// PRE-SESSION CHECKLIST — Custom templates + execution tracking
// ═══════════════════════════════════════════════════════════════
var CL_STORAGE_KEY = 'REP_checklist_v1';
var CL = {
  templates: [],       // [{id, name, type, groups:[{id,name,items:[{id,text,priority,note,required}]}]}]
  currentTplId: null,
  session: null,       // active session {tplId, startedAt, completions:{itemId:{done,ts,note}}, finalizedAt}
  history: []          // [{tplId, tplName, type, startedAt, finalizedAt, total, done, notes}]
};

function clLoad(){
  try {
    var raw = localStorage.getItem(CL_STORAGE_KEY);
    if(raw){
      var data = JSON.parse(raw);
      if(data.templates) CL.templates = data.templates;
      if(data.currentTplId) CL.currentTplId = data.currentTplId;
      if(data.session) CL.session = data.session;
      if(data.history) CL.history = data.history;
    }
  } catch(e){ console.warn('CL load fail', e); }
  // Seed default templates if empty
  if(!CL.templates.length){
    CL.templates = _clDefaultTemplates();
    CL.currentTplId = CL.templates[0].id;
    clSave();
  } else {
    // Migration: if user already had the 3 old templates, offer to add the 8 new ones.
    // We detect by checking presence of the new types (Post, Prep, Recce, Shake, PS, Service, EOD, Maint, Season).
    var existingTypes = new Set(CL.templates.map(function(t){return t.type;}));
    var NEW_TYPES_EXPECTED = ['Post','Prep','Recce','Shake','PS','Service','EOD','Maint','Season'];
    var missing = NEW_TYPES_EXPECTED.filter(function(t){return !existingTypes.has(t);});
    if(missing.length >= 5){
      // At least 5 of the new types are missing → this user is on the old 3-template setup.
      // Add the new default templates, keeping user's existing ones.
      var defaults = _clDefaultTemplates();
      defaults.forEach(function(tpl){
        if(!existingTypes.has(tpl.type)){
          // Give the new template a fresh id to avoid collision
          CL.templates.push(tpl);
        }
      });
      // Also backfill mode/frequency on old templates (they didn't have these fields)
      CL.templates.forEach(function(tpl){
        if(!tpl.mode){
          if(tpl.type === 'FP1' || tpl.type === 'Q' || tpl.type === 'Gara') tpl.mode = 'track';
          else tpl.mode = 'both';
        }
        if(!tpl.frequency) tpl.frequency = 'per-session';
      });
      clSave();
      console.log('[CL] Migrato: aggiunti '+missing.length+' nuovi template di default');
    }
  }
}
function clSave(){
  try { localStorage.setItem(CL_STORAGE_KEY, JSON.stringify({
    templates: CL.templates, currentTplId: CL.currentTplId, session: CL.session, history: CL.history
  })); } catch(e){ console.warn('CL save fail', e); }
}

// Returns an array of templates that are "overdue" based on their frequency
// and history of last completion. Used to show a warning badge in the sidebar.
function clGetOverdueTemplates(){
  if(!CL.templates || !CL.history) return [];
  var now = Date.now();
  var MS_DAY = 86400000;
  var overdue = [];
  CL.templates.forEach(function(tpl){
    var f = tpl.frequency;
    if(!f || f === 'per-session') return; // session-only templates don't get reminders
    // Find most recent completion of this template in history
    var last = null;
    (CL.history||[]).forEach(function(h){
      if(h.tplId === tpl.id && h.finalizedAt){
        var ts = (typeof h.finalizedAt === 'number') ? h.finalizedAt : Date.parse(h.finalizedAt);
        if(!last || ts > last) last = ts;
      }
    });
    var threshold;
    if(f === 'per-weekend') threshold = 7 * MS_DAY;           // weekly check
    else if(f === 'per-month') threshold = 30 * MS_DAY;       // monthly
    else if(f === 'per-season') threshold = 365 * MS_DAY;     // yearly
    else if(f === 'every-500km') threshold = null;            // km-based, not time-based
    else return;
    if(threshold && (!last || (now - last) > threshold)){
      overdue.push({ tpl: tpl, last: last, daysSince: last ? Math.floor((now-last)/MS_DAY) : null });
    }
  });
  return overdue;
}
window.clGetOverdueTemplates = clGetOverdueTemplates;

