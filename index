/* ── TERRENO: griglia quote attorno al percorso ── */
function m3Terrain(latMin, latMax, lonMin, lonMax){
  var key=[latMin.toFixed(3),latMax.toFixed(3),lonMin.toFixed(3),lonMax.toFixed(3)].join('|');
  if(_terrCache.key===key && _terrCache.trace) return Promise.resolve(_terrCache.trace);
  var lats=[], lons=[];
  for(var i=0;i<TERR_N;i++){
    lats.push(latMin+(latMax-latMin)*i/(TERR_N-1));
    lons.push(lonMin+(lonMax-lonMin)*i/(TERR_N-1));
  }
  var qLat=[], qLon=[];
  for(var iy=0;iy<TERR_N;iy++) for(var ix=0;ix<TERR_N;ix++){ qLat.push(lats[iy].toFixed(5)); qLon.push(lons[ix].toFixed(5)); }
  var out=new Array(qLat.length), idx=0;
  function batch(){
    if(idx>=qLat.length) return Promise.resolve();
    setProg('🏔 Terreno: '+Math.min(idx+100,qLat.length)+'/'+qLat.length+' quote...');
    return m3FetchElev(qLat.slice(idx,idx+100), qLon.slice(idx,idx+100)).then(function(arr){
      for(var i2=0;i2<arr.length;i2++) out[idx+i2]=arr[i2];
      idx+=100;
      return batch();
    });
  }
  return batch().then(function(){
    setProg('');
    var z=[];
    for(var iy=0;iy<TERR_N;iy++){
      var row=[];
      for(var ix=0;ix<TERR_N;ix++) row.push(out[iy*TERR_N+ix]||0);
      z.push(row);
    }
    var trace={ type:'surface', x:lons, y:lats, z:z,
      colorscale:[[0,'#16281c'],[0.35,'#2e4a2e'],[0.65,'#5a5a40'],[0.85,'#7b6f58'],[1,'#9aa0a8']],
      opacity:1, showscale:false, hoverinfo:'skip', name:'terreno',
      lighting:{ ambient:0.55, diffuse:0.7, specular:0.12, roughness:0.8 },
      lightposition:{ x:1000, y:-2000, z:4000 },
      contours:{ z:{ show:false } } };
    _terrCache={ key:key, trace:trace };
    return trace;
  });
}

/* ── RESA 3D v3: nastro-strada + terreno + cippi ── */
window.m3Render3D = function(){
  var g=gpsData();
  var el=document.getElementById('plotly-3d-map');
  if(!g || !el || typeof Plotly==='undefined') return;
  // tracciati GPS reali: decine di migliaia di punti -> ricampiona per la scena
  var n0=g.lats.length;
  var step=Math.max(1, Math.ceil(n0/800));
  var lats=[], lons=[], alts=[];
  for(var p0=0;p0<n0;p0+=step){ lats.push(+g.lats[p0]); lons.push(+g.lons[p0]); alts.push(+g.alts[p0]); }
  if(lats[lats.length-1]!==+g.lats[n0-1]){ lats.push(+g.lats[n0-1]); lons.push(+g.lons[n0-1]); alts.push(+g.alts[n0-1]); }
  var n=lats.length;
  if(n<2) return;
  // quote GPS rumorose: smussatura (media mobile +-2) e pendenze ricalcolate
  alts=movAvg(alts,2);
  var slopes=[0];
  for(var p1=1;p1<n;p1++){
    var dd=havM(lats[p1-1],lons[p1-1],lats[p1],lons[p1]);
    slopes.push(dd>0? Math.max(-20,Math.min(20,(alts[p1]-alts[p1-1])/dd*100)) : 0);
  }
  var latMin=aMin(lats), latMax=aMax(lats);
  var lonMin=aMin(lons), lonMax=aMax(lons);
  var zminA=aMin(alts), zmaxA=aMax(alts);
  var latC=(latMin+latMax)/2;
  var mLat=111320, mLon=111320*Math.cos(latC*Math.PI/180);

  // distanza cumulata
  var cum=[0];
  for(var i=1;i<n;i++) cum.push(cum[i-1]+havM(lats[i-1],lons[i-1],lats[i],lons[i]));
  var totKm=cum[n-1]/1000;

  // larghezza nastro in metri (auto con la lunghezza; ben visibile)
  var halfW=Math.max(4, Math.min(22, totKm*1.4))/1;   // semi-larghezza m
  var zLift=(zmaxA-zminA)*0.012+1.5;

  // vertici sinistra/destra perpendicolari alla direzione
  var Lx=[],Ly=[],Rx=[],Ry=[],Zt=[];
  for(var i2=0;i2<n;i2++){
    var a=Math.max(0,i2-1), b=Math.min(n-1,i2+1);
    var dxm=(lons[b]-lons[a])*mLon, dym=(lats[b]-lats[a])*mLat;
    var len=Math.sqrt(dxm*dxm+dym*dym)||1;
    var px=-dym/len, py=dxm/len;   // perpendicolare unitaria (m)
    Lx.push(lons[i2]+px*halfW/mLon); Ly.push(lats[i2]+py*halfW/mLat);
    Rx.push(lons[i2]-px*halfW/mLon); Ry.push(lats[i2]-py*halfW/mLat);
    Zt.push(alts[i2]+zLift);
  }
  var X=Lx.concat(Rx), Y=Ly.concat(Ry), Z=Zt.concat(Zt);
  var I=[],J=[],K=[],INT=slopes.concat(slopes);
  for(var q=0;q<n-1;q++){
    I.push(q);   J.push(q+1);   K.push(n+q);
    I.push(q+1); J.push(n+q+1); K.push(n+q);
  }
  var road={ type:'mesh3d', x:X, y:Y, z:Z, i:I, j:J, k:K,
    intensity:INT, cmin:-14, cmax:14,
    colorscale:[[0,'#2b7de9'],[0.32,'#38c7d8'],[0.5,'#2ecc71'],[0.68,'#f1c40f'],[0.85,'#e67e22'],[1,'#e74c3c']],
    colorbar:{ title:'Pendenza %', thickness:14, len:0.5, tickfont:{color:'#a8afc0'} },
    lighting:{ ambient:0.65, diffuse:0.6, specular:0.25, roughness:0.55 },
    lightposition:{ x:1000, y:-2000, z:4000 },
    hoverinfo:'skip', name:'strada' };

  // linea di mezzeria bianca con hover informativo
  var mid={ type:'scatter3d', mode:'lines', x:lons, y:lats, z:Zt.map(function(z2){return z2+0.8;}),
    line:{ width:3, color:'rgba(255,255,255,.8)' },
    text:slopes.map(function(s,i3){ return 'km '+(cum[i3]/1000).toFixed(2)+'<br>Quota: '+alts[i3].toFixed(0)+' m<br>Pendenza: '+s.toFixed(1)+'%'; }),
    hoverinfo:'text', name:'' };

  // parete d'ombra
  var base=zminA-(zmaxA-zminA)*0.08-3;
  var Xw=lons.concat(lons), Yw=lats.concat(lats), Zw=alts.concat(alts.map(function(){return base;}));
  var Iw=[],Jw=[],Kw=[];
  for(var q2=0;q2<n-1;q2++){
    Iw.push(q2);   Jw.push(q2+1);   Kw.push(n+q2);
    Iw.push(q2+1); Jw.push(n+q2+1); Kw.push(n+q2);
  }
  var wall={ type:'mesh3d', x:Xw, y:Yw, z:Zw, i:Iw, j:Jw, k:Kw,
    color:'#1aada0', opacity:0.13, hoverinfo:'skip', showscale:false };

  // partenza/arrivo + cippi chilometrici
  var kmStep = totKm>30? 5 : (totKm>12? 2 : 1);
  var kx=[],ky=[],kz=[],kt=[];
  var nextKm=kmStep;
  for(var i4=1;i4<n;i4++){
    while(cum[i4]/1000>=nextKm){
      kx.push(lons[i4]); ky.push(lats[i4]); kz.push(alts[i4]+zLift+6); kt.push(String(nextKm));
      nextKm+=kmStep;
    }
  }
  var kms={ type:'scatter3d', mode:'markers+text', x:kx, y:ky, z:kz,
    marker:{ size:3, color:'#ffd75e' }, text:kt, textposition:'top center',
    textfont:{ size:9, color:'#ffd75e' }, hoverinfo:'skip', name:'km' };
  var mark={ type:'scatter3d', mode:'markers+text',
    x:[lons[0],lons[n-1]], y:[lats[0],lats[n-1]], z:[alts[0]+zLift+4, alts[n-1]+zLift+4],
    marker:{ size:10, color:['#2ecc71','#e74c3c'], line:{color:'#fff',width:1.5} },
    text:['PARTENZA','ARRIVO'], textposition:'top center',
    textfont:{ size:11, color:'#eef2f7' }, hoverinfo:'text', name:'' };

  // proporzioni geografiche reali + esagerazione verticale
  var dxKm=(lonMax-lonMin)*mLon/1000, dyKm=(latMax-latMin)*mLat/1000;
  var dzKm=(zmaxA-zminA)/1000*Z_EXAG, mx=Math.max(dxKm,dyKm,0.0001);
  var layout={
    margin:{l:0,r:0,b:0,t:0},
    scene:{
      xaxis:{ visible:false }, yaxis:{ visible:false },
      zaxis:{ title:'m', color:'#6b7280', gridcolor:'#232838', showbackground:false },
      bgcolor:'rgba(0,0,0,0)',
      aspectmode:'manual',
      aspectratio:{ x:dxKm/mx, y:dyKm/mx, z:Math.max(0.14, dzKm/mx) },
      camera:{ eye:{x:0.85,y:-1.35,z:0.5} },
      dragmode:'orbit'
    },
    paper_bgcolor:'transparent', plot_bgcolor:'transparent',
    font:{ color:'#a8afc0' }, showlegend:false
  };
  Plotly.newPlot(el, [road, wall, mid, kms, mark], layout,
    { responsive:true, displayModeBar:true, modeBarButtonsToRemove:['sendDataToCloud'] });

  // terreno asincrono (griglia quote attorno al percorso, bbox +18%)
  if(terrOn()){
    var padLat=(latMax-latMin)*0.18+0.002, padLon=(lonMax-lonMin)*0.18+0.002;
    m3Terrain(latMin-padLat, latMax+padLat, lonMin-padLon, lonMax+padLon)
      .then(function(tr){
        try { Plotly.addTraces(el, [tr]); } catch(eT){}
      })
      .catch(function(){ setProg(''); });
  }

  // profilo altimetrico
  var prof=document.getElementById('m3-profile');
  if(prof){
    prof.style.display='';
    var dkm=cum.map(function(d){return d/1000;});
    Plotly.newPlot(prof, [{
      x:dkm, y:alts, mode:'lines', fill:'tozeroy',
      line:{ color:'#1aada0', width:3.5 }, fillcolor:'rgba(26,173,160,.18)',
      text:slopes.map(function(s,i5){ return 'km '+dkm[i5].toFixed(2)+' · '+alts[i5].toFixed(0)+' m · '+s.toFixed(1)+'%'; }),
      hoverinfo:'text'
    }],{
      margin:{l:44,r:8,t:8,b:30},
      xaxis:{ title:'km', color:'#6b7280', gridcolor:'#2a2f3e' },
      yaxis:{ title:'m', color:'#6b7280', gridcolor:'#2a2f3e' },
      paper_bgcolor:'transparent', plot_bgcolor:'transparent',
      font:{ color:'#a8afc0', size:10 }, showlegend:false
    },{ responsive:true, displayModeBar:false });
  }
};

