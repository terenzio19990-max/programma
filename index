  try { if(window.Notification && Notification.permission==='default') Notification.requestPermission(); } catch(e){}
  setT('rep-live-hstat','Connessione al broker…');
  LIVE.hostOn=true; LIVE.peerRetries=0; LIVE.lastAnyData=0; LIVE.lastRebuild=Date.now();
  var code=teamCode(false);
