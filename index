  if(!confirm('Eliminare questa lezione?\n\nL\'azione è permanente.')) return;
  _lessons.entries = _lessons.entries.filter(function(e){return e.id!==id;});
  _lsSave();
  if(_lessonsSelectedId === id) _lessonsSelectedId = null;
  renderLessonsPage();
  showToast('🗑 Lezione eliminata');
}
