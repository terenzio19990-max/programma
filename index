function buildSpareSummary() {
  const el = document.getElementById('spare-summary'); if(!el) return;
  const parts = SPARE_PARTS[_spareMode] || [];
  const total = parts.length;
  // Use per-part min threshold if set, else default to 2
  const low   = parts.filter(function(p){var m=p.min||2;return p.qty<=m&&p.qty>0;}).length;
  const empty = parts.filter(function(p){return p.qty===0;}).length;
  const trackT = (SPARE_PARTS.track||[]).length;
  const rallyT = (SPARE_PARTS.rally||[]).length;
  // Total inventory value (qty * cost) for the active mode
  var totalValue = 0;
  parts.forEach(function(p){
    if(p.cost && p.qty) totalValue += +p.cost * +p.qty;
  });
  // Total used (sum of "used" counters)
  var totalUsed = parts.reduce(function(s,p){return s + (+p.used||0);},0);

  var html = '<div class="g2" style="gap:8px;margin-bottom:8px;">';
  html += '<div class="tile"><div class="tile-label">TOTALE PEZZI</div><div class="tile-value">'+total+'</div></div>';
  html += '<div class="tile '+(empty?'tile-bad':low?'tile-warn':'tile-good')+'"><div class="tile-label">ESAURITI</div><div class="tile-value">'+empty+'</div></div>';
  html += '</div>';
  html += '<div class="g2" style="gap:8px;margin-bottom:8px;">';
  html += '<div class="tile '+(low>0?'tile-warn':'')+'"><div class="tile-label">SCORTA BASSA</div><div class="tile-value" style="color:'+(low>0?'var(--yellow)':'var(--text1)')+'">'+low+'</div></div>';
  if(totalValue > 0){
    html += '<div class="tile"><div class="tile-label">VALORE €</div><div class="tile-value" style="font-size:16px;">€'+totalValue.toFixed(0)+'</div></div>';
  } else {
    html += '<div class="tile"><div class="tile-label">USATI</div><div class="tile-value">'+totalUsed+'</div></div>';
  }
  html += '</div>';
  html += '<div style="display:flex;gap:8px;font-size:11px;color:var(--text3);flex-wrap:wrap;">';
  html += '<span>Pista: <b style="color:var(--text1)">'+trackT+'</b></span>';
  html += '<span>Rally: <b style="color:var(--text1)">'+rallyT+'</b></span>';
  if(low) html += '<span style="color:var(--yellow);">⚠ '+low+' scorte basse</span>';
  if(empty) html += '<span style="color:var(--red);">✗ '+empty+' esauriti</span>';
  if(totalUsed) html += '<span>Totale consumati: '+totalUsed+'</span>';
  html += '</div>';
  el.innerHTML = html;
}

