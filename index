// ─── Per-car stats for a driver (used to compare driving style) ─
// Returns array of { car, stats } where stats has same shape as _drvComputeStats
function _drvComputeStatsPerCar(driverId){
  var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
  var result = [];
  allCars.forEach(function(car){
    var laps = [];
    (STATE.laps[car.id]||[]).forEach(function(l){
      if((l.driverId||'') === (driverId||'')){
        var ms = parseTime(l.time);
        if(ms && isFinite(ms)){
          laps.push({ ms: ms, lap: l.lap, session: l.session, ts: l.ts||0 });
        }
      }
    });
    if(!laps.length) return;
    laps.sort(function(a,b){ if(a.ts && b.ts) return a.ts - b.ts; return 0; });
    var times = laps.map(function(l){return l.ms;});
    var firstTime = times[0];
    var lastTime = times[times.length-1];
    var bestTime = Math.min.apply(null, times);
    var worstTime = Math.max.apply(null, times);
    var avg = times.reduce(function(a,b){return a+b;},0)/times.length;
    var variance = times.reduce(function(s,v){return s+(v-avg)*(v-avg);},0)/times.length;
    var stddev = Math.sqrt(variance);
    var cv = (stddev/avg)*100;
    var improvement = firstTime - lastTime;
    // Warmup: bucket by session, find best lap index per session
    var bySession = {};
    laps.forEach(function(l){
      var s = l.session || 'sess';
      if(!bySession[s]) bySession[s] = [];
      bySession[s].push(l);
    });
    var warmupLaps = [];
    Object.keys(bySession).forEach(function(s){
      var sLaps = bySession[s];
      var bestIdx = 0, bestMs = sLaps[0].ms;
      for(var i=1;i<sLaps.length;i++){
        if(sLaps[i].ms < bestMs){ bestMs = sLaps[i].ms; bestIdx = i; }
      }
      warmupLaps.push(bestIdx + 1);
    });
    var avgWarmup = warmupLaps.length ? warmupLaps.reduce(function(a,b){return a+b;},0)/warmupLaps.length : null;
    // Range = worst - best (più alto = più aggressivo / push variance)
    var range = worstTime - bestTime;
    // Aggressiveness score = ratio range/best, normalizzato (0=sempre uguale, 1=range = best)
    var aggressiveness = bestTime ? (range/bestTime*100) : 0;
    result.push({
      car: car,
      stats: {
        totalLaps: laps.length,
        firstTime: firstTime,
        lastTime: lastTime,
        bestTime: bestTime,
        worstTime: worstTime,
        avg: avg,
        cv: cv,
        improvement: improvement,
        avgWarmup: avgWarmup,
        range: range,
        aggressiveness: aggressiveness,
        sessionsCount: Object.keys(bySession).length
      }
    });
  });
  return result;
}
window._drvComputeStatsPerCar = _drvComputeStatsPerCar;

// ─── Render the per-car comparison block ─────────────────────────
function _renderDrvPerCarComparison(driver, perCar){
  var html = '';
  html += '<div style="margin-top:18px;padding:14px 16px;background:var(--bg3);border-radius:6px;border-left:3px solid var(--accent3);">';
  html += '<div style="font-family:var(--head);font-size:11px;color:var(--accent3);letter-spacing:2px;margin-bottom:10px;font-weight:700;">🔀 STILE DI GUIDA — '+perCar.length+' VETTURE</div>';
  html += '<div style="font-size:11px;color:var(--text3);line-height:1.6;margin-bottom:12px;">'+
    'Confronto delle metriche di guida per ogni vettura. Verde = migliore, giallo = peggiore.'+
  '</div>';

  // Find best/worst for each metric for color coding
  function bestIdx(key, lower){
    var bIdx = 0, bVal = lower ? Infinity : -Infinity;
    perCar.forEach(function(p, i){
      var v = p.stats[key];
      if(v == null || !isFinite(v)) return;
      if(lower ? v < bVal : v > bVal){ bVal = v; bIdx = i; }
    });
    return bIdx;
  }
  function worstIdx(key, lower){
    var wIdx = 0, wVal = lower ? -Infinity : Infinity;
    perCar.forEach(function(p, i){
      var v = p.stats[key];
      if(v == null || !isFinite(v)) return;
      if(lower ? v > wVal : v < wVal){ wVal = v; wIdx = i; }
    });
    return wIdx;
  }

  var bestBest = bestIdx('bestTime', true);
  var bestCV   = bestIdx('cv', true);          // più basso = meglio
  var bestWarm = bestIdx('avgWarmup', true);   // più basso = scaldamento veloce
  var bestImpr = bestIdx('improvement', false); // più alto = più migliorato
  var maxAggr  = bestIdx('aggressiveness', false); // più alto = più aggressivo

  // Build table
  html += '<table class="data-table" style="font-size:11px;margin-bottom:12px;"><thead><tr>'+
    '<th>VETTURA</th><th>GIRI</th><th>BEST</th><th>CV%</th><th>WARMUP</th><th>RANGE</th><th>MIGLIORAM.</th>'+
  '</tr></thead><tbody>';
  perCar.forEach(function(p, i){
    var s = p.stats;
    var col = p.car.type === 'rally' ? 'var(--green)' : 'var(--accent)';
    function cell(val, isBest, isWorst){
      var c = isBest ? 'var(--green)' : isWorst ? 'var(--yellow)' : 'var(--text1)';
      var fw = (isBest||isWorst) ? '700' : '500';
      return '<td style="font-family:var(--mono);color:'+c+';font-weight:'+fw+';">'+(isBest?'🏆 ':'')+val+'</td>';
    }
    html += '<tr>';
    html += '<td><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:'+col+';margin-right:6px;vertical-align:middle;"></span>'+
      '<b>'+p.car.name+'</b><span style="font-size:9px;color:var(--text3);margin-left:4px;">('+(p.car.type||'track')+')</span></td>';
    html += '<td>'+s.totalLaps+'</td>';
    html += cell(_drvFmtMs(s.bestTime), i===bestBest, false);
    html += cell(s.cv.toFixed(2)+'%', i===bestCV, perCar.length>2 && s.cv === Math.max.apply(null, perCar.map(function(x){return x.stats.cv;})));
    html += cell(s.avgWarmup ? s.avgWarmup.toFixed(1)+' g' : '—', i===bestWarm, false);
    html += cell((s.range/1000).toFixed(2)+'s', false, false);
    var improvStr = (s.improvement>=0?'-':'+')+(Math.abs(s.improvement)/1000).toFixed(2)+'s';
    html += cell(improvStr, i===bestImpr && s.improvement > 0, false);
    html += '</tr>';
  });
  html += '</tbody></table>';

  // ─── Verdetto automatico ──────────────────────────────────────
  var verdicts = [];
  if(perCar.length >= 2){
    // Più consistente
    var consCar = perCar[bestCV];
    var consDelta = perCar[worstIdx('cv', true)].stats.cv - consCar.stats.cv;
    if(consDelta > 0.5){
      verdicts.push('🎯 <b>Più consistente</b> su <b>'+consCar.car.name+'</b> ('+consCar.stats.cv.toFixed(2)+'% vs '+perCar[worstIdx('cv', true)].stats.cv.toFixed(2)+'% sull\'altra)');
    }
    // Si scalda più rapidamente
    var warmCar = perCar[bestWarm];
    if(warmCar.stats.avgWarmup !== null){
      var warmOther = perCar[worstIdx('avgWarmup', true)];
      if(warmOther.stats.avgWarmup !== null && (warmOther.stats.avgWarmup - warmCar.stats.avgWarmup) >= 1){
        verdicts.push('🔥 <b>Si scalda più in fretta</b> su <b>'+warmCar.car.name+'</b> (~'+warmCar.stats.avgWarmup.toFixed(1)+' giri vs ~'+warmOther.stats.avgWarmup.toFixed(1)+')');
      }
    }
    // Più aggressivo (range più alto)
    var aggrCar = perCar[maxAggr];
    if(aggrCar.stats.aggressiveness > 3 && perCar.length >= 2){
      verdicts.push('💥 <b>Push più variabile</b> su <b>'+aggrCar.car.name+'</b> (range '+(aggrCar.stats.range/1000).toFixed(2)+'s — più aggressivo o meno regolare)');
    }
    // Più migliorato
    if(perCar[bestImpr].stats.improvement > 500){
      verdicts.push('📈 <b>Crescita più marcata</b> su <b>'+perCar[bestImpr].car.name+'</b> (-'+(perCar[bestImpr].stats.improvement/1000).toFixed(2)+'s dal primo all\'ultimo giro)');
    }
  }
  if(verdicts.length){
    html += '<div style="background:var(--bg2);border-radius:5px;padding:10px 14px;font-size:11px;line-height:1.8;">';
    html += '<div style="font-family:var(--head);font-size:10px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">📝 OSSERVAZIONI AUTOMATICHE</div>';
    verdicts.forEach(function(v){ html += '<div style="margin-bottom:4px;">• '+v+'</div>'; });
    html += '</div>';
  } else {
    html += '<div style="font-size:11px;color:var(--text3);font-style:italic;text-align:center;padding:10px;">Differenze tra le vetture non significative — pilota molto coerente.</div>';
  }

  html += '</div>';
  return html;
}
