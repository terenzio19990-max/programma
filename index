/* ── ANALISI CURVA-PER-CURVA: curve individuate dalla geometria del
   giro migliore, vmin per curva confrontata giro su giro ── */
function brgP(a,b){
  var p1=a.lat*Math.PI/180,p2=b.lat*Math.PI/180,dl=(b.lon-a.lon)*Math.PI/180;
  return (Math.atan2(Math.sin(dl)*Math.cos(p2),Math.cos(p1)*Math.sin(p2)-Math.sin(p1)*Math.cos(p2)*Math.cos(dl))*180/Math.PI+360)%360;
}
function havP(a,b){
  var R=6371e3,p1=a.lat*Math.PI/180,p2=b.lat*Math.PI/180,dp=(b.lat-a.lat)*Math.PI/180,dl=(b.lon-a.lon)*Math.PI/180;
  var x=Math.sin(dp/2)*Math.sin(dp/2)+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)*Math.sin(dl/2);
  return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));
}
function lapSeg(C,L){
  if(!L||!L.tc) return null;
  var t1=L.tc,t0=t1-L.t;
  var seg=C.pts.filter(function(p){ return p.t>=t0-1500 && p.t<=t1+1500; });
  return seg.length>6? seg:null;
}
function cornersDetect(seg){
  var out=[],cur=null,acc=0;
  for(var i=2;i<seg.length;i++){
    var d=havP(seg[i-1],seg[i]); if(d<0.5) continue;
    var b1=brgP(seg[i-2],seg[i-1]), b2=brgP(seg[i-1],seg[i]);
    var dh=((b2-b1+540)%360)-180;
    var rate=Math.abs(dh)/d;                      // °/m
    if(rate>0.22){                                 // raggio < ~260 m
      if(!cur){ cur={ i0:i-1, vmin:1e9, apex:null, turn:0 }; }
      cur.turn+=dh;
      var vv=(seg[i].v!=null)? seg[i].v:1e9;
      if(vv<cur.vmin){ cur.vmin=vv; cur.apex=seg[i]; }
      cur.i1=i;
    } else if(cur){
      if(Math.abs(cur.turn)>28 && cur.apex){ out.push(cur); }
      cur=null;
    }
  }
  if(cur && Math.abs(cur.turn)>28 && cur.apex) out.push(cur);
  return out.map(function(c,idx){
    // raggio all'apice: circumcerchio di 3 punti (prima, apice, dopo)
    var r=null;
    try {
      var i0=Math.max(0,c.i0), i1=Math.min(seg.length-1,c.i1);
      var A=seg[i0], B=c.apex, Cc=seg[i1];
      var ab=havP(A,B), bc=havP(B,Cc), ca=havP(Cc,A);
      var s2=(ab+bc+ca)/2, ar=Math.sqrt(Math.max(0,s2*(s2-ab)*(s2-bc)*(s2-ca)));
      if(ar>1) r=(ab*bc*ca)/(4*ar);
    } catch(e){}
    return { n:idx+1, lat:c.apex.lat, lon:c.apex.lon, tApex:(c.apex.t||null), r:r,
      vmin:c.vmin<1e9? c.vmin:null, dir:(c.turn>0?'DX':'SX') };
  });
}
function cornerVmin(seg,corner){
  var v=null;
  seg.forEach(function(p){
    if(p.v==null) return;
    if(havP(p,corner)<35){ if(v==null||p.v<v) v=p.v; }
  });
  return v;
}
