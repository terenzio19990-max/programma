/* ---- Parser scheda assetto ---- */
window.saLoadSheetFile = function(ev, taId){
  var f = ev.target.files && ev.target.files[0];
  if(!f) return;
  var rd = new FileReader();
  rd.onload = function(){ var ta=document.getElementById(taId); if(ta) ta.value = String(rd.result||''); };
  rd.readAsText(f);
};
window.saParseSetupSheet = function(mode){
  var ta = document.getElementById('sa-sheet-ta-'+mode);
  var rep = document.getElementById('sa-sheet-rep-'+mode);
  if(!ta) return;
  var pref = mode==='rally'?'r-':'';
  var got=[], missed=[];
  function setF(id,val){
    var el=document.getElementById(pref+id);
    if(el && val!==undefined && val!==null && String(val)!==''){
      el.value=val; got.push(id.replace(/-/g,' ')+' = '+val);
    }
  }
  ta.value.split(/\r?\n/).forEach(function(rawline){
  rawline.split(/(?:,(?!\d)|;|\u00b7|\u2014|\u2013)/).forEach(function(raw){
    var l = raw.toLowerCase();
    if(!l.trim()) return;
    var norm = raw.replace(/(\d),(\d)/g,'$1.$2');
    var nums = norm.match(/-?\d+(\.\d+)?/g)||[];
    var isF = /(ant|front|davanti|\bav\b)/.test(l);
    var isR = /(post|rear|dietro|tras)/.test(l);
    var mm = /mm/.test(l);
    function val(i){ return nums[i]!==undefined? nums[i] : null; }
    function assign(idF,idR,suffix){
      function sv(n){ return (suffix && parseFloat(n)>=10)? n+suffix : n; }
      if(isF && !isR && nums.length){ setF(idF, sv(val(0))); }
      else if(isR && !isF && nums.length){ setF(idR, sv(val(0))); }
      else if(nums.length>=2){ setF(idF, sv(val(0))); setF(idR, sv(val(1))); }
      else if(nums.length===1){ setF(idF, sv(val(0))); setF(idR, sv(val(0))); }
    }
    if(/(fast|veloce)/.test(l) && /(bump|compress)/.test(l)) assign('fast-bump-f','fast-bump-r');
    else if(/(fast|veloce)/.test(l) && /(reb|esten|ritorno)/.test(l)) assign('fast-reb-f','fast-reb-r');
    else if(/(bump|compress)/.test(l)) assign('bump-f','bump-r');
    else if(/(rebound|\breb\b|esten|ritorno)/.test(l)) assign('reb-f','reb-r');
    else if(/(molla|molle|spring)/.test(l)) assign('spring-f','spring-r');
    else if(/(barra|antiroll|anti-roll|\barb\b|stabilizz)/.test(l)) assign('bar-f','bar-r', mm?'mm':'');
    else if(/(camber|campanatura)/.test(l)){
      if(isF && !isR && nums.length){ setF('camber-fl',val(0)); setF('camber-fr',val(0)); }
      else if(isR && !isF && nums.length){ setF('camber-rl',val(0)); setF('camber-rr',val(0)); }
      else if(nums.length>=2){ setF('camber-fl',val(0)); setF('camber-fr',val(0)); setF('camber-rl',val(1)); setF('camber-rr',val(1)); }
    }
    else if(/(toe|converg)/.test(l)) assign('toe-f','toe-r');
    else if(/(bias|ripartizion\w*)/.test(l) && /(fren|brake|%)/.test(l) && nums.length) setF('brake-bias', val(0)+'%');
    else if(/splitter/.test(l)) setF('splitter', /\bon\b/.test(l)?'on':(/\boff\b/.test(l)?'off':val(0)));
    else if(/(ala|wing)/.test(l)) assign('wing-front','wing-rear');
    else if(/(altezza|ride|ground)/.test(l) && mode==='rally') assign('ride-f','ride-r');
    else if(/diff/.test(l)){
      var isFd=/(ant|front)/.test(l), isRd=/(post|rear)/.test(l), isCd=/(centr|center)/.test(l);
      var sfx = isCd? '-c' : ((isRd&&!isFd)? '-r' : '-f');
      window._saLastDiffSfx = sfx;
      var handled=false;
      var mR=l.match(/ramp[ae]?[^\d]{0,10}(\d{2})\s*[\/x-]\s*(\d{2})/);
      if(mR){ setF('diff-ramp-acc'+sfx, mR[1]); setF('diff-ramp-dec'+sfx, mR[2]); handled=true; }
      var mP=l.match(/precaric\w*[^\d]{0,10}(\d{1,3})/);
      if(mP){ setF('diff-preload'+sfx, mP[1]); handled=true; }
      if(!handled) assign('diff-f','diff-r');
    }
    else if(/precaric/.test(l) && nums.length){
      setF('diff-preload'+(window._saLastDiffSfx||'-f'), val(0));
    }
    else if(/ramp[ae]/.test(l) && nums.length>=2){
      var sfx2=(window._saLastDiffSfx||'-f');
      setF('diff-ramp-acc'+sfx2, val(0)); setF('diff-ramp-dec'+sfx2, val(1));
    }
    else if(/(mappa|map)/.test(l) && nums.length) setF('eng-map', val(0));
    else if(/(rapport|marce|gear|cambio|finale)/.test(l)) missed.push('«'+raw.trim().slice(0,45)+'» → dati cambio: usa la SCHEDA VETTURA in ⚙ PARAMETRI');
    else if(/press/.test(l)) missed.push('«'+raw.trim().slice(0,45)+'» → pressioni: pagina GOMME');
    else if(nums.length) missed.push('«'+raw.trim().slice(0,45)+'» non riconosciuta');
  }); });
  if(rep){
    var h='';
    if(got.length) h += '<span style="color:var(--green)">✔ Compilati '+got.length+' campi:</span> '+esc(got.join(' · '))+'<br>';
    else h += '<span style="color:var(--yellow)">Nessun campo riconosciuto: controlla il formato (una riga per voce).</span><br>';
    if(missed.length) h += '<span style="color:var(--yellow)">⚠ '+esc(missed.join(' · '))+'</span>';
    rep.innerHTML = h;
  }
  if(typeof showToast==='function' && got.length) showToast('📥 Scheda assetto: '+got.length+' campi compilati');
  saRender(mode);
};

/* ---- Parser scheda vettura ---- */
window.saParseCarSheet = function(mode){
  var ta = document.getElementById('sa-carsheet-'+mode);
  var rep = document.getElementById('sa-carsheet-rep-'+mode);
  if(!ta) return;
  var car = saCar(mode), type = car.type;
  var t = ta.value.replace(/(\d),(\d)/g,'$1.$2');
  var tl = t.toLowerCase();
  var found=[];
  function set(k, v, label){ saSaveParam(type,k,v); found.push(label+' = '+v); }
  function num(re, idx){ var m = tl.match(re); return m? parseFloat(m[idx===undefined?1:idx]) : null; }

  var v;
  v = num(/(?:massa|peso)[^\d]{0,20}(\d{3,4}(?:\.\d+)?)/); if(v!==null && v>=400 && v<=2200) set('m', v, 'massa kg');
  v = num(/(\d{2,3}(?:\.\d+)?)\s*(?:cv|hp|ch\b)/); if(v!==null && v>40){ set('powerKW', Math.round(v*0.7355*10)/10, 'potenza kW (da '+v+' cv)'); }
  else { v = num(/(\d{2,3}(?:\.\d+)?)\s*kw/); if(v!==null && v>40) set('powerKW', v, 'potenza kW'); }
  v = num(/(?:passo|wheelbase|interasse)[^\d]{0,20}(\d+(?:\.\d+)?)/); if(v!==null){ if(v>100) v=v/1000; if(v>1.8&&v<3.5) set('L', v, 'passo m'); }
  v = num(/carreggiat\w*\s*(?:ant\w*|front\w*)[^\d]{0,15}(\d+(?:\.\d+)?)/); if(v!==null){ if(v>100) v=v/1000; if(v>1.2&&v<2.2) set('trackF', v, 'carreggiata ant m'); }
  v = num(/carreggiat\w*\s*(?:post\w*|rear\w*)[^\d]{0,15}(\d+(?:\.\d+)?)/); if(v!==null){ if(v>100) v=v/1000; if(v>1.2&&v<2.2) set('trackR', v, 'carreggiata post m'); }
  v = num(/(?:distribuzion\w*|ripartizion\w*)[^\d]{0,30}(\d{2}(?:\.\d+)?)\s*[\/%]/); if(v!==null && v>30 && v<80) set('wf', Math.round(v)/100, 'peso ant %');
  v = num(/(?:baricentro|centro di gravit\w*|\bcg\b)[^\d]{0,25}(\d+(?:\.\d+)?)/); if(v!==null){ if(v>5) v=v/1000; if(v>0.25&&v<0.8) set('h', v, 'altezza CG m'); }
  v = num(/(\d{4,5})\s*(?:giri|rpm)/); if(v!==null && v>3000 && v<12000) set('rpmMax', v, 'rpm max');
  v = num(/(?:rapporto\s*finale|final\s*drive|coppia\s*conica)[^\d]{0,15}(\d+(?:\.\d+)?)/); if(v!==null && v>2 && v<7) set('finalDrive', v, 'rapporto finale');
  v = num(/(?:vmax|velocit\w*\s*mass\w*|top\s*speed)[^\d]{0,20}(\d{2,3})/); if(v!==null && v>120 && v<380) set('vmaxDecl', v, 'vmax dichiarata km/h');
  v = num(/circonferenz\w*[^\d]{0,20}(\d+(?:\.\d+)?)/); if(v!==null){ if(v>100) v=v/1000; if(v>1.4&&v<2.6) set('wheelCirc', v, 'circonferenza ruota m'); }
  else { v = num(/diametro\s*(?:ruota|gomma|pneumatic\w*)[^\d]{0,15}(\d+(?:\.\d+)?)/); if(v!==null){ if(v>10) v=v/1000; if(v>0.5&&v<0.8) set('wheelCirc', Math.round(v*Math.PI*100)/100, 'circonf. da diametro'); } }
  v = num(/cda[^\d]{0,12}(\d+(?:\.\d+)?)/); if(v!==null && v>0.4 && v<1.5) set('cdA0', v, 'CdA base');

  // trazione
  var dr = null;
  if(/trazione\s+anterior/.test(tl) || /\bfwd\b/.test(tl)) dr='FWD';
  if(/trazione\s+posterior/.test(tl) || /\brwd\b/.test(tl)) dr='RWD';
  if(/trazione\s+integral/.test(tl) || /\bawd\b|\b4wd\b|4x4/.test(tl)) dr='AWD';
  if(dr) set('drive', dr, 'trazione '+SA_DRIVES[dr].toLowerCase());

  // rapporti: cerca una sequenza di 4-8 numeri 0.5-5 dopo parole chiave
  var gm = tl.match(/(?:rapporti|marce|gears?|cambio)[^\n]*([\s\S]{0,160})/);
  if(gm){
    var cand = (gm[0].match(/\d\.\d{1,3}/g)||[]).map(parseFloat).filter(function(x){return x>0.5&&x<5.5;});
    // scarta il rapporto finale se gia' trovato
    if(cand.length>=4 && cand.length<=8){
      var fd = saGetParams(type).finalDrive;
      if(fd && Math.abs(cand[0]-fd)<0.001) cand.shift();
      if(fd && Math.abs(cand[cand.length-1]-fd)<0.001) cand.pop();
      // devono essere decrescenti in prevalenza
      var desc=0; for(var i=1;i<cand.length;i++) if(cand[i]<cand[i-1]) desc++;
      if(desc>=cand.length-2){ set('gearRatiosStr', cand.join(', '), cand.length+' rapporti'); }
    }
  }
  var nm = tl.match(/(\d)\s*(?:marce|rapporti|speed)/);
  if(nm) found.push('cambio dichiarato a '+nm[1]+' marce');

  if(rep){
    rep.innerHTML = found.length?
      '<span style="color:var(--green)">✔ Riconosciuti:</span> '+esc(found.join(' · '))+'<br><span class="small">Parametri aggiornati per tutte le vetture di tipo <b>'+type+'</b>.</span>' :
      '<span style="color:var(--yellow)">Nessun dato riconosciuto. Scrivi valori con etichette (es. "Massa: 1130 kg", "Trazione anteriore", "Rapporti: 3.62 2.10 1.51 1.19 0.97").</span>';
  }
  if(typeof showToast==='function' && found.length) showToast('🚗 Scheda vettura: '+found.length+' dati acquisiti');
  // rigenera griglia parametri se aperta
  var box = document.getElementById('sa-box-params-'+mode);
  if(box && box.style.display!=='none') box.innerHTML = saParamsHTML(mode, type);
  saRender(mode);
};



/* ---- Densita' aria dal meteo (p/RT) ---- */
function saAirDensity(){
  try {
    var tEl=document.getElementById('meteo-temp-air');
    var pEl=document.getElementById('meteo-pressure');
    var T = tEl? parseFloat(String(tEl.textContent).replace(',','.')) : NaN;
    var P = pEl? parseFloat(String(pEl.textContent).replace(',','.')) : NaN;
    if(!isFinite(P)||P<800||P>1100) P=1013.25;
    if(isFinite(T)&&T>-30&&T<55) return P*100/(287.05*(T+273.15));
  } catch(e){}
  return 1.225;
}

/* ---- Gomme: temperature I/M/O e verdetti (Smith cap.11) ---- */
var SA_TYKEY='REP_sa_tyres_v1';
function saTyGet(carId){ try { return (JSON.parse(localStorage.getItem(SA_TYKEY)||'{}'))[carId]||{}; } catch(e){ return {}; } }
function saTySet(carId,obj){ try { var o=JSON.parse(localStorage.getItem(SA_TYKEY)||'{}'); o[carId]=obj; localStorage.setItem(SA_TYKEY,JSON.stringify(o)); } catch(e){} }
window.saTyreSave = function(mode){
  var car=saCar(mode); if(!car) return;
  var d={};
  ['fl','fr','rl','rr'].forEach(function(w){
    d[w]={};
    ['i','m','o','p'].forEach(function(k){
      var el=document.getElementById('sa-ty-'+mode+'-'+w+'-'+k);
      var v = el && el.value!==''? parseFloat(String(el.value).replace(',','.')) : NaN;
      d[w][k]= isFinite(v)? v : null;
    });
  });
  saTySet(car.id,d);
  var vd=document.getElementById('sa-ty-verd-'+mode);
  if(vd){ var tv=saTyreVerdicts(mode,car,saReadFields(mode)); vd.innerHTML=tv?tv.html:''; }
  saQueueRender(mode);
};
function saTyreAxle(d, ws){
  var res={i:[],m:[],o:[],p:[]};
  ws.forEach(function(w){
    var x=d[w]||{};
    ['i','m','o','p'].forEach(function(k){ if(x[k]!==null&&x[k]!==undefined&&isFinite(x[k])) res[k].push(x[k]); });
  });
  function avg(a){ return a.length? a.reduce(function(sm,v){return sm+v;},0)/a.length : null; }
  return { i:avg(res.i), m:avg(res.m), o:avg(res.o), p:avg(res.p) };
}
function saTyreVerdicts(mode, car, cur){
  var d = saTyGet(car.id);
  var hasAny=false;
  ['fl','fr','rl','rr'].forEach(function(w){ var x=d[w]||{}; if(x.i!==null&&x.i!==undefined&&isFinite(x.i)) hasAny=true; });
  if(!hasAny) return null;
  var surf = SA_SURFACES[saSurfKey(mode)];
  var F = saTyreAxle(d,['fl','fr']), R = saTyreAxle(d,['rl','rr']);
  function axle(name, X, curCam){
    var parts=[], camOpt=null, tAvgV=null;
    if(X.i!==null&&X.o!==null){
      var dIO=X.i-X.o, target=8; // Smith: interno 10-25 F piu' caldo
      if(dIO<5){ var add=Math.min(1.0,(target-dIO)*0.06);
        parts.push('Δint-est '+dIO.toFixed(0)+'°C → serve PIÙ camber negativo (~−'+add.toFixed(1)+'°)');
        if(curCam!==null) camOpt=curCam-add; }
      else if(dIO>13){ var rem=Math.min(1.0,(dIO-target)*0.06);
        parts.push('Δint-est '+dIO.toFixed(0)+'°C → TROPPO camber negativo (~+'+rem.toFixed(1)+'°)');
        if(curCam!==null) camOpt=curCam+rem; }
      else { parts.push('camber OK (Δint-est '+dIO.toFixed(0)+'°C)'); if(curCam!==null) camOpt=curCam; }
    }
    if(X.i!==null&&X.m!==null&&X.o!==null){
      var dM=X.m-(X.i+X.o)/2;
      if(dM>3) parts.push('centro +'+dM.toFixed(0)+'°C → SOVRAPRESSIONE (−'+Math.min(0.3,dM*0.033).toFixed(2)+' bar)');
      else if(dM<-3) parts.push('centro '+dM.toFixed(0)+'°C → SOTTOPRESSIONE (+'+Math.min(0.3,-dM*0.033).toFixed(2)+' bar)');
      else parts.push('pressione OK');
    }
    var ts=[X.i,X.m,X.o].filter(function(x){return x!==null;});
    if(ts.length){
      tAvgV=ts.reduce(function(sm,v){return sm+v;},0)/ts.length;
      if(tAvgV<surf.tOptLo) parts.push('gomma FREDDA ('+tAvgV.toFixed(0)+'°C, finestra '+surf.tOptLo+'-'+surf.tOptHi+')');
      else if(tAvgV>surf.tOptHi) parts.push('gomma SURRISCALDATA ('+tAvgV.toFixed(0)+'°C)');
      else parts.push(tAvgV.toFixed(0)+'°C in finestra');
    }
    return { html:'<div class="small" style="margin-top:4px"><b>'+name+':</b> '+parts.join(' · ')+'</div>', camOpt:camOpt, tAvg:tAvgV };
  }
  var fx = axle('Anteriore', F, cur? cur.camberF:null);
  var rx = axle('Posteriore', R, cur? cur.camberR:null);
  var html = fx.html + rx.html;
  if(fx.tAvg!==null&&rx.tAvg!==null){
    var dFR=fx.tAvg-rx.tAvg;
    if(dFR>8) html+='<div class="small">Anteriore molto più caldo (+'+dFR.toFixed(0)+'°C): asse sovrasfruttato → conferma sottosterzo (Smith cap.11).</div>';
    else if(dFR<-8) html+='<div class="small">Posteriore molto più caldo ('+dFR.toFixed(0)+'°C): asse sovrasfruttato → conferma sovrasterzo.</div>';
  }
  return { html:html, camOptF:fx.camOpt, camOptR:rx.camOpt, tAvgF:fx.tAvg, tAvgR:rx.tAvg };
}
function saTyresHTML(mode){
  var car=saCar(mode); if(!car) return '';
  var d=saTyGet(car.id);
  try {
    var ts = mode==='rally'? (STATE.rallyTyres||{})[car.id] : (STATE.tyres||{})[car.id];
    var wh = ts && ts.current && ts.current.wheels;
    if(wh){ ['fl','fr','rl','rr'].forEach(function(w){
      d[w]=d[w]||{};
      if((d[w].m===undefined||d[w].m===null) && wh[w] && wh[w].temp!=='' && isFinite(parseFloat(wh[w].temp))) d[w].m=parseFloat(wh[w].temp);
      if((d[w].p===undefined||d[w].p===null) && wh[w] && isFinite(parseFloat(wh[w].pressure))) d[w].p=parseFloat(wh[w].pressure);
