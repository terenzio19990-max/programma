    '<button class="btn btn-blue" style="font-size:10px" onclick="saFitAero(\''+mode+'\')">FIT CdA DA VMAX</button>'+
    '<div class="field" style="max-width:150px"><label>ay REALE in curva (g)</label><input type="number" step="0.05" id="sa-gfit-'+mode+'" placeholder="es. 1.45"></div>'+
    '<button class="btn btn-blue" style="font-size:10px" onclick="saFitGrip(\''+mode+'\')" title="Misura la g laterale vera (v²/R su curva nota o dal logger) e taro il µ della gomma">FIT GRIP DA g</button>'+
    '<button class="btn btn-gray" style="font-size:10px" onclick="saCalReset(\''+mode+'\')">AZZERA CALIBRAZIONE</button></div>';
  html+='<div class="small" style="margin-top:4px;opacity:.75">I tempi reali dipendono anche da gomme, benzina, traffico e pilota: il fattore è volutamente smorzato.</div>';
