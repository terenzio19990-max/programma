function setSparePmode(mode) {
  _spareMode = mode;
  var lbl = document.getElementById('spare-mode-label');
  if(lbl) lbl.textContent = 'INVENTARIO ' + (mode==='track'?'PISTA':'RALLY');
  var bt = document.getElementById('spare-mode-track');
  var br = document.getElementById('spare-mode-rally');
  if(bt) { bt.className = mode==='track'?'btn btn-blue':'btn btn-gray'; bt.style.padding='5px 18px'; bt.style.fontSize='12px'; }
  if(br) { br.className = mode==='rally'?'btn btn-blue':'btn btn-gray'; br.style.padding='5px 18px'; br.style.fontSize='12px'; }
  _spareFilter = '';
  document.querySelectorAll('.spare-filter-btn').forEach(function(b){b.classList.remove('active');});
  var first = document.querySelector('.spare-filter-btn');
  if(first) first.classList.add('active');
  renderSpareParts();
  buildSpareSummary();
}
var _spareFilter = '';
function addSparePart() {
  var name = (document.getElementById('spare-name')||{}).value;
  if(!name||!name.trim()) return;
  name = name.trim();
  var cat  = (document.getElementById('spare-cat')||{}).value||'Altro';
  var qty  = +(document.getElementById('spare-qty')||{}).value||1;
  var note = (document.getElementById('spare-note-field')||{}).value||'';
  var minQty   = +(document.getElementById('spare-min')||{}).value || 0;
  var cost     = +(document.getElementById('spare-cost')||{}).value || 0;
  var supplier = (document.getElementById('spare-supplier')||{}).value || '';
  var leadDays = +(document.getElementById('spare-lead')||{}).value || 0;
  SPARE_PARTS[_spareMode].push({
    id:Date.now(), name:name, cat:cat, qty:qty, note:note, used:0,
    min: minQty, cost: cost, supplier: supplier.trim(), lead: leadDays,
    history: [],   // [{action:'add'|'use', qty:N, motivo:'...', at:ts}]
    createdAt: Date.now()
  });
  document.getElementById('spare-name').value='';
  if(document.getElementById('spare-note-field')) document.getElementById('spare-note-field').value='';
  if(document.getElementById('spare-qty')) document.getElementById('spare-qty').value='1';
  if(document.getElementById('spare-min')) document.getElementById('spare-min').value='2';
  if(document.getElementById('spare-cost')) document.getElementById('spare-cost').value='';
  if(document.getElementById('spare-supplier')) document.getElementById('spare-supplier').value='';
  if(document.getElementById('spare-lead')) document.getElementById('spare-lead').value='';
  _spareRefreshSuppliersList();
  renderSpareParts(); buildSpareSummary(); triggerAutoSave();
}
function useSparePart(id, motivo) {
  var parts = SPARE_PARTS[_spareMode];
  var p = parts.filter(function(x){return x.id===id;})[0];
  if(!p||p.qty<=0) return;
  p.qty--; p.used=(p.used||0)+1;
  if(!p.history) p.history = [];
  p.history.push({ action:'use', qty:1, motivo: motivo || '', at: Date.now() });
  renderSpareParts(); buildSpareSummary(); triggerAutoSave();
}
// Open a small prompt modal to ask "perché lo stai usando" then call useSparePart
function useSparePartWithReason(id){
  var parts = SPARE_PARTS[_spareMode];
  var p = parts.filter(function(x){return x.id===id;})[0];
  if(!p) return;
  // Pre-fill default motivo (sessione corrente, oppure semplice nome vettura corrente)
  var defaultMotivo = '';
  try {
    var sess = document.getElementById('session-type')?.value || '';
    var car = STATE.mode==='track' ? STATE.trackCars[STATE.selectedTrackCar] : STATE.rallyCars[STATE.selectedRallyCar];
    defaultMotivo = (car?car.name:'') + (sess?' · '+sess:'');
  } catch(_){}
  var motivo = prompt('Motivo / Vettura · Sessione (opzionale):\n\n"'+p.name+'" — usato 1', defaultMotivo);
  if(motivo === null) return; // canceled
  useSparePart(id, motivo);
}
window.useSparePartWithReason = useSparePartWithReason;

function addSpareQty(id,n,motivo) {
  var parts = SPARE_PARTS[_spareMode];
  var p = parts.filter(function(x){return x.id===id;})[0];
  if(p) {
    p.qty+=n;
    if(!p.history) p.history = [];
    p.history.push({ action:'add', qty:n, motivo:motivo||'', at:Date.now() });
    renderSpareParts(); buildSpareSummary(); triggerAutoSave();
  }
}
function removeSparePart(id) {
  if(!confirm('Rimuovere?')) return;
  SPARE_PARTS[_spareMode] = SPARE_PARTS[_spareMode].filter(function(p){return p.id!==id;});
  renderSpareParts(); buildSpareSummary(); triggerAutoSave();
}

// Rebuild the suppliers datalist from existing parts (for autocomplete)
function _spareRefreshSuppliersList(){
  var dl = document.getElementById('spare-suppliers-list');
  if(!dl) return;
  var all = [].concat(SPARE_PARTS.track||[], SPARE_PARTS.rally||[]);
  var sup = Array.from(new Set(all.map(function(p){return (p.supplier||'').trim();}).filter(Boolean))).sort();
  dl.innerHTML = sup.map(function(s){return '<option value="'+s.replace(/"/g,'&quot;')+'">';}).join('');
