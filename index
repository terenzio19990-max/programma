// Opens a new browser window on the same URL, but with a #page=XXX hash so the
// secondary window automatically switches to that page. Data stays in-sync via
// the shared IndexedDB/localStorage autosave.
function _openMultiWindow(page, name, width, height, left, top){
  var base = window.location.href.split('#')[0];
  var url = base + '#page=' + encodeURIComponent(page);
  var features = 'width='+width+',height='+height+',left='+left+',top='+top+',toolbar=no,menubar=no,location=no,status=no,resizable=yes,scrollbars=yes';
  var wnd = window.open(url, name, features);
  if(!wnd){
    var warn = document.getElementById('ms-warning');
    if(warn) warn.style.display='block';
    showToast('⚠️ Popup bloccati — autorizza i popup e riprova');
    return null;
  }
  return wnd;
}

function launchMultiScreen(n){
  var W = screen.availWidth || 1920;
  var H = screen.availHeight || 1080;
  var pages;
  if(n===2)      pages = ['laps','tyres'];
  else if(n===3) pages = ['laps','competitors','tyres'];
  else           pages = ['dashboard','laps','tyres','setup'];
  // Arrange in a grid
  var cols = n<=2 ? n : 2;
  var rows = Math.ceil(n/cols);
  var ww = Math.floor(W/cols);
  var hh = Math.floor(H/rows);
  var opened = 0;
  // Switch main window to first page
  if(typeof showPage==='function') showPage(pages[0]);
  // Main window resize (position 0,0 top-left)
  try { window.moveTo(0,0); window.resizeTo(ww,hh); } catch(e){}
  // Open slave windows for the remaining pages
  for(var i=1;i<pages.length;i++){
    var c = i % cols;
    var r = Math.floor(i/cols);
    var wnd = _openMultiWindow(pages[i], 'REP_scr_'+i, ww, hh, c*ww, r*hh);
    if(wnd) opened++;
  }
  document.getElementById('multiscreen-modal').style.display='none';
  showToast('🖥 '+(opened+1)+' schermi aperti — trascinali sui monitor desiderati');
}

function launchSinglePage(){
  var sel = document.getElementById('multi-page-sel');
  var page = sel ? sel.value : 'laps';
  var W = screen.availWidth || 1920, H = screen.availHeight || 1080;
  _openMultiWindow(page, 'REP_'+page+'_'+Date.now(), Math.floor(W*0.5), Math.floor(H*0.7), Math.floor(W*0.5), Math.floor(H*0.15));
}

// Check URL hash on startup: if #page=XXX, switch to that page after init
function applyHashPage(){
  try {
    var h = window.location.hash || '';
    var m = h.match(/page=([^&]+)/);
    if(m && m[1]){
      var pg = decodeURIComponent(m[1]);
