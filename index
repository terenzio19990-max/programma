// ═══════════════════════════════════════════════════════════════
// DOCUMENT STORAGE INDICATOR
// ═══════════════════════════════════════════════════════════════
function getStorageInfo() {
  let used = 0;
  try {
    for(let k in localStorage) {
      if(localStorage.hasOwnProperty(k)) used += localStorage[k].length * 2;
    }
  } catch(e) {}
  const docs = [...DOCS.track,...DOCS.rally];
  const docsSize = docs.reduce((a,d)=>a+(d.dataUrl?d.dataUrl.length*0.75:0), 0);
  return {
    lsUsedKb: Math.round(used/1024),
    lsMaxKb: 5120,
    docsSizeKb: Math.round(docsSize/1024),
    docsCount: docs.length,
    docsBlocked: docs.filter(d=>!d.dataUrl).length
  };
}

function buildDocStorageIndicator(mode) {
  const el = document.getElementById('doc-'+mode+'-summary');
  if(!el) return;
  const info = getStorageInfo();
  const pct = Math.round(info.lsUsedKb/info.lsMaxKb*100);
  const color = pct>80?'var(--red)':pct>60?'var(--yellow)':'var(--green)';
  const docs = DOCS[mode];
  const totalKb = docs.reduce((a,d)=>a+(d.dataUrl?Math.round(d.dataUrl.length*0.75/1024):0),0);
  const total=docs.length, pdfs=docs.filter(d=>d.type==='pdf').length, imgs=docs.filter(d=>d.type==='image').length;
  const blocked=docs.filter(d=>!d.dataUrl).length;

  el.innerHTML =
    (total?
      '<div class="g2" style="gap:8px;margin-bottom:8px;">' +
        '<div class="tile"><div class="tile-label">TOTALE</div><div class="tile-value">'+total+'</div></div>' +
        '<div class="tile"><div class="tile-label">PDF / IMG</div><div class="tile-value">'+pdfs+' / '+imgs+'</div></div>' +
      '</div>' : '') +
    '<div style="margin-bottom:6px;">' +
      '<div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-bottom:3px;">' +
        '<span>💾 Spazio localStorage</span><span style="font-family:var(--mono);">'+info.lsUsedKb+'KB / '+info.lsMaxKb+'KB ('+pct+'%)</span>' +
      '</div>' +
      '<div style="height:5px;background:var(--border);border-radius:3px;overflow:hidden;">' +
        '<div style="height:100%;width:'+Math.min(100,pct)+'%;background:'+color+';border-radius:3px;transition:width .3s;"></div>' +
      '</div>' +
    '</div>' +
    (totalKb>0?'<div style="font-size:11px;color:var(--text3);">Documenti: '+totalKb+'KB</div>':'') +
    (blocked>0?'<div style="font-size:11px;color:var(--yellow);margin-top:4px;">⚠️ '+blocked+' doc. troppo grandi per il salvataggio sessione (usa ⬇ Download)</div>':'') +
    (pct>80?'<div style="font-size:11px;color:var(--red);margin-top:4px;">⚠️ Spazio quasi esaurito — esporta la sessione in JSON</div>':'') +
    (total===0?'<div style="color:var(--text3);">Nessun documento</div>':'');
}

