function addNewCar() {
  const name = document.getElementById('new-car-name')?.value?.trim();
  const cat  = document.getElementById('new-car-category')?.value?.trim() || 'Vetture';
  const mode = document.getElementById('new-car-mode')?.value || 'track';
  const color = document.getElementById('new-car-color')?.value || '#e8421a';
  if(!name) { showToast('⚠️ Inserisci il nome della vettura'); return; }
  _carCounter++;
  const id = (mode==='track'?'TK':'RL') + '_' + _carCounter;
  const car = { id, name, type: mode==='track'?'custom':'lancia', category: cat, color, retired: false };
  if(mode==='track') {
    STATE.trackCars.push(car);
    initCarData(car.id);
  } else {
    STATE.rallyCars.push(car);
    STATE.rallyTyres[car.id] = { current:null, history:[], spare:{compound:'S',pressure:2.2,wear:0,damage:'none',note:''} };
    STATE.rallyFuel[car.id]  = { capacity:60, current:60, consSS:0.18, consTF:0.08, totalUsed:0, log:[] };
    STATE.rallySetup[car.id] = [];
    STATE.rallyTeleNotes[car.id] = [];
    initCarData(car.id);
  }
  document.getElementById('new-car-name').value = '';
  renderCarManagerList();
  rebuildAllCarTabs();
  // Immediate save (no debounce) so a quick refresh keeps the new car
  if(typeof autoSave === 'function') { try { autoSave(); } catch(e){} }
  if(typeof autoSaveIDB === 'function') { try { autoSaveIDB(); } catch(e){} }
  showToast(`✅ Vettura "${name}" aggiunta`);
}

function editCar(mode, idx, field, value) {
  const cars = mode==='track' ? STATE.trackCars : STATE.rallyCars;
  if(!cars[idx]) return;
  cars[idx][field] = value;
  rebuildAllCarTabs();
  // Immediate save so changes survive a quick refresh
  if(typeof autoSave === 'function') { try { autoSave(); } catch(e){} }
  if(typeof autoSaveIDB === 'function') { try { autoSaveIDB(); } catch(e){} }
}

function removeCar(mode, idx) {
  const cars = mode==='track' ? STATE.trackCars : STATE.rallyCars;
  if(!cars[idx]) return;
  if(!confirm('Rimuovere questa vettura? I dati associati verranno eliminati.')) return;
  const car = cars[idx];
  cars.splice(idx, 1);
  // Clean up data
  delete STATE.laps[car.id]; delete STATE.tyres[car.id]; delete STATE.fuel[car.id];
  delete STATE.setup[car.id]; delete STATE.damage[car.id]; delete STATE.teleNotes[car.id];
  delete STATE.positions[car.id];
  if(mode==='rally') {
    delete STATE.rallyTyres[car.id]; delete STATE.rallyFuel[car.id];
    delete STATE.rallySetup[car.id]; delete STATE.rallyTeleNotes[car.id];
  }
  // Fix selected index
  if(mode==='track' && STATE.selectedTrackCar >= STATE.trackCars.length) STATE.selectedTrackCar = Math.max(0, STATE.trackCars.length-1);
  if(mode==='rally' && STATE.selectedRallyCar >= STATE.rallyCars.length) STATE.selectedRallyCar = Math.max(0, STATE.rallyCars.length-1);
  // Clean up per-car chrono state
  try {
    if(_chronoStore && _chronoStore.cars && _chronoStore.cars[car.id]){
      delete _chronoStore.cars[car.id];
      _chronoSave();
    }
  } catch(_){}
  renderCarManagerList();
  rebuildAllCarTabs();
  // Re-bind chrono in case the deleted car was the active one
  if(typeof _chronoRebind === 'function') _chronoRebind();
  // Immediate save (no debounce)
  if(typeof autoSave === 'function') { try { autoSave(); } catch(e){} }
  if(typeof autoSaveIDB === 'function') { try { autoSaveIDB(); } catch(e){} }
  showToast('🗑 Vettura rimossa');
}

function rebuildAllCarTabs() {
  // Use the comprehensive refresh helper if available — it covers ALL tabs,
  // selectors, panels, dropdown filters, and analytics pages.
  if(typeof refreshAllCarNameDisplays === 'function'){
    refreshAllCarNameDisplays();
    return;
  }
  // Fallback (legacy behaviour) if for some reason the helper isn't loaded yet
  buildTrackCarTabs();
