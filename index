// Parse pasted text into PS rows. Heuristic similar to bulkAnalyze for laps,
// but column meanings: ps_num, name, km, time, abs_pos, cls_pos, note.
function psBulkAnalyze(){
  var txt = (document.getElementById('ps-bulk-paste')||{}).value||'';
  var st = document.getElementById('ps-bulk-status');
  if(!txt.trim()){ if(st) st.innerHTML='<span style="color:var(--yellow)">Nessun testo da analizzare</span>'; return; }
  var startNum = +(document.getElementById('ps-bulk-start-num')||{}).value || 1;
  var rows = txt.split(/\r?\n/).map(function(l){return l.trim();}).filter(function(l){return l.length>0;});

  // Detect headers
  var headers = null, headerIdx = -1;
  for(var i=0;i<Math.min(rows.length,5);i++){
    var low = rows[i].toLowerCase();
    if(/\b(ps|tempo|time|nome|name)\b/.test(low) && !/^\d/.test(rows[i].trim())){
      headers = rows[i].split(/[,;\t]/).map(function(h){return h.replace(/["']/g,'').trim().toLowerCase();});
      headerIdx = i; break;
    }
  }
  var psIdx=-1, nameIdx=-1, kmIdx=-1, timeIdx=-1, absIdx=-1, clsIdx=-1, noteIdx=-1;
  var sep = null;
  if(headers){
    psIdx   = headers.findIndex(function(h){return h==='ps'||h==='ps#'||h==='n'||h==='#'||h==='num';});
    nameIdx = headers.findIndex(function(h){return h==='nome'||h==='name'||h==='stage';});
    kmIdx   = headers.findIndex(function(h){return h==='km'||h==='dist'||h==='distance'||h==='lunghezza';});
    timeIdx = headers.findIndex(function(h){return h==='time'||h==='tempo'||h==='ps time';});
    absIdx  = headers.findIndex(function(h){return h==='pos.ass'||h==='pos ass'||h==='pos assoluta'||h==='abs'||h==='absolute';});
    clsIdx  = headers.findIndex(function(h){return h==='pos.cls'||h==='pos cls'||h==='pos classe'||h==='cls'||h==='class';});
    noteIdx = headers.findIndex(function(h){return h==='note'||h==='notes'||h==='comment';});
    var orig = rows[headerIdx];
    if(orig.indexOf(',')>=0) sep=',';
    else if(orig.indexOf(';')>=0) sep=';';
    else if(orig.indexOf('\t')>=0) sep='\t';
  }
  var dataRows = headers ? rows.slice(headerIdx+1) : rows;

  var parsed = [];
  var skipped = [];
  var autoNum = startNum;

  function splitRow(line){
    if(sep) return line.split(sep).map(function(v){return v.replace(/["']/g,'').trim();});
    if(line.indexOf('\t')>=0) return line.split(/\t+/).map(function(v){return v.trim();});
    if(/\s{2,}/.test(line)) return line.split(/\s{2,}/).map(function(v){return v.trim();});
    if(line.indexOf(',')>=0) return line.split(',').map(function(v){return v.trim();});
    if(line.indexOf(';')>=0) return line.split(';').map(function(v){return v.trim();});
    return line.split(/\s+/);
  }

  dataRows.forEach(function(line){
    if(/^\s*$/.test(line)) return;
    if(/^[-=_]{3,}$/.test(line)) return;
    // "PS1: 8:23.456" or "PS1 8:23.456"
    var m1 = line.match(/^\s*(?:ps)\s*:?\s*(\d+)\s*[:\-\t ]+(.+)$/i);
    if(m1){
      var t = parseTime(m1[2].split(/\s+/)[0]);
      if(t){ parsed.push({num:+m1[1]||autoNum++, name:'', km:0, time:msToTime(t), absPos:1, clsPos:1, note:''}); return; }
    }
    var cols = splitRow(line);
    if(headers){
      var time = timeIdx>=0 ? cols[timeIdx] : null;
      var ms = parseTime(time);
      if(!ms){ skipped.push(line); return; }
      parsed.push({
        num:    psIdx>=0 ? (+cols[psIdx] || autoNum++) : autoNum++,
        name:   nameIdx>=0 ? cols[nameIdx]||'' : '',
        km:     kmIdx>=0 ? (parseFloat((cols[kmIdx]||'').replace(',','.'))||0) : 0,
        time:   msToTime(ms),
        absPos: absIdx>=0 ? (+cols[absIdx]||1) : 1,
        clsPos: clsIdx>=0 ? (+cols[clsIdx]||1) : 1,
        note:   noteIdx>=0 ? cols[noteIdx]||'' : ''
      });
      return;
    }
    // Heuristic without headers:
    // Try to find a time-like token among cols
    var timeCol = -1, timeMs = null;
    for(var i=0;i<cols.length;i++){
      var maybe = parseTime(cols[i]);
      if(maybe && maybe > 30000){ // PS times are usually > 30s
        timeCol = i; timeMs = maybe; break;
      }
    }
    if(!timeMs){ skipped.push(line); return; }
    var num = autoNum;
    var name = '';
    var km = 0;
    var absPos = 1, clsPos = 1;
    // Cols before time:
    //   1 col → that's the PS num
    //   2 cols → num, name
    //   3 cols → num, name, km
    var preCols = cols.slice(0, timeCol);
    if(preCols.length >= 1){
      var n = parseInt(preCols[0]);
      if(!isNaN(n) && n > 0 && n < 100){
        num = n;
      } else {
        autoNum++;
        name = preCols[0];
      }
    } else {
      autoNum++;
    }
    if(num === autoNum) autoNum = num + 1;
    if(preCols.length >= 2 && !name){
      name = preCols[1];
    }
    if(preCols.length >= 3){
      var kmVal = parseFloat((preCols[2]||'').replace(',','.'));
      if(!isNaN(kmVal) && kmVal > 0) km = kmVal;
      else if(!name) name = preCols[2];
    }
    // Cols after time → positions
    var postCols = cols.slice(timeCol+1);
    if(postCols.length >= 1) absPos = +postCols[0] || 1;
    if(postCols.length >= 2) clsPos = +postCols[1] || 1;

    parsed.push({
      num: num, name: name, km: km,
      time: msToTime(timeMs),
      absPos: absPos, clsPos: clsPos, note: ''
    });
  });

  // Render preview
  var tbody = document.getElementById('ps-bulk-preview-tbody');
  var preview = document.getElementById('ps-bulk-preview');
  if(!tbody) return;
  tbody.innerHTML = parsed.map(function(p, idx){
    return '<tr>'+
      '<td><input type="checkbox" class="ps-bulk-chk" checked></td>'+
      '<td><input type="number" class="ps-bulk-num" value="'+p.num+'" style="width:50px;"></td>'+
      '<td><input type="text" class="ps-bulk-name" value="'+(p.name||'').replace(/"/g,'&quot;')+'" style="width:140px;"></td>'+
      '<td><input type="number" class="ps-bulk-km" step="0.1" value="'+(p.km||0)+'" style="width:60px;"></td>'+
      '<td><input type="text" class="ps-bulk-time" value="'+p.time+'" style="width:90px;"></td>'+
      '<td><input type="number" class="ps-bulk-abs" value="'+(p.absPos||1)+'" style="width:50px;"></td>'+
      '<td><input type="number" class="ps-bulk-cls" value="'+(p.clsPos||1)+'" style="width:50px;"></td>'+
      '<td><input type="text" class="ps-bulk-note" value="'+(p.note||'').replace(/"/g,'&quot;')+'" style="width:140px;"></td>'+
    '</tr>';
  }).join('');
  if(preview) preview.style.display = parsed.length ? 'block' : 'none';
  var btn = document.getElementById('ps-bulk-confirm-btn');
  var cn = document.getElementById('ps-bulk-count');
  if(btn){ btn.disabled = parsed.length===0; btn.style.opacity = parsed.length?'1':'.4'; }
  if(cn) cn.textContent = parsed.length;
  if(st){
    if(parsed.length) st.innerHTML='<span style="color:var(--green)">✓ '+parsed.length+' PS pronte</span>'+(skipped.length?' <span style="color:var(--yellow)">('+skipped.length+' righe ignorate)</span>':'');
    else st.innerHTML='<span style="color:var(--red)">✗ Nessuna PS valida trovata</span>';
  }
}
window.psBulkAnalyze = psBulkAnalyze;

