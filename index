// ── Hook save into key actions (debounced auto-save) ──
let _autoSaveDebounce;
let _autoSaveLastHash = null;
function triggerAutoSave() {
  clearTimeout(_autoSaveDebounce);
  // 5s instead of 3s: when user adds many laps quickly, defer save until they pause.
  // Concrete benefit: 20 laps in 60s → 1 save instead of 1 save every 3s.
  _autoSaveDebounce = setTimeout(function(){
    // Smart dirty check: build a fingerprint that catches not just additions but also
    // modifications (lap edits, deletions+re-adds within debounce window).
    // We include lap/stage timestamps and a sum of times — much harder to coincidentally match.
    try {
      var hash = '';
      try {
        var totalLaps = 0, lapsTsSum = 0, lapsTimeSum = 0;
        Object.keys(STATE.laps||{}).forEach(function(k){
          (STATE.laps[k]||[]).forEach(function(l){
            totalLaps++;
            lapsTsSum += (+l.ts || 0);
            // Add a fingerprint of the lap content (helps detect edits)
            var t = parseTime(l.time) || 0;
            lapsTimeSum += t;
          });
        });
        var stagesTsSum = 0, stagesTimeSum = 0;
        (STATE.stages||[]).forEach(function(s){
          stagesTsSum += (+s.ts || 0);
          stagesTimeSum += (parseTime(s.time) || 0);
        });
        // Concatenate: all components must match for hash to match
        hash = 'L'+totalLaps+'/'+lapsTsSum+'/'+lapsTimeSum+
               'S'+((STATE.stages||[]).length)+'/'+stagesTsSum+'/'+stagesTimeSum+
               'C'+((STATE.trackCars||[]).length+(STATE.rallyCars||[]).length);
      } catch(_){ hash = String(Date.now()); }
      if(hash === _autoSaveLastHash){
        // Nothing changed — skip the heavy save
        return;
      }
      _autoSaveLastHash = hash;
    } catch(_){}
    autoSave();
  }, 5000);
}

// Allow forcing the next autosave to run even if hash matches
// (e.g. after edit operations that might not change the hash but did change other fields).
window.markStateDirty = function(){ _autoSaveLastHash = null; };



