// ── Manual save ──
function saveSession(name) {
  const nm = name || document.getElementById('session-save-name')?.value?.trim() || autoSessionName();
  const snap = serializeSession();
  snap.name = nm;
  const list = getAllSessions();
  // Replace if same name exists, else prepend
  const idx = list.findIndex(s=>s.name===nm);
  if(idx>=0) list[idx]=snap; else list.unshift(snap);
  if(saveAllSessions(list)) {
    showToast(`✅ Sessione "${nm}" salvata`);
    renderSessionList();
    if(document.getElementById('session-save-name')) document.getElementById('session-save-name').value='';
  }
}

