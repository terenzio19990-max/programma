// ═══════════════════════════════════════════════════════════════
// NOTIFICATION ENGINE
// ═══════════════════════════════════════════════════════════════
let _notifHistory = [];
let _notifCount = 0;
let _notifPanelOpen = false;
let _notifSeen = {};   // dedup: key -> timestamp last fired
const NOTIF_COOLDOWN = 60000; // 1 min between same alert

function pushNotif(type, icon, title, msg, opts={}) {
  // Native notification for critical/warn
  if((type==='crit'||type==='warn')&&typeof Notification!=='undefined'&&Notification.permission==='granted'&&(document.hidden||!document.hasFocus())){
    try{var n=new Notification('RaceEngPro: '+title,{body:msg.replace(/<[^>]+>/g,''),tag:title});setTimeout(function(){n.close();},5000);}catch(e){}
  }
  const key = opts.key || (type+title);
  const now = Date.now();
  if(_notifSeen[key] && now - _notifSeen[key] < (opts.cooldown||NOTIF_COOLDOWN)) return;
  _notifSeen[key] = now;

  const id = ++_notifCount;
  const time = new Date().toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  const card = {id, type, icon, title, msg, time};
  _notifHistory.unshift(card);
  if(_notifHistory.length > 50) _notifHistory.pop();

  // Show floating card
  const drawer = document.getElementById('notif-drawer');
  if(drawer) {
    const el = document.createElement('div');
    el.className = 'notif-card notif-'+type;
    el.id = 'notif-'+id;
    el.innerHTML =
      '<div class="notif-icon">'+icon+'</div>' +
      '<div class="notif-body">' +
        '<div class="notif-title">'+title+'</div>' +
        '<div class="notif-msg">'+msg+'</div>' +
        '<div class="notif-time">'+time+'</div>' +
      '</div>' +
      '<button class="notif-close" onclick="dismissNotif('+id+')">✕</button>';
    drawer.appendChild(el);
    // Auto dismiss after 8s (critical stay longer)
    setTimeout(() => dismissNotif(id), type==='crit'?14000:8000);
  }

  // Update badge
  updateNotifBadge();
  renderNotifHistory();

  // Sound feedback (optional click sound)
  if(opts.sound !== false) {
    try {
      const ctx = new (window.AudioContext||window.webkitAudioContext)();
      const o = ctx.createOscillator(); const g = ctx.createGain();
      o.connect(g); g.connect(ctx.destination);
      o.frequency.value = type==='crit'?440:type==='warn'?520:660;
      g.gain.setValueAtTime(0.08, ctx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime+0.3);
      o.start(); o.stop(ctx.currentTime+0.3);
    } catch(e) {}
  }
}

function dismissNotif(id) {
  const el = document.getElementById('notif-'+id);
  if(el) { el.style.opacity='0'; el.style.transform='translateX(120%)'; el.style.transition='all .25s'; setTimeout(()=>el.remove(),260); }
}

