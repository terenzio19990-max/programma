/* ---- Coerenza modello / gomme / pilota (voto a 3) ---- */
function saDriverVote(mode, car){
  try {
    var texts=[];
    var notes = (STATE.teleNotes&&STATE.teleNotes[car.id])||[];
    notes.slice(-5).forEach(function(n){ texts.push(String(n.note||n.text||n)); });
    var hist = mode==='rally'? ((STATE.rallySetup||{})[car.id]||[]) : ((STATE.setup||{})[car.id]||[]);
    hist.slice(-2).forEach(function(e){ texts.push(String(e.notes||'')); });
    var t=texts.join(' ').toLowerCase();
    var us=/sottosterz|understeer|non gira|spinge dritt/.test(t);
    var os=/sovrasterz|oversteer|scoda|gira troppo|nervosa dietro/.test(t);
    if(us&&!os) return 'und';
    if(os&&!us) return 'ovr';
    return null;
  } catch(e){ return null; }
}
function saCoherenceHTML(mode, A, ctx){
  try {
    var car=ctx&&ctx.car; if(!car) return '';
    var votes=[];
    var mv=saClassifyU(A.phases.mid.U).cls; votes.push(['Modello', mv]);
    var tv=ctx.tyres && ctx.tyres.tAvgF!==undefined? ctx.tyres : null;
    var gv2=null;
    if(tv && tv.tAvgF!==null && tv.tAvgR!==null){
      var d=tv.tAvgF-tv.tAvgR;
      gv2 = d>4? 'und' : d<-4? 'ovr' : 'neu';
      votes.push(['Gomme', gv2]);
    }
    var dv=saDriverVote(mode, car);
    if(dv) votes.push(['Pilota', dv]);
    if(votes.length<2) return '';
    function lbl(c){ return c==='und'?'SOTTO':c==='ovr'?'SOVRA':'NEUTRO'; }
    var counts={}; votes.forEach(function(v){ counts[v[1]]=(counts[v[1]]||0)+1; });
    var agree=Math.max.apply(null,Object.keys(counts).map(function(k){return counts[k];}));
    var html='<div class="small" style="margin:4px 0;padding:6px 10px;background:var(--bg3);border:1px solid var(--border);border-radius:6px">🧭 <b>Coerenza</b>: '+
      votes.map(function(v){ return v[0]+'='+lbl(v[1]); }).join(' · ')+' → <b>'+agree+'/'+votes.length+' concordi</b>';
    if(gv2 && gv2!==mv && gv2!=='neu' && mv!=='neu'){
      var dir=gv2==='und'? '+1':'-1';
      html+=' — le GOMME contraddicono il modello: <button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="saCoherenceApply(\''+mode+'\','+dir+')">TARA h CG '+(dir==='+1'?'+':'−')+'10 mm</button>';
    }
    return html+'</div>';
  } catch(e){ return ''; }
}
window.saCoherenceApply = function(mode, dir){
