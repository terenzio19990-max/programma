  // Total km (approx from circuit)
  var trackKm = STATE.circuit && CIRCUITS[STATE.circuit] ? CIRCUITS[STATE.circuit].km : 0;
  var totalKm = trackKm * totalLaps;

  // Executive summary
  html += '<h2>📊 EXECUTIVE SUMMARY</h2>';
  html += '<div class="grid6">';
  html += '<div class="tile"><div class="tl">GIRI TOTALI</div><div class="tv">'+totalLaps+'</div></div>';
  html += '<div class="tile"><div class="tl">KM PERCORSI</div><div class="tv">'+(totalKm?totalKm.toFixed(1)+' km':'—')+'</div></div>';
  html += '<div class="tile"><div class="tl">BEST OVERALL</div><div class="tvs" style="color:#2cbc6e;">'+(overallBest?msToTime(overallBest):'—')+'</div><div class="tsub">'+(overallBestCar?overallBestCar.name:'—')+'</div></div>';
