          '<div style="font-size:13px;color:var(--text1);"><b>'+prev.year+'</b> → <b>'+curr.year+'</b></div>'+
          '<div style="font-size:11px;color:var(--text3);">Best: '+_seasonsFmtMs(prev.best)+' → '+_seasonsFmtMs(curr.best)+'</div>'+
        '</div>'+
        '<div style="font-family:var(--mono);font-size:18px;font-weight:700;color:'+color+';">'+arrow+' '+(delta>=0?'+':'')+(delta/1000).toFixed(3)+'s</div>'+
      '</div>';
    }
    html += '</div></div>';
  }

  // ─── Per-car YoY: same car across multiple seasons ─────────────
  // Useful when same car (LR4) raced in 2 seasons
  var carIdsAcrossYears = {}; // carId -> [{year, best}]
  Object.keys(buckets).forEach(function(y){
    var byCar = {};
    buckets[y].laps.forEach(function(l){
      if(!byCar[l.car.id]) byCar[l.car.id] = { name: l.car.name, type: l.car.type, times: [] };
      byCar[l.car.id].times.push(l.ms);
    });
    Object.keys(byCar).forEach(function(cid){
      if(!carIdsAcrossYears[cid]) carIdsAcrossYears[cid] = { name: byCar[cid].name, type: byCar[cid].type, byYear: {} };
      carIdsAcrossYears[cid].byYear[y] = Math.min.apply(null, byCar[cid].times);
    });
  });
  var carsMulti = Object.keys(carIdsAcrossYears).filter(function(cid){
    return Object.keys(carIdsAcrossYears[cid].byYear).length >= 2;
  });
  if(carsMulti.length){
    html += '<div class="panel"><div class="panel-head">🚗 STESSA VETTURA TRA STAGIONI</div><div class="panel-body" style="overflow-x:auto;">';
    var allYears = stats.map(function(s){return s.year;}).sort();
    html += '<table class="data-table" style="font-size:11px;"><thead><tr><th>VETTURA</th>'+
      allYears.map(function(y){return '<th>'+y+'</th>';}).join('')+
      '<th>EVOLUZIONE</th></tr></thead><tbody>';
    carsMulti.forEach(function(cid){
      var c = carIdsAcrossYears[cid];
      var col = c.type === 'rally' ? 'var(--green)' : 'var(--accent)';
      var bestPerYear = allYears.map(function(y){return c.byYear[y]||null;});
      html += '<tr>';
      html += '<td><span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:'+col+';margin-right:6px;vertical-align:middle;"></span><b>'+c.name+'</b></td>';
      bestPerYear.forEach(function(b){
        html += '<td style="font-family:var(--mono);">'+(b ? _seasonsFmtMs(b) : '<span style="color:var(--text3);">—</span>')+'</td>';
      });
      // Trend: first vs last
      var first = bestPerYear.find(function(b){return b!==null;});
      var last  = bestPerYear.slice().reverse().find(function(b){return b!==null;});
      if(first && last && first !== last){
        var d = last - first;
        var col2 = d < -100 ? 'var(--green)' : d > 100 ? 'var(--red)' : 'var(--text3)';
        html += '<td style="font-family:var(--mono);font-weight:700;color:'+col2+';">'+(d>=0?'+':'')+(d/1000).toFixed(3)+'s</td>';
      } else {
        html += '<td>—</td>';
      }
      html += '</tr>';
    });
    html += '</tbody></table></div></div>';
  }

  c.innerHTML = html;
}
window.renderSeasonsComparePage = renderSeasonsComparePage;

