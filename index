    form.append('file', new Blob([jsonStr], {type:GDRIVE_MIME}));
    return fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name,createdTime', {
      method: 'POST',
      headers: { Authorization: 'Bearer ' + _gdriveToken },
      body: form
    });
  }).then(function(r){ return r.json(); }).then(function(file){
    if(btn) btn.textContent = oldText;
    if(file.id) {
      showToast('Salvato su Drive: ' + filename);
      gdriveRefreshList();
      gdriveRefreshList();
    } else {
      showToast('Errore salvataggio: ' + JSON.stringify(file.error || file));
    }
  }).catch(function(err){
    if(btn) btn.textContent = oldText;
    showToast('Errore Drive: ' + err.message);
    console.error(err);
  });
}

// ── List files on Drive ──
function gdriveRefreshList() {
  if(!_gdriveToken) return;
  var el = document.getElementById('gdrive-file-list');
  if(!el) return;
  el.innerHTML = '<div style="text-align:center;color:var(--text3);padding:16px;font-size:12px;">&#8987; Caricamento lista...</div>';

  gdriveGetFolderId().then(function(folderId){
    var q = encodeURIComponent("'" + folderId + "' in parents and trashed=false and mimeType='" + GDRIVE_MIME + "'");
    return fetch(
      'https://www.googleapis.com/drive/v3/files?q=' + q + '&orderBy=createdTime%20desc&fields=files(id%2Cname%2CcreatedTime%2Csize)&pageSize=50',
      { headers: { Authorization: 'Bearer ' + _gdriveToken } }
    );
  }).then(function(r){ return r.json(); }).then(function(data){
    if(!data.files || !data.files.length) {
      el.innerHTML = '<div style="text-align:center;color:var(--text3);padding:24px;font-size:12px;">Nessuna sessione salvata su Drive.<br><span style="font-size:11px;">Premi "Salva sessione attuale" per iniziare.</span></div>';
      return;
    }
    el.innerHTML = data.files.map(function(f){
      var date = f.createdTime ? new Date(f.createdTime).toLocaleString('it-IT') : '—';
      var size = f.size ? (f.size/1024).toFixed(1)+'KB' : '';
      var parts = f.name.replace('.json','').split('_');
      var mode = parts[1] || '';
      var badgeColor = mode==='PISTA' ? 'var(--blue)' : 'var(--green)';
      return '<div class="gdrive-file" onclick="gdriveLoadFile(\'' + f.id + '\',\'' + f.name.replace(/'/g,"\\'") + '\')">'
        + '<div class="gdrive-file-icon">&#128196;</div>'
        + '<div style="flex:1;min-width:0;">'
        + '<div class="gdrive-file-name" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="' + f.name + '">' + f.name.replace('.json','') + '</div>'
        + '<div class="gdrive-file-date">' + date + (size?' &middot; '+size:'') + '</div>'
        + '</div>'
        + (mode ? '<span class="badge" style="background:rgba(0,0,0,.3);border:1px solid '+badgeColor+';color:'+badgeColor+';font-size:10px;padding:1px 6px;flex-shrink:0;">' + mode + '</span>' : '')
        + '<button onclick="event.stopPropagation();gdriveDeleteFile(\'' + f.id + '\',this)" class="btn btn-gray" style="padding:3px 8px;font-size:11px;flex-shrink:0;">&#128465;</button>'
        + '</div>';
    }).join('');
  }).catch(function(err){
    el.innerHTML = '<div style="color:var(--red);padding:12px;font-size:12px;">Errore caricamento lista: ' + err.message + '</div>';
  });
}

// ── Load a file from Drive ──
function gdriveLoadFile(fileId, fileName) {
  if(!_gdriveToken) return;
  if(!confirm('Caricare "' + fileName + '"?\nLa sessione corrente verrà sovrascritta.')) return;

  var el = document.getElementById('gdrive-file-list');
  if(el) el.innerHTML = '<div style="text-align:center;color:var(--text3);padding:20px;font-size:12px;">&#8987; Caricamento...</div>';

  fetch('https://www.googleapis.com/drive/v3/files/' + fileId + '?alt=media', {
    headers: { Authorization: 'Bearer ' + _gdriveToken }
  }).then(function(r){
    if(!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  }).then(function(snap){
    if(restoreSession(snap)) {
      closeGDriveModal();
      showPage(STATE.mode === 'track' ? 'overview' : 'rally-overview');
      showToast('Sessione caricata da Drive: ' + fileName);
    } else {
      showToast('Errore: file non valido o corrotto');
      gdriveRefreshList();
    }
  }).catch(function(err){
    showToast('Errore caricamento: ' + err.message);
    gdriveRefreshList();
  });
}

// ── Delete a file from Drive ──
function gdriveDeleteFile(fileId, btnEl) {
  if(!confirm('Eliminare questo file da Google Drive?')) return;
  var origText = btnEl ? btnEl.textContent : '';
  if(btnEl) { btnEl.textContent = '...'; btnEl.disabled = true; }

  fetch('https://www.googleapis.com/drive/v3/files/' + fileId, {
    method: 'DELETE',
    headers: { Authorization: 'Bearer ' + _gdriveToken }
  }).then(function(r){
    if(r.status === 204 || r.ok) {
      showToast('File eliminato da Drive');
      gdriveRefreshList();
    } else {
      return r.json().then(function(e){ throw new Error(e.error && e.error.message || r.status); });
    }
  }).catch(function(err){
    if(btnEl) { btnEl.textContent = origText; btnEl.disabled = false; }
    showToast('Errore eliminazione: ' + err.message);
  });
}

