window.fpNewPlan = fpNewPlan;

function fpDeletePlan(){
  var plan = _fpCurrent();
  if(!plan){ showToast('Nessun piano selezionato'); return; }
  if(!confirm('Eliminare definitivamente il piano "'+plan.name+'"?\n\nLe PS e refuel inseriti andranno persi.')) return;
