function getSessionData(name) {
  if(!name) return { STATE: STATE, COMPOUND_NAMES: COMPOUND_NAMES, savedAt: Date.now(), name: 'Sessione corrente' };
  const s = getAllSessions().find(x=>x.name===name);
  return s || null;
}

function _compareCarsForSession(name){
  const s = getSessionData(name);
  if(!s || !s.STATE) return [];
  return (s.STATE.trackCars||[]).concat(s.STATE.rallyCars||[]);
}

function _compareRefreshCarSelector(slot){
  const sessSel = document.getElementById('compare-session-'+slot);
  const carSel  = document.getElementById('compare-car-'+slot);
  if(!sessSel || !carSel) return;
  const sessName = sessSel.value || '';
  const cars = _compareCarsForSession(sessName);
  const prev = carSel.value;
  carSel.innerHTML = '<option value="">— Seleziona vettura —</option>' +
    cars.map(c=>'<option value="'+c.id+'">'+c.name+(c.retired?' (RTD)':'')+'</option>').join('');
  // Try to keep previous selection if it still exists
  if(prev && cars.some(c=>c.id===prev)) carSel.value = prev;
  else if(cars.length) carSel.value = cars[0].id;
}

function buildComparePage() {
  const sessions = getAllSessions();
  const selA = document.getElementById('compare-session-a');
  const selB = document.getElementById('compare-session-b');

  [selA, selB].forEach((sel,i) => {
    if(!sel) return;
    const prev = sel.value;
    const opts = sessions.map(s=>'<option value="'+s.name+'">'+s.name+' ('+new Date(s.savedAt||0).toLocaleDateString('it-IT')+')</option>').join('');
