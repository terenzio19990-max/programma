// ─── 3) PILOTA REPORT ───────────────────────────────────────────
function _generatePilotaReport(){
  var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
  var now = new Date().toLocaleString('it-IT');

  var html = '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><title>Report Pilota</title><style>'+_reportNewCss()+'</style></head><body>';

  html += '<div class="cover">'+
    '<div class="cover-title">DEBRIEF PILOTA</div>'+
    '<div class="cover-sub">👤 Analisi personale</div>'+
    '<div class="cover-meta">'+
      '<div><b>Vetture:</b> '+allCars.length+'</div>'+
      '<div><b>Generato:</b> '+now+'</div>'+
    '</div>'+
  '</div>';

  html += '<h1>👤 Debrief Pilota</h1><div class="subtitle">Per discussione post-sessione · '+now+'</div>';

  allCars.forEach(function(car){
    var laps = STATE.laps[car.id] || [];
    if(!laps.length) return;

    html += '<div class="section">';
    html += '<h2>'+car.name+'</h2>';

    var times = laps.map(function(l){return parseTime(l.time);}).filter(function(t){return t&&isFinite(t);});
    if(!times.length){
      html += '<p class="muted">Nessun tempo registrato.</p></div>';
      return;
    }
    var best = Math.min.apply(null, times);
    var avg = times.reduce(function(a,b){return a+b;},0)/times.length;
    var sortedTimes = times.slice().sort(function(a,b){return a-b;});
    var top3avg = sortedTimes.slice(0, Math.min(3,sortedTimes.length)).reduce(function(a,b){return a+b;},0)/Math.min(3,sortedTimes.length);
    var mean = avg;
    var variance = times.reduce(function(s,v){return s+(v-mean)*(v-mean);},0)/times.length;
    var stddev = Math.sqrt(variance);
    var cv = (stddev/mean*100).toFixed(2);

    html += '<div class="kpis">'+
      '<div class="kpi"><div class="kpi-label">Best Lap</div><div class="kpi-val">'+_reportFmtMs(best)+'</div></div>'+
      '<div class="kpi"><div class="kpi-label">Top-3 Media</div><div class="kpi-val">'+_reportFmtMs(top3avg)+'</div><div class="kpi-sub">3 giri più veloci</div></div>'+
      '<div class="kpi"><div class="kpi-label">Media</div><div class="kpi-val">'+_reportFmtMs(avg)+'</div></div>'+
      '<div class="kpi"><div class="kpi-label">Consistenza CV</div><div class="kpi-val">'+cv+'%</div><div class="kpi-sub">'+(cv<1.5?'Eccellente':cv<2.5?'Buona':cv<4?'Migliorabile':'Da lavorare')+'</div></div>'+
      '<div class="kpi"><div class="kpi-label">Giri</div><div class="kpi-val">'+laps.length+'</div></div>'+
    '</div>';

    html += '<h3>Top 5 Giri</h3>';
    var top5 = laps.slice().sort(function(a,b){
      var ma=parseTime(a.time)||Infinity, mb=parseTime(b.time)||Infinity;
      return ma-mb;
    }).slice(0,5);
    html += '<table><thead><tr><th>Pos</th><th>G#</th><th>Sessione</th><th>Tempo</th><th>S1</th><th>S2</th><th>S3</th><th>VMax</th><th>Note</th></tr></thead><tbody>';
    top5.forEach(function(l, i){
      html += '<tr>'+
        '<td><b>'+(i+1)+'</b></td>'+
        '<td>'+(l.lap||'—')+'</td>'+
        '<td>'+(l.session||'—')+'</td>'+
        '<td style="font-family:monospace;font-weight:700;">'+(l.time||'—')+'</td>'+
        '<td>'+(l.s1||'—')+'</td>'+
        '<td>'+(l.s2||'—')+'</td>'+
        '<td>'+(l.s3||'—')+'</td>'+
        '<td>'+(l.vmax?l.vmax+' km/h':'—')+'</td>'+
        '<td style="font-size:10px;">'+((l.note||'')+'').slice(0,60)+'</td>'+
      '</tr>';
    });
    html += '</tbody></table>';

    var bestS1 = Infinity, bestS2 = Infinity, bestS3 = Infinity;
    laps.forEach(function(l){
      var ms1 = parseTime(l.s1); if(ms1&&isFinite(ms1)&&ms1<bestS1) bestS1 = ms1;
      var ms2 = parseTime(l.s2); if(ms2&&isFinite(ms2)&&ms2<bestS2) bestS2 = ms2;
      var ms3 = parseTime(l.s3); if(ms3&&isFinite(ms3)&&ms3<bestS3) bestS3 = ms3;
    });
    if(isFinite(bestS1)&&isFinite(bestS2)&&isFinite(bestS3)){
      var theoretical = bestS1 + bestS2 + bestS3;
      var loss = best - theoretical;
      html += '<h3>Best Teorico (somma migliori settori)</h3>';
      html += '<p style="font-size:11px;">S1 best: <b>'+_reportFmtMs(bestS1)+'</b> · S2 best: <b>'+_reportFmtMs(bestS2)+'</b> · S3 best: <b>'+_reportFmtMs(bestS3)+'</b></p>';
      html += '<p style="font-size:11px;">Best Teorico: <b>'+_reportFmtMs(theoretical)+'</b> · Best Reale: <b>'+_reportFmtMs(best)+'</b> · '+
        '<span class="'+(loss<300?'green':loss<700?'yellow':'red')+'">Margine: '+(loss/1000).toFixed(3)+'s</span></p>';
    }

    var teleNotes = STATE.teleNotes && STATE.teleNotes[car.id] || [];
    if(teleNotes.length){
      html += '<h3>Note Pilota / Telemetria ('+teleNotes.length+')</h3>';
      teleNotes.slice(-10).reverse().forEach(function(n){
        var prioColor = n.prio==='critical'?'red':n.prio==='high'?'yellow':'';
        html += '<p style="margin:6px 0;font-size:11px;border-left:3px solid '+(n.prio==='critical'?'#d53a3a':n.prio==='high'?'#d97706':'#aaa')+';padding-left:8px;">'+
          '<span class="tag">'+(n.cat||'').toUpperCase()+'</span>'+
          (n.lap?'<span style="color:#888;font-size:10px;">G'+n.lap+' · </span>':'')+
          '<span class="'+prioColor+'">'+(n.note||'')+'</span>'+
          '<span style="color:#888;font-size:9px;float:right;">'+(n.timestamp||'')+'</span>'+
        '</p>';
      });
    }

    html += '</div>';
  });

  html += '<div class="footer">Race Engineer Pro · Pilota Report · '+now+'</div></body></html>';
  var w = window.open('','_blank');
  if(w){ w.document.write(html); w.document.close(); setTimeout(function(){w.print();},800); }
  showToast('✅ Pilota report aperto');
}
window._generatePilotaReport = _generatePilotaReport;

