var _THEME_KEY_CUSTOM = 'rep_theme_custom_v1';

function _hexToRgb(hex){
  hex = (hex||'').replace('#','').trim();
  if(hex.length===3) hex = hex.split('').map(function(c){return c+c;}).join('');
  var n = parseInt(hex,16);
  return { r:(n>>16)&255, g:(n>>8)&255, b:n&255 };
}
function _rgbToHex(r,g,b){
  return '#'+[r,g,b].map(function(v){v=Math.round(Math.max(0,Math.min(255,v)));return v.toString(16).padStart(2,'0');}).join('');
}
function _lighten(hex, amt){
  var c = _hexToRgb(hex);
  return _rgbToHex(c.r+(255-c.r)*amt, c.g+(255-c.g)*amt, c.b+(255-c.b)*amt);
}
function _darken(hex, amt){
  var c = _hexToRgb(hex);
  return _rgbToHex(c.r*(1-amt), c.g*(1-amt), c.b*(1-amt));
}
function _readAccentColor(){
  try {
    var saved = JSON.parse(localStorage.getItem(_THEME_KEY_CUSTOM)||'{}');
    if(saved.accent) return saved.accent;
  } catch(e){}
  return getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#e8421a';
}

function applyTheme(name){
  var el = document.documentElement;
  // Clear accent override for base themes (keep user's color if set)
  if(name==='light'){
    el.setAttribute('data-theme','light');
    try { localStorage.setItem('REP_theme','light'); } catch(e){}
    try { if(typeof _isDark!=='undefined') _isDark = false; } catch(e){}
  } else if(name==='dark'){
    el.setAttribute('data-theme','dark');
    try { localStorage.setItem('REP_theme','dark'); } catch(e){}
    try { if(typeof _isDark!=='undefined') _isDark = true; } catch(e){}
  } else if(name==='racing'){
    // Dark base with red/yellow racing accents
    el.setAttribute('data-theme','dark');
    applyAccentColor('#e8421a');
    el.style.setProperty('--accent3', '#ffcc00');
    el.style.setProperty('--bg0', '#060608');
    el.style.setProperty('--bg1', '#0b0c10');
  } else if(name==='classic'){
    // Light classic paddock style: beige/brown
    el.setAttribute('data-theme','light');
    applyAccentColor('#8b4513');
    el.style.setProperty('--bg0','#f5f1e8');
    el.style.setProperty('--bg1','#faf6ee');
  }
  // Save selected theme
  try {
    var prev = JSON.parse(localStorage.getItem(_THEME_KEY_CUSTOM)||'{}');
    prev.theme = name;
    localStorage.setItem(_THEME_KEY_CUSTOM, JSON.stringify(prev));
  } catch(e){}
  showToast('🎨 Tema: '+name);
}

function applyAccentColor(hex){
  if(!hex) return;
  var el = document.documentElement;
  el.style.setProperty('--accent', hex);
  el.style.setProperty('--accent2', _lighten(hex, 0.15));
  el.style.setProperty('--accent3', _lighten(hex, 0.35));
  try {
    var prev = JSON.parse(localStorage.getItem(_THEME_KEY_CUSTOM)||'{}');
    prev.accent = hex;
    localStorage.setItem(_THEME_KEY_CUSTOM, JSON.stringify(prev));
  } catch(e){}
  var p = document.getElementById('theme-accent-picker');
  if(p) p.value = hex;
}

function applyDensity(name){
  document.body.classList.remove('density-compact','density-normal','density-spacious');
  if(name && name!=='normal') document.body.classList.add('density-'+name);
  try {
    var prev = JSON.parse(localStorage.getItem(_THEME_KEY_CUSTOM)||'{}');
    prev.density = name;
    localStorage.setItem(_THEME_KEY_CUSTOM, JSON.stringify(prev));
  } catch(e){}
  showToast('📐 Densità: '+name);
}

function resetTheme(){
  if(!confirm('Ripristinare tema e colori ai valori default?')) return;
  var el = document.documentElement;
  ['--accent','--accent2','--accent3','--bg0','--bg1'].forEach(function(v){ el.style.removeProperty(v); });
  el.setAttribute('data-theme','dark');
  document.body.classList.remove('density-compact','density-spacious');
  try { localStorage.removeItem(_THEME_KEY_CUSTOM); localStorage.setItem('REP_theme','dark'); } catch(e){}
  showToast('🔄 Tema resettato');
}

// Apply saved theme on startup
function loadSavedThemePrefs(){
  try {
    var cfg = JSON.parse(localStorage.getItem(_THEME_KEY_CUSTOM)||'{}');
