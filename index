function anRenderSuggest(){
  // Perf guard: skip rebuild if container is hidden
  var _g = document.getElementById('an-suggest-result');
  if(_g && !_g.offsetParent && !window.__FORCE_REBUILD) return;

  var el = document.getElementById('an-suggest-result');
  if(!el) return;
  if(!AN.suggestCar){ el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text3);">Seleziona una vettura</div>'; return; }
  var notes = (typeof _driverNotes!=='undefined' ? (_driverNotes[AN.suggestCar]||[]) : []);
  if(!notes.length){
    el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text3);">🔧 Nessuna nota pilota registrata per questa vettura.<br><span style="font-size:10px;">Inserisci note con intensità e categoria dalla pagina "💬 PILOTA" per ottenere suggerimenti.</span></div>';
    return;
  }
  // Focus on high-intensity recent notes (last 20, weighted by intensity)
  var intensityWeights = { light:1, medium:2, heavy:3, critical:4 };
  var recentNotes = notes.slice(-20);
  // Aggregate suggestions by matching rules
  var matchedRules = []; // {rule, score, matchedNotes:[]}
  SETUP_RULES.forEach(function(rule){
    var matchedNotes = [];
    var totalScore = 0;
    recentNotes.forEach(function(n){
      if(n.category !== rule.category) return;
      var txt = ((n.note||'')+' '+(n.point||'')).toLowerCase();
      var keywordMatch = !rule.keywords.length || rule.keywords.some(function(kw){return txt.includes(kw);});
      if(keywordMatch){
        matchedNotes.push(n);
        totalScore += intensityWeights[n.intensity||'medium'] || 2;
      }
    });
    if(matchedNotes.length>0){
      matchedRules.push({ rule:rule, score:totalScore, matchedNotes:matchedNotes });
    }
  });
  matchedRules.sort(function(a,b){return b.score-a.score;});
  if(!matchedRules.length){
    el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text3);">🤔 Nessuna regola applicabile alle note attuali.<br><span style="font-size:10px;">Prova a categorizzare le note pilota con più precisione.</span></div>';
