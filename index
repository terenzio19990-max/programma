/* ---- What-if grafico: curve U(v) e ay(v) ---- */
function saSweep(setup, p, surf){
  var stF=saAxleStiffness(setup.springF,setup.barFraw,p,'f');
  var stR=saAxleStiffness(setup.springR,setup.barRraw,p,'r');
  var lt=saLoadTransfer(stF.Kphi,stR.Kphi,p);
  var aero=saAeroLoads(setup,p,40);
  var mech={ mu0:surf.mu0, muB:surf.muB, dWf:lt.dWf, dWr:lt.dWr, rollGrad:lt.rollGrad,
    camF:setup.camberF, camR:setup.camberR, camOptF:surf.camOptF, camOptR:surf.camOptR,
    ClAf:aero.ClAf, ClAr:aero.ClAr, biasSplit:null,
    axTraction:saMaxTraction(surf.mu0,p), gripFfX:1, gripFrX:1 };
  var pts=[];
  for(var v=40;v<=210;v+=10){
    var b=saBalanceCond(v/3.6, 0, 'mid', setup, p, mech);
    pts.push({v:v,U:b.U,ay:b.ay/SA_G});
  }
  return pts;
}
function saCurveSVG(ptsCur, ptsBase, key, label, yMinF, yMaxF){
  var W=640,H=150,L=44,R=10,T=14,Bm=24;
  var vals=[];
  ptsCur.forEach(function(pt){ vals.push(pt[key]); });
  if(ptsBase) ptsBase.forEach(function(pt){ vals.push(pt[key]); });
  var yMin=(yMinF!==undefined)? yMinF : Math.min.apply(null,vals)*0.92;
  var yMax=(yMaxF!==undefined)? yMaxF : Math.max.apply(null,vals)*1.06;
  if(yMax-yMin<0.01){ yMax+=0.05; yMin-=0.05; }
  function X(v){ return L+(v-40)/(210-40)*(W-L-R); }
  function Y(y){ return T+(yMax-Math.max(yMin,Math.min(yMax,y)))/(yMax-yMin)*(H-T-Bm); }
  function poly(pts,color,dash){
    var dd=pts.map(function(pt,i){ return (i?'L':'M')+X(pt.v).toFixed(1)+' '+Y(pt[key]).toFixed(1); }).join(' ');
