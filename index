<script>
/* REP-IMPROVE-BEGIN ===================================================
   MIGLIORIE AUDIT — aree A/B/C/D1
   A: autosave sulle azioni che lo saltavano; modal sessioni con ricerca,
      dimensione e ordinamento.
   B: pannelli riepilogo VERI per Overview rally, Assistenza rally e
      Overview pista; Predittivo rally collegato ai percorsi 3D.
   C: tabelle con intestazioni fisse negli elenchi scorrevoli.
   D1: profilo circuito AUTOMATICO dal percorso 3D (geometria curve ->
       quote rettilinei/curve + sconnesso + tempo stimato) per
       l'Analizzatore Setup.
====================================================================== */
(function(){
'use strict';
if(window._repImprove1) return;
window._repImprove1 = true;

function T(m){ try { if(typeof showToast==='function') showToast(m); } catch(e){} }

/* ═══ A1: autosave sulle azioni che non salvavano ═══ */
['setMode','setFlag','updateSurface','deleteRallyTyreHistory','updateSpare',
 'setTimerFromInput','setTimerFromClock','resetAssistTimer','updateMeteoLocation']
.forEach(function(fn){
  if(typeof window[fn]==='function' && !window['_repAS_'+fn]){
    window['_repAS_'+fn]=true;
    var o=window[fn];
    window[fn]=function(){
      var r=o.apply(this,arguments);
      try { if(typeof triggerAutoSave==='function') triggerAutoSave(); } catch(e){}
      return r;
    };
  }
});

/* ═══ A2: modal sessioni — ricerca, dimensione, ordinamento ═══ */
if(typeof window.renderSessionList==='function' && !window._repSessList){
  window._repSessList=true;
  window.renderSessionList = function(){
    var list=document.getElementById('session-list');
    if(!list) return;
    var sessions=(typeof getAllSessions==='function'? getAllSessions():[])||[];
    var q=(window._repSessQ||'').toLowerCase();
    var searchBar='<div style="display:flex;gap:8px;margin-bottom:8px;align-items:center">'+
      '<input type="text" placeholder="🔎 cerca sessione..." value="'+(window._repSessQ||'').replace(/"/g,'&quot;')+'"'+
      ' style="flex:1;background:var(--bg0);border:1px solid var(--border);border-radius:4px;color:var(--text1);padding:6px 10px;font-size:12px"'+
      ' oninput="window._repSessQ=this.value; renderSessionList(); this.focus(); this.setSelectionRange(this.value.length,this.value.length)">'+
      '<span class="small">'+sessions.length+' salvataggi</span></div>';
    if(!sessions.length){
      list.innerHTML=searchBar+'<div style="text-align:center;color:var(--text3);font-size:12px;padding:24px;">Nessuna sessione salvata</div>';
      return;
    }
    var rows=sessions.slice().sort(function(a,b){ return new Date(b.savedAt||0)-new Date(a.savedAt||0); })
      .filter(function(s){ return !q || String(s.name).toLowerCase().indexOf(q)>=0; })
      .map(function(s){
        var d=s.savedAt? new Date(s.savedAt):null;
        var dateStr=d? d.toLocaleDateString('it-IT')+' '+d.toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit'}):'—';
        var mode=(s.STATE&&s.STATE.mode)==='track'?'🏁 PISTA':'🌿 RALLY';
        var lapsCount=s.STATE&&s.STATE.laps? Object.values(s.STATE.laps).reduce(function(a,v){return a+((v&&v.length)||0);},0):0;
        var stagesCount=(s.STATE&&s.STATE.stages&&s.STATE.stages.length)||0;
        var kb=0; try { kb=Math.round(JSON.stringify(s).length/1024); } catch(e){}
        var nm=String(s.name).replace(/'/g,"\\'");
        return '<div style="display:flex;align-items:center;gap:10px;padding:11px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;margin-bottom:6px">'+
          '<div style="flex:1;min-width:0"><div style="font-size:13px;color:var(--text1);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">'+s.name+'</div>'+
          '<div style="font-size:11px;color:var(--text3);margin-top:3px">'+mode+' · '+dateStr+' · '+(lapsCount>0? lapsCount+' giri': stagesCount>0? stagesCount+' PS':'—')+' · '+(kb>=1024? (kb/1024).toFixed(1)+' MB' : kb+' KB')+'</div></div>'+
          '<button class="btn btn-blue" style="padding:4px 12px;font-size:11px" onclick="loadSession(\''+nm+'\')">📂 CARICA</button>'+
          '<button class="btn btn-gray" style="padding:4px 10px;font-size:11px" onclick="downloadSessionJSON(\''+nm+'\')" title="Esporta">⬇</button>'+
          '<button onclick="deleteSession(\''+nm+'\')" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:16px" title="Elimina">✕</button></div>';
      }).join('');
    list.innerHTML=searchBar+(rows||'<div class="small" style="text-align:center;padding:16px;color:var(--text3)">nessun risultato per "'+q+'"</div>');
  };
}

/* ═══ C: intestazioni tabella fisse negli elenchi scorrevoli ═══ */
(function(){
  var css='.panel-body[style*="overflow-y"] .data-table thead th, .panel-body[style*="max-height"] .data-table thead th{position:sticky;top:0;background:var(--bg2);z-index:2}'+
    '@media (max-width:760px){ .data-table{font-size:10px} .data-table td,.data-table th{padding:4px 6px} }';
  var st=document.createElement('style'); st.textContent=css; document.head.appendChild(st);
