}
window.fpSwitchEvent = fpSwitchEvent;

// Save base parameters edited in form
function fpAutoSave(){
  var plan = _fpCurrent();
  if(!plan) return;
  plan.name      = document.getElementById('fp-name').value.trim() || plan.name;
  plan.capacity  = +document.getElementById('fp-capacity').value || 60;
  plan.startFuel = +document.getElementById('fp-start-fuel').value || plan.capacity;
  plan.consSS    = +document.getElementById('fp-cons-ss').value || 0.18;
  plan.consTF    = +document.getElementById('fp-cons-tf').value || 0.08;
  plan.safety    = +document.getElementById('fp-safety').value || 0;
  plan.minReserve = +document.getElementById('fp-min-reserve').value || 0;
  plan.updatedAt = Date.now();
  _fpSave();
  // Don't re-render the whole table here (would steal focus from inputs)
}
window.fpAutoSave = fpAutoSave;

// Core: compute segments and refuel plan
// A "segment" is a contiguous run between two refuel points (or start→first refuel, or last refuel→end).
function fpRecalc(){
  var plan = _fpCurrent();
  var listEl = document.getElementById('fp-segments-list');
  var feasEl = document.getElementById('fp-feasibility');
  if(!plan || !plan.stages || !plan.stages.length){
    if(listEl) listEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text3);font-size:11px;">Nessun piano da calcolare. Aggiungi PS sopra.</div>';
    if(feasEl) feasEl.innerHTML = 'Inserisci PS e refuel per vedere la fattibilità del piano.';
    document.getElementById('fp-tot-stages').textContent = '0';
    document.getElementById('fp-tot-km').textContent = '0 km';
    document.getElementById('fp-tot-fuel').textContent = '0 L';
    document.getElementById('fp-tot-refuel').textContent = '0 L';
    return;
  }
  var consSS  = +plan.consSS || 0.18;
  var consTF  = +plan.consTF || 0.08;
  var safety  = (+plan.safety || 0) / 100;
  var minReserve = Math.max(0, +plan.minReserve || 0);
  var capacity = +plan.capacity || 60;
  var startFuel = Math.min(capacity, +plan.startFuel || capacity);
  var stages  = plan.stages.slice().sort(function(a,b){return (+a.n||0)-(+b.n||0);});

  // Validation: minReserve cannot be >= capacity
  if(minReserve >= capacity){
    minReserve = Math.max(0, capacity - 1);
  }
  // Validation: startFuel must be at least minReserve to be feasible
  // (we don't auto-correct, just flag the issue later)
  // Build segments: each PS contributes its own fuel + (transfer to next).
  // The transfer of the LAST PS goes to "end of rally" (no further consumption).
  // A segment ends after a stage marked refuelAfter (the transfer of that stage
  // is consumed in the same segment as the PS — the refuel happens AFTER the
  // transfer, immediately before the next PS).
  // For simplicity here: refuel happens at end of the "PS+transfer" slot if
  // refuelAfter=true. Adjust if user feedback demands different model.
  var segments = [];
  var currentSeg = { stages: [], totalFuel: 0, refuelMax: 0 };
  stages.forEach(function(s, idx){
    var f = (+s.km||0)*consSS + (+s.kmTF||0)*consTF;
    currentSeg.stages.push({ s: s, fuel: f });
    currentSeg.totalFuel += f;
    if(s.refuelAfter){
      currentSeg.refuelMax = +s.refuelMax || 0; // 0 = illimitato
      segments.push(currentSeg);
      currentSeg = { stages: [], totalFuel: 0, refuelMax: 0 };
    }
  });
  if(currentSeg.stages.length) segments.push(currentSeg);

  // Compute total stats
  var totKm = 0, totFuel = 0;
  stages.forEach(function(s){
    totKm += (+s.km||0) + (+s.kmTF||0);
    totFuel += (+s.km||0)*consSS + (+s.kmTF||0)*consTF;
  });
  document.getElementById('fp-tot-stages').textContent = stages.length;
  document.getElementById('fp-tot-km').textContent = totKm.toFixed(1)+' km';
  document.getElementById('fp-tot-fuel').textContent = (totFuel*(1+safety)).toFixed(1)+' L';

  // Plan refuels: walk segments, simulate fuel level
  // Each segment requires (consumption*(1+safety) + minReserve) at start of segment,
  // so that even with margin worst-case, we never end below minReserve.
  // Refuel after segment = "we want enough at start of next segment".
  var fuel = startFuel;
  var refuelTotal = 0;
  var rows = [];
  var feasIssues = [];
  // Initial check: if startFuel is below minReserve, that's a configuration error
  if(startFuel < minReserve && minReserve > 0){
    feasIssues.push('Serbatoio iniziale ('+startFuel.toFixed(1)+'L) sotto la riserva minima ('+minReserve.toFixed(1)+'L)');
  }
  segments.forEach(function(seg, segIdx){
    // Needed fuel for this segment = consumption*(1+safety) + reserve to keep at end
    var consumption = seg.totalFuel * (1 + safety);
    var needed = consumption + minReserve;
    var startFuelOfSeg = fuel;
    // If we don't have enough fuel for this segment...
    var shortfall = needed - fuel;
    if(shortfall > 0.01){
      var explanation = ' (servono '+needed.toFixed(1)+'L = '+consumption.toFixed(1)+' consumo' +
        (minReserve > 0 ? ' + '+minReserve.toFixed(1)+' riserva' : '') +
        ', hai '+fuel.toFixed(1)+'L)';
      feasIssues.push('Segmento '+(segIdx+1)+': mancano '+shortfall.toFixed(1)+'L'+explanation);
    }
    // Consume the fuel
    fuel = Math.max(0, fuel - seg.totalFuel);
    var endFuelOfSeg = fuel;
    // Reserve check at end of segment
    if(endFuelOfSeg < minReserve - 0.01 && minReserve > 0){
      feasIssues.push('Segmento '+(segIdx+1)+': fine segmento sotto riserva minima ('+endFuelOfSeg.toFixed(1)+'L < '+minReserve.toFixed(1)+'L)');
    }
    // If there's a refuel point after this segment (i.e. not the last segment)
    var refuelAdded = 0;
    var nextSegConsumption = (segIdx+1 < segments.length) ? segments[segIdx+1].totalFuel * (1+safety) : 0;
    var nextSegNeeded = nextSegConsumption + minReserve;
    if(segIdx+1 < segments.length){
      // Compute how much to add: enough to cover next segment + reserve, capped at capacity
      var desiredLevel = Math.min(capacity, nextSegNeeded);
      refuelAdded = Math.max(0, desiredLevel - fuel);
      // Cap at refuelMax if specified (>0 means there's a limit)
      var rmax = seg.refuelMax;
      if(rmax > 0 && refuelAdded > rmax){
        feasIssues.push('Refuel '+(segIdx+1)+': limite '+rmax+' L ma servirebbero '+refuelAdded.toFixed(1)+' L');
        refuelAdded = rmax;
      }
      fuel += refuelAdded;
      refuelTotal += refuelAdded;
    }
    rows.push({
      idx: segIdx,
      stages: seg.stages,
      totalFuel: seg.totalFuel,
      needed: needed,
      consumption: consumption,
      reserve: minReserve,
      startFuelOfSeg: startFuelOfSeg,
      endFuelOfSeg: endFuelOfSeg,
      refuelAdded: refuelAdded,
      refuelLimit: seg.refuelMax,
      shortfall: Math.max(0, shortfall),
      isLast: segIdx === segments.length-1,
      fuelAfterRefuel: fuel
    });
  });
  document.getElementById('fp-tot-refuel').textContent = refuelTotal.toFixed(1)+' L';

  // Feasibility verdict
  if(feasIssues.length){
    feasEl.innerHTML = '<div style="color:var(--red);font-weight:700;margin-bottom:6px;">⚠️ '+feasIssues.length+' problemi rilevati:</div>' +
      feasIssues.map(function(m){return '<div style="font-size:10px;color:var(--red);">• '+m+'</div>';}).join('');
    feasEl.style.background = 'rgba(255,80,80,0.10)';
    feasEl.style.borderLeft = '3px solid var(--red)';
  } else if(segments.length){
    feasEl.innerHTML = '<div style="color:var(--green);font-weight:700;">✅ Piano fattibile</div>'+
      '<div style="font-size:10px;color:var(--text3);margin-top:4px;">Margine sicurezza '+(safety*100).toFixed(0)+'% applicato'+(minReserve>0?' · riserva minima '+minReserve.toFixed(1)+'L garantita':'')+'. Carburante a fine rally: '+fuel.toFixed(1)+' L.</div>';
    feasEl.style.background = 'rgba(44,188,110,0.10)';
    feasEl.style.borderLeft = '3px solid var(--green)';
  } else {
    feasEl.innerHTML = 'Nessun segmento calcolato.';
  }

  // Render segments list
  if(rows.length){
    listEl.innerHTML = rows.map(function(r){
      var stagesList = r.stages.map(function(x){return 'PS'+(x.s.n||'?')+(x.s.name?' '+x.s.name.substring(0,18):'');}).join(' → ');
      var statusBadge = r.shortfall > 0
        ? '<span style="background:rgba(255,80,80,0.20);color:var(--red);padding:3px 8px;border-radius:3px;font-weight:700;font-size:10px;">⚠ MANCA '+r.shortfall.toFixed(1)+'L</span>'
        : '<span style="background:rgba(44,188,110,0.20);color:var(--green);padding:3px 8px;border-radius:3px;font-weight:700;font-size:10px;">✓ OK</span>';
      var refuelLine = r.isLast
        ? '<div style="font-size:11px;color:var(--text3);">Fine rally · carburante residuo: <b style="color:var(--text1);">'+r.endFuelOfSeg.toFixed(1)+' L</b></div>'
        : '<div style="font-size:11px;color:var(--text2);">⛽ <b>Aggiungi '+r.refuelAdded.toFixed(1)+' L</b> al rifornimento'+(r.refuelLimit>0?' (limite: '+r.refuelLimit+'L)':'')+' · serbatoio dopo: <b style="color:var(--green);">'+r.fuelAfterRefuel.toFixed(1)+' L</b></div>';
      return '<div style="background:var(--bg3);border-left:3px solid '+(r.shortfall>0?'var(--red)':'var(--accent3)')+';border-radius:4px;padding:10px 14px;margin-bottom:8px;">'+
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;flex-wrap:wrap;gap:6px;">'+
          '<div style="font-family:var(--head);font-size:12px;color:var(--text1);font-weight:700;letter-spacing:1px;">SEGMENTO '+(r.idx+1)+'</div>'+
          statusBadge+
        '</div>'+
        '<div style="font-size:11px;color:var(--text2);margin-bottom:5px;line-height:1.4;">'+stagesList+'</div>'+
        '<div style="display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--text3);margin-bottom:5px;">'+
          '<span>Consumo: <b style="color:var(--text1);">'+r.totalFuel.toFixed(2)+' L</b></span>'+
          '<span>Con margine: <b style="color:var(--yellow);">'+r.consumption.toFixed(2)+' L</b></span>'+
          (r.reserve > 0 ? '<span>+ Riserva: <b style="color:var(--purple);">'+r.reserve.toFixed(1)+' L</b></span>' : '')+
          '<span>Tot necessario: <b style="color:var(--accent3);">'+r.needed.toFixed(2)+' L</b></span>'+
          '<span>All\'inizio segmento: <b style="color:var(--blue);">'+r.startFuelOfSeg.toFixed(1)+' L</b></span>'+
          '<span>Alla fine: <b style="color:'+(r.endFuelOfSeg < r.reserve ? 'var(--red)' : 'var(--text1)')+';">'+r.endFuelOfSeg.toFixed(1)+' L</b></span>'+
        '</div>'+
        refuelLine+
      '</div>';
    }).join('');
  } else {
    listEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text3);font-size:11px;">Nessun segmento.</div>';
  }
}
window.fpRecalc = fpRecalc;

// Import stages from current rally session into the active plan
function fpImportFromStages(){
  var plan = _fpCurrent();
  if(!plan){ showToast('⚠️ Crea prima un piano'); return; }
  if(!STATE.stages || !STATE.stages.length){ showToast('Nessuna PS in sessione da importare'); return; }
  if(plan.stages.length && !confirm('Sostituire le '+plan.stages.length+' PS esistenti del piano con le '+STATE.stages.length+' della sessione corrente?')) return;
  // Use unique PS by num — last wins
  var uniqueByNum = {};
  STATE.stages.forEach(function(s){
    uniqueByNum[s.num] = { n: +s.num||0, name: s.name||'', km: +s.km||0, kmTF: +s.tfKm||0, refuelAfter: false, refuelMax: 0 };
  });
  plan.stages = Object.values(uniqueByNum).sort(function(a,b){return a.n-b.n;});
  fpAutoSave();
  fpRender();
  showToast('✓ Importate '+plan.stages.length+' PS dalla sessione');
}
window.fpImportFromStages = fpImportFromStages;

// Apply plan to session: copy plan.stages into STATE.stages (without overwriting existing times)
function fpApplyToSession(){
  var plan = _fpCurrent();
  if(!plan){ showToast('Nessun piano selezionato'); return; }
  if(!plan.stages || !plan.stages.length){ showToast('Il piano non ha PS'); return; }
  var car = STATE.rallyCars[STATE.selectedRallyCar];
  if(!car){ showToast('Nessuna vettura rally selezionata'); return; }
  var mode = confirm(
    'Applicare il piano "'+plan.name+'" alla sessione corrente?\n\n'+
    '✅ OK: aggiunge le PS del piano alle Prove Speciali (con tempi vuoti, da compilare durante il rally)\n'+
    '❌ Annulla: torna indietro\n\n'+
    'Vettura: '+car.name+'\n'+
    'PS che verranno aggiunte: '+plan.stages.length
  );
  if(!mode) return;
  // Push undo
  var snap = JSON.parse(JSON.stringify(STATE.stages));
  if(typeof pushUndo === 'function') pushUndo('Applica piano carb.', function(){ STATE.stages = snap; if(typeof refreshStages==='function') refreshStages(); });
  // Add stages — skip those that already exist with same num+car
  var added = 0;
  plan.stages.forEach(function(p){
    var exists = STATE.stages.some(function(s){return +s.num === +p.n && s.car === car.name;});
    if(exists) return;
    STATE.stages.push({
      num: +p.n,
      name: p.name||'',
      km: +p.km||0,
      tfKm: +p.kmTF||0,
      car: car.name,
      time: '',
      absPos: 1, clsPos: 1,
      fuelSS: 0, fuelTF: 0,
      surface: 'Asfalto',
      lights: false,
      driverId: (typeof _psCurrentDriverId==='function')?_psCurrentDriverId():'',
      ts: Date.now()+added
    });
    added++;
  });
  if(typeof refreshStages==='function') refreshStages();
  if(typeof updateRallyTyreKm==='function') updateRallyTyreKm();
  if(typeof updateRallyFuelFromStages==='function') updateRallyFuelFromStages();
  if(typeof triggerAutoSave==='function') triggerAutoSave();
  showToast('✓ Aggiunte '+added+' PS alla sessione');
}
window.fpApplyToSession = fpApplyToSession;

// Generate a printable HTML report of the fuel plan and open the browser's
// print dialog. The user can then "Save as PDF" from the print dialog.
function fpPrintReport(){
  var plan = _fpCurrent();
  if(!plan){ showToast('Nessun piano selezionato'); return; }
  if(!plan.stages || !plan.stages.length){ showToast('Il piano non ha PS — aggiungile prima'); return; }

  // Recompute everything fresh so the report reflects current values
  var consSS  = +plan.consSS || 0.18;
  var consTF  = +plan.consTF || 0.08;
  var safety  = (+plan.safety || 0) / 100;
  var minReserve = Math.max(0, +plan.minReserve || 0);
  var capacity = +plan.capacity || 60;
  var startFuel = Math.min(capacity, +plan.startFuel || capacity);
  var stages = plan.stages.slice().sort(function(a,b){return (+a.n||0)-(+b.n||0);});

  // Sanity check: at least some km defined?
  var hasAnyKm = stages.some(function(s){return (+s.km||0)>0 || (+s.kmTF||0)>0;});
  if(!hasAnyKm){
    showToast('⚠️ Le PS non hanno km inseriti — impossibile generare il report');
    return;
  }

  // Build segments (same logic as fpRecalc)
  var segments = [];
  var currentSeg = { stages: [], totalFuel: 0, refuelMax: 0 };
  stages.forEach(function(s){
    var f = (+s.km||0)*consSS + (+s.kmTF||0)*consTF;
    currentSeg.stages.push({ s: s, fuel: f });
    currentSeg.totalFuel += f;
    if(s.refuelAfter){
      currentSeg.refuelMax = +s.refuelMax || 0;
      segments.push(currentSeg);
      currentSeg = { stages: [], totalFuel: 0, refuelMax: 0 };
    }
  });
  if(currentSeg.stages.length) segments.push(currentSeg);

  // Simulate fuel and compute refuel plan
  var fuel = startFuel;
  var refuelTotal = 0;
  var rows = [];
  var feasIssues = [];
  if(startFuel < minReserve && minReserve > 0){
    feasIssues.push('Serbatoio iniziale ('+startFuel.toFixed(1)+'L) sotto la riserva minima ('+minReserve.toFixed(1)+'L)');
  }
  segments.forEach(function(seg, segIdx){
    var consumption = seg.totalFuel * (1 + safety);
    var needed = consumption + minReserve;
    var startFuelOfSeg = fuel;
    var shortfall = needed - fuel;
    if(shortfall > 0.01){
      feasIssues.push('Segmento '+(segIdx+1)+': mancano '+shortfall.toFixed(1)+' L');
    }
    fuel = Math.max(0, fuel - seg.totalFuel);
    var endFuelOfSeg = fuel;
    if(endFuelOfSeg < minReserve - 0.01 && minReserve > 0){
      feasIssues.push('Segmento '+(segIdx+1)+': fine sotto riserva minima ('+endFuelOfSeg.toFixed(1)+'L)');
    }
    var refuelAdded = 0;
    var nextSegConsumption = (segIdx+1 < segments.length) ? segments[segIdx+1].totalFuel * (1+safety) : 0;
    var nextSegNeeded = nextSegConsumption + minReserve;
    if(segIdx+1 < segments.length){
      var desiredLevel = Math.min(capacity, nextSegNeeded);
      refuelAdded = Math.max(0, desiredLevel - fuel);
      var rmax = seg.refuelMax;
      if(rmax > 0 && refuelAdded > rmax){
        feasIssues.push('Refuel '+(segIdx+1)+': limite '+rmax+'L insufficiente');
        refuelAdded = rmax;
      }
      fuel += refuelAdded;
      refuelTotal += refuelAdded;
    }
    rows.push({
      idx: segIdx,
      stages: seg.stages,
      totalFuel: seg.totalFuel,
      consumption: consumption,
      reserve: minReserve,
      needed: needed,
      startFuelOfSeg: startFuelOfSeg,
      endFuelOfSeg: endFuelOfSeg,
      refuelAdded: refuelAdded,
      refuelLimit: seg.refuelMax,
      shortfall: Math.max(0, shortfall),
      isLast: segIdx === segments.length-1,
      fuelAfterRefuel: fuel
    });
  });
  var totKm = 0, totFuel = 0;
  stages.forEach(function(s){
    totKm += (+s.km||0) + (+s.kmTF||0);
    totFuel += (+s.km||0)*consSS + (+s.kmTF||0)*consTF;
  });

  var feasibleStr = feasIssues.length ? 'CRITICITÀ RILEVATE' : 'PIANO FATTIBILE';
  var feasibleColor = feasIssues.length ? '#c00' : '#2c8b3a';

  // Build the HTML report (clean, print-friendly)
  var now = new Date();
  var dateStr = now.toLocaleDateString('it-IT', {day:'2-digit', month:'long', year:'numeric'});
  var timeStr = now.toLocaleTimeString('it-IT', {hour:'2-digit', minute:'2-digit'});

  var html = '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8">' +
    '<title>Piano Carburante - '+(plan.name||'').replace(/[<>]/g,'')+'</title>' +
    '<style>' +
      '@page { size: A4; margin: 18mm 14mm; }' +
      '* { box-sizing: border-box; }' +
      'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; color: #222; font-size: 11pt; line-height: 1.4; margin: 0; padding: 0; }' +
      'h1 { font-size: 18pt; margin: 0 0 4pt 0; color: #b53d00; }' +
      'h2 { font-size: 13pt; margin: 14pt 0 6pt 0; padding-bottom: 3pt; border-bottom: 2pt solid #333; color: #333; }' +
      'h3 { font-size: 11pt; margin: 10pt 0 4pt 0; color: #444; }' +
      '.cover { padding: 0 0 8pt 0; border-bottom: 3pt solid #b53d00; margin-bottom: 12pt; }' +
      '.cover-meta { font-size: 9pt; color: #666; margin-top: 4pt; }' +
      '.kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6pt; margin: 8pt 0; }' +
      '.kpi { border: 1pt solid #ddd; border-radius: 3pt; padding: 6pt 8pt; text-align: center; background: #fafafa; }' +
      '.kpi-label { font-size: 7pt; color: #666; text-transform: uppercase; letter-spacing: 0.5pt; margin-bottom: 3pt; }' +
      '.kpi-val { font-size: 14pt; font-weight: 700; color: #b53d00; }' +
      'table { width: 100%; border-collapse: collapse; margin: 6pt 0; font-size: 9pt; }' +
      'th { background: #333; color: #fff; padding: 4pt 6pt; text-align: left; font-weight: 600; }' +
      'td { padding: 4pt 6pt; border-bottom: 0.5pt solid #ddd; }' +
      'tr.refuel { background: #e8f5e9; }' +
      'tr.refuel td { font-weight: 600; }' +
      '.alert { background: #ffe8e0; border-left: 3pt solid #c00; padding: 6pt 10pt; margin: 8pt 0; font-size: 9pt; }' +
      '.success { background: #e8f5e9; border-left: 3pt solid #2c8b3a; padding: 6pt 10pt; margin: 8pt 0; font-size: 9pt; }' +
      '.segment { border: 1pt solid #ddd; border-radius: 3pt; padding: 8pt 10pt; margin: 6pt 0; page-break-inside: avoid; }' +
      '.segment.warn { border-color: #c00; background: #fff5f0; }' +
      '.segment-head { display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 4pt; }' +
      '.segment-stages { color: #555; font-size: 9pt; margin-bottom: 6pt; }' +
      '.fuel-line { display: flex; gap: 14pt; flex-wrap: wrap; font-size: 8pt; color: #666; margin-bottom: 4pt; }' +
      '.fuel-line b { color: #222; font-weight: 600; }' +
      '.refuel-action { background: #fff8e1; border-radius: 2pt; padding: 4pt 8pt; font-size: 9pt; color: #333; }' +
      '.footer { margin-top: 24pt; padding-top: 6pt; border-top: 1pt solid #ddd; font-size: 8pt; color: #999; text-align: center; }' +
      '.params-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4pt 16pt; font-size: 9pt; margin: 6pt 0; }' +
      '.param-label { color: #777; }' +
      '.param-value { font-weight: 600; }' +
    '</style></head><body>';

  // ─── Cover ───
  html += '<div class="cover">';
  html += '<h1>📋 PIANO CARBURANTE RALLY</h1>';
  html += '<div style="font-size:13pt;font-weight:600;color:#333;">'+(plan.name||'(senza nome)').replace(/</g,'&lt;')+'</div>';
  html += '<div class="cover-meta">Generato il '+dateStr+' alle '+timeStr+'</div>';
  html += '</div>';

  // ─── Verdetto fattibilità (in alto, vistoso) ───
  var endFuelStr = rows.length ? rows[rows.length-1].endFuelOfSeg.toFixed(1) : '0.0';
  if(feasIssues.length === 0){
    html += '<div class="success"><b style="color:'+feasibleColor+';">✓ '+feasibleStr+'</b><br>'+
      'Margine sicurezza '+(safety*100).toFixed(0)+'% applicato' +
      (minReserve > 0 ? ' · riserva minima '+minReserve.toFixed(1)+'L garantita' : '') +
      '. Carburante a fine rally: '+endFuelStr+' L.</div>';
  } else {
    html += '<div class="alert"><b style="color:'+feasibleColor+';">⚠ '+feasibleStr+' ('+feasIssues.length+')</b><ul style="margin:4pt 0 0 14pt;padding:0;">';
    feasIssues.forEach(function(m){ html += '<li>'+m.replace(/</g,'&lt;')+'</li>'; });
    html += '</ul></div>';
  }

  // ─── KPI riepilogativi ───
  html += '<div class="kpi-grid">';
  html += '<div class="kpi"><div class="kpi-label">PS Totali</div><div class="kpi-val">'+stages.length+'</div></div>';
  html += '<div class="kpi"><div class="kpi-label">KM Totali</div><div class="kpi-val">'+totKm.toFixed(1)+'</div></div>';
  html += '<div class="kpi"><div class="kpi-label">Consumo Stimato</div><div class="kpi-val">'+(totFuel*(1+safety)).toFixed(1)+' L</div></div>';
  html += '<div class="kpi"><div class="kpi-label">Refuel Totali</div><div class="kpi-val">'+refuelTotal.toFixed(1)+' L</div></div>';
  html += '</div>';

  // ─── Parametri base ───
  html += '<h2>⚙ PARAMETRI BASE</h2>';
  html += '<div class="params-grid">';
  html += '<div><span class="param-label">Capacità serbatoio:</span> <span class="param-value">'+capacity.toFixed(1)+' L</span></div>';
  html += '<div><span class="param-label">Serbatoio iniziale:</span> <span class="param-value">'+startFuel.toFixed(1)+' L</span></div>';
  html += '<div><span class="param-label">Riserva minima:</span> <span class="param-value">'+minReserve.toFixed(1)+' L</span></div>';
  html += '<div><span class="param-label">Consumo SS:</span> <span class="param-value">'+consSS.toFixed(3)+' L/km</span></div>';
  html += '<div><span class="param-label">Consumo Trasf.:</span> <span class="param-value">'+consTF.toFixed(3)+' L/km</span></div>';
  html += '<div><span class="param-label">Margine sicurezza:</span> <span class="param-value">'+(safety*100).toFixed(0)+' %</span></div>';
  html += '</div>';

  // ─── RIEPILOGO RIFORNIMENTI (la cosa che il cliente cerca subito) ───
  html += '<h2>🎯 RIEPILOGO RIFORNIMENTI</h2>';
  html += '<p style="font-size:9pt;color:#666;">Tabella sintetica: per ogni rifornimento, quanti litri caricare. Da consultare durante il rally al parco assistenza.</p>';
  html += '<table>';
  html += '<thead><tr><th style="width:80px;">RIFORN.</th><th>DOPO PS</th><th>LITRI DA CARICARE</th><th>SERBATOIO DOPO</th><th>LIMITE</th></tr></thead><tbody>';
  var refuelN = 0;
  rows.forEach(function(r){
    if(r.isLast) return;
    refuelN++;
    var lastStageInSeg = r.stages[r.stages.length-1].s;
    html += '<tr class="refuel">';
    html += '<td><b>R'+refuelN+'</b></td>';
    html += '<td>PS'+(lastStageInSeg.n||'?')+(lastStageInSeg.name?' — '+(lastStageInSeg.name||'').replace(/</g,'&lt;'):'')+'</td>';
    html += '<td><b style="color:#b53d00;font-size:11pt;">'+r.refuelAdded.toFixed(1)+' L</b></td>';
    html += '<td>'+r.fuelAfterRefuel.toFixed(1)+' L / '+capacity.toFixed(1)+' L</td>';
    html += '<td>'+(r.refuelLimit > 0 ? r.refuelLimit.toFixed(1)+'L max' : 'illimitato')+'</td>';
    html += '</tr>';
  });
  if(refuelN === 0){
    html += '<tr><td colspan="5" style="text-align:center;color:#999;font-style:italic;padding:10pt;">Nessun rifornimento richiesto (singolo segmento o nessun refuel definito)</td></tr>';
  }
  html += '</tbody></table>';
  html += '<div style="font-size:8pt;color:#666;margin-top:4pt;">Totale carburante da caricare durante il rally: <b>'+refuelTotal.toFixed(1)+' L</b></div>';

  // ─── Tabella PS dettagliata ───
  html += '<h2>🏞 PROVE SPECIALI E TRASFERIMENTI</h2>';
  html += '<table>';
  html += '<thead><tr><th>PS#</th><th>NOME</th><th>KM PS</th><th>KM TRASF</th><th>L SS</th><th>L TF</th><th>L TOT</th><th>REFUEL DOPO</th></tr></thead><tbody>';
  stages.forEach(function(s){
    var litSS = (+s.km||0)*consSS;
    var litTF = (+s.kmTF||0)*consTF;
    var refuelInfo = '—';
    if(s.refuelAfter){
      refuelInfo = s.refuelMax > 0 ? '⛽ MAX '+s.refuelMax+'L' : '⛽ illimitato';
    }
    html += '<tr>';
    html += '<td><b>PS'+(s.n||'?')+'</b></td>';
    html += '<td>'+(s.name||'—').replace(/</g,'&lt;')+'</td>';
    html += '<td>'+(s.km||0).toFixed(1)+'</td>';
    html += '<td>'+(s.kmTF||0).toFixed(1)+'</td>';
    html += '<td>'+litSS.toFixed(2)+'</td>';
    html += '<td>'+litTF.toFixed(2)+'</td>';
    html += '<td><b>'+(litSS+litTF).toFixed(2)+'</b></td>';
    html += '<td>'+refuelInfo+'</td>';
    html += '</tr>';
  });
  html += '</tbody></table>';

  // ─── Dettaglio segmenti ───
  html += '<h2>📈 DETTAGLIO SEGMENTI TRA REFUEL</h2>';
  html += '<p style="font-size:9pt;color:#666;">Per ogni segmento, consumo previsto e simulazione del livello serbatoio.</p>';
  rows.forEach(function(r){
    var stagesList = r.stages.map(function(x){return 'PS'+(x.s.n||'?')+(x.s.name?' '+x.s.name:'');}).join(' → ');
    var warnClass = r.shortfall > 0.01 || r.endFuelOfSeg < r.reserve - 0.01 ? ' warn' : '';
    html += '<div class="segment'+warnClass+'">';
    html += '<div class="segment-head"><span>SEGMENTO '+(r.idx+1)+'</span><span style="color:'+(r.shortfall>0.01?'#c00':'#2c8b3a')+';">'+(r.shortfall>0.01?'⚠ MANCA '+r.shortfall.toFixed(1)+'L':'✓ OK')+'</span></div>';
    html += '<div class="segment-stages">'+stagesList.replace(/</g,'&lt;')+'</div>';
    html += '<div class="fuel-line">';
    html += '<span>Consumo base: <b>'+r.totalFuel.toFixed(2)+' L</b></span>';
    html += '<span>Con margine: <b>'+r.consumption.toFixed(2)+' L</b></span>';
    if(r.reserve > 0) html += '<span>+ Riserva: <b>'+r.reserve.toFixed(1)+' L</b></span>';
    html += '<span>Tot necessario: <b>'+r.needed.toFixed(2)+' L</b></span>';
    html += '</div>';
    html += '<div class="fuel-line">';
    html += '<span>Inizio segmento: <b>'+r.startFuelOfSeg.toFixed(1)+' L</b></span>';
    html += '<span>Fine segmento: <b style="color:'+(r.endFuelOfSeg<r.reserve?'#c00':'#222')+';">'+r.endFuelOfSeg.toFixed(1)+' L</b></span>';
    html += '</div>';
    if(!r.isLast){
      html += '<div class="refuel-action">⛽ <b>Carica '+r.refuelAdded.toFixed(1)+' L</b> al rifornimento successivo' +
        (r.refuelLimit > 0 ? ' (limite: '+r.refuelLimit+'L)' : '') +
        ' → serbatoio: <b>'+r.fuelAfterRefuel.toFixed(1)+' L</b></div>';
    } else {
      html += '<div style="font-size:9pt;color:#666;">🏁 Fine rally — carburante residuo: <b>'+r.endFuelOfSeg.toFixed(1)+' L</b></div>';
    }
    html += '</div>';
  });

  // ─── Footer ───
  // ─── TABELLA RIEPILOGATIVA TEORICO/EFFETTIVO (stile foglio rally cartaceo) ───
  // Ogni segmento tra refuel = una riga "Leg N" + una riga "End leg N" (stato dopo refuel)
  html += '<h2 style="page-break-before:always;">📊 TABELLA TEORICO / EFFETTIVO</h2>';
  html += '<p style="font-size:9pt;color:#666;margin-bottom:6pt;">Riepilogo per leg. Sezione TEORICO calcolata dal piano. Sezione EFFETTIVO da compilare a mano durante/dopo il rally.</p>';
  html += '<table style="font-size:8.5pt;">';
  html += '<thead>';
  html += '<tr style="background:#222;color:#fff;">'+
    '<th rowspan="2" style="vertical-align:middle;border-right:1pt solid #555;">FASE</th>'+
    '<th colspan="3" style="text-align:center;border-right:1pt solid #555;border-bottom:0.5pt solid #555;">km</th>'+
    '<th colspan="4" style="text-align:center;border-right:2pt solid #fff;border-bottom:0.5pt solid #555;background:#444;">TEORICO (litri)</th>'+
    '<th colspan="4" style="text-align:center;border-bottom:0.5pt solid #555;background:#444;">EFFETTIVO (litri)</th>'+
  '</tr>';
  html += '<tr style="background:#333;color:#fff;font-size:7.5pt;">'+
    '<th style="border-right:0.5pt solid #555;">P.S.</th>'+
    '<th style="border-right:0.5pt solid #555;">TRASF.</th>'+
    '<th style="border-right:1pt solid #555;">TOTALE</th>'+
    '<th style="border-right:0.5pt solid #555;">P.S.</th>'+
    '<th style="border-right:0.5pt solid #555;">TRASF.</th>'+
    '<th style="border-right:0.5pt solid #555;">TOT</th>'+
    '<th style="border-right:2pt solid #fff;background:#444;">+MARGINE</th>'+
    '<th style="border-right:0.5pt solid #555;">REALI</th>'+
    '<th style="border-right:0.5pt solid #555;">RIMASTI</th>'+
    '<th style="border-right:0.5pt solid #555;">CONSUMATI</th>'+
    '<th>DIFFERENZA</th>'+
  '</tr>';
  html += '</thead><tbody>';

  // Riga "Start" — situazione al via (zero consumo, livello iniziale)
  html += '<tr style="background:#fff8e1;">'+
    '<td><b>Start</b></td>'+
    '<td style="text-align:right;">0</td>'+
    '<td style="text-align:right;">0</td>'+
    '<td style="text-align:right;">0</td>'+
    '<td style="text-align:right;">0,0</td>'+
    '<td style="text-align:right;">0,0</td>'+
    '<td style="text-align:right;">0,0</td>'+
    '<td style="text-align:right;background:#fffde7;"><b>'+startFuel.toFixed(1)+'</b></td>'+
    '<td style="background:#f5f5f5;"></td>'+
    '<td style="background:#f5f5f5;"></td>'+
    '<td style="background:#f5f5f5;"></td>'+
    '<td style="background:#f5f5f5;"></td>'+
  '</tr>';

  // Per ogni segmento: una riga "Leg N" e (se non ultimo) una "End leg N"
  // Accumulatori cumulativi
  var cumKmPS = 0, cumKmTF = 0, cumLitPS = 0, cumLitTF = 0;
  rows.forEach(function(r, segIdx){
    // Riepilogo segmento (somma di tutte le PS dentro il segmento)
    var kmPS = 0, kmTF = 0;
    r.stages.forEach(function(x){
      kmPS += (+x.s.km || 0);
      kmTF += (+x.s.kmTF || 0);
    });
    var litPS = kmPS * consSS;
    var litTF = kmTF * consTF;
    var litTot = litPS + litTF;
    var litWithMargin = litTot * (1 + safety) + minReserve;
    cumKmPS += kmPS; cumKmTF += kmTF;
    cumLitPS += litPS; cumLitTF += litTF;

    // Riga Leg N
    var legLabel = 'Leg ' + (segIdx+1);
    // (Riga "Leg N" rimossa su richiesta — mostriamo solo End leg / End rally con i cumulativi)

    // Riga End leg N (per ogni refuel) oppure End rally per l'ultimo segmento
    var isEndRally = r.isLast;
    var rowLabel = isEndRally ? 'End rally' : 'End leg '+(segIdx+1);
    var bg = isEndRally ? '#fff3e0' : '#e8f5e9'; // arancione chiaro fine rally, verde chiaro end leg
    var marginCell = isEndRally
      ? '<b>'+Math.round((cumLitPS+cumLitTF)*(1+safety)+minReserve)+'</b>'  // teorico cumulativo con margine
      : '<b>⛽ +'+r.refuelAdded.toFixed(1).replace('.', ',')+'</b>';         // litri da caricare al refuel
    html += '<tr style="background:'+bg+';">'+
      '<td><b>'+rowLabel+'</b></td>'+
      '<td style="text-align:right;">'+cumKmPS.toFixed(2)+'</td>'+
      '<td style="text-align:right;">'+cumKmTF.toFixed(2)+'</td>'+
      '<td style="text-align:right;">'+(cumKmPS+cumKmTF).toFixed(2)+'</td>'+
      '<td style="text-align:right;">'+cumLitPS.toFixed(1).replace('.', ',')+'</td>'+
      '<td style="text-align:right;">'+cumLitTF.toFixed(1).replace('.', ',')+'</td>'+
      '<td style="text-align:right;">'+(cumLitPS+cumLitTF).toFixed(1).replace('.', ',')+'</td>'+
      '<td style="text-align:right;background:#fff8e1;">'+marginCell+'</td>'+
      '<td style="background:#f5f5f5;"></td>'+
      '<td style="background:#f5f5f5;"></td>'+
      '<td style="background:#f5f5f5;"></td>'+
      '<td style="background:#f5f5f5;"></td>'+
    '</tr>';
  });

  // Riga TOTALE finale
  html += '<tr style="background:#222;color:#fff;font-weight:700;">'+
    '<td>TOTALE</td>'+
    '<td style="text-align:right;">'+cumKmPS.toFixed(2)+'</td>'+
    '<td style="text-align:right;">'+cumKmTF.toFixed(2)+'</td>'+
    '<td style="text-align:right;">'+(cumKmPS+cumKmTF).toFixed(2)+'</td>'+
    '<td style="text-align:right;">'+cumLitPS.toFixed(1).replace('.', ',')+'</td>'+
    '<td style="text-align:right;">'+cumLitTF.toFixed(1).replace('.', ',')+'</td>'+
    '<td style="text-align:right;">'+(cumLitPS+cumLitTF).toFixed(1).replace('.', ',')+'</td>'+
    '<td style="text-align:right;background:#444;">'+Math.round((cumLitPS+cumLitTF)*(1+safety)+minReserve*rows.length)+'</td>'+
    '<td style="background:#444;"></td>'+
    '<td style="background:#444;"></td>'+
    '<td style="background:#444;"></td>'+
    '<td style="background:#444;"></td>'+
  '</tr>';
  html += '</tbody></table>';

  // Legenda
  html += '<div style="font-size:8pt;color:#666;margin-top:6pt;line-height:1.5;">'+
    '<b>Legenda:</b> &nbsp;'+
    '<span style="background:#fff8e1;padding:1pt 4pt;">Start / End leg</span> stato chiave del segmento &nbsp;·&nbsp; '+
    '<span style="background:#fffde7;padding:1pt 4pt;">+MARGINE</span> litri totali con margine + riserva &nbsp;·&nbsp; '+
    '<span style="background:#f5f5f5;padding:1pt 4pt;">EFFETTIVO</span> da compilare a mano durante/dopo il rally'+
  '</div>';

  html += '<div class="footer">Race Engineer Pro — Piano Carburante "'+(plan.name||'').replace(/</g,'&lt;')+'" — '+dateStr+' '+timeStr+'</div>';
  html += '</body></html>';

  // Try to open print window. If blocked or fails, offer download as fallback.
  var w = null;
  try { w = window.open('', '_blank'); } catch(_){}
  if(!w || w.closed){
    // Popup blocked: download as HTML file instead, user can open and print manually
    var blob = new Blob([html], { type: 'text/html;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    var safeName = (plan.name||'piano-carburante').replace(/[^a-zA-Z0-9_\-]/g,'_');
    a.download = 'piano-carburante-'+safeName+'-'+now.toISOString().slice(0,10)+'.html';
    document.body.appendChild(a);
    a.click();
    setTimeout(function(){
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 100);
    showToast('⚠️ Popup bloccato — scaricato come HTML. Aprilo e premi Ctrl+P per stampare in PDF');
    return;
  }
  w.document.open();
  w.document.write(html);
  w.document.close();
  // Give the document time to render before triggering print
  setTimeout(function(){
    try {
      w.focus();
      w.print();
    } catch(e){
      // If auto-print fails, user can press Ctrl+P manually — the window is open
    }
  }, 600);
  showToast('🖨 Report aperto — usa "Salva come PDF" dalla finestra di stampa');
}
