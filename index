// Apply filter: hide menu items not in enabled list
function applyCustomNavFilter(){
  loadCustomMode();
  if(!CUSTOM_MODE.enabledPages || !CUSTOM_MODE.enabledPages.length){
    // First time in custom mode without config → open setup
    setTimeout(function(){ openCustomModeSetup(); }, 300);
    return;
  }
  var enabled = new Set(CUSTOM_MODE.enabledPages);
  // Iterate all nav-menu-item elements and hide those whose page isn't enabled
  document.querySelectorAll('.nav-menu-item').forEach(function(item){
    var oc = item.getAttribute('onclick') || '';
    // Extract pageId from showPage('xxx') or stGo('xxx') or specific calls
    var m = oc.match(/showPage\s*\(\s*['"]([^'"]+)['"]/);
    var pageId = m ? m[1] : null;
    // Also handle stGo (stagione subpages)
    if(!pageId && oc.indexOf('stGo(') >= 0) pageId = 'stagione';
    // openCarManager / openTrackEditor: show always
    if(!pageId && (oc.indexOf('openCarManager')>=0 || oc.indexOf('openTrackEditor')>=0)){
      item.style.display = '';
      return;
    }
    if(pageId){
      item.style.display = enabled.has(pageId) ? '' : 'none';
    }
  });
  // Hide nav-group buttons whose menu has all items hidden.
  // In custom mode we keep both track-nav and rally-nav groups (baseline 30+ pages),
  // but individual groups are hidden if empty OR if the group has no items and was
  // already hidden by mode rules.
  document.querySelectorAll('.nav-group').forEach(function(grp){
    var anyVisible = Array.from(grp.querySelectorAll('.nav-menu-item')).some(function(mi){
      return mi.style.display !== 'none';
    });
    grp.style.display = anyVisible ? '' : 'none';
    // Also their preceding separator
    var sep = grp.previousElementSibling;
    if(sep && sep.classList && sep.classList.contains('nav-grp-sep')) sep.style.display = anyVisible ? '' : 'none';
  });
}
// Restore nav to default state for a given mode (track / rally / any other).
// Optional mode argument so callers can tell us which mode we are switching TO,
// so we can clear inline styles and let the mode-based .track-nav / .rally-nav
// classes control visibility again.
function resetCustomNavFilter(mode){
  // Clear item-level display overrides so nothing stays hidden across mode changes
  document.querySelectorAll('.nav-menu-item').forEach(function(item){ item.style.display = ''; });
  // For nav-groups and separators: clear inline display so the mode's class rules win.
  // But we must also respect the current mode's .track-nav / .rally-nav visibility.
  document.querySelectorAll('.nav-group').forEach(function(grp){
    var sep = grp.previousElementSibling;
    if(mode === 'track'){
      // Show only track-nav groups, hide rally-nav groups
      if(grp.classList.contains('track-nav')){
        grp.style.display = '';
        if(sep && sep.classList && sep.classList.contains('nav-grp-sep')) sep.style.display = '';
      } else if(grp.classList.contains('rally-nav')){
        grp.style.display = 'none';
        if(sep && sep.classList && sep.classList.contains('nav-grp-sep')) sep.style.display = 'none';
      } else {
        grp.style.display = '';
        if(sep && sep.classList && sep.classList.contains('nav-grp-sep')) sep.style.display = '';
      }
    } else if(mode === 'rally'){
      if(grp.classList.contains('rally-nav')){
        grp.style.display = '';
        if(sep && sep.classList && sep.classList.contains('nav-grp-sep')) sep.style.display = '';
      } else if(grp.classList.contains('track-nav')){
        grp.style.display = 'none';
        if(sep && sep.classList && sep.classList.contains('nav-grp-sep')) sep.style.display = 'none';
      } else {
        grp.style.display = '';
        if(sep && sep.classList && sep.classList.contains('nav-grp-sep')) sep.style.display = '';
      }
    } else {
      // No mode specified or custom: just clear inline override
