/* ---- PILOTA: dal feedback alla fase, mosse filtrate ---- */
function saPilotDetect(mode, car){
  try {
    var texts=[];
    ((STATE.teleNotes&&STATE.teleNotes[car.id])||[]).slice(-6).forEach(function(n){ texts.push(String(n.note||n.text||n)); });
    var hist = mode==='rally'? ((STATE.rallySetup||{})[car.id]||[]) : ((STATE.setup||{})[car.id]||[]);
    hist.slice(-2).forEach(function(e){ texts.push(String(e.notes||'')); });
    var t=texts.join(' · ').toLowerCase();
    var prob = /sottosterz|understeer|non gira|spinge/.test(t)? 'und' : (/sovrasterz|oversteer|scoda|nervosa/.test(t)? 'ovr' : null);
    var phase = /uscita|trazion|gas|acceler/.test(t)? 'exit' : (/ingresso|inseriment|staccata|fren/.test(t)? 'entry' : (/percorrenz|centro/.test(t)? 'mid' : null));
    return { prob:prob, phase:phase, sample:t.slice(0,120) };
  } catch(e){ return {prob:null, phase:null, sample:''}; }
}
function saPilotHTML(mode){
  var car=saCar(mode);
  var det=saPilotDetect(mode, car);
  var html='<div class="sa-sec">🗣 PILOTA → MOSSE PER FASE</div>';
  html+='<div class="form-row mb8">'+
    '<div class="field"><label>Problema</label><select id="sa-pl-prob-'+mode+'">'+
      '<option value="und"'+(det.prob==='und'?' selected':'')+'>Sottosterzo</option>'+
      '<option value="ovr"'+(det.prob==='ovr'?' selected':'')+'>Sovrasterzo</option></select></div>'+
    '<div class="field"><label>Fase</label><select id="sa-pl-phase-'+mode+'">'+
      '<option value="entry"'+(det.phase==='entry'?' selected':'')+'>Ingresso</option>'+
      '<option value="mid"'+(det.phase==='mid'||!det.phase?' selected':'')+'>Percorrenza</option>'+
      '<option value="exit"'+(det.phase==='exit'?' selected':'')+'>Uscita</option></select></div>'+
  '</div>'+
  (det.prob? '<div class="small" style="margin-bottom:6px;opacity:.8">Rilevato dalle note: "'+det.sample.replace(/</g,'&lt;')+'"</div>':'')+
  '<button class="btn btn-green" style="font-size:11px" onclick="saPilotAdvise(\''+mode+'\')">🔧 MOSSE PER QUESTA FASE</button>'+
  '<div id="sa-pl-out-'+mode+'" style="margin-top:8px"></div>';
  return html;
}
window.saPilotAdvise = function(mode){
  var out=document.getElementById('sa-pl-out-'+mode);
  if(!out) return;
  try {
    var prob=(document.getElementById('sa-pl-prob-'+mode)||{}).value||'und';
    var phase=(document.getElementById('sa-pl-phase-'+mode)||{}).value||'mid';
    var wantDir = prob==='und'? +1 : -1;    // sottosterzo -> serve +U (verso sovra) in quella fase
    var ctx=saCtx(mode);
    var A0=saAnalyze(ctx.cur, ctx.p, ctx.surf);
    var cands=[];
    saMoves(ctx.cur, ctx.p, ctx.surf, ctx.prof).forEach(function(m){
      try {
        var A1=saAnalyze(m.s, ctx.p, ctx.surf);
        var dPh=(A1.phases[phase].U - A0.phases[phase].U);
        var C=saCompare(A1, A0, ctx.p, ctx.surf, ctx.prof);
        if(dPh*wantDir > 0.002) cands.push({ lab:m.lab, conf:m.conf, dPh:dPh, dt:C.total });
      } catch(e){}
    });
    cands.sort(function(a,b){ return (Math.abs(b.dPh)-Math.abs(a.dPh)) || (a.dt-b.dt); });
    var phName={entry:'INGRESSO',mid:'PERCORRENZA',exit:'USCITA'}[phase];
    if(!cands.length){ out.innerHTML='<div class="small" style="color:var(--yellow)">Nessuna mossa efficace trovata per '+phName+' dai valori attuali: compila più campi (barre, diff, bias) per avere più manopole.</div>'; return; }
    var html='<div class="small" style="margin-bottom:4px">Correggere <b>'+(prob==='und'?'SOTTOSTERZO':'SOVRASTERZO')+'</b> in <b>'+phName+'</b> — mosse ordinate per effetto sulla fase:</div><ol style="margin:0 0 4px 18px;font-size:12px;line-height:1.8">';
    cands.slice(0,5).forEach(function(c){
      html+='<li><b>'+c.lab.replace(/</g,'&lt;')+'</b> <span style="color:var(--teal)">'+fmtSigned(c.dPh*100,1)+' pt fase</span> · <span style="color:'+(c.dt<0?'var(--green)':'var(--text3)')+'">Δt '+fmtSigned(c.dt,3)+'s</span> <span class="small">'+c.conf+'</span></li>';
    });
    html+='</ol><div class="small" style="opacity:.7">Una alla volta, poi verifica (Smith). Le mosse che correggono la fase ma costano tempo sono in grigio.</div>';
    out.innerHTML=html;
  } catch(e){ out.innerHTML='<span class="small" style="color:var(--yellow)">Errore: '+String(e.message).replace(/</g,'&lt;')+'</span>'; }
};

/* ---- STINT: degrado dai giri, benzina, finestra pit ---- */
function saStintHTML(mode){
  var car=saCar(mode);
  var html='<div class="sa-sec">⛽ STINT — '+car.name+'</div>';
  if(mode==='rally'){
    var rf=(STATE.rallyFuel||{})[car.id];
    var done=(STATE.stages||[]).filter(function(s){return s.car===car.name&&!s.cancelled;}).length;
    var tot=+(STATE.rallyNumStages||0);
    var kmLeft=0;
    // stima km rimanenti dai km medi PS
    var kms=(STATE.stages||[]).filter(function(s){return s.car===car.name;}).map(function(s){return +s.km||0;}).filter(Boolean);
    var avgKm=kms.length? kms.reduce(function(a,b){return a+b;},0)/kms.length : 12;
    if(tot>done) kmLeft=(tot-done)*avgKm;
    html+='<div class="small" style="line-height:1.8">PS fatte: <b>'+done+(tot?'/'+tot:'')+'</b> · km PS rimanenti stimati: <b>'+kmLeft.toFixed(0)+'</b><br>';
    if(rf){
      var cons=+rf.consSS||0.18;
      var need=kmLeft*cons*1.15;
      html+='Benzina: <b>'+(+rf.current).toFixed(1)+' L</b> · fabbisogno stimato (PS +15% margine): <b>'+need.toFixed(1)+' L</b> → '+
        ((+rf.current)>=need? '<b style="color:var(--green)">OK fino a fine gara</b>' : '<b style="color:var(--red)">RIFORNIRE (+'+(need-(+rf.current)).toFixed(1)+' L)</b>');
    }
    return html+'</div>';
  }
  var laps=(STATE.laps&&STATE.laps[car.id])||[];
  var times=laps.map(function(l){ return parseTime(l.time); }).filter(Boolean);
  if(times.length<4) return html+'<div class="small" style="color:var(--yellow)">Servono almeno 4 giri per stimare il degrado.</div>';
  var N=Math.min(10, times.length);
  var seg=times.slice(-N).map(function(t){return t/1000;});
  // fit lineare tempo vs indice
  var n=seg.length, sx=0, sy=0, sxy=0, sxx=0;
  seg.forEach(function(y,i){ sx+=i; sy+=y; sxy+=i*y; sxx+=i*i; });
  var slope=(n*sxy-sx*sy)/Math.max(1,(n*sxx-sx*sx));
  var deg=Math.max(0, slope);
  var fu=(STATE.fuel||{})[car.id];
  var lapsFuel=fu&&(+fu.perLap)>0? Math.floor((+fu.current)/(+fu.perLap)) : null;
  var ty=(STATE.tyres||{})[car.id];
  var age=ty&&ty.current? laps.length-(ty.current.lapsMounted||0) : null;
  html+='<div class="form-row mb8">'+
    '<div class="field"><label>Giri rimanenti sessione</label><input type="number" id="sa-st-laps-'+mode+'" value="12"></div>'+
    '<div class="field"><label>Perdita pit (s)</label><input type="number" id="sa-st-pit-'+mode+'" value="25"></div>'+
  '</div>'+
  '<button class="btn btn-green" style="font-size:11px" onclick="saStintCalc(\''+mode+'\')">CALCOLA</button>'+
  '<div class="small" style="margin-top:6px;line-height:1.8">Degrado misurato (ultimi '+N+' giri): <b>'+(deg>0.001? '+'+deg.toFixed(3)+' s/giro':'~0 (stint stabile)')+'</b>'+
  (age!==null? ' · gomme: <b>'+age+' giri</b>':'')+(lapsFuel!==null? ' · benzina per <b>'+lapsFuel+' giri</b>':'')+'</div>'+
  '<div id="sa-st-out-'+mode+'" style="margin-top:6px"></div>';
  window['_saStintDeg_'+mode]=deg;
  window['_saStintFuel_'+mode]=lapsFuel;
  return html;
}
window.saStintCalc = function(mode){
  var out=document.getElementById('sa-st-out-'+mode);
  if(!out) return;
  var deg=window['_saStintDeg_'+mode]||0;
  var lapsFuel=window['_saStintFuel_'+mode];
  var R=+((document.getElementById('sa-st-laps-'+mode)||{}).value)||10;
  var pit=+((document.getElementById('sa-st-pit-'+mode)||{}).value)||25;
  var lossStay=0;
  for(var i=1;i<=R;i++) lossStay+=deg*i;   // perdita cumulata restando fuori
  var html='<div class="small" style="line-height:1.8">Restando fuori '+R+' giri perdi ≈ <b>'+lossStay.toFixed(1)+' s</b> di degrado cumulato.<br>';
  if(deg>0.005){
    var be=Math.ceil(Math.sqrt(2*pit/Math.max(0.001,deg)));
    html+= lossStay>pit?
      '<b style="color:var(--yellow)">Conviene il PIT</b> se hai gomme fresche: breakeven ≈ <b>'+be+' giri</b> rimanenti (pit '+pit+'s vs degrado).' :
      '<b style="color:var(--green)">Resta fuori</b>: il degrado cumulato ('+lossStay.toFixed(1)+'s) non ripaga la sosta ('+pit+'s).';
  } else html+='<b style="color:var(--green)">Degrado trascurabile: nessun pit necessario per le gomme.</b>';
  if(lapsFuel!==null && lapsFuel<R) html+='<br><b style="color:var(--red)">⚠ Benzina per soli '+lapsFuel+' giri su '+R+': rifornimento obbligatorio.</b>';
  out.innerHTML=html+'</div>';
};


