function applyHeaderStyle(ws, row, cols) {
  for(let c=0;c<cols;c++) {
    const cell = XLSX.utils.encode_cell({r:row,c});
    if(ws[cell]) ws[cell].s = xlsStyle('header');
  }
}


function styleSheetAdvanced(ws, headerRow=0) {
  const range = XLSX.utils.decode_range(ws['!ref']||'A1');
  // Auto-width columns (approximate)
  const colWidths = {};
  for(let R=range.s.r; R<=range.e.r; R++) {
    for(let C=range.s.c; C<=range.e.c; C++) {
      const cell = ws[XLSX.utils.encode_cell({r:R,c:C})];
      if(cell && cell.v) {
        const len = String(cell.v).length;
        colWidths[C] = Math.max(colWidths[C]||8, Math.min(40, len+2));
      }
    }
  }
  ws['!cols'] = Object.keys(colWidths).sort((a,b)=>+a-+b).map(c=>({wch:colWidths[c]||12}));
  // Row height for header
  ws['!rows'] = ws['!rows']||[];
  ws['!rows'][headerRow] = {hpt:22};
  // Apply header style
  applyHeaderStyle(ws, headerRow, range.e.c+1);
  // Freeze header row
  ws['!freeze'] = {xSplit:0, ySplit:headerRow+1, topLeftCell:XLSX.utils.encode_cell({r:headerRow+1,c:0}), activeCell:XLSX.utils.encode_cell({r:headerRow+1,c:0}), sqref:XLSX.utils.encode_cell({r:headerRow+1,c:0})};
  return ws;
}



