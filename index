function _diaryRenderList(){
  var listEl = document.getElementById('diary-list');
  if(!listEl) return;
  var entries = _diaryFilteredEntries();
  if(!entries.length){
    listEl.innerHTML = '<div style="background:var(--bg3);padding:16px;border-radius:5px;text-align:center;color:var(--text3);font-size:12px;">'+
