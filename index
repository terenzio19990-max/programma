function selectCircuit(val) {
  if(!val) return;
  STATE.circuit = val;
  const c = CIRCUITS[val];
  document.getElementById('circuit-name-head').textContent = c.name;
  const info = document.getElementById('circuit-info');
  // Compute personal best across all track cars on records (simplified: the all-time best lap)
  var personalBest = '—';
  var personalBestCar = '';
  try {
    var allTimes = [];
    (STATE.trackCars||[]).forEach(function(car){
      (STATE.laps[car.id]||[]).forEach(function(l){
        var ms = parseTime(l.time);
        if(ms && isFinite(ms)) allTimes.push({ms:ms, car:car.name});
      });
    });
    if(allTimes.length){
      allTimes.sort(function(a,b){return a.ms-b.ms;});
      var bestEver = allTimes[0];
      var min = Math.floor(bestEver.ms/60000);
      var sec = ((bestEver.ms%60000)/1000).toFixed(3);
      if(sec.length === 5) sec = '0'+sec;
      personalBest = min+':'+sec;
      personalBestCar = bestEver.car;
    }
  } catch(_){}

  var sectorsStr = c.sectors && c.sectors.length === 3
    ? c.sectors.map(function(s){return s+' km';}).join(' · S2: ').replace(' km · S2:', ' km — S2:').replace(' km — S2: ', ' km · ')
    : '—';
  // Cleaner version
  if(c.sectors && c.sectors.length === 3){
    sectorsStr = 'S1 '+c.sectors[0]+'km · S2 '+c.sectors[1]+'km · S3 '+c.sectors[2]+'km';
  }

  info.innerHTML = `
    <div class="ci-tag"><span>LUNGHEZZA</span><span>${c.km} km</span></div>
    <div class="ci-tag"><span>CURVE</span><span>${c.turns}</span></div>
    <div class="ci-tag"><span>PAESE</span><span>${c.country}</span></div>
    <div class="ci-tag"><span>RECORD UFFICIALE</span><span>${c.record}${c.recordCat?' <small style="opacity:0.7;">('+c.recordCat+')</small>':''}</span></div>
    <div class="ci-tag" style="border-color:var(--green);"><span>IL TUO BEST</span><span style="color:var(--green);">${personalBest}${personalBestCar?' <small style="opacity:0.7;">'+personalBestCar+'</small>':''}</span></div>
    ${c.sectors ? `<div class="ci-tag"><span>SETTORI</span><span style="font-size:10px;">${sectorsStr}</span></div>` : ''}
    ${c.pitLengthM ? `<div class="ci-tag"><span>PIT LANE</span><span>${c.pitLengthM}m · max ${c.pitLimitKmh||60} km/h</span></div>` : ''}
    ${c.notes ? `<div class="ci-tag" style="flex-basis:100%;border-color:var(--blue);"><span>NOTE</span><span style="font-size:10px;text-align:left;">${c.notes}</span></div>` : ''}
  `;
  drawCircuit(val);
  updatePositionInputs();
  updateMeteoLocation(val);
}

function drawCircuit(key) {
  const canvas = document.getElementById('circuit-canvas');
  const wrap = document.getElementById('circuit-wrap');
  const w = wrap.offsetWidth || 600;
  const h = w * 9/16;
  canvas.width = w; canvas.height = h;
  const ctx = canvas.getContext('2d');
  if(!ctx) return;
  ctx.clearRect(0,0,w,h);

  // ─── Check for user-supplied image ───
  const imgKey = _normalizeCircuitKey(key);
  // Try exact key, then fuzzy match
  let imgUrl = CIRCUIT_IMAGES[imgKey];
  if(!imgUrl) {
    // Try to find a fuzzy match (e.g. "monza" matches "Monza")
    const keys = Object.keys(CIRCUIT_IMAGES);
    const match = keys.find(k => k.includes(imgKey) || imgKey.includes(k));
    if(match) imgUrl = CIRCUIT_IMAGES[match];
  }

  if(imgUrl) {
    // Draw the real circuit image as background, then overlay info
    const img = new Image();
    img.onload = function() {
      // Dark overlay background
      ctx.fillStyle = '#05070a';
      ctx.fillRect(0,0,w,h);
      // Draw image centered, fitting the canvas, with slight letterbox
      const scale = Math.min(w/img.width, h/img.height) * 0.96;
      const iw = img.width * scale, ih = img.height * scale;
      const ix = (w-iw)/2, iy = (h-ih)/2;
      // Subtle vignette behind image
      const vig = ctx.createRadialGradient(w/2,h/2,Math.min(iw,ih)*0.3,w/2,h/2,Math.max(w,h)*0.75);
      vig.addColorStop(0,'rgba(0,0,0,0)'); vig.addColorStop(1,'rgba(0,0,0,0.55)');
      ctx.drawImage(img, ix, iy, iw, ih);
      ctx.fillStyle = vig; ctx.fillRect(0,0,w,h);
      // Circuit name watermark
      ctx.fillStyle = 'rgba(255,255,255,0.08)';
      ctx.font = `bold ${Math.floor(w*0.06)}px var(--head,sans-serif)`;
      ctx.textAlign = 'center';
      ctx.fillText((key||'').toUpperCase(), w/2, h*0.92);
      ctx.textAlign = 'start';
    };
    img.src = imgUrl;
    return;
  }

  // ─── Fallback: procedural canvas drawing ───

  // ─── Background with radial gradient (dark green/grey grass effect) ───
  const bgGrad = ctx.createRadialGradient(w/2,h/2,w*0.1,w/2,h/2,w*0.7);
  bgGrad.addColorStop(0,'#0e1118');
  bgGrad.addColorStop(1,'#05070a');
  ctx.fillStyle = bgGrad; ctx.fillRect(0,0,w,h);

  // Subtle grass texture (random speckles)
  ctx.fillStyle = 'rgba(44,188,110,0.04)';
  for(let i=0;i<140;i++){
    const rx = Math.random()*w, ry = Math.random()*h, rs = Math.random()*2+0.5;
    ctx.fillRect(rx,ry,rs,rs);
  }

  // Grid
  ctx.strokeStyle = 'rgba(255,255,255,0.025)'; ctx.lineWidth=1;
  for(let x=0;x<w;x+=40){ ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke(); }
  for(let y=0;y<h;y+=40){ ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke(); }

  const pathStr = CIRCUIT_PATHS[key];
  if(!pathStr) return;

  // Scale path to canvas (coord system 0-630, 0-300)
  const scaleX = w/630, scaleY = h/300;
  ctx.save();
  ctx.scale(scaleX, scaleY);
  const path = new Path2D(pathStr);

  // ─── Layer 1: Runoff (sandy green) ───
  ctx.strokeStyle = 'rgba(180,160,90,0.15)';
  ctx.lineWidth = 26/scaleX;
  ctx.lineCap='round'; ctx.lineJoin='round';
  ctx.stroke(path);

  // ─── Layer 2: Red/white kerbs (outer stripe) ───
  ctx.strokeStyle = '#c01818';
  ctx.lineWidth = 18/scaleX;
  ctx.setLineDash([10/scaleX, 10/scaleX]);
  ctx.stroke(path);
  ctx.strokeStyle = '#ffffff';
  ctx.lineDashOffset = 10/scaleX;
  ctx.stroke(path);
  ctx.setLineDash([]);
  ctx.lineDashOffset = 0;

  // ─── Layer 3: Tarmac with gradient ───
  // Dark outer edge
  ctx.strokeStyle = '#181a22';
  ctx.lineWidth = 14/scaleX;
  ctx.stroke(path);
  // Main asphalt
  ctx.strokeStyle = '#2d3244';
  ctx.lineWidth = 12/scaleX;
  ctx.stroke(path);

  // ─── Layer 4: Asphalt highlight (center) ───
  ctx.strokeStyle = '#3c4358';
  ctx.lineWidth = 6/scaleX;
  ctx.stroke(path);

  // ─── Racing line (accent) ───
  ctx.shadowColor = 'rgba(232,66,26,0.55)';
  ctx.shadowBlur = 12;
  ctx.strokeStyle = 'rgba(232,66,26,0.7)';
  ctx.lineWidth = 1.5/scaleX;
  ctx.setLineDash([12/scaleX, 8/scaleX]);
  ctx.stroke(path);
  ctx.setLineDash([]);
  ctx.shadowBlur = 0;

  ctx.restore();

  // ─── Start/Finish line (checkered pattern) ───
  // Start is approx at the beginning of the path — use first point by sampling
  const sf = _getPathPointAt(key, 0.01) || {x:95, y:260};
  const sfNext = _getPathPointAt(key, 0.03) || {x:100, y:250};
  const dx = sfNext.x - sf.x, dy = sfNext.y - sf.y;
  const len = Math.hypot(dx,dy) || 1;
  const nx = -dy/len, ny = dx/len;
  const lineLen = 16;
  ctx.save();
  ctx.translate(sf.x*scaleX, sf.y*scaleY);
  ctx.rotate(Math.atan2(dy,dx));
  // Checkered
  for(let i=-4;i<4;i++){
    ctx.fillStyle = (i%2===0) ? '#ffffff' : '#1a1d26';
    ctx.fillRect(0, i*2.2*Math.min(scaleX,scaleY), 4.5*Math.min(scaleX,scaleY), 2.2*Math.min(scaleX,scaleY));
  }
  ctx.restore();

  // S/F label with badge
  ctx.fillStyle = 'rgba(26,29,38,0.85)';
  ctx.fillRect((sf.x-22)*scaleX, (sf.y-22)*scaleY, 42*scaleX, 14*scaleY);
  ctx.fillStyle = '#ffa040';
  ctx.font = `bold ${10*Math.min(scaleX,scaleY)}px Rajdhani,sans-serif`;
  ctx.textAlign = 'center';
  ctx.fillText('START/FINISH', sf.x*scaleX-1, (sf.y-12)*scaleY);
  ctx.textAlign = 'start';

  // Direction arrow
  const arrowPt = _getPathPointAt(key, 0.1) || {x:150, y:250};
  const arrowNext = _getPathPointAt(key, 0.12) || {x:160, y:245};
  const adx = arrowNext.x - arrowPt.x, ady = arrowNext.y - arrowPt.y;
  ctx.save();
  ctx.translate(arrowPt.x*scaleX, arrowPt.y*scaleY);
  ctx.rotate(Math.atan2(ady,adx));
  ctx.fillStyle = 'rgba(255,160,64,0.9)';
  ctx.beginPath();
  ctx.moveTo(10, 0);
  ctx.lineTo(-6, -5);
  ctx.lineTo(-3, 0);
  ctx.lineTo(-6, 5);
  ctx.closePath();
  ctx.fill();
  ctx.restore();

  // Circuit name corner label
  const cInfo = CIRCUITS[key];
  if(cInfo){
    ctx.fillStyle = 'rgba(15,17,21,0.85)';
    ctx.fillRect(10,10, 170, 46);
    ctx.strokeStyle = 'rgba(232,66,26,0.6)';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(10,10, 170, 46);
    ctx.fillStyle = '#f0f2f5';
    ctx.font = `bold 12px Rajdhani,sans-serif`;
    ctx.fillText((cInfo.name||key).toUpperCase(), 18, 28);
    ctx.fillStyle = '#a8afc0';
    ctx.font = `9px Share Tech Mono,monospace`;
    ctx.fillText((cInfo.km||0)+' km · '+(cInfo.turns||0)+' curve', 18, 42);
    ctx.fillStyle = '#6b7280';
    ctx.fillText('Record: '+(cInfo.record||'—'), 18, 52);
  }

  // Draw car dots (will be updated)
  drawCarsOnCircuit(ctx, key, w, h, scaleX, scaleY);
}

// Helper: sample a point along an SVG path at t in [0,1]
function _getPathPointAt(key, t){
  try {
    const svg = document.createElementNS('http://www.w3.org/2000/svg','svg');
    const p = document.createElementNS('http://www.w3.org/2000/svg','path');
    p.setAttribute('d', CIRCUIT_PATHS[key]);
    svg.appendChild(p);
    const len = p.getTotalLength();
    if(!len) return null;
    const pt = p.getPointAtLength(t*len);
    return { x: pt.x, y: pt.y };
  } catch(e){ return null; }
}

let carAnimPos = {};
function drawCarsOnCircuit(ctx, key, w, h, sx, sy) {
  const cars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;
  cars.forEach((car,i) => {
    if(car.retired) return;
    const t = (carAnimPos[car.id]||0) % 1;
    // Offset each car slightly to avoid overlap
    const offsetT = (t + i*0.05) % 1;
    const pt = _getPathPointAt(key, offsetT);
    if(!pt) return;
    const cx = pt.x * sx;
    const cy = pt.y * sy;
    const color = car.color || ['#e8421a','#2b7de9','#2cbc6e','#8b5cf6'][i%4];
    // Halo
    ctx.beginPath();
    ctx.arc(cx, cy, 9, 0, Math.PI*2);
    ctx.fillStyle = color+'33';
    ctx.fill();
    // Core dot
    ctx.beginPath();
    ctx.arc(cx, cy, 5, 0, Math.PI*2);
    ctx.fillStyle = color;
    ctx.fill();
    ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.2;
    ctx.stroke();
    // Number
    ctx.fillStyle = '#fff';
    ctx.font = `bold 9px Exo 2,sans-serif`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(i+1, cx, cy);
    ctx.textAlign = 'start';
    ctx.textBaseline = 'alphabetic';
  });
}

// Animate cars based on lap times
let animFrame;
function animateCars() {
  cancelAnimationFrame(animFrame);
  const canvas = document.getElementById('circuit-canvas');
  const wrap = document.getElementById('circuit-wrap');
  if(!STATE.circuit||!canvas) return;
  const w = canvas.width, h = canvas.height;
  const sx = w/630, sy = h/300;
  const ctx = canvas.getContext('2d');
  if(!ctx) return;
  
  const cars = STATE.mode==='track'?STATE.trackCars:STATE.rallyCars;
  // Use best lap time to compute animation speed
  cars.forEach(car=>{
    const laps = STATE.laps[car.id]||[];
    const bestMs = getBestLapMs(car.id) || 90000;
    const speedFactor = 90000/bestMs;
    carAnimPos[car.id] = ((carAnimPos[car.id]||0) + 0.0003 * speedFactor) % 1;
  });
  
  // Redraw background
  ctx.clearRect(0,0,w,h);

  // ─── Use circuit image if available ───
  const imgKey = typeof _normalizeCircuitKey==='function' ? _normalizeCircuitKey(STATE.circuit) : STATE.circuit;
  let bgImg = CIRCUIT_IMAGES[imgKey];
  if(!bgImg) {
    const keys = Object.keys(CIRCUIT_IMAGES||{});
    const match = keys.find(k=>k.includes(imgKey)||imgKey.includes(k));
    if(match) bgImg = CIRCUIT_IMAGES[match];
  }

  if(bgImg) {
    // Draw circuit image as background, then overlay cars on top
    const img = new Image();
    img.onload = function() {
      ctx.fillStyle='#05070a'; ctx.fillRect(0,0,w,h);
      const scale = Math.min(w/img.width, h/img.height)*0.96;
      const iw=img.width*scale, ih=img.height*scale;
      ctx.drawImage(img,(w-iw)/2,(h-ih)/2,iw,ih);
      // Dark vignette
      const vig=ctx.createRadialGradient(w/2,h/2,Math.min(iw,ih)*0.3,w/2,h/2,Math.max(w,h)*0.75);
      vig.addColorStop(0,'rgba(0,0,0,0)'); vig.addColorStop(1,'rgba(0,0,0,0.5)');
      ctx.fillStyle=vig; ctx.fillRect(0,0,w,h);
      // No cars overlay when using circuit image
    };
    // Use cached image object if already loaded
    if(!animateCars._imgCache) animateCars._imgCache = {};
    if(!animateCars._imgCache[imgKey]) {
      animateCars._imgCache[imgKey] = new Image();
      animateCars._imgCache[imgKey].src = bgImg;
    }
    const cachedImg = animateCars._imgCache[imgKey];
    if(cachedImg.complete && cachedImg.naturalWidth) {
      ctx.fillStyle='#05070a'; ctx.fillRect(0,0,w,h);
      const scale=Math.min(w/cachedImg.width,h/cachedImg.height)*0.96;
      const iw=cachedImg.width*scale, ih=cachedImg.height*scale;
      ctx.drawImage(cachedImg,(w-iw)/2,(h-ih)/2,iw,ih);
      const vig=ctx.createRadialGradient(w/2,h/2,Math.min(iw,ih)*0.3,w/2,h/2,Math.max(w,h)*0.75);
      vig.addColorStop(0,'rgba(0,0,0,0)'); vig.addColorStop(1,'rgba(0,0,0,0.5)');
      ctx.fillStyle=vig; ctx.fillRect(0,0,w,h);
      // No cars overlay when using circuit image
    }
    animFrame = requestAnimationFrame(animateCars);
    return;
  }

  // ─── Fallback: original procedural background ───
  ctx.fillStyle='#0a0b0d'; ctx.fillRect(0,0,w,h);
  ctx.strokeStyle='rgba(255,255,255,0.03)';ctx.lineWidth=1;
  for(let x=0;x<w;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}
  for(let y=0;y<h;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
  
  ctx.save(); ctx.scale(sx,sy);
  const path = new Path2D(CIRCUIT_PATHS[STATE.circuit]);
  ctx.shadowColor='rgba(232,66,26,0.4)'; ctx.shadowBlur=20;
  ctx.strokeStyle='#e8421a'; ctx.lineWidth=14/sx; ctx.lineCap='round';
  ctx.stroke(path); ctx.shadowBlur=0;
  ctx.strokeStyle='#2a2f3e'; ctx.lineWidth=12/sx; ctx.stroke(path);
  ctx.strokeStyle='#f0f2f5'; ctx.lineWidth=2/sx; ctx.setLineDash([8/sx,6/sx]);
  ctx.stroke(path); ctx.setLineDash([]);
  ctx.restore();
  
  ctx.fillStyle='#ffa040'; ctx.font=`${10*sx}px Rajdhani`; ctx.fillText('S/F',78*sx,168*sy);
  drawCarsOnCircuit(ctx, STATE.circuit, w, h, sx, sy);
  
  animFrame = requestAnimationFrame(animateCars);
}

