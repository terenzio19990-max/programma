  if(typeof coopBroadcastPatch==='function' && typeof COOP!=='undefined' && COOP.status!=='disconnected' && !COOP.applyingRemote){
    coopBroadcastPatch('STATE.stages', 'set', STATE.stages, 'ha eliminato PS'+s.num+' su '+s.car);
  }
  showToast('🗑 PS'+s.num+' eliminata');
}
window.deleteStageAt = deleteStageAt;

// ═══════════════════════════════════════════════════════════════════════════
// FUEL PLAN — Pianificazione carburante rally
// Storage: REP_fuel_plans_v1 = { plans: [{id, name, capacity, startFuel,
//   consSS, consTF, safety, stages: [{n, name, km, kmTF, refuelAfter,
//   refuelMax}], updatedAt}] }
// ═══════════════════════════════════════════════════════════════════════════
var FP_KEY = 'REP_fuel_plans_v1';
var _fp = null;            // entire storage object
var _fpCurrentId = null;   // id of currently-loaded plan

function _fpLoad(){
  if(_fp) return _fp;
  try { _fp = JSON.parse(localStorage.getItem(FP_KEY)||'null'); } catch(_){ _fp = null; }
  if(!_fp || !Array.isArray(_fp.plans)) _fp = { plans: [] };
  return _fp;
}
function _fpSave(){
  try { localStorage.setItem(FP_KEY, JSON.stringify(_fp||{plans:[]})); } catch(_){}
}
function _fpUid(){ return 'fp_'+Date.now()+'_'+Math.random().toString(36).slice(2,7); }

function _fpCurrent(){
  _fpLoad();
  if(!_fpCurrentId) return null;
  return _fp.plans.find(function(p){return p.id===_fpCurrentId;}) || null;
}

// Populate the rally event selector with all saved plans
function _fpPopulateSelector(){
  _fpLoad();
  var sel = document.getElementById('fp-rally-event');
  if(!sel) return;
  var prev = _fpCurrentId;
  sel.innerHTML = '<option value="">— Scegli piano —</option>' +
    _fp.plans.map(function(p){
      return '<option value="'+p.id+'">'+ (p.name||'(senza nome)') +'</option>';
    }).join('');
  if(prev && _fp.plans.some(function(p){return p.id===prev;})) sel.value = prev;
  else if(_fp.plans.length === 1) { sel.value = _fp.plans[0].id; _fpCurrentId = _fp.plans[0].id; }
}
window._fpPopulateSelector = _fpPopulateSelector;

// Render the page from the current plan (or empty state)
function fpRender(){
  _fpLoad();
  _fpPopulateSelector();
  var plan = _fpCurrent();
  if(!plan){
    // Empty state
    document.getElementById('fp-name').value = '';
    document.getElementById('fp-stages-tbody').innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--text3);padding:14px;">Nessun piano selezionato. Premi <b>➕ NUOVO PIANO</b> per crearne uno.</td></tr>';
    document.getElementById('fp-segments-list').innerHTML = '<div style="text-align:center;padding:20px;color:var(--text3);font-size:11px;">Nessun piano da calcolare.</div>';
    document.getElementById('fp-tot-stages').textContent = '0';
    document.getElementById('fp-tot-km').textContent = '0 km';
    document.getElementById('fp-tot-fuel').textContent = '0 L';
    document.getElementById('fp-tot-refuel').textContent = '0 L';
    return;
  }
  // Fill base parameters
  document.getElementById('fp-name').value = plan.name || '';
  document.getElementById('fp-capacity').value = plan.capacity || 60;
  document.getElementById('fp-start-fuel').value = plan.startFuel != null ? plan.startFuel : (plan.capacity||60);
  document.getElementById('fp-cons-ss').value = plan.consSS || 0.18;
  document.getElementById('fp-cons-tf').value = plan.consTF || 0.08;
  document.getElementById('fp-safety').value = plan.safety != null ? plan.safety : 15;
  document.getElementById('fp-min-reserve').value = plan.minReserve != null ? plan.minReserve : 5;
  // Render stages table
  fpRenderStagesTable(plan);
  // Recalc segments
  fpRecalc();
}
window.fpRender = fpRender;

function fpRenderStagesTable(plan){
  var tbody = document.getElementById('fp-stages-tbody');
  if(!tbody) return;
  if(!plan.stages || !plan.stages.length){
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:var(--text3);padding:12px;">Nessuna PS. Premi <b>➕ AGGIUNGI PS</b> per cominciare.</td></tr>';
    return;
  }
  var consSS = +document.getElementById('fp-cons-ss').value || 0.18;
  var consTF = +document.getElementById('fp-cons-tf').value || 0.08;
  tbody.innerHTML = plan.stages.map(function(s, i){
    var litSS = (+s.km || 0) * consSS;
    var litTF = (+s.kmTF || 0) * consTF;
    var litTot = litSS + litTF;
    return '<tr>'+
      '<td><input type="number" value="'+(s.n||(i+1))+'" style="width:50px;" oninput="fpUpdateStageField('+i+',\'n\',this.value)"></td>'+
      '<td><input type="text" value="'+(s.name||'').replace(/"/g,'&quot;')+'" style="width:160px;" placeholder="nome PS" oninput="fpUpdateStageField('+i+',\'name\',this.value)"></td>'+
      '<td><input type="number" step="0.1" value="'+(s.km||0)+'" style="width:70px;" oninput="fpUpdateStageField('+i+',\'km\',this.value)"></td>'+
      '<td><input type="number" step="0.1" value="'+(s.kmTF||0)+'" style="width:70px;" oninput="fpUpdateStageField('+i+',\'kmTF\',this.value)"></td>'+
      '<td class="mono" style="color:var(--text3);">'+litSS.toFixed(2)+'</td>'+
      '<td class="mono" style="color:var(--text3);">'+litTF.toFixed(2)+'</td>'+
      '<td class="mono" style="color:var(--accent3);font-weight:700;">'+litTot.toFixed(2)+'</td>'+
      '<td style="text-align:center;"><input type="checkbox" '+(s.refuelAfter?'checked':'')+' onchange="fpUpdateStageField('+i+',\'refuelAfter\',this.checked)" style="transform:scale(1.3);"></td>'+
      '<td><input type="number" step="0.5" value="'+(s.refuelMax||0)+'" style="width:70px;" '+(s.refuelAfter?'':'disabled')+' oninput="fpUpdateStageField('+i+',\'refuelMax\',this.value)" placeholder="max L" title="Massimo litri rifornibili a questo punto. 0 = illimitato (parco assistenza)"></td>'+
      '<td><button onclick="fpDeleteStage('+i+')" style="background:none;border:none;color:var(--red);cursor:pointer;font-size:14px;">🗑</button></td>'+
    '</tr>';
  }).join('');
}

function fpUpdateStageField(idx, field, val){
  var plan = _fpCurrent(); if(!plan) return;
  if(!plan.stages[idx]) return;
  if(field === 'n' || field === 'km' || field === 'kmTF' || field === 'refuelMax'){
    plan.stages[idx][field] = +val || 0;
  } else if(field === 'refuelAfter'){
    plan.stages[idx][field] = !!val;
  } else {
    plan.stages[idx][field] = val;
  }
  fpAutoSave();
  fpRecalc();
  // If we toggled refuelAfter, re-render to enable/disable the max field
  if(field === 'refuelAfter'){
    fpRenderStagesTable(plan);
  }
}
window.fpUpdateStageField = fpUpdateStageField;

function fpAddStage(){
  var plan = _fpCurrent();
  if(!plan){ showToast('⚠️ Crea prima un piano'); return; }
  if(!plan.stages) plan.stages = [];
  var nextN = plan.stages.length ? Math.max.apply(null, plan.stages.map(function(s){return +s.n||0;}))+1 : 1;
  plan.stages.push({ n: nextN, name: '', km: 0, kmTF: 0, refuelAfter: false, refuelMax: 0 });
  fpAutoSave();
  fpRender();
}
window.fpAddStage = fpAddStage;

function fpDeleteStage(idx){
  var plan = _fpCurrent();
  if(!plan || !plan.stages[idx]) return;
  if(!confirm('Eliminare PS'+(plan.stages[idx].n||idx+1)+(plan.stages[idx].name?' "'+plan.stages[idx].name+'"':'')+'?')) return;
  plan.stages.splice(idx, 1);
  fpAutoSave();
  fpRender();
}
window.fpDeleteStage = fpDeleteStage;

function fpNewPlan(){
  _fpLoad();
  var name = prompt('Nome del piano (es. "Rally San Marino 2026"):');
  if(!name) return;
  var plan = {
    id: _fpUid(),
