/* ═══ B: pannelli riepilogo Overview rally / Assistenza / Overview pista ═══ */
function esc2(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
function bestOf(times){
  var best=null;
  times.forEach(function(t){ var ms=(typeof parseTime==='function')? parseTime(t):null; if(ms&&(best===null||ms<best)) best=ms; });
  return best;
}
function msStr(ms){
  if(!ms) return '—';
  var m=Math.floor(ms/60000), s=(ms%60000)/1000;
  return m+':'+(s<10?'0':'')+s.toFixed(3);
}
function panelBox(id, page, title){
  var pg=document.getElementById('page-'+page);
  if(!pg) return null;
  var el=document.getElementById(id);
  if(!el){
    pg.insertAdjacentHTML('afterbegin','<div class="panel mb12" id="'+id+'"><div class="panel-head">'+title+'</div><div class="panel-body" id="'+id+'-body"></div></div>');
    el=document.getElementById(id);
  }
  return document.getElementById(id+'-body');
}

window.repBuildRallyOverview = function(){
  try {
    var body=panelBox('rep-ov-rally','rally-overview','🌿 RIEPILOGO RALLY — LIVE');
    if(!body) return;
    var totPS=+((STATE&&STATE.rallyNumStages)||0);
    var html='<div style="overflow-x:auto"><table class="data-table" style="font-size:11px"><thead><tr><th>VETTURA</th><th>PS FATTE</th><th>MIGLIOR PS</th><th>BENZINA</th><th>GOMME</th><th>DANNI APERTI</th></tr></thead><tbody>';
    (STATE.rallyCars||[]).forEach(function(c){
      var st=(STATE.stages||[]).filter(function(s){return s.car===c.name&&!s.cancelled;});
      var best=bestOf(st.map(function(s){return s.time;}));
      var fu=(STATE.rallyFuel||{})[c.id];
      var ty=(STATE.rallyTyres||{})[c.id];
      var comp=ty&&ty.current&&ty.current.wheels&&ty.current.wheels.fl? (ty.current.wheels.fl.compound||'—') : '—';
      var dmg=((STATE.rallyDamage||[]).filter? (STATE.rallyDamage||[]).filter(function(d){return d.car===c.name&&!d.fixed;}).length : 0);
      html+='<tr><td><b>'+esc2(c.name)+'</b></td><td>'+st.length+(totPS?'/'+totPS:'')+'</td><td class="mono">'+msStr(best)+'</td>'+
        '<td>'+(fu&&isFinite(+fu.current)? (+fu.current).toFixed(1)+' L':'—')+'</td>'+
        '<td>'+esc2(comp)+'</td><td'+(dmg?' style="color:var(--red);font-weight:700"':'')+'>'+dmg+'</td></tr>';
    });
    html+='</tbody></table></div>';
    // prossimo impegno dal programma weekend
    try {
      var sched=JSON.parse(localStorage.getItem('rep_weekend_schedule_v1')||'[]');
      var now=new Date(); var next=null;
      sched.forEach(function(it){
        var t=it.time||it.ora||''; var lbl=it.label||it.nome||it.desc||'';
        if(!t) return;
        var hm=String(t).match(/(\d{1,2})[:.](\d{2})/);
        if(!hm) return;
        var dt=new Date(); dt.setHours(+hm[1],+hm[2],0,0);
        if(dt>now && (!next||dt<next.dt)) next={dt:dt,t:t,lbl:lbl};
      });
      if(next) html+='<div class="small" style="margin-top:8px">⏱ Prossimo impegno: <b>'+esc2(next.t)+'</b> '+esc2(next.lbl)+'</div>';
    } catch(e){}
    body.innerHTML=html;
  } catch(e){}
};
window.repBuildRallyService = function(){
  try {
    var body=panelBox('rep-sv-rally','rally-service','🔩 RIEPILOGO ASSISTENZA');
    if(!body) return;
    var svc=(STATE.services||[]);
    var html='<div class="small">Interventi registrati: <b>'+svc.length+'</b></div>';
    if(svc.length){
      html+='<div style="overflow-x:auto;margin-top:6px"><table class="data-table" style="font-size:11px"><thead><tr><th>#</th><th>DETTAGLIO</th></tr></thead><tbody>';
      svc.slice(-5).reverse().forEach(function(s,i){
        var txt = typeof s==='string'? s : (s.note||s.desc||s.label||[s.car,s.time,s.type].filter(Boolean).join(' · ')||JSON.stringify(s).slice(0,80));
        html+='<tr><td>'+(svc.length-i)+'</td><td>'+esc2(txt)+'</td></tr>';
