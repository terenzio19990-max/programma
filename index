<script>
/* REP-ANLZ-BEGIN ======================================================
   ANALISI GIRO/PS: legge le registrazioni salvate (percorsi 3D con
   ts/spd/gs) e produce:
   - velocità vs distanza (A e, in confronto, B)
   - delta tempo progressivo A→B lungo la distanza
   - g laterale vs distanza + frenate individuate dalla g longitudinale
   - verdetto: dove si perde, con posizione km e tipo di curva
====================================================================== */
(function(){
'use strict';
if(window._repAnlz1) return;
window._repAnlz1 = true;

function el(id){ return document.getElementById(id); }
function esc(x){ return String(x==null?'':x).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
function hav(a1,o1,a2,o2){ var R=6371e3,p1=a1*Math.PI/180,p2=a2*Math.PI/180,dp=(a2-a1)*Math.PI/180,dl=(o2-o1)*Math.PI/180;
  var x=Math.sin(dp/2)*Math.sin(dp/2)+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)*Math.sin(dl/2); return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x)); }

function routes(){ try { return JSON.parse(localStorage.getItem('REP_routes_v1')||'{}'); } catch(e){ return {}; } }

/* prepara una registrazione: distanza cumulata, velocità, tempo, g per distanza */
function anlzPrep(r){
  if(!r || !r.lats || r.lats.length<10) return null;
  var n=r.lats.length, dist=[0];
  for(var i=1;i<n;i++) dist.push(dist[i-1]+hav(r.lats[i-1],r.lons[i-1],r.lats[i],r.lons[i]));
  var ts=(r.ts&&r.ts.length===n)? r.ts : null;
  var spd=(r.spd&&r.spd.length===n)? r.spd.slice() : null;
  // velocità mancante ma tempi presenti → derivala
  if(!spd && ts){
    spd=[null];
    for(var j=1;j<n;j++){
      var dt=(ts[j]-ts[j-1])/1000;
      spd.push(dt>0.2? +( (dist[j]-dist[j-1])/dt*3.6 ).toFixed(1) : (spd[j-1]||null));
    }
  }
  // g mappate sulla distanza (interpolando il tempo)
  var gd=null;
  if(r.gs && r.gs.length>5 && ts){
    gd=[];
    var k=0;
    r.gs.forEach(function(g){
      var t=g[0];
      while(k<n-2 && ts[k+1]<t) k++;
      var f=(ts[k+1]>ts[k])? (t-ts[k])/(ts[k+1]-ts[k]) : 0;
      f=Math.max(0,Math.min(1,f));
      gd.push({ d:dist[k]+f*(dist[k+1]-dist[k]), lat:g[1], lon:g[2] });
    });
  }
  // frenate: g long < -0.25 g per almeno 3 campioni consecutivi
  var brakes=[];
  if(gd){
    var run=null;
    gd.forEach(function(p){
      if(p.lon<-0.25){
        if(!run) run={d0:p.d,gmax:p.lon,cnt:0};
        run.cnt++; run.d1=p.d; if(p.lon<run.gmax) run.gmax=p.lon;
      } else if(run){ if(run.cnt>=3) brakes.push(run); run=null; }
    });
    if(run && run.cnt>=3) brakes.push(run);
  }
  return { n:n, dist:dist, ts:ts, spd:spd, gd:gd, brakes:brakes,
           len:dist[n-1], time:ts? (ts[n-1]-ts[0])/1000 : null,
           vmax: spd? Math.max.apply(null, spd.filter(function(v){return v!=null;})) : null };
}

/* tempo per raggiungere la distanza d (interpolato) */
function timeAt(P,d){
  var lo=0, hi=P.n-1;
  if(d<=0) return 0;
  if(d>=P.len) return (P.ts[P.n-1]-P.ts[0])/1000;
  while(hi-lo>1){ var m=(lo+hi)>>1; if(P.dist[m]<d) lo=m; else hi=m; }
  var f=(P.dist[hi]>P.dist[lo])? (d-P.dist[lo])/(P.dist[hi]-P.dist[lo]) : 0;
  return ((P.ts[lo]-P.ts[0]) + f*(P.ts[hi]-P.ts[lo]))/1000;
}
function spdAt(P,d){
  var lo=0, hi=P.n-1;
  if(d<=0||!P.spd) return P.spd? P.spd[0]:null;
  if(d>=P.len) return P.spd[P.n-1];
  while(hi-lo>1){ var m=(lo+hi)>>1; if(P.dist[m]<d) lo=m; else hi=m; }
  return P.spd[lo];
}
/* raggio locale di curva ~ v²/(g_lat·9.81) se g disponibile */
function radiusNear(P,d){
  if(!P.gd) return null;
  var best=null, bd=1e9;
  P.gd.forEach(function(p){ var dd=Math.abs(p.d-d); if(dd<bd){ bd=dd; best=p; } });
  if(!best || Math.abs(best.lat)<0.15) return null;
  var v=spdAt(P,d); if(v==null) return null;
  return Math.round(Math.pow(v/3.6,2)/(Math.abs(best.lat)*9.81));
}

window.anlzRun = function(){
  var all=routes();
  var ka=(el('anlz-a')||{}).value, kb=(el('anlz-b')||{}).value;
  var out=el('anlz-verdict'); if(!out) return;
  var A=anlzPrep(all[ka]);
  if(!A){ out.innerHTML='<div class="small" style="color:var(--yellow)">Scegli una registrazione valida (min 10 punti).</div>'; return; }
  var B=(kb && kb!=='-')? anlzPrep(all[kb]) : null;
  var h='';

  // ── verdetto ──
  function fmtT(s){ if(s==null) return '—'; var m=Math.floor(s/60); return m+':'+String((s%60).toFixed(1)).padStart(4,'0'); }
  h+='<div class="sa-metrics" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-bottom:10px">'+
     '<div class="sa-met"><div class="sa-mlab">A · TEMPO</div><div class="sa-mval">'+fmtT(A.time)+'</div></div>'+
     '<div class="sa-met"><div class="sa-mlab">A · KM</div><div class="sa-mval">'+(A.len/1000).toFixed(2)+'</div></div>'+
     '<div class="sa-met"><div class="sa-mlab">A · VMAX</div><div class="sa-mval">'+(A.vmax!=null?Math.round(A.vmax)+' km/h':'—')+'</div></div>'+
     '<div class="sa-met"><div class="sa-mlab">A · FRENATE</div><div class="sa-mval">'+(A.gd? A.brakes.length:'—')+'</div></div>';
  if(B) h+='<div class="sa-met"><div class="sa-mlab">B · TEMPO</div><div class="sa-mval">'+fmtT(B.time)+'</div></div>'+
           '<div class="sa-met"><div class="sa-mlab">B · VMAX</div><div class="sa-mval">'+(B.vmax!=null?Math.round(B.vmax)+' km/h':'—')+'</div></div>';
  h+='</div>';

  var deltaInfo='';
  if(B && A.ts && B.ts){
    var L=Math.min(A.len,B.len), N=200, dd=[], dl=[];
    for(var i=0;i<=N;i++){
      var d=L*i/N;
      dd.push(d/1000);
      dl.push(+(timeAt(B,d)-timeAt(A,d)).toFixed(2));
    }
    var tot=dl[dl.length-1];
    // i 3 tratti dove B perde di più (pendenza del delta su finestre da L/20)
    var W=Math.max(2,Math.round(N/20)), worst=[];
    for(var w=0;w+W<=N;w+=W){
      worst.push({ d0:dd[w], d1:dd[w+W], gain:+(dl[w+W]-dl[w]).toFixed(2) });
    }
    worst.sort(function(a,b){ return b.gain-a.gain; });
    var top=worst.slice(0,3).filter(function(x){ return x.gain>0.05; });
    deltaInfo='<div class="panel-body" style="border:1px solid var(--border);border-radius:10px;margin-bottom:10px">'+
      '<b>Δ totale (B−A): '+(tot>0?'+':'')+tot.toFixed(2)+' s</b> su '+(L/1000).toFixed(2)+' km'+
      (top.length? '<br>B perde soprattutto:':'')+
      top.map(function(x){
        var mid=(x.d0+x.d1)/2*1000;
        var R=radiusNear(A,mid);
        var vA=spdAt(A,mid), vB=spdAt(B,mid);
        return '<br>· <b>+'+x.gain.toFixed(2)+' s</b> tra km '+x.d0.toFixed(2)+' e '+x.d1.toFixed(2)+
          (R? ' (curva ~R'+R+' m)':'')+
          (vA!=null&&vB!=null? ' — v: '+Math.round(vB)+' vs '+Math.round(vA)+' km/h':'');
      }).join('')+
      '</div>';
    // grafico delta
    if(typeof Plotly!=='undefined' && el('anlz-delta')){
      try { Plotly.react(el('anlz-delta'),[
        { x:dd, y:dl, mode:'lines', line:{width:3,color:'#ffd60a'}, fill:'tozeroy', fillcolor:'rgba(255,214,10,.12)', hoverinfo:'x+y' }
      ],{ title:{text:'Δ tempo B−A (s)',font:{size:12,color:'#8a90a0'}}, margin:{l:44,r:10,t:30,b:34},
          xaxis:{title:'km',gridcolor:'rgba(128,140,160,.12)',color:'#8a90a0'},
          yaxis:{gridcolor:'rgba(128,140,160,.12)',color:'#8a90a0',zeroline:true},
          paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)', showlegend:false, height:220 },
        { displayModeBar:false }); } catch(e){}
    }
  } else if(B){
    deltaInfo='<div class="small" style="color:var(--yellow);margin-bottom:8px">Una delle due registrazioni è senza tempi (formato vecchio): niente delta, solo sovrapposizione velocità.</div>';
  }
  h+=deltaInfo;

  // ── velocità vs distanza ──
  if(typeof Plotly!=='undefined' && el('anlz-speed')){
    var tr=[];
    if(A.spd) tr.push({ x:A.dist.map(function(d){return d/1000;}), y:A.spd, mode:'lines', name:'A', line:{width:3,color:'#00e5ff'} });
    if(B && B.spd) tr.push({ x:B.dist.map(function(d){return d/1000;}), y:B.spd, mode:'lines', name:'B', line:{width:2,color:'#ff9f0a'} });
    // frenate di A come marker
    if(A.gd && A.brakes.length && A.spd){
      tr.push({ x:A.brakes.map(function(b){return b.d0/1000;}), y:A.brakes.map(function(b){ return spdAt(A,b.d0)||0; }),
        mode:'markers', name:'frenata', marker:{size:9,color:'#ff453a',symbol:'triangle-down'} });
    }
    if(tr.length){
      try { Plotly.react(el('anlz-speed'),tr,
        { title:{text:'Velocità (km/h) vs distanza',font:{size:12,color:'#8a90a0'}}, margin:{l:44,r:10,t:30,b:34},
          xaxis:{title:'km',gridcolor:'rgba(128,140,160,.12)',color:'#8a90a0'},
          yaxis:{gridcolor:'rgba(128,140,160,.12)',color:'#8a90a0'},
          paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)',
          legend:{font:{color:'#8a90a0'},orientation:'h'}, height:260 },
        { displayModeBar:false }); } catch(e){}
    } else h+='<div class="small" style="color:var(--yellow)">Registrazione senza velocità (formato vecchio): registra di nuovo con la versione attuale per l\'analisi completa.</div>';
  }

  // ── g laterale vs distanza ──
  if(typeof Plotly!=='undefined' && el('anlz-g') && A.gd && A.gd.length){
    try { Plotly.react(el('anlz-g'),[
      { x:A.gd.map(function(p){return p.d/1000;}), y:A.gd.map(function(p){return p.lat;}), mode:'lines', name:'g lat', line:{width:2,color:'#30d158'} },
      { x:A.gd.map(function(p){return p.d/1000;}), y:A.gd.map(function(p){return p.lon;}), mode:'lines', name:'g long', line:{width:1.5,color:'#ff453a'} }
    ],{ title:{text:'g laterale / longitudinale (A)',font:{size:12,color:'#8a90a0'}}, margin:{l:44,r:10,t:30,b:34},
        xaxis:{title:'km',gridcolor:'rgba(128,140,160,.12)',color:'#8a90a0'},
        yaxis:{gridcolor:'rgba(128,140,160,.12)',color:'#8a90a0',zeroline:true},
        paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)',
        legend:{font:{color:'#8a90a0'},orientation:'h'}, height:200 },
      { displayModeBar:false }); } catch(e){}
  }

  el('anlz-verdict').innerHTML=h;
};

function fillSelects(){
  var all=routes(), keys=Object.keys(all).filter(function(k){ return all[k]&&all[k].lats&&all[k].lats.length>=10; });
  keys.sort(function(a,b){ return (all[b].savedAt||'').localeCompare(all[a].savedAt||''); });
  var opts=keys.map(function(k){
    var tag=(all[k].ts&&all[k].spd)? '':' (senza tempi)';
    return '<option value="'+esc(k)+'">'+esc(k)+tag+'</option>';
  }).join('');
  var a=el('anlz-a'), b=el('anlz-b');
  if(a) a.innerHTML=opts||'<option value="-">nessuna registrazione</option>';
  if(b) b.innerHTML='<option value="-">— nessun confronto —</option>'+opts;
}

function pageHTML(){
  return '<div class="panel"><div class="panel-head">📉 ANALISI GIRO / PS — dalle registrazioni GPS</div><div class="panel-body">'+
  '<div class="form-row mb8" style="display:flex;gap:10px;flex-wrap:wrap">'+
  '<div class="field" style="min-width:220px;flex:1"><label>Registrazione A (riferimento)</label><select id="anlz-a"></select></div>'+
  '<div class="field" style="min-width:220px;flex:1"><label>Confronto B (opzionale)</label><select id="anlz-b"></select></div>'+
  '<div style="align-self:flex-end"><button class="btn btn-green" onclick="anlzRun()">📉 ANALIZZA</button></div></div>'+
  '<div id="anlz-verdict"></div>'+
  '<div id="anlz-speed"></div><div id="anlz-delta"></div><div id="anlz-g"></div>'+
  '<div class="small" style="opacity:.65;margin-top:8px">Le frenate (▼) vengono dalle g del telefono; il raggio curva stimato da v²/(g·9.81). '+
  'Registrazioni fatte prima di oggi non hanno tempi/velocità: rifalle con trasmettitore v1.5 e software attuale.</div>'+
  '</div></div>';
}
function injectPage(){
  var anyPage=document.querySelector('.page');
  if(!anyPage||!anyPage.parentElement||document.getElementById('page-rep-anlz')) return;
