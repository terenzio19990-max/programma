// Link one of the tyres being mounted to a stock entry (by code or manually)
function _tsTryLinkMount(stockCode, carId, position){
  if(!stockCode) return null;
  tsLoad();
  var t = TYRE_STOCK.find(function(x){return x.code && x.code === stockCode && x.status !== 'dismissed';});
  if(!t) return null;
  t.status = 'mounted';
  t.car = carId;
  t.position = position || t.position;
  t.lastMountedAt = Date.now();
  if(!t.history) t.history = [];
  var carName = '';
  var c = [].concat(STATE.trackCars||[], STATE.rallyCars||[]).find(function(c){return c.id===carId;});
  if(c) carName = c.name;
  t.history.push({ date: Date.now(), action: 'montata', car: carName, km: t.km, wear: t.wear });
  tsSave();
  return t;
}

// Called when a set is dismounted (track mount replaces old set, rally mount idem)
function _tsReturnMountedToStock(oldWheels, carId, usedKm, lapsUsed){
  if(!oldWheels) return;
  tsLoad();
  var carName = '';
  var c = [].concat(STATE.trackCars||[], STATE.rallyCars||[]).find(function(c){return c.id===carId;});
  if(c) carName = c.name;
  WHEELS.forEach(function(w){
    var wd = oldWheels[w]; if(!wd || !wd.code) return;
    var t = TYRE_STOCK.find(function(x){return x.code === wd.code;});
    if(!t) return;
    t.status = 'used';
    t.km = (t.km||0) + (usedKm||0);
    t.laps = (t.laps||0) + (lapsUsed||0);
    if(+wd.wear > (t.wear||0)) t.wear = +wd.wear;
    if(wd.damage && wd.damage !== 'none') t.damage = wd.damage;
    if(!t.history) t.history = [];
    t.history.push({ date: Date.now(), action: 'rimossa', car: carName, km: usedKm||0, wear: t.wear });
  });
  tsSave();
}

function tsExport(){
  tsLoad();
  if(!TYRE_STOCK.length){ showToast('Magazzino vuoto'); return; }
  var headers = ['id','code','brand','compound','set','position','status','car','km','laps','wear','damage','notes','addedAt'];
  var rows = [headers.join(';')];
  TYRE_STOCK.forEach(function(t){
    var row = headers.map(function(h){
      var v = t[h]; if(v==null) v='';
      if(h==='addedAt' && v) v = new Date(v).toISOString();
      return ('"' + String(v).replace(/"/g,'""') + '"');
    });
    rows.push(row.join(';'));
  });
  var csv = '\ufeff' + rows.join('\n');
  var blob = new Blob([csv], {type:'text/csv'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'REP-magazzino-gomme-'+new Date().toISOString().slice(0,10)+'.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  showToast('⬇ Magazzino esportato ('+TYRE_STOCK.length+' gomme)');
}

function tsImportCsv(){
  var inp = document.createElement('input');
  inp.type = 'file'; inp.accept = '.csv,text/csv';
  inp.onchange = function(e){
    var f = e.target.files[0]; if(!f) return;
    var r = new FileReader();
    r.onload = function(ev){
      var text = ev.target.result.replace(/^\ufeff/,'');
      var lines = text.split(/\r?\n/).filter(function(l){return l.trim();});
      if(lines.length < 2){ showToast('CSV vuoto'); return; }
      // Detect separator
      var sep = lines[0].indexOf(';')>=0 ? ';' : ',';
      var headers = lines[0].split(sep).map(function(h){return h.replace(/^"|"$/g,'').trim();});
      var count = 0;
      for(var i=1;i<lines.length;i++){
        var parts = lines[i].split(sep).map(function(p){return p.replace(/^"|"$/g,'').replace(/""/g,'"');});
        var obj = { id: _tsNewId(), status:'new', car:'', history:[], addedAt:Date.now() };
        headers.forEach(function(h,idx){
          var v = parts[idx] || '';
          if(['km','laps','wear'].indexOf(h)>=0) v = +v || 0;
          if(h==='addedAt' && v){ var d=new Date(v); v=isNaN(d.getTime())?Date.now():d.getTime(); }
          if(h!=='id') obj[h] = v;
        });
        TYRE_STOCK.push(obj);
        count++;
      }
      tsSave();
      buildTyreStockPage();
      showToast('✓ Importate '+count+' gomme');
    };
    r.readAsText(f);
  };
  inp.click();
}

