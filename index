    html += '<div class="sa-zrow" title="'+esc(z.note)+'">' +
      '<div class="sa-zlabel">'+z.label+' <span class="small" title="confidenza '+z.conf+'">'+confIcon+'</span></div>' +
      '<div class="sa-zbarwrap">' +
        '<div class="sa-zbar" style="transform:scaleX('+(w/100).toFixed(3)+');background:'+col+'"></div>' +
