function stpSaveNew(mode){
  var name = document.getElementById('stp-new-name')?.value?.trim();
  var note = document.getElementById('stp-new-note')?.value?.trim() || '';
  if(!name){ showToast('⚠️ Inserisci un nome per il template'); return; }
  var db = stpLoad();
  if(!db[mode]) db[mode] = [];
  var tpl = {
    id: Date.now(),
    name: name,
    note: note,
    values: stpCapture(mode),
    savedAt: new Date().toLocaleString('it-IT',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})
  };
  db[mode].push(tpl);
  stpSave(db);
  showToast('✅ Template "'+name+'" salvato');
  openSetupTemplates(mode); // Refresh modal
}
window.stpSaveNew = stpSaveNew;

function stpApplyFromModal(mode, idx){
  var db = stpLoad();
  var tpl = (db[mode]||[])[idx];
  if(!tpl){ showToast('Template non trovato'); return; }
  var count = stpApply(mode, tpl.values || {});
  document.getElementById('setup-tpl-modal').style.display='none';
  showToast('📋 Template "'+tpl.name+'" caricato ('+count+' campi)');
}
window.stpApplyFromModal = stpApplyFromModal;

function stpDeleteFromModal(mode, idx){
  var db = stpLoad();
  var tpl = (db[mode]||[])[idx];
  if(!tpl) return;
  if(!confirm('Eliminare il template "'+tpl.name+'"?')) return;
  db[mode].splice(idx, 1);
  stpSave(db);
  showToast('🗑 Template eliminato');
  openSetupTemplates(mode);
}
window.stpDeleteFromModal = stpDeleteFromModal;

function stpExport(){
  var db = stpLoad();
  var data = JSON.stringify(db, null, 2);
  var blob = new Blob([data], { type:'application/json' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = 'race-eng-pro-setup-templates-'+new Date().toISOString().slice(0,10)+'.json';
  a.click();
  setTimeout(function(){ URL.revokeObjectURL(url); }, 1000);
  showToast('📤 Templates esportati');
}
window.stpExport = stpExport;

function stpImport(ev){
  var file = ev.target.files[0];
  if(!file) return;
  var reader = new FileReader();
  reader.onload = function(e){
    try {
      var imported = JSON.parse(e.target.result);
      if(!imported.track && !imported.rally){ showToast('❌ File non valido'); return; }
      var db = stpLoad();
      var beforeCount = (db.track||[]).length + (db.rally||[]).length;
      (imported.track||[]).forEach(function(t){ db.track.push(t); });
      (imported.rally||[]).forEach(function(t){ db.rally.push(t); });
      stpSave(db);
      var after = (db.track||[]).length + (db.rally||[]).length;
      showToast('✅ Importati '+(after-beforeCount)+' templates');
      // Reopen to show merged list (best effort: detect by last visible mode in URL)
      var modal = document.getElementById('setup-tpl-modal');
      if(modal && modal.style.display === 'flex'){
        var title = modal.querySelector('[style*="letter-spacing:2px"]');
        var mode = title && title.textContent.indexOf('RALLY') >= 0 ? 'rally' : 'track';
        openSetupTemplates(mode);
      }
    } catch(err){ showToast('❌ Errore import: '+err.message); }
  };
  reader.readAsText(file);
}
window.stpImport = stpImport;

