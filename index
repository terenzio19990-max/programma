window.repAdviseSetup = function(){
  var out=document.getElementById('rep-advise-out');
  if(!out) return;
  try {
    var g=null;
    try { if(typeof _gpsData!=='undefined' && _gpsData) g=_gpsData; } catch(e){}
    if(!g) g=window._gpsData;
    if(!g||!g.lats||g.lats.length<10){ out.innerHTML='<span class="small" style="color:var(--yellow)">Carica prima un percorso (importa o CARICA un salvato).</span>'; return; }
    // 1) profilo dal tracciato (salva e aggiorna l'analizzatore)
    repRouteToProfile();
    // 2) ottimizzatore fisico sul profilo appena creato
    var mode = (STATE.mode==='track')? 'track':'rally';
    if(typeof saSuggestForTrack!=='function'){ out.innerHTML='<span class="small">Analizzatore non disponibile.</span>'; return; }
    var r = saSuggestForTrack(mode);
    if(!r.ok){ out.innerHTML='<span class="small" style="color:var(--yellow)">Errore analisi: '+esc2(r.err)+'</span>'; return; }
    var car=r.ctx.car;
    var html='<div class="sa-sec" style="font-size:10px;color:var(--text3);letter-spacing:1px;margin:4px 0 6px;font-weight:600">🔧 SETUP CONSIGLIATO PER QUESTO TRACCIATO — '+esc2(car.name)+' ('+esc2(r.ctx.p.drive||'')+')</div>';
    if(!r.res.steps.length){
      html+='<div class="small">Partendo dai valori attuali del form Setup, il modello non trova modifiche con guadagno affidabile per questo profilo: il setup è già coerente col tracciato. Prova a compilare più campi (ali, molle, barre, bias) per un’analisi più ricca.</div>';
    } else {
      html+='<ol style="margin:4px 0 6px 18px;font-size:12px;line-height:1.8">';
      r.res.steps.forEach(function(st){
        var bal=Math.abs(st.dU)>0.003? ' · bilancio '+(st.dU>0?'+':'')+(st.dU*100).toFixed(1)+' pt '+(st.dU>0?'sovra':'sotto'):'';
        html+='<li><b>'+esc2(st.lab)+'</b> <span style="color:var(--green)">'+st.dt.toFixed(3)+' s</span> <span class="small">'+st.conf+bal+'</span></li>';
      });
      html+='</ol>';
      html+='<div class="small">Guadagno totale previsto su questo tracciato: <b style="color:var(--green)">'+r.res.total.toFixed(3)+' ± '+r.res.unc.toFixed(3)+' s</b></div>';
    }
    html+='<div style="display:flex;gap:8px;margin-top:6px;flex-wrap:wrap">'+
      '<button class="btn btn-blue" style="font-size:10px" onclick="showPage(\''+(mode==='track'?'setup':'rally-setup')+'\')">APRI SETUP</button>'+
      '<span class="small" style="opacity:.75">Base: valori attuali del form Setup '+(mode==='track'?'pista':'rally')+' + profilo geometrico del percorso (quote zone, sconnesso, tempo). Applica una modifica alla volta e verifica.</span></div>';
    out.innerHTML=html;
  } catch(e){ out.innerHTML='<span class="small" style="color:var(--yellow)">Errore: '+esc2(e.message)+'</span>'; }
};

