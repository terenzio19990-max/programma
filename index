async function _chooseReport(type){
  document.getElementById('report-type-modal').style.display='none';
  // Route to the right generator
  if(type === 'json')    return _exportReportJson();
  if(type === 'image')   return _exportReportImage();
  if(type === 'weekend') return _generateWeekendReport();
  if(type === 'officina')return _generateOfficinaReport();
