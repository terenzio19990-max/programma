        <div class="field f2"><label>Vettura destinazione</label><select id="ps-bulk-car-sel" style="width:100%;"></select></div>
        <div class="field f2"><label>Pilota destinazione</label><select id="ps-bulk-driver-sel" style="width:100%;"><option value="">— Tutti / Non assegnato —</option></select></div>
