// ═══════════════════════════════════════════════════════════════
// CONFRONTO VETTURE — side-by-side comparison of 2-4 cars
// ═══════════════════════════════════════════════════════════════
var _cmpSelected = []; // car ids selected for comparison

function _cmpAllCars(){
  // Combine track + rally cars; user picks any subset across both
  return [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
}

function _cmpToggle(carId){
  var i = _cmpSelected.indexOf(carId);
  if(i >= 0){
    _cmpSelected.splice(i, 1);
  } else {
    if(_cmpSelected.length >= 4){
      showToast('Massimo 4 vetture per confronto');
      return;
    }
    _cmpSelected.push(carId);
  }
  renderConfrontoPage();
}
window._cmpToggle = _cmpToggle;

function _cmpRefreshSessionFilter(){
  var sel = document.getElementById('cmp-session-filter');
  if(!sel) return;
  // Collect all unique session names across all selected cars (or all if none selected)
  var carIds = _cmpSelected.length ? _cmpSelected : _cmpAllCars().map(function(c){return c.id;});
  var sessSet = new Set();
  carIds.forEach(function(id){
    (STATE.laps[id]||[]).forEach(function(l){
      if(l.session) sessSet.add(l.session);
    });
  });
  var current = sel.value;
  var sessions = Array.from(sessSet).sort();
  sel.innerHTML = '<option value="">Tutte le sessioni</option>'+
    sessions.map(function(s){return '<option value="'+s+'"'+(s===current?' selected':'')+'>'+s+'</option>';}).join('');
}

function _cmpFmtMs(ms){
  if(!ms||!isFinite(ms)||ms<=0) return '—';
  var min = Math.floor(ms/60000);
  var sec = ((ms%60000)/1000).toFixed(3);
  if(sec.length === 5) sec = '0'+sec;
  return min+':'+sec;
}

// Compute aggregated stats for a single car, optionally filtered by session
function _cmpStatsForCar(car, sessionFilter){
  var laps = (STATE.laps[car.id]||[]).slice();
  if(sessionFilter) laps = laps.filter(function(l){return l.session === sessionFilter;});
  var times = laps.map(function(l){return parseTime(l.time);}).filter(function(t){return t&&isFinite(t);});
  var s1times = laps.map(function(l){return parseTime(l.s1);}).filter(function(t){return t&&isFinite(t);});
  var s2times = laps.map(function(l){return parseTime(l.s2);}).filter(function(t){return t&&isFinite(t);});
  var s3times = laps.map(function(l){return parseTime(l.s3);}).filter(function(t){return t&&isFinite(t);});
  var vmaxes  = laps.map(function(l){return +l.vmax||0;}).filter(function(v){return v>0;});
  var best  = times.length ? Math.min.apply(null, times) : null;
  var avg   = times.length ? times.reduce(function(a,b){return a+b;},0)/times.length : null;
  // Standard deviation (consistency)
  var stddev = null, cv = null;
  if(times.length >= 2 && avg){
    var variance = times.reduce(function(s,v){return s+(v-avg)*(v-avg);},0)/times.length;
    stddev = Math.sqrt(variance);
    cv = (stddev/avg)*100;
  }
  // Tyres compound (current)
  var ts = (STATE.tyres && STATE.tyres[car.id]) || (STATE.rallyTyres && STATE.rallyTyres[car.id]);
  var compound = '—';
  var avgWear = null;
  if(ts && ts.current && ts.current.wheels){
    var cpds = [];
    var wears = [];
    ['FL','FR','RL','RR'].forEach(function(p){
      var w = ts.current.wheels[p];
      if(w){
        if(w.compound) cpds.push(w.compound);
        if(w.wear !== undefined) wears.push(+w.wear||0);
      }
    });
    if(cpds.length) compound = Array.from(new Set(cpds)).join('/');
    if(wears.length) avgWear = wears.reduce(function(a,b){return a+b;},0)/wears.length;
  }
  // Fuel L/lap
  var fuel = (STATE.fuel && STATE.fuel[car.id]) || (STATE.rallyFuel && STATE.rallyFuel[car.id]);
  var perLap = fuel && fuel.perLap ? +fuel.perLap : null;

  return {
    car: car,
    laps: laps,
    times: times,
    best: best,
    bestS1: s1times.length ? Math.min.apply(null, s1times) : null,
    bestS2: s2times.length ? Math.min.apply(null, s2times) : null,
    bestS3: s3times.length ? Math.min.apply(null, s3times) : null,
    avg: avg,
    stddev: stddev,
    cv: cv,
    maxVmax: vmaxes.length ? Math.max.apply(null, vmaxes) : null,
    lapCount: times.length,
    compound: compound,
    avgWear: avgWear,
    fuelPerLap: perLap
  };
}

// Render the car selector (chips)
function _cmpRenderCarSelector(){
  var container = document.getElementById('cmp-car-selector');
  if(!container) return;
  var cars = _cmpAllCars();
  if(!cars.length){
    container.innerHTML = '<div style="color:var(--text3);font-size:11px;padding:8px;">Nessuna vettura disponibile.</div>';
    return;
  }
  container.innerHTML = cars.map(function(c){
    var sel = _cmpSelected.indexOf(c.id) >= 0;
    var col = c.type === 'rally' ? 'var(--green)' : 'var(--accent)';
    return '<button onclick="_cmpToggle(\''+c.id+'\')" style="'+
      'background:'+(sel?col:'var(--bg3)')+';'+
      'color:'+(sel?'#fff':'var(--text2)')+';'+
      'border:1px solid '+(sel?col:'var(--border)')+';'+
      'border-radius:18px;padding:6px 13px;font-size:11px;font-weight:600;cursor:pointer;'+
      (sel?'box-shadow:0 0 8px rgba(232,66,26,0.3);':'')+
      '">'+(sel?'✓ ':'')+c.name+(c.retired?' (R)':'')+'</button>';
  }).join('');
}

// Helper: KPI row for the comparison table
function _cmpFindBest(stats, key, lower){
  // returns the index of the car with best value for key (lower=true means smaller is better)
  var bestIdx = -1, bestVal = lower?Infinity:-Infinity;
  stats.forEach(function(s, i){
    var v = s[key];
    if(v == null || !isFinite(v)) return;
    if(lower ? v < bestVal : v > bestVal){
      bestVal = v;
      bestIdx = i;
    }
  });
  return bestIdx;
}

function renderConfrontoPage(){
  // Perf guard: skip if container not visible
  var _pg = document.getElementById('confronto-content');
  if(_pg && !_pg.offsetParent && !window.__FORCE_REBUILD) return;

  _cmpRefreshSessionFilter();
  _cmpRenderCarSelector();
  var c = document.getElementById('confronto-content');
  if(!c) return;
  if(_cmpSelected.length < 2){
    c.innerHTML = '<div style="padding:30px;text-align:center;color:var(--text3);font-size:12px;line-height:1.7;">'+
      '<div style="font-size:32px;margin-bottom:10px;">🔀</div>'+
      'Seleziona <b>almeno 2 vetture</b> qui sopra per iniziare il confronto.<br>'+
      '<span style="font-size:11px;">Puoi mescolare vetture di pista e rally se ti serve un confronto incrociato.</span>'+
      '</div>';
    return;
  }
  var sessFilter = document.getElementById('cmp-session-filter')?.value || '';
  var cars = _cmpAllCars();
  var stats = _cmpSelected.map(function(id){
    var car = cars.find(function(c){return c.id === id;});
    if(!car) return null;
    return _cmpStatsForCar(car, sessFilter);
  }).filter(Boolean);

  if(stats.length < 2){
    c.innerHTML = '<div style="padding:20px;color:var(--text3);">Vetture selezionate non valide.</div>';
    return;
  }

  // Find best indices for each metric (so we can highlight)
  var bestBest    = _cmpFindBest(stats, 'best', true);
  var bestS1      = _cmpFindBest(stats, 'bestS1', true);
  var bestS2      = _cmpFindBest(stats, 'bestS2', true);
  var bestS3      = _cmpFindBest(stats, 'bestS3', true);
  var bestAvg     = _cmpFindBest(stats, 'avg', true);
  var bestCV      = _cmpFindBest(stats, 'cv', true);
  var bestVmax    = _cmpFindBest(stats, 'maxVmax', false);
  var bestFuel    = _cmpFindBest(stats, 'fuelPerLap', true);

  function valCell(s, key, idx, bestIdx, fmt, suffix){
    var v = s[key];
    var disp = v == null || !isFinite(v) ? '—' : (fmt ? fmt(v) : v.toString());
    if(disp !== '—' && suffix) disp += suffix;
    var isBest = idx === bestIdx;
    var color = isBest ? 'var(--green)' : 'var(--text1)';
    var fontWeight = isBest ? '700' : '500';
    return '<td style="font-family:var(--mono);color:'+color+';font-weight:'+fontWeight+';text-align:center;">'+(isBest?'🏆 ':'')+disp+'</td>';
  }

  var html = '<div class="panel"><div class="panel-head">📊 CONFRONTO ('+stats.length+' VETTURE'+(sessFilter?' · '+sessFilter:'')+')</div><div class="panel-body" style="overflow-x:auto;">';
  html += '<table class="data-table" style="font-size:12px;"><thead><tr>'+
    '<th style="background:var(--bg3);text-align:left;">METRICA</th>'+
    stats.map(function(s){
      var col = s.car.type === 'rally' ? 'var(--green)' : 'var(--accent)';
      return '<th style="background:'+col+';color:#fff;text-align:center;">'+s.car.name+'</th>';
    }).join('')+
  '</tr></thead><tbody>';

  // BEST LAP
  html += '<tr><td><b>🏁 Best Lap</b></td>'+
    stats.map(function(s,i){return valCell(s,'best',i,bestBest, _cmpFmtMs);}).join('')+
  '</tr>';
  // BEST S1
  html += '<tr><td>Best Settore 1</td>'+
    stats.map(function(s,i){return valCell(s,'bestS1',i,bestS1, _cmpFmtMs);}).join('')+
  '</tr>';
  // BEST S2
  html += '<tr><td>Best Settore 2</td>'+
    stats.map(function(s,i){return valCell(s,'bestS2',i,bestS2, _cmpFmtMs);}).join('')+
  '</tr>';
  // BEST S3
  html += '<tr><td>Best Settore 3</td>'+
    stats.map(function(s,i){return valCell(s,'bestS3',i,bestS3, _cmpFmtMs);}).join('')+
  '</tr>';
  // AVG
  html += '<tr><td>Tempo medio</td>'+
    stats.map(function(s,i){return valCell(s,'avg',i,bestAvg, _cmpFmtMs);}).join('')+
  '</tr>';
  // CV
  html += '<tr><td>Consistenza CV%</td>'+
    stats.map(function(s,i){return valCell(s,'cv',i,bestCV, function(v){return v.toFixed(2);}, '%');}).join('')+
  '</tr>';
  // MAX VMAX
  html += '<tr><td>🚀 V.Max</td>'+
    stats.map(function(s,i){return valCell(s,'maxVmax',i,bestVmax, function(v){return v.toFixed(1);}, ' km/h');}).join('')+
  '</tr>';
  // LAPS
  html += '<tr><td>Giri considerati</td>'+
    stats.map(function(s,i){return '<td style="text-align:center;">'+s.lapCount+'</td>';}).join('')+
  '</tr>';
  // COMPOUND
  html += '<tr><td>🛞 Mescola attuale</td>'+
    stats.map(function(s,i){return '<td style="text-align:center;font-family:var(--mono);">'+s.compound+'</td>';}).join('')+
  '</tr>';
  // AVG WEAR
  html += '<tr><td>Usura media</td>'+
    stats.map(function(s,i){
      if(s.avgWear == null) return '<td style="text-align:center;color:var(--text3);">—</td>';
      var wcol = s.avgWear<40?'var(--green)':s.avgWear<70?'var(--yellow)':'var(--red)';
      return '<td style="text-align:center;color:'+wcol+';font-weight:700;font-family:var(--mono);">'+s.avgWear.toFixed(0)+'%</td>';
    }).join('')+
  '</tr>';
  // FUEL L/LAP
  html += '<tr><td>⛽ Consumo L/giro</td>'+
    stats.map(function(s,i){return valCell(s,'fuelPerLap',i,bestFuel, function(v){return v.toFixed(2);}, ' L');}).join('')+
  '</tr>';

  html += '</tbody></table></div></div>';

  // ─── Delta from best (gap analysis) ─────────────────────────
  if(bestBest >= 0){
    var refBest = stats[bestBest].best;
    html += '<div class="panel" style="margin-top:12px;"><div class="panel-head">⏱ DELTA SUL BEST LAP</div><div class="panel-body">';
    html += '<div style="font-size:11px;color:var(--text3);margin-bottom:10px;line-height:1.5;">'+
      'Gap di ogni vettura rispetto alla più veloce ('+stats[bestBest].car.name+': '+_cmpFmtMs(refBest)+').'+
    '</div>';
    stats.forEach(function(s, i){
      if(i === bestBest){
        html += '<div style="display:grid;grid-template-columns:160px 1fr 80px;gap:10px;align-items:center;margin-bottom:6px;">'+
          '<span style="font-size:12px;color:var(--text1);"><b>'+s.car.name+'</b></span>'+
          '<div style="background:var(--green);height:10px;border-radius:2px;width:100%;"></div>'+
          '<span style="text-align:right;font-family:var(--mono);color:var(--green);font-weight:700;">RIFERIMENTO</span>'+
        '</div>';
        return;
      }
      if(s.best == null){
        html += '<div style="display:grid;grid-template-columns:160px 1fr 80px;gap:10px;align-items:center;margin-bottom:6px;">'+
          '<span style="font-size:12px;color:var(--text2);">'+s.car.name+'</span>'+
          '<div style="background:var(--bg3);height:10px;border-radius:2px;"></div>'+
          '<span style="text-align:right;font-family:var(--mono);color:var(--text3);font-size:11px;">— no data</span>'+
        '</div>';
        return;
      }
      var deltaMs = s.best - refBest;
      var deltaSec = (deltaMs/1000).toFixed(3);
      var maxDeltaForBar = Math.max.apply(null, stats.filter(function(x){return x.best!=null;}).map(function(x){return x.best - refBest;}));
      var pct = maxDeltaForBar > 0 ? Math.min(100, Math.round((deltaMs/maxDeltaForBar)*100)) : 0;
      var col = deltaMs < 200 ? 'var(--yellow)' : deltaMs < 700 ? '#f59e0b' : 'var(--red)';
      html += '<div style="display:grid;grid-template-columns:160px 1fr 80px;gap:10px;align-items:center;margin-bottom:6px;">'+
        '<span style="font-size:12px;color:var(--text1);">'+s.car.name+'</span>'+
        '<div style="background:var(--bg3);height:10px;border-radius:2px;overflow:hidden;"><div style="background:'+col+';height:100%;width:'+pct+'%;"></div></div>'+
        '<span style="text-align:right;font-family:var(--mono);color:'+col+';font-weight:700;">+'+deltaSec+'s</span>'+
      '</div>';
    });
    html += '</div></div>';
  }

  // ─── Sector dominance ────────────────────────────────────────
  html += '<div class="panel" style="margin-top:12px;"><div class="panel-head">🎯 DOMINANZA SETTORI</div><div class="panel-body">';
  html += '<div style="font-size:11px;color:var(--text3);margin-bottom:10px;line-height:1.5;">'+
    'Per ogni settore, quale vettura è la più veloce. Aiuta a capire dove ogni vettura ha i suoi punti forti.'+
  '</div>';
  ['S1','S2','S3'].forEach(function(s, idx){
    var keys = ['bestS1','bestS2','bestS3'];
    var bestI = _cmpFindBest(stats, keys[idx], true);
    if(bestI < 0){
      html += '<div style="margin-bottom:6px;font-size:12px;color:var(--text3);">'+s+': nessun dato disponibile</div>';
      return;
    }
    var winner = stats[bestI];
    var others = stats.map(function(st, i){
      if(i === bestI) return null;
      var v = st[keys[idx]];
      if(v == null) return null;
      return { name: st.car.name, gap: v - winner[keys[idx]] };
    }).filter(Boolean);
    html += '<div style="display:flex;align-items:center;gap:10px;background:var(--bg3);padding:8px 12px;border-radius:4px;margin-bottom:5px;">'+
      '<span style="background:var(--green);color:#fff;padding:3px 9px;border-radius:3px;font-size:11px;font-weight:700;letter-spacing:1px;">🏆 '+s+'</span>'+
      '<span style="font-size:12px;color:var(--text1);"><b>'+winner.car.name+'</b> '+_cmpFmtMs(winner[keys[idx]])+'</span>'+
      (others.length ? '<span style="margin-left:auto;font-size:10px;color:var(--text3);">'+
        others.map(function(o){return o.name+' +'+(o.gap/1000).toFixed(3)+'s';}).join(' · ')+
      '</span>' : '')+
    '</div>';
  });
  html += '</div></div>';

  c.innerHTML = html;
}
window.renderConfrontoPage = renderConfrontoPage;

// ═══════════════════════════════════════════════════════════════
// BROWSER NOTIFICATIONS — alert the user about critical Todo items
// ═══════════════════════════════════════════════════════════════
var NOTIFS_KEY = 'REP_notifs_enabled_v1';
var _notifsLastCriticalSet = new Set();   // de-dup: don't re-notify already-notified critical alerts
var _notifsTimer = null;

function notifsSupported(){
  return ('Notification' in window);
}
function notifsPermission(){
  if(!notifsSupported()) return 'unsupported';
  return Notification.permission; // 'default' | 'granted' | 'denied'
}
function notifsEnabled(){
  if(!notifsSupported()) return false;
  if(notifsPermission() !== 'granted') return false;
  try { return localStorage.getItem(NOTIFS_KEY) === '1'; } catch(_){ return false; }
}
window.notifsEnabled = notifsEnabled;

function notifsRefreshUI(){
  var statusEl = document.getElementById('notif-perm-status');
  var btn      = document.getElementById('notif-permission-btn');
  var cb       = document.getElementById('notif-enabled-cb');
  var lab      = document.getElementById('notif-enabled-label');
  if(!notifsSupported()){
    if(statusEl) statusEl.innerHTML = '<span style="color:var(--red);">⚠ Browser non supporta le notifiche</span>';
    if(btn) { btn.disabled = true; btn.textContent = 'NON DISPONIBILE'; btn.style.opacity = '0.4'; }
    if(cb) { cb.disabled = true; cb.checked = false; }
    if(lab) { lab.textContent = 'NON DISPONIBILE'; lab.style.color = 'var(--text3)'; }
    return;
  }
  var perm = notifsPermission();
  if(statusEl){
    if(perm === 'granted')      statusEl.innerHTML = '<span style="color:var(--green);">✓ Permesso concesso</span>';
    else if(perm === 'denied')  statusEl.innerHTML = '<span style="color:var(--red);">✗ Permesso negato — abilita nelle impostazioni del browser</span>';
    else                        statusEl.innerHTML = '<span style="color:var(--yellow);">⚠ Permesso non ancora richiesto</span>';
  }
  if(btn){
    btn.disabled = (perm === 'granted' || perm === 'denied');
    btn.style.opacity = btn.disabled ? '0.5' : '1';
    btn.textContent = perm === 'granted' ? '✓ CONCESSO' : perm === 'denied' ? '✗ NEGATO' : 'RICHIEDI PERMESSO';
  }
  if(cb){
    cb.disabled = (perm !== 'granted');
    cb.checked = notifsEnabled();
  }
  if(lab){
    if(notifsEnabled()){ lab.textContent = '🔔 ATTIVE'; lab.style.color = 'var(--green)'; }
    else               { lab.textContent = 'SPENTE';   lab.style.color = 'var(--text3)'; }
  }
}
window.notifsRefreshUI = notifsRefreshUI;

function notifsRequestPermission(){
  if(!notifsSupported()){ showToast('Browser non supporta le notifiche'); return; }
  Notification.requestPermission().then(function(perm){
    notifsRefreshUI();
    if(perm === 'granted'){
      showToast('✓ Permesso concesso — attiva il toggle per ricevere alert');
    } else if(perm === 'denied'){
      showToast('Permesso negato — modifica nelle impostazioni del browser');
    }
  }).catch(function(){
    notifsRefreshUI();
  });
}
window.notifsRequestPermission = notifsRequestPermission;

function notifsToggle(on){
  if(on && notifsPermission() !== 'granted'){
    showToast('Prima richiedi il permesso al browser');
    var cb = document.getElementById('notif-enabled-cb');
    if(cb) cb.checked = false;
    notifsRefreshUI();
    return;
  }
  try { localStorage.setItem(NOTIFS_KEY, on ? '1' : '0'); } catch(_){}
  if(on){
    notifsStartWatcher();
    showToast('🔔 Notifiche attivate');
  } else {
    notifsStopWatcher();
    showToast('Notifiche disattivate');
  }
  notifsRefreshUI();
}
window.notifsToggle = notifsToggle;

function notifsTest(){
  if(!notifsSupported()){ showToast('Browser non supporta le notifiche'); return; }
  if(notifsPermission() !== 'granted'){ showToast('Prima concedi il permesso'); return; }
  try {
    var n = new Notification('🏁 Race Engineer Pro', {
      body: 'Notifica di prova — il sistema funziona ✓',
      tag: 'rep-test',
      icon: undefined
    });
    n.onclick = function(){
      try { window.focus(); n.close(); } catch(_){}
    };
    showToast('📨 Notifica inviata');
  } catch(e){
    showToast('Errore: '+e.message);
  }
}
window.notifsTest = notifsTest;

// Send notification for a specific critical item (de-duped by text)
function _notifsSend(item){
  if(!notifsEnabled()) return;
  var key = (item.icon||'')+'|'+(item.text||'');
  if(_notifsLastCriticalSet.has(key)) return;
  _notifsLastCriticalSet.add(key);
  try {
    var n = new Notification('🚨 Race Engineer Pro — Alert critico', {
      body: item.text,
      tag: 'rep-' + key.slice(0,40),  // tag de-dups at OS level too
      requireInteraction: false
    });
    n.onclick = function(){
      try {
        window.focus();
        if(item.page && typeof showPage === 'function') showPage(item.page);
        n.close();
      } catch(_){}
    };
  } catch(_){}
}

// Periodic check: scan _todoCheck and notify on new critical items
function _notifsTick(){
  if(!notifsEnabled()) return;
  if(typeof _todoCheck !== 'function') return;
  try {
    var items = _todoCheck();
    var critical = items.filter(function(it){return it.prio === 'critical';});
    // Build set of currently-critical keys
    var currentKeys = new Set(critical.map(function(it){return (it.icon||'')+'|'+(it.text||'');}));
    // Drop from "last set" any keys no longer critical (so they can re-notify if come back)
    _notifsLastCriticalSet.forEach(function(k){
      if(!currentKeys.has(k)) _notifsLastCriticalSet.delete(k);
    });
    // Send for new criticals
    critical.forEach(_notifsSend);
  } catch(_){}
}

function notifsStartWatcher(){
  notifsStopWatcher();
  // First tick immediate (after 2s settle), then every 30s
  setTimeout(_notifsTick, 2000);
  _notifsTimer = setInterval(_notifsTick, 30000);
}
function notifsStopWatcher(){
  if(_notifsTimer){ clearInterval(_notifsTimer); _notifsTimer = null; }
  _notifsLastCriticalSet.clear();
}

// Auto-start at app load if user had previously opted in AND permission still granted
if(typeof window !== 'undefined'){
  try {
    if(notifsSupported() && notifsPermission() === 'granted' && localStorage.getItem(NOTIFS_KEY) === '1'){
      // Defer slightly to let app finish init
      setTimeout(notifsStartWatcher, 5000);
    }
  } catch(_){}
}





(function init() {
