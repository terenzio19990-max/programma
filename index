// Simple QR-code-like matrix generator using canvas







// ═══════════════════════════════════════════════════════════════
// QR CODE SESSION — rewritten
// ═══════════════════════════════════════════════════════════════
var _qrLibLoaded   = false;
var _qrLibLoading  = false;
var _qrPendingText = null;

function generateSessionQR() {
  var modal = document.getElementById('qr-modal');
  if(modal) modal.style.display = 'flex';

  var snap   = serializeSession();
  snap.name  = snap.name || autoSessionName();

  // Compact summary that fits in a QR (< 500 chars)
  var allCars   = (snap.STATE.trackCars||[]).concat(snap.STATE.rallyCars||[]);
  var totalLaps = allCars.reduce(function(a,c){ return a + ((snap.STATE.laps||{})[c.id]||[]).length; }, 0);
  var bestMs    = Infinity;
  allCars.forEach(function(c){ var b = getBestLapMs(c.id); if(b && b < bestMs) bestMs = b; });

  var summary = {
    app:     'RaceEngineerPro_v16',
    name:    (snap.name||'').slice(0,40),
    mode:    snap.STATE.mode,
    circuit: snap.STATE.circuit||'',
    cars:    allCars.map(function(c){ return c.name; }).join(', ').slice(0,60),
    laps:    totalLaps,
    best:    bestMs < Infinity ? msToTime(bestMs) : '-',
    at:      new Date().toLocaleString('it-IT',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}),
  };
  var qrText = JSON.stringify(summary);

  // Status panel
  var statusEl = document.getElementById('qr-status');
  if(statusEl) {
    statusEl.innerHTML =
      '<b style="color:var(--text1);">'+(summary.name||'Sessione senza nome')+'</b><br>'
      +(summary.cars ? '<span style="color:var(--text3);font-size:10px;">'+summary.cars+'</span><br>' : '')
      +'<span style="font-size:11px;">Giri: <b>'+totalLaps+'</b>'
      +(bestMs<Infinity ? ' &middot; Best: <b>'+msToTime(bestMs)+'</b>' : '')+' &middot; '+summary.at+'</span>';
  }

  // Download link (full session JSON)
  var blob  = new Blob([JSON.stringify(snap, null, 2)], {type:'application/json'});
  var dlUrl = URL.createObjectURL(blob);
  var dlBtn = document.getElementById('qr-download-btn');
  if(dlBtn) {
    dlBtn.href     = dlUrl;
    dlBtn.download = (summary.name||'sessione').replace(/[^\w\-]/g,'_') + '.json';
  }

  // Draw QR
  _qrRender(qrText);
}

function _qrRender(text) {
  var wrap = document.getElementById('qr-canvas-wrap');
  if(!wrap) return;

  if(_qrLibLoaded && window.QRCode) {
    // Library already loaded — render directly
    wrap.innerHTML = '';
    try {
      new QRCode(wrap, {
        text:         text,
        width:        200,
        height:       200,
        colorDark:    '#1a1d26',
        colorLight:   '#ffffff',
        correctLevel: QRCode.CorrectLevel.M,
      });
    } catch(e) {
      _qrCanvas(wrap, text);
    }
    return;
  }

  if(_qrLibLoading) {
    // Already loading — save pending text, will render on load
    _qrPendingText = text;
    wrap.innerHTML = '<div style="color:var(--text3);font-size:12px;padding:20px;text-align:center;">&#8987; Caricamento QR...</div>';
    return;
  }

  // First load — show spinner
  wrap.innerHTML = '<div style="color:var(--text3);font-size:12px;padding:20px;text-align:center;">&#8987; Caricamento QR...</div>';
  _qrLibLoading  = true;
  _qrPendingText = text;

  var script = document.createElement('script');
  script.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  script.onload = function() {
    _qrLibLoaded  = true;
    _qrLibLoading = false;
    var t = _qrPendingText;
    _qrPendingText = null;
    var w = document.getElementById('qr-canvas-wrap');
    if(!w) return;
    w.innerHTML = '';
    try {
      new QRCode(w, {text:t, width:200, height:200, colorDark:'#1a1d26', colorLight:'#ffffff', correctLevel:QRCode.CorrectLevel.M});
    } catch(e2) { _qrCanvas(w, t); }
  };
  script.onerror = function() {
    _qrLibLoading = false;
    var w = document.getElementById('qr-canvas-wrap');
    if(w) {
      var c = document.createElement('canvas');
      c.width = 200; c.height = 200;
      w.innerHTML = '';
      w.appendChild(c);
      _qrCanvas(w, _qrPendingText||text);
    }
  };
  document.head.appendChild(script);
}

// Canvas fallback — draws a real Reed-Solomon-free QR pattern that at least LOOKS like a QR
// (not scannable, but visually correct with finder patterns)
function _qrCanvas(container, text) {
  var size = 200;
  var canvas = container.querySelector('canvas');
  if(!canvas) { canvas = document.createElement('canvas'); container.appendChild(canvas); }
  canvas.width = size; canvas.height = size;
  var ctx = canvas.getContext('2d');
  if(!ctx) return;
  ctx.fillStyle = '#ffffff'; ctx.fillRect(0,0,size,size);
  ctx.fillStyle = '#1a1d26';
  var N = 21, cs = size/N;

  // Data bits from text
  var bits = [];
  for(var i=0;i<text.length;i++){var c=text.charCodeAt(i);for(var b=7;b>=0;b--)bits.push((c>>b)&1);}

  for(var row=0;row<N;row++){
    for(var col=0;col<N;col++){
      var fill = false;
      // Finder patterns (top-left, top-right, bottom-left)
      if((row<7&&col<7)||(row<7&&col>13)||(row>13&&col<7)){
        var r=row%7, c2=col%7;
        if(row>13)r=row-14; if(col>13)c2=col-14;
        fill = (r===0||r===6||c2===0||c2===6||(r>=2&&r<=4&&c2>=2&&c2<=4));
      } else if(row===7||col===7) {
        // Timing
        fill = (row===6||col===6) ? ((row+col)%2===0) : false;
      } else {
        // Data
        var bi = ((row-8)*8+(col-8)) % bits.length;
        if(bi<0)bi+=bits.length;
        fill = bits[Math.abs(bi)] === 1;
      }
      if(fill) ctx.fillRect(col*cs, row*cs, cs-0.5, cs-0.5);
    }
  }
  // Label
  ctx.fillStyle = '#e8421a';
  ctx.font = 'bold 9px monospace';
  ctx.textAlign = 'center';
  ctx.fillText('REP v16', size/2, size-3);

  // Show "not scannable" note
  var note = container.parentNode && container.parentNode.querySelector('.qr-note');
  if(!note) {
    var nd = document.createElement('div');
    nd.className = 'qr-note';
    nd.style.cssText = 'font-size:10px;color:var(--yellow);margin-top:6px;text-align:center;';
    nd.textContent = '⚠ Offline: QR decorativo. Usa Scarica JSON.';
    container.parentNode && container.parentNode.insertBefore(nd, container.nextSibling);
  }
}

