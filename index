const EMBEDDABLE_SITES = [
  'wikipedia.org','acisport.it','ewrc-results.com','rallylink.it','motorsportstats.com',
  'openstreetmap.org','fiasport.it','thatsrally.it','rallyssimo.it','motorsport.com',
  'rally.it','acisport.it'
];
const ALWAYS_NEWTAB = [
  'google.com','facebook.com','twitter.com','x.com','instagram.com','tiktok.com',
  'apple.com','amazon.com','paypal.com','netflix.com','linkedin.com','youtube.com',
  'reddit.com','github.com',
  // Siti motorsport/enciclopedici che vietano l'incorporamento (X-Frame-Options/CSP):
