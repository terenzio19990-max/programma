      var r=mode==='rally'? 'r-':'';
      function set(id,v){ var el=document.getElementById(r+id); if(el&&v!=null&&v!==''){ el.value=v; } }
      ta.value.split(/\r?\n/).forEach(function(line){
        var l=line.toLowerCase(), nums=(line.replace(/(\d),(\d)/g,'$1.$2').match(/-?\d+(\.\d+)?/g))||[];
        if(/compensator/.test(l)&&nums.length){ set('sa2-helper-f',nums[0]); set('sa2-helper-r',nums[1]!==undefined?nums[1]:nums[0]); }
