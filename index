// Main parser — tries to detect formats automatically
function bulkAnalyze(){
  var txt=(document.getElementById('bulk-paste')||{}).value||'';
  var st=document.getElementById('bulk-status');
  if(!txt.trim()){ if(st) st.innerHTML='<span style="color:var(--yellow)">Nessun testo da analizzare</span>'; return; }
  var startLap = +(document.getElementById('bulk-start-lap')||{}).value || 1;
  var rows = txt.split(/\r?\n/).map(function(l){return l.replace(/\t/g,'\t').trim();}).filter(function(l){return l.length>0;});

  // Detect CSV vs TSV vs space separator
  // Try to find a header row first
  var headers = null, headerIdx = -1;
  for(var i=0;i<Math.min(rows.length,5);i++){
    var low = rows[i].toLowerCase();
    if(/\b(time|tempo|lap|giro)\b/.test(low) && !/^\d/.test(rows[i])){
      headers = rows[i].split(/[,;\t]/).map(function(h){return h.replace(/["']/g,'').trim().toLowerCase();});
      headerIdx = i; break;
    }
  }
  var lapIdx=-1,timeIdx=-1,s1Idx=-1,s2Idx=-1,s3Idx=-1,posIdx=-1,noteIdx=-1,vmaxIdx=-1;
  var sep = null;
  if(headers){
    lapIdx  = headers.findIndex(function(h){return h==='lap'||h==='giro'||h==='n'||h==='#';});
    timeIdx = headers.findIndex(function(h){return h==='time'||h==='tempo'||h==='laptime'||h==='lap time';});
    s1Idx   = headers.findIndex(function(h){return h==='s1'||h==='sector1'||h==='sec1'||h==='settore1';});
    s2Idx   = headers.findIndex(function(h){return h==='s2'||h==='sector2'||h==='sec2'||h==='settore2';});
    s3Idx   = headers.findIndex(function(h){return h==='s3'||h==='sector3'||h==='sec3'||h==='settore3';});
    posIdx  = headers.findIndex(function(h){return h==='pos'||h==='posizione'||h==='position';});
    noteIdx = headers.findIndex(function(h){return h==='note'||h==='notes'||h==='comment';});
    vmaxIdx = headers.findIndex(function(h){return h==='vmax'||h==='v.max'||h==='vel max'||h==='velmax'||h==='top speed'||h==='topspeed'||h==='speed'||h==='speed max'||h==='kmh'||h==='km/h'||h==='velocita'||h==='velocità';});
    // Detect sep by re-splitting original header
    var orig = rows[headerIdx];
    if(orig.indexOf(',')>=0) sep=',';
    else if(orig.indexOf(';')>=0) sep=';';
    else if(orig.indexOf('\t')>=0) sep='\t';
    else sep=null;
  }
  var dataRows = headers ? rows.slice(headerIdx+1) : rows;

  var parsed = [];
  var skipped = [];
  var autoLap = startLap;

  function splitRow(line){
    if(sep) return line.split(sep).map(function(v){return v.replace(/["']/g,'').trim();});
    // Auto-detect: if contains tab => tab; else multiple spaces; else comma; else single value
    if(line.indexOf('\t')>=0) return line.split(/\t+/).map(function(v){return v.trim();});
    if(/\s{2,}/.test(line)) return line.split(/\s{2,}/).map(function(v){return v.trim();});
    if(line.indexOf(',')>=0) return line.split(',').map(function(v){return v.trim();});
    if(line.indexOf(';')>=0) return line.split(';').map(function(v){return v.trim();});
    // Fallback: single space, but only if first token is int (lap number) and second looks like time
    var parts = line.split(/\s+/);
    return parts;
  }

  dataRows.forEach(function(line){
    // Skip obvious non-data lines
    if(/^\s*$/.test(line)) return;
    if(/^[-=_]{3,}$/.test(line)) return;
    // Strip "Lap N:" prefix → unify
    var m1 = line.match(/^\s*(?:lap|giro)\s*:?\s*(\d+)\s*[:\-\t ]+(.+)$/i);
    if(m1){
      var t = parseTime(m1[2].split(/\s+/)[0]);
      if(t){ parsed.push({lap:+m1[1]||autoLap++, time:msToTime(t), s1:'',s2:'',s3:'',pos:'',note:''}); return; }
    }
    var cols = splitRow(line);
    // Heuristic mapping when no headers
    if(headers){
      var time = timeIdx>=0 ? cols[timeIdx] : null;
      var ms = parseTime(time);
      if(!ms){ skipped.push(line); return; }
      parsed.push({
        lap: lapIdx>=0 ? (+cols[lapIdx] || autoLap++) : autoLap++,
        time: msToTime(ms),
        s1: s1Idx>=0 ? (cols[s1Idx]||'') : '',
        s2: s2Idx>=0 ? (cols[s2Idx]||'') : '',
        s3: s3Idx>=0 ? (cols[s3Idx]||'') : '',
        pos: posIdx>=0 ? (cols[posIdx]||'') : '',
        vmax:vmaxIdx>=0 ? ((+String(cols[vmaxIdx]).replace(',','.'))||'') : '',
        note:noteIdx>=0 ? (cols[noteIdx]||'') : ''
      });
      return;
    }
    // No headers — try to find the first parseable time token
    var timeColIdx = -1, lapVal = null;
    for(var c=0;c<cols.length;c++){
      var candidate = cols[c];
      // Lap number (integer <=999) at position 0 — remember it
      if(c===0 && /^\d{1,3}$/.test(candidate) && !/[.,:'"]/.test(candidate)){
        // Could be a lap number only if next column is a time
        continue;
      }
      if(parseTime(candidate)){ timeColIdx = c; break; }
    }
    if(timeColIdx<0){ skipped.push(line); return; }
    // Lap = integer in column 0 (only if column 0 is integer and different from time column)
    if(timeColIdx>0 && /^\d{1,4}$/.test(cols[0]) && !parseTime(cols[0])) lapVal = +cols[0];
    var timeStr = msToTime(parseTime(cols[timeColIdx]));
    // Look for sectors after time column
    var s1='', s2='', s3='';
    var after = cols.slice(timeColIdx+1).filter(function(v){return v && parseTime(v);});
    if(after[0]) s1 = msToTime(parseTime(after[0])).replace(/^0:/,'');
    if(after[1]) s2 = msToTime(parseTime(after[1])).replace(/^0:/,'');
    if(after[2]) s3 = msToTime(parseTime(after[2])).replace(/^0:/,'');
    parsed.push({
      lap: lapVal!=null?lapVal:autoLap++,
      time: timeStr,
      s1:s1,s2:s2,s3:s3,pos:'',vmax:'',note:''
    });
  });

  // Renumber any lap<=0
  var nextLap = parsed.length ? Math.max.apply(null, parsed.map(function(p){return +p.lap||0;})) : 0;
  parsed.forEach(function(p,i){ if(!p.lap) p.lap = ++nextLap; });

  _bulkParsed = parsed;
  bulkRenderPreview();
  if(st){
    var msg = '<span style="color:var(--green)">✓ '+parsed.length+' tempi riconosciuti</span>';
    if(skipped.length) msg += ' <span style="color:var(--yellow)"> - '+skipped.length+' righe saltate</span>';
    st.innerHTML = msg;
  }
}

