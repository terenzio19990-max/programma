/* ═══ METEO → CONSIGLIO GOMME ═══ */
function tyreAdviceHTML(){
  try {
    var fc=(typeof METEO_STATE!=='undefined') && METEO_STATE.forecast;
    if(!fc || !fc.time || !fc.precipitation_probability) return '<span class="small">Apri prima il meteo di una località (serve il forecast orario).</span>';
    var now=Date.now(), idx=[];
    for(var i=0;i<fc.time.length;i++){
      var t=new Date(fc.time[i]).getTime();
      if(t>=now-1800000 && idx.length<4) { if(t>=now-1800000) idx.push(i); }
    }
    if(!idx.length) return '<span class="small">Forecast non copre le prossime ore.</span>';
    var maxProb=0, sumPrec=0, temps=[];
    idx.forEach(function(i2){
      maxProb=Math.max(maxProb, +fc.precipitation_probability[i2]||0);
      sumPrec+=+((fc.precipitation||[])[i2]||0);
      temps.push(+fc.temperature_2m[i2]);
    });
    var tAvg=temps.reduce(function(a,b){return a+b;},0)/temps.length;
    var verdict, col;
    if(sumPrec>1.5 || maxProb>=70){ verdict='🌧 RAIN — pioggia probabile ('+maxProb+'%, '+sumPrec.toFixed(1)+' mm attesi)'; col='var(--blue)'; }
    else if(maxProb>=35){ verdict='🌦 SLICK ma RISCHIO — tieni pronte le rain ('+maxProb+'%)'; col='var(--yellow)'; }
    else { verdict='☀ SLICK — pioggia improbabile ('+maxProb+'%)'; col='var(--green)'; }
    var comp = tAvg>=26? 'mescola più DURA / pressioni −0.1 (asfalto caldo '+tAvg.toFixed(0)+'°C)' :
               tAvg<=12? 'mescola più MORBIDA / scaldale bene (aria '+tAvg.toFixed(0)+'°C)' :
               'mescola standard (aria '+tAvg.toFixed(0)+'°C)';
    return '<div style="font-weight:700;color:'+col+'">'+verdict+'</div><div class="small" style="margin-top:4px">Prossime ~4 ore · consiglio mescola: '+comp+'</div>'+
      '<div class="small" style="opacity:.7;margin-top:2px">Fonte: forecast orario open-meteo della località impostata.</div>';
  } catch(e){ return '<span class="small">n.d.</span>'; }
}
function injectMeteoAdvice(){
  var pg=document.getElementById('page-meteo');
  if(!pg) return;
  var el=document.getElementById('rep-tyre-advice');
  if(!el){
    pg.insertAdjacentHTML('afterbegin','<div class="panel mb12" id="rep-tyre-advice-panel"><div class="panel-head">🛞 CONSIGLIO GOMME (prossime ore)</div><div class="panel-body" id="rep-tyre-advice"></div></div>');
