// Compute real consumption from declared fuelSS/fuelTF on past stages and
// suggest adopting it as the official param.
function buildRallyFuelInsight(car, rf){
  var el = document.getElementById('rfuel-insight');
  if(!el) return;
  var stages = STATE.stages.filter(function(s){return s.car===car.name && !s.cancelled;});
  // Filter to stages with both km and fuel declared
  var withFuelSS = stages.filter(function(s){return (+s.km||0) > 0 && (+s.fuelSS||0) > 0;});
  var withFuelTF = stages.filter(function(s){return (+s.tfKm||0) > 0 && (+s.fuelTF||0) > 0;});
  if(!withFuelSS.length && !withFuelTF.length){
    el.innerHTML = '<div style="font-size:11px;color:var(--text3);line-height:1.5;">📊 Inserisci almeno una PS con km e consumo reale per calcolare il consumo medio effettivo della vettura.</div>';
    return;
  }
  var html = '<div style="font-size:11px;color:var(--text3);margin-bottom:8px;line-height:1.5;">Consumo <b style="color:var(--text1);">misurato</b> dai dati che hai inserito sulle PS reali, vs il <b style="color:var(--text1);">parametro</b> attualmente impostato.</div>';
  html += '<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:8px;">';

  function row(label, paramVal, withFuel, kmField, fuelField){
    if(!withFuel.length){
      return '<div style="background:var(--bg3);padding:8px 10px;border-radius:4px;"><div style="font-size:9px;color:var(--text3);letter-spacing:1px;">'+label+'</div><div style="font-size:11px;color:var(--text3);">— dati insufficienti —</div></div>';
    }
    var totKm = withFuel.reduce(function(a,s){return a+(+s[kmField]||0);}, 0);
    var totFuel = withFuel.reduce(function(a,s){return a+(+s[fuelField]||0);}, 0);
    var measured = totKm > 0 ? totFuel/totKm : 0;
    var pct = paramVal > 0 ? ((measured-paramVal)/paramVal*100) : 0;
    var col = Math.abs(pct) < 10 ? 'var(--green)' : Math.abs(pct) < 25 ? 'var(--yellow)' : 'var(--red)';
    var badge = pct >= 0 ? '+'+pct.toFixed(0)+'%' : pct.toFixed(0)+'%';
    var btnLabel = label.toLowerCase().includes('ss') ? 'ss' : 'tf';
    return '<div style="background:var(--bg3);padding:8px 10px;border-radius:4px;border-left:3px solid '+col+';">'+
      '<div style="font-size:9px;color:var(--text3);letter-spacing:1px;margin-bottom:2px;">'+label+'</div>'+
      '<div style="font-family:var(--mono);font-size:14px;color:var(--text1);font-weight:700;">'+measured.toFixed(3)+' L/km <span style="font-size:10px;color:'+col+';">('+badge+')</span></div>'+
      '<div style="font-size:10px;color:var(--text3);margin:2px 0 5px 0;">Su '+withFuel.length+' PS · '+totKm.toFixed(1)+'km · '+totFuel.toFixed(1)+'L</div>'+
      '<button class="btn btn-blue" style="font-size:10px;padding:3px 8px;" onclick="adoptRealConsumption(\''+btnLabel+'\')" title="Sostituisci il parametro col valore misurato">↻ Adotta '+measured.toFixed(3)+'</button>'+
    '</div>';
  }
  html += row('CONSUMO SS MISURATO', rf.consSS, withFuelSS, 'km', 'fuelSS');
  html += row('CONSUMO TF MISURATO', rf.consTF, withFuelTF, 'tfKm', 'fuelTF');
  html += '</div>';
  el.innerHTML = html;
}
window.buildRallyFuelInsight = buildRallyFuelInsight;

function adoptRealConsumption(which){
  var car = STATE.rallyCars[STATE.selectedRallyCar];
  if(!car || !STATE.rallyFuel || !STATE.rallyFuel[car.id]) return;
  var rf = STATE.rallyFuel[car.id];
  var stages = STATE.stages.filter(function(s){return s.car===car.name && !s.cancelled;});
  if(which === 'ss'){
    var withSS = stages.filter(function(s){return (+s.km||0) > 0 && (+s.fuelSS||0) > 0;});
    if(!withSS.length) return;
    var totKm = withSS.reduce(function(a,s){return a+(+s.km||0);}, 0);
    var totFuel = withSS.reduce(function(a,s){return a+(+s.fuelSS||0);}, 0);
    rf.consSS = totKm > 0 ? totFuel/totKm : rf.consSS;
    document.getElementById('rally-cons-ss').value = rf.consSS.toFixed(3);
    showToast('↻ Consumo SS aggiornato a '+rf.consSS.toFixed(3)+' L/km');
  } else if(which === 'tf'){
    var withTF = stages.filter(function(s){return (+s.tfKm||0) > 0 && (+s.fuelTF||0) > 0;});
    if(!withTF.length) return;
    var totKm = withTF.reduce(function(a,s){return a+(+s.tfKm||0);}, 0);
    var totFuel = withTF.reduce(function(a,s){return a+(+s.fuelTF||0);}, 0);
    rf.consTF = totKm > 0 ? totFuel/totKm : rf.consTF;
    document.getElementById('rally-cons-tf').value = rf.consTF.toFixed(3);
    showToast('↻ Consumo TF aggiornato a '+rf.consTF.toFixed(3)+' L/km');
  }
  triggerAutoSave();
  buildRallyFuelUI();
}
window.adoptRealConsumption = adoptRealConsumption;

function buildRallyFuelForecast(rf) {
  const el = document.getElementById('rfuel-forecast-list');
  if(!el) return;
  const totalStages = STATE.rallyNumStages || 10;
  const car = STATE.rallyCars[STATE.selectedRallyCar];
  const doneStages = STATE.stages.filter(s=>s.car===car.name).length;
  const remaining = totalStages - doneStages;
  if(remaining<=0) { el.innerHTML='<div class="small" style="color:var(--green)">Tutte le PS completate!</div>'; return; }
  const avgKmSS = doneStages>0 ? STATE.stages.filter(s=>s.car===car.name).reduce((a,s)=>a+(+s.km||0),0)/doneStages : 15;
  const avgKmTF = doneStages>0 ? STATE.stages.filter(s=>s.car===car.name).reduce((a,s)=>a+(+s.tfKm||0),0)/doneStages : 20;
  const fuelNeeded = remaining * (avgKmSS*rf.consSS + avgKmTF*rf.consTF);
  const ok = rf.current >= fuelNeeded;
  el.innerHTML = `<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
    <div class="tile"><div class="tile-label">PS RIMANENTI</div><div class="tile-value" style="color:var(--accent3);">${remaining}</div></div>
    <div class="tile"><div class="tile-label">FABBISOGNO STIMATO</div><div class="tile-value" style="color:var(--blue);">${fuelNeeded.toFixed(1)}L</div></div>
    <div class="tile ${ok?'tile-good':'tile-bad'}"><div class="tile-label">STATO</div><div class="tile-value" style="font-size:14px;">${ok?'✅ OK':'⚠️ CORTO'}</div></div>
  </div>`;
}

