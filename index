var _driverNotes = {};
function buildDriverNotesPage() {
  var cars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;
  var selIdx = STATE.mode==='track' ? STATE.selectedTrackCar : STATE.selectedRallyCar;
  var tabsEl = document.getElementById('driver-notes-car-tabs');
  if(tabsEl) {
    tabsEl.innerHTML = cars.map(function(c,i) {
      return '<button class="car-tab car-dyn '+(i===selIdx?'active':'')+'" onclick="'+(STATE.mode==='track'?'STATE.selectedTrackCar':'STATE.selectedRallyCar')+'='+i+';buildDriverNotesPage()">'+c.name+'</button>';
    }).join('');
  }
  var car = cars[selIdx];
  if(!car) return;
  if(!_driverNotes[car.id]) _driverNotes[car.id]=[];
  renderDriverNotes(car.id);
  buildDriverNotesChart(car.id);
  var lapEl = document.getElementById('dn-lap');
  if(lapEl && STATE.laps[car.id]) lapEl.value = (STATE.laps[car.id].length||0)+1;
}
function saveDriverNote() {
  var cars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;
  var car = cars[STATE.mode==='track' ? STATE.selectedTrackCar : STATE.selectedRallyCar];
  if(!_driverNotes[car.id]) _driverNotes[car.id]=[];
  var note = (document.getElementById('dn-note')||{}).value;
  if(!note||!note.trim()) { showToast('Scrivi una nota prima di salvare'); return; }
  var entry = {
    id: Date.now(),
    lap: +(document.getElementById('dn-lap')||{}).value||1,
    point: (document.getElementById('dn-point')||{}).value||'',
    cat: (document.getElementById('dn-cat')||{}).value||'general',
    intensity: (document.getElementById('dn-intensity')||{}).value||'medium',
    note: note.trim(),
    response: (document.getElementById('dn-response')||{}).value||'',
    timestamp: new Date().toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit'})
  };
  var snap = JSON.parse(JSON.stringify(_driverNotes[car.id]));
  pushUndo('Nota pilota G'+entry.lap, function(){_driverNotes[car.id]=snap; renderDriverNotes(car.id); buildDriverNotesChart(car.id);});
  _driverNotes[car.id].unshift(entry);
  if(document.getElementById('dn-note')) document.getElementById('dn-note').value='';
  if(document.getElementById('dn-response')) document.getElementById('dn-response').value='';
  renderDriverNotes(car.id); buildDriverNotesChart(car.id); triggerAutoSave();
  showToast('Nota pilota salvata');
}
function renderDriverNotes(carId) {
  var el = document.getElementById('driver-notes-summary'); if(!el) return;
  var notes = _driverNotes[carId]||[];
  var catL = {understeer:'Sottosterzo',oversteer:'Sovrasterzo',braking:'Bloccaggio',traction:'Trazione',balance:'Bilanciamento',vibration:'Vibrazioni',noise:'Rumore',positive:'Positivo',general:'Generale'};
  var intC = {light:'var(--green)',medium:'var(--accent3)',heavy:'var(--yellow)',critical:'var(--red)'};
  if(!notes.length) { el.innerHTML='<div style="color:var(--text3);font-size:12px;padding:10px;">Nessuna nota pilota</div>'; return; }
  el.innerHTML = notes.map(function(n,i) {
    var col = intC[n.intensity]||'var(--accent2)';
    var html = '<div class="note-item" style="border-left-color:'+col+';margin-bottom:8px;">';
    html += '<div style="display:flex;align-items:center;justify-content:space-between;">';
    html += '<span style="font-family:var(--head);font-size:11px;color:'+col+';letter-spacing:1px;">'+(catL[n.cat]||n.cat)+' &middot; G'+n.lap+(n.point?' &middot; '+n.point:'')+'</span>';
    html += '<button onclick="_driverNotes[\''+carId+'\'].splice('+i+',1);renderDriverNotes(\''+carId+'\');buildDriverNotesChart(\''+carId+'\')" style="background:none;border:none;color:var(--text3);cursor:pointer;">&#10005;</button>';
    html += '</div>';
    html += '<div style="font-size:12px;color:var(--text1);margin-top:4px;">'+n.note+'</div>';
    if(n.response) html += '<div style="font-size:11px;color:var(--blue);margin-top:3px;border-left:2px solid var(--blue);padding-left:6px;">'+n.response+'</div>';
    html += '<div class="note-meta">'+n.timestamp+'</div></div>';
    return html;
  }).join('');
}
function buildDriverNotesChart(carId) {
  var el = document.getElementById('driver-notes-chart'); if(!el||!window.Plotly) return;
  var notes = _driverNotes[carId]||[];
  var catL = {understeer:'Sottosterzo',oversteer:'Sovrasterzo',braking:'Bloccaggio',traction:'Trazione',balance:'Bilanciamento',vibration:'Vibrazioni',noise:'Rumore',positive:'Positivo',general:'Generale'};
  var counts = {};
  notes.forEach(function(n){ counts[n.cat]=(counts[n.cat]||0)+1; });
  if(!Object.keys(counts).length) { if(Plotly.purge) Plotly.purge(el); return; }
  var labels = Object.keys(counts).map(function(k){return catL[k]||k;});
  var values = Object.values(counts);
  var colors = ['#e8421a','#2b7de9','#2cbc6e','#8b5cf6','#f5c518','#1aada0','#e03030','#ffa040','#6b7280'];
  var trace = {type:'pie',labels:labels,values:values,marker:{colors:colors},textfont:{color:'#a8afc0',size:11},hole:0.35};
  var layout = {margin:{l:20,r:20,t:10,b:20},paper_bgcolor:'transparent',plot_bgcolor:'transparent',font:{color:'#a8afc0'},legend:{font:{color:'#a8afc0'},bgcolor:'rgba(0,0,0,0)',orientation:'h'}};
  Plotly.newPlot(el,[trace],layout,{responsive:true,displayModeBar:false});
}

