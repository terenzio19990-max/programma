/* ---- Tempo obiettivo: motore di consigli --------------------------
   Ricerca greedy sul modello fisico: prova modifiche plausibili una
   alla volta, tiene la migliore (Delta t piu' negativo, penalizzando
   bilanci pericolosi), ripete fino a 6 mosse. I guadagni non sono
   perfettamente additivi: il totale finale e' ricalcolato in un colpo. */
var SA_TGTKEY = 'REP_sa_target_v1';
function saGetTarget(carId){
  try { return (JSON.parse(localStorage.getItem(SA_TGTKEY)||'{}'))[carId]||''; } catch(e){ return ''; }
}
function saSetTarget(carId, v){
  try { var o=JSON.parse(localStorage.getItem(SA_TGTKEY)||'{}'); o[carId]=v; localStorage.setItem(SA_TGTKEY, JSON.stringify(o)); } catch(e){}
}

function saCtx(mode){
  var car = saCar(mode);
  var pm = saPMode(mode);
  var p = (pm==='generic' || pm==='off')? saDefaultsFor(car.type) : saGetParams(car.type);
  var surfKey = saSurfKey(mode);
  var surf = SA_SURFACES[surfKey];
  var prRaw = saGetProfile(saProfKey(mode, surfKey));
  var sum = (+prRaw.fStraight)+(+prRaw.fFast)+(+prRaw.fMid)+(+prRaw.fSlow)+(+prRaw.fBrake);
  if(!(sum>0)) sum=100;
  var refMs = saRefTime(mode, car);
  var lapSec = (+prRaw.lapSecOverride>0)? +prRaw.lapSecOverride : (refMs? refMs/1000 : 100);
  var prof = { fStraight:prRaw.fStraight/sum, fFast:prRaw.fFast/sum, fMid:prRaw.fMid/sum,
    fSlow:prRaw.fSlow/sum, fBrake:prRaw.fBrake/sum, bumpy:+prRaw.bumpy, lapSec:lapSec,
    biasRefPct: (+prRaw.biasRefPct>0)? +prRaw.biasRefPct : null };
  var cur = saReadFields(mode);
  var p2 = Object.assign({}, p);
  p2.biasRefForPhase = (typeof prRaw!=='undefined' && +prRaw.biasRefPct>0)? +prRaw.biasRefPct : null;
  if(mode==='rally' && cur.rideF!==null && cur.rideR!==null){
    p2.h = p.h + (((cur.rideF+cur.rideR)/2) - 145)/1000;
  }
  // densita' aria dal meteo
  window.SA_RHO = saAirDensity();
  // carburante a bordo -> massa e altezza CG
  var fuelL=null;
  try {
    var fu = mode==='rally'? (STATE.rallyFuel||{})[car.id] : (STATE.fuel||{})[car.id];
    if(fu && isFinite(+fu.current) && +fu.current>0) fuelL=+fu.current;
  } catch(e){}
  if(fuelL!==null && p2.useFuelMass!==0){
    var mf=(p2.fuelDens||0.75)*fuelL;
    p2.h=(p2.h*p2.m+(p2.fuelTankH||0.35)*mf)/(p2.m+mf);
    p2.m=p2.m+mf;
  }
  // superficie effettiva: µ scalato dalla taratura aderenza gomma (⚙ muGrip)
  var surf2=Object.assign({},surf);
  var mg=(p2.muGrip&&p2.muGrip>0.3)? p2.muGrip : 1;
  surf2.mu0=surf.mu0*mg;
  surf2.muB=surf.muB*mg;
  // ottimi camber dai rilievi gomme (se presenti)
  var tv=saTyreVerdicts(mode,car,cur);
  if(tv && (tv.camOptF!==null||tv.camOptR!==null)){
    if(tv.camOptF!==null) surf2.camOptF=Math.round(tv.camOptF*10)/10;
    if(tv.camOptR!==null) surf2.camOptR=Math.round(tv.camOptR*10)/10;
  }
  var cal=saCalGet(saCalKey(mode,car.type));
  return { car:car, p:p2, surf:surf2, prof:prof, refMs:refMs, cur:cur, fuelL:fuelL, cal:cal, tyres:tv, pmodeGeneric:(pm==='generic') };
}

function saMoves(S, p, surf, prof){
  var mv=[];
  function C(o){ return Object.assign({}, S, o); }
  function n(x,d){ return x===null||x===undefined? d : x; }
  var wR=n(S.wingR,0), wF=n(S.wingF,0), sp=n(S.splitter,0);
  if(wR>0) mv.push({lab:'Ala post. '+wR+' → '+(wR-1), s:C({wingR:wR-1}), conf:'●', grp:'wingR'});
  mv.push({lab:'Ala post. '+wR+' → '+(wR+1), s:C({wingR:wR+1}), conf:'●', grp:'wingR'});
  if(wF>0) mv.push({lab:'Ala ant. '+wF+' → '+(wF-1), s:C({wingF:wF-1}), conf:'●', grp:'wingF'});
  mv.push({lab:'Ala ant. '+wF+' → '+(wF+1), s:C({wingF:wF+1}), conf:'●', grp:'wingF'});
  mv.push(sp>0? {lab:'Splitter OFF', s:C({splitter:0}), conf:'◐', grp:'split'} :
                {lab:'Splitter ON', s:C({splitter:1}), conf:'◐', grp:'split'});
  var sf=n(S.springF,p.defSpringF), sr=n(S.springR,p.defSpringR);
  var sfd=Math.round(sf*0.9), sfu=Math.round(sf*1.1), srd=Math.round(sr*0.9), sru=Math.round(sr*1.1);
  mv.push({lab:'Molla ant. '+Math.round(sf)+' → '+sfd+' N/mm', s:C({springF:sfd}), conf:'●', grp:'sprF'});
  mv.push({lab:'Molla ant. '+Math.round(sf)+' → '+sfu+' N/mm', s:C({springF:sfu}), conf:'●', grp:'sprF'});
  mv.push({lab:'Molla post. '+Math.round(sr)+' → '+srd+' N/mm', s:C({springR:srd}), conf:'●', grp:'sprR'});
  mv.push({lab:'Molla post. '+Math.round(sr)+' → '+sru+' N/mm', s:C({springR:sru}), conf:'●', grp:'sprR'});
  function barMoves(raw, key, name){
    var bn = saNum(raw);
    if(bn===null) return;
    if(saIsBarDiameter(raw)){
      if(bn>14) mv.push({lab:'Barra '+name+' ∅'+bn+' → ∅'+(bn-1)+'mm', s:C(key==='f'?{barFraw:(bn-1)+'mm'}:{barRraw:(bn-1)+'mm'}), conf:'●', grp:'bar'+key});
      mv.push({lab:'Barra '+name+' ∅'+bn+' → ∅'+(bn+1)+'mm', s:C(key==='f'?{barFraw:(bn+1)+'mm'}:{barRraw:(bn+1)+'mm'}), conf:'●', grp:'bar'+key});
    } else {
      if(bn>0) mv.push({lab:'Barra '+name+' '+bn+' → '+(bn-1), s:C(key==='f'?{barFraw:String(bn-1)}:{barRraw:String(bn-1)}), conf:'●', grp:'bar'+key});
      mv.push({lab:'Barra '+name+' '+bn+' → '+(bn+1), s:C(key==='f'?{barFraw:String(bn+1)}:{barRraw:String(bn+1)}), conf:'●', grp:'bar'+key});
    }
  }
  barMoves(S.barFraw,'f','ant.'); barMoves(S.barRraw,'r','post.');
  if(S.camberF!==null && Math.abs(S.camberF-surf.camOptF)>0.25){
    var cf = S.camberF + Math.sign(surf.camOptF-S.camberF)*Math.min(0.5, Math.abs(surf.camOptF-S.camberF));
    mv.push({lab:'Camber ant. '+S.camberF.toFixed(1)+'° → '+cf.toFixed(1)+'° (verso ottimo '+surf.camOptF+'°)', s:C({camberF:cf}), conf:'◐', grp:'camF'});
  }
  if(S.camberR!==null && Math.abs(S.camberR-surf.camOptR)>0.25){
    var cr = S.camberR + Math.sign(surf.camOptR-S.camberR)*Math.min(0.5, Math.abs(surf.camOptR-S.camberR));
    mv.push({lab:'Camber post. '+S.camberR.toFixed(1)+'° → '+cr.toFixed(1)+'° (verso ottimo '+surf.camOptR+'°)', s:C({camberR:cr}), conf:'◐', grp:'camR'});
  }
  if(S.toeF!==null){
    if(S.toeF>-0.2) mv.push({lab:'Toe ant. '+S.toeF.toFixed(2)+' → '+(S.toeF-0.05).toFixed(2)+' (apertura: +inserimento)', s:C({toeF:S.toeF-0.05}), conf:'◐', grp:'toeF'});
    if(S.toeF<0.2) mv.push({lab:'Toe ant. '+S.toeF.toFixed(2)+' → '+(S.toeF+0.05).toFixed(2), s:C({toeF:S.toeF+0.05}), conf:'◐', grp:'toeF'});
  }
  if(S.toeR!==null && S.toeR<0.05){
    mv.push({lab:'Toe post. '+S.toeR.toFixed(2)+' → 0.10 (chiusura: stabilità)', s:C({toeR:0.10}), conf:'◐', grp:'toeR'});
  }
  if(S.brakeBias!==null && prof.biasRefPct){
    var bb = S.brakeBias>1? S.brakeBias : S.brakeBias*100;
    var dir = prof.biasRefPct>bb? 1 : -1;
    if(Math.abs(prof.biasRefPct-bb)>=0.5) mv.push({lab:'Bias freni '+bb+'% → '+(bb+dir)+'% (verso riferimento '+prof.biasRefPct+'%)', s:C({brakeBias:bb+dir}), conf:'◐', grp:'bias'});
  }
  // differenziale (solo asse motrice, se almeno un campo LSD e' compilato)
  var fr = p.drive==='RWD'? 'R':'F';
  var preK='diffPre'+fr, raK='diffRampAcc'+fr;
  if(S[preK]!==null || S[raK]!==null){
    var pre0=S[preK]!==null? S[preK] : 50;
    if(pre0>=20){ var o1={}; o1[preK]=pre0-20; mv.push({lab:'Diff: precarico '+pre0+' → '+(pre0-20)+' Nm', s:C(o1), conf:'◐', grp:'dpre'}); }
    if(pre0<=130){ var o2={}; o2[preK]=pre0+20; mv.push({lab:'Diff: precarico '+pre0+' → '+(pre0+20)+' Nm', s:C(o2), conf:'◐', grp:'dpre'}); }
    var steps=[80,60,45,30];
    var ra0=S[raK]!==null? S[raK] : 60;
    var ri=steps.indexOf(steps.reduce(function(a,b){ return Math.abs(b-ra0)<Math.abs(a-ra0)? b:a; }));
    if(ri>0){ var o3={}; o3[raK]=steps[ri-1]; mv.push({lab:'Diff: rampa accel. '+ra0+'° → '+steps[ri-1]+'° (meno blocco)', s:C(o3), conf:'◐', grp:'dramp'}); }
    if(ri<steps.length-1){ var o4={}; o4[raK]=steps[ri+1]; mv.push({lab:'Diff: rampa accel. '+ra0+'° → '+steps[ri+1]+'° (più blocco)', s:C(o4), conf:'◐', grp:'dramp'}); }
    var rdK='diffRampDec'+fr;
    var rd0=S[rdK]!==null? S[rdK] : 70;
    var rdi=steps.indexOf(steps.reduce(function(a,b){ return Math.abs(b-rd0)<Math.abs(a-rd0)? b:a; }));
    if(rdi>0){ var o5={}; o5[rdK]=steps[rdi-1]; mv.push({lab:'Diff: rampa rilascio '+rd0+'° → '+steps[rdi-1]+'° (ingresso più reattivo)', s:C(o5), conf:'◐', grp:'drdec'}); }
    if(rdi<steps.length-1){ var o6={}; o6[rdK]=steps[rdi+1]; mv.push({lab:'Diff: rampa rilascio '+rd0+'° → '+steps[rdi+1]+'° (ingresso più stabile)', s:C(o6), conf:'◐', grp:'drdec'}); }
  }
  var zs=[S.bumpF,S.bumpR,S.rebF,S.rebR].filter(function(x){return x!==null;});
  if(zs.length===4){
    mv.push({lab:'Ammortizzatori: tutti −2 click (meno smorzati)', s:C({bumpF:Math.max(0,S.bumpF-2),bumpR:Math.max(0,S.bumpR-2),rebF:Math.max(0,S.rebF-2),rebR:Math.max(0,S.rebR-2)}), conf:'○', grp:'damp'});
    mv.push({lab:'Ammortizzatori: tutti +2 click (più smorzati)', s:C({bumpF:S.bumpF+2,bumpR:S.bumpR+2,rebF:S.rebF+2,rebR:S.rebR+2}), conf:'○', grp:'damp'});
  }
  return mv;
}

function saSuggest(cur, p, surf, prof, maxSteps){
  var steps=[], S=cur, usedGrp={};
  for(var k=0;k<(maxSteps||6);k++){
    var A0 = saAnalyze(S, p, surf);
    var best=null;
    saMoves(S, p, surf, prof).forEach(function(m){
      if((usedGrp[m.grp]||0)>=2) return;
      var A1, Cc;
      try { A1 = saAnalyze(m.s, p, surf); Cc = saCompare(A1, A0, p, surf, prof); }
      catch(e){ return; }
      var pen=0;
      Cc.zones.forEach(function(z){ if(z.warn) pen+=0.15; });
      var U0=(Math.abs(A0.bLow.U)+Math.abs(A0.bMid.U)+Math.abs(A0.bHigh.U))/3;
      var U1=(Math.abs(A1.bLow.U)+Math.abs(A1.bMid.U)+Math.abs(A1.bHigh.U))/3;
      if(U1>0.05 && U1>U0) pen+=0.10;
      if(m.s.toeR!==null && m.s.toeR<0) pen+=1;
      var confW = m.conf==='○'? 0.55 : (m.conf==='◐'? 0.8 : 1);
      var score = Cc.total*confW + pen;
      if(score < -0.004 && (!best || score<best.score)) best={ m:m, C:Cc, score:score };
    });
    if(!best) break;
    steps.push({ lab:best.m.lab, dt:best.C.total, conf:best.m.conf,
      dU:(best.C.dU.low+best.C.dU.mid+best.C.dU.high)/3 });
    S = best.m.s;
    usedGrp[best.m.grp] = (usedGrp[best.m.grp]||0)+1;
  }
  var Afin = saAnalyze(S, p, surf);
  var Cfin = saCompare(Afin, saAnalyze(cur, p, surf), p, surf, prof);
  return { steps:steps, total:Cfin.total, unc:Cfin.uncertainty, finalU:(Afin.bLow.U+Afin.bMid.U+Afin.bHigh.U)/3 };
}

