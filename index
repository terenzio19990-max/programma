function addStageTime() {
  // ─── Validation ─────────────────────────────────────────────────
  if(typeof Validate !== 'undefined'){
    var stStr = document.getElementById('stage-time').value;
    var stR = Validate.lapTime(stStr);
    if(!stR.valid){
      showToast('⚠️ Tempo PS non valido: '+stR.msg);
      var el = document.getElementById('stage-time'); if(el) el.focus();
      return;
    }
    var warns = [];
    if(stR.level === 'warn') warns.push(stR.msg);
    var ap = +document.getElementById('stage-abs-pos').value;
    var cp = +document.getElementById('stage-cls-pos').value;
    if(ap === 0 || cp === 0){ showToast('⚠️ Posizione 0 non valida'); return; }
    var km = +document.getElementById('stage-km').value;
    if(km > 0 && km < 1) warns.push('Km PS molto bassi (<1km) — verifica');
    if(km > 60) warns.push('Km PS molto lunghi (>60km) — verifica');
    if(warns.length){
      showToast('⚠️ Salvato con avvisi: ' + warns[0] + (warns.length>1?' (+'+(warns.length-1)+')':''));
    }
  }
  const _ss=JSON.parse(JSON.stringify(STATE.stages));
  pushUndo("PS",()=>{STATE.stages=_ss;if(typeof refreshStages==="function")refreshStages();});
  const entry = {
    num: +document.getElementById('stage-num').value,
    name: document.getElementById('stage-name').value,
    km: +document.getElementById('stage-km').value,
    tfKm: +document.getElementById('transfer-km').value,
    car: (STATE.rallyCars.find(c=>c.id===document.getElementById('stage-car-sel').value)||STATE.rallyCars[STATE.selectedRallyCar]).name,
    time: document.getElementById('stage-time').value,
    absPos: +document.getElementById('stage-abs-pos').value,
    clsPos: +document.getElementById('stage-cls-pos').value,
    fuelSS: +document.getElementById('stage-fuel-ss').value,
    fuelTF: +document.getElementById('stage-fuel-tf').value,
    surface: document.getElementById('stage-surface').value,
    lights: stageLightsOn,
    driverId: ((document.getElementById('stage-driver')||{}).value || '') || (typeof _psCurrentDriverId === 'function' ? _psCurrentDriverId() : ''),
    ts: Date.now()
  };
  STATE.stages.push(entry);
  // Remember user choices for next time
  if(typeof rememberDriverChoice === 'function') rememberDriverChoice(entry.driverId);
  triggerAutoSave();
  // Reset PS# to auto-mode so next call re-computes intelligently
  var psInp = document.getElementById('stage-num');
  if(psInp){ psInp.dataset.userTouched=''; }
  if(typeof updateStageNumAuto === 'function') updateStageNumAuto();
  else if(psInp) psInp.value = entry.num+1;
  document.getElementById('stage-time').value='';
  var stSec = document.getElementById('stage-time-sec'); if(stSec) stSec.value='';
  refreshStages();
  updateRallyTyreKm();
  updateRallyFuelFromStages();
  setTimeout(runAlertChecks, 200);
  // Broadcast to coop peers
  if(typeof coopBroadcastPatch === 'function' && typeof COOP !== 'undefined' && COOP.status !== 'disconnected' && !COOP.applyingRemote){
    coopBroadcastPatch('STATE.stages', 'set', STATE.stages, 'ha registrato PS'+entry.num+' '+entry.time+' su '+entry.car);
  }
}

