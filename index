var BUDGET_CATEGORIES = ['Gomme','Carburante','Ricambi','Trasferte','Iscrizioni','Assicurazioni','Stipendi','Altro'];

function stAddBudgetItem(prefill){
  var s = _stCurrent();
  var item = {
    id: 'bud_'+Date.now()+'_'+Math.floor(Math.random()*999),
    date: (prefill&&prefill.date) || new Date().toISOString().slice(0,10),
    category: (prefill&&prefill.category) || 'Altro',
    description: (prefill&&prefill.description) || '',
