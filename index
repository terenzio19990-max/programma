    setTimeout(scheduleNotifyCheck, 800);
    // Ask for browser notif permission (one time, non-blocking)
    setTimeout(requestNotifPermOnce, 2500);
  }
  // Block 1: theme prefs, spectator, onboarding autostart
  if(typeof loadSavedThemePrefs==='function') loadSavedThemePrefs();
  if(typeof loadSavedSpectator==='function')  loadSavedSpectator();
  if(typeof initCustomModeLabel==='function') initCustomModeLabel();
  if(typeof maybeAutoStartOnboarding==='function') maybeAutoStartOnboarding();
  // Multi-screen: detect #page= hash and switch
  if(typeof applyHashPage==='function') applyHashPage();
  // Flush any iframes that loaded before onBrowserLoad was defined
  document.querySelectorAll('iframe[_pendingBL]').forEach(function(fr) {
    var mode = fr.getAttribute('_pendingBL');
    fr.removeAttribute('_pendingBL');
    if(typeof onBrowserLoad === 'function') onBrowserLoad(mode, fr);
  });
  setTimeout(initPWA, 1500);
  if(typeof Notification!=="undefined") _notifPermission=Notification.permission;
  setTimeout(updateStorageStatus, 2000);
  setInterval(function(){if(typeof autoSaveIDB==="function")autoSaveIDB();},60000);
  // Keyboard hint on first load
    setTimeout(()=>{
    if(typeof pushNotif==='function') pushNotif('info','keyboard','SCORCIATOIE ATTIVE','Premi K per le scorciatoie',{key:'kb_init',cooldown:999999});
  }, 3000);
  // Welcome banner for new users
  setTimeout(function(){
    if(typeof renderWelcomeBanner === 'function') renderWelcomeBanner();
  }, 1000);
})();
