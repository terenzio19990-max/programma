window.lessonsExport = lessonsExport;

function _lsFilteredEntries(){
  _lsLoad();
  var q = (document.getElementById('lessons-search')?.value || '').toLowerCase().trim();
  var impF = document.getElementById('lessons-importance-filter')?.value || '';
  var tagF = document.getElementById('lessons-tag-filter')?.value || '';
  var cirF = document.getElementById('lessons-circuit-filter')?.value || '';
  return _lessons.entries.filter(function(e){
    if(impF && e.importance !== impF) return false;
    if(tagF && !(e.tags||[]).includes(tagF)) return false;
    if(cirF && e.triggerCircuit !== cirF) return false;
    if(q){
      var hay = ((e.situation||'') + ' ' + (e.lesson||'') + ' ' + (e.tags||[]).join(' ')).toLowerCase();
      if(hay.indexOf(q) < 0) return false;
    }
    return true;
  }).sort(function(a,b){
    // Sort: importance desc, then updatedAt desc
    var impOrder = {high:3, medium:2, low:1};
    var diff = (impOrder[b.importance]||2) - (impOrder[a.importance]||2);
    if(diff !== 0) return diff;
    return (b.updatedAt||0) - (a.updatedAt||0);
  });
}

function _lsPopulateFilters(){
  _lsLoad();
  var tagSel = document.getElementById('lessons-tag-filter');
  var cirSel = document.getElementById('lessons-circuit-filter');
  if(tagSel){
    var prev = tagSel.value;
    var allTags = _lessons.entries.reduce(function(acc, e){return acc.concat(e.tags||[]);}, []);
    var uniq = Array.from(new Set(allTags)).sort();
    tagSel.innerHTML = '<option value="">Ogni tag</option>' +
      uniq.map(function(t){return '<option value="'+t+'">#'+t+'</option>';}).join('');
    if(prev) tagSel.value = prev;
  }
  if(cirSel){
    var prevC = cirSel.value;
    var cirs = Array.from(new Set(_lessons.entries.map(function(e){return e.triggerCircuit||'';}).filter(Boolean))).sort();
    cirSel.innerHTML = '<option value="">Ogni circuito</option>' +
      cirs.map(function(c){
        var name = (typeof CIRCUITS !== 'undefined' && CIRCUITS[c] && CIRCUITS[c].name) ? CIRCUITS[c].name : c;
        return '<option value="'+c+'">'+name+'</option>';
      }).join('');
    if(prevC) cirSel.value = prevC;
  }
}

function _lsImportanceLabel(imp){
  if(imp === 'high') return { icon: '🔥', label: 'ALTA', color: 'var(--red)' };
  if(imp === 'low')  return { icon: '💡', label: 'BASSA', color: 'var(--text3)' };
  return { icon: '⚠', label: 'MEDIA', color: 'var(--yellow)' };
}

function _lsRenderSuggestions(){
  var el = document.getElementById('lessons-suggestions');
  if(!el) return;
  _lsLoad();
  var ctx = _lsCurrentContext();
  // No context: hide
  if(!ctx.circuit && !ctx.session && !ctx.weather){
    el.innerHTML = '';
    return;
  }
  var relevant = _lessons.entries.filter(function(e){return _lsIsRelevant(e, ctx);});
  if(!relevant.length){
    el.innerHTML = '';
    return;
  }
  // Sort by importance
  var impOrder = {high:3, medium:2, low:1};
  relevant.sort(function(a,b){return (impOrder[b.importance]||2) - (impOrder[a.importance]||2);});
  var ctxLabel = [];
  if(ctx.circuit){
