/* ═══════════════════════════════════════════
   3. BACKUP AUTOMATICO (ogni 4 min)
═══════════════════════════════════════════ */
// v18.1: backup a 3 slot a rotazione — uno snapshot corrotto non distrugge più i precedenti
var BACKUP_SLOTS = 3;
function _validSnapshot(json){
  if(!json) return null;
  try {
    var d = JSON.parse(json);
    return (d && d.STATE && typeof d.STATE==='object' && d.ts) ? d : null;
  } catch(e){ return null; }
}
function autoBackup() {
  var snap;
  try {
    snap = JSON.stringify({ STATE:window.STATE, ts:Date.now(), v:'v18.1' });
  } catch(e){
    showToast('⚠️ Backup fallito: stato non serializzabile — slot precedenti preservati');
    return;
  }
  if(!_validSnapshot(snap)){
    showToast('⚠️ Backup fallito: snapshot non valido — slot precedenti preservati');
    return;
  }
  try {
    var idx = (parseInt(localStorage.getItem('REP_backup_idx')||'0',10)+1) % BACKUP_SLOTS;
    localStorage.setItem('REP_auto_backup_'+idx, snap);
    localStorage.setItem('REP_backup_idx', String(idx));
    localStorage.setItem('REP_backup_time', new Date().toLocaleTimeString('it-IT'));
    var dot = document.getElementById('backup-dot');
    if(dot){ dot.style.opacity='1'; setTimeout(function(){ dot.style.opacity='.4'; },2000); }
  } catch(e){
    // Tipicamente QuotaExceededError (~5MB): prima falliva in silenzio
    showToast('⚠️ Backup NON salvato: spazio localStorage esaurito. Esporta i dati o libera spazio.');
  }
}
setInterval(autoBackup, 240000);
setTimeout(autoBackup, 8000);

function _latestBackup(){
  var best = null;
  for(var i=0;i<BACKUP_SLOTS;i++){
    var d = _validSnapshot(localStorage.getItem('REP_auto_backup_'+i));
    if(d && (!best || d.ts>best.ts)) best = d;
  }
  // Migrazione: considera anche il vecchio slot singolo pre-v18.1
  var legacy = _validSnapshot(localStorage.getItem('REP_auto_backup'));
  if(legacy && (!best || legacy.ts>best.ts)) best = legacy;
  return best;
}
function restoreAutoBackup() {
  try {
    var data = _latestBackup();
    if(!data){ showToast('Nessun backup valido disponibile'); return; }
    var when = new Date(data.ts).toLocaleString('it-IT');
    if(!confirm('Ripristinare il backup del '+when+'? I dati attuali saranno sovrascritti.')) return;
    // Sostituzione completa: elimina anche le chiavi non presenti nel backup (prima restavano dati stantii)
    Object.keys(window.STATE).forEach(function(k){ if(!(k in data.STATE)) delete window.STATE[k]; });
    Object.assign(window.STATE, data.STATE);
    // Ricostruisce nav, tab vetture e pagina corrente (prima solo dashboard+laps)
    try { if(typeof setMode==='function') setMode(window.STATE.mode||'track'); } catch(_){}
    try { if(typeof rebuildAllCarTabs==='function') rebuildAllCarTabs(); } catch(_){}
    try { if(typeof buildDashboard==='function') buildDashboard(); } catch(_){}
    showToast('✅ Backup ripristinato ('+when+')');
  } catch(e){ showToast('❌ Errore nel ripristino: '+e.message); }
}
window.restoreAutoBackup = restoreAutoBackup;

/* ═══════════════════════════════════════════
   4. PIT STRATEGY SUGGERIMENTO
═══════════════════════════════════════════ */
window.calcPitStrategy = function() {
  var car = STATE.trackCars[STATE.selectedTrackCar];
  if(!car) return;
  var laps = STATE.laps[car.id]||[];
  var fuel = STATE.fuel[car.id];
  var tyres = STATE.tyres[car.id];
  var results = [];

  // Fuel check
  if(fuel && fuel.perLap > 0) {
    var lapsFuel = Math.floor(fuel.current / fuel.perLap);
    var urgency = lapsFuel <= 3 ? 'CRITICO' : lapsFuel <= 8 ? 'CONSIGLIATO' : 'OK';
    var color = lapsFuel <= 3 ? 'var(--red)' : lapsFuel <= 8 ? 'var(--yellow)' : 'var(--green)';
    results.push('<div class="pit-suggest" style="border-color:'+color+';color:'+color+';">⛽ Carburante: ancora <b>~'+lapsFuel+' giri</b> — '+urgency+'</div>');
  }

  // Tyre check
  if(tyres && tyres.current && tyres.current.wheels) {
    var ws = tyres.current.wheels;
    var maxW = Math.max(ws.FL.wear||0, ws.FR.wear||0, ws.RL.wear||0, ws.RR.wear||0);
    var urgencyT = maxW >= 85 ? 'CAMBIO IMMEDIATO' : maxW >= 70 ? 'PIT CONSIGLIATO' : 'GOMME OK';
    var colorT = maxW >= 85 ? 'var(--red)' : maxW >= 70 ? 'var(--yellow)' : 'var(--green)';
    results.push('<div class="pit-suggest" style="border-color:'+colorT+';color:'+colorT+';">🔴 Usura max: <b>'+maxW+'%</b> — '+urgencyT+'</div>');
  }

  // Lap delta trend (is driver slowing down = degradation)
  if(laps.length >= 4) {
    var recent = laps.slice(-4).map(function(l){ return parseTime(l.time)||0; }).filter(Boolean);
    if(recent.length >= 4) {
      var trend = recent[3] - recent[0];
      if(trend > 2000) results.push('<div class="pit-suggest" style="border-color:var(--yellow);color:var(--yellow);">📉 Degradazione: +'+( trend/1000).toFixed(2)+'s negli ultimi 4 giri — considera pit</div>');
    }
  }

  if(!results.length) results.push('<div class="pit-suggest" style="border-color:var(--green);color:var(--green);">✅ Condizioni nella norma — nessun pit urgente</div>');

  var el = document.getElementById('pit-strategy-output');
  if(el) el.innerHTML = results.join('<div style="height:6px"></div>');
  else {
    var toast = results.map(function(r){ return r.replace(/<[^>]+>/g,''); }).join(' | ');
    showToast('🔧 Strategia: '+toast.substring(0,80));
  }
};

/* ═══════════════════════════════════════════
   5. STINT ANALYSIS
═══════════════════════════════════════════ */
window.calcStintAnalysis = function(carId) {
  var laps = STATE.laps[carId||STATE.trackCars[STATE.selectedTrackCar].id]||[];
  if(laps.length < 3) return null;
  var times = laps.map(function(l){ return parseTime(l.time)||0; }).filter(Boolean);
  var best = Math.min.apply(null,times);
  var avg = times.reduce(function(a,b){return a+b;},0)/times.length;
  // Degrade: compare first third vs last third
  var third = Math.floor(times.length/3)||1;
  var firstAvg = times.slice(0,third).reduce(function(a,b){return a+b;},0)/third;
  var lastAvg = times.slice(-third).reduce(function(a,b){return a+b;},0)/third;
  var degradeMs = lastAvg - firstAvg;
  return { best:best, avg:avg, degrade:degradeMs, laps:times.length };
};

/* ═══════════════════════════════════════════
   6. LIVE TIMING ALKAMELSYSTEMS
═══════════════════════════════════════════ */
var LT = { url:'', endpoint:'', interval:null, lastData:null, pollMs:10000 };
var CORS = 'https://api.allorigins.win/get?url=';
var LT_PATHS = ['/feeds/HXXtiming.json','/feeds/timing.json','/feeds/Results.json','/feeds/SessionInfo.json','/feeds/Timing.json','/api/timing','/live/timing.json','/api/session','/feeds/live.json','/api/live/session','/api/session/current','/timing.json','/results.json','/data/timing.json'];

function ltStatus(msg,type){ var el=document.getElementById('lt-status'); if(!el) return; var c={ok:'var(--green)',warn:'var(--yellow)',err:'var(--red)',info:'var(--blue)'}; el.style.color=c[type]||'var(--text3)'; el.innerHTML='<span style="font-family:var(--mono);font-size:10px;color:var(--text3);">'+new Date().toLocaleTimeString('it-IT')+'</span> '+msg; }

async function ltFetch(url) {
  try {
    var r = await fetch(CORS+encodeURIComponent(url),{signal:AbortSignal.timeout(8000)});
    if(!r.ok) return null;
    var j = await r.json();
    if(!j.contents) return null;
    try { return JSON.parse(j.contents); } catch(e){ return {_html: j.contents, _url: url}; }
  } catch(e){ return null; }
}

window.ltConnect = async function(){
  var urlEl=document.getElementById('lt-url'); if(!urlEl) return;
  LT.url=(urlEl.value||'').trim().replace(/\/$/,'');
  if(!LT.url){ ltStatus('⚠️ Inserisci un URL','warn'); return; }
  LT.pollMs=(+document.getElementById('lt-interval')?.value||10)*1000;
  ltStatus('🔍 Ricerca endpoint dati...','info');
  if(LT.interval){ clearInterval(LT.interval); LT.interval=null; }
  // 1. Try JSON endpoints
  for(var ep of LT_PATHS){
    ltStatus('🔍 Provo <code style="font-size:10px;">'+ep+'</code>...','info');
    var d=await ltFetch(LT.url+ep);
    if(d && typeof d==='object' && !d._html){ LT.endpoint=LT.url+ep; ltStatus('✅ Feed JSON trovato: <code style="font-size:10px;">'+ep+'</code>','ok'); ltProcess(d); LT.interval=setInterval(ltPoll,LT.pollMs); return; }
  }
  // 2. Fetch main page — look for embedded JSON data or table data
  ltStatus('🔍 Analisi pagina principale...','info');
  var page=await ltFetch(LT.url);
  if(page){
    var html = page._html || (typeof page==='string'?page:'');
    // 2a. Look for JSON endpoint hints in JS
    var m=html.match(/["'](\/[^"']*(?:timing|results|session|live)[^"']*\.json)["']/i);
    if(m){ var ep2=m[1]; var base=new URL(LT.url).origin; LT.endpoint=base+ep2; var d2=await ltFetch(LT.endpoint); if(d2&&!d2._html){ ltStatus('✅ Auto-rilevato: <code style="font-size:10px;">'+ep2+'</code>','ok'); ltProcess(d2); LT.interval=setInterval(ltPoll,LT.pollMs); return; } }
    // 2b. Look for embedded initial state
    var stateMatch=html.match(/window\.__(?:INITIAL_STATE|data|timing|APP_STATE)__\s*=\s*(\{[\s\S]{10,2000}?\});/);
    if(stateMatch){ try{ var sd=JSON.parse(stateMatch[1]); LT.endpoint=LT.url; ltStatus('✅ Dati embedded rilevati nella pagina','ok'); ltProcess(sd); return; }catch(e){} }
    // 2c. Parse HTML tables
    var tableEntries=ltParseHTMLTable(html);
    if(tableEntries&&tableEntries.length){ LT.lastData={_tableEntries:tableEntries}; ltRender(tableEntries); ltStatus('✅ Tabella HTML rilevata: '+tableEntries.length+' entry. Polling ogni '+LT.pollMs/1000+'s.','ok'); LT.endpoint=LT.url; LT.interval=setInterval(async function(){ var pg=await ltFetch(LT.url); if(pg){var e2=ltParseHTMLTable(pg._html||'');if(e2&&e2.length){LT.lastData={_tableEntries:e2};ltRender(e2);ltStatus('✅ '+e2.length+' entry · '+new Date().toLocaleTimeString('it-IT'),'ok');}}}, LT.pollMs); return; }
  }
  // 3. Fallback: manual paste
  ltStatus('⚠️ Nessun feed automatico trovato. <br><small>Prova ad aprire il timing nel <b>Browser</b> integrato, copia i dati e usa il pulsante <b>Incolla manuale</b> qui sotto.</small>','warn');
  var el=document.getElementById('lt-manual-wrap'); if(el) el.style.display='';
};

window.ltDisconnect = function(){ if(LT.interval){clearInterval(LT.interval);LT.interval=null;} ltStatus('⏹ Disconnesso','info'); };

async function ltPoll(){ if(!LT.endpoint) return; var d=await ltFetch(LT.endpoint); if(d) ltProcess(d); }

function ltParse(d){
  if(!d) return null;
  var arr=d.Competitors||d.Results||d.entries||d.Drivers||d.data||(Array.isArray(d)?d:null);
  if(arr && Array.isArray(arr) && arr.length){
    return arr.map(function(c){
      var ks=Object.keys(c);
      var nk=ks.find(function(k){return /name|driver|pilota|car|kart/i.test(k);})||ks[0];
      var tk=ks.find(function(k){return /lastlap|lasttime|last_lap|last_time/i.test(k);})||ks.find(function(k){return /time|tempo/i.test(k);});
      var bk=ks.find(function(k){return /best|fastest|minlap/i.test(k);});
      var pk=ks.find(function(k){return /^pos|position|rank|class/i.test(k);});
      var lk=ks.find(function(k){return /laps|giri|lap_count/i.test(k);});
      return { pos:pk?c[pk]:'—', name:c[nk]||'—', last:tk?c[tk]:'—', best:bk?c[bk]:'—', gap:c.Gap||c.gap||'—', laps:lk?c[lk]:0, num:c.Number||c.Num||c.number||'' };
    });
  }
  return null;
}

function ltProcess(d){
  LT.lastData=d;
  var entries=ltParse(d);
  if(!entries){ ltStatus('⚠️ Dati ricevuti, formato non standard. <a href="#" onclick="ltShowRaw()" style="color:var(--blue);">Vedi raw ↗</a>','warn'); return; }
  ltRender(entries);
  ltStatus('✅ '+entries.length+' vetture · aggiornato '+new Date().toLocaleTimeString('it-IT'),'ok');
  if(document.getElementById('lt-auto-import')?.checked) ltAutoImport(entries);
  ltLog('📊 Aggiornamento: '+entries.length+' vetture');
}

function ltRender(entries){
  var tbody=document.getElementById('lt-timing-tbody'); if(!tbody) return;
  tbody.innerHTML=entries.map(function(e,i){
    var mine=STATE.trackCars.some(function(c){ return e.name&&c.name&&e.name.toLowerCase().includes(c.name.split(' ')[0].toLowerCase().substring(0,4)); });
    return '<tr class="'+(mine?'lt-mine':'')+'"><td class="mono" style="color:'+(i===0?'var(--green)':i<3?'var(--yellow)':'var(--text2)')+';">'+e.pos+'</td><td>'+e.name+(e.num?' <span class="badge badge-gray">#'+e.num+'</span>':'')+(mine?' <span class="badge badge-red">TUA</span>':'')+'</td><td class="mono">'+e.last+'</td><td class="mono" style="color:var(--green);">'+e.best+'</td><td class="mono">'+e.gap+'</td><td class="mono">'+e.laps+'</td><td><button onclick="ltImportEntry('+i+')" class="btn btn-gray" style="padding:2px 6px;font-size:10px;">&#8595;</button></td></tr>';
  }).join('');
}

window.ltImportEntry = function(idx){
  if(!LT.lastData) return;
  var entries=ltParse(LT.lastData); if(!entries||!entries[idx]) return;
  var e=entries[idx];
  var car=STATE.trackCars[STATE.selectedTrackCar]; if(!car) return;
  var count=0;
  if(e.best&&e.best!=='—'&&parseTime(e.best)){ STATE.laps[car.id].push({lap:STATE.laps[car.id].length+1,time:e.best,session:'LiveTiming',car:car.id,note:'🔴 LT import'}); count++; }
  if(e.pos&&e.pos!=='—'){ STATE.positions[car.id]=STATE.positions[car.id]||{}; STATE.positions[car.id].current=e.pos; }
  if(count&&typeof buildLapsPage==='function') buildLapsPage();
  showToast('✅ Importato per '+car.name+' da live timing');
  ltLog('⬇ Importato: '+e.name+' best='+e.best);
};

function ltAutoImport(entries){
  entries.forEach(function(e){
    STATE.trackCars.forEach(function(car){
      if(!e.name||!car.name) return;
      if(!e.name.toLowerCase().includes(car.name.split(' ')[0].toLowerCase().substring(0,4))) return;
      if(e.pos&&e.pos!=='—'){ STATE.positions[car.id]=STATE.positions[car.id]||{}; STATE.positions[car.id].current=e.pos; }
      if(e.best&&e.best!=='—'&&parseTime(e.best)){
        var bestMs=getBestLapMs(car.id), newMs=parseTime(e.best);
        if(!bestMs||newMs<bestMs){ STATE.laps[car.id].push({lap:STATE.laps[car.id].length+1,time:e.best,session:'LiveTiming',car:car.id,note:'🔴 Auto LT'}); if(typeof buildLapsTable==='function') buildLapsTable(car.id); }
      }
    });
  });
}

window.ltImportAll = function(){
  if(!LT.lastData){ ltStatus('❌ Connettiti prima','err'); return; }
