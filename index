function tsSaveEdit(id){
  var t = TYRE_STOCK.find(function(x){return x.id===id;});
  if(!t) return;
  var oldStatus = t.status;
  var oldCar = t.car;
  t.code = document.getElementById('ts-e-code').value;
  t.brand = document.getElementById('ts-e-brand').value;
  t.compound = document.getElementById('ts-e-compound').value;
  t.position = document.getElementById('ts-e-position').value;
  t.set = document.getElementById('ts-e-set').value;
  t.status = document.getElementById('ts-e-status').value;
  t.car = document.getElementById('ts-e-car').value;
  t.km = +document.getElementById('ts-e-km').value || 0;
  t.laps = +document.getElementById('ts-e-laps').value || 0;
  t.wear = +document.getElementById('ts-e-wear').value || 0;
  t.damage = document.getElementById('ts-e-damage').value;
  t.notes = document.getElementById('ts-e-notes').value;
  // Log change in history
  if(!t.history) t.history = [];
  if(oldStatus !== t.status || oldCar !== t.car){
    var carName = '';
    if(t.car){
      var c = [].concat(STATE.trackCars||[], STATE.rallyCars||[]).find(function(c){return c.id===t.car;});
      carName = c ? c.name : '';
    }
    t.history.push({
      date: Date.now(),
      action: 'modifica manuale (stato: '+oldStatus+' → '+t.status+')',
      car: carName, km: t.km, wear: t.wear, note: 'aggiornamento manuale'
    });
  }
  tsSave();
  document.getElementById('ts-edit-modal').style.display='none';
  buildTyreStockPage();
  showToast('✓ Gomma aggiornata');
}

function tsDismissTyre(id){
  var t = TYRE_STOCK.find(function(x){return x.id===id;});
  if(!t) return;
  if(t.status === 'mounted'){ alert('Smonta prima la gomma dalla vettura.'); return; }
  if(!confirm('Segnare come DISMESSA (fine vita)? Rimarrà nello storico ma non più utilizzabile.')) return;
  t.status = 'dismissed';
  t.dismissedAt = Date.now();
  if(!t.history) t.history = [];
  t.history.push({ date: Date.now(), action: 'dismessa (fine vita)', wear: t.wear });
  tsSave();
  document.getElementById('ts-edit-modal').style.display='none';
  buildTyreStockPage();
}

