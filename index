// Opens a file picker (with camera capability on mobile) and saves the chosen image.
function photoCapture(category, carId, label){
  var inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = 'image/*';
  // Setting capture as attribute (not just property) for max compatibility:
  // - iOS Safari respects 'capture=environment' to prefer rear camera
  // - Android Chrome: same, opens camera app directly
  // - Desktop: capture attribute is ignored, falls back to standard file picker
  inp.setAttribute('capture', 'environment');
  // Also set as property (some older browsers prefer this)
  try { inp.capture = 'environment'; } catch(_){}
  inp.style.display = 'none';
  // Append to body — some browsers (notably iOS Safari) need the input to be in DOM
  // for click() to actually open the camera/picker.
  document.body.appendChild(inp);
  inp.onchange = async function(ev){
    var f = ev.target.files && ev.target.files[0];
    // Always cleanup the input element
    setTimeout(function(){ try { document.body.removeChild(inp); } catch(_){} }, 100);
    if(!f) return;
    try {
      showToast('📷 Compressione foto...');
      var rec = await photoSave({ category:category, carId:carId, label:label||'', file:f });
      showToast('✅ Foto salvata ('+rec.sizeKB+' KB, da '+rec.originalSizeKB+' KB)');
      // Refresh whichever gallery is currently visible
      if(typeof renderPhotoGallery === 'function') renderPhotoGallery(category, carId);
    } catch(e){ showToast('❌ Errore foto: '+e.message); }
  };
  // Cancel handler — if user cancels, also clean up
  inp.oncancel = function(){
    setTimeout(function(){ try { document.body.removeChild(inp); } catch(_){} }, 100);
  };
  inp.click();
}
window.photoCapture = photoCapture;

