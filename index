function saWarnings(A, C, p, surf, cur){
  var w = [];
  if(A.rollGrad>3.5) w.push('Gradiente di rollio elevato ('+fmt(A.rollGrad,1)+'°/g): perdita di camber dinamico sull’anteriore esterno (Smith cap.4). Valuta più barra o molle.');
  if(cur.toeR!==null && cur.toeR<0) w.push('Toe-out posteriore: instabilità in trazione e in rettilineo — da evitare (Smith cap.11: "Rear toe-out - any: power oversteer").');
  var fr=(A.rideFreqF+A.rideFreqR)/2;
  if(fr>surf.rideOptHi+0.4) w.push('Frequenze di ride alte ('+fmt(fr,2)+' Hz) per questa superficie: la gomma perde contatto sullo sconnesso (Seward cap.4).');
  if(fr<surf.rideOptLo-0.3) w.push('Frequenze di ride basse ('+fmt(fr,2)+' Hz): rischio fondo corsa/rollio eccessivo.');
  if(A.zetaAvg!==null){
    if(A.zetaAvg>0.95) w.push('Smorzamento medio molto alto (ζ='+fmt(A.zetaAvg,2)+'): ruote che "saltellano", gomma scaldata a strappi (ottimo ≈ '+surf.zetaOpt+', Seward Es.4.4).');
    if(A.zetaAvg<0.45) w.push('Smorzamento medio basso (ζ='+fmt(A.zetaAvg,2)+'): cassa che galleggia, risposta lenta (Smith cap.7).');
  }
  if(A.aeroBalF!==null && (A.ClAf+A.ClAr)>0.5){
    var mism = (A.aeroBalF - p.wf)*100;
    if(Math.abs(mism)>12) w.push('Bilancio aero ('+fmt(A.aeroBalF*100,0)+'% ant.) molto diverso dalla distribuzione pesi ('+fmt(p.wf*100,0)+'%): comportamento incoerente fra bassa e alta velocità (Seward 11.3.7).');
  }
  if(A.rideFreqR < A.rideFreqF) w.push('Frequenza posteriore ('+fmt(A.rideFreqR,2)+' Hz) inferiore all’anteriore ('+fmt(A.rideFreqF,2)+' Hz): beccheggio non smorzato sullo sconnesso ("flat ride", Smith cap.6).');
  if(A.camDynF!==null && A.camDynF>-0.2) w.push('Camber dinamico anteriore ~'+A.camDynF.toFixed(1)+'° in percorrenza (il rollio mangia il negativo statico): ruota esterna piatta/positiva → più barra/molle o più camber statico (Seward cap.4).');
  if(A.camDynR!==null && A.camDynR>0.2) w.push('Camber dinamico posteriore positivo in percorrenza: trazione e stabilità ne soffrono.');
  if(A._hasLsd){
    if(A.lockCoast>1.1) w.push('Molto blocco in RILASCIO (rampa stretta/precarico alto): ingresso curva stabile ma pigro — la vettura non ruota (tipico sottosterzo di rilascio).');
    if(A.lockAcc>1.3 && p.drive!=='RWD') w.push('Molto blocco in ACCELERAZIONE su avantreno: trazione forte ma spinta/sottosterzo in uscita curva e sterzo che si irrigidisce sul gas.');
    if(A.lockAcc>1.3 && p.drive==='RWD') w.push('Molto blocco in ACCELERAZIONE al posteriore: attenzione al sovrasterzo di potenza in uscita.');
    if(A.lockC>1.3) w.push('Diff CENTRALE molto bloccato: trasmissione che "avvolge" nei tornanti stretti, sterzo pesante e sottosterzo sul gas.');
  }
  if(A.gear && p.vmaxDecl>0){
    var diffPct = (A.vmax*3.6 - p.vmaxDecl)/p.vmaxDecl*100;
    if(Math.abs(diffPct)>4) w.push('Vmax modello ('+fmt(A.vmax*3.6,0)+' km/h) diversa dalla dichiarata ('+fmt(p.vmaxDecl,0)+'): calibra CdA, potenza o rapporti nei PARAMETRI.');
  }
  if(A.gear && A.limiter==='potenza' && A.gear.vTop*3.6 > A.vmaxPower*3.6*1.12) w.push('Ultima marcia molto lunga: Vmax rapporti '+fmt(A.gear.vTop*3.6,0)+' km/h vs '+fmt(A.vmaxPower*3.6,0)+' raggiungibili — non arriverai mai al limitatore (rapporto sprecato).');
  if(C){
    C.zones.forEach(function(z){ if(z.warn) w.push(z.warn); });
    if(Math.abs(C.transient.entry)>0.05){
      w.push('Transitorio INGRESSO curva: '+(C.transient.entry>0?'più puntato/nervoso (verso sovrasterzo)':'più stabile/sottosterzante')+' per effetto ammortizzatori (Smith p.77; non tocca il bilancio a regime — Seward 11.3.8).');
    }
    if(Math.abs(C.transient.exit)>0.05){
      w.push('Transitorio USCITA curva: '+(C.transient.exit>0?'più sovrasterzo in trazione':'più trazione/stabilità')+' per effetto ammortizzatori.');
    }
  }
  return w;
}

