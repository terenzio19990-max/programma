/* ═══ BOX (PC): ricezione ═══ */
/* Il CODICE SQUADRA e' persistente: riattivando la ricezione (o dopo un
   crash/ricaricamento del PC) si riusa lo stesso codice, cosi' i telefoni
   gia' collegati riagganciano da soli. "🔄 NUOVO" lo rigenera apposta. */
function teamCode(fresh){
  var c=null;
  try { c=localStorage.getItem('REP_team_code'); } catch(e){}
  if(fresh || !c || !/^[A-Z2-9]{6}$/.test(c)){
    c=shortCode();
    try { localStorage.setItem('REP_team_code',c); } catch(e){}
  }
  return c;
}
window.repNewCode=function(){
  var c=teamCode(true);
  setT('rep-live-code',c);
  toast('🔄 Nuovo codice: '+c+' — aggiornalo sui telefoni');
  if(LIVE.hostOn) rebuildConns();
};
function teardownConns(){
  LIVE.hostConns.forEach(function(c){ try{c.close();}catch(e){} });
  try { if(LIVE.hostPeer) LIVE.hostPeer.destroy(); } catch(e){}
  LIVE.hostPeer=null; LIVE.hostConns=[];
  LIVE.mqs.forEach(function(c){ try{c.end(true);}catch(e){} });
  LIVE.mqs=[]; LIVE.viaMq=false;
  clearInterval(LIVE.ackTimer); LIVE.ackTimer=null;
  Object.keys(LIVE.calls||{}).forEach(function(n){ try{ LIVE.calls[n].close(); }catch(e){} });
  LIVE.calls={};
}
function setupPeer(code){
  repIce(function(ice){
    try { LIVE.hostPeer=new Peer('reptel-'+code.toLowerCase(), ice? {debug:0, config:ice} : {debug:0}); }
    catch(e){ setT('rep-live-hstat','Errore: '+e.message); return; }
    LIVE.hostPeer.on('open', function(){
      LIVE.peerRetries=0;
      setT('rep-live-code',code);
      if(!Object.keys(LIVE.cars).length)
        setT('rep-live-hstat','In attesa dei telefoni… stesso codice per tutta la squadra: ogni telefono imposta il NOME AUTO, CONNETTI, poi START.');
      var b=el('rep-live-hbtn'); if(b){ b.textContent='⏹ STOP RICEZIONE'; }
      var cd=el('rep-live-codebox'); if(cd) cd.style.display='block';
    });
    LIVE.hostPeer.on('call', function(call){
      var nm=(call.metadata&&call.metadata.c)||'AUTO ?';
      try { call.answer(); } catch(e){ return; }
      call.on('stream', function(stream){ videoAdd(nm, stream, call); });
      call.on('close', function(){ videoHold(nm); });
      call.on('error', function(){ videoHold(nm); });
    });
    LIVE.hostPeer.on('connection', function(conn){
      LIVE.hostConns.push(conn);
      conn.on('open', function(){ setT('rep-live-hstat','📡 Telefono collegato — in attesa di dati (START sul telefono)'); gPlot(); });
      conn.on('data', onBoxData);
      conn.on('close', function(){ finishAll(false); });
      conn.on('error', function(){});
    });
    LIVE.hostPeer.on('error', function(err){
      if(err.type==='unavailable-id'){
        /* il vecchio collegamento occupa ancora l'id sul broker: si libera
           da solo in pochi secondi. Ritenta lo STESSO codice (il relay MQTT
           intanto riceve gia'). */
        LIVE.peerRetries=(LIVE.peerRetries||0)+1;
        if(LIVE.peerRetries<=10){
          setT('rep-live-hstat','Codice occupato dal vecchio collegamento: riprovo ('+LIVE.peerRetries+'/10)… il relay è già attivo.');
          setTimeout(function(){ if(LIVE.hostOn) setupPeer(code); }, (window._REP_RETRY_MS||4000));
        }
      } else setT('rep-live-hstat','Errore: '+errMsg(err.type||err.message));
    });
    LIVE.hostPeer.on('disconnected', function(){ try { LIVE.hostPeer.reconnect(); } catch(e){} });
  });
}
function connectAll(code){
  setupPeer(code);
  mqBoxStart(code);
  /* BATTITO: ogni 5 s un piccolo "ack" su tutti i canali. Serve ai
     telefoni per capire se il collegamento e' vivo davvero: un canale
     puo' morire senza dare alcun errore (cambio rete, hotspot caduto). */
  clearInterval(LIVE.ackTimer);
  LIVE.ackTimer=setInterval(function(){
    var m={k:'ack',t:Date.now()}, sj=JSON.stringify(m);
    LIVE.hostConns.forEach(function(c){ try { if(c.open!==false) c.send(m); } catch(e){} });
    LIVE.mqs.forEach(function(c){ try { c.publish('reptel/'+code.toLowerCase()+'/cmd', sj); } catch(e){} });
  },(window._REP_ACK_TX||5000));
}
var CMD_LABEL={ start:'▶ START dati', stop:'⏹ STOP dati', video_on:'🎥 video ON',
                video_off:'🎥 video OFF', mic_on:'🎙 microfono ON', mic_off:'🎙 microfono OFF',
                pit:'📋 pit board' };
