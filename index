// DRIVER COACH — post-session prescriptive analytics
// ═══════════════════════════════════════════════════════════════

function _coachFmtMs(ms){
  if(!ms||!isFinite(ms)||ms<=0) return '—';
  var min = Math.floor(ms/60000);
  var sec = ((ms%60000)/1000).toFixed(3);
  if(sec.length === 5) sec = '0'+sec;
  return min+':'+sec;
}

function _coachPopulateFilters(){
  var dEl = document.getElementById('coach-driver');
