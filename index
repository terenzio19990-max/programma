// ── 10. DELTA LIVE NEL FORM TEMPI ────────────────────
(function(){
  var ltInput = document.getElementById('lap-time');
  if(!ltInput) return;

  // Crea elemento delta
  var deltaEl = document.createElement('div');
  deltaEl.id = 'lap-time-delta-hint';
  deltaEl.style.cssText = 'font-family:var(--mono);font-size:11px;height:16px;margin-top:3px;letter-spacing:.5px;transition:color .15s;';
  ltInput.parentElement.appendChild(deltaEl);

  function parseMs(str) {
    if(!str) return null;
    str = str.trim();
    var m = str.match(/^(\d+):(\d{2})\.(\d+)$/);
    if(m) return (+m[1])*60000 + (+m[2])*1000 + (+m[3].padEnd(3,'0').slice(0,3));
    m = str.match(/^(\d+)\.(\d+)$/);
    if(m) return (+m[1])*1000 + (+m[2].padEnd(3,'0').slice(0,3));
    return null;
  }

  function getBestMs() {
    if(typeof STATE==='undefined') return null;
    var selIdx = STATE.selectedTrackCar||0;
    var cars = STATE.trackCars||[];
    var car = cars[selIdx];
    if(!car) return null;
    var laps = (STATE.laps&&STATE.laps[car.id])||[];
    if(!laps.length) return null;
    var best = null;
    laps.forEach(function(l){
      var ms = parseMs(l.time);
      if(ms && (best===null||ms<best)) best=ms;
    });
    return best;
  }

  ltInput.addEventListener('input', function(){
    var val = ltInput.value;
    var ms = parseMs(val);
    var best = getBestMs();
    if(!ms || !best) { deltaEl.textContent=''; return; }
    var diff = ms - best;
    var sign = diff>=0?'+':'-';
    var abs = Math.abs(diff);
    var s = Math.floor(abs/1000), ms2 = abs%1000;
    var str = sign + s + '.' + String(ms2).padStart(3,'0') + 's vs best';
    deltaEl.textContent = str;
    deltaEl.style.color = diff<-200?'var(--green)':diff<500?'var(--yellow)':'var(--red)';
  });
})();

