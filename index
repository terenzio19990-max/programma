function buildDashboard() {
  // Perf guard: skip rebuild if dashboard not visible (saves significant CPU
  // when adding many laps in a row from another page).
  // Bypassed when window.__FORCE_REBUILD is true (e.g. after JSON restore).
  var dashEl = document.getElementById('page-dashboard');
  if(dashEl && !dashEl.classList.contains('active') && !window.__FORCE_REBUILD) return;
  // ─── Welcome banner (shown only first time / when empty) ─
  if(typeof renderWelcomeBanner === 'function') renderWelcomeBanner();

  // ─── HERO BAND: Modalità · Circuito · Sessione · Meteo · Prossima sessione ─
  var hero = document.getElementById('dash-hero');
  if(hero){
    var mode = STATE.mode || '—';
    var modeLabel = mode === 'rally' ? '🌲 RALLY' : '🏁 PISTA';
    var modeColor = mode === 'rally' ? 'var(--green)' : 'var(--accent)';
    var circuit = (typeof CIRCUIT !== 'undefined' && CIRCUIT && CIRCUIT.name) ? CIRCUIT.name : (STATE.circuit||'—');
    var sessType = document.getElementById('session-type')?.value || '—';
    var surface = document.getElementById('surface-sel')?.value || '—';
    // Meteo
    var meteoStr = '—';
    var meteoIcon = '🌤';
    if(typeof METEO_STATE !== 'undefined' && METEO_STATE && METEO_STATE.current){
      var m = METEO_STATE.current;
      var temp = m.temp !== undefined ? m.temp+'°C' : '';
      var cond = m.condition || '';
      meteoStr = (temp+' '+cond).trim() || '—';
      // Pick icon from condition
      var c = (cond||'').toLowerCase();
      meteoIcon = c.indexOf('pioggia')>=0||c.indexOf('rain')>=0?'🌧':
                  c.indexOf('nuvol')>=0||c.indexOf('cloud')>=0?'☁':
                  c.indexOf('sole')>=0||c.indexOf('sun')>=0?'☀':
                  c.indexOf('bagn')>=0?'💧':'🌤';
    }
    // Next session — try to read from REP_weekend_schedule_v1
    var nextSess = '';
    try {
      var sched = JSON.parse(localStorage.getItem('REP_weekend_schedule_v1')||'null');
      if(sched && Array.isArray(sched) && sched.length){
        var now = Date.now();
        var upcoming = sched.filter(function(s){
          var t = s.startMs || (s.startTime && Date.parse(s.startTime)) || null;
          return t && t > now;
        }).sort(function(a,b){
          var ta = a.startMs || Date.parse(a.startTime||'');
          var tb = b.startMs || Date.parse(b.startTime||'');
          return ta - tb;
        });
        if(upcoming.length){
          var ns = upcoming[0];
          var nsTs = ns.startMs || Date.parse(ns.startTime||'');
          var deltaMin = Math.floor((nsTs - now)/60000);
          var label = deltaMin < 60 ? deltaMin+' min' : Math.floor(deltaMin/60)+'h '+(deltaMin%60)+'min';
          nextSess = '<div><div style="font-size:9px;color:var(--text3);letter-spacing:1.5px;margin-bottom:2px;">PROSSIMA SESSIONE</div>'+
            '<div style="font-size:13px;font-weight:700;color:var(--blue);">⏱ '+(ns.label||ns.session||'—')+'</div>'+
            '<div style="font-size:10px;color:var(--text3);">tra '+label+'</div></div>';
        }
      }
    } catch(_){}

    hero.innerHTML =
      '<div style="display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between;">'+
        '<div>'+
          '<div style="font-family:var(--head);font-size:24px;font-weight:900;letter-spacing:3px;color:'+modeColor+';">'+modeLabel+'</div>'+
          '<div style="font-size:14px;color:var(--text1);font-weight:600;margin-top:3px;">📍 '+circuit+'</div>'+
        '</div>'+
        '<div><div style="font-size:9px;color:var(--text3);letter-spacing:1.5px;margin-bottom:2px;">SESSIONE CORRENTE</div>'+
          '<div style="font-size:13px;font-weight:700;color:var(--text1);">'+sessType+'</div>'+
          '<div style="font-size:10px;color:var(--text3);">Fondo: '+surface+'</div></div>'+
        '<div><div style="font-size:9px;color:var(--text3);letter-spacing:1.5px;margin-bottom:2px;">METEO LIVE</div>'+
          '<div style="font-size:18px;">'+meteoIcon+' <span style="font-size:13px;font-weight:700;color:var(--text1);">'+meteoStr+'</span></div></div>'+
        (nextSess || '')+
      '</div>';
  }

  // ─── KPI ROW: best weekend, giri totali, posizione, gap ─────────
  var kpiEl = document.getElementById('dash-kpis');
  if(kpiEl){
    var allCars = STATE.mode==='track' ? (STATE.trackCars||[]) : (STATE.rallyCars||[]);
    var weekendBest = Infinity, weekendBestCar = '';
    var totalLaps = 0;
    allCars.forEach(function(car){
      var laps = STATE.laps[car.id]||[];
      laps.forEach(function(l){
        var ms = parseTime(l.time);
        if(ms && isFinite(ms) && ms < weekendBest){
          weekendBest = ms;
          weekendBestCar = car.name;
        }
      });
      totalLaps += laps.length;
    });
    var selCar = STATE.mode==='track' ? STATE.trackCars[STATE.selectedTrackCar] : STATE.rallyCars[STATE.selectedRallyCar];
    var selPos = selCar && STATE.positions[selCar.id]?.current;
    var selBest = selCar ? getBestLap(selCar.id) : null;

    function kpiBox(label, value, sub, color){
      color = color || 'var(--accent3)';
      return '<div style="background:var(--bg2);border-left:3px solid '+color+';border-radius:5px;padding:10px 14px;flex:1;min-width:150px;">'+
        '<div style="font-size:9px;color:var(--text3);letter-spacing:1.5px;margin-bottom:3px;">'+label+'</div>'+
        '<div style="font-family:var(--mono);font-size:20px;font-weight:700;color:'+color+';">'+value+'</div>'+
        (sub ? '<div style="font-size:10px;color:var(--text3);margin-top:2px;">'+sub+'</div>' : '')+
      '</div>';
    }
    function fmt(ms){
      if(!ms||!isFinite(ms)) return '—';
      var min = Math.floor(ms/60000);
      var sec = ((ms%60000)/1000).toFixed(3);
      if(sec.length === 5) sec = '0'+sec;
      return min+':'+sec;
    }
    kpiEl.innerHTML =
      kpiBox('🏆 BEST WEEKEND', isFinite(weekendBest)?fmt(weekendBest):'—', weekendBestCar, 'var(--green)')+
      kpiBox('GIRI TOTALI', totalLaps, allCars.length+' vetture', 'var(--blue)')+
      kpiBox('TUO BEST', selBest||'—', selCar?selCar.name:'', 'var(--accent3)')+
      kpiBox('POSIZIONE', selPos?'P'+selPos:'—', selCar?selCar.name:'', selPos&&selPos<=3?'var(--yellow)':'var(--text2)');
  }

  // ─── ALERTS: top 4 from todo engine ─────────────────────────────
  var alertEl = document.getElementById('dash-alerts');
  if(alertEl){
    var todo = (typeof _todoCheck === 'function') ? _todoCheck() : [];
    if(!todo.length){
      alertEl.innerHTML = '<div style="background:rgba(44,188,110,0.08);border-left:3px solid var(--green);border-radius:5px;padding:10px 14px;font-size:12px;color:var(--text2);">'+
        '✅ <b>Tutto sotto controllo</b> — nessuna azione richiesta'+
      '</div>';
    } else {
      var topAlerts = todo.slice(0, 4);
      alertEl.innerHTML = '<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">'+
        '<span style="font-family:var(--head);font-size:11px;color:var(--text3);letter-spacing:1.5px;">⚠️ AZIONI RICHIESTE</span>'+
        (todo.length>4?'<span style="font-size:10px;color:var(--text3);">(+'+(todo.length-4)+' altre)</span>':'')+
        '</div>'+
        '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:6px;">'+
          topAlerts.map(function(it){
            var col = it.prio==='critical'?'var(--red)':it.prio==='warning'?'var(--yellow)':'var(--blue)';
            var click = it.page ? 'onclick="showPage(\''+it.page+'\')" style="cursor:pointer;"' : '';
            return '<div '+click+' style="background:var(--bg2);border-left:3px solid '+col+';border-radius:4px;padding:8px 12px;font-size:11px;'+(it.page?'cursor:pointer;':'')+'">'+
              '<span style="margin-right:5px;">'+it.icon+'</span>'+
              '<span style="color:var(--text1);">'+it.text+'</span>'+
              (it.page?'<span style="float:right;color:var(--text3);">→</span>':'')+
            '</div>';
          }).join('')+
        '</div>';
    }
  }

  // ─── MINI CHART: last 10 laps of the selected car (SVG) ────────
  var chartEl = document.getElementById('dash-mini-chart');
  if(chartEl){
    var selCar2 = STATE.mode==='track' ? STATE.trackCars[STATE.selectedTrackCar] : STATE.rallyCars[STATE.selectedRallyCar];
    if(selCar2){
      var laps = (STATE.laps[selCar2.id]||[]).slice(-10);
      var data = laps.map(function(l, i){
        var ms = parseTime(l.time);
        return ms && isFinite(ms) ? { y: ms/1000, label: 'G'+l.lap } : null;
      }).filter(Boolean);
      if(data.length >= 2){
        // Use existing _statsMiniLineChart if available
        var chartHtml = (typeof _statsMiniLineChart === 'function')
          ? _statsMiniLineChart(data, { width: 800, height: 160, fmtY: function(v){return v.toFixed(2)+'s';} })
          : '';
        chartEl.innerHTML = '<div style="background:var(--bg2);border:1px solid var(--border);border-radius:6px;padding:12px 14px;">'+
          '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">'+
            '<span style="font-family:var(--head);font-size:11px;color:var(--text3);letter-spacing:1.5px;">📈 ULTIMI '+data.length+' GIRI · '+selCar2.name+'</span>'+
            '<button class="btn btn-gray" style="padding:3px 8px;font-size:10px;" onclick="showPage(\'lapchart\')">Grafico completo →</button>'+
          '</div>'+
          chartHtml+
        '</div>';
      } else {
        chartEl.innerHTML = '';
      }
    }
  }

  // ─── PER-CAR GRID (existing detailed cards) ────────────────────
  const grid = document.getElementById('dashboard-grid');
  if(!grid) return;
  const cars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;
  grid.innerHTML = cars.map(car => {
    const laps    = STATE.laps[car.id]||[];
    const best    = getBestLap(car.id)||'—';
    const lastLap = laps.length ? laps[laps.length-1] : null;
    const fuel    = STATE.fuel[car.id];
    const tyres   = STATE.tyres[car.id];
    const fuelPct = fuel ? Math.round(fuel.current/fuel.capacity*100) : null;
    const fuelColor = fuelPct===null?'var(--text3)':fuelPct>40?'var(--green)':fuelPct>20?'var(--yellow)':'var(--red)';
    const pos     = STATE.positions[car.id]?.current;
    const WHEELS  = ['FL','FR','RL','RR'];
    const maxWear = tyres?.current?.wheels ? Math.max(...WHEELS.map(w=>tyres.current.wheels[w]?.wear||0)) : null;
    const wearColor = maxWear===null?'var(--text3)':maxWear>75?'var(--red)':maxWear>50?'var(--yellow)':'var(--green)';
    const compound = tyres?.current?.wheels ? WHEELS.map(w=>{
      const wh=tyres.current.wheels[w]; return '<span class="tyre-compound cpd-'+(wh?.compound||'?')+'" style="font-size:10px;padding:1px 4px;">'+(wh?.compound||'?')+'</span>';
    }).join(' ') : '—';
    const dmgKeys = Object.keys(STATE.damage[car.id]||{});
    const hasDmg  = (STATE.damage[car.id]||[]).length>0;
    const retired = car.retired;
    const statusColor = retired?'var(--red)':hasDmg?'var(--yellow)':'var(--green)';
    const status = retired?'RITIRATA':hasDmg?'DANNI':'OK';

    return '<div class="panel" style="border-left:3px solid '+(car.color||'var(--accent2)')+'">' +
      '<div class="panel-head" style="border-left:none;">' +
        '<span style="color:'+(car.color||'var(--accent2)')+';font-size:14px;">&#9679;</span> '+car.name+
        ' <span class="badge '+(retired?'badge-red':hasDmg?'badge-yellow':'badge-green')+'" style="margin-left:6px;">'+status+'</span>' +
        (pos ? ' <span class="badge badge-blue" style="margin-left:4px;">P'+pos+'</span>' : '') +
      '</div>' +
      '<div class="panel-body">' +
        '<div class="g4" style="gap:8px;">' +
          '<div class="tile"><div class="tile-label">GIRI</div><div class="tile-value">'+laps.length+'</div></div>' +
          '<div class="tile tile-good"><div class="tile-label">BEST</div><div class="tile-value" style="font-size:16px;">'+best+'</div></div>' +
          '<div class="tile"><div class="tile-label">ULTIMO</div><div class="tile-value" style="font-size:16px;">'+(lastLap?lastLap.time:'—')+'</div></div>' +
          '<div class="tile"><div class="tile-label">POSIZ.</div><div class="tile-value">'+(pos||'—')+'</div></div>' +
        '</div>' +
        '<div class="g4 mt8" style="gap:8px;">' +
          '<div class="tile"><div class="tile-label">CARBURANTE</div><div class="tile-value" style="color:'+fuelColor+';font-size:16px;">'+(fuelPct!==null?fuelPct+'%':'—')+'</div><div class="tile-sub">'+(fuel?fuel.current.toFixed(1)+'L':'')+'</div></div>' +
          '<div class="tile"><div class="tile-label">USURA MAX</div><div class="tile-value" style="color:'+wearColor+';font-size:16px;">'+(maxWear!==null?maxWear+'%':'—')+'</div></div>' +
          '<div class="tile"><div class="tile-label">MESCOLE</div><div class="tile-value" style="font-size:11px;line-height:1.8;">'+compound+'</div></div>' +
          '<div class="tile"><div class="tile-label">DANNI</div><div class="tile-value" style="font-size:14px;">'+(hasDmg?'<span style="color:var(--yellow)">⚠️ '+STATE.damage[car.id].length+'</span>':'<span style="color:var(--green)">✅</span>')+'</div></div>' +
        '</div>' +
      '</div>' +
    '</div>';
  }).join('');
}

