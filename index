      '<div style="font-size:10px;color:'+(isSel?'rgba(255,255,255,0.85)':'var(--text3)')+';margin-bottom:4px;">'+dateStr+(circuitName?' · '+circuitName:'')+'</div>'+
      (preview?'<div style="font-size:11px;color:'+(isSel?'rgba(255,255,255,0.9)':'var(--text2)')+';line-height:1.4;margin-bottom:4px;">'+preview+'</div>':'')+
      (tags?'<div style="margin-top:4px;">'+tags+'</div>':'')+
