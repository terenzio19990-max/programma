function uid(){ return 'd'+Date.now().toString(36)+Math.floor(Math.random()*1e4).toString(36); }

function load(){
  var o;
  try { o = JSON.parse(localStorage.getItem(DPKEY)||'null'); } catch(e){ o=null; }
  if(!o || typeof o!=='object') o = {v:1, drivers:{}, activeId:null};
  if(!o.drivers) o.drivers = {};
  return o;
}
