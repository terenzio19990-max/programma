// TIMERS
// ═══════════════════════════════════════════════════════════════
let sessionInterval, assistInterval;
let SESSION_DURATION_MS = 0; // 0 = count up, >0 = countdown

function parseTimerInput(str) {
  // Accepts: "30:00", "1:30:00", "90" (minutes), "5400" (seconds-if-big)
  if(!str) return 0;
  const parts = str.trim().split(':');
  if(parts.length===3) return (+parts[0])*3600000 + (+parts[1])*60000 + (+parts[2])*1000;
  if(parts.length===2) return (+parts[0])*60000 + (+parts[1])*1000;
  const n = +parts[0];
  return n>0 ? n*60000 : 0; // interpret lone number as minutes
}

function setTimerFromInput() {
  const val = document.getElementById('session-duration-input')?.value||'';
  SESSION_DURATION_MS = parseTimerInput(val);
  pauseTimer();
  STATE.sessionTimerElapsed = SESSION_DURATION_MS > 0 ? SESSION_DURATION_MS : 0;
  updateSessionTimerDisplay();
  if(SESSION_DURATION_MS>0) setEl('session-countdown-disp', `⬇ CONTO ALLA ROVESCIA: ${val}`);
  else setEl('session-countdown-disp', '⬆ CONTO IN AVANTI');
}

function setTimerFromClock() {
  const timeInput = document.getElementById('session-start-time')?.value;
  if(!timeInput) return;
  const [hh,mm] = timeInput.split(':').map(Number);
  const now = new Date();
  const start = new Date(); start.setHours(hh,mm,0,0);
  const elapsed = Math.max(0, now - start);
  SESSION_DURATION_MS = 0;
  STATE.sessionTimerElapsed = elapsed;
  STATE.sessionTimerStart = Date.now() - elapsed;
  updateSessionTimerDisplay();
  setEl('session-countdown-disp', `▶ Partito alle ${timeInput}`);
}

function startTimer() {
  if(STATE.sessionTimerRunning) return;
  STATE.sessionTimerRunning = true;
  if(SESSION_DURATION_MS>0) {
    // countdown: start = now, elapsed reused as "remaining at pause"
    STATE.sessionTimerStart = Date.now() - (SESSION_DURATION_MS - STATE.sessionTimerElapsed);
  } else {
    STATE.sessionTimerStart = Date.now() - STATE.sessionTimerElapsed;
  }
  sessionInterval = setInterval(updateSessionTimerDisplay, 100);
  animateCars();
}
function pauseTimer() {
  STATE.sessionTimerRunning = false;
  if(SESSION_DURATION_MS>0) {
    const elapsed = Date.now() - STATE.sessionTimerStart;
    STATE.sessionTimerElapsed = Math.max(0, SESSION_DURATION_MS - elapsed);
  } else {
    STATE.sessionTimerElapsed = Date.now() - STATE.sessionTimerStart;
  }
  clearInterval(sessionInterval);
  cancelAnimationFrame(animFrame);
}
function resetTimer() {
  pauseTimer();
  STATE.sessionTimerElapsed = SESSION_DURATION_MS > 0 ? SESSION_DURATION_MS : 0;
  updateSessionTimerDisplay();
}
function updateSessionTimerDisplay() {
  let display, countdown='';
  if(SESSION_DURATION_MS>0) {
    const elapsed = STATE.sessionTimerRunning ? Date.now()-STATE.sessionTimerStart : 0;
    const remaining = Math.max(0, SESSION_DURATION_MS - elapsed - (STATE.sessionTimerRunning?0:SESSION_DURATION_MS-STATE.sessionTimerElapsed));
    const rem2 = STATE.sessionTimerRunning
      ? Math.max(0, SESSION_DURATION_MS - (Date.now()-STATE.sessionTimerStart))
      : STATE.sessionTimerElapsed;
    display = formatElapsed(rem2);
    if(rem2 < 60000) countdown = '⚠️ MENO DI 1 MINUTO';
    else if(rem2 < 300000) countdown = `⚠️ ${Math.ceil(rem2/60000)} min rimasti`;
  } else {
    const el = STATE.sessionTimerRunning ? Date.now()-STATE.sessionTimerStart : STATE.sessionTimerElapsed;
    display = formatElapsed(el);
  }
  setEl('session-timer-display', display);
  setEl('session-clock', display.substring(0,8));
  if(countdown) setEl('session-countdown-disp', countdown);
}

// ═══════════════════════════════════════════════════════════════
// WEEKEND SCHEDULE PLANNER
// ═══════════════════════════════════════════════════════════════
// Persistence key
var _SCHEDULE_KEY = 'rep_weekend_schedule_v1';
var _schedule = []; // [{id, day (YYYY-MM-DD), start (HH:MM), duration (min), type, name, notified15, notifiedStart}]
var _scheduleActiveId = null;

function loadSchedule(){
  try {
    var s = JSON.parse(localStorage.getItem(_SCHEDULE_KEY)||'[]');
    if(Array.isArray(s)) _schedule = s;
  } catch(e){ _schedule = []; }
}
function saveSchedule(){
  try { localStorage.setItem(_SCHEDULE_KEY, JSON.stringify(_schedule)); } catch(e){}
}

function todayISO(offset){
  var d = new Date();
  if(offset) d.setDate(d.getDate()+offset);
  var y = d.getFullYear(), m = String(d.getMonth()+1).padStart(2,'0'), day = String(d.getDate()).padStart(2,'0');
  return y+'-'+m+'-'+day;
}

function addScheduleItem(prefill){
  var d = prefill||{};
  var id = 'sch_'+Date.now()+'_'+Math.floor(Math.random()*1000);
  _schedule.push({
    id: id,
    day: d.day || todayISO(),
    start: d.start || '10:00',
    duration: d.duration || 30,
    type: d.type || 'FP1',
    name: d.name || '',
    notified15: false,
    notifiedStart: false
  });
  saveSchedule();
  renderSchedule();
}

function clearSchedule(){
  if(!_schedule.length){ showToast('Schedule vuota'); return; }
  if(!confirm('Rimuovere tutte le '+_schedule.length+' sessioni pianificate?')) return;
  _schedule = [];
  saveSchedule();
  renderSchedule();
}

function removeScheduleItem(id){
  _schedule = _schedule.filter(function(s){return s.id!==id;});
  saveSchedule();
  renderSchedule();
}

function updateScheduleItem(id, field, value){
  var it = _schedule.find(function(s){return s.id===id;});
  if(!it) return;
  it[field] = value;
  // If start was changed reset notification flags
  if(field==='start'||field==='day'||field==='duration'){
    it.notified15 = false;
    it.notifiedStart = false;
  }
  saveSchedule();
}

function toggleScheduleHelp(){
  var el = document.getElementById('schedule-help');
  if(el) el.style.display = el.style.display==='none' ? 'block' : 'none';
}

function _scheduleDateTime(item){
  return new Date(item.day+'T'+item.start+':00');
}

function _dayLabel(iso){
  var days = ['Dom','Lun','Mar','Mer','Gio','Ven','Sab'];
  try {
    var d = new Date(iso+'T00:00:00');
    return days[d.getDay()]+' '+String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0');
  } catch(e){ return iso; }
}

function renderSchedule(){
  var el = document.getElementById('schedule-list');
  if(!el) return;
  if(!_schedule.length){
    el.innerHTML = '<div style="color:var(--text3);font-size:11px;padding:8px;text-align:center;">Nessuna sessione pianificata. Clicca <b>+ SESSIONE</b> per aggiungere.</div>';
    updateScheduledBanner();
    return;
  }
  // Sort by day + start time
  var sorted = _schedule.slice().sort(function(a,b){
    return _scheduleDateTime(a) - _scheduleDateTime(b);
  });
  // Group by day
  var byDay = {};
  sorted.forEach(function(s){
    if(!byDay[s.day]) byDay[s.day] = [];
    byDay[s.day].push(s);
  });
  var now = Date.now();
  var html = Object.keys(byDay).map(function(day){
    var items = byDay[day];
    return '<div style="font-family:var(--head);font-size:10px;color:var(--accent3);letter-spacing:2px;padding:4px 2px;border-bottom:1px solid var(--border);margin-top:4px;">📅 '+_dayLabel(day).toUpperCase()+'</div>'+
      items.map(function(it){
        var dt = _scheduleDateTime(it);
        var delta = dt.getTime() - now;
        var endDt = new Date(dt.getTime() + (+it.duration||30)*60000);
        var status, statusColor;
        if(it.id===_scheduleActiveId){ status='▶ ATTIVA'; statusColor='var(--green)'; }
        else if(now > endDt.getTime()){ status='✓ Conclusa'; statusColor='var(--text3)'; }
        else if(delta <= 0){ status='🔴 In corso'; statusColor='var(--red)'; }
        else if(delta < 15*60000){ var m=Math.ceil(delta/60000); status='⚠️ -'+m+'min'; statusColor='var(--accent3)'; }
        else if(delta < 60*60000){ status='⏳ '+Math.ceil(delta/60000)+'min'; statusColor='var(--yellow)'; }
        else { status='🗓 '+Math.ceil(delta/3600000)+'h'; statusColor='var(--text3)'; }
        var isPast = now > endDt.getTime();
        return '<div style="display:grid;grid-template-columns:60px 1fr 60px 70px 80px auto auto;gap:4px;align-items:center;padding:5px 6px;background:'+(it.id===_scheduleActiveId?'rgba(44,188,110,0.1)':'var(--bg3)')+';border-radius:4px;'+(isPast?'opacity:.55;':'')+'">'+
          '<input type="time" value="'+it.start+'" onchange="updateScheduleItem(\''+it.id+'\',\'start\',this.value);renderSchedule()" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-family:var(--mono);font-size:11px;padding:2px 4px;">'+
          '<input type="text" value="'+(it.name||'')+'" placeholder="'+(it.type||'Sessione')+'" onchange="updateScheduleItem(\''+it.id+'\',\'name\',this.value)" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-size:11px;padding:2px 5px;">'+
          '<select onchange="updateScheduleItem(\''+it.id+'\',\'type\',this.value);renderSchedule()" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text2);font-size:10px;padding:2px;">'+
          ['FP1','FP2','FP3','Q','Q1','Q2','Q3','Gara','Gara 1','Gara 2','Warm-up','Shakedown','PS','Libero'].map(function(t){return '<option '+(it.type===t?'selected':'')+'>'+t+'</option>';}).join('')+
          '</select>'+
          '<input type="number" min="1" max="480" value="'+it.duration+'" onchange="updateScheduleItem(\''+it.id+'\',\'duration\',+this.value);renderSchedule()" title="Durata (minuti)" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text2);font-family:var(--mono);font-size:11px;padding:2px 4px;text-align:center;">'+
          '<span style="font-size:10px;color:'+statusColor+';text-align:center;">'+status+'</span>'+
          '<button class="btn btn-green" style="padding:3px 7px;font-size:10px;" onclick="activateScheduledSession(\''+it.id+'\')" title="Usa questa sessione nel timer">🎯</button>'+
          '<button onclick="removeScheduleItem(\''+it.id+'\')" title="Rimuovi" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:13px;">✕</button>'+
          '</div>';
      }).join('');
  }).join('');
  el.innerHTML = html;
  updateScheduledBanner();
}

// Pick the next upcoming (or running) session and show its banner under the timer
function updateScheduledBanner(){
  var banner = document.getElementById('scheduled-session-banner');
  if(!banner) return;
  var now = Date.now();
  var next = _schedule.map(function(s){
    var start = _scheduleDateTime(s).getTime();
    var end = start + (+s.duration||30)*60000;
    return { it:s, start:start, end:end };
  }).filter(function(r){return r.end > now;}).sort(function(a,b){return a.start-b.start;})[0];
  if(!next){ banner.style.display='none'; return; }
  var delta = next.start - now;
  var label = next.it.name ? (next.it.name+' ['+next.it.type+']') : next.it.type;
  var txt;
  if(delta <= 0){
    var elapsed = now - next.start;
    var remainingMin = Math.ceil((next.end - now)/60000);
    txt = '🔴 <b>IN CORSO:</b> '+label+' · Tempo rimanente: <b>'+remainingMin+' min</b>';
    banner.style.borderLeftColor = 'var(--red)';
    banner.style.background = 'rgba(224,48,48,0.10)';
  } else if(delta < 15*60000){
    txt = '⚠️ <b>PROSSIMA SESSIONE:</b> '+label+' alle <b>'+next.it.start+'</b> — inizia tra <b>'+Math.ceil(delta/60000)+' min</b>';
    banner.style.borderLeftColor = 'var(--accent3)';
    banner.style.background = 'rgba(255,160,64,0.14)';
  } else {
    var h = Math.floor(delta/3600000), m = Math.ceil((delta%3600000)/60000);
    txt = '🗓 <b>Prossima:</b> '+label+' — '+_dayLabel(next.it.day)+' '+next.it.start+' (tra '+(h?h+'h ':'')+m+'min)';
    banner.style.borderLeftColor = 'var(--blue)';
    banner.style.background = 'rgba(43,125,233,0.10)';
  }
  banner.innerHTML = txt;
  banner.style.display = 'block';
}

// Activate a scheduled session into the timer
function activateScheduledSession(id){
  var it = _schedule.find(function(s){return s.id===id;});
  if(!it) return;
  _scheduleActiveId = id;
  // Set duration
  SESSION_DURATION_MS = (+it.duration||30) * 60 * 1000;
  var mmss = String(Math.floor(it.duration/60)).padStart(2,'0')+':'+String(it.duration%60).padStart(2,'0')+':00';
  if(it.duration<60) mmss = String(it.duration).padStart(2,'0')+':00';
  var di = document.getElementById('session-duration-input');
  if(di) di.value = (it.duration>=60 ? mmss : (it.duration+':00'));
  var si = document.getElementById('session-start-time');
  if(si) si.value = it.start;
  // Set session type field if exists
  var st = document.getElementById('session-type');
  if(st) st.value = it.type;
  // Reset the timer to the full duration
  STATE.sessionTimerRunning = false;
  if(typeof sessionInterval!=='undefined' && sessionInterval) clearInterval(sessionInterval);
  STATE.sessionTimerElapsed = SESSION_DURATION_MS;
  updateSessionTimerDisplay();
  setEl('session-countdown-disp', '🎯 '+(it.name||it.type)+' · start '+it.start+' · durata '+it.duration+' min');
  showToast('🎯 Sessione "'+(it.name||it.type)+'" attiva nel timer');
  renderSchedule();
}

// Periodic check — fires notifications -15 min and at start
function scheduleNotifyCheck(){
  var now = Date.now();
  _schedule.forEach(function(s){
    var start = _scheduleDateTime(s).getTime();
    var delta = start - now;
    // -15 min notification
    if(!s.notified15 && delta > 0 && delta <= 15*60000){
      s.notified15 = true;
      saveSchedule();
      var label = s.name ? (s.name+' ['+s.type+']') : s.type;
      if(typeof pushNotif==='function'){
        pushNotif('warning','⏰','15 MINUTI ALLA SESSIONE', label+' inizia alle '+s.start+' (tra '+Math.ceil(delta/60000)+' minuti)',{key:'sch15_'+s.id});
      }
      showToast('⏰ 15 min alla sessione: '+label);
      // Browser notification if permitted
      try {
        if(typeof Notification!=='undefined' && Notification.permission==='granted'){
          new Notification('⏰ 15 min alla sessione', { body: label+' alle '+s.start, tag:'sch15_'+s.id });
        }
      } catch(e){}
      // Audio beep
      _scheduleBeep();
    }
    // Start notification (± 30 sec window)
    if(!s.notifiedStart && delta <= 0 && delta > -30000){
      s.notifiedStart = true;
      saveSchedule();
      var label2 = s.name ? (s.name+' ['+s.type+']') : s.type;
      if(typeof pushNotif==='function'){
        pushNotif('info','🏁','SESSIONE INIZIATA', label2+' - clicca sulla sessione in schedule per avviare il timer',{key:'sch0_'+s.id});
      }
      showToast('🏁 Inizio sessione: '+label2);
      try {
        if(typeof Notification!=='undefined' && Notification.permission==='granted'){
          new Notification('🏁 Sessione iniziata', { body: label2, tag:'sch0_'+s.id });
        }
      } catch(e){}
      _scheduleBeep();
      setTimeout(_scheduleBeep, 400);
    }
  });
  // Refresh UI so status badges stay current
  if(document.getElementById('schedule-list')) renderSchedule();
}

function _scheduleBeep(){
  try {
    var ctx = new (window.AudioContext||window.webkitAudioContext)();
    var o = ctx.createOscillator();
    var g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.frequency.value = 880;
    g.gain.value = 0.15;
    o.start();
    setTimeout(function(){ o.frequency.value = 660; }, 120);
    setTimeout(function(){ o.stop(); ctx.close(); }, 300);
  } catch(e){}
}

// Request browser notif perm on first schedule interaction
function requestNotifPermOnce(){
  try {
    if(typeof Notification!=='undefined' && Notification.permission==='default'){
      Notification.requestPermission();
    }
  } catch(e){}
}

