      showToast('⚠️ Tempo giro non valido: '+ltVal.msg);
      var el = document.getElementById('lap-time'); if(el) el.focus();
      return;
    }
    // Soft warnings — log as toast but allow save
    var warnings = [];
    if(ltVal.level === 'warn') warnings.push(ltVal.msg);
    [['s1',s1str],['s2',s2str],['s3',s3str]].forEach(function(p){
      var r = Validate.sectorTime(p[1]);
      if(r.level === 'warn') warnings.push(p[0].toUpperCase()+': '+r.msg);
    });
    var consist = Validate.sectorsConsistency(s1str, s2str, s3str, ltVal.parsed);
    if(consist.level === 'warn') warnings.push(consist.msg);
    var pos = +document.getElementById('lap-pos').value;
    if(pos === 0) { showToast('⚠️ Posizione 0 non valida'); return; }
    var vmaxR = Validate.vmax(document.getElementById('lap-vmax').value);
    if(vmaxR.level === 'warn') warnings.push(vmaxR.msg);
    if(warnings.length){
      showToast('⚠️ Salvato con avvisi: ' + warnings[0] + (warnings.length>1?' (+'+(warnings.length-1)+')':''));
    }
  }
  const _lapSnap=JSON.parse(JSON.stringify(STATE.laps[car.id]||[]));
  pushUndo('G'+((STATE.laps[car.id]||[]).length+1)+' '+car.name,()=>{STATE.laps[car.id]=_lapSnap;if(typeof buildLapsPage==='function')buildLapsPage();buildDashboard();});
  const lap = {
    lap: +document.getElementById('lap-num').value,
    time: document.getElementById('lap-time').value,
    s1: document.getElementById('s1-time').value,
    s2: document.getElementById('s2-time').value,
    s3: document.getElementById('s3-time').value,
    pos: +document.getElementById('lap-pos').value,
    vmax: +document.getElementById('lap-vmax').value || null,
    note: document.getElementById('lap-note').value,
    session: document.getElementById('session-type').value,
    car: car.id,
    driverId: (document.getElementById('lap-driver')||{}).value || '',
    ts: Date.now()  // timestamp for heatmap analysis
  };
  STATE.laps[car.id].push(lap);
  // Remember user choices for next time
  if(typeof rememberSessionChoice === 'function') rememberSessionChoice();
  if(typeof rememberDriverChoice === 'function') rememberDriverChoice(lap.driverId);
  document.getElementById('lap-num').value = lap.lap+1;
  document.getElementById('lap-time').value='';
  document.getElementById('lap-note').value='';
  document.getElementById('lap-vmax').value='';
  buildLapsTable(car.id);
  updateTrackCarsPanel();
  updateSidebarStats(car.id);
  triggerAutoSave();

  // Broadcast to coop peers (if connected)
  if(typeof coopBroadcastPatch === 'function' && typeof COOP !== 'undefined' && COOP.status !== 'disconnected' && !COOP.applyingRemote){
    coopBroadcastPatch('STATE.laps.'+car.id, 'push', lap, 'ha aggiunto G'+lap.lap+' su '+car.name);
  }

  // Auto-focus lap time input for quick consecutive entries
  setTimeout(function(){ var el=document.getElementById('lap-time'); if(el) el.focus(); }, 60);

  // Auto fuel calc
  const fuelState = STATE.fuel[car.id];
  fuelState.current = Math.max(0, fuelState.current - fuelState.perLap);
  fuelState.totalUsed += fuelState.perLap;
  buildFuelUI(car.id);
  updateTyreKm('track');
  setTimeout(runAlertChecks, 200);
}

