};
window.repBuildTrackOverview = function(){
  try {
    var body=panelBox('rep-ov-track','overview','🏁 RIEPILOGO SESSIONE — LIVE');
    if(!body) return;
    var html='<div style="overflow-x:auto"><table class="data-table" style="font-size:11px"><thead><tr><th>VETTURA</th><th>GIRI</th><th>BEST</th><th>ULTIMO</th><th>BENZINA</th><th>GOMME (età)</th><th>POS</th></tr></thead><tbody>';
    (STATE.trackCars||[]).forEach(function(c){
      var laps=(STATE.laps||{})[c.id]||[];
      var best=bestOf(laps.map(function(l){return l.time;}));
      var last=laps.length? laps[laps.length-1].time : '—';
      var fu=(STATE.fuel||{})[c.id];
      var ty=(STATE.tyres||{})[c.id];
      var age = ty&&ty.current? (laps.length-(ty.current.lapsMounted||0))+' giri' : '—';
      var pos=(STATE.positions||{})[c.id];
      html+='<tr><td><b>'+esc2(c.name)+'</b></td><td>'+laps.length+'</td><td class="mono" style="color:var(--green)">'+msStr(best)+'</td>'+
        '<td class="mono">'+esc2(last)+'</td>'+
        '<td>'+(fu&&isFinite(+fu.current)? (+fu.current).toFixed(1)+' L':'—')+'</td>'+
        '<td>'+esc2(age)+'</td><td>'+esc2((pos&&pos.current)||'—')+'</td></tr>';
    });
    html+='</tbody></table></div>';
    body.innerHTML=html;
  } catch(e){}
};
