   ['barF','barra ant.'],['barR','barra post.'],['bumpF','bump ant.'],['bumpR','bump post.'],['rebF','reb. ant.'],['rebR','reb. post.'],
   ['brakeBias','bias'],['toeF','toe ant.'],['toeR','toe post.'],
