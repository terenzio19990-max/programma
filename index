var CB = {
  KEY:KEY, load:load, save:save, render:render, inject:inject,
  perKm:perKm, dayCost:dayCost, raceCost:raceCost, projection:projection, season:season,
  compCost:compCost, kmRace:kmRace, kmPerDaySuggested:kmPerDaySuggested, addSpend:addSpend,
  money:money, cars:cars
};
