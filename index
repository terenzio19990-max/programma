    // Auto-suggest VMax from average of last 5 laps
    var vmaxEl = document.getElementById('lap-vmax');
    if(vmaxEl && !vmaxEl.value){
      var lastLaps = (STATE.laps[car.id] || []).slice(-5);
      var vmaxes = lastLaps.map(function(l){return +l.vmax||0;}).filter(function(v){return v>0;});
      if(vmaxes.length){
        var avgV = vmaxes.reduce(function(a,b){return a+b;},0)/vmaxes.length;
        vmaxEl.placeholder = 'es. ~'+avgV.toFixed(0)+' (media ultimi)';
      }
    }
  } catch(_){}
  applySmartDefaults();
}
