    h+='<div style="font-weight:600;margin-bottom:2px">'+esc(ar.arch.name)+'</div>'+
       '<div class="small" style="opacity:.8;line-height:1.5;margin-bottom:6px">'+esc(ar.arch.desc)+'</div>'+
       '<div class="small" style="opacity:.7">Sessioni in archivio: <b>'+nEv+'</b> · con feedback: <b>'+nFb+'</b></div>'+
       '<div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">'+
       '<button class="btn" style="font-size:11px" onclick="DP.quiz(\''+mode+'\')">📋 Rifai questionario</button>'+
       '<button class="btn" style="font-size:11px" onclick="DP.tune(\''+mode+'\')">🎚 Correggi assi</button>'+
       '</div>';
  }
  h+='</div></div>';

  /* — assi in chiaro — */
  h+='<div class="small" style="margin-top:10px;line-height:1.7;opacity:.85">';
  AXES.forEach(function(a){
    var s=st[a.k], pct=Math.round(s.v*100);
    var tag = s.src==='appreso'? ('appreso da '+s.n+' sessioni') : (s.src==='manuale'?'impostato a mano':(s.src==='quiz'?'dichiarato':'default'));
    h+='<div>'+esc(a.lab)+': <b>'+pct+'%</b> <span style="opacity:.6">('+esc(a.lo)+' → '+esc(a.hi)+', '+tag+')</span></div>';
  });
  h+='</div>';

  /* — memoria del luogo — */
  var key=venueKey(mode), vm=venueMemory(d, key);
  h+='<div class="sa-sec" style="margin-top:14px">📍 '+esc(venueName(mode))+' · '+esc(surfNow(mode))+'</div>';
  if(mode==='rally'){
    h+='<div class="field" style="max-width:260px;margin-bottom:8px"><label>Nome evento (per lo storico)</label>'+
       '<input id="dp-venue-rally" value="'+esc(venueName(mode))+'" onchange="DP.render(\'rally\')"></div>';
  }
  if(vm){
    h+='<div class="small" style="line-height:1.7">Ci sei già stato: <b>'+vm.runs+'</b> session'+(vm.runs===1?'e':'i')+
       ' · fiducia media <b>'+vm.avgConf.toFixed(1)+'/10</b>'+
       (vm.best && +vm.best.timeS>0? ' · miglior tempo <b>'+(+vm.best.timeS).toFixed(2)+'s</b>':'')+'</div>';
    var cur=null; try { cur=saReadFields(mode); } catch(e){}
    var diff=setupDiff(cur, vm.best && vm.best.setup);
    if(diff.length){
      h+='<div class="small" style="margin-top:6px;opacity:.85">Differenze rispetto al setup migliore usato qui:</div>'+
         '<ul style="margin:4px 0 0 18px;font-size:12px;line-height:1.7">';
      diff.slice(0,6).forEach(function(x){ h+='<li>'+esc(x.lab)+': ora <b>'+esc(x.to)+'</b>, allora <b>'+esc(x.from)+'</b></li>'; });
      h+='</ul>';
      h+='<div class="small" style="margin-top:4px;opacity:.7">'+(diff.length>6? ('+'+(diff.length-6)+' altre differenze'):'')+'</div>';
    } else if(cur){
      h+='<div class="small" style="margin-top:4px;opacity:.7">Il setup attuale coincide con quello migliore usato qui.</div>';
    }
    if(vm.best && vm.best.note) h+='<div class="small" style="margin-top:4px;opacity:.8">Nota di allora: “'+esc(vm.best.note)+'”</div>';
  } else {
    h+='<div class="small" style="opacity:.7">Prima volta qui per '+esc(d.name)+' — dopo questa sessione l\'app se lo ricorderà.</div>';
  }

  /* — motore su misura — */
  h+='<div class="sa-sec" style="margin-top:14px">🔧 SETUP SU MISURA</div>'+
     '<button class="btn btn-green" style="font-size:11px" onclick="DP.advise(\''+mode+'\')">🎯 COSA CAMBIARE PER '+esc(d.name).toUpperCase()+'</button>'+
     '<div id="dp-adv-'+mode+'" style="margin-top:8px"></div>';

  /* — registrazione sessione — */
  h+='<div class="sa-sec" style="margin-top:14px">📝 REGISTRA QUESTA SESSIONE</div>'+
     '<div class="small" style="opacity:.75;margin-bottom:6px">Come si è trovato? Da −5 (sottosterzo) a +5 (sovrasterzo).</div>'+
     '<div class="form-row mb8">'+
       fbField(mode,'entry','Ingresso')+fbField(mode,'mid','Percorrenza')+fbField(mode,'exit','Uscita')+
     '</div>'+
     '<div class="form-row mb8">'+
       '<div class="field"><label>Fiducia (0–10)</label><input id="dp-conf-'+mode+'" type="number" min="0" max="10" step="1" value="5"></div>'+
       '<div class="field"><label>Tempo rif. (s, opz.)</label><input id="dp-time-'+mode+'" type="number" step="0.01" placeholder="es. 92.45"></div>'+
       '<div class="field"><label>Qualità run</label><select id="dp-qual-'+mode+'">'+
         '<option value="ok">Pulita</option><option value="dubbia">Dubbia (traffico, errori)</option><option value="scarta">Da non contare</option></select></div>'+
     '</div>'+
     '<div class="field mb8"><label>Nota del pilota</label><input id="dp-note-'+mode+'" placeholder="es. nervosa in compressione sui dossi"></div>'+
     '<button class="btn btn-blue" style="font-size:11px" onclick="DP.logNow(\''+mode+'\')">💾 SALVA NELLO STORICO</button>';

  /* — storico — */
  var evs=(d.events||[]).slice(-8).reverse();
  h+='<div class="sa-sec" style="margin-top:14px">📚 ULTIME SESSIONI ('+nEv+' in totale)</div>';
  if(!evs.length){ h+='<div class="small" style="opacity:.7">Ancora niente. Il primo record si crea qui sopra.</div>'; }
  else {
    h+='<div style="overflow-x:auto"><table style="width:100%;font-size:11px;border-collapse:collapse">'+
       '<tr style="opacity:.7;text-align:left"><th>Data</th><th>Luogo</th><th>Sup.</th><th>I/P/U</th><th>Fid.</th><th>Tempo</th><th></th></tr>';
    evs.forEach(function(e){
      h+='<tr style="border-top:1px solid rgba(128,128,128,.18)">'+
         '<td>'+esc(new Date(e.ts).toLocaleDateString('it-IT'))+'</td>'+
         '<td>'+esc(e.venue||'')+'</td>'+
         '<td>'+esc(e.surface||'')+'</td>'+
         '<td>'+(e.fb? (sgn(e.fb.entry,0)+'/'+sgn(e.fb.mid,0)+'/'+sgn(e.fb.exit,0)) : '—')+'</td>'+
         '<td>'+(e.fb&&e.fb.conf!==undefined? e.fb.conf : '—')+'</td>'+
         '<td>'+(+e.timeS>0? (+e.timeS).toFixed(2) : '—')+'</td>'+
         '<td><button class="btn" style="font-size:10px;padding:2px 6px" onclick="DP.delEvent(\''+e.id+'\',\''+mode+'\')">✕</button></td></tr>';
    });
    h+='</table></div>';
  }
  return h;
}

function fbField(mode, ph, lab){
  return '<div class="field"><label>'+lab+'</label>'+
    '<input id="dp-fb-'+ph+'-'+mode+'" type="number" min="-5" max="5" step="1" value="0"></div>';
}

/* ─── 13. AZIONI ─────────────────────────────────────────────────────────── */
function render(mode){
  try {
    var el=document.getElementById('dp-body-'+mode);
    if(el) el.innerHTML = bodyHTML(mode);
  } catch(e){ try { console.warn('DP render', e); } catch(_){} }
}
function renderAll(){ render('track'); render('rally'); }

function inject(){
  try {
    var pgT=document.getElementById('page-setup');
    if(pgT && !document.getElementById('dp-panel-track')){ pgT.insertAdjacentHTML('beforeend', panelHTML('track')); render('track'); }
    var pgR=document.getElementById('page-rally-setup');
    if(pgR && !document.getElementById('dp-panel-rally')){ pgR.insertAdjacentHTML('beforeend', panelHTML('rally')); render('rally'); }
  } catch(e){}
}

var DP = {
  KEY: DPKEY, AXES: AXES, QUIZ: QUIZ, ARCH: ARCH,
  load: load, save: save, list: list, get: get, active: active, setActive: setActive,
  addDriver: addDriver, renameDriver: renameDriver, delDriver: delDriver,
  styleOf: styleOf, archetypeOf: archetypeOf, targetsOf: targetsOf, seedFromQuiz: seedFromQuiz,
  venueKey: venueKey, venueName: venueName, venueMemory: venueMemory, setupDiff: setupDiff,
  logEvent: logEvent, adviseCore: advise, render: render, renderAll: renderAll, inject: inject,
  radarSVG: radarSVG, isLowGrip: isLowGrip
};
window.DP = DP;

DP.pick = function(id, mode){ setActive(id); render(mode); };

DP.newDriver = function(mode){
  var n=prompt('Nome del pilota:');
  if(n===null) return;
  if(!String(n).trim()){ toast('Nome vuoto'); return; }
  addDriver(n);
  render(mode);
  toast('Pilota aggiunto — ora il questionario');
  setTimeout(function(){ DP.quiz(mode); }, 250);
};

DP.quiz = function(mode){
  var d=active(); if(!d){ toast('Nessun pilota'); return; }
  var answers=[], i=0;
  for(i=0;i<QUIZ.length;i++){
    var q=QUIZ[i];
    var txt=(i+1)+'/'+QUIZ.length+' — '+q.q+'\n\n';
    q.a.forEach(function(a,j){ txt+=(j+1)+') '+a.t+'\n'; });
    txt+='\nRispondi con 1, 2 o 3:';
    var r=prompt(txt, '2');
    if(r===null){ toast('Questionario annullato'); return; }
    var k=parseInt(r,10);
    if(!(k>=1 && k<=q.a.length)){ toast('Risposta non valida, questionario interrotto'); return; }
    answers.push(k-1);
  }
  var seed=seedFromQuiz(answers);
  update(d.id, function(x){ x.seed=seed; x.quizAt=Date.now(); });
  render(mode);
  var st=styleOf(get(d.id)), ar=archetypeOf(st);
  toast('Profilo creato: '+ar.arch.name);
};

DP.tune = function(mode){
  var d=active(); if(!d) return;
  var st=styleOf(d), man=Object.assign({}, d.manual||{});
  for(var i=0;i<AXES.length;i++){
    var a=AXES[i];
    var cur=Math.round((st[a.k]?st[a.k].v:0.5)*100);
    var r=prompt(a.lab+' — 0 = '+a.lo+', 100 = '+a.hi+'\n(vuoto = lascia com\'è, "auto" = torna al valore calcolato)', String(cur));
    if(r===null) return;
    r=String(r).trim();
    if(r==='') continue;
    if(/^auto$/i.test(r)){ delete man[a.k]; continue; }
    var v=parseFloat(r);
    if(isFinite(v)) man[a.k]=clamp(v/100,0,1);
  }
  update(d.id, function(x){ x.manual=man; });
  render(mode);
  toast('Assi aggiornati');
};

DP.advise = function(mode){
  var out=document.getElementById('dp-adv-'+mode);
  if(!out) return;
  try {
    var r=advise(mode);
    if(r.err){ out.innerHTML='<div class="small" style="color:var(--yellow,#e0b32a)">'+esc(r.err)+'</div>'; return; }
    var t=r.targets, A=r.A0;
    var h='';
    h+='<div class="small" style="line-height:1.7;margin-bottom:6px">Bilanciamento voluto da <b>'+esc(r.driver.name)+'</b> '+
       (r.lowGrip? '<span style="opacity:.8">(condizioni di poca aderenza)</span> ':'')+'— scostamento rispetto al neutro:<br>'+
       'Ingresso <b>'+sgn(t.entry*100,1)+'</b> · Percorrenza <b>'+sgn(t.mid*100,1)+'</b> · Uscita <b>'+sgn(t.exit*100,1)+'</b> '+
       '<span style="opacity:.6">(positivo = più girevole)</span></div>';
    h+='<div class="small" style="opacity:.75;margin-bottom:8px">Auto adesso: ingresso '+sgn(A.phases.entry.U*100,1)+
       ' · percorrenza '+sgn(A.phases.mid.U*100,1)+' · uscita '+sgn(A.phases.exit.U*100,1)+
       ' → scarto medio <b>'+(r.e0*100).toFixed(1)+' pt</b></div>';

    if(!r.moves.length){
      h+='<div class="small" style="color:var(--green,#3fbf6f)">L\'auto è già coerente con il suo stile: nessuna modifica utile trovata. '+
         'Se vuoi più opzioni, compila più campi (barre, differenziale, bias).</div>';
    } else {
      h+='<div class="small" style="margin-bottom:4px">Massimo 3 mosse, una alla volta, poi si verifica:</div>'+
         '<ol style="margin:0 0 6px 18px;font-size:12px;line-height:1.9">';
      r.moves.forEach(function(m){
        var why=[];
        if(Math.abs(m.gain)>0.01) why.push('avvicina il bilanciamento a quello che chiede ('+sgn(m.gain,2)+'s equivalenti)');
        if(m.dt<-0.005) why.push('e fa anche guadagnare '+Math.abs(m.dt).toFixed(3)+'s');
        else if(m.dt>0.005) why.push('al costo di '+m.dt.toFixed(3)+'s sul giro');
        h+='<li><b>'+esc(m.lab)+'</b> <span class="small">'+esc(m.conf||'')+'</span><br>'+
           '<span style="opacity:.78;font-size:11px">'+esc(why.join(', '))+'</span></li>';
      });
      h+='</ol>';
    }
    /* motivazioni dal profilo */
    var wh=[];
    ['entry','mid','exit'].forEach(function(ph){
      (t._why[ph]||[]).forEach(function(w){ if(w.why && wh.indexOf(w.why)<0) wh.push(w.why); });
    });
    if(wh.length) h+='<div class="small" style="opacity:.7;margin-top:4px">Perché: '+esc(wh.join(' · '))+'.</div>';
    var vm=venueMemory(r.driver, venueKey(mode));
    if(vm) h+='<div class="small" style="opacity:.7;margin-top:2px">Storico qui: '+vm.runs+' sessioni, fiducia media '+vm.avgConf.toFixed(1)+'/10.</div>';
    out.innerHTML=h;
  } catch(e){
    out.innerHTML='<div class="small" style="color:var(--yellow,#e0b32a)">Errore: '+esc(e.message)+'</div>';
  }
};

DP.logNow = function(mode){
  var d=active(); if(!d){ toast('Nessun pilota selezionato'); return; }
  function n(id, dflt){ var el=document.getElementById(id); var v=el? parseFloat(el.value) : NaN; return isFinite(v)? v : dflt; }
  var fb={
    entry: clamp(n('dp-fb-entry-'+mode,0), -5, 5),
    mid:   clamp(n('dp-fb-mid-'+mode,0),   -5, 5),
    exit:  clamp(n('dp-fb-exit-'+mode,0),  -5, 5),
    conf:  clamp(n('dp-conf-'+mode,5), 0, 10)
  };
  var setup=null; try { setup=saReadFields(mode); } catch(e){}
  var car=null; try { car=saCar(mode); } catch(e){}
  var ev={
    id:'e'+Date.now().toString(36)+Math.floor(Math.random()*1e3).toString(36),
    ts:Date.now(), mode:mode,
    venue:venueName(mode), surface:surfNow(mode), venueKey:venueKey(mode),
    car: car? car.name : '', carType: car? car.type : '',
    setup:setup, fb:fb,
    timeS: n('dp-time-'+mode, 0),
    quality: (document.getElementById('dp-qual-'+mode)||{}).value || 'ok',
    note: (document.getElementById('dp-note-'+mode)||{}).value || ''
  };
  logEvent(d.id, ev);
  render(mode);
  var st=styleOf(get(d.id)), ar=archetypeOf(st);
  toast('Sessione registrata — profilo di '+d.name+': '+ar.arch.name);
  try { if(typeof triggerAutoSave==='function') triggerAutoSave(); } catch(e){}
};

DP.delEvent = function(evId, mode){
  var d=active(); if(!d) return;
  if(!confirm('Eliminare questa sessione dallo storico?')) return;
  update(d.id, function(x){ x.events=(x.events||[]).filter(function(e){ return e.id!==evId; }); });
  render(mode);
};

DP.exportJSON = function(){
  try {
    var blob=new Blob([JSON.stringify(load(),null,2)], {type:'application/json'});
    var a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='profili_piloti_'+new Date().toISOString().slice(0,10)+'.json';
    a.click();
    toast('Profili esportati');
  } catch(e){ toast('Export fallito: '+e.message); }
};

/* ─── 14. AGGANCI ────────────────────────────────────────────────────────── */
/* i profili entrano nei salvataggi/ripristini di sessione */
if(typeof window.serializeSession==='function' && !window._dpSerWrapped){
  window._dpSerWrapped=true;
  var _oS=window.serializeSession;
  window.serializeSession=function(){
    var snap=_oS.apply(this, arguments);
    try { if(snap){ snap._repModules=snap._repModules||{}; var v=localStorage.getItem(DPKEY); if(v!==null) snap._repModules[DPKEY]=v; } } catch(e){}
    return snap;
  };
}
if(typeof window.restoreSession==='function' && !window._dpResWrapped){
  window._dpResWrapped=true;
  var _oR=window.restoreSession;
  window.restoreSession=function(snap){
    try { if(snap && snap._repModules && snap._repModules[DPKEY]) localStorage.setItem(DPKEY, snap._repModules[DPKEY]); } catch(e){}
    var r=_oR.apply(this, arguments);
    setTimeout(renderAll, 200);
    return r;
  };
}
/* ricordare la sessione dopo il salvataggio di un setup */
['saveSetup','saveRallySetup'].forEach(function(fn){
  if(typeof window[fn]==='function' && !window['_dp_'+fn]){
    window['_dp_'+fn]=true;
    var o=window[fn];
    window[fn]=function(){
      var r=o.apply(this, arguments);
      try { if(active()) toast('Setup salvato — ricordati di registrare il feedback nel profilo pilota'); } catch(e){}
      setTimeout(function(){ render(fn==='saveSetup'?'track':'rally'); }, 150);
      return r;
    };
  }
});
/* ridisegno quando si cambia pagina */
if(typeof window.showPage==='function' && !window._dpPageWrapped){
  window._dpPageWrapped=true;
  var _oP=window.showPage;
  window.showPage=function(id){
    var r=_oP.apply(this, arguments);
    if(id==='setup' || id==='rally-setup'){ setTimeout(function(){ inject(); render(id==='setup'?'track':'rally'); }, 80); }
    return r;
  };
}

/* ─── 15. AVVIO ──────────────────────────────────────────────────────────── */
function boot(){ inject(); renderAll(); }
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(boot, 900); });
else setTimeout(boot, 900);
setTimeout(inject, 2500);
setTimeout(inject, 6000);

})();

</script>
<script>
/* ═══════════════════════════════════════════════════════════════════════════
   MODULO COSTI E BUDGET (CB) — v1.0
   Ogni componente del libretto vita ha un costo → costo al km, costo della
   giornata, budget di stagione e proiezione degli interventi futuri.
   Si aggancia in sola lettura a REP_life_v1 (libretto vita); registra da solo
   una spesa quando un componente viene dato per "FATTO".
   Storage: REP_cost_v1
   ═══════════════════════════════════════════════════════════════════════════ */
(function(){
'use strict';
if(window.CB) return;

var KEY='REP_cost_v1';
var LIFEKEY='REP_life_v1';

var DEF = {
  cfg:{ cur:'€', hourRate:35, kmRace:0, racesTotal:8, racesDone:0, year:new Date().getFullYear(), budget:0 },
  comp:{},      // "VETTURA::compId" -> {price, hours, note}
  cons:{},      // "VETTURA" -> [ {id,name,cost,kmLife,note} ]
  fixed:[],     // [ {id,name,amount,per:'gara'|'giorno'|'stagione'} ]
  spend:[]      // [ {id,ts,car,cat,label,amount,note,auto} ]
};

/* ─── utilità ─────────────────────────────────────────────────────────────── */
function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function toast(m){ try{ if(typeof showToast==='function') showToast(m); }catch(e){} }
function num(v,d){ var x=parseFloat(String(v==null?'':v).replace(',','.')); return isFinite(x)? x : (d||0); }
function uid(p){ return (p||'x')+Date.now().toString(36)+Math.floor(Math.random()*1e4).toString(36); }

function load(){
  var o;
  try { o=JSON.parse(localStorage.getItem(KEY)||'null'); } catch(e){ o=null; }
  if(!o||typeof o!=='object') o=JSON.parse(JSON.stringify(DEF));
  o.cfg=Object.assign({}, DEF.cfg, o.cfg||{});
  o.comp=o.comp||{}; o.cons=o.cons||{}; o.fixed=o.fixed||[]; o.spend=o.spend||[];
  return o;
}
function save(o){ try{ localStorage.setItem(KEY, JSON.stringify(o)); }catch(e){ toast('Memoria piena: costi non salvati'); } }
function edit(fn){ var o=load(); fn(o); save(o); return o; }

function life(){
  try { var o=JSON.parse(localStorage.getItem(LIFEKEY)||'null'); if(o&&o.cars) return o; } catch(e){}
  return {cars:{}, log:[]};
}
function cars(){ return Object.keys(life().cars); }

function money(n){
  var o=load();
  if(!isFinite(n)) n=0;
  var s=Math.abs(n)>=1000? Math.round(n).toLocaleString('it-IT') : (Math.round(n*100)/100).toLocaleString('it-IT',{maximumFractionDigits:2});
  return s+' '+o.cfg.cur;
}
function money2(n){
  var o=load();
  if(!isFinite(n)) n=0;
  return (Math.round(n*100)/100).toLocaleString('it-IT',{minimumFractionDigits:2, maximumFractionDigits:2})+' '+o.cfg.cur;
}

/* ─── km medi per giornata di prova/gara, dedotti dal libretto ────────────── */
function kmPerDaySuggested(carName){
  var L=life();
  var days={};
  (L.log||[]).forEach(function(e){
    if(carName && e.car!==carName) return;
    if(!e.ps) return;                                  // solo km di prova/gara
    var d=new Date(e.at||Date.now()).toISOString().slice(0,10);
    days[d]=(days[d]||0)+(+e.km||0);
  });
  var ks=Object.keys(days);
  if(!ks.length) return 0;
  var tot=ks.reduce(function(s,k){ return s+days[k]; },0);
  return tot/ks.length;
}
function kmRace(carName){
  var o=load();
  if(+o.cfg.kmRace>0) return +o.cfg.kmRace;
  var s=kmPerDaySuggested(carName);
  return s>0? s : 0;
}

/* ─── costo di un intervento su un componente ─────────────────────────────── */
function compKey(car, id){ return car+'::'+id; }
function compCost(car, p){
  var o=load();
  var c=o.comp[compKey(car,p.id)]||{};
  var price=+c.price||0, hours=+c.hours||0;
  return { price:price, hours:hours, labour:hours*(+o.cfg.hourRate||0), total:price+hours*(+o.cfg.hourRate||0), note:c.note||'' };
}

/* ─── costo al km ─────────────────────────────────────────────────────────── */
function perKm(carName){
  var L=life(), C=L.cars[carName];
  var out={ comps:0, cons:0, total:0, rows:[], missing:[] };
  if(!C) return out;
  (C.comps||[]).forEach(function(p){
    if(p.retired) return;
    var lim=+p.limit||0;
    var cc=compCost(carName,p);
    if(lim<=0){ if(cc.total>0) out.missing.push(p.name+' (nessun limite km)'); return; }
    if(cc.total<=0){ out.missing.push(p.name+' (nessun costo)'); return; }
    var k=cc.total/lim;
    out.comps+=k;
    out.rows.push({ name:p.name, kind:p.kind, cost:cc.total, limit:lim, perKm:k, km:+p.km||0, left:Math.max(0,lim-(+p.km||0)) });
  });
  var o=load();
  (o.cons[carName]||[]).forEach(function(c){
    var kl=+c.kmLife||0, cost=+c.cost||0;
    if(kl<=0||cost<=0) return;
    var k=cost/kl;
    out.cons+=k;
    out.rows.push({ name:c.name, kind:'consumo', cost:cost, limit:kl, perKm:k, km:null, left:null, isCons:true, id:c.id });
  });
  out.rows.sort(function(a,b){ return b.perKm-a.perKm; });
  out.total=out.comps+out.cons;
  return out;
}

/* ─── costo di una giornata / di una gara ─────────────────────────────────── */
function fixedSum(per){
  var o=load(), s=0;
  o.fixed.forEach(function(f){ if(f.per===per) s+=+f.amount||0; });
  return s;
}
function dayCost(carName, km){
  var pk=perKm(carName).total;
  var k=(km!=null? km : kmRace(carName));
  return { km:k, usura:k*pk, fissi:fixedSum('giorno'), total:k*pk+fixedSum('giorno') };
}
function raceCost(carName){
  var pk=perKm(carName).total;
  var k=kmRace(carName);
  return { km:k, usura:k*pk, fissi:fixedSum('gara'), total:k*pk+fixedSum('gara') };
}

/* ─── proiezione: quali interventi cadono nelle prossime gare ─────────────── */
function projection(carName, nRaces){
  var L=life(), C=L.cars[carName];
  var km=kmRace(carName);
  var out={ km:km, races:nRaces||3, items:[], total:0, byRace:[] };
  if(!C||km<=0) return out;
  (C.comps||[]).forEach(function(p){
    if(p.retired) return;
    var lim=+p.limit||0; if(lim<=0) return;
    var left=lim-(+p.km||0);
    var races=left/km;                       // gare che mancano al limite
    var cc=compCost(carName,p);
    out.items.push({ name:p.name, kind:p.kind||'revisione', left:left, races:races,
                     cost:cc.total, hasCost:cc.total>0 });
  });
  out.items.sort(function(a,b){ return a.races-b.races; });
  var n=out.races;
  out.items.forEach(function(it){ if(it.races<=n) out.total+=it.cost; });
  for(var r=1;r<=n;r++){
    /* la prima gara raccoglie anche ciò che è GIÀ oltre il limite (gare residue ≤ 0) */
    var inR=out.items.filter(function(it){ return (r===1? it.races<=1 : (it.races>r-1 && it.races<=r)); });
    out.byRace.push({ race:r, items:inR, sum:inR.reduce(function(s,x){ return s+x.cost; },0) });
  }
  return out;
}

/* ─── budget di stagione ──────────────────────────────────────────────────── */
function season(carName){
  var o=load(), y=+o.cfg.year||new Date().getFullYear();
  var spent=0;
  o.spend.forEach(function(s){ if(new Date(s.ts).getFullYear()===y) spent+=+s.amount||0; });
  var tot=+o.cfg.racesTotal||0, done=+o.cfg.racesDone||0;
  var left=Math.max(0, tot-done);
  var rc=raceCost(carName);
  var proj=projection(carName, left);
  var futureRun=left*rc.total;                       // usura + fissi per gara
  var futureJobs=proj.total;                         // interventi che cadranno
  var fixedSeason=fixedSum('stagione');
  var forecast=spent+futureRun+futureJobs+(done===0? fixedSeason : 0);
  return { year:y, budget:+o.cfg.budget||0, spent:spent, racesTotal:tot, racesDone:done, racesLeft:left,
           perRace:rc.total, futureRun:futureRun, futureJobs:futureJobs, fixedSeason:fixedSeason,
           forecast:forecast, delta:(+o.cfg.budget||0)-forecast };
}

/* ─── registro spese ──────────────────────────────────────────────────────── */
function addSpend(sp){
  edit(function(o){
    o.spend.push(Object.assign({ id:uid('s'), ts:Date.now(), cat:'varie', amount:0, auto:false }, sp));
    if(o.spend.length>1000) o.spend=o.spend.slice(-1000);
  });
}

