function renderWidgetNextSession() {
  try {
    var arr = JSON.parse(localStorage.getItem(_SCHEDULE_KEY||'rep_weekend_schedule_v1')||'[]');
    var now = Date.now();
    var upcoming = arr.map(function(s){
      var dt = new Date(s.day+'T'+s.start+':00').getTime();
      var end = dt + (+s.duration||30)*60000;
      return { s:s, dt:dt, end:end };
    }).filter(function(r){return r.end > now;}).sort(function(a,b){return a.dt-b.dt;});
    if(!upcoming.length) return '<div style="padding:14px;text-align:center;color:var(--text3);font-size:11px;">Nessuna sessione programmata.<br><a href="#" onclick="scrollTo(0,0);return false;" style="color:var(--accent3);">Aggiungila in Overview →</a></div>';
    var n = upcoming[0];
    var delta = n.dt - now;
    var status, color;
    if(delta <= 0){ status='🔴 IN CORSO'; color='var(--red)'; }
    else if(delta < 15*60000){ status='⚠️ -'+Math.ceil(delta/60000)+' min'; color='var(--accent3)'; }
    else if(delta < 3600000){ status='⏳ '+Math.ceil(delta/60000)+' min'; color='var(--yellow)'; }
    else {
      var h = Math.floor(delta/3600000);
      var m = Math.ceil((delta%3600000)/60000);
      status = '🗓 '+(h>0?h+'h ':'')+m+'min';
      color = 'var(--text2)';
    }
    var label = (n.s.name ? n.s.name+' ' : '')+'['+(n.s.type||'?')+']';
    return '<div style="padding:4px 0;">'+
      '<div style="font-family:var(--mono);font-size:16px;color:'+color+';font-weight:700;margin-bottom:4px;">'+status+'</div>'+
      '<div style="font-size:12px;color:var(--text1);margin-bottom:2px;">'+label+'</div>'+
      '<div style="font-size:11px;color:var(--text3);font-family:var(--mono);">'+n.s.start+' · '+n.s.duration+' min</div>'+
    '</div>';
  } catch(e) { return '<div style="padding:10px;color:var(--text3);font-size:11px;">—</div>'; }
}
