var _undoStack = [];
var UNDO_MAX = 15;
function pushUndo(description, restoreFn) {
  _undoStack.push({ description:description, restoreFn:restoreFn, time:Date.now() });
  if(_undoStack.length > UNDO_MAX) _undoStack.shift();
  updateUndoButton();
}
function undoLast() {
  var action = _undoStack.pop();
  if(!action) { showToast('Nessuna azione da annullare'); return; }
  try { action.restoreFn(); showToast('&#8629; Annullato: '+action.description); updateUndoButton(); }
  catch(e) { showToast('Errore undo: '+e.message); }
}
function updateUndoButton() {
  var last = _undoStack[_undoStack.length-1];
  document.querySelectorAll('.undo-btn').forEach(function(btn) {
    btn.disabled = !last;
    btn.title = last ? 'Annulla: '+last.description+' (Ctrl+Z)' : 'Nessuna azione (Ctrl+Z)';
    btn.style.opacity = last ? '1' : '0.4';
  });
}
document.addEventListener('keydown', function(e) {
  if((e.ctrlKey||e.metaKey) && e.key==='z' && !['INPUT','TEXTAREA','SELECT'].includes(e.target.tagName)) {
    e.preventDefault(); undoLast();
  }
});

