    else if(_barcodeTarget.kind === 'tyre' || _barcodeTarget.kind === 'tyre-mounted') titleEl.textContent = '📷 SCAN CODICE GOMMA' + (_barcodeTarget.wheel ? ' — ' + _barcodeTarget.wheel : '');
    else titleEl.textContent = '📷 SCAN CODICE';
  }
  // Adapt action button visibility
  var addPartBtn = document.getElementById('barcode-addpart-btn');
  if(addPartBtn) addPartBtn.style.display = (_barcodeTarget==='spare-part' || !_barcodeTarget) ? '' : 'none';
  var applyBtn = document.getElementById('barcode-apply-btn');
  if(applyBtn) applyBtn.style.display = (_barcodeTarget && _barcodeTarget!=='spare-part') ? '' : 'none';
