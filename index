}

function _reportFmtMs(ms){
  if(!ms||!isFinite(ms)||ms<=0) return '—';
  var min = Math.floor(ms/60000);
  var sec = ((ms%60000)/1000).toFixed(3);
  if(sec.length === 5) sec = '0'+sec;
  return min+':'+sec;
}

function _reportDmgBadge(v){
  if(!v||v==='ok'||v==='OK') return '<span class="green">ok</span>';
  if(v==='minor') return '<span class="yellow">minor</span>';
  if(v==='major'||v==='critical') return '<span class="red">'+v+'</span>';
  return '<span class="muted">'+v+'</span>';
}

// ─── 1) WEEKEND REPORT ──────────────────────────────────────────
function _generateWeekendReport(){
  var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
  var now = new Date().toLocaleString('it-IT');
  var circuit = (typeof CIRCUIT !== 'undefined' && CIRCUIT && CIRCUIT.name) ? CIRCUIT.name : (STATE.circuit||'—');

  var sessionsSet = new Set();
  allCars.forEach(function(car){
    (STATE.laps[car.id]||[]).forEach(function(l){ if(l.session) sessionsSet.add(l.session); });
  });
  var sessions = Array.from(sessionsSet);

  if(!sessions.length){ showToast('⚠️ Nessuna sessione registrata'); return; }

  var perSession = sessions.map(function(s){
    var perCar = [];
    var sessBest = Infinity;
    allCars.forEach(function(car){
      var laps = (STATE.laps[car.id]||[]).filter(function(l){return l.session === s;});
      if(!laps.length) return;
      var times = laps.map(function(l){return parseTime(l.time);}).filter(function(t){return t&&isFinite(t);});
      if(!times.length) return;
      var best = Math.min.apply(null, times);
      var avg = times.reduce(function(a,b){return a+b;},0)/times.length;
      perCar.push({ car:car, best:best, avg:avg, count:times.length });
      if(best < sessBest) sessBest = best;
    });
    return { session: s, cars: perCar, sessBest: sessBest };
  });

  var totalLaps = 0, weekendBest = Infinity, weekendBestCar = '', weekendBestSess = '';
  perSession.forEach(function(ps){
    ps.cars.forEach(function(c){
      totalLaps += c.count;
      if(c.best < weekendBest){ weekendBest = c.best; weekendBestCar = c.car.name; weekendBestSess = ps.session; }
    });
  });

  var html = '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><title>Report Weekend</title><style>'+_reportNewCss()+'</style></head><body>';
  html += '<div class="cover">'+
    '<div class="cover-title">WEEKEND REPORT</div>'+
    '<div class="cover-sub">'+circuit+'</div>'+
    '<div class="cover-meta">'+
      '<div><b>Modalità:</b> '+(STATE.mode||'—').toUpperCase()+'</div>'+
      '<div><b>Sessioni:</b> '+sessions.length+' ('+sessions.join(', ')+')</div>'+
      '<div><b>Vetture:</b> '+allCars.filter(function(c){return !c.retired;}).map(function(c){return c.name;}).join(' · ')+'</div>'+
      '<div><b>Generato il:</b> '+now+'</div>'+
    '</div>'+
  '</div>';

  html += '<h1>🏁 Riepilogo Weekend</h1>';
