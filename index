      if(!teamTotals[t]) teamTotals[t] = { total:0, drivers:[], wins:0, races:0 };
      teamTotals[t].total += r.total;
      teamTotals[t].wins += r.wins;
      teamTotals[t].races += r.races;
      teamTotals[t].drivers.push(r.driver.name);
    });
    var teamArr = Object.keys(teamTotals).map(function(k){return Object.assign({name:k}, teamTotals[k]);})
