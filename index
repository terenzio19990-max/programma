// DIARIO DI BORDO — free-form journal entries per weekend
// ═══════════════════════════════════════════════════════════════
var DIARY_KEY = 'REP_diary_v1';
var _diary = null;          // cache: { entries: [...] }
var _diarySelectedId = null;

function _diaryLoad(){
  if(_diary) return _diary;
  try {
    _diary = JSON.parse(localStorage.getItem(DIARY_KEY)||'null') || { entries: [] };
    if(!Array.isArray(_diary.entries)) _diary.entries = [];
  } catch(_) { _diary = { entries: [] }; }
  return _diary;
}
function _diarySave(){
  try { localStorage.setItem(DIARY_KEY, JSON.stringify(_diary || {entries:[]})); } catch(_){}
}
function _diaryFmtDate(ts){
  if(!ts) return '—';
  try {
    var d = new Date(ts);
    return d.toLocaleDateString('it-IT', {day:'2-digit', month:'short', year:'numeric'});
  } catch(_) { return '—'; }
}
function _diaryFmtRelative(ts){
  if(!ts) return '';
  var diffMs = Date.now() - ts;
  var min = Math.floor(diffMs/60000);
  if(min < 1) return 'ora';
  if(min < 60) return min+'m fa';
  var h = Math.floor(min/60);
  if(h < 24) return h+'h fa';
  var d = Math.floor(h/24);
  if(d < 7) return d+'g fa';
  return _diaryFmtDate(ts);
}

// Create a new empty entry and select it
function diaryNewEntry(){
  _diaryLoad();
  var today = new Date();
  var todayIso = today.toISOString().slice(0,10);
  var defaultTitle = 'Note del '+today.toLocaleDateString('it-IT',{day:'2-digit',month:'long',year:'numeric'});
  var entry = {
    id: Date.now() + Math.random().toString(36).substr(2,5),
    createdAt: Date.now(),
    updatedAt: Date.now(),
    title: defaultTitle,
    date: todayIso,
    circuit: STATE.circuit || '',
    mode: STATE.mode || 'track',
    season: String(today.getFullYear()),
    tags: [],
    content: ''
  };
  _diary.entries.unshift(entry);
  _diarySave();
  _diarySelectedId = entry.id;
  renderDiaryPage();
  // Focus the editor textarea
  setTimeout(function(){
    var ta = document.getElementById('diary-content');
    if(ta) ta.focus();
  }, 100);
}
window.diaryNewEntry = diaryNewEntry;

function diaryDelete(id){
  _diaryLoad();
  var entry = _diary.entries.find(function(e){return e.id===id;});
  if(!entry) return;
  if(!confirm('Eliminare l\'entry "'+(entry.title||'(senza titolo)')+'"?\n\nL\'azione è permanente.')) return;
  _diary.entries = _diary.entries.filter(function(e){return e.id!==id;});
  _diarySave();
  if(_diarySelectedId === id) _diarySelectedId = null;
  renderDiaryPage();
  showToast('🗑 Entry eliminata');
}
window.diaryDelete = diaryDelete;

function diarySelect(id){
  _diarySelectedId = id;
  renderDiaryPage();
}
window.diarySelect = diarySelect;

// Save changes from the editor back to the entry
function diarySaveCurrent(){
  if(!_diarySelectedId) return;
  _diaryLoad();
  var e = _diary.entries.find(function(x){return x.id===_diarySelectedId;});
  if(!e) return;
  var titleEl = document.getElementById('diary-title');
  var dateEl = document.getElementById('diary-date');
  var circuitEl = document.getElementById('diary-circuit');
  var tagsEl = document.getElementById('diary-tags');
  var contentEl = document.getElementById('diary-content');
  if(titleEl) e.title = titleEl.value.trim() || 'Senza titolo';
  if(dateEl) e.date = dateEl.value;
  if(circuitEl) e.circuit = circuitEl.value;
  if(tagsEl) e.tags = tagsEl.value.split(',').map(function(t){return t.trim();}).filter(Boolean);
  if(contentEl) e.content = contentEl.value;
  e.updatedAt = Date.now();
  // Update season from date
  if(e.date){ try { e.season = String(new Date(e.date).getFullYear()); } catch(_){} }
  _diarySave();
  // Re-render the list to update title/date display, but don't refresh the editor (would lose focus)
  _diaryRenderList();
  _diaryRenderStats();
}
window.diarySaveCurrent = diarySaveCurrent;

function diaryCopyToClipboard(){
  if(!_diarySelectedId) return;
  _diaryLoad();
  var e = _diary.entries.find(function(x){return x.id===_diarySelectedId;});
  if(!e) return;
  var txt = e.title+'\n'+(e.date||'')+(e.circuit?' · '+e.circuit:'')+'\n\n'+(e.content||'');
  if(navigator.clipboard){
    navigator.clipboard.writeText(txt).then(function(){
      showToast('✓ Copiato negli appunti');
    }).catch(function(){ showToast('Errore clipboard'); });
  } else {
    showToast('Clipboard non disponibile');
  }
}
window.diaryCopyToClipboard = diaryCopyToClipboard;

function diaryExport(){
  _diaryLoad();
  if(!_diary.entries.length){ showToast('Diario vuoto'); return; }
  var json = JSON.stringify(_diary, null, 2);
  var blob = new Blob([json], {type:'application/json'});
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = 'diario-bordo-'+new Date().toISOString().slice(0,10)+'.json';
  a.click();
  setTimeout(function(){URL.revokeObjectURL(url);}, 1500);
  showToast('📤 Export diario ('+_diary.entries.length+' entry)');
}
window.diaryExport = diaryExport;

// Apply filters and search to entries
function _diaryFilteredEntries(){
  _diaryLoad();
  var q = (document.getElementById('diary-search')?.value || '').toLowerCase().trim();
  var circuitF = document.getElementById('diary-circuit-filter')?.value || '';
  var seasonF = document.getElementById('diary-season-filter')?.value || '';
  return _diary.entries.filter(function(e){
    if(circuitF && e.circuit !== circuitF) return false;
    if(seasonF && e.season !== seasonF) return false;
    if(q){
      var hay = ((e.title||'') + ' ' + (e.content||'') + ' ' + (e.tags||[]).join(' ')).toLowerCase();
      if(hay.indexOf(q) < 0) return false;
    }
    return true;
  }).sort(function(a,b){return (b.date||'').localeCompare(a.date||'') || (b.updatedAt||0) - (a.updatedAt||0);});
}

// Populate circuit + season filter dropdowns
function _diaryPopulateFilters(){
  _diaryLoad();
  var cf = document.getElementById('diary-circuit-filter');
  var sf = document.getElementById('diary-season-filter');
  if(cf){
    var prevC = cf.value;
    var circuits = Array.from(new Set(_diary.entries.map(function(e){return e.circuit||'';}).filter(Boolean))).sort();
    cf.innerHTML = '<option value="">Tutti i circuiti</option>' +
      circuits.map(function(c){
        var name = (typeof CIRCUITS !== 'undefined' && CIRCUITS[c] && CIRCUITS[c].name) ? CIRCUITS[c].name : c;
        return '<option value="'+c+'">'+name+'</option>';
      }).join('');
    if(prevC) cf.value = prevC;
  }
  if(sf){
    var prevS = sf.value;
    var seasons = Array.from(new Set(_diary.entries.map(function(e){return e.season||'';}).filter(Boolean))).sort().reverse();
    sf.innerHTML = '<option value="">Tutte le stagioni</option>' +
      seasons.map(function(s){return '<option value="'+s+'">'+s+'</option>';}).join('');
    if(prevS) sf.value = prevS;
  }
}

