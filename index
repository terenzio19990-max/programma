</script>
<script>
/* REP-GUARD-BEGIN v1 ==================================================
   GUARDIANO QUALITÀ: raccolta errori, backup automatici, monitor memoria
   - Ogni errore JS (anche promise) finisce in un log esportabile: badge
     🐞 in basso a destra quando succede qualcosa.
   - Backup automatico di TUTTI i dati locali ogni 30 min in IndexedDB
     (ultimi 6 conservati), con ripristino a un click.
   - Monitor quota memoria browser: avvisa PRIMA di perdere dati.
   REP-GUARD-END-MARKER */
(function(){
var G={ errs:[], lsBytes:0, qWarned:false, lsWarned:false };
window._repGuard=G;
function toastG(m){ try { if(typeof showToast==='function') showToast(m); } catch(e){} }
function pushErr(type,msg,src,line){
  var e={ t:Date.now(), type:type, msg:String(msg||'').slice(0,300), src:String(src||'').slice(0,140), line:line||0 };
  G.errs.push(e); if(G.errs.length>200) G.errs.shift();
  try {
    var saved=JSON.parse(localStorage.getItem('REP_errlog')||'[]');
    saved.push(e); if(saved.length>50) saved=saved.slice(-50);
    localStorage.setItem('REP_errlog', JSON.stringify(saved));
  } catch(ex){}
  badge();
}
window.addEventListener('error', function(ev){
  pushErr('error', ev.message||String(ev.type), ev.filename, ev.lineno);
});
window.addEventListener('unhandledrejection', function(ev){
  var r=ev&&ev.reason;
  pushErr('promise', (r&&r.message)||String(r));
});
function badge(){
  var b=document.getElementById('rep-guard-badge');
  if(!b){
    b=document.createElement('button');
    b.id='rep-guard-badge';
    b.style.cssText='position:fixed;right:12px;bottom:12px;z-index:99990;background:#2b0f12;color:#ff453a;border:1px solid #ff453a;border-radius:20px;padding:6px 12px;font-size:11px;font-weight:700;cursor:pointer;display:none';
    b.onclick=function(){ window.repGuardPanel(); };
    (document.body||document.documentElement).appendChild(b);
  }
  if(G.errs.length){ b.style.display='block'; b.textContent='🐞 '+G.errs.length+(G.errs.length===1?' errore':' errori'); }
  else b.style.display='none';
}
/* ── pannello ── */
window.repGuardPanel=function(){
  var old=document.getElementById('rep-guard-panel'); if(old){ old.remove(); return; }
  var d=document.createElement('div');
  d.id='rep-guard-panel';
  d.style.cssText='position:fixed;right:12px;bottom:52px;z-index:99991;background:#12141a;border:1px solid #333;border-radius:12px;padding:14px;width:440px;max-width:92vw;max-height:70vh;overflow:auto;box-shadow:0 8px 30px rgba(0,0,0,.6);font-size:12px;color:#e8eaf0';
  function esc2(x){ return String(x).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
  function p2(n){ return (n<10?'0':'')+n; }
  var rows=G.errs.slice(-25).reverse().map(function(e){
    var dt=new Date(e.t);
    return '<div style="border-bottom:1px solid #222;padding:4px 0"><span style="opacity:.5">'+p2(dt.getHours())+':'+p2(dt.getMinutes())+':'+p2(dt.getSeconds())+'</span> '+
      '<b style="color:#ff453a">'+esc2(e.type)+'</b> '+esc2(e.msg)+(e.src? ' <span style="opacity:.5">'+esc2(e.src.split('/').pop())+':'+e.line+'</span>':'')+'</div>';
  }).join('')||'<div style="opacity:.6">Nessun errore in questa sessione ✅</div>';
  var quotaTxt='Dati locali: ~'+(G.lsBytes/1048576).toFixed(2)+' MB';
  d.innerHTML='<div style="font-weight:800;margin-bottom:8px">🛡 GUARDIANO QUALITÀ</div>'+
    '<div style="margin-bottom:8px;opacity:.8">'+quotaTxt+'<span id="rep-guard-quota"></span></div>'+
    '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px">'+
    '<button class="btn btn-green" style="font-size:10px" onclick="repGuardBackup(true)">💾 BACKUP ORA</button>'+
    '<button class="btn btn-gray" style="font-size:10px" onclick="repGuardExport()">⬇ ESPORTA LOG</button>'+
    '<button class="btn btn-gray" style="font-size:10px" onclick="repGuardClear()">🧹 SVUOTA LOG</button>'+
    '<button class="btn btn-gray" style="font-size:10px" onclick="repGuardPanel()">✖ CHIUDI</button></div>'+
    '<div style="font-weight:700;margin-bottom:4px">Errori di questa sessione</div>'+rows+
    '<div style="font-weight:700;margin:10px 0 4px">Backup di sicurezza (automatici ogni 30 min)</div>'+
    '<div id="rep-guard-snaps" style="opacity:.8">carico…</div>';
  document.body.appendChild(d);
  try {
    if(navigator.storage&&navigator.storage.estimate) navigator.storage.estimate().then(function(est){
      var q=document.getElementById('rep-guard-quota');
      if(q&&est.quota) q.textContent=' · memoria browser: '+(100*est.usage/est.quota).toFixed(1)+'% usata';
    });
  } catch(e){}
  window.repGuardList(function(snaps){
    var h=document.getElementById('rep-guard-snaps'); if(!h) return;
    snaps.sort(function(a,b){ return b.t-a.t; });
    h.innerHTML=snaps.length? snaps.map(function(s){
      return '<div style="display:flex;gap:8px;align-items:center;margin-bottom:3px"><span>'+new Date(s.t).toLocaleString()+' · '+s.n+' chiavi</span>'+
        '<button class="btn btn-gray" style="font-size:9px" onclick="repGuardRestore('+s.t+')">↩ RIPRISTINA</button></div>';
    }).join('') : 'Nessun backup ancora (il primo parte 1 minuto dopo l\'avvio).';
  });
};
window.repGuardClear=function(){ G.errs=[]; try { localStorage.removeItem('REP_errlog'); } catch(e){} badge(); var pn=document.getElementById('rep-guard-panel'); if(pn){ pn.remove(); window.repGuardPanel(); } };
window.repGuardExport=function(){
  var hist=[]; try { hist=JSON.parse(localStorage.getItem('REP_errlog')||'[]'); } catch(e){}
  var all=hist.concat(G.errs);
  var txt='Race Engineer Pro — log errori · '+new Date().toISOString()+'\nUserAgent: '+navigator.userAgent+'\n\n'+
    all.map(function(e){ return new Date(e.t).toISOString()+' ['+e.type+'] '+e.msg+(e.src? ' @'+e.src+':'+e.line:''); }).join('\n');
  var a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([txt],{type:'text/plain'}));
  a.download='rep_log_errori_'+new Date().toISOString().slice(0,10)+'.txt';
  a.click();
};
/* ── quota memoria ── */
function quotaCheck(){
  try {
    var used=0;
    for(var i=0;i<localStorage.length;i++){ var k=localStorage.key(i); used+=(localStorage.getItem(k)||'').length+k.length; }
    G.lsBytes=used*2;
    if(G.lsBytes>4.2*1024*1024 && !G.lsWarned){
      G.lsWarned=true;
      toastG('⚠️ Dati locali ~'+(G.lsBytes/1048576).toFixed(1)+' MB: vicini al limite — fai ⬇ BACKUP COMPLETO ed esporta le sessioni vecchie');
    }
    if(navigator.storage&&navigator.storage.estimate){
      navigator.storage.estimate().then(function(est){
        if(est.quota && 100*est.usage/est.quota>80 && !G.qWarned){
          G.qWarned=true;
          toastG('⚠️ Memoria browser oltre l\'80%: backup consigliato subito');
        }
      });
    }
  } catch(e){}
}
/* ── backup automatici in IndexedDB ── */
function idb(cb){
  try {
    var r=indexedDB.open('rep_guard',1);
    r.onupgradeneeded=function(){ try { r.result.createObjectStore('snap',{keyPath:'t'}); } catch(e){} };
    r.onsuccess=function(){ cb(r.result); };
    r.onerror=function(){};
  } catch(e){}
}
window.repGuardBackup=function(manual){
  try {
    var dump={};
    for(var i=0;i<localStorage.length;i++){ var k=localStorage.key(i); dump[k]=localStorage.getItem(k); }
    var payload=JSON.stringify(dump);
    idb(function(db){
      try {
        var tx=db.transaction('snap','readwrite'), st=tx.objectStore('snap');
        st.put({ t:Date.now(), n:Object.keys(dump).length, bytes:payload.length, data:payload });
        var rq=st.getAllKeys? st.getAllKeys():null;
        if(rq) rq.onsuccess=function(){
          var ks=(rq.result||[]).slice().sort();
          while(ks.length>6){ try { st.delete(ks.shift()); } catch(e){} }
        };
        if(manual) toastG('💾 Backup di sicurezza salvato ('+Object.keys(dump).length+' chiavi)');
      } catch(e){}
    });
  } catch(e){}
};
window.repGuardList=function(cb){
  idb(function(db){
    try { var rq=db.transaction('snap').objectStore('snap').getAll();
      rq.onsuccess=function(){ cb(rq.result||[]); }; rq.onerror=function(){ cb([]); };
    } catch(e){ cb([]); }
  });
};
window.repGuardRestore=function(t){
  idb(function(db){
    try {
      var rq=db.transaction('snap').objectStore('snap').get(t);
      rq.onsuccess=function(){
        var s=rq.result; if(!s) return;
        if(!confirm('Ripristinare il backup del '+new Date(s.t).toLocaleString()+'?\nI dati attuali verranno sostituiti e la pagina ricaricata.')) return;
        try {
          var d=JSON.parse(s.data);
          localStorage.clear();
          Object.keys(d).forEach(function(k){ try { localStorage.setItem(k,d[k]); } catch(e){} });
          location.reload();
        } catch(e){ alert('Ripristino fallito: '+e.message); }
      };
    } catch(e){}
  });
};
setTimeout(quotaCheck, 8000);
setInterval(quotaCheck, 5*60*1000);
setTimeout(function(){ window.repGuardBackup(false); }, 60*1000);
setInterval(function(){ window.repGuardBackup(false); }, 30*60*1000);
})();

</script>
<script>
/* REP-LIFE-BEGIN v1 =====================================================
   LIBRETTO VITA COMPONENTI
   Ogni km percorso (PS, giri, trasferimenti) si somma alla vettura e ai
   componenti montati. Soglie di revisione/sostituzione definite dall'utente,
   con allarmi automatici all'avvicinarsi del fine vita.
   Storage: REP_life_v1 = { cars:{ nome:{ km, kmPS, h, comps:[...] } },
                            log:[...] }
   REP-LIFE-END-MARKER */
(function(){
var KEY='REP_life_v1';
var LIFE={ cars:{}, log:[] };
function load(){ try{ var o=JSON.parse(localStorage.getItem(KEY)||'null'); if(o&&o.cars) LIFE=o; }catch(e){} return LIFE; }
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(LIFE)); }catch(e){} }
function toastL(m){ try{ if(typeof showToast==='function') showToast(m); }catch(e){} }
function esc2(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'); }
load();
window._repLife=LIFE;

/* categorie tipiche con soglie di partenza (modificabili) */
var PRESET=[
 ['Motore','revisione',3000],['Cambio','revisione',3000],['Differenziale','revisione',2500],
 ['Frizione','sostituzione',1500],['Dischi freno ant.','sostituzione',800],
 ['Dischi freno post.','sostituzione',1200],['Pastiglie ant.','sostituzione',400],
 ['Pastiglie post.','sostituzione',600],['Ammortizzatori','revisione',2000],
 ['Cinture','scadenza',0],['Estintore','scadenza',0],['Serbatoio','scadenza',0]
];

window.lifeCar=function(nm){
  nm=String(nm||'').trim().toUpperCase()||'VETTURA';
  if(!LIFE.cars[nm]) LIFE.cars[nm]={ km:0, kmPS:0, comps:[] };
  return LIFE.cars[nm];
};
/* ── il cuore: aggiunge km alla vettura e a tutti i componenti attivi ── */
window.lifeAddKm=function(carName, km, isPS, note){
  km=+km||0; if(km<=0) return null;
  var C=window.lifeCar(carName);
  C.km=+(C.km+km).toFixed(2);
  if(isPS) C.kmPS=+(C.kmPS+km).toFixed(2);
  var alerts=[];
  (C.comps||[]).forEach(function(p){
    if(p.retired) return;
    p.km=+((p.km||0)+km).toFixed(2);
    if(isPS) p.kmPS=+((p.kmPS||0)+km).toFixed(2);
    var lim=+p.limit||0; if(lim<=0) return;
    var pct=100*p.km/lim;
    var warnAt=(p.warn!=null? +p.warn : 85);
    if(pct>=100 && p.state!=='over'){ p.state='over';
      alerts.push({ p:p, lvl:'over', msg:'🔴 '+carName+' — '+p.name+': LIMITE SUPERATO ('+p.km.toFixed(0)+'/'+lim+' km) → '+(p.kind||'revisione') });
    } else if(pct>=warnAt && !p.state){ p.state='warn';
      alerts.push({ p:p, lvl:'warn', msg:'🟡 '+carName+' — '+p.name+': '+pct.toFixed(0)+'% della vita ('+(lim-p.km).toFixed(0)+' km alla '+(p.kind||'revisione')+')' });
    }
  });
  LIFE.log.push({ car:carName, km:km, ps:!!isPS, note:note||'', at:Date.now() });
  if(LIFE.log.length>500) LIFE.log.shift();
  save();
  alerts.forEach(function(a){
    toastL(a.msg);
    try { if(window.Notification && Notification.permission==='granted') new Notification('Manutenzione — '+carName, {body:a.p.name+': '+(a.lvl==='over'?'limite superato':'in scadenza')}); } catch(e){}
  });
  try { lifeRender(); } catch(e){}
  return alerts;
};
window.lifeAddComp=function(carName){
  var C=window.lifeCar(carName);
  var nm=prompt('Nome componente (es. Motore, Dischi ant., Cambio):','');
  if(nm===null) return; nm=String(nm).trim(); if(!nm) return;
  var kind=prompt('Tipo di scadenza: revisione / sostituzione / scadenza (data)','revisione')||'revisione';
  kind=String(kind).trim().toLowerCase();
  var comp={ id:'c'+Date.now(), name:nm, kind:kind, km:0, kmPS:0, limit:0, warn:85,
             since:new Date().toISOString().slice(0,10), state:null };
  if(kind==='scadenza'){
    var dt=prompt('Data di scadenza (AAAA-MM-GG):','');
    comp.due=String(dt||'').trim();
  } else {
    var lim=prompt('Limite in km prima di '+kind+':','1000');
    comp.limit=parseFloat(String(lim||'').replace(',','.'))||0;
    var kmNow=prompt('Km già percorsi da questo componente (0 se nuovo):','0');
    comp.km=parseFloat(String(kmNow||'').replace(',','.'))||0;
  }
  C.comps.push(comp); save(); lifeRender();
  toastL('🔧 '+nm+' aggiunto al libretto di '+carName);
};
window.lifePreset=function(carName){
  var C=window.lifeCar(carName);
  if(!confirm('Aggiungere i componenti tipici con soglie di partenza? (potrai modificarle)')) return;
  PRESET.forEach(function(p){
    if(C.comps.some(function(x){ return x.name===p[0]; })) return;
    C.comps.push({ id:'c'+Date.now()+Math.random().toString(36).slice(2,5), name:p[0], kind:p[1],
      km:0, kmPS:0, limit:p[2], warn:85, since:new Date().toISOString().slice(0,10), state:null });
  });
  save(); lifeRender(); toastL('🔧 Componenti tipici aggiunti — controlla e correggi le soglie');
};
window.lifeSet=function(carName, id, field, v){
  var C=window.lifeCar(carName);
  var p=C.comps.filter(function(x){ return x.id===id; })[0]; if(!p) return;
  if(field==='limit'||field==='warn'||field==='km'){ p[field]=parseFloat(String(v).replace(',','.'))||0; p.state=null; }
  else p[field]=String(v);
  save(); lifeRender();
};
window.lifeReset=function(carName, id){
  var C=window.lifeCar(carName);
  var p=C.comps.filter(function(x){ return x.id===id; })[0]; if(!p) return;
  if(!confirm('Azzerare i km di "'+p.name+'"? (dopo revisione o sostituzione)')) return;
  p.hist=(p.hist||[]); p.hist.push({ km:p.km, at:Date.now(), kind:p.kind });
  p.km=0; p.kmPS=0; p.state=null; p.since=new Date().toISOString().slice(0,10);
  save(); lifeRender(); toastL('✅ '+p.name+': intervento registrato, contatore azzerato');
};
window.lifeDel=function(carName, id){
  var C=window.lifeCar(carName);
  var p=C.comps.filter(function(x){ return x.id===id; })[0]; if(!p) return;
  if(!confirm('Togliere "'+p.name+'" dal libretto?')) return;
  C.comps=C.comps.filter(function(x){ return x.id!==id; });
  save(); lifeRender();
};
window.lifeAddKmManual=function(carName){
  var v=prompt('Km da aggiungere a '+carName+' (es. test privato, trasferta):','0');
  if(v===null) return;
  var km=parseFloat(String(v).replace(',','.'))||0; if(km<=0) return;
  var ps=confirm('Sono km di prova/gara (OK) o di trasferimento (Annulla)?');
  window.lifeAddKm(carName, km, ps, 'inserimento manuale');
};
/* ── scadenze a data (cinture, estintore, serbatoio) ── */
function dueDays(p){
  if(!p.due) return null;
  var d=new Date(p.due+'T00:00:00');
  if(isNaN(d)) return null;
  return Math.round((d-new Date())/86400000);
}
window.lifeCheckDates=function(){
  load(); var out=[];
  Object.keys(LIFE.cars).forEach(function(cn){
    (LIFE.cars[cn].comps||[]).forEach(function(p){
      var dd=dueDays(p);
      if(dd!=null && dd<=60) out.push({ car:cn, name:p.name, days:dd });
    });
  });
  return out;
};
/* ── pannello ── */
window.lifeSelCar=function(nm){ window._lifeSel=nm; lifeRender(); };
window.lifeRender=function(){
  var host=document.getElementById('life-body'); if(!host) return;
  load();
  var cars=Object.keys(LIFE.cars);
  if(!window._lifeSel || !LIFE.cars[window._lifeSel]) window._lifeSel=cars[0]||null;
  var sel=window._lifeSel;
  var tabs=cars.map(function(c){
    return '<button class="btn '+(c===sel?'btn-blue':'btn-gray')+'" style="font-size:11px" onclick="lifeSelCar(\''+esc2(c).replace(/'/g,'')+'\')">'+esc2(c)+'</button>';
  }).join(' ');
  var addBtn='<button class="btn btn-gray" style="font-size:11px" onclick="var n=prompt(\'Nome vettura:\',\'\'); if(n){ lifeCar(n); lifeSelCar(n.trim().toUpperCase()); }">+ VETTURA</button>';
  if(!sel){ host.innerHTML='<div class="panel"><div class="panel-body">'+addBtn+
    '<div class="small" style="margin-top:8px;opacity:.7">Aggiungi una vettura per iniziare il libretto vita. I km delle prove e dei giri si sommeranno da soli.</div></div></div>'; return; }
  var C=LIFE.cars[sel];
  var rows=(C.comps||[]).map(function(p){
    var lim=+p.limit||0, pct=lim>0? Math.min(999,100*p.km/lim):0;
    var col=(lim>0)? (pct>=100?'var(--red)':(pct>=(p.warn||85)?'var(--yellow,#ffd60a)':'var(--green)')) : 'var(--text3)';
    var dd=dueDays(p);
    var stato=(p.kind==='scadenza')
      ? (dd==null? '—' : (dd<0? '<b style="color:var(--red)">SCADUTO da '+Math.abs(dd)+' gg</b>' : (dd<=30? '<b style="color:var(--yellow,#ffd60a)">scade tra '+dd+' gg</b>' : 'scade tra '+dd+' gg')))
      : (lim>0? '<b style="color:'+col+'">'+pct.toFixed(0)+'%</b> · restano '+Math.max(0,lim-p.km).toFixed(0)+' km' : '—');
    var bar=(lim>0)? '<div style="height:6px;background:var(--bg3);border-radius:3px;overflow:hidden;margin-top:3px"><div style="height:100%;width:'+Math.min(100,pct)+'%;background:'+col+'"></div></div>':'';
    return '<tr>'+
      '<td><b>'+esc2(p.name)+'</b><div class="small" style="opacity:.55">'+esc2(p.kind)+' · dal '+esc2(p.since||'—')+(p.hist&&p.hist.length?' · '+p.hist.length+' interventi':'')+'</div></td>'+
      '<td class="mono">'+(+p.km||0).toFixed(0)+'<div class="small" style="opacity:.55">di cui PS '+(+p.kmPS||0).toFixed(0)+'</div></td>'+
      '<td>'+(p.kind==='scadenza'
        ? '<input type="date" value="'+esc2(p.due||'')+'" onchange="lifeSet(\''+esc2(sel)+'\',\''+p.id+'\',\'due\',this.value)" style="background:var(--bg3);color:var(--text1);border:1px solid var(--border);border-radius:4px;padding:2px 4px;font-size:11px">'
        : '<input type="number" value="'+lim+'" onchange="lifeSet(\''+esc2(sel)+'\',\''+p.id+'\',\'limit\',this.value)" style="width:80px;background:var(--bg3);color:var(--text1);border:1px solid var(--border);border-radius:4px;padding:2px 4px;font-size:11px"> km')+'</td>'+
      '<td>'+stato+bar+'</td>'+
      '<td style="white-space:nowrap">'+
        '<button class="btn btn-green" style="font-size:9px;padding:2px 6px" onclick="lifeReset(\''+esc2(sel)+'\',\''+p.id+'\')" title="Registra revisione/sostituzione e azzera">✅ FATTO</button> '+
        '<button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="lifeDel(\''+esc2(sel)+'\',\''+p.id+'\')">🗑</button></td></tr>';
  }).join('');
  var warns=(C.comps||[]).filter(function(p){ var l=+p.limit||0; return l>0 && p.km>=l*((p.warn||85)/100); });
  var expd=(C.comps||[]).filter(function(p){ var dd=dueDays(p); return dd!=null && dd<=30; });
  host.innerHTML=
    '<div class="panel mb12"><div class="panel-body" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">'+tabs+' '+addBtn+
      '<span style="flex:1"></span>'+
      '<button class="btn btn-gray" style="font-size:11px" onclick="lifePreset(\''+esc2(sel)+'\')">📋 COMPONENTI TIPICI</button>'+
      '<button class="btn btn-blue" style="font-size:11px" onclick="lifeAddComp(\''+esc2(sel)+'\')">+ COMPONENTE</button>'+
      '<button class="btn btn-gray" style="font-size:11px" onclick="lifeAddKmManual(\''+esc2(sel)+'\')">+ KM A MANO</button>'+
      '<button class="btn btn-gray" style="font-size:11px" onclick="lifeExport()">⬇ CSV</button></div></div>'+
    ((warns.length||expd.length)? '<div class="panel mb12" style="border-color:var(--yellow,#ffd60a)"><div class="panel-head">⚠ DA PROGRAMMARE</div><div class="panel-body">'+
      warns.map(function(p){ var l=+p.limit||0; var over=p.km>=l;
        return '<div style="color:'+(over?'var(--red)':'var(--yellow,#ffd60a)')+'">'+(over?'🔴':'🟡')+' <b>'+esc2(p.name)+'</b> — '+
          (over? 'limite superato di '+(p.km-l).toFixed(0)+' km' : 'mancano '+(l-p.km).toFixed(0)+' km')+' alla '+esc2(p.kind)+'</div>'; }).join('')+
      expd.map(function(p){ var dd=dueDays(p);
        return '<div style="color:'+(dd<0?'var(--red)':'var(--yellow,#ffd60a)')+'">'+(dd<0?'🔴':'🟡')+' <b>'+esc2(p.name)+'</b> — '+(dd<0? 'scaduto da '+Math.abs(dd)+' giorni':'scade tra '+dd+' giorni')+'</div>'; }).join('')+
      '</div></div>' : '')+
    '<div class="panel"><div class="panel-head">🔧 LIBRETTO — '+esc2(sel)+' · totale '+(C.km||0).toFixed(0)+' km (di cui '+(C.kmPS||0).toFixed(0)+' in prova/gara)</div>'+
    '<div class="panel-body" style="overflow-x:auto">'+
    (rows? '<table class="small" style="width:100%;border-collapse:collapse;text-align:left">'+
      '<tr style="opacity:.6"><th>COMPONENTE</th><th>KM</th><th>LIMITE</th><th>STATO</th><th></th></tr>'+rows+'</table>'
     : '<div class="small" style="opacity:.7">Nessun componente. Usa <b>📋 COMPONENTI TIPICI</b> per partire, poi correggi le soglie secondo il tuo regolamento e i tuoi ricambi.</div>')+
    '</div></div>';
};
window.lifeExport=function(){
  load();
  var rows=['vettura;componente;tipo;km;km_ps;limite;percentuale;dal;scadenza'];
  Object.keys(LIFE.cars).forEach(function(cn){
    (LIFE.cars[cn].comps||[]).forEach(function(p){
      var lim=+p.limit||0;
      rows.push([cn,p.name,p.kind,(+p.km||0).toFixed(1),(+p.kmPS||0).toFixed(1),lim||'',
        lim>0? (100*p.km/lim).toFixed(0)+'%':'', p.since||'', p.due||''].join(';'));
    });
  });
  var a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([rows.join('\n')],{type:'text/csv'}));
  a.download='libretto_vita_'+new Date().toISOString().slice(0,10)+'.csv';
  a.click();
};
/* ── pagina ── */
function inject(){
  if(document.getElementById('page-life')) return;
  var main=document.querySelector('.page') && document.querySelector('.page').parentNode;
  if(!main) return;
  var pg=document.createElement('div');
  pg.className='page'; pg.id='page-life';
  pg.innerHTML='<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">'+
    '<div style="font-family:var(--head);font-size:20px;font-weight:700;letter-spacing:2px;color:var(--accent3)">🔧 LIBRETTO VITA COMPONENTI</div>'+
    '<span class="small" style="opacity:.65">i km di prove, giri e trasferimenti si sommano da soli</span></div>'+
    '<div id="life-body"></div>';
  main.appendChild(pg);
  /* accesso: palette Ctrl+K (stabile) + pulsante nella pagina Ricambi.
     Il menu di navigazione viene ricostruito dal programma, quindi non
     ci si aggancia: si usano punti che restano. */
  try { if(window.PAGES && !window.PAGES.some(function(p){return p[0]==='life';})) window.PAGES.push(['life','🔧 Libretto vita componenti']); } catch(e){}
  try {
    var sp=document.getElementById('page-spare-parts');
    if(sp && !document.getElementById('life-goto')){
      var bar=sp.querySelector('div');
      var b=document.createElement('button');
      b.id='life-goto'; b.className='btn btn-gray';
      b.style.cssText='padding:5px 12px;font-size:11px;margin-left:auto';
      b.textContent='🔧 LIBRETTO VITA';
      b.onclick=function(){ showPage('life'); };
      if(bar) bar.appendChild(b); else sp.insertBefore(b, sp.firstChild);
    }
  } catch(e){}
  /* voce di menu: reinserita anche dopo le ricostruzioni della barra */
  function navItem(){
    try {
      if(document.getElementById('life-nav')) return;
      var items=document.querySelectorAll('.nav-menu-item');
      for(var i=0;i<items.length;i++){
        if(/ricambi/i.test(items[i].textContent||'')){
          var it=document.createElement('div');
          it.id='life-nav'; it.className='nav-menu-item';
          it.style.color='var(--purple)';
          it.textContent='🔧 Libretto vita';
          it.onclick=function(){ showPage('life'); if(typeof closeAllNavGroups==='function') closeAllNavGroups(); };
          items[i].parentNode.insertBefore(it, items[i].nextSibling);
          return;
        }
      }
    } catch(e){}
  }
  navItem();
  setTimeout(navItem,300); setTimeout(navItem,1200); setTimeout(navItem,3000);
  setInterval(navItem, 4000);
  if(typeof window.showPage==='function' && !window._repLifeWrapped){
    window._repLifeWrapped=true;
    var o=window.showPage;
    window.showPage=function(id){ var r=o.apply(this,arguments); if(id==='life') setTimeout(lifeRender,60); return r; };
  }
}
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',function(){ setTimeout(inject,700); });
else setTimeout(inject,700);
/* avviso scadenze all'avvio */
setTimeout(function(){
  var due=window.lifeCheckDates();
  due.forEach(function(d){
    toastL((d.days<0? '🔴 ':'🟡 ')+d.car+' — '+d.name+': '+(d.days<0? 'SCADUTO da '+Math.abs(d.days)+' giorni':'scade tra '+d.days+' giorni'));
  });
}, 6000);
})();

</script>
<script>
/* ═══════════════════════════════════════════════════════════════════════════
   MODULO PROFILO PILOTA (DP) — v1.0
   Storico per pilota + stile di guida + memoria per rally/pista
   → setup su misura, costruito sopra il motore SA esistente (non lo modifica).
   Dipendenze (già presenti nell'app): saCtx, saAnalyze, saMoves, saCompare,
   saReadFields, saCar, saSurfKey, showToast, fmtSigned, STATE.
   ═══════════════════════════════════════════════════════════════════════════ */
(function(){
