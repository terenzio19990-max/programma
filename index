function onBoxData(d){
  if(!d) return;
  LIVE.lastAnyData=Date.now();
  var name=(d.c&&String(d.c).trim())||'AUTO 1';
  if(d.k==='ack') return;
  if(d.k==='cack'){
    toast((d.ok? '✅ ':'⚠️ ')+name+': '+cmdLabel(d.cmd)+(d.ok? ' eseguito':' NON riuscito'));
    return;
  }
  if(d.k==='vf'){ frameShow(name, d.d); return; }
  if(d.k==='diag'){ diagShow(name, String(d.s||'')); return; }
  if(d.k==='part'){
    var pc=String(d.code||'').slice(0,200), pn=String(d.name||'').trim().slice(0,80);
    var pcat=String(d.cat||'Altro'), pq=Math.max(1, +d.qty||1);
    var msgP='magazzino non disponibile in questa build';
    try {
      if(typeof SPARE_PARTS!=='undefined'){
        var md=(typeof _spareMode!=='undefined')? _spareMode:'track';
        var ar=SPARE_PARTS[md]=SPARE_PARTS[md]||[];
        var lowP=pc.toLowerCase(), hitP=null;
        if(lowP) ar.forEach(function(pz){ if(!hitP && pz.note && pz.note.toLowerCase().indexOf(lowP)>=0) hitP=pz; });
        if(hitP){
          hitP.qty=(hitP.qty||0)+pq;
          (hitP.history=hitP.history||[]).push({ action:'add', qty:pq, motivo:'scan telefono ('+name+')', at:Date.now() });
          msgP='+'+pq+' "'+hitP.name+'" → qtà '+hitP.qty;
        } else {
          ar.push({ id:Date.now(), name:(pn||('Pezzo '+pc.slice(0,14))), cat:pcat, qty:pq, note:pc,
            used:0, min:0, cost:0, supplier:'', lead:0,
            history:[{ action:'add', qty:pq, motivo:'scan telefono ('+name+')', at:Date.now() }],
            createdAt:Date.now() });
          msgP='NUOVO "'+(pn||pc)+'" ('+pcat+') qtà '+pq;
        }
        try { if(typeof renderSpareParts==='function') renderSpareParts(); } catch(e){}
        try { if(typeof buildSpareSummary==='function') buildSpareSummary(); } catch(e){}
        try { if(typeof triggerAutoSave==='function') triggerAutoSave(); } catch(e){}
      }
    } catch(e){}
    LIVE.codes=LIVE.codes||[];
    LIVE.codes.unshift({ d:pc+(pn? ' — '+pn:''), t:Date.now(), by:name, fmt:'part' });
    if(LIVE.codes.length>30) LIVE.codes.pop();
    codesRender();
    toast('📦 '+name+': '+msgP);
    return;
  }
  if(d.k==='code'){
    var txtC=String(d.data||'').slice(0,300);
    var ae=document.activeElement, routed=false;
    if(ae && (ae.tagName==='INPUT'||ae.tagName==='TEXTAREA') && !ae.readOnly && !ae.disabled && ae.type!=='range'){
      ae.value=txtC;
      try { ae.dispatchEvent(new Event('input',{bubbles:true})); ae.dispatchEvent(new Event('change',{bubbles:true})); } catch(e){}
      routed=true;
    }
    /* nessun campo attivo → instradamento MAGAZZINO RICAMBI (se attivo):
       codice gia' presente = +1 quantita' (carico merce); codice nuovo =
       pagina ricambi aperta col codice precompilato */
    var magMsg='';
    if(!routed && scanMagOn() && typeof SPARE_PARTS!=='undefined'){
      try {
        var mode=(typeof _spareMode!=='undefined')? _spareMode:'track';
        var arr=SPARE_PARTS[mode]||[];
        var low=txtC.toLowerCase(), hit=null;
        arr.forEach(function(pz){ if(!hit && pz.note && pz.note.toLowerCase().indexOf(low)>=0) hit=pz; });
        if(hit){
          hit.qty=(hit.qty||0)+1;
          if(!hit.history) hit.history=[];
          hit.history.push({ action:'add', qty:1, motivo:'scan telefono ('+name+')', at:Date.now() });
          try { if(typeof renderSpareParts==='function') renderSpareParts(); } catch(e){}
          try { if(typeof buildSpareSummary==='function') buildSpareSummary(); } catch(e){}
          try { if(typeof triggerAutoSave==='function') triggerAutoSave(); } catch(e){}
          routed=true; magMsg='📦 +1 "'+hit.name+'" (qtà '+hit.qty+')';
        } else {
          try { if(typeof showPage==='function') showPage('spare-parts'); } catch(e){}
          setTimeout(function(){
            var nf=document.getElementById('spare-note-field');
            var nm=document.getElementById('spare-name');
            if(nf){ nf.value=txtC; }
            if(nm){ try { nm.focus(); } catch(e){} }
          },300);
          routed=true; magMsg='📦 codice NUOVO → pagina ricambi aperta: completa nome e AGGIUNGI';
        }
      } catch(e){}
    }
    LIVE.codes=LIVE.codes||[];
    LIVE.codes.unshift({ d:txtC, t:Date.now(), by:name, fmt:String(d.fmt||'') });
    if(LIVE.codes.length>30) LIVE.codes.pop();
    codesRender();
    try { if(navigator.clipboard&&navigator.clipboard.writeText) navigator.clipboard.writeText(txtC); } catch(e){}
    toast('📷 '+name+': '+(magMsg||(routed? 'codice inserito nel campo attivo':'codice ricevuto (copiato negli appunti)'))+' — '+txtC.slice(0,40));
    return;
  }
  /* trasferimento differito di una registrazione archiviata */
  if(d.k==='hist'){
    LIVE.hist=LIVE.hist||{};
    var hh=LIVE.hist[d.name]=LIVE.hist[d.name]||{ parts:{}, total:+d.total, dist:d.dist, vmax:d.vmax };
    hh.parts[+d.part]=d.pts||[];
    var got=Object.keys(hh.parts).length;
    setT('rep-live-hstat','📥 Ricevo registrazione "'+d.name+'"… '+Math.round(got/hh.total*100)+'%');
    if(got>=hh.total){
      try {
        var all=[];
        for(var pi=0;pi<hh.total;pi++){ (hh.parts[pi]||[]).forEach(function(r){ all.push(r); }); }
        if(all.length>=10){
          var nm=d.name, o=JSON.parse(localStorage.getItem('REP_routes_v1')||'{}');
          if(o[nm]) nm=nm+' ('+Math.floor(Math.random()*90+10)+')';
          var gsArr=[];
          all.forEach(function(r){ if(r[5]!=null||r[6]!=null) gsArr.push([+r[4]||0,+r[5]||0,+r[6]||0]); });
          o[nm]={ lats:all.map(function(r){return +r[0];}), lons:all.map(function(r){return +r[1];}),
                  alts:all.map(function(r){return +r[2];}), ts:all.map(function(r){return +r[4]||0;}),
                  spd:all.map(function(r){return r[3]!=null? +r[3]:null;}), gs:gsArr.slice(0,4000),
                  savedAt:new Date().toISOString() };
          localStorage.setItem('REP_routes_v1', JSON.stringify(o));
          setT('rep-live-hstat','✅ Registrazione "'+nm+'" salvata nei percorsi 3D ('+all.length+' punti). Aprila dalla Mappa 3D o con Ctrl+K.');
          toast('📥 Percorso "'+nm+'" ricevuto dal telefono');
          try { if(typeof repFillRoutes==='function') repFillRoutes(); } catch(e){}
        }
      } catch(e){ setT('rep-live-hstat','Errore salvataggio registrazione: '+e.message); }
      delete LIVE.hist[d.name];
    }
    return;
  }
  if(d.k==='alert'){
    if(!alertsEnabled()) return;
    var Ca=carState(name);
    Ca.alertT=+d.t||Date.now();
    window._repAlerts.push({ name:name, g:+d.g||0, t:+d.t||Date.now(),
      a:(d.a!=null? (+d.a).toFixed(6):null), o:(d.o!=null? (+d.o).toFixed(6):null),
      v:(d.v!=null? +d.v:null), done:false });
    alertRender(); alertBeep(); carsStrip(true);
    try { if(window.Notification && Notification.permission==='granted')
      new Notification('⚠️ POSSIBILE INCIDENTE — '+name,{ body:'Urto '+d.g+' g' }); } catch(e){}
    try { if(typeof showToast==='function') showToast('⚠️ URTO '+d.g+' g — '+name); } catch(e){}
    return;
  }
  if(d.k==='end'){
    var Ce=LIVE.cars[name];
    if(Ce){ finishCar(Ce); setT('rep-live-hstat','✅ '+name+': trasmissione terminata.'); }
    return;
  }
  var C=carState(name);
  if(d.k==='leg'){
    var Cl2=carState(name);
    if(d.type==='reset'){ Cl2.legs=[]; Cl2.kmPS=0; Cl2.kmTF=0; if(name===LIVE.sel) fuelPanel(); return; }
    var lg={ type:String(d.type||'tf'), name:String(d.name||''), n:+d.n||0,
             km:+d.km||0, t:+d.t||0, at:Date.now() };
    Cl2.legs.push(lg); if(Cl2.legs.length>200) Cl2.legs.shift();
    lg.tyre=String(d.tyre||'');
    if(lg.tyre){
      var tk=Cl2.tyres[lg.tyre]=Cl2.tyres[lg.tyre]||{ km:0, kmPS:0, n:0 };
      tk.km+=lg.km; if(lg.type==='ps'){ tk.kmPS+=lg.km; tk.n++; }
      try { tyreStockSync(lg.tyre, lg.km, lg.type==='ps'); } catch(e){}
    }
    try { if(typeof lifeAddKm==='function') lifeAddKm(name, lg.km, lg.type==='ps', (lg.type==='ps'? ('PS '+(lg.name||'')):'trasferimento')); } catch(e){}
    if(d.totPS!=null) Cl2.kmPS=+d.totPS; else if(lg.type==='ps') Cl2.kmPS+=lg.km;
    if(d.totTF!=null) Cl2.kmTF=+d.totTF; else if(lg.type==='tf') Cl2.kmTF+=lg.km;
    try { fuelPlanSync(name, Cl2, lg); } catch(e){}
    toast((lg.type==='ps'? '🚦 '+name+' — '+(lg.name||'PS')+': ':'🚗 '+name+' — trasferimento: ')+lg.km.toFixed(2)+' km');
    if(name===LIVE.sel){ fuelPanel(); tyrePanel(); }
    return;
  }
  if(d.k==='co'){
    var Cc=carState(name);
    Cc.co={ hhmm:String(d.hhmm||''), min:+d.min||0, km:+d.km||0, need:+d.need||0, at:Date.now() };
    toast('⏰ '+name+': CO '+Cc.co.hhmm+' — '+(Cc.co.min<0? 'IN RITARDO':(Cc.co.min+' min · '+Cc.co.need+' km/h necessari')));
