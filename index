// Capture all fields from the current form into a template object
function stpCapture(mode){
  var fields = mode==='rally' ? SETUP_FIELDS_RALLY : SETUP_FIELDS_TRACK;
  var out = {};
  fields.forEach(function(f){
    var el = document.getElementById(f[0]);
    out[f[1]] = el ? el.value : '';
  });
  return out;
}
// Apply a template: fill all the form fields with the saved values
function stpApply(mode, values){
  var fields = mode==='rally' ? SETUP_FIELDS_RALLY : SETUP_FIELDS_TRACK;
  var count = 0;
  fields.forEach(function(f){
    var el = document.getElementById(f[0]);
    if(!el) return;
    if(values[f[1]] !== undefined && values[f[1]] !== null){
      el.value = values[f[1]];
      count++;
      // Brief highlight to show the field got filled
      var orig = el.style.background;
      el.style.background = 'rgba(44,188,110,0.3)';
      setTimeout(function(){ el.style.background = orig; }, 800);
    }
  });
  return count;
}

