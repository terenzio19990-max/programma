}

function _randColor(){
  var palette = ['#8b5cf6','#ec4899','#f59e0b','#10b981','#06b6d4','#3b82f6','#ef4444','#84cc16','#f97316','#a855f7','#14b8a6','#eab308'];
  return palette[Math.floor(Math.random()*palette.length)];
}

function addCompetitorsBatch(){
  var n = +(document.getElementById('batch-count')||{}).value || 0;
  if(n<=0){ showToast('Inserisci una quantità valida'); return; }
  if(n>60){ if(!confirm('Creare '+n+' avversari in blocco? Può essere difficile da gestire.')) return; }
  var cls = (document.getElementById('batch-class')||{}).value||'';
  var myCat = (document.getElementById('batch-my-cat')||{}).value||'';
  if(myCat) cls = myCat;
  var prefix = ((document.getElementById('batch-prefix')||{}).value||'Avv.').trim();
  var start  = +(document.getElementById('batch-start')||{}).value || 1;
  var color  = (document.getElementById('batch-color')||{}).value||'#8b5cf6';
  var random = !!(document.getElementById('batch-color-random')||{}).checked;
  // Collect existing numbers with the same prefix to avoid collisions
  var existingNums = new Set();
  _competitors.forEach(function(c){
    var m = (c.name||'').match(new RegExp('^'+prefix.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\s*#?(\\d+)\\s*$'));
    if(m) existingNums.add(+m[1]);
  });
  var num = start;
  var created = 0;
  var now = Date.now();
  for(var i=0;i<n;i++){
    while(existingNums.has(num)) num++;
    existingNums.add(num);
    var name = prefix ? (prefix+' #'+num) : ('#'+num);
    _competitors.push({
      id: now + i,
      name: name,
      cls: cls.trim(),
      color: random ? _randColor() : color,
      laps: []
    });
    num++; created++;
  }
  showToast('✓ Creati '+created+' avversari'+(cls?' in "'+cls+'"':''));
  _compRefreshCategoryLists();
  renderCompetitorsList();
  updateCompGaps();
  renderCategoryRanking();
  if(typeof triggerAutoSave==='function') triggerAutoSave();
}

// Inline rename of a competitor
function renameCompetitor(idx){
  var c = _competitors[idx]; if(!c) return;
  var newName = prompt('Nuovo nome per "'+c.name+'":', c.name);
  if(!newName || !newName.trim() || newName.trim()===c.name) return;
  c.name = newName.trim();
  renderCompetitorsList();
  updateCompGaps();
  renderCategoryRanking();
  if(typeof triggerAutoSave==='function') triggerAutoSave();
}

// Clear all competitors (with confirmation)
function clearAllCompetitors(){
  if(!_competitors.length){ showToast('Nessun avversario'); return; }
  if(!confirm('Rimuovere tutti i '+_competitors.length+' avversari?')) return;
  _competitors.length = 0;
  _compRefreshCategoryLists();
  renderCompetitorsList();
  updateCompGaps();
  renderCategoryRanking();
  if(typeof triggerAutoSave==='function') triggerAutoSave();
}

function renderCompetitorsList() {
  _compRefreshCategoryLists();
  var el = document.getElementById('competitors-list'); if(!el) return;
  var filterCat = (document.getElementById('comp-filter-cat')||{}).value||'';
  var sortBy  = (document.getElementById('comp-sort')||{}).value||'best';
  var groupByCat = (document.getElementById('comp-group-by-cat')||{}).checked;

  var list = _competitors.slice();
  if(filterCat) list = list.filter(function(c){return (c.cls||'').trim()===filterCat;});

  // Sort
  function bestMsOf(c){ return c.laps.length ? Math.min.apply(null, c.laps.map(parseTime).filter(function(t){return t&&isFinite(t);})) : Infinity; }
  list.sort(function(a,b){
    switch(sortBy){
      case 'name': return (a.name||'').localeCompare(b.name||'');
      case 'cat':  return (a.cls||'zzz').localeCompare(b.cls||'zzz') || (a.name||'').localeCompare(b.name||'');
      case 'laps': return b.laps.length - a.laps.length;
      case 'best':
      default:     return bestMsOf(a) - bestMsOf(b);
    }
  });

  var info = document.getElementById('comp-count-info');
  if(info) info.textContent = list.length+' avversari · '+new Set(list.map(function(c){return c.cls||'';})).size+' categorie';

  if(!list.length) {
    el.innerHTML='<div style="color:var(--text3);font-size:12px;padding:14px;">Nessun avversario'+(filterCat?' in categoria "'+filterCat+'"':'')+'. Aggiungine uno sopra.</div>';
    renderCategoryRanking();
    return;
  }

  function renderOne(comp){
    var ci = _competitors.indexOf(comp);
    var best = comp.laps.length ? Math.min.apply(null, comp.laps.map(parseTime).filter(function(t){return t&&isFinite(t);})) : null;
    var bestStr = best ? msToTime(best) : '--:--';
    var avg = null;
    if(comp.laps.length){
      var ms = comp.laps.map(parseTime).filter(function(t){return t&&isFinite(t);});
      if(ms.length) avg = ms.reduce(function(a,b){return a+b;},0)/ms.length;
    }
    var avgStr = avg ? msToTime(avg) : '--:--';
    var html = '<div class="panel" style="border-left:3px solid '+comp.color+';">';
    html += '<div class="panel-head"><span style="color:'+comp.color+';">&#9679;</span> '+comp.name+' <button onclick="renameCompetitor('+ci+')" title="Rinomina" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:12px;padding:0 2px;">✏️</button>';
    if(comp.cls) html += ' <span class="badge badge-gray" style="margin-left:6px;">'+comp.cls+'</span>';
    html += '<div style="display:flex;gap:10px;margin-left:auto;align-items:center;">';
    html += '<span style="font-family:var(--mono);font-size:11px;color:var(--text3);">Best: <b style="color:var(--green);">'+bestStr+'</b></span>';
    html += '<span style="font-family:var(--mono);font-size:11px;color:var(--text3);">Avg: <b>'+avgStr+'</b></span>';
    html += '<span style="font-size:10px;color:var(--text3);">'+comp.laps.length+' giri</span>';
    html += '<button onclick="removeCompetitor('+ci+')" title="Rimuovi" style="background:none;border:none;color:var(--text3);cursor:pointer;">&#10005;</button>';
    html += '</div></div>';
    html += '<div class="panel-body">';
    html += '<div class="form-row mb8">';
    html += '<div class="field"><label>Tempo giro</label><input type="text" id="comp-lap-'+comp.id+'" placeholder="1:34.567" style="font-family:var(--mono);" onkeydown="if(event.key===\'Enter\') addCompLap('+comp.id+')"></div>';
    html += '<div class="field" style="flex:0;"><label>&nbsp;</label><button class="btn btn-green" onclick="addCompLap('+comp.id+')">+ AGGIUNGI</button></div>';
    html += '<div class="field" style="flex:0;"><label>&nbsp;</label><button class="btn btn-blue" onclick="bulkPasteCompLaps('+comp.id+')" title="Incolla più tempi">📋 Incolla multi</button></div>';
    html += '</div>';
    if(comp.laps.length) {
      html += '<div style="display:flex;flex-wrap:wrap;gap:4px;">';
      comp.laps.forEach(function(l,li) {
        var isBest = parseTime(l) === best;
        html += '<span style="font-family:var(--mono);font-size:11px;background:var(--bg3);padding:2px 6px;border-radius:3px;cursor:pointer;'+(isBest?'color:var(--green);font-weight:700;border:1px solid var(--green);':'')+'" onclick="removeCompLap('+ci+','+li+')" title="Clicca per rimuovere">'+l+' &#10005;</span>';
      });
      html += '</div>';
    }
    html += '</div></div>';
    return html;
  }

  if(groupByCat){
    // Group
    var groups = {};
    list.forEach(function(c){
      var k = c.cls || '— Senza categoria —';
      if(!groups[k]) groups[k] = [];
      groups[k].push(c);
    });
    el.innerHTML = Object.keys(groups).sort().map(function(cat){
      return '<div style="font-family:var(--head);font-size:12px;letter-spacing:2px;color:var(--accent3);padding:8px 4px 4px;border-bottom:1px solid var(--border);margin-top:6px;">▸ '+cat+' <span style="color:var(--text3);font-weight:400;">('+groups[cat].length+')</span></div>'+
        groups[cat].map(renderOne).join('');
    }).join('');
  } else {
    el.innerHTML = list.map(renderOne).join('');
  }
  renderCategoryRanking();
}

function removeCompetitor(idx){
  if(idx<0||idx>=_competitors.length) return;
  if(!confirm('Rimuovere '+(_competitors[idx].name||'questo avversario')+'?')) return;
  _competitors.splice(idx,1);
  renderCompetitorsList(); updateCompGaps();
}
function removeCompLap(ci, li){
  if(!_competitors[ci]) return;
  _competitors[ci].laps.splice(li,1);
  renderCompetitorsList(); updateCompGaps();
}

function addCompLap(id) {
  var comp = _competitors.filter(function(c){return c.id===id;})[0]; if(!comp) return;
  var t = (document.getElementById('comp-lap-'+id)||{}).value;
  if(!t||!t.trim()) return;
  t = t.trim();
  var ms = parseTime(t);
  if(!ms) { showToast('Formato non valido (es: 1:34.567)'); return; }
  comp.laps.push(msToTime(ms));
  if(document.getElementById('comp-lap-'+id)) document.getElementById('comp-lap-'+id).value='';
  renderCompetitorsList(); updateCompGaps();
  if(typeof triggerAutoSave==='function') triggerAutoSave();
  // Broadcast to coop peers
  if(typeof coopBroadcastPatch === 'function' && typeof COOP !== 'undefined' && COOP.status !== 'disconnected' && !COOP.applyingRemote){
    coopBroadcastPatch('_competitors', 'set', _competitors, 'ha inserito tempo avversario '+comp.name+' '+msToTime(ms));
  }
}

function bulkPasteCompLaps(id){
  var comp = _competitors.filter(function(c){return c.id===id;})[0]; if(!comp) return;
  var text = prompt('Incolla uno o più tempi (uno per riga):');
  if(!text) return;
  var added = 0;
  text.split(/\r?\n/).forEach(function(line){
    line = line.trim();
    if(!line) return;
    // Try to extract a time token from each line
    var parts = line.split(/\s+/);
    for(var i=0;i<parts.length;i++){
      var ms = parseTime(parts[i]);
      if(ms){ comp.laps.push(msToTime(ms)); added++; break; }
    }
  });
  showToast('+' + added + ' tempi aggiunti');
  renderCompetitorsList(); updateCompGaps();
}

function updateCompGaps() {
  var el = document.getElementById('comp-gaps-panel'); if(!el) return;
  // Pick our reference car: either explicit gap-car selector, or current selected track car
  var gapCarId = (document.getElementById('comp-gap-car')||{}).value||'';
  var ourCar;
  if(gapCarId){
    var allOur = STATE.trackCars.concat(STATE.rallyCars);
    ourCar = allOur.filter(function(c){return c.id===gapCarId;})[0];
  }
  if(!ourCar){
    var ourCars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;
    ourCar = ourCars[STATE.mode==='track' ? STATE.selectedTrackCar : STATE.selectedRallyCar];
  }
  if(!ourCar){ el.innerHTML='<div style="color:var(--text3);font-size:12px;">Seleziona una vettura.</div>'; return; }
  var ourBest = getBestLapMs(ourCar.id);
  var ourCat = (ourCar.category||ourCar.type||'').trim();

  var filterCat = (document.getElementById('comp-filter-cat')||{}).value||'';
  var list = _competitors.slice();
  if(filterCat) list = list.filter(function(c){return (c.cls||'').trim()===filterCat;});

  if(!list.length) { el.innerHTML='<div style="color:var(--text3);font-size:12px;">Aggiungi avversari per calcolare i gap.</div>'; return; }
  // Sort by best lap
  function bestMsOf(c){ return c.laps.length ? Math.min.apply(null, c.laps.map(parseTime).filter(function(t){return t&&isFinite(t);})) : Infinity; }
  list.sort(function(a,b){return bestMsOf(a)-bestMsOf(b);});

  var html = '<div style="font-size:10px;color:var(--text3);margin-bottom:6px;">Riferimento: <b style="color:var(--accent3);">'+ourCar.name+'</b>'+(ourCat?' [<b>'+ourCat+'</b>]':'')+' — Best: <b>'+(ourBest?msToTime(ourBest):'—')+'</b></div>';
  list.forEach(function(comp) {
    var theirBest = comp.laps.length ? Math.min.apply(null, comp.laps.map(parseTime).filter(function(t){return t&&isFinite(t);})) : null;
    var gap = ourBest&&theirBest ? ((theirBest-ourBest)/1000).toFixed(3) : null;
    var gapColor = gap===null?'var(--text3)':parseFloat(gap)<0?'var(--red)':parseFloat(gap)>0?'var(--green)':'var(--text3)';
    var sameCat = ourCat && (comp.cls||'').trim()===ourCat;
    html += '<div style="display:flex;align-items:center;gap:10px;padding:7px 10px;background:var(--bg3);border-radius:5px;margin-bottom:5px;border-left:3px solid '+comp.color+';'+(sameCat?'box-shadow:inset 0 0 0 1px var(--accent3);':'')+'">';
    html += '<div style="flex:1;font-size:12px;">'+comp.name+(sameCat?' <span style="font-size:9px;color:var(--accent3);">★ stessa cat.</span>':'')+(comp.cls?' <span class="badge badge-gray" style="font-size:9px;">'+comp.cls+'</span>':'')+'</div>';
    html += '<div style="font-family:var(--mono);font-size:12px;color:var(--text2);">'+(theirBest?msToTime(theirBest):'—')+'</div>';
    html += '<div style="font-family:var(--mono);font-size:13px;font-weight:700;min-width:80px;text-align:right;color:'+gapColor+'">'+(gap===null?'—':(parseFloat(gap)>0?'+':'')+gap+'s')+'</div>';
    html += '</div>';
  });
  el.innerHTML = html;
}

// Combined ranking (own cars + competitors) grouped by category
function renderCategoryRanking(){
  var el = document.getElementById('comp-category-ranking'); if(!el) return;
  // Combine all entries
  var entries = [];
  STATE.trackCars.concat(STATE.rallyCars).forEach(function(c){
    var b = getBestLapMs(c.id);
    entries.push({
      name:c.name, cat:(c.category||c.type||'— Senza cat. —').trim(),
      bestMs:b||Infinity, isMine:true, color:c.color||'#e8421a', retired:!!c.retired
    });
  });
  _competitors.forEach(function(c){
    var b = c.laps.length ? Math.min.apply(null, c.laps.map(parseTime).filter(function(t){return t&&isFinite(t);})) : Infinity;
    entries.push({
      name:c.name, cat:(c.cls||'— Senza cat. —').trim(),
      bestMs:b, isMine:false, color:c.color||'#8b5cf6', retired:false
    });
  });
  // Group by cat
  var groups = {};
  entries.forEach(function(e){
    if(!groups[e.cat]) groups[e.cat] = [];
    groups[e.cat].push(e);
  });
  var keys = Object.keys(groups).sort();
  if(!keys.length || entries.length === STATE.trackCars.length + STATE.rallyCars.length){
    // Only own cars → nothing useful to show
    el.innerHTML = '<div style="color:var(--text3);font-size:12px;">Aggiungi avversari con una Categoria per visualizzare la classifica combinata.</div>';
    return;
  }
  var html = '';
  keys.forEach(function(cat){
    var arr = groups[cat];
    // Skip cats with no competitors (own only)
    if(!arr.some(function(e){return !e.isMine;})) return;
    arr.sort(function(a,b){return a.bestMs-b.bestMs;});
    var leaderMs = arr[0].bestMs;
    html += '<div style="margin-bottom:12px;">';
    html += '<div style="font-family:var(--head);font-size:12px;letter-spacing:2px;color:var(--accent3);padding:4px 0;border-bottom:1px solid var(--border);margin-bottom:6px;">▸ '+cat+' <span style="color:var(--text3);font-weight:400;">('+arr.length+')</span></div>';
    html += '<table class="data-table" style="font-size:11px;"><thead><tr><th style="width:35px;">#</th><th>PILOTA/VETTURA</th><th style="width:110px;">BEST</th><th style="width:90px;">GAP LEADER</th></tr></thead><tbody>';
    arr.forEach(function(e,i){
      var gap = (isFinite(e.bestMs) && isFinite(leaderMs) && i>0) ? '+'+((e.bestMs-leaderMs)/1000).toFixed(3)+'s' : (i===0?'LEADER':'—');
      var nameHtml = '<span style="color:'+e.color+';">●</span> '+e.name+(e.isMine?' <span style="font-size:9px;color:var(--accent3);">★ TUA</span>':'');
      html += '<tr style="'+(e.isMine?'background:rgba(232,66,26,0.06);':'')+'">';
      html += '<td class="mono">'+(i+1)+'</td>';
      html += '<td>'+nameHtml+'</td>';
      html += '<td class="mono" style="color:'+(isFinite(e.bestMs)?'var(--text1)':'var(--text3)')+';">'+(isFinite(e.bestMs)?msToTime(e.bestMs):'—')+'</td>';
      html += '<td class="mono" style="color:'+(i===0?'var(--green)':'var(--text2)')+';">'+gap+'</td>';
      html += '</tr>';
    });
    html += '</tbody></table></div>';
  });
  el.innerHTML = html || '<div style="color:var(--text3);font-size:12px;">Aggiungi avversari con una Categoria per visualizzare la classifica combinata.</div>';
}

