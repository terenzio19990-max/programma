  }
  // Sessions
  if(sEl){
    var prevS = sEl.value;
    var driverId2 = dEl ? dEl.value : '';
    var carId = cEl ? cEl.value : '';
    var sessSet = new Set();
    [].concat(STATE.trackCars||[], STATE.rallyCars||[]).forEach(function(car){
      if(carId && car.id !== carId) return;
      (STATE.laps[car.id]||[]).forEach(function(l){
        if(driverId2 && (l.driverId||'') !== driverId2) return;
        if(l.session) sessSet.add(l.session);
      });
    });
    sEl.innerHTML = '<option value="">— tutte —</option>' +
      Array.from(sessSet).sort().map(function(s){return '<option value="'+s+'">'+s+'</option>';}).join('');
    if(prevS) sEl.value = prevS;
  }
}

function _coachCollectLaps(driverId, carId, session, period){
  var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
  var laps = [];
  var cutoff = null;
  if(period === 'today') cutoff = new Date(); cutoff && cutoff.setHours(0,0,0,0); cutoff = cutoff ? cutoff.getTime() : null;
  if(period === 'week')  cutoff = Date.now() - 7*86400000;
  // 'last' is handled below — just take laps with matching session that happened latest
  allCars.forEach(function(car){
    if(carId && car.id !== carId) return;
    (STATE.laps[car.id]||[]).forEach(function(l){
      if(driverId && (l.driverId||'') !== driverId) return;
      if(session && l.session !== session) return;
      if(cutoff && l.ts && l.ts < cutoff) return;
      var ms = parseTime(l.time);
      if(!ms || !isFinite(ms)) return;
      laps.push({
        ms: ms, lap: l.lap, session: l.session||'',
        s1: parseTime(l.s1), s2: parseTime(l.s2), s3: parseTime(l.s3),
        ts: l.ts || 0, vmax: +l.vmax || 0,
        car: car
      });
    });
  });
  if(period === 'last' && !session){
    // Restrict to laps of the most recent session this driver did
    if(!laps.length) return [];
    laps.sort(function(a,b){return (b.ts||0) - (a.ts||0);});
    var lastSess = laps[0].session;
    var lastDate = laps[0].ts ? new Date(laps[0].ts).toDateString() : null;
    laps = laps.filter(function(l){
      if(lastDate && l.ts && new Date(l.ts).toDateString() !== lastDate) return false;
      return l.session === lastSess;
    });
  }
  // Sort chronologically (or by lap number if no ts)
  laps.sort(function(a,b){
    if(a.ts && b.ts) return a.ts - b.ts;
    return (a.lap||0) - (b.lap||0);
  });
  return laps;
}

// Compute coach analysis from laps
function _coachAnalyze(laps, driverId, carId){
  if(!laps.length) return null;
  var times = laps.map(function(l){return l.ms;});
  var best = Math.min.apply(null, times);
  var worst = Math.max.apply(null, times);
  var avg = times.reduce(function(a,b){return a+b;},0)/times.length;
  var sortedT = times.slice().sort(function(a,b){return a-b;});
  var top3avg = sortedT.slice(0, Math.min(3, sortedT.length)).reduce(function(a,b){return a+b;},0)/Math.min(3, sortedT.length);
  // Consistency
  var variance = times.reduce(function(s,v){return s+(v-avg)*(v-avg);},0)/times.length;
  var stddev = Math.sqrt(variance);
  var cv = avg ? (stddev/avg)*100 : 0;
  // Best per sector
  var s1times = laps.map(function(l){return l.s1;}).filter(function(t){return t&&isFinite(t);});
  var s2times = laps.map(function(l){return l.s2;}).filter(function(t){return t&&isFinite(t);});
  var s3times = laps.map(function(l){return l.s3;}).filter(function(t){return t&&isFinite(t);});
  var bestS1 = s1times.length ? Math.min.apply(null, s1times) : null;
  var bestS2 = s2times.length ? Math.min.apply(null, s2times) : null;
  var bestS3 = s3times.length ? Math.min.apply(null, s3times) : null;
  var theoretical = (bestS1 && bestS2 && bestS3) ? (bestS1 + bestS2 + bestS3) : null;
  var marginToTheoretical = theoretical ? (best - theoretical) : null;
  // Avg per sector (where consistent? where lose?)
  var avgS1 = s1times.length ? s1times.reduce(function(a,b){return a+b;},0)/s1times.length : null;
  var avgS2 = s2times.length ? s2times.reduce(function(a,b){return a+b;},0)/s2times.length : null;
  var avgS3 = s3times.length ? s3times.reduce(function(a,b){return a+b;},0)/s3times.length : null;
  // CV per sector
  function cvOf(arr){
    if(arr.length < 2) return null;
    var a = arr.reduce(function(x,y){return x+y;},0)/arr.length;
    var v = arr.reduce(function(s,x){return s+(x-a)*(x-a);},0)/arr.length;
    return a ? (Math.sqrt(v)/a)*100 : null;
  }
  var cvS1 = cvOf(s1times);
  var cvS2 = cvOf(s2times);
  var cvS3 = cvOf(s3times);
  // Sector loss (avg - best per sector)
  var lossS1 = (avgS1 && bestS1) ? avgS1 - bestS1 : null;
  var lossS2 = (avgS2 && bestS2) ? avgS2 - bestS2 : null;
  var lossS3 = (avgS3 && bestS3) ? avgS3 - bestS3 : null;
  // Trend: warmup giri, best lap index, has dropped at end?
  var bestIdx = times.indexOf(best);
  var warmupLaps = bestIdx + 1;
  // Push iniziale?
  var firstHalf = times.slice(0, Math.ceil(times.length/2));
  var secondHalf = times.slice(Math.ceil(times.length/2));
  var firstAvg = firstHalf.reduce(function(a,b){return a+b;},0)/firstHalf.length;
  var secondAvg = secondHalf.length ? secondHalf.reduce(function(a,b){return a+b;},0)/secondHalf.length : firstAvg;
  // Drop in finale (peggioramento ultimi 3 giri)
  var endDrop = false;
  if(times.length >= 6){
    var last3 = times.slice(-3);
    var prev3 = times.slice(-6, -3);
    var last3avg = last3.reduce(function(a,b){return a+b;},0)/3;
    var prev3avg = prev3.reduce(function(a,b){return a+b;},0)/3;
    if(last3avg - prev3avg > 500) endDrop = true; // mezzo secondo peggio = stanchezza
  }

  // Compare vs driver's historical best on same circuit (if any)
  // (using car circuit field — but laps don't store it. Skip comparison for this version.)

  return {
    laps: laps,
    times: times,
    best: best,
    worst: worst,
    avg: avg,
    top3avg: top3avg,
    cv: cv,
    bestS1: bestS1, bestS2: bestS2, bestS3: bestS3,
    avgS1: avgS1, avgS2: avgS2, avgS3: avgS3,
    cvS1: cvS1, cvS2: cvS2, cvS3: cvS3,
    lossS1: lossS1, lossS2: lossS2, lossS3: lossS3,
    theoretical: theoretical,
    marginToTheoretical: marginToTheoretical,
    warmupLaps: warmupLaps,
    bestLapIdx: bestIdx,
    firstHalfAvg: firstAvg,
    secondHalfAvg: secondAvg,
    endDrop: endDrop,
    range: worst - best
  };
}

// Generate prescriptive observations from analysis
function _coachGenerateRecommendations(analysis){
  var recs = [];
  // 1. Warmup
  if(analysis.warmupLaps >= 5){
    recs.push({ icon: '🔥', priority: 'warmup', text: 'Tempi al best dopo '+analysis.warmupLaps+' giri — il warmup è lungo. Considera un riscaldamento più aggressivo nei primi giri o pre-riscaldamento gomme se possibile.' });
  } else if(analysis.warmupLaps <= 2){
    recs.push({ icon: '✓', priority: 'good', text: 'Best lap raggiunto al giro '+analysis.warmupLaps+' — partenza forte, sai mettere subito le gomme in temperatura.' });
  }

  // 2. Sectors — find weakest
  if(analysis.lossS1 !== null && analysis.lossS2 !== null && analysis.lossS3 !== null){
    var losses = [
      { s: 'S1', loss: analysis.lossS1, cv: analysis.cvS1 },
      { s: 'S2', loss: analysis.lossS2, cv: analysis.cvS2 },
      { s: 'S3', loss: analysis.lossS3, cv: analysis.cvS3 }
    ];
    losses.sort(function(a,b){return b.loss - a.loss;});
    var worst = losses[0];
    if(worst.loss > 200){
      recs.push({ icon: '🎯', priority: 'sector', text: 'Settore più discontinuo: <b>'+worst.s+'</b> con perdita media di '+(worst.loss/1000).toFixed(3)+'s rispetto al tuo best del settore. Concentrati sui riferimenti di '+worst.s+' nei prossimi giri.' });
    }
    // Find most consistent
    var mostConsistent = losses.slice().sort(function(a,b){
      if(a.cv == null) return 1;
      if(b.cv == null) return -1;
      return a.cv - b.cv;
    })[0];
    if(mostConsistent.cv != null && mostConsistent.cv < 1){
      recs.push({ icon: '🎯', priority: 'sector', text: 'Settore più costante: <b>'+mostConsistent.s+'</b> ('+mostConsistent.cv.toFixed(2)+'% CV). Già molto solido qui.' });
    }
  }

  // 3. Theoretical margin
  if(analysis.marginToTheoretical !== null){
    if(analysis.marginToTheoretical > 700){
      recs.push({ icon: '⏱', priority: 'theoretical', text: 'Hai '+(analysis.marginToTheoretical/1000).toFixed(2)+'s di margine prima del tuo best teorico — non hai ancora messo insieme un giro pulito. <b>Concentrati su un giro singolo che combini i tuoi migliori settori.</b>' });
    } else if(analysis.marginToTheoretical < 200){
      recs.push({ icon: '✓', priority: 'good', text: 'Best lap a soli '+(analysis.marginToTheoretical/1000).toFixed(3)+'s dal best teorico — stai già combinando bene i settori. Margine minimo significa che per andare più veloce devi alzare il livello complessivo.' });
    }
  }

  // 4. Consistency
  if(analysis.cv > 3){
    recs.push({ icon: '📉', priority: 'consistency', text: 'Consistenza CV '+analysis.cv.toFixed(2)+'% — alta. Lavora su giri ripetibili: meglio 5 giri dello stesso tempo che 1 best e 4 da buttare.' });
  } else if(analysis.cv < 1.5){
    recs.push({ icon: '✓', priority: 'good', text: 'Consistenza ottima ('+analysis.cv.toFixed(2)+'% CV). Sei un metronomo — ottima base per gara.' });
  }

  // 5. End drop (stanchezza)
  if(analysis.endDrop){
    recs.push({ icon: '⚠', priority: 'fitness', text: 'Tempi peggiorati negli ultimi 3 giri della sessione (>0.5s di drop). Possibile stanchezza fisica o gomme finite. <b>Da approfondire</b>: era normale degrado o tu hai mollato?' });
  }

  // 6. Push iniziale vs finale
  if(analysis.times.length >= 6){
    var diff = analysis.firstHalfAvg - analysis.secondHalfAvg;
    if(diff > 500){
      recs.push({ icon: '📈', priority: 'progress', text: 'Migliorato di '+(diff/1000).toFixed(2)+'s tra prima e seconda metà — buona crescita in sessione. Tieni questa progressione.' });
    } else if(diff < -300){
      recs.push({ icon: '📉', priority: 'fade', text: 'Peggiorato di '+(Math.abs(diff)/1000).toFixed(2)+'s nella seconda metà — stai mollando o le gomme stanno finendo. Verifica usura post-sessione.' });
    }
  }

  // Return top 3-5 recommendations, prioritizing actionable ones
  var prioOrder = ['warmup','sector','theoretical','consistency','fade','fitness','progress','good'];
  recs.sort(function(a,b){return prioOrder.indexOf(a.priority) - prioOrder.indexOf(b.priority);});
  return recs.slice(0, 5);
}

