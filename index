.wear-card-row { display:flex; align-items:center; gap:6px; margin-top:5px; font-size:11px; color:var(--text2); }
.wear-card-row input[type=range] { flex:1; }
.wear-card-row select { background:var(--bg0); border:1px solid var(--border); border-radius:3px; color:var(--text1); font-size:11px; padding:2px 4px; }
.wheel-mount-row { display:grid; grid-template-columns:50px 1fr 1fr 1fr 1fr 70px 70px; gap:6px; align-items:center; margin-bottom:6px; padding:5px 0; border-bottom:1px solid var(--border); }
.wheel-mount-row:last-child { border-bottom:none; }
.wheel-label { font-family:var(--head); font-size:12px; font-weight:700; color:var(--accent3); }

/* ─── NOTIFICATION SYSTEM ─── */
#notif-drawer { position:fixed; top:60px; right:16px; z-index:3000; display:flex; flex-direction:column; gap:6px; max-width:340px; pointer-events:none; }
.notif-card { background:var(--bg2); border:1px solid var(--border2); border-left:4px solid var(--accent2); border-radius:6px; padding:10px 14px; box-shadow:0 4px 20px rgba(0,0,0,.5); display:flex; align-items:flex-start; gap:10px; pointer-events:all; animation:notifSlideIn .25s ease; font-size:12px; color:var(--text2); }
.notif-card.notif-warn  { border-left-color:var(--yellow); }
.notif-card.notif-crit  { border-left-color:var(--red); animation:notifSlideIn .25s ease, pulse-red 1.5s infinite; }
.notif-card.notif-info  { border-left-color:var(--blue); }
.notif-card.notif-ok    { border-left-color:var(--green); }
.notif-card.notif-weather { border-left-color:var(--teal); }
.notif-icon { font-size:20px; line-height:1; flex-shrink:0; }
.notif-body { flex:1; }
.notif-title { font-family:var(--head); font-size:12px; font-weight:700; letter-spacing:1px; color:var(--text1); margin-bottom:2px; }
.notif-msg   { font-size:11px; color:var(--text2); line-height:1.5; }
.notif-time  { font-size:10px; color:var(--text3); margin-top:3px; font-family:var(--mono); }
.notif-close { background:none; border:none; color:var(--text3); cursor:pointer; font-size:15px; padding:0; flex-shrink:0; }
@keyframes notifSlideIn { from{transform:translateX(120%);opacity:0} to{transform:translateX(0);opacity:1} }
#notif-bell { position:relative; cursor:pointer; background:var(--bg3); border:1px solid var(--border); border-radius:4px; padding:5px 10px; font-size:16px; transition:all .2s; user-select:none; }
#notif-bell:hover { background:var(--bg4); }
#notif-badge { position:absolute; top:-4px; right:-4px; background:var(--red); color:#fff; font-size:10px; font-family:var(--head); font-weight:700; width:16px; height:16px; border-radius:50%; display:none; align-items:center; justify-content:center; line-height:1; }
#notif-history-panel { position:fixed; top:56px; right:10px; z-index:2999; width:360px; max-height:70vh; overflow-y:auto; background:var(--bg2); border:1px solid var(--border2); border-radius:8px; box-shadow:0 8px 32px rgba(0,0,0,.6); display:none; flex-direction:column; }
#notif-history-panel.open { display:flex; }

/* ── Google Drive Modal ── */
#gdrive-modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:3000; align-items:center; justify-content:center; }
#gdrive-modal.open { display:flex; }
#gdrive-modal > div {
  background:var(--bg1); border:1px solid var(--border); border-radius:10px;
  width:min(680px,95vw); max-height:88vh; display:flex; flex-direction:column;
  box-shadow:0 20px 60px rgba(0,0,0,.5);
}
.gdrive-head { padding:18px 22px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:12px; }
.gdrive-body { padding:20px 22px; overflow-y:auto; flex:1; }
.gdrive-status { display:flex; align-items:center; gap:10px; padding:10px 14px; border-radius:6px; margin-bottom:14px; font-size:13px; }
.gdrive-file { display:flex; align-items:center; gap:10px; padding:9px 12px; background:var(--bg3); border:1px solid var(--border); border-radius:6px; margin-bottom:7px; cursor:pointer; transition:border-color .15s; }
.gdrive-file:hover { border-color:var(--blue); }
.gdrive-file-icon { font-size:20px; flex-shrink:0; }
.gdrive-file-name { flex:1; font-size:13px; color:var(--text1); font-weight:600; }
.gdrive-file-date { font-size:11px; color:var(--text3); }
.gdrive-setup { background:var(--bg3); border:1px solid var(--border); border-radius:6px; padding:14px; margin-bottom:14px; }

/* ═══════════════════════════════════════════
   GROUPED NAV — v18
═══════════════════════════════════════════ */
#subbar {
  display:flex; align-items:center; gap:0; padding:0 8px;
  height:40px; background:var(--bg1); border-bottom:1px solid var(--border);
  flex-shrink:0; overflow:visible !important; white-space:nowrap; position:relative; z-index:100;
}
/* v18: override old subbar gap */
#subbar { gap:0; padding:0 8px; }

.nav-group { position:relative; display:flex; align-items:stretch; flex-shrink:0; }
.nav-group-btn {
  background:none; border:none; color:var(--text3);
