}

function startAssistTimer() {
  if(STATE.assistTimerRunning) return;
  const totalMs = getAssistDurationMs();
  if(!totalMs) return;
  if(STATE.assistTimerElapsed <= 0) STATE.assistTimerElapsed = totalMs; // fresh start
  STATE.assistTimerRunning = true;
  STATE.assistTimerStart = Date.now() - (totalMs - STATE.assistTimerElapsed);
  document.getElementById('assist-start-btn') && (document.getElementById('assist-start-btn').textContent='▶ IN CORSO');
  assistInterval = setInterval(()=>updateAssistTimerDisplay(totalMs), 200);
}
function pauseAssistTimer() {
  if(!STATE.assistTimerRunning) return;
  STATE.assistTimerRunning = false;
  const totalMs = getAssistDurationMs();
  const elapsed = Date.now() - STATE.assistTimerStart;
  STATE.assistTimerElapsed = Math.max(0, totalMs - elapsed);
  clearInterval(assistInterval);
  const btn = document.getElementById('assist-start-btn');
  if(btn) btn.textContent='▶ RIPRENDI';
  updateAssistTimerDisplay(totalMs);
  setAssistStatus('⏸ In pausa', 'var(--text3)');
}
function resetAssistTimer() {
  STATE.assistTimerRunning = false;
  clearInterval(assistInterval);
  const totalMs = getAssistDurationMs();
  STATE.assistTimerElapsed = totalMs;
  const btn = document.getElementById('assist-start-btn');
  if(btn) btn.textContent='▶ AVVIA';
  updateAssistTimerDisplay(totalMs);
  setAssistStatus('In attesa', 'var(--text3)');
}
function getAssistDurationMs() {
  const sel = document.getElementById('assist-duration');
  if(!sel) return 45*60000;
  if(sel.value === 'custom') {
    const cv = document.getElementById('assist-custom-val')?.value||'45:00';
    const parts = cv.split(':');
    return (+(parts[0]||0))*60000 + (+(parts[1]||0))*1000;
  }
  return (+sel.value)*60000;
}
function updateAssistTimerDisplay(totalMs) {
  const elapsed = STATE.assistTimerRunning ? Date.now() - STATE.assistTimerStart : 0;
  const remaining = STATE.assistTimerRunning
    ? Math.max(0, totalMs - elapsed)
    : STATE.assistTimerElapsed;
  // Format mm:ss
  const mins = Math.floor(remaining/60000);
  const secs = Math.floor((remaining%60000)/1000);
  const str = `${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
  setEl('assist-timer-disp', str);
  setEl('assist-timer-disp2', str);
  // Progress bar
  const pct = totalMs>0 ? (remaining/totalMs)*100 : 0;
  const color = pct>50?'var(--green)':pct>20?'var(--yellow)':'var(--red)';
  ['assist-progress-bar','assist-progress-bar2'].forEach(id=>{
    const el = document.getElementById(id);
    if(el) { el.style.width=pct+'%'; el.style.background=color; }
  });
  // Status
  if(remaining<=0) {
    clearInterval(assistInterval); STATE.assistTimerRunning=false;
    setAssistStatus('✅ ASSISTENZA TERMINATA', 'var(--green)');
    const btn = document.getElementById('assist-start-btn');
    if(btn) btn.textContent='▶ AVVIA';
    return;
  }
  if(STATE.assistTimerRunning) {
    const statusTxt = remaining < 60000 ? `⚠️ MENO DI 1 MINUTO` : remaining < 300000 ? `${Math.ceil(remaining/60000)} min rimasti` : `In corso…`;
    setAssistStatus(statusTxt, remaining<60000?'var(--red)':remaining<300000?'var(--yellow)':'var(--green)');
  }
}
function setAssistStatus(msg, color) {
  ['assist-timer-status','assist-timer-status2'].forEach(id=>{
    const el=document.getElementById(id);
    if(el){ el.textContent=msg; el.style.color=color; }
  });
}
document.addEventListener('DOMContentLoaded',()=>{
  const sel=document.getElementById('assist-duration');
