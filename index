<script>
/* REP-STORAGE-BEGIN ===================================================
   STORAGE v2 — sessioni su IndexedDB (niente limite 5MB), caricamento
   veloce (rebuild solo pagina visibile, il resto alla visita),
   sincronizzazione fra schede/finestre (BroadcastChannel + fallback).
   Modulo additivo: avvolge le funzioni esistenti senza rimuoverle.
====================================================================== */
(function(){
'use strict';
if(window._repStorageV2) return;
window._repStorageV2 = true;

var TAB_ID = Math.random().toString(36).slice(2)+Date.now().toString(36);
var _lastLocalEdit = 0;      // ultimo edit locale (per non farsi sovrascrivere a meta' modifica)
