/* ─── 10. MOTORE "SETUP SU MISURA" ───────────────────────────────────────── */
var K_UT = 6;        // secondi equivalenti per 1.0 di scostamento U (scala interna)
var PH_W = {entry:1.0, mid:1.2, exit:1.1};

function fitError(A, t){
  var s=0;
  ['entry','mid','exit'].forEach(function(ph){
    var u=(A.phases&&A.phases[ph])? A.phases[ph].U : 0;
    var e=u-t[ph];
    s += PH_W[ph]*e*e;
  });
  return Math.sqrt(s/3);
}

function advise(mode){
  var d=active();
  if(!d) return {err:'Nessun pilota selezionato.'};
  var st=styleOf(d);
  var lg=isLowGrip(surfNow(mode));
  var t=targetsOf(st, lg);
  var ctx=saCtx(mode);
  var A0=saAnalyze(ctx.cur, ctx.p, ctx.surf);
  var e0=fitError(A0, t);
  var cands=[];
  saMoves(ctx.cur, ctx.p, ctx.surf, ctx.prof).forEach(function(m){
    try {
      var A1=saAnalyze(m.s, ctx.p, ctx.surf);
      var e1=fitError(A1, t);
      var dt=saCompare(A1, A0, ctx.p, ctx.surf, ctx.prof).total;
      var gain=(e0-e1)*K_UT;             // s equivalenti guadagnati in "adattamento al pilota"
      var score=gain - dt;               // dt<0 = più veloce ⇒ alza lo score
      if(score>0.01) cands.push({lab:m.lab, conf:m.conf, grp:m.grp, gain:gain, dt:dt, score:score,
        dU:{entry:(A1.phases.entry.U-A0.phases.entry.U), mid:(A1.phases.mid.U-A0.phases.mid.U), exit:(A1.phases.exit.U-A0.phases.exit.U)}});
    } catch(e){}
  });
  cands.sort(function(a,b){ return b.score-a.score; });
  // una sola mossa per gruppo (non ha senso proporre molla+ e molla- insieme)
  var seen={}, top=[];
  cands.forEach(function(c){ if(top.length>=3) return; var g=c.grp||c.lab; if(seen[g]) return; seen[g]=1; top.push(c); });
  return {driver:d, style:st, targets:t, A0:A0, e0:e0, moves:top, lowGrip:lg, total:cands.length};
}

/* ─── 11. RADAR SVG ──────────────────────────────────────────────────────── */
function radarSVG(st, size){
  var S=size||190, cx=S/2, cy=S/2, R=S/2-28, n=AXES.length;
  function pt(i, r){ var a=-Math.PI/2 + i*2*Math.PI/n; return [cx+Math.cos(a)*r, cy+Math.sin(a)*r]; }
  var g='';
  [0.25,0.5,0.75,1].forEach(function(f){
    var p=[]; for(var i=0;i<n;i++){ var q=pt(i,R*f); p.push(q[0].toFixed(1)+','+q[1].toFixed(1)); }
    g+='<polygon points="'+p.join(' ')+'" fill="none" stroke="currentColor" stroke-opacity="'+(f===1?0.35:0.13)+'" stroke-width="1"/>';
  });
  var poly=[], dots='';
  for(var i=0;i<n;i++){
    var k=AXES[i].k, v=st[k]?st[k].v:0.5, c=st[k]?st[k].c:0.3;
    var q=pt(i, R*clamp(v,0.04,1));
    poly.push(q[0].toFixed(1)+','+q[1].toFixed(1));
    dots+='<circle cx="'+q[0].toFixed(1)+'" cy="'+q[1].toFixed(1)+'" r="'+(2+2*c).toFixed(1)+'" fill="var(--teal,#1aada0)" fill-opacity="'+(0.35+0.6*c).toFixed(2)+'"/>';
    var l=pt(i, R+16);
    var anchor = l[0]>cx+4?'start':(l[0]<cx-4?'end':'middle');
    g+='<text x="'+l[0].toFixed(1)+'" y="'+(l[1]+3).toFixed(1)+'" text-anchor="'+anchor+'" font-size="9" fill="currentColor" fill-opacity=".72">'+esc(AXES[i].lab)+'</text>';
  }
  return '<svg viewBox="0 0 '+S+' '+S+'" width="'+S+'" height="'+S+'" style="color:var(--text3,#8a94a6)">'+g+
    '<polygon points="'+poly.join(' ')+'" fill="var(--teal,#1aada0)" fill-opacity=".16" stroke="var(--teal,#1aada0)" stroke-width="1.6"/>'+dots+'</svg>';
}

