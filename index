// ─── Centralized driver filter helpers (used across all analytics pages) ─
// Returns the currently-selected driverId from a given <select> id, or '' if none.
function _selectedDriverFilter(selectId){
  try {
    var el = document.getElementById(selectId);
    return el ? (el.value || '') : '';
  } catch(_){ return ''; }
}
window._selectedDriverFilter = _selectedDriverFilter;

// Returns the driver-filtered laps for a given car. If driverId is '' or null,
// returns all laps. Used by analytics functions to respect the user's filter.
function _lapsForCar(carId, driverId){
  var laps = STATE.laps[carId] || [];
  if(!driverId) return laps;
  return laps.filter(function(l){ return (l.driverId||'') === driverId; });
}
window._lapsForCar = _lapsForCar;

// Populate any <select> with the list of drivers from the current season.
// Adds an "All drivers" option at the top.
function _populateDriverFilter(selectId){
  var el = document.getElementById(selectId);
