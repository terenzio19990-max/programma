// ═══════════════════════════════════════════════════════════════
// LAN mode — PeerJS
// ═══════════════════════════════════════════════════════════════
// Helper: wait up to maxMs for PeerJS to finish loading (multi-CDN fallback
// in <head> may still be in flight). Returns true if ready, false if failed/timeout.
function _ensurePeerJS(onReady, onFail){
  if(typeof Peer !== 'undefined'){ onReady(); return; }
  // If loader has already definitively failed → abort
  if(window._PEERJS_LOAD_STATUS === 'failed'){
    onFail && onFail('all-cdn-failed');
    return;
  }
  coopUpdateStatus('connecting','Caricamento PeerJS...','🟡');
  var waited = 0;
  var tick = setInterval(function(){
    if(typeof Peer !== 'undefined'){
      clearInterval(tick);
      onReady();
      return;
    }
    if(window._PEERJS_LOAD_STATUS === 'failed'){
      clearInterval(tick);
      onFail && onFail('all-cdn-failed');
      return;
    }
    waited += 250;
    if(waited >= 8000){
      clearInterval(tick);
      onFail && onFail('timeout');
    }
  }, 250);
}

function _peerjsLoadErrorMessage(reason){
  var tried = (window._PEERJS_CDN_TRIED||[]).join(', ');
  if(reason === 'all-cdn-failed'){
    return 'PeerJS non disponibile — tutti i CDN hanno fallito.\n\n'+
      'Possibili cause:\n'+
      '• Connessione internet assente o instabile\n'+
      '• Firewall/proxy aziendale blocca cdn.jsdelivr.net, unpkg.com, cdnjs.cloudflare.com\n'+
      '• Estensione browser (AdBlock / NoScript / Privacy Badger) blocca gli script CDN\n'+
      '• DNS della rete non risolve i domini CDN\n\n'+
      'Soluzioni:\n'+
      '• Ricarica la pagina con connessione attiva\n'+
      '• Disabilita temporaneamente le estensioni sulle CDN\n'+
      '• Prova da hotspot telefono per testare\n'+
      '• In alternativa usa la modalità "📤 MANUAL" (import/export JSON) che non richiede PeerJS\n\n'+
      'CDN provati: '+tried;
  }
  return 'PeerJS sta caricando ancora... riprova tra qualche secondo.';
}

// Update the status indicator in the Coop modal LAN panel
function coopUpdatePeerJSStatus(){
  var icon = document.getElementById('coop-peerjs-icon');
  var label = document.getElementById('coop-peerjs-label');
  var wrap = document.getElementById('coop-peerjs-status');
  if(!icon || !label || !wrap) return;
  // Self-correct: if Peer is loaded, ALWAYS report green regardless of previous status.
  // This handles cases where onload fired but our flag didn't update, or the
  // library loaded via cache without triggering our loader.
  if(typeof Peer !== 'undefined'){
    if(window._PEERJS_LOAD_STATUS !== 'ready'){
      window._PEERJS_LOAD_STATUS = 'ready';
      if(!window._PEERJS_CDN_USED) window._PEERJS_CDN_USED = 'cache locale / preload';
    }
    icon.textContent = '✅';
    label.innerHTML = '<b style="color:var(--green);">PeerJS caricato</b> — pronto per hostare/collegarsi<br>'+
      '<span style="font-size:10px;color:var(--text3);">Fonte: '+(window._PEERJS_CDN_USED||'cache locale')+'</span>';
    wrap.style.borderLeftColor = 'var(--green)';
  } else if(window._PEERJS_LOAD_STATUS === 'failed'){
    icon.textContent = '❌';
    label.innerHTML = '<b style="color:var(--red);">PeerJS NON caricato</b> — controlla connessione/firewall/adblock<br>'+
      '<span style="font-size:10px;color:var(--text3);">Usa 📤 Manual o ricarica pagina</span>';
    wrap.style.borderLeftColor = 'var(--red)';
  } else {
    icon.textContent = '⏳';
    label.innerHTML = '<b style="color:var(--yellow);">PeerJS in caricamento...</b>';
    wrap.style.borderLeftColor = 'var(--yellow)';
  }
}

// Manually re-check (user pressed "Ricontrolla") — attempts to re-load if failed
function coopRecheckPeerJS(){
  if(typeof Peer !== 'undefined'){
    coopUpdatePeerJSStatus();
    showToast('✅ PeerJS è caricato e funzionante');
    return;
  }
  // Force-retry by manually appending a script tag from each CDN
  var cdns = [
    'https://cdn.jsdelivr.net/npm/[email protected]/dist/peerjs.min.js',
    'https://unpkg.com/[email protected]/dist/peerjs.min.js',
    'https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js'
  ];
  var icon = document.getElementById('coop-peerjs-icon');
  var label = document.getElementById('coop-peerjs-label');
  if(icon) icon.textContent = '⏳';
  if(label) label.innerHTML = '<b style="color:var(--yellow);">Nuovo tentativo di caricamento...</b>';
  window._PEERJS_LOAD_STATUS = 'loading';
  var idx = 0;
  function retry(){
    if(idx >= cdns.length){
      window._PEERJS_LOAD_STATUS = 'failed';
      coopUpdatePeerJSStatus();
      showToast('❌ PeerJS: tutti i CDN falliti');
      return;
    }
    var s = document.createElement('script');
    s.src = cdns[idx];
    s.async = false;
    s.onload = function(){
      if(typeof Peer !== 'undefined'){
        window._PEERJS_LOAD_STATUS = 'ready';
        window._PEERJS_CDN_USED = cdns[idx];
        coopUpdatePeerJSStatus();
        showToast('✅ PeerJS caricato');
      } else { idx++; retry(); }
    };
    s.onerror = function(){ idx++; retry(); };
    document.head.appendChild(s);
  }
  retry();
}

function coopLanHost(){
  _persistIdentity();
  if(!COOP.me.name){ showToast('⚠️ Inserisci il tuo nome prima'); return; }
  _ensurePeerJS(function(){
    coopUpdateStatus('connecting','Apertura host...','🟡');
    // Lowercase ID for PeerJS registration (PeerJS IDs are case-sensitive).
    // Display to user in uppercase for readability — both sides normalise to lowercase.
    var shortId = 'rep-'+coopShortId().toLowerCase();
    try {
      COOP.peer = new Peer(shortId, { debug: 1 });
    } catch(e){ coopLog('Errore creazione peer: '+e.message); showToast('❌ Errore: '+e.message); return; }
    COOP.peer.on('open', function(id){
      COOP.me.id = id;
      COOP.isHost = true;
      coopUpdateStatus('host','HOST attivo — '+id,'🟢');
      coopLog('Sei HOST come '+COOP.me.name);
      var el = document.getElementById('coop-lan-my-id');
      // Show in uppercase for readability, actual ID on PeerJS is lowercase
      if(el) el.textContent = id.replace(/^rep-/,'').toUpperCase();
      document.getElementById('coop-lan-host-info').style.display='block';
      document.getElementById('coop-lan-role-pick').style.display='none';
    });
    COOP.peer.on('connection', function(conn){
      _lanSetupConnection(conn, true);
    });
    COOP.peer.on('error', function(err){
      coopLog('Errore: '+err.type+' — '+err.message);
      showToast('❌ PeerJS: '+err.type);
      if(err.type==='unavailable-id'){
        setTimeout(coopLanHost, 500);
      }
    });
    COOP.peer.on('disconnected', function(){
      coopLog('Peer disconnesso — tentativo riconnessione');
      try { COOP.peer.reconnect(); } catch(e){}
    });
  }, function(reason){
    coopUpdateStatus('disconnected','PeerJS non disponibile','⚪');
    coopLog('❌ PeerJS non caricato ('+reason+')');
    alert(_peerjsLoadErrorMessage(reason));
  });
}
function coopLanJoinPrompt(){
  _persistIdentity();
  if(!COOP.me.name){ showToast('⚠️ Inserisci il tuo nome prima'); return; }
  var code = prompt('Inserisci il codice host (6 lettere/cifre):');
  if(!code) return;
  // Normalise: strip whitespace, remove any 'REP-' prefix user might have pasted (in any case),
  // then add our canonical 'rep-' prefix and lowercase everything for PeerJS (IDs are case-sensitive).
  code = code.trim().replace(/^rep-/i, '');
  if(!code){ showToast('⚠️ Codice vuoto'); return; }
  var hostId = ('rep-'+code).toLowerCase();
  coopLanJoin(hostId);
}
function coopLanJoin(hostId){
  _ensurePeerJS(function(){
    coopUpdateStatus('connecting','Collegamento a '+hostId+'...','🟡');
    try {
      COOP.peer = new Peer({ debug:1 });
    } catch(e){ coopLog('Errore: '+e.message); showToast('❌ Errore: '+e.message); return; }
    COOP.peer.on('open', function(myId){
      COOP.me.id = myId;
      COOP.isHost = false;
      var conn = COOP.peer.connect(hostId, { reliable:true, metadata:{ name:COOP.me.name, color:COOP.me.color } });
      _lanSetupConnection(conn, false);
      document.getElementById('coop-lan-join-info').style.display='block';
      document.getElementById('coop-lan-role-pick').style.display='none';
      var info = document.getElementById('coop-lan-peer-info');
      if(info) info.textContent = 'Host: '+hostId.replace(/^rep-/,'').toUpperCase();
    });
    COOP.peer.on('error', function(err){
      coopLog('❌ '+err.type);
      showToast('❌ Connessione fallita: '+err.type);
      coopUpdateStatus('disconnected','Disconnesso','⚪');
    });
    COOP.peer.on('connection', function(conn){
      _lanSetupConnection(conn, true);
    });
  }, function(reason){
    coopUpdateStatus('disconnected','PeerJS non disponibile','⚪');
    coopLog('❌ PeerJS non caricato ('+reason+')');
    alert(_peerjsLoadErrorMessage(reason));
  });
}
function _lanSetupConnection(conn, isIncoming){
  conn.on('open', function(){
    COOP.connections[conn.peer] = conn;
    var meta = conn.metadata || {};
    COOP.peers[conn.peer] = { name: meta.name||'Engineer', color: meta.color||'#2b7de9', lastSeen: Date.now() };
    coopLog('✅ Connesso con '+(meta.name||conn.peer));
    showToast('✅ '+(meta.name||'Engineer')+' connesso');
    coopUpdateStatus(COOP.isHost?'host':'guest', (COOP.isHost?'HOST':'GUEST')+' · '+Object.keys(COOP.connections).length+' peer', '🟢');
    // Handshake: send identity + current state snapshot if we are HOST
    conn.send({type:'hello', from:COOP.me.id, name:COOP.me.name, color:COOP.me.color});
    if(COOP.isHost){
      conn.send({type:'snapshot', state: _coopSnapshot()});
    }
    _updateCoopPeersList();
    // Broadcast new peer announcement to others (host relays)
    if(COOP.isHost) _lanBroadcastExcept(conn.peer, {type:'peer-joined', id:conn.peer, name:COOP.peers[conn.peer].name, color:COOP.peers[conn.peer].color});
  });
  conn.on('data', function(data){
    console.log('[COOP←] data received from '+conn.peer, data?.type);
    _handleCoopMessage(data, conn.peer);
  });
  conn.on('close', function(){
    var name = COOP.peers[conn.peer]?.name||conn.peer;
    delete COOP.connections[conn.peer];
    delete COOP.peers[conn.peer];
    coopLog('❌ '+name+' disconnesso');
    if(COOP.isHost) _lanBroadcastExcept(conn.peer, {type:'peer-left', id:conn.peer});
    _updateCoopPeersList();
    coopUpdateStatus(COOP.isHost?'host':'guest', Object.keys(COOP.connections).length+' peer', '🟢');
  });
  conn.on('error', function(err){ coopLog('⚠️ conn err: '+err); });
}
function _lanBroadcastExcept(exceptId, msg){
  Object.keys(COOP.connections).forEach(function(pid){
    if(pid===exceptId) return;
    try { COOP.connections[pid].send(msg); } catch(e){}
  });
}
function _lanBroadcast(msg){
  Object.keys(COOP.connections).forEach(function(pid){
    try { COOP.connections[pid].send(msg); } catch(e){}
  });
}
