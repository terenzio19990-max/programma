function anRenderOverlay(){
  // Perf guard: skip rebuild if container is hidden
  var _g = document.getElementById('an-overlay-chart');
  if(_g && !_g.offsetParent && !window.__FORCE_REBUILD) return;

  var chartEl = document.getElementById('an-overlay-chart');
  var statsEl = document.getElementById('an-overlay-stats');
  if(!chartEl) return;
  if(typeof Plotly==='undefined'){ chartEl.innerHTML='<div style="padding:20px;color:var(--text3);">Plotly non caricato</div>'; return; }
  var metric = document.getElementById('an-overlay-metric')?.value || 'time';
  var showMarkers = document.getElementById('an-overlay-markers')?.checked;
  var showTrend = document.getElementById('an-overlay-smoothing')?.checked;
  var driverFilter = _selectedDriverFilter('an-driver-filter');
  var ids = Object.keys(AN.overlaySelected);
  if(!ids.length){
    chartEl.innerHTML = '<div style="padding:30px;text-align:center;color:var(--text3);">📊 Seleziona almeno una vettura per visualizzare il grafico</div>';
    statsEl.innerHTML = '';
    return;
  }
  // Build reference "best lap overall" for delta computation
  var bestOverall = Infinity;
  if(metric==='delta'){
    ids.forEach(function(id){
      _lapsForCar(id, driverFilter).forEach(function(l){
        var ms = parseTime(l.time);
        if(ms && ms<bestOverall) bestOverall = ms;
      });
    });
  }
  var traces = [];
  var statsRows = [];
  ids.forEach(function(id){
    var car = _anAllCars().find(function(c){return c.id===id;});
    if(!car) return;
    var laps = _lapsForCar(id, driverFilter);
    var xs = [], ys = [];
    laps.forEach(function(l){
      xs.push(l.lap);
      var y = null;
      if(metric==='time')  { var t=parseTime(l.time);  y=t ? t/1000 : null; }
      if(metric==='s1')    { var t1=parseTime(l.s1); y=t1 ? t1/1000 : null; }
      if(metric==='s2')    { var t2=parseTime(l.s2); y=t2 ? t2/1000 : null; }
      if(metric==='s3')    { var t3=parseTime(l.s3); y=t3 ? t3/1000 : null; }
      if(metric==='vmax')  { y = (+l.vmax||null); }
      if(metric==='delta') { var td=parseTime(l.time); y = (td && isFinite(bestOverall)) ? (td-bestOverall)/1000 : null; }
      ys.push(y);
    });
    traces.push({
      x: xs, y: ys,
      name: car.name,
      mode: showMarkers ? 'lines+markers' : 'lines',
      line: { color: car.color||'#888', width: 2.5 },
      marker: { size: 7 },
      hovertemplate: '<b>'+car.name+'</b><br>Giro %{x}<br>'+( metric==='vmax'?'V.max %{y} km/h':'%{y:.3f}s')+'<extra></extra>',
    });
    // Trendline
    if(showTrend && ys.filter(function(v){return v!=null;}).length>=3){
      var validPts = xs.map(function(x,i){return [x, ys[i]];}).filter(function(p){return p[1]!=null;});
      if(validPts.length>=2){
        var n = validPts.length;
        var sx=0, sy=0, sxy=0, sxx=0;
        validPts.forEach(function(p){ sx+=p[0]; sy+=p[1]; sxy+=p[0]*p[1]; sxx+=p[0]*p[0]; });
        var slope = (n*sxy - sx*sy) / (n*sxx - sx*sx || 1);
        var intercept = (sy - slope*sx) / n;
        var tx = xs, ty = xs.map(function(x){return slope*x+intercept;});
        traces.push({ x:tx, y:ty, name:car.name+' (trend)', mode:'lines', line:{color:car.color||'#888', width:1, dash:'dash'}, showlegend:false, hoverinfo:'skip' });
      }
    }
    // Stats row
    var vals = ys.filter(function(v){return v!=null;});
    if(vals.length){
      var min = Math.min.apply(null,vals);
      var max = Math.max.apply(null,vals);
      var avg = vals.reduce(function(a,b){return a+b;},0)/vals.length;
      var sd = Math.sqrt(vals.reduce(function(s,v){return s+Math.pow(v-avg,2);},0)/vals.length);
      statsRows.push({car:car, n:vals.length, min:min, max:max, avg:avg, sd:sd});
    }
  });
  var yTitle = metric==='vmax' ? 'km/h' : (metric==='delta' ? 's vs best overall' : 'secondi');
  Plotly.newPlot(chartEl, traces, {
    paper_bgcolor:'transparent', plot_bgcolor:'rgba(255,255,255,0.02)',
    font:{ color:'#a8afc0', family:'Share Tech Mono, monospace' },
    xaxis:{ title:'Giro', gridcolor:'rgba(255,255,255,0.08)', zeroline:false },
    yaxis:{ title:yTitle, gridcolor:'rgba(255,255,255,0.08)', zeroline:false, autorange:(metric==='delta'?'reversed':true) },
    margin:{ t:20, l:55, r:20, b:40 },
    legend:{ orientation:'h', y:-0.15 },
    hovermode: 'closest'
  }, { displaylogo:false, responsive:true });
  // Stats table
  if(statsRows.length){
    var best = Math.min.apply(null, statsRows.map(function(r){return r.min;}));
    statsEl.innerHTML =
      '<table style="width:100%;border-collapse:collapse;font-size:11px;">'+
      '<tr style="background:var(--bg3);"><th style="padding:6px 8px;text-align:left;">Vettura</th><th>Giri</th><th>Migliore</th><th>Media</th><th>Peggiore</th><th>σ (costanza)</th><th>Gap vs top</th></tr>'+
      statsRows.map(function(r){
        var gap = r.min - best;
        var gapColor = gap<0.05 ? 'var(--green)' : gap<0.5 ? 'var(--yellow)' : 'var(--red)';
        var unit = (metric==='vmax'?' km/h':'s');
        return '<tr style="border-bottom:1px solid var(--border);">'+
          '<td style="padding:4px 8px;"><span class="an-dot" style="background:'+(r.car.color||'#888')+';"></span> '+r.car.name+'</td>'+
          '<td class="mono" style="text-align:center;">'+r.n+'</td>'+
          '<td class="mono" style="text-align:center;color:var(--green);">'+r.min.toFixed(3)+unit+'</td>'+
          '<td class="mono" style="text-align:center;">'+r.avg.toFixed(3)+unit+'</td>'+
          '<td class="mono" style="text-align:center;color:var(--text3);">'+r.max.toFixed(3)+unit+'</td>'+
          '<td class="mono" style="text-align:center;">'+r.sd.toFixed(3)+unit+'</td>'+
          '<td class="mono" style="text-align:center;color:'+gapColor+';">'+(gap<=0?'LEADER':'+'+gap.toFixed(3)+unit)+'</td>'+
          '</tr>';
      }).join('')+
      '</table>';
  } else statsEl.innerHTML='';
}

// ─── 2) BOXPLOT CONSISTENCY ───
function anRenderBoxplot(){
  // Perf guard: skip rebuild if container is hidden
  var _g = document.getElementById('an-boxplot-chart');
  if(_g && !_g.offsetParent && !window.__FORCE_REBUILD) return;

  var chartEl = document.getElementById('an-boxplot-chart');
  var statsEl = document.getElementById('an-boxplot-stats');
  if(!chartEl) return;
  if(typeof Plotly==='undefined'){ chartEl.innerHTML='<div style="padding:20px;color:var(--text3);">Plotly non caricato</div>'; return; }
  var driverFilter = _selectedDriverFilter('an-driver-filter');
  var cars = _anAllCars().filter(function(c){return _lapsForCar(c.id, driverFilter).length>=3;});
  if(!cars.length){
    chartEl.innerHTML = '<div style="padding:30px;text-align:center;color:var(--text3);">📦 Servono almeno 3 giri per vettura per calcolare la distribuzione</div>';
    statsEl.innerHTML = '';
    return;
  }
  var traces = cars.map(function(car){
    var vals = _lapsForCar(car.id, driverFilter).map(function(l){var t=parseTime(l.time);return t?t/1000:null;}).filter(function(v){return v!=null;});
    return { y: vals, name: car.name, type:'box', marker:{color: car.color||'#888'}, boxpoints:'outliers', jitter:0.3, pointpos:-1.8, line:{width:1.5} };
  });
  Plotly.newPlot(chartEl, traces, {
    paper_bgcolor:'transparent', plot_bgcolor:'rgba(255,255,255,0.02)',
    font:{ color:'#a8afc0', family:'Share Tech Mono, monospace' },
    yaxis:{ title:'Tempo giro (s)', gridcolor:'rgba(255,255,255,0.08)', zeroline:false },
    margin:{ t:20, l:55, r:20, b:50 },
    showlegend:false,
  }, { displaylogo:false, responsive:true });
  // Stats: ranking by consistency (σ)
  var rows = cars.map(function(car){
    var vals = _lapsForCar(car.id, driverFilter).map(function(l){var t=parseTime(l.time);return t?t/1000:null;}).filter(function(v){return v!=null;});
    var avg = vals.reduce(function(a,b){return a+b;},0)/vals.length;
    var sd = Math.sqrt(vals.reduce(function(s,v){return s+Math.pow(v-avg,2);},0)/vals.length);
    var sorted = vals.slice().sort(function(a,b){return a-b;});
    var median = sorted.length%2 ? sorted[Math.floor(sorted.length/2)] : (sorted[sorted.length/2-1]+sorted[sorted.length/2])/2;
    var q1 = sorted[Math.floor(sorted.length*0.25)];
    var q3 = sorted[Math.floor(sorted.length*0.75)];
    var iqr = q3-q1;
    return { car:car, n:vals.length, min:Math.min.apply(null,vals), median:median, avg:avg, sd:sd, iqr:iqr };
  }).sort(function(a,b){return a.sd-b.sd;});
  statsEl.innerHTML = '<div style="font-family:var(--head);font-size:11px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">🏆 RANKING COSTANZA (più in alto = più regolare)</div>'+
    '<table style="width:100%;border-collapse:collapse;font-size:11px;">'+
    '<tr style="background:var(--bg3);"><th style="padding:6px 8px;text-align:left;">#</th><th>Vettura</th><th>Giri</th><th>Mediana</th><th>σ</th><th>IQR</th><th>Valutazione</th></tr>'+
    rows.map(function(r,i){
      var eval_;
      if(r.sd<0.2)      eval_ = '<span style="color:var(--green);font-weight:700;">⭐ Eccellente</span>';
      else if(r.sd<0.5) eval_ = '<span style="color:var(--green);">✓ Buona</span>';
      else if(r.sd<1.0) eval_ = '<span style="color:var(--yellow);">△ Discreta</span>';
      else              eval_ = '<span style="color:var(--red);">✗ Incostante</span>';
      return '<tr style="border-bottom:1px solid var(--border);">'+
        '<td style="padding:4px 8px;" class="mono">'+(i+1)+'</td>'+
        '<td><span class="an-dot" style="background:'+(r.car.color||'#888')+';"></span> '+r.car.name+'</td>'+
        '<td class="mono" style="text-align:center;">'+r.n+'</td>'+
        '<td class="mono" style="text-align:center;">'+r.median.toFixed(3)+'s</td>'+
        '<td class="mono" style="text-align:center;">'+r.sd.toFixed(3)+'s</td>'+
        '<td class="mono" style="text-align:center;">'+r.iqr.toFixed(3)+'s</td>'+
        '<td style="text-align:center;">'+eval_+'</td>'+
        '</tr>';
    }).join('')+'</table>';
}

// ─── 3) DEGRADO GOMME ───
function _anDetectStints(carId, driverId){
  // Use pit stops and tyre mounts as stint markers
  var laps = _lapsForCar(carId, driverId);
  var pitLaps = new Set();
  try { (typeof _pitStops!=='undefined'?_pitStops[carId]||[]:[]).forEach(function(p){if(p.lap) pitLaps.add(+p.lap);}); } catch(e){}
  try {
    var ts = STATE.tyres[carId] || STATE.rallyTyres[carId];
    if(ts){
      (ts.history||[]).forEach(function(t){ if(t.lapsMounted) pitLaps.add(+t.lapsMounted); });
      if(ts.current && ts.current.lapsMounted) pitLaps.add(+ts.current.lapsMounted);
    }
  } catch(e){}
  var stints = [];
  var cur = { laps:[] };
  laps.forEach(function(l){
    if(pitLaps.has(+l.lap) && cur.laps.length){
      stints.push(cur);
      cur = { laps:[l] };
    } else {
      cur.laps.push(l);
    }
  });
  if(cur.laps.length) stints.push(cur);
  return stints;
}

function anRenderDegrado(){
  // Perf guard: skip rebuild if container is hidden
  var _g = document.getElementById('an-degrado-chart');
  if(_g && !_g.offsetParent && !window.__FORCE_REBUILD) return;

  var chartEl = document.getElementById('an-degrado-chart');
  var stintsEl = document.getElementById('an-degrado-stints');
  if(!chartEl) return;
  if(typeof Plotly==='undefined'){ chartEl.innerHTML='<div style="padding:20px;color:var(--text3);">Plotly non caricato</div>'; return; }
  if(!AN.degradoCar){ chartEl.innerHTML = '<div style="padding:30px;text-align:center;color:var(--text3);">Seleziona una vettura</div>'; stintsEl.innerHTML=''; return; }
  var driverFilter = _selectedDriverFilter('an-driver-filter');
  var stints = _anDetectStints(AN.degradoCar, driverFilter);
  if(!stints.length){ chartEl.innerHTML='<div style="padding:30px;text-align:center;color:var(--text3);">Nessun giro</div>'; stintsEl.innerHTML=''; return; }
  var palette = ['#2b7de9','#e8421a','#2cbc6e','#8b5cf6','#f59e0b','#14b8a6','#ec4899','#84cc16'];
  var traces = [];
  var infoRows = [];
  stints.forEach(function(st,si){
    var xs = [], ys = [];
    st.laps.forEach(function(l,i){
      var t = parseTime(l.time);
      if(t){ xs.push(i+1); ys.push(t/1000); }
    });
    if(!ys.length) return;
    var color = palette[si%palette.length];
    traces.push({ x:xs, y:ys, name:'Stint #'+(si+1)+' ('+st.laps.length+' giri)', mode:'lines+markers', line:{color:color, width:2.5}, marker:{size:8} });
    // Trendline slope per stint (sec/giro)
    if(ys.length>=3){
      var n = ys.length;
      var sx=0,sy=0,sxy=0,sxx=0;
      for(var i=0;i<n;i++){ sx+=xs[i]; sy+=ys[i]; sxy+=xs[i]*ys[i]; sxx+=xs[i]*xs[i]; }
      var slope = (n*sxy-sx*sy)/(n*sxx-sx*sx||1);
      var intercept = (sy-slope*sx)/n;
      traces.push({ x:xs, y:xs.map(function(x){return slope*x+intercept;}), name:'Trend #'+(si+1), mode:'lines', line:{color:color, width:1.5, dash:'dash'}, showlegend:false, hoverinfo:'skip' });
      infoRows.push({ stint:si+1, nlaps:st.laps.length, best:Math.min.apply(null,ys), avg:ys.reduce(function(a,b){return a+b;},0)/ys.length, slope:slope, color:color, startLap:st.laps[0].lap, endLap:st.laps[st.laps.length-1].lap });
    } else {
      infoRows.push({ stint:si+1, nlaps:st.laps.length, best:Math.min.apply(null,ys), avg:ys.reduce(function(a,b){return a+b;},0)/ys.length, slope:null, color:color, startLap:st.laps[0].lap, endLap:st.laps[st.laps.length-1].lap });
    }
  });
  Plotly.newPlot(chartEl, traces, {
    paper_bgcolor:'transparent', plot_bgcolor:'rgba(255,255,255,0.02)',
    font:{ color:'#a8afc0', family:'Share Tech Mono, monospace' },
    xaxis:{ title:'Giro nello stint', gridcolor:'rgba(255,255,255,0.08)', zeroline:false },
    yaxis:{ title:'Tempo giro (s)', gridcolor:'rgba(255,255,255,0.08)', zeroline:false },
    margin:{ t:20, l:55, r:20, b:40 },
    legend:{ orientation:'h', y:-0.15 }
  }, { displaylogo:false, responsive:true });
  // Stints table
  stintsEl.innerHTML = '<table style="width:100%;border-collapse:collapse;font-size:11px;">'+
    '<tr style="background:var(--bg3);"><th style="padding:6px 8px;text-align:left;">Stint</th><th>Range</th><th>Giri</th><th>Best</th><th>Media</th><th>Degrado (s/giro)</th><th>Valutazione</th></tr>'+
    infoRows.map(function(r){
      var sl = r.slope;
      var deg, evalTxt;
      if(sl==null){ deg='—'; evalTxt='<span style="color:var(--text3);">(dati insufficienti)</span>'; }
      else {
        deg = (sl>=0?'+':'')+sl.toFixed(4)+'s';
        if(sl<-0.02)      evalTxt = '<span style="color:var(--green);">📈 Miglioramento</span>';
        else if(sl<0.02)  evalTxt = '<span style="color:var(--text2);">≈ Stabile</span>';
        else if(sl<0.1)   evalTxt = '<span style="color:var(--yellow);">📉 Lieve degrado</span>';
        else              evalTxt = '<span style="color:var(--red);">📉 Degrado marcato</span>';
      }
      return '<tr style="border-bottom:1px solid var(--border);">'+
        '<td style="padding:4px 8px;"><span class="an-dot" style="background:'+r.color+';"></span> #'+r.stint+'</td>'+
        '<td class="mono">G'+r.startLap+'→G'+r.endLap+'</td>'+
        '<td class="mono" style="text-align:center;">'+r.nlaps+'</td>'+
        '<td class="mono" style="text-align:center;color:var(--green);">'+r.best.toFixed(3)+'s</td>'+
        '<td class="mono" style="text-align:center;">'+r.avg.toFixed(3)+'s</td>'+
        '<td class="mono" style="text-align:center;">'+deg+'</td>'+
        '<td style="text-align:center;">'+evalTxt+'</td>'+
        '</tr>';
    }).join('')+'</table>';
}

