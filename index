// BARCODE SCANNER (BarcodeDetector API)
// ═══════════════════════════════════════════════════════════════
var _barcodeStream = null;
var _barcodeDetector = null;
var _barcodeScanInterval = null;
// Target for the scan result: 'spare-part' (default, adds to ricambi)
//   or { kind:'input', targetId:'...' } → writes code into that input
//   or { kind:'tyre', prefix:'tr-', wheel:'FL' } → writes code into tr-code-FL
//   or { kind:'tyre-mounted', wheel:'FL' } → updates current tyre code on the selected car
var _barcodeTarget = 'spare-part';

function openBarcodeScanner(targetOpts) {
