function exportExcel() {
  const wb = XLSX.utils.book_new();
  const now = new Date().toLocaleDateString('it-IT');
  const nowFull = new Date().toLocaleString('it-IT');
  const session = document.getElementById('session-type')?.value||'SESSION';
  const circuitName = STATE.circuit ? (CIRCUITS[STATE.circuit]?.name||STATE.circuit) :
    document.getElementById('rally-event-sel')?.selectedOptions[0]?.text||'—';
  const mode = STATE.mode==='track'?'PISTA':'RALLY';
  const cars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;

  // ── RIEPILOGO (first sheet, most important) ──
  const sumRows = [
    ['RACE ENGINEER PRO', 'Export completo', nowFull],
    ['Modalità', mode, ''],
    ['Circuito / Rally', circuitName, ''],
    ['Sessione', session, ''],
    ['Fondo', STATE.surface||'—', ''],
    ['Data', now, ''],
    ['', '', ''],
    ['VETTURA','CATEGORIA','GIRI TOT','BEST LAP','BEST LAP (s)','MEDIA (s)','POSIZIONE','STATO','KM PERCORSI'],
  ];
  const allCars = [...STATE.trackCars,...STATE.rallyCars];
  allCars.forEach(car=>{
    const laps = STATE.laps[car.id]||[];
    const best = getBestLapMs(car.id);
    const avgMs = laps.length ? laps.reduce((a,l)=>a+(parseTime(l.time)||0),0)/laps.length : 0;
    const km = STATE.circuit ? laps.length*(CIRCUITS[STATE.circuit]?.km||0) : 0;
    sumRows.push([car.name, car.category||car.type, laps.length, getBestLap(car.id)||'—',
      best?(best/1000).toFixed(3):'', avgMs?(avgMs/1000).toFixed(3):'',
      STATE.positions[car.id]?.current||'—', car.retired?'RITIRATA':'ATTIVA',
      km>0?km.toFixed(2)+'km':'—']);
  });
  const wsSum = styleSheetAdvanced(XLSX.utils.aoa_to_sheet(sumRows), 7);
  XLSX.utils.book_append_sheet(wb, wsSum, '📊 Riepilogo');

  // ── TEMPI GIRI ──
  const lapRows = [['VETTURA','SESSIONE','GIRO #','TEMPO','S1','S2','S3','Δ BEST','Δ PREV','POS','NOTE','STATO GOMME']];
  allCars.forEach(car=>{
    const best=getBestLapMs(car.id);
    const laps=STATE.laps[car.id]||[];
    let prevMs=null;
    laps.forEach(l=>{
      const ms=parseTime(l.time);
      const dBest=ms&&best?deltaStr(ms-best):'';
      const dPrev=ms&&prevMs?deltaStr(ms-prevMs):'';
      const tyreInfo=STATE.tyres[car.id]?.current?.wheels ?
        ['FL','FR','RL','RR'].map(w=>STATE.tyres[car.id].current.wheels[w]?.compound||'?').join('/') : '—';
      lapRows.push([car.name,l.session||session,l.lap,l.time,l.s1||'',l.s2||'',l.s3||'',dBest,dPrev,l.pos||'',l.note||'',tyreInfo]);
      prevMs=ms;
    });
  });
  const wsLaps = styleSheetAdvanced(XLSX.utils.aoa_to_sheet(lapRows));
  XLSX.utils.book_append_sheet(wb, wsLaps, '⏱ Tempi');

  // ── GOMME (new format: per-wheel compounds) ──
  const tyreRows = [['VETTURA','SET #','MONTATO','GIRI USATI','KM PERCORSI',
    'CPD FL','USURA FL%','CPD FR','USURA FR%','CPD RL','USURA RL%','CPD RR','USURA RR%',
    'DANNO FL','DANNO FR','DANNO RL','DANNO RR','NOTE']];
  allCars.forEach(car=>{
    const ts=STATE.tyres[car.id];
    const addTyreRow=(t,label='STORICO')=>{
      if(!t?.wheels) return;
      const W=['FL','FR','RL','RR'];
      tyreRows.push([car.name,t.set||'—',t.mountedAt||label,t.lapsUsed||0,+(t.km||0).toFixed(1),
        ...W.flatMap(w=>[t.wheels[w]?.compound||'?', t.wheels[w]?.wear||0]),
        ...W.map(w=>t.wheels[w]?.damage||'none'),t.note||'']);
    };
    if(ts?.current) addTyreRow(ts.current,'CORRENTE');
    (ts?.history||[]).forEach(t=>addTyreRow(t));
    // Rally tyres
    const rts=STATE.rallyTyres?.[car.id];
    if(rts?.current) addTyreRow(rts.current,'CORRENTE RALLY');
    (rts?.history||[]).forEach(t=>addTyreRow(t));
  });
  const wsTyres = styleSheetAdvanced(XLSX.utils.aoa_to_sheet(tyreRows));
  XLSX.utils.book_append_sheet(wb, wsTyres, '🔴 Gomme');

  // ── CARBURANTE ──
  const fuelRows = [['VETTURA','GIRO/PS','EVENTO','LITRI','LIVELLO DOPO','CONS/GIRO','LIVELLO %','NOTE']];
  allCars.forEach(car=>{
    const f=STATE.fuel[car.id];
    (f?.log||[]).forEach(l=>{
      const pct=f?.capacity?+((l.level/f.capacity)*100).toFixed(1):'';
      fuelRows.push([car.name,l.lap,l.event,l.liters,l.level,l.perLap||'',pct,l.note||'']);
    });
  });
  const wsFuel = styleSheetAdvanced(XLSX.utils.aoa_to_sheet(fuelRows));
  XLSX.utils.book_append_sheet(wb, wsFuel, '⛽ Carburante');

  // ── DANNI ──
  const dmgRows = [['VETTURA','SESSIONE','GIRO','MOTORE','SOSPENSIONI','FRENI','CARROZZERIA','CAMBIO','ELETTRONICA','STERZO','RAFFREDD.','GRAVITÀ','DESCRIZIONE','ORA']];
  allCars.forEach(car=>{
    (STATE.damage[car.id]||[]).forEach(e=>{
      const comps=[e.engine,e.suspension,e.brakes,e.body,e.gearbox,e.electronics,e.steering,e.cooling];
      const severity=comps.includes('critical')?'CRITICO':comps.includes('major')?'MAGGIORE':comps.includes('minor')?'MINORE':'OK';
      dmgRows.push([car.name,e.session||'—',e.lap||'—',e.engine||'ok',e.suspension||'ok',e.brakes||'ok',e.body||'ok',e.gearbox||'ok',e.electronics||'ok',e.steering||'ok',e.cooling||'ok',severity,e.desc||'',e.timestamp||'']);
    });
    // Rally damage
    (STATE.rallyDamage||[]).filter(e=>e.car===car.name).forEach(e=>{
      dmgRows.push([car.name,'RALLY','PS'+e.stage,e.engine||'ok',e.suspension||'ok',e.brakes||'ok',e.body||'ok',e.gearbox||'ok',e.electronics||'ok',e.steering||'ok',e.cooling||'ok','—',e.desc||'',e.timestamp||'']);
    });
  });
  const wsDmg = styleSheetAdvanced(XLSX.utils.aoa_to_sheet(dmgRows));
  XLSX.utils.book_append_sheet(wb, wsDmg, '🔧 Danni');

  // ── SETUP COMPLETO ──
  const setupRows = [['VETTURA','SESSIONE','GIRO','ALA ANT.','ALA POST.','SPLITTER',
    'MOLLA ANT.','MOLLA POST.','BARRA ANT.','BARRA POST.',
    'BUMP ANT.(slow)','REB ANT.(slow)','BUMP POST.(slow)','REB POST.(slow)',
    'F.BUMP ANT.','F.REB ANT.','F.BUMP POST.','F.REB POST.',
    'CAMBER FL','CAMBER FR','CAMBER RL','CAMBER RR',
    'TOE ANT.','TOE POST.','BIAS FRENO','MAPPA','CAMBIO','NOTE','ORA']];
  allCars.forEach(car=>{
    const setupData=[...(STATE.setup[car.id]||[]),...(STATE.rallySetup?.[car.id]||[])];
    setupData.forEach(e=>setupRows.push([car.name,e.session||'—',e.lap||e.ps||'—',
      e.wingF||'',e.wingR||'',e.splitter||'',
      e.springF||'',e.springR||'',e.barF||'',e.barR||'',
      e.bumpF||'',e.rebF||'',e.bumpR||'',e.rebR||'',
      e.fastBumpF||'',e.fastRebF||'',e.fastBumpR||'',e.fastRebR||'',
      e.camberFL||'',e.camberFR||'',e.camberRL||'',e.camberRR||'',
      e.toeF||'',e.toeR||'',e.brakeBias||'',e.engMap||'',e.gearbox||'',e.notes||'',e.timestamp||'']));
  });
  const wsSetup = styleSheetAdvanced(XLSX.utils.aoa_to_sheet(setupRows));
  XLSX.utils.book_append_sheet(wb, wsSetup, '⚙️ Setup');

  // ── PIT STOP ──
  if(Object.values(_pitStops||{}).some(p=>p.length)) {
    const pitRows = [['VETTURA','GIRO','DURATA (s)','TARGET (s)','DELTA','TIPO','POS PRIMA','POS DOPO','CARB. AGGIUNTO','PERDITA LANE','NOTE','ORA']];
    allCars.forEach(car=>{
      (_pitStops[car.id]||[]).forEach(p=>{
        const diff=(p.duration-p.target).toFixed(3);
        const typeLabels={tyre:'Gomme',fuel:'Carburante',tyre_fuel:'Gomme+Carb.',repair:'Riparazione',drive_through:'Drive Through',other:'Altro'};
        pitRows.push([car.name,p.lap,p.duration.toFixed(3),p.target,diff,typeLabels[p.type]||p.type,p.posBefore,p.posAfter,p.fuelAdded||0,p.laneLoss||0,p.notes||'',p.timestamp||'']);
      });
    });
    XLSX.utils.book_append_sheet(wb, styleSheetAdvanced(XLSX.utils.aoa_to_sheet(pitRows)), '🔧 Pit Stop');
  }

  // ── TELEMETRIA + NOTE PILOTA ──
  // Skip the Telemetria sheet entirely if there are no notes — avoids confusing
  // empty-sheet behavior on some Excel versions, and removes a potentially-blank tab.
  const teleRows = [['VETTURA','GIRO','CATEGORIA','PRIORITÀ','NOTA','ORA']];
  let teleCount = 0;
  allCars.forEach(car=>{
    (STATE.teleNotes[car.id]||[]).forEach(n=>{
      teleRows.push([car.name||'?', n.lap||'', n.cat||'', n.prio||'', n.note||'', n.timestamp||'']);
      teleCount++;
    });
  });
  if(teleCount > 0){
    XLSX.utils.book_append_sheet(wb, styleSheetAdvanced(XLSX.utils.aoa_to_sheet(teleRows)), 'Note Telemetria');
  }

  const dnRows = [['VETTURA','GIRO/PS','PUNTO','CATEGORIA','INTENSITÀ','NOTA PILOTA','RISPOSTA TECNICA','ORA']];
  allCars.forEach(car=>{ (_driverNotes[car.id]||[]).forEach(n=>dnRows.push([car.name,n.lap,n.point||'—',n.cat,n.intensity,n.note,n.response||'',n.timestamp])); });
  if(dnRows.length>1) XLSX.utils.book_append_sheet(wb, styleSheetAdvanced(XLSX.utils.aoa_to_sheet(dnRows)), '🗣 Note Pilota');

  // ── PROVE SPECIALI (rally) ──
  if(STATE.stages.length) {
    const stageRows = [['STATO','PS #','NOME PS','VETTURA','KM SS','KM TRASF.','TEMPO','POS ASS.','POS CLS.','CONS SS (L)','CONS TRASF (L)','FONDO','FANALIERA']];
    STATE.stages.forEach(s=>stageRows.push([s.cancelled?'ANNULLATA':'OK','PS'+s.num,s.name||'—',s.car,s.km,s.tfKm||0,s.time||'—',s.absPos||'—',s.clsPos||'—',s.fuelSS||0,s.fuelTF||0,s.surface||'—',s.lights?'SÌ':'NO']));
    XLSX.utils.book_append_sheet(wb, styleSheetAdvanced(XLSX.utils.aoa_to_sheet(stageRows)), '🌿 Prove Speciali');
  }

  // ── RICAMBI ──
  const spareTrack = (SPARE_PARTS?.track||[]);
  const spareRally = (SPARE_PARTS?.rally||[]);
  if(spareTrack.length||spareRally.length) {
    const spareRows = [['MODALITÀ','CATEGORIA','NOME PEZZO','QUANTITÀ','USATI','NOTE']];
    spareTrack.forEach(p=>spareRows.push(['PISTA',p.cat,p.name,p.qty,p.used||0,p.note||'']));
    spareRally.forEach(p=>spareRows.push(['RALLY',p.cat,p.name,p.qty,p.used||0,p.note||'']));
    XLSX.utils.book_append_sheet(wb, styleSheetAdvanced(XLSX.utils.aoa_to_sheet(spareRows)), '📦 Ricambi');
  }

  // ── AVVERSARI ──
  if((_competitors||[]).length) {
    const compRows = [['NOME','CATEGORIA','BEST LAP','GIRI INSERITI','GAP DA NOI']];
    _competitors.forEach(comp=>{
      const ourBest=getBestLapMs(STATE.trackCars[STATE.selectedTrackCar].id);
      const theirBest=comp.laps.length?Math.min(...comp.laps.map(l=>parseTime(l)||Infinity).filter(t=>t!==Infinity)):null;
      const gap=ourBest&&theirBest?deltaStr(theirBest-ourBest):'—';
      compRows.push([comp.name,comp.cls||'—',theirBest?msToTime(theirBest):'—',comp.laps.length,gap]);
    });
    XLSX.utils.book_append_sheet(wb, styleSheetAdvanced(XLSX.utils.aoa_to_sheet(compRows)), '🏁 Avversari');
  }

  const fname = `REP_${mode}_${circuitName.replace(/[^a-zA-Z0-9]/g,'_')}_${now.replace(/\//g,'-')}.xlsx`;
  var _dnR=[['VETTURA','GIRO','CAT','NOTA','ORA']];
  STATE.trackCars.concat(STATE.rallyCars).forEach(function(car){(_driverNotes[car.id]||[]).forEach(function(n){_dnR.push([car.name,n.lap,n.cat||'',n.note,n.timestamp]);});});
  if(_dnR.length>1)XLSX.utils.book_append_sheet(wb,applyHeaderStyle(XLSX.utils.aoa_to_sheet(_dnR)),'NoteP');
  XLSX.writeFile(wb, fname);
  showToast('📊 Excel esportato: '+fname);
}

