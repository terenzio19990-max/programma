// ═══════════════════════════════════════════════════════════════
// CRONOMETRO — manual lap timer (button-based)
// State persisted to localStorage so it survives reload
// ═══════════════════════════════════════════════════════════════
var CHRONO_KEY = 'REP_chrono_v1';
// New storage: { cars: { [carId]: {running, startedAt, accumulated, lastLapAt, laps:[]} } }
// Legacy: { running, startedAt, accumulated, lastLapAt, laps:[] }  -> migrated to cars._global
var _chronoStore = null;  // entire storage object
var _chrono = null;       // pointer to current car's chrono state (set by _chronoLoad)
var _chronoTimer = null;  // setInterval handle
var _chronoCurrentCarId = null;  // tracks which car _chrono belongs to

// Returns the carId that the chronometer should follow.
// In track mode: the selected track car. In rally mode: '_global' (chrono not really used there).
function _chronoCurrentCarKey(){
  try {
    if(typeof STATE !== 'undefined' && STATE.mode !== 'rally' && STATE.trackCars && STATE.trackCars.length){
      var car = STATE.trackCars[STATE.selectedTrackCar||0];
      if(car && car.id) return car.id;
    }
  } catch(_){}
  return '_global';
}

function _chronoLoadStore(){
  if(_chronoStore) return _chronoStore;
  try {
    var raw = JSON.parse(localStorage.getItem(CHRONO_KEY)||'null');
    if(raw){
      // Migration: old single-chrono format detected -> wrap as cars._global
      if(raw.cars && typeof raw.cars === 'object'){
        _chronoStore = raw;
      } else if(raw.laps !== undefined || raw.running !== undefined){
        _chronoStore = { cars: { '_global': raw } };
      } else {
        _chronoStore = { cars: {} };
      }
    } else {
      _chronoStore = { cars: {} };
    }
  } catch(_){ _chronoStore = { cars: {} }; }
  if(!_chronoStore.cars) _chronoStore.cars = {};
  return _chronoStore;
}

// Loads the chrono state of the currently-selected car. Stops the timer if
// switching to a different car (so two cars don't tick at once visually).
function _chronoLoad(){
  _chronoLoadStore();
  var key = _chronoCurrentCarKey();
  // If we switched car while a timer was running, stop the visual ticker
  if(_chronoCurrentCarId !== null && _chronoCurrentCarId !== key && _chronoTimer){
    clearInterval(_chronoTimer); _chronoTimer = null;
  }
  _chronoCurrentCarId = key;
  if(!_chronoStore.cars[key]){
    _chronoStore.cars[key] = { running:false, startedAt:0, accumulated:0, lastLapAt:0, laps:[] };
  }
  _chrono = _chronoStore.cars[key];
  return _chrono;
}
function _chronoSave(){
  // _chrono is a reference into _chronoStore.cars[carId], so saving the store persists it
  try { localStorage.setItem(CHRONO_KEY, JSON.stringify(_chronoStore||{cars:{}})); } catch(_){}
}

// Force re-bind to the (possibly different) current car. Called by selectTrackCar.
// If the timer is running for the new car, restart visual tick. Otherwise, leave it stopped.
function _chronoRebind(){
  _chronoLoad();
  // Update label showing which car this chrono belongs to
  try {
    var lblEl = document.getElementById('chrono-car-label');
    if(lblEl){
      var car = STATE.trackCars[STATE.selectedTrackCar||0];
      lblEl.textContent = car ? '— '+car.name : '— vettura corrente';
    }
  } catch(_){}
  if(_chrono && _chrono.running){
    _chronoTickStart();
  } else {
    _chronoTickStop();
  }
  _chronoUpdateDisplay();
  _chronoUpdateButtons();
  _chronoUpdateLapsList();
}
window._chronoRebind = _chronoRebind;

// performance.now() preferred (monotonic); fall back to Date.now()
function _chronoNow(){
  return (typeof performance !== 'undefined' && performance.now) ? performance.now() : Date.now();
}

// Format ms as m:ss.mmm
function _chronoFmt(ms){
  if(ms < 0) ms = 0;
  var totalMs = Math.floor(ms);
  var min = Math.floor(totalMs/60000);
  var sec = Math.floor((totalMs%60000)/1000);
  var mil = totalMs%1000;
  return min+':'+(sec<10?'0':'')+sec+'.'+(mil<100?'0':'')+(mil<10?'0':'')+mil;
}

// Compute current elapsed (since session start, not since lap)
function _chronoElapsed(){
  _chronoLoad();
  if(_chrono.running){
    return _chrono.accumulated + (_chronoNow() - _chrono.startedAt);
  }
  return _chrono.accumulated;
}

// Compute current lap time (since last lap mark, or session start if first lap)
function _chronoCurrentLapMs(){
  _chronoLoad();
  var elapsed = _chronoElapsed();
  return elapsed - (_chrono.lastLapAt || 0);
}

function chronoStart(){
  _chronoLoad();
  if(_chrono.running) return;
  _chrono.running = true;
  _chrono.startedAt = _chronoNow();
  // If fresh start (no accumulated), zero lastLapAt
  if(_chrono.accumulated === 0 && _chrono.laps.length === 0){
    _chrono.lastLapAt = 0;
  }
  _chronoSave();
  _chronoTickStart();
  _chronoUpdateButtons();
  showToast('▶ Cronometro avviato');
}
window.chronoStart = chronoStart;

function chronoStop(){
  _chronoLoad();
  if(!_chrono.running) return;
  _chrono.accumulated += _chronoNow() - _chrono.startedAt;
  _chrono.running = false;
  _chrono.startedAt = 0;
  _chronoSave();
  _chronoTickStop();
  _chronoUpdateDisplay();
  _chronoUpdateButtons();
}
window.chronoStop = chronoStop;

function chronoResume(){
  _chronoLoad();
  if(_chrono.running) return;
  _chrono.running = true;
  _chrono.startedAt = _chronoNow();
  _chronoSave();
  _chronoTickStart();
  _chronoUpdateButtons();
}
window.chronoResume = chronoResume;

function chronoLap(){
  _chronoLoad();
  if(!_chrono.running) {
    showToast('⚠️ Cronometro fermo, premi START');
    return;
  }
  var elapsed = _chronoElapsed();
  var lapMs = elapsed - (_chrono.lastLapAt || 0);
  // Block double-taps and unreasonably short laps
  if(lapMs < 1000) {
    showToast('⚠️ Lap ignorato (<1s) — doppio tap?');
    return;
  }
  _chrono.laps.push({
    n: _chrono.laps.length + 1,
    ms: Math.round(lapMs),
    at: Date.now()
  });
  _chrono.lastLapAt = elapsed;
  _chronoSave();
  _chronoUpdateLapsList();
  _chronoUpdateDisplay();  // immediato refresh dei numeri
  // Flash visibile sopra la lista — non si può non vederlo
  var flash = document.getElementById('chrono-flash');
  if(flash){
    flash.textContent = '🚩 GIRO ' + _chrono.laps.length + ' REGISTRATO: ' + _chronoFmt(lapMs);
    flash.style.display = 'block';
    flash.style.background = 'var(--green)';
    // Best?
    var best = Math.min.apply(null, _chrono.laps.map(function(l){return l.ms;}));
    if(lapMs === best && _chrono.laps.length > 1){
      flash.textContent = '🏆 NUOVO BEST! GIRO ' + _chrono.laps.length + ': ' + _chronoFmt(lapMs);
      flash.style.background = 'var(--accent3)';
    }
    // Auto-hide dopo 2.5s
    if(flash._tm) clearTimeout(flash._tm);
    flash._tm = setTimeout(function(){
      flash.style.display = 'none';
    }, 2500);
  }
  // Quick visual feedback on the LAP button
  var btn = document.getElementById('chrono-btn-lap');
  if(btn){
    btn.style.transform = 'scale(0.95)';
    setTimeout(function(){ btn.style.transform = ''; }, 150);
  }
}
window.chronoLap = chronoLap;

