function parseTimeToken(t){
  return (typeof parseTime==='function')? parseTime(t) : null;
}
window.repImpParse = function(text, mode){
  // ritorna { rows:[{lap/num, time, s1,s2,s3, name, km}], note }
  var rows=[], note='';
  if(!text) return {rows:rows, note:'vuoto'};
  // HTML? estrai testo delle celle
  if(/<t[rd]/i.test(text)){
    try {
      var doc=new DOMParser().parseFromString(text,'text/html');
      var lines=[];
      doc.querySelectorAll('tr').forEach(function(tr){
        var cs=[]; tr.querySelectorAll('td,th').forEach(function(td){ cs.push(td.textContent.trim()); });
        if(cs.length) lines.push(cs.join(';'));
      });
      text=lines.join('\n');
      note='tabella HTML riconosciuta · ';
    } catch(e){}
  }
  var lns=text.split(/\r?\n/).map(function(l){return l.trim();}).filter(Boolean);
  if(!lns.length) return {rows:rows, note:'vuoto'};
  // header CSV?
  var sep = (lns[0].split(';').length>1)? ';' : (lns[0].split('\t').length>1? '\t' : (lns[0].split(',').length>2 ? ',' : null));
  var head=null, start=0;
  if(sep){
    var h0=lns[0].toLowerCase().split(sep).map(function(x){return x.trim();});
    if(h0.some(function(x){ return /lap|giro|tempo|time|ps/.test(x); })){ head=h0; start=1; }
  }
  for(var i=start;i<lns.length;i++){
    var l=lns[i];
    var cells = sep? l.split(sep).map(function(x){return x.trim();}) : l.split(/\s+/);
    var r={};
    if(head){
      function col(){ for(var a=0;a<arguments.length;a++){ var j=-1; for(var c=0;c<head.length;c++){ if(head[c].indexOf(arguments[a])>=0){ j=c; break; } } if(j>=0) return cells[j]; } return undefined; }
      r.lap = col('lap','giro','ps','n.');
      r.time = col('tempo','time');
      r.s1=col('s1','settore 1','sector1'); r.s2=col('s2','settore 2','sector2'); r.s3=col('s3','settore 3','sector3');
      r.name=col('nome','name','prova'); r.km=col('km','lungh');
      if(r.time && parseTimeToken(r.time)) rows.push(r);
      continue;
    }
    // euristica senza header: trova il primo token-tempo
    var ti=-1;
    for(var c2=0;c2<cells.length;c2++){ if(/\d+[:'.]\d{2}[.:]\d{1,3}|^\d{1,3}\.\d{1,3}$/.test(cells[c2]) && parseTimeToken(cells[c2])){ ti=c2; break; } }
    if(ti<0) continue;
    r.time=cells[ti];
    r.lap = (ti>0 && /^\d{1,3}$/.test(cells[0]))? cells[0] : String(rows.length+1);
    // settori: i 3 token-tempo successivi
    var secs=[];
    for(var c3=ti+1;c3<cells.length && secs.length<3;c3++){ if(parseTimeToken(cells[c3])) secs.push(cells[c3]); }
    if(secs.length===3){ r.s1=secs[0]; r.s2=secs[1]; r.s3=secs[2]; }
    if(mode==='rally' && ti>=2 && isNaN(parseFloat(cells[1]))) r.name=cells.slice(1,ti).join(' ');
    rows.push(r);
  }
  return { rows:rows, note: note + rows.length+' righe riconosciute' };
};
