function loadGPXFile(event) {
  var file = event.target.files[0]; if(!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    try { parseGPX(e.target.result, file.name); }
    catch(err) {
      var st = document.getElementById('gpx-status');
      if(st) st.innerHTML='<span style="color:var(--red);">Errore: '+err.message+'</span>';
    }
  };
  reader.readAsText(file);
}
function parseGPX(xmlText, filename) {
  var parser = new DOMParser();
  var xml = parser.parseFromString(xmlText, 'application/xml');
  if(xml.querySelector('parsererror')) throw new Error('XML non valido');
  var trkpts = xml.querySelectorAll('trkpt,rtept,wpt');
  if(!trkpts.length) throw new Error('Nessun punto GPS trovato');
  var lats=[],lons=[],alts=[];
  trkpts.forEach(function(pt) {
    var lat=parseFloat(pt.getAttribute('lat'));
    var lon=parseFloat(pt.getAttribute('lon'));
    var eleEl=pt.querySelector('ele');
    var alt=eleEl?parseFloat(eleEl.textContent):0;
    if(!isNaN(lat)&&!isNaN(lon)) { lats.push(lat); lons.push(lon); alts.push(isNaN(alt)?0:alt); }
  });
  if(lats.length < 2) throw new Error('Dati GPS insufficienti');
  var csvLines = ['lat,lon,alt'];
  for(var i=0;i<lats.length;i++) csvLines.push(lats[i]+','+lons[i]+','+alts[i]);
  if(typeof parseAndPlotGPS === 'function') parseAndPlotGPS(csvLines.join('\n'));
  var st = document.getElementById('gpx-status');
  if(st) st.innerHTML='<span style="color:var(--green);">Caricato: '+lats.length+' punti GPS da "'+( filename||'file')+'"</span>';
  showPage('map3d');
  showToast('GPX importato - '+lats.length+' punti. Vai alla Mappa 3D.');
}

