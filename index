  var filename = 'REP_' + mode + '_' + circuitName.replace(/[^a-zA-Z0-9]/g,'_') + '_' + dateStr + '_' + timeStr + '.json';
  var jsonStr = JSON.stringify(data, null, 2);

  // Show loading
  var btn = document.querySelector('[onclick="gdriveSaveSession()"]');
  var oldText = btn ? btn.textContent : '';
  if(btn) btn.textContent = 'Salvataggio...';

  gdriveGetFolderId().then(function(folderId){
    var meta = { name: filename, mimeType: GDRIVE_MIME, parents: [folderId] };
