  if(!out || !out.value) return;
  var blob = new Blob([out.value], {type:'application/json'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'rep-coop-'+new Date().toISOString().slice(0,19).replace(/[:T]/g,'-')+'.json';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  showToast('⬇ Pacchetto scaricato');
}
function coopManualShareWA(){
  var out = document.getElementById('coop-manual-output');
  if(!out || !out.value) return;
  var txt = encodeURIComponent('[Race Engineer Pro — pacchetto coop]\n\n'+out.value.slice(0,800)+(out.value.length>800?'\n\n[...troppo lungo per WhatsApp — usa "Scarica .json" e condividi il file]':''));
  window.open('https://wa.me/?text='+txt, '_blank');
}
function coopManualImport(){
  var inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = '.json,application/json';
  inp.onchange = function(e){
    var f = e.target.files[0]; if(!f) return;
    var r = new FileReader();
    r.onload = function(ev){ _coopManualApply(ev.target.result); };
    r.readAsText(f);
  };
  // Alternative: let them paste
  setTimeout(function(){
    if(confirm('Carica file .json dal dispositivo? (Annulla per incollare manualmente)')){
      inp.click();
    } else {
      var txt = prompt('Incolla qui il pacchetto JSON:');
      if(txt) _coopManualApply(txt);
    }
  }, 50);
}
function _coopManualApply(json){
  try {
    var pkg = JSON.parse(json);
    if(!pkg._REP_COOP_PKG) throw new Error('Non è un pacchetto REP coop');
    if(!confirm('Applicare il pacchetto di '+(pkg.from||'?')+' del '+new Date(pkg.ts).toLocaleString('it-IT')+'?\n\n⚠️ I dati locali verranno sovrascritti.')) return;
    _applyCoopSnapshot(pkg.state);
    coopLog('📥 Importato pacchetto da '+(pkg.from||'?'));
    showToast('✓ Pacchetto importato');
  } catch(e){
    showToast('❌ '+e.message);
  }
}

// ═══════════════════════════════════════════════════════════════
// Shared: snapshot + message handling + disconnect
// ═══════════════════════════════════════════════════════════════
function _coopSnapshot(){
  // Reuse existing session-save mechanism if available; fallback to minimal snapshot
  try {
    if(typeof _buildSessionSnapshot==='function') return _buildSessionSnapshot();
  } catch(e){}
  // Minimal manual snapshot
  return {
    STATE: JSON.parse(JSON.stringify(STATE)),
    COMPOUND_NAMES: typeof COMPOUND_NAMES!=='undefined' ? COMPOUND_NAMES : null,
    _competitors: typeof _competitors!=='undefined' ? _competitors : [],
    _driverNotes: typeof _driverNotes!=='undefined' ? _driverNotes : {},
    _pitStops: typeof _pitStops!=='undefined' ? _pitStops : {},
    savedAt: new Date().toISOString()
  };
}
function _applyCoopSnapshot(snap){
  if(!snap) return;
  COOP.applyingRemote = true;
  try {
    console.log('[COOP←] applying snapshot — replacing local STATE with host state');
    if(snap.STATE){
      // Full replace: clear arrays and objects then fill with host state so we don't
      // carry over stale local cars/laps that don't match the host.
      // Key collections we MUST replace entirely:
      var replaceKeys = ['trackCars','rallyCars','laps','tyres','rallyTyres','fuel','rallyFuel',
                         'setup','rallySetup','damage','rallyDamage','teleNotes','rallyTeleNotes',
                         'rallyNotes','stages','positions','services'];
      replaceKeys.forEach(function(k){
        if(snap.STATE[k] !== undefined){
          STATE[k] = snap.STATE[k];
        }
      });
      // Scalars / other props
      Object.keys(snap.STATE).forEach(function(k){
        if(replaceKeys.indexOf(k) < 0){
          STATE[k] = snap.STATE[k];
        }
      });
    }
    if(snap._competitors && typeof _competitors!=='undefined'){
      _competitors.length = 0;
      snap._competitors.forEach(function(x){_competitors.push(x);});
    }
    if(snap._driverNotes && typeof _driverNotes!=='undefined'){
      Object.keys(_driverNotes).forEach(function(k){delete _driverNotes[k];});
      Object.assign(_driverNotes, snap._driverNotes);
    }
    if(snap._pitStops && typeof _pitStops!=='undefined'){
      Object.keys(_pitStops).forEach(function(k){delete _pitStops[k];});
      Object.assign(_pitStops, snap._pitStops);
    }
    if(snap.COMPOUND_NAMES && typeof COMPOUND_NAMES!=='undefined'){
      Object.assign(COMPOUND_NAMES, snap.COMPOUND_NAMES);
    }
    // Persist locally so reload doesn't revert
    if(typeof triggerAutoSave==='function') triggerAutoSave();
    // Refresh the whole UI
    if(typeof buildTrackCarTabs==='function') buildTrackCarTabs();
    if(typeof updateTrackCarsPanel==='function') updateTrackCarsPanel();
    if(typeof refreshCurrentPageData==='function') refreshCurrentPageData();
    if(typeof buildDashboard==='function') buildDashboard();
    if(typeof renderCompetitorsList==='function') renderCompetitorsList();
    if(typeof buildLapsPage==='function') try { buildLapsPage(); } catch(e){}
    showToast('✓ Stato sincronizzato con host ('+((snap.STATE?.trackCars||[]).length)+' vetture pista)');
    console.log('[COOP←] snapshot applied. trackCars:', (STATE.trackCars||[]).length, 'rallyCars:', (STATE.rallyCars||[]).length);
  } catch(e){ console.error('applySnapshot err', e); }
  setTimeout(function(){ COOP.applyingRemote = false; }, 200);
}
function _handleCoopMessage(msg, fromId){
  if(!msg || !msg.type) return;
  var who = COOP.peers[fromId]?.name || msg.fromName || fromId;
  switch(msg.type){
    case 'hello':
      COOP.peers[fromId] = { name:msg.name, color:msg.color, lastSeen:Date.now() };
      coopLog('👋 '+msg.name+' si è presentato');
      _updateCoopPeersList();
      break;
    case 'peer-joined':
      COOP.peers[msg.id] = { name:msg.name, color:msg.color, lastSeen:Date.now() };
      _updateCoopPeersList();
      break;
    case 'peer-left':
      delete COOP.peers[msg.id];
      _updateCoopPeersList();
      break;
    case 'snapshot':
      _applyCoopSnapshot(msg.state);
      coopLog('📥 Snapshot ricevuto da '+who);
      break;
    case 'state-patch':
      // Partial update: { path:'STATE.laps.CC5_1', action:'push'|'set', value:... }
      _applyStatePatch(msg);
      coopLog('🔄 <b>'+who+'</b> · '+msg.desc);
      break;
    case 'presence':
      COOP.peers[fromId] = { name:msg.name, color:msg.color, lastSeen:Date.now(), page:msg.page };
      _updateCoopPeersList();
      break;
    case 'request-snapshot':
      // Guest asks for fresh state — host responds with full snapshot
      if(COOP.isHost && COOP.connections[fromId]){
        console.log('[COOP] '+who+' requested fresh snapshot, sending...');
        try { COOP.connections[fromId].send({type:'snapshot', state:_coopSnapshot(), fromName:COOP.me.name}); } catch(e){}
        showToast('📤 Snapshot inviato a '+who);
      }
      break;
    default: break;
  }
}
function _applyStatePatch(msg){
  try {
    COOP.applyingRemote = true;
    console.log('[COOP←] applying patch', { path: msg.path, action: msg.action, valuePreview: JSON.stringify(msg.value).substring(0,140), desc: msg.desc });
    // Direct dispatch on known path prefixes — avoids window traversal which fails
    // for `const STATE` declarations (const does NOT attach to window in modern browsers).
    var path = msg.path||'';
    var applied = false;

    // Handle STATE.* paths
    if(path.indexOf('STATE.') === 0){
      // Strip 'STATE.' prefix and split (e.g. 'laps.TK_1' -> ['laps','TK_1'])
      var rest = path.substring('STATE.'.length).split('.');
      if(rest.length === 2){
        var subKey = rest[0];   // e.g. 'laps'
        var carId = rest[1];    // e.g. 'TK_1'
        // Ensure the sub-container exists
        if(!STATE[subKey]) STATE[subKey] = {};
        var target = STATE[subKey][carId];
        console.log('[COOP←] STATE.'+subKey+'.'+carId, {
          existingType: Array.isArray(target) ? 'array' : typeof target,
          existingLength: Array.isArray(target) ? target.length : 'n/a',
          availableCarIds: Object.keys(STATE[subKey] || {}).slice(0, 20)
        });
        if(msg.action === 'push'){
          if(!Array.isArray(target)){
            STATE[subKey][carId] = [msg.value];
            console.warn('[COOP←] ⚠️ STATE.'+subKey+'.'+carId+' non era un array; ricreato. Probabile mismatch ID vettura.');
            showToast('⚠️ Vettura '+carId+' non presente — auto-creata');
            if(!COOP.isHost) _lanBroadcast({type:'request-snapshot', fromName:COOP.me.name});
          } else {
            target.push(msg.value);
            console.log('[COOP←] push OK — '+subKey+'.'+carId+' ora ha '+target.length+' elementi');
          }
          applied = true;
        } else if(msg.action === 'set'){
          STATE[subKey][carId] = msg.value;
          console.log('[COOP←] set applied on STATE.'+subKey+'.'+carId);
          applied = true;
        } else if(msg.action === 'delete'){
          delete STATE[subKey][carId];
          applied = true;
        }
      } else if(rest.length === 1){
        // STATE.xxx (whole collection, e.g. STATE.rallyDamage)
        var key = rest[0];
        if(msg.action === 'set'){
          STATE[key] = msg.value;
          applied = true;
        } else if(msg.action === 'push' && Array.isArray(STATE[key])){
          STATE[key].push(msg.value);
          applied = true;
        }
      }
    } else if(path === '_competitors'){
      if(msg.action === 'set' && typeof _competitors !== 'undefined'){
        _competitors.length = 0;
        (msg.value||[]).forEach(function(x){_competitors.push(x);});
        applied = true;
      }
    }

    if(!applied){
      console.warn('[COOP←] patch NOT applied — unrecognised path/action:', path, msg.action);
    }

    // Persist received change to IndexedDB so it survives reload
    if(typeof triggerAutoSave==='function') triggerAutoSave();

    // Visual feedback — a clear notification that a remote change just arrived
    if(msg.desc){
      var who = msg.fromName || 'Altro ingegnere';
      showToast('⬇ '+who+': '+msg.desc);
    }

    // Refresh UI — for laps patches, also force rendering the incoming car's laps
    // even if the user has a different car selected. We jump to that car so the
    // update is actually visible, not silently lost in STATE.
    console.log('[COOP←] refreshing UI...');
    if(path.indexOf('STATE.laps.') === 0){
      var incomingCarId = path.substring('STATE.laps.'.length);
      // Switch to the incoming car if it exists in our trackCars
      var cars = STATE.trackCars || [];
      var idx = cars.findIndex(function(c){return c.id === incomingCarId;});
      if(idx >= 0 && STATE.selectedTrackCar !== idx){
        console.log('[COOP←] switching selected car to match incoming patch (idx '+idx+')');
        STATE.selectedTrackCar = idx;
      }
      // Always rebuild the laps table/page for the incoming car
      if(typeof buildLapsTable==='function') try { buildLapsTable(incomingCarId); } catch(e){}
      if(typeof buildLapsPage==='function') try { buildLapsPage(); } catch(e){}
      if(typeof updateTrackCarsPanel==='function') try { updateTrackCarsPanel(); } catch(e){}
      if(typeof buildTrackCarTabs==='function') try { buildTrackCarTabs(); } catch(e){}
    }
    // Track tyres — mount/unmount/set changes
    if(path.indexOf('STATE.tyres.') === 0){
      if(typeof buildTyresPage==='function') try { buildTyresPage(); } catch(e){}
    }
    // Rally tyres
    if(path.indexOf('STATE.rallyTyres.') === 0){
      if(typeof buildRallyTyresPage==='function') try { buildRallyTyresPage(); } catch(e){}
    }
    // Setup (track)
    if(path.indexOf('STATE.setup.') === 0){
      var setupCarId = path.substring('STATE.setup.'.length);
      if(typeof buildSetupHistoryTable==='function') try { buildSetupHistoryTable(setupCarId); } catch(e){}
      if(typeof buildSetupCarTabs==='function') try { buildSetupCarTabs(); } catch(e){}
    }
    // Setup (rally)
    if(path.indexOf('STATE.rallySetup.') === 0){
      var rSetupCarId = path.substring('STATE.rallySetup.'.length);
      if(typeof buildRallySetupHistoryTable==='function') try { buildRallySetupHistoryTable(rSetupCarId); } catch(e){}
      if(typeof buildRallySetupPage==='function') try { buildRallySetupPage(); } catch(e){}
    }
    // Damage (track)
    if(path.indexOf('STATE.damage.') === 0){
      var dmgCarId = path.substring('STATE.damage.'.length);
      if(typeof buildDamageHistoryTable==='function') try { buildDamageHistoryTable(dmgCarId); } catch(e){}
      if(typeof buildDamagePage==='function') try { buildDamagePage(); } catch(e){}
    }
    // Damage (rally)
    if(path === 'STATE.rallyDamage'){
      if(typeof buildRallyDamageHistoryTable==='function') try { buildRallyDamageHistoryTable(); } catch(e){}
      if(typeof buildRallyDamagePage==='function') try { buildRallyDamagePage(); } catch(e){}
    }
    // Fuel (track)
    if(path.indexOf('STATE.fuel.') === 0){
      var fuelCarId = path.substring('STATE.fuel.'.length);
      if(typeof buildFuelUI==='function') try { buildFuelUI(fuelCarId); } catch(e){}
      if(typeof buildFuelLogTable==='function') try { buildFuelLogTable(fuelCarId); } catch(e){}
    }
    // Fuel (rally)
    if(path.indexOf('STATE.rallyFuel.') === 0){
      var rFuelCarId = path.substring('STATE.rallyFuel.'.length);
      if(typeof buildRallyFuelUI==='function') try { buildRallyFuelUI(); } catch(e){}
      if(typeof buildRallyFuelLogTable==='function') try { buildRallyFuelLogTable(rFuelCarId); } catch(e){}
    }
    // Rally stages (prove speciali)
    if(path === 'STATE.stages'){
      if(typeof refreshStages==='function') try { refreshStages(); } catch(e){}
      if(typeof updateRallyTyreKm==='function') try { updateRallyTyreKm(); } catch(e){}
      if(typeof updateRallyFuelFromStages==='function') try { updateRallyFuelFromStages(); } catch(e){}
    }
    // Competitors
    if(path === '_competitors'){
      if(typeof renderCompetitorsList==='function') try { renderCompetitorsList(); } catch(e){}
      if(typeof updateCompGaps==='function') try { updateCompGaps(); } catch(e){}
      if(typeof renderCategoryRanking==='function') try { renderCategoryRanking(); } catch(e){}
    }
    // General refresh for whatever page we're on
    if(typeof refreshCurrentPageData==='function') try { refreshCurrentPageData(); } catch(e){}
    if(typeof buildDashboard==='function') try { buildDashboard(); } catch(e){}
    console.log('[COOP←] UI refresh done');
  } catch(e){ console.warn('[COOP←] patch fail', e); }
  finally { setTimeout(function(){ COOP.applyingRemote = false; }, 200); }
}

// Public API — any change the app makes can broadcast a patch
function coopBroadcastPatch(path, action, value, desc){
  if(COOP.status==='disconnected' || COOP.applyingRemote) return;
  var msg = { type:'state-patch', path:path, action:action, value:value, desc:desc||path, fromName:COOP.me.name };
  var peerCount = Object.keys(COOP.connections).length;
  console.log('[COOP→] broadcast patch', { path: path, action: action, mode: COOP.mode, status: COOP.status, peers: peerCount, desc: desc });
  coopLog('→ invio: '+(desc||path)+' ('+peerCount+' peer)');
  if(COOP.mode==='lan') _lanBroadcast(msg);
  else if(COOP.mode==='firebase') _coopFbPublish(msg);
}
// Broadcast a full fresh snapshot (use after big changes / on-demand)
function coopBroadcastSnapshot(){
  if(COOP.status==='disconnected') return;
  var snap = { type:'snapshot', state:_coopSnapshot(), fromName:COOP.me.name };
  if(COOP.mode==='lan') _lanBroadcast(snap);
  else if(COOP.mode==='firebase') {
    // Write the state under sessions/{room} doc
    if(COOP.fbDb && COOP.fbRoom && window._FB_MODS){
      var mods = window._FB_MODS;
      var sessionDoc = mods.db.doc(COOP.fbDb, 'sessions', COOP.fbRoom);
      mods.db.setDoc(sessionDoc, { updatedAt:Date.now(), state:snap.state, updatedBy:COOP.me.name }, { merge:true });
      coopLog('☁️ Snapshot pubblicato');
    }
  }
}

function coopDisconnect(){
  try { if(COOP.peer){ COOP.peer.destroy(); COOP.peer=null; } } catch(e){}
  COOP.fbUnsub.forEach(function(u){try{u();}catch(e){}});
  COOP.fbUnsub.length=0;
  COOP.connections = {};
  COOP.peers = {};
  COOP.fbDb = null; COOP.fbApp = null; COOP.fbRoom = null;
  coopUpdateStatus('disconnected','Disconnesso','⚪');
  document.getElementById('coop-lan-host-info').style.display='none';
  document.getElementById('coop-lan-join-info').style.display='none';
  document.getElementById('coop-lan-role-pick').style.display='flex';
  document.getElementById('coop-fb-connected-info').style.display='none';
  document.getElementById('coop-fb-config-wrap').style.display = localStorage.getItem('coop_fb_config') ? 'none' : 'block';
  document.getElementById('coop-fb-room-wrap').style.display   = localStorage.getItem('coop_fb_config') ? 'block' : 'none';
  _updateCoopPeersList();
  coopLog('⏹ Disconnesso');
  showToast('Disconnesso dalla modalità coop');
}

function _updateCoopPeersList(){
  var el = document.getElementById('coop-peers-list');
  var countEl = document.getElementById('coop-peers-count');
  var peerIds = Object.keys(COOP.peers);
  if(countEl) countEl.textContent = peerIds.length ? (peerIds.length+' ingegnere'+(peerIds.length>1?'i':'')+' collegat'+(peerIds.length>1?'i':'o')) : '';
  if(el){
    if(!peerIds.length){ el.innerHTML=''; }
    else {
