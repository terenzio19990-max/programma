// CIRCUIT IMAGE LOADER — carica BMP/PNG dalla cartella CIRCUITS
// ═══════════════════════════════════════════════════════════════
const CIRCUIT_IMAGES = {};

function _normalizeCircuitKey(name) {
  return name.replace(/\.[^.]+$/, '').toLowerCase().replace(/[^a-z0-9]/g, '');
}

function loadCircuitImages() {
  document.getElementById('circuit-img-input').click();
}

function handleCircuitImages(files) {
  if(!files || !files.length) return;
  let loaded = 0;
  const total = files.length;
  Array.from(files).forEach(function(file) {
    const key = _normalizeCircuitKey(file.name);
    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = function() {
        const cv = document.createElement('canvas');
        cv.width = img.width; cv.height = img.height;
        const cx = cv.getContext('2d');
        if(!cx) return;
        cx.drawImage(img, 0, 0);
        try { CIRCUIT_IMAGES[key] = cv.toDataURL('image/png'); }
        catch(err) { CIRCUIT_IMAGES[key] = e.target.result; }
        loaded++;
        if(loaded === total) {
          try { sessionStorage.setItem('_circuitImages', JSON.stringify(CIRCUIT_IMAGES)); } catch(e2){}
          if(STATE.circuit) drawCircuit(STATE.circuit);
          const cnt = document.getElementById('circuit-img-count');
          if(cnt) cnt.textContent = Object.keys(CIRCUIT_IMAGES).length;
          alert(Object.keys(CIRCUIT_IMAGES).length + ' mappe circuito caricate!');
        }
      };
      img.onerror = function() { loaded++; };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  });
}

// Ripristina da sessionStorage
(function(){
  try {
    const stored = sessionStorage.getItem('_circuitImages');
    if(stored) {
      Object.assign(CIRCUIT_IMAGES, JSON.parse(stored));
      // Aggiorna contatore quando DOM è pronto
      setTimeout(function(){
        const cnt = document.getElementById('circuit-img-count');
        if(cnt) cnt.textContent = Object.keys(CIRCUIT_IMAGES).length;
