/* ═══ 2) AUTOSAVE OTTIMIZZATO (una sola serializzazione) + BROADCAST ═══ */
var _origAutoSave = window.autoSave;
window.autoSave = function(){
  var snap;
  try { snap = serializeSession(); } catch(e){ console.warn('[REP-Storage] serialize fail', e); return; }
