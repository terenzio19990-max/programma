// Auto-update the "PS #" input field with the next number not yet used
// by the (driver, car) combination currently selected. Call this whenever
// driver or car selector changes.
function updateStageNumAuto(){
  var input = document.getElementById('stage-num');
  if(!input) return;
  // Don't overwrite if user has manually typed a value that's not auto
  if(input.dataset.userTouched === '1') return;

  var driverId = (document.getElementById('stage-driver')||{}).value
              || (document.getElementById('ps-driver-current')||{}).value
              || '';
  var carSel = document.getElementById('stage-car-sel');
  var carId = carSel ? carSel.value : '';
  var carName = '';
  if(carId){
    var found = (STATE.rallyCars||[]).find(function(c){return c.id===carId;});
    if(found) carName = found.name;
  }
  // Find the highest PS num used for this driver+car combination, then +1
  // Filter logic:
  //   - if driverId is set, match s.driverId === driverId
  //   - if carName is set, match s.car === carName
  //   - otherwise consider all stages
  var nums = (STATE.stages||[]).filter(function(s){
    if(driverId && (s.driverId||'') !== driverId) return false;
    if(carName && (s.car||'') !== carName) return false;
    return true;
  }).map(function(s){return +s.num||0;});
  var next = nums.length ? Math.max.apply(null, nums) + 1 : 1;
  input.value = next;
}
window.updateStageNumAuto = updateStageNumAuto;

