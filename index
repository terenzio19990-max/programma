}

// ─── CALENDAR ────────────────────────────────────────────────────
function stAddRaceEvent(prefill){
  var s = _stCurrent();
  var e = prefill || {};
  var newEv = {
    id: 'evt_'+Date.now()+'_'+Math.floor(Math.random()*999),
    name: e.name || 'Round '+(s.events.length+1),
    circuit: e.circuit || '',
    location: e.location || '',
    country: e.country || 'IT',
    date: e.date || new Date().toISOString().slice(0,10),
    endDate: e.endDate || '',
    mode: e.mode || STATE.mode || 'track',
    category: e.category || '',
    sessionId: e.sessionId || null,
    results: e.results || {}, // {carId: {pos, points, qualifying, fastestLap, note}}
    status: e.status || 'scheduled' // scheduled | done | cancelled
  };
  s.events.push(newEv);
  stSave();
  stRenderCalendar();
  showToast('+ Evento aggiunto');
}
function stImportFromSavedSessions(){
  if(typeof getAllSessions !== 'function'){ showToast('⚠️ Sessioni non disponibili'); return; }
  var saved = getAllSessions();
  if(!saved.length){ showToast('⚠️ Nessuna sessione salvata'); return; }
  if(!confirm('Creare eventi dalla '+saved.length+' sessioni salvate?\n(Quelli già importati non vengono duplicati)')) return;
  var s = _stCurrent();
  var existing = new Set(s.events.map(function(e){return e.sessionId;}).filter(Boolean));
  var added = 0;
  saved.forEach(function(sess){
    if(existing.has(sess.id || sess.name)) return;
    var circuitName = '';
    try {
      var key = sess.STATE && sess.STATE.circuit;
      if(key && typeof CIRCUITS !== 'undefined' && CIRCUITS[key]) circuitName = CIRCUITS[key].name || key;
      else circuitName = key || '';
    } catch(e){}
    var dt = sess.savedAt || sess.date || new Date().toISOString();
    stAddRaceEvent({
      name: sess.name || 'Sessione salvata',
      circuit: circuitName,
      date: dt.slice(0,10),
      mode: sess.STATE?.mode || 'track',
      sessionId: sess.id || sess.name,
      status: 'done'
    });
    added++;
  });
  if(added===0) showToast('Tutti gli eventi erano già importati');
  else showToast('✓ Importati '+added+' eventi');
}
function stRemoveEvent(id){
  if(!confirm('Rimuovere questo evento dal calendario?')) return;
  var s = _stCurrent();
  s.events = s.events.filter(function(e){return e.id!==id;});
  stSave(); stRenderCalendar();
}
function stUpdateEvent(id, field, value){
  var s = _stCurrent();
  var e = s.events.find(function(x){return x.id===id;});
  if(!e) return;
  e[field] = value;
  stSave();
}
function stRenderCalendar(){
  var s = _stCurrent();
  var gridEl = document.getElementById('st-calendar-grid');
  var listEl = document.getElementById('st-calendar-list');
  if(!gridEl || !listEl) return;
  var lbl = document.getElementById('st-cal-season-label');
  if(lbl) lbl.textContent = 'Stagione '+ST.currentSeason;
  // Month grid
  var months = ['GEN','FEB','MAR','APR','MAG','GIU','LUG','AGO','SET','OTT','NOV','DIC'];
  var eventsByMonth = Array(12).fill(null).map(function(){return [];});
  s.events.forEach(function(e){
    if(!e.date) return;
    var d = new Date(e.date);
    if(isNaN(d.getTime())) return;
    if(d.getFullYear().toString() !== ST.currentSeason) return;
    eventsByMonth[d.getMonth()].push(e);
  });
  gridEl.innerHTML = months.map(function(m, mi){
    var evs = eventsByMonth[mi];
    var hasEvents = evs.length > 0;
    var content = hasEvents ? evs.map(function(e){
      var d = new Date(e.date);
      return '<div style="font-size:10px;color:var(--text2);margin-bottom:3px;"><b style="color:var(--yellow);">'+d.getDate()+'</b> '+(e.name||'—')+(e.status==='done'?' ✓':e.status==='cancelled'?' ✕':'')+'</div>';
    }).join('') : '<div style="font-size:10px;color:var(--text3);font-style:italic;">—</div>';
    return '<div class="st-month-card'+(hasEvents?' has-events':'')+'"><div class="st-month-label">'+m+'</div>'+content+'</div>';
  }).join('');
  // Full list
  if(!s.events.length){
    listEl.innerHTML = '<div style="text-align:center;color:var(--text3);padding:20px;font-size:11px;">Nessun evento. Clicca <b>+ EVENTO</b> per aggiungere.</div>';
    return;
  }
  // Sort: upcoming first, then past
  var now = new Date();
  var sorted = s.events.slice().sort(function(a,b){
    return new Date(a.date) - new Date(b.date);
  });
  var upcoming = sorted.filter(function(e){return e.status!=='done' && e.status!=='cancelled' && new Date(e.date) >= now;});
  var nextEvent = upcoming[0];
  var html = '<div style="font-family:var(--head);font-size:10px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">ELENCO COMPLETO EVENTI</div>';
  html += '<div style="display:grid;grid-template-columns:60px 70px 1fr 1fr 100px 90px 90px auto;gap:6px;font-size:9px;color:var(--text3);letter-spacing:1px;padding:0 8px 6px 8px;border-bottom:1px solid var(--border);margin-bottom:6px;">'+
    '<span>DATA</span><span>MODO</span><span>NOME</span><span>CIRCUITO</span><span>CATEGORIA</span><span>STATO</span><span>SESSIONE</span><span></span></div>';
  html += sorted.map(function(e){
    var isPast = new Date(e.date) < now;
    var isNext = e === nextEvent;
    var d = e.date ? new Date(e.date) : null;
    var dStr = d ? String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0') : '—';
    return '<div class="st-event-row'+(isPast?' past':'')+(isNext?' next':'')+'">'+
      '<input type="date" value="'+(e.date||'')+'" onchange="stUpdateEvent(\''+e.id+'\',\'date\',this.value);stRenderCalendar()" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-family:var(--mono);font-size:10px;padding:2px 4px;">'+
      '<select onchange="stUpdateEvent(\''+e.id+'\',\'mode\',this.value)" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-size:10px;padding:2px 4px;">'+
        '<option value="track"'+(e.mode==='track'?' selected':'')+'>Pista</option>'+
        '<option value="rally"'+(e.mode==='rally'?' selected':'')+'>Rally</option>'+
      '</select>'+
      '<input type="text" value="'+(e.name||'').replace(/"/g,'&quot;')+'" onchange="stUpdateEvent(\''+e.id+'\',\'name\',this.value)" placeholder="Nome evento" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-size:11px;padding:2px 5px;">'+
      '<input type="text" value="'+(e.circuit||'').replace(/"/g,'&quot;')+'" onchange="stUpdateEvent(\''+e.id+'\',\'circuit\',this.value)" placeholder="Circuito/PS" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-size:11px;padding:2px 5px;">'+
      '<input type="text" value="'+(e.category||'').replace(/"/g,'&quot;')+'" onchange="stUpdateEvent(\''+e.id+'\',\'category\',this.value)" placeholder="Categoria" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-size:11px;padding:2px 5px;">'+
      '<select onchange="stUpdateEvent(\''+e.id+'\',\'status\',this.value);stRenderCalendar()" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:'+(e.status==='done'?'var(--green)':e.status==='cancelled'?'var(--red)':'var(--text1)')+';font-size:10px;padding:2px 4px;">'+
        '<option value="scheduled"'+(e.status==='scheduled'?' selected':'')+'>🗓 In programma</option>'+
        '<option value="done"'+(e.status==='done'?' selected':'')+'>✓ Corso</option>'+
        '<option value="cancelled"'+(e.status==='cancelled'?' selected':'')+'>✕ Annullato</option>'+
      '</select>'+
      '<button class="btn btn-gray" style="padding:2px 6px;font-size:10px;" onclick="stEditResults(\''+e.id+'\')" title="Inserisci risultati">📊</button>'+
      '<button onclick="stRemoveEvent(\''+e.id+'\')" title="Rimuovi" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:13px;">✕</button>'+
    '</div>';
  }).join('');
  listEl.innerHTML = html;
}

// Simple results editor
function stEditResults(eventId){
  var s = _stCurrent();
  var e = s.events.find(function(x){return x.id===eventId;});
  if(!e) return;
  // Get driver list from season
  var drivers = s.drivers || [];
  if(!drivers.length){
    if(!confirm('Nessun pilota registrato nella stagione. Vuoi aggiungere piloti dal pannello Piloti?\n\n(Premi OK per andare al pannello Piloti, oppure Annulla per inserire i risultati a mano)')) {
      // fall through
    } else {
      stSwitchTab('drivers');
      return;
    }
  }
  var existing = e.results || {};
  var lines = drivers.map(function(d){
    var r = existing[d.id] || {};
    return d.name+'|'+(r.pos||'')+'|'+(r.points||'')+'|'+(r.fastestLap?'1':'0')+'|'+(r.pole?'1':'0');
  });
  var txt = prompt(
    'RISULTATI EVENTO: '+e.name+'\n\n'+
    'Formato per ciascuna riga:\n'+
    'nome_pilota | posizione | punti | giroveloce(0/1) | pole(0/1)\n\n'+
    'Lascia posizione vuota se il pilota non ha partecipato.\nPer punti, 0 = calcolo automatico dalla classifica.\n\n(separa righe con andate a capo)',
    lines.join('\n')
  );
  if(txt===null) return;
  var newResults = {};
  txt.split('\n').forEach(function(line){
    var parts = line.split('|').map(function(p){return p.trim();});
    if(parts.length < 2) return;
    var driver = drivers.find(function(d){return d.name===parts[0];});
    if(!driver) return;
    var pos = parts[1] ? parseInt(parts[1]) : null;
    if(pos && pos>0){
      newResults[driver.id] = {
        pos: pos,
        points: parts[2] && +parts[2] > 0 ? +parts[2] : null, // null = auto
        fastestLap: parts[3] === '1',
        pole: parts[4] === '1'
      };
    }
  });
  e.results = newResults;
  e.status = 'done';
  stSave();
  stRenderCalendar();
  showToast('✓ Risultati salvati ('+Object.keys(newResults).length+' piloti)');
}

// ─── STANDINGS ───────────────────────────────────────────────────
function _stPointsFor(pos, system, custom){
  if(!pos || pos < 1) return 0;
  var table;
  switch(system){
    case 'f1_top10': table = [25,18,15,12,10,8,6,4,2,1]; break;
    case 'f1_classic': table = [10,8,6,5,4,3,2,1]; break;
    case 'wrc': table = [25,18,15,12,10,8,6,4,2,1]; break;
    case 'nascar': table = [40,35,34,33,32,31,30,29,28,27,26,25,24,23,22,21,20,19,18,17]; break;
    case 'custom':
      table = (custom||'').split(/[,;\s]+/).map(function(v){return +v;}).filter(function(v){return v>=0;});
      break;
    default: table = [25,18,15,12,10,8,6,4,2,1];
  }
  return (pos<=table.length) ? table[pos-1] : 0;
}
function stRenderStandings(){
  var s = _stCurrent();
  // Sync controls
  var sysEl = document.getElementById('st-points-system');
  if(sysEl) sysEl.value = s.pointsSystem || 'f1_top10';
  var customEl = document.getElementById('st-points-custom');
  if(customEl) customEl.style.display = (sysEl && sysEl.value==='custom') ? '' : 'none';
  if(customEl) customEl.value = s.pointsCustom || '';
  var peEl = document.getElementById('st-points-polebonus');
  if(peEl) peEl.checked = !!s.polebonus;
  var flEl = document.getElementById('st-points-fastlap');
  if(flEl) flEl.checked = !!s.fastlap;
  // Read back for saving
  if(sysEl) s.pointsSystem = sysEl.value;
  if(customEl) s.pointsCustom = customEl.value;
  if(peEl) s.polebonus = peEl.checked;
  if(flEl) s.fastlap = flEl.checked;
  stSave();

  var drDiv = document.getElementById('st-standings-drivers');
  var tmDiv = document.getElementById('st-standings-teams');
  if(!drDiv) return;

  var drivers = s.drivers || [];
  if(!drivers.length){
    drDiv.innerHTML = '<div style="text-align:center;color:var(--text3);padding:20px;font-size:11px;">Aggiungi piloti dal pannello <b>👤 PILOTI</b> per vedere la classifica.</div>';
    if(tmDiv) tmDiv.innerHTML = '';
    return;
  }

  // Compute totals
  var standings = drivers.map(function(d){
    var total = 0, wins=0, poles=0, fastest=0, podiums=0, races=0, bestPos=null;
    var perEvent = [];
    s.events.forEach(function(e){
      if(e.status !== 'done' || !e.results || !e.results[d.id]) return;
      var r = e.results[d.id];
      races++;
      var pts = r.points != null ? r.points : _stPointsFor(r.pos, s.pointsSystem, s.pointsCustom);
      if(r.pole && s.polebonus) pts += 1;
      if(r.fastestLap && s.fastlap) pts += 1;
      total += pts;
      if(r.pos === 1) wins++;
      if(r.pole) poles++;
      if(r.fastestLap) fastest++;
      if(r.pos <= 3) podiums++;
      if(bestPos === null || r.pos < bestPos) bestPos = r.pos;
      perEvent.push({ eid:e.id, name:e.name, pos:r.pos, pts:pts });
    });
    return { driver:d, total:total, wins:wins, poles:poles, fastest:fastest, podiums:podiums, races:races, bestPos:bestPos, perEvent:perEvent };
  }).sort(function(a,b){ return b.total-a.total || b.wins-a.wins; });

  var leaderPts = standings.length ? standings[0].total : 0;
  var html = '<div style="font-family:var(--head);font-size:10px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">🏆 CLASSIFICA PILOTI — '+ST.currentSeason+'</div>';
  html += '<table style="width:100%;border-collapse:collapse;font-size:11px;"><tr style="background:var(--bg3);">'+
    '<th style="padding:5px 8px;">#</th><th style="padding:5px 8px;text-align:left;">PILOTA</th><th style="padding:5px 8px;">TEAM</th>'+
    '<th style="padding:5px 8px;">GARE</th><th style="padding:5px 8px;">V</th><th style="padding:5px 8px;">POD</th>'+
    '<th style="padding:5px 8px;">POLE</th><th style="padding:5px 8px;">GV</th><th style="padding:5px 8px;">MIGLIORE</th>'+
    '<th style="padding:5px 8px;">PUNTI</th><th style="padding:5px 8px;">GAP</th></tr>';
  standings.forEach(function(r, i){
    var isChamp = i === 0 && r.total > 0;
    var isLast = standings.length > 1 && i === standings.length-1 && r.total === 0;
    var bgStyle = isChamp ? 'background:rgba(255,204,0,0.15);' : '';
    html += '<tr style="border-bottom:1px solid var(--border);'+bgStyle+'">'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);font-weight:700;color:'+(isChamp?'var(--yellow)':'var(--text2)')+';">'+(i+1)+(isChamp?' 👑':'')+'</td>'+
      '<td style="padding:5px 8px;"><span class="an-dot" style="background:'+(r.driver.color||'#888')+';margin-right:6px;"></span>'+r.driver.name+'</td>'+
      '<td style="padding:5px 8px;color:var(--text3);">'+(r.driver.team||'—')+'</td>'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);">'+r.races+'</td>'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);color:var(--green);">'+r.wins+'</td>'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);">'+r.podiums+'</td>'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);">'+r.poles+'</td>'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);">'+r.fastest+'</td>'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);">'+(r.bestPos?('P'+r.bestPos):'—')+'</td>'+
      '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);font-size:13px;font-weight:700;color:var(--accent3);">'+r.total+'</td>'+
