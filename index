function _chronoUpdateLapsList(){
  _chronoLoad();
  var list = document.getElementById('chrono-laps');
  var count = document.getElementById('chrono-laps-count');
  if(!list) return;
  if(count) count.textContent = _chrono.laps.length;
  if(!_chrono.laps.length){
    // Empty state: show helpful message instead of hiding
    list.innerHTML = '<div style="text-align:center;padding:14px 8px;color:var(--text3);font-size:12px;font-style:italic;">'+
      'Nessun giro cronometrato. Premi <b style="color:var(--blue);">🚩 LAP</b> mentre il cronometro gira.'+
    '</div>';
    return;
  }
  // Find best lap for highlight
  var best = Math.min.apply(null, _chrono.laps.map(function(l){return l.ms;}));
  // Show in reverse (most recent on top)
  var rev = _chrono.laps.slice().reverse();
  list.innerHTML = rev.map(function(l, idx){
    var isBest = l.ms === best;
    var isMostRecent = idx === 0;
    var color = isBest ? 'var(--green)' : 'var(--text1)';
    var bg = isMostRecent ? 'rgba(43,125,233,0.12)' : (isBest ? 'rgba(44,188,110,0.10)' : 'transparent');
    return '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 8px;background:'+bg+';border-radius:3px;font-size:14px;gap:8px;'+(isMostRecent?'border-left:3px solid var(--blue);':'')+'">'+
      '<span style="color:var(--text3);min-width:50px;flex-shrink:0;font-weight:'+(isMostRecent?'700':'500')+';">G'+l.n+'</span>'+
      '<span style="font-family:var(--mono);color:'+color+';font-weight:'+(isBest||isMostRecent?'700':'500')+';flex:1;text-align:right;">'+(isBest?'🏆 ':'')+_chronoFmt(l.ms)+'</span>'+
      '<button onclick="chronoEditLap('+l.n+')" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:13px;padding:2px 4px;" title="Modifica tempo">✏️</button>'+
      '<button onclick="chronoDeleteLap('+l.n+')" style="background:none;border:none;color:var(--red);cursor:pointer;font-size:14px;padding:2px 4px;" title="Elimina">✕</button>'+
    '</div>';
  }).join('');
}

