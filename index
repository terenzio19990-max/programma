.nav-menu-item.active { color:var(--accent2); background:rgba(240,112,48,.07); border-left-color:var(--accent2); }
.nav-grp-sep { color:var(--border2); font-size:14px; display:flex; align-items:center; padding:0 4px; flex-shrink:0; }
.nav-always { display:flex; align-items:center; gap:2px; margin-left:auto; flex-shrink:0; }

/* ─── OVERFLOW MENU (topbar ⋮) ─── */
.overflow-wrap { position:relative; }
.overflow-dropdown {
