    if(prev) dEl.value = prev;
  }
  // Cars (depend on selected driver — show only cars with laps for that driver)
  if(cEl){
    var prevC = cEl.value;
    var driverId = dEl ? dEl.value : '';
    var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
    var carsWithDriver = driverId
      ? allCars.filter(function(car){
          return (STATE.laps[car.id]||[]).some(function(l){return (l.driverId||'')===driverId;});
        })
      : allCars;
    cEl.innerHTML = '<option value="">— tutte —</option>' +
      carsWithDriver.map(function(c){return '<option value="'+c.id+'">'+c.name+'</option>';}).join('');
