// RALLY PREDICTIVE CALCULATOR
// ═══════════════════════════════════════════════════════════════
function calcRallyPredict() {
  var sel = document.getElementById('rp-car-sel');
  if(sel && !sel.options.length) {
    sel.innerHTML = STATE.rallyCars.map(function(c){return '<option value="'+c.id+'">'+c.name+'</option>';}).join('');
  }
  var carId = sel ? sel.value : (STATE.rallyCars[0]||{}).id;
  var stagesLeft = +(document.getElementById('rp-stages-left')||{}).value||5;
  var avgKm = +(document.getElementById('rp-avg-km')||{}).value||15;
  var gapRecover = +(document.getElementById('rp-gap-recover')||{}).value||0;
  var avgSpeed = +(document.getElementById('rp-avg-speed')||{}).value||95;
  var el = document.getElementById('rally-predict-result'); if(!el) return;
  if(!stagesLeft||!avgKm||!avgSpeed) { el.innerHTML='<div style="color:var(--text3);">Inserisci i parametri.</div>'; return; }
  var avgTimePerStage = (avgKm / avgSpeed) * 3600; // seconds
  var totalTimeLeft = avgTimePerStage * stagesLeft;
  var targetTimePerStage = avgTimePerStage - (gapRecover / stagesLeft);
  var targetSpeed = (avgKm / (targetTimePerStage / 3600));
  var timeGainPerStage = gapRecover / stagesLeft;
  var html = '<div class="g2" style="gap:8px;margin-bottom:10px;">';
  html += '<div class="tile"><div class="tile-label">TEMPO TARGET/PS</div><div class="tile-value" style="font-size:14px;font-family:var(--mono);">'+msToTime(targetTimePerStage*1000)+'</div></div>';
  html += '<div class="tile"><div class="tile-label">VELOCITA TARGET</div><div class="tile-value">'+targetSpeed.toFixed(1)+' km/h</div></div>';
  html += '</div>';
  html += '<div style="font-size:12px;">';
  if(gapRecover > 0) html += '<div style="color:var(--green);margin-bottom:6px;">Da RECUPERARE: <b>'+gapRecover+'s</b> in '+stagesLeft+' PS (+'+timeGainPerStage.toFixed(1)+'s/PS)</div>';
  else if(gapRecover < 0) html += '<div style="color:var(--yellow);margin-bottom:6px;">Da CEDERE: <b>'+Math.abs(gapRecover)+'s</b> in '+stagesLeft+' PS ('+timeGainPerStage.toFixed(1)+'s/PS)</div>';
  else html += '<div style="color:var(--text3);margin-bottom:6px;">Ritmo attuale, nessun gap da gestire</div>';
  html += '<div style="margin-bottom:4px;">Tempo totale rimanente stimato: <b style="font-family:var(--mono);">'+msToTime(totalTimeLeft*1000)+'</b></div>';
  html += '</div>';
  el.innerHTML = html;
  var fuelEl = document.getElementById('rally-predict-fuel');
  if(fuelEl && carId) {
    var f = STATE.rallyFuel ? STATE.rallyFuel[carId] : null;
    if(f && f.perKm) {
      var totalKm = stagesLeft * avgKm;
      var fuelNeeded = totalKm * f.perKm;
      fuelEl.innerHTML = '<div style="font-size:12px;"><span>Carburante stimato: </span><b style="color:var(--accent3);">'+fuelNeeded.toFixed(1)+'L</b> per '+totalKm.toFixed(0)+'km</div>';
    } else {
      fuelEl.innerHTML = '<div style="font-size:12px;color:var(--text3);">Aggiungi dati carburante nelle PS per la previsione.</div>';
    }
  }
}

