// Populate the driver select with current season drivers
function _psPopulateDriverSelect(){
  var el = document.getElementById('ps-driver-current');
  if(!el) return;
  var prev = el.value;
  var drivers = (typeof _drvList === 'function') ? _drvList() : [];
  el.innerHTML = '<option value="">— Seleziona pilota —</option>' +
    drivers.map(function(d){ return '<option value="'+d.id+'">'+(d.name||'?')+(d.number?' #'+d.number:'')+'</option>'; }).join('');
