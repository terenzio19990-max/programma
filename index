function fetchWeatherFull(lat, lng) {
  // Current weather
  const curUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current=temperature_2m,weathercode,windspeed_10m,winddirection_10m,relativehumidity_2m,surface_pressure,visibility,dewpoint_2m&timezone=auto&forecast_days=1`;
  // Hourly forecast 24h
  const hourUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&hourly=temperature_2m,weathercode,precipitation_probability,precipitation,windspeed_10m&timezone=auto&forecast_days=2`;

  Promise.all([fetch(curUrl), fetch(hourUrl)])
    .then(([r1,r2]) => Promise.all([r1.json(), r2.json()]))
    .then(([cur, hour]) => {
      const c = cur.current;
      const code = c.weathercode;
      const cond = wmoCode(code);
      const temp = c.temperature_2m;
      const hum  = c.relativehumidity_2m;
      const wind = c.windspeed_10m;
      const wdir = c.winddirection_10m;
      const pres = c.surface_pressure;
      const vis  = c.visibility;
      const dew  = c.dewpoint_2m;

      // Sidebar widgets
      setEl('w-temp', temp+'°C');
      setEl('w-cond', cond.label.toUpperCase());
      setEl('w-icon', cond.icon);
      setEl('sw-temp', temp+'°C');
      setEl('sw-cond', cond.icon+' '+cond.label);
      setEl('sw-hum', hum+'%');
      setEl('sw-wind', wind+' km/h');

      // Meteo page current
      setEl('meteo-temp-air', temp+'°C');
      setEl('meteo-humidity', hum+'%');
      setEl('meteo-wind', wind+' km/h');
      setEl('meteo-wind-dir', windDirLabel(wdir));
      setEl('meteo-cond', cond.icon+' '+cond.label);
      setEl('meteo-pressure', pres ? Math.round(pres)+' hPa' : '—');
      setEl('meteo-visibility', vis ? (vis/1000).toFixed(1)+' km' : '—');
      setEl('meteo-dewpoint', dew !== undefined ? dew+'°C' : '—');

      // Auto-suggest surface
      if(code>=61&&code<=67) updateSurface('BAGNATO');
      if(code>=71&&code<=77) updateSurface('NEVE');
      // Weather alerts
      if(typeof runWeatherAlerts==='function') runWeatherAlerts(code, wind, temp, hum);
      // Refresh PS animation weather
      if(document.getElementById('page-rally-stages')?.classList.contains('active')) {
        if(!psAnimRunning) { initPsCanvas(); startPsAnim(); }
      }

      // Hourly forecast
      METEO_STATE.forecast = hour.hourly;
      buildForecastList(hour.hourly);
      buildMeteoChart(hour.hourly);
    })
    .catch(()=>{
      setEl('meteo-cond','⚠️ Offline'); setEl('w-cond','OFFLINE');
    });
}

function windDirLabel(deg) {
  if(deg===undefined||deg===null) return '—';
  const dirs = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSO','SO','OSO','O','ONO','NO','NNO'];
  return dirs[Math.round(deg/22.5)%16] + ' ' + Math.round(deg) + '°';
}

