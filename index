      '<td class="mono"><input type="text" class="bulk-time" data-i="'+i+'" value="'+p.time+'" style="width:90px;background:transparent;border:1px solid var(--border);color:var(--text1);font-family:var(--mono);padding:2px;"></td>'+
      '<td class="mono"><input type="text" class="bulk-s1" data-i="'+i+'" value="'+(p.s1||'')+'" style="width:70px;background:transparent;border:1px solid var(--border);color:var(--text2);font-family:var(--mono);padding:2px;"></td>'+
      '<td class="mono"><input type="text" class="bulk-s2" data-i="'+i+'" value="'+(p.s2||'')+'" style="width:70px;background:transparent;border:1px solid var(--border);color:var(--text2);font-family:var(--mono);padding:2px;"></td>'+
      '<td class="mono"><input type="text" class="bulk-s3" data-i="'+i+'" value="'+(p.s3||'')+'" style="width:70px;background:transparent;border:1px solid var(--border);color:var(--text2);font-family:var(--mono);padding:2px;"></td>'+
      '<td class="mono"><input type="text" class="bulk-pos" data-i="'+i+'" value="'+(p.pos||'')+'" style="width:40px;background:transparent;border:1px solid var(--border);color:var(--text2);font-family:var(--mono);padding:2px;"></td>'+
      '<td class="mono"><input type="number" step="0.1" class="bulk-vmax" data-i="'+i+'" value="'+(p.vmax||'')+'" placeholder="km/h" style="width:60px;background:transparent;border:1px solid var(--border);color:var(--accent3);font-family:var(--mono);padding:2px;"></td>'+
      '<td><input type="text" class="bulk-note" data-i="'+i+'" value="'+(p.note||'')+'" style="width:100%;background:transparent;border:1px solid var(--border);color:var(--text2);padding:2px;font-size:11px;"></td>'+
      '</tr>';
  }).join('');
  if(btn){btn.disabled=false;btn.style.opacity=1;}
  if(cnt) cnt.textContent = _bulkParsed.length;
}

