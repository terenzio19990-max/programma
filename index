<!-- ===== SETUP ANALYZER v6.5 ===== -->
<script>
/* SA-PHYS-BEGIN v6 ====================================================
   MOTORE FISICO v6 — fasi di curva con carichi PER RUOTA
   Upgrade dai testi:
   - Carichi ruota per ruota: statici + trasferimento laterale ripartito
     (TLLTD) + trasferimento longitudinale + aero (Guiggiani cap.3/5.10,
     Seward cap.5, Milliken RCVD)
   - Ellisse d'attrito per asse: frenata/trazione consumano laterale
     (Guiggiani cap.3; Smith cap.2 traction circle)
   - Gomma: sensibilita' al carico esponenziale mu(Fz)=mu0*(Fz/Fz0)^(b-1)
     calibrabile (Seward App.1 dati Pacejka)
   - Camber DINAMICO: il rollio (deg/g) mangia camber secondo il recupero
     della sospensione (Seward cap.4; Facchinelli)
   - Resistenza indotta dallo squilibrio: slip angle in eccesso = drag
     (Seward 5.2.2)
   - Fasi: INGRESSO (freno+laterale), PERCORRENZA (laterale puro),
     USCITA (trazione+laterale sull'asse motrice)
   API compatibile con la v5 (saAnalyze/saCompare/saClassifyU/...).
====================================================================== */

var SA_RHO = 1.225;
var SA_G   = 9.81;
var SA_STEEL_G = 79300;

function saNum(v){
  if(v===null||v===undefined) return null;
  var s = String(v).trim().toLowerCase().replace(',','.');
  if(!s) return null;
  if(s==='on'||s==='si'||s==='yes') return 1;
  if(s==='off'||s==='no') return 0;
  var m = s.match(/-?\d+(\.\d+)?/);
  return m ? parseFloat(m[0]) : null;
}
function saIsBarDiameter(v){
  if(v===null||v===undefined) return false;
  var s = String(v).toLowerCase();
  return /(mm|diam|d\s*=)/.test(s) && saNum(v)!==null && saNum(v)>=10;
}

/* ── rigidezze (invariato, gomma in serie — Seward eq.4.1) ── */
function saAxleStiffness(springNmm, barField, p, axle){
  var f = axle==='f';
  var Ks  = (springNmm!==null? springNmm : (f? p.defSpringF : p.defSpringR)) * 1000;
  var MR  = f? p.mrF : p.mrR;
  var t   = f? p.trackF : p.trackR;
  var Kt  = p.tyreRate*1000;
  var Kw  = Ks*MR*MR;
  var KR  = Kw*Kt/(Kw+Kt);
  var KphiSusp = 0.5*Kw*t*t;
  var KphiTyre = 0.5*Kt*t*t;
  var Kphi = KphiSusp*KphiTyre/(KphiSusp+KphiTyre);
  var barK = 0;
  var bn = saNum(barField);
  if(bn!==null && bn>0){
    if(saIsBarDiameter(barField)){
      var D=bn, L=(f?p.barLenF:p.barLenR), A=(f?p.barArmF:p.barArmR);
      var KarmNmm = Math.PI*SA_STEEL_G*Math.pow(D,4)/(32*L*A*A);
      var MRb = f? p.mrBarF : p.mrBarR;
      barK = 0.5*(KarmNmm*1000)*t*t*MRb*MRb*0.9;
    } else {
      barK = bn*(f? p.barStepF : p.barStepR)*(180/Math.PI);
    }
  }
  return { Kphi: Kphi+barK, Kw: Kw, KR: KR, KphiBar: barK };
}
function saLoadTransfer(KphiF, KphiR, p){
  var a  = p.L*(1-p.wf);
  var b  = p.L*p.wf;
  var zCG = p.zf + (p.zr-p.zf)*(a/p.L);
  var hs  = Math.max(0.01, p.h - zCG);
  var W   = p.m*SA_G;
  var kf  = KphiF/(KphiF+KphiR);
  var dWf = (W/p.trackF)*( hs*kf     + (b/p.L)*p.zf );
  var dWr = (W/p.trackR)*( hs*(1-kf) + (a/p.L)*p.zr );
  var rollGrad = (W*hs/(KphiF+KphiR - W*hs))*(180/Math.PI);
  return { dWf:dWf, dWr:dWr, tlltd: dWf/(dWf+dWr), hs:hs, kf:kf, rollGrad:rollGrad };
}

/* ── GOMMA v6: mu(Fz) esponenziale, riferimento = carico d'angolo nominale
   mu = mu0 * (Fz/Fz0)^(b-1)  con b ~0.8-0.9 (Seward App.1)
   b=1 => nessuna sensibilita'; piu' piccolo = gomma piu' sensibile      */
function saMuFz(Fz, mu0, p){
  var Fz0 = p.m*SA_G/4;
  var b = (p.tyreExpB && p.tyreExpB>0.5 && p.tyreExpB<1)? p.tyreExpB : (1 - (p.tyreK||0.08)*0.9);
  if(Fz<=1) return mu0*0.2;
  return mu0*Math.pow(Fz/Fz0, b-1);
}

/* ── camber DINAMICO: statico + perdita da rollio (recupero sospensione) */
function saCamberDynFactor(camStatic, camOpt, rollDeg, rec, cCam){
  if(camStatic===null) return 1;
  var camDyn = camStatic + rollDeg*(1-(rec===undefined?0.5:rec)); // il rollio toglie negativo alla ruota esterna
  var d = camDyn - camOpt;
  var f = Math.max(0.82, 1 - cCam*d*d);
  return f;
}

/* ── capacita' laterale di un ASSE con carichi per ruota + ellisse ──
   inner/outer da trasferimento; Fx (freno/trazione) consuma con
   sqrt(1-(Fx/(mu*Fz))^2); ritorna ay massimo sostenibile dall'asse    */
function saAxleAy(axleW, aeroW, dW_perG, ay_g, Fx, mu0, camF, quota, m){
  var Wd = axleW + aeroW;
  var out = Wd/2 + dW_perG*ay_g;
  var inn = Wd/2 - dW_perG*ay_g;
  if(inn<0){ out+=inn; inn=0; }   // ruota interna sollevata
  function wheelFy(Fz, FxW){
    if(Fz<=0) return 0;
    var mu = saMuFz(Fz, mu0, saAxleAy._p)*camF;
    var cap = mu*Fz;
    var used = Math.min(0.97, Math.abs(FxW)/Math.max(1,cap));
    return cap*Math.sqrt(Math.max(0, 1-used*used));
  }
  // Fx ripartita ~ col carico (ABS/diff distribuiscono circa cosi')
  var FxOut = Fx * (out/Math.max(1,out+inn));
  var FxInn = Fx - FxOut;
  var Fy = wheelFy(out, FxOut) + wheelFy(inn, FxInn);
  return Fy/(m*quota);   // ay che l'asse puo' sostenere per l'equilibrio d'imbardata
}

/* ── bilancio a una condizione (v, ax richiesto) — punto fisso su ay ── */
function saBalanceCond(v, axFrac, phase, setup, p, mech){
  // axFrac: frazione della capacita' long. usata (freno<0 / trazione>0)
  var Wf = p.m*SA_G*p.wf, Wr = p.m*SA_G*(1-p.wf);
  var q = 0.5*SA_RHO*v*v;
  var aeroF = q*mech.ClAf, aeroR = q*mech.ClAr;
  saAxleAy._p = p;
  var ay = mech.mu0*SA_G, ayF=0, ayR=0;
  for(var i=0;i<7;i++){
    var g_ay = ay/SA_G;
    var roll = mech.rollGrad*g_ay;
    var camFf = saCamberDynFactor(mech.camF, mech.camOptF, roll, p.camberRecF, p.cCam)*(mech.gripFfX||1);
    var camFr = saCamberDynFactor(mech.camR, mech.camOptR, roll, p.camberRecR, p.cCam)*(mech.gripFrX||1);
    // longitudinale: trasferimento e forze per fase
    var ax=0, FxF=0, FxR=0;
    if(phase==='entry'){
      var aMax = mech.muB*SA_G;
      ax = -Math.abs(axFrac)*aMax;
      var Ftot = p.m*Math.abs(ax);
      FxF = -Ftot*(mech.biasSplit!==null? mech.biasSplit : (p.wf + mech.muB*p.h/p.L));
      FxR = -(Ftot - Math.abs(FxF));   // resto al posteriore
    } else if(phase==='exit'){
      var aTr = mech.axTraction;
      ax = Math.abs(axFrac)*aTr;
      var FtotT = p.m*ax;
      if(p.drive==='FWD'){ FxF=FtotT; FxR=0; }
      else if(p.drive==='RWD'){ FxR=FtotT; FxF=0; }
      else { FxF=FtotT*0.45; FxR=FtotT*0.55; }
    }
    var dWx = p.m*ax*p.h/p.L;   // >0 in trazione: carica il posteriore
    var WfD = Math.max(200, Wf - dWx), WrD = Math.max(200, Wr + dWx);
    ayF = saAxleAy(WfD, aeroF, mech.dWf, g_ay, FxF, mech.mu0, camFf, p.wf, p.m);
    ayR = saAxleAy(WrD, aeroR, mech.dWr, g_ay, FxR, mech.mu0, camFr, 1-p.wf, p.m);
    ay = Math.min(ayF, ayR);
  }
  var Uc = 2*(ayF-ayR)/(Math.max(0.01,ayF+ayR));
  return { ay:ay, ayF:ayF, ayR:ayR, U: Math.max(-0.6, Math.min(0.6, Uc)) };
}

function saAeroLoads(setup, p, v){
  var nF = setup.wingF!==null? setup.wingF : 0;
  var nR = setup.wingR!==null? setup.wingR : 0;
  var sp = setup.splitter!==null? setup.splitter : 0;
  var ClAf = Math.max(0, p.clA0f + nF*p.clAperClickF + sp*p.clAsplit);
  var ClAr = Math.max(0, p.clA0r + nR*p.clAperClickR);
  var CdA  = Math.max(0.3, p.cdA0 + nF*p.cdAperClickF + nR*p.cdAperClickR + sp*p.cdAsplit);
  var q = 0.5*SA_RHO*v*v;
  return { ClAf:ClAf, ClAr:ClAr, CdA:CdA, Ff:q*ClAf, Fr:q*ClAr };
}
function saVmax(CdA, p){
  var Pw = p.powerKW*1000*p.driveEff;
  var v = 50;
  for(var i=0;i<40;i++){
    var fv  = 0.5*SA_RHO*CdA*v*v*v + p.crr*p.m*SA_G*v - Pw;
    var fp  = 1.5*SA_RHO*CdA*v*v   + p.crr*p.m*SA_G;
    var v2 = v - fv/fp;
    if(Math.abs(v2-v)<0.001){ v=v2; break; }
    v = v2;
  }
  return v;
}
function saGearing(p){
  var R = p.gearRatios;
  if(!R || !R.length || !(p.finalDrive>0) || !(p.rpmMax>0) || !(p.wheelCirc>0)) return null;
  var per = R.map(function(r){ return (p.rpmMax/60)/(r*p.finalDrive)*p.wheelCirc; });
  return { per: per, vTop: per[per.length-1], n: R.length };
}
function saMaxTraction(mu, p){
  var q = mu*p.h/p.L;
  if(p.drive==='RWD') return Math.min(mu*SA_G, mu*SA_G*(1-p.wf)/Math.max(0.2,(1-q)));
  if(p.drive==='AWD') return mu*SA_G;
  return mu*SA_G*p.wf/(1+q);
}
function saDiffLock(preNm, rampDeg, rampDefault){
  var pre = (preNm===null||preNm===undefined||!isFinite(preNm))? 0 : Math.max(0,preNm);
  var r = (rampDeg===null||rampDeg===undefined||!(rampDeg>15&&rampDeg<90))? rampDefault : rampDeg;
  return Math.max(0, Math.min(2, pre/80 + (80-r)/50));
}
function saBrakeSplit(biasPct, biasRefPct, muB, p){
  var ideal = p.wf + muB*p.h/p.L;
  if(biasPct===null || biasRefPct===null) return { split: ideal, ideal: ideal };
  return { split: ideal + p.biasGain*(biasPct-biasRefPct)/100, ideal: ideal };
}
function saBrakeDecel(split, muB, p){
  var hf = muB*p.h/p.L;
  var aF = split>hf ? muB*SA_G*p.wf/(split-hf) : Infinity;
  var aR = muB*SA_G*(1-p.wf)/((1-split)+hf);
  return { a: Math.min(aF,aR), rearLimited: aR<aF };
}
function saZeta(clicks, KR, p, axle){
  if(clicks===null) return null;
  var mc = p.m*p.sprungFrac*(axle==='f'?p.wf:(1-p.wf))/2;
  var dir = (p.dampClickDir===1)? 1 : -1;
  var c = dir>0? (p.damp0 + clicks*p.dampPerClick)
               : Math.max(300, p.damp0 - clicks*p.dampPerClick);
  return c/(2*Math.sqrt(KR*mc));
}
function saRideFreq(KR, p, axle){
  var mc = p.m*p.sprungFrac*(axle==='f'?p.wf:(1-p.wf))/2;
  return Math.sqrt(KR/mc)/(2*Math.PI);
}
function saTransientBalance(cur, base){
  function d(a,b){ return (a!==null&&b!==null)? a-b : 0; }
  var entry = 0.5*d(cur.zBF,base.zBF) + 0.3*d(cur.zRR,base.zRR) - 0.3*d(cur.zRF,base.zRF);
  var exit  = 0.5*d(cur.zBR,base.zBR) - 0.2*d(cur.zRF,base.zRF);
  return { entry: entry, exit: exit };
}

/* ── ANALISI v6 ── */
function saAnalyze(setup, p, surf){
  var stF = saAxleStiffness(setup.springF, setup.barFraw, p, 'f');
  var stR = saAxleStiffness(setup.springR, setup.barRraw, p, 'r');
  var lt  = saLoadTransfer(stF.Kphi, stR.Kphi, p);

  var aeroRef = saAeroLoads(setup, p, (surf.vHigh||150)/3.6);
  var mech = {
    mu0: surf.mu0, muB: surf.muB,
    dWf: lt.dWf, dWr: lt.dWr, rollGrad: lt.rollGrad,
    camF: setup.camberF, camR: setup.camberR,
    camOptF: surf.camOptF, camOptR: surf.camOptR,
    ClAf: aeroRef.ClAf, ClAr: aeroRef.ClAr,
    biasSplit: null, axTraction: saMaxTraction(surf.mu0, p),
    gripFfX: 1, gripFrX: 1
  };
  // bias -> split effettivo per la fase d'ingresso
  var bias = setup.brakeBias!==null? (setup.brakeBias>1? setup.brakeBias : setup.brakeBias*100) : null;
  if(bias!==null){
    var refB = (p.biasRefForPhase!==undefined && p.biasRefForPhase!==null)? p.biasRefForPhase : 60;
    mech.biasSplit = saBrakeSplit(bias, refB, surf.muB, p).split;
  }

  var kmh = function(k){ return k/3.6; };
  // sweep in velocita' (per zone tempo, curve, aero) — laterale puro
  var bLow  = saBalanceCond(kmh(surf.vLow),  0, 'mid', setup, p, mech);
  var bMid  = saBalanceCond(kmh(surf.vMid),  0, 'mid', setup, p, mech);
  var bHigh = saBalanceCond(kmh(surf.vHigh), 0, 'mid', setup, p, mech);
  // FASI (alla velocita' media): ingresso col freno, uscita col gas
  var phEntry = saBalanceCond(kmh(surf.vMid), (p.entryBrake||0.45), 'entry', setup, p, mech);
  var phMid   = bMid;
  var phExit  = saBalanceCond(kmh(surf.vLow), (p.exitThrottle||0.40), 'exit', setup, p, mech);

  // correzioni toe / diff (bassa velocita' e fasi)
  var toeAdj = 0;
  if(setup.toeF!==null) toeAdj += -setup.toeF*p.toeSensF;
  if(setup.toeR!==null) toeAdj += -Math.min(0,setup.toeR)*p.toeSensR;
  bLow.U += toeAdj; phEntry.U += toeAdj*0.7; phExit.U += toeAdj*0.4;

  var hasLsdF = setup.diffPreF!==null || setup.diffRampAccF!==null || setup.diffRampDecF!==null;
  var hasLsdR = setup.diffPreR!==null || setup.diffRampAccR!==null || setup.diffRampDecR!==null;
  var lockAcc=0, lockCoast=0;
  if(p.drive!=='RWD'){
    if(hasLsdF){
      lockAcc  = saDiffLock(setup.diffPreF, setup.diffRampAccF, 60);
      lockCoast= saDiffLock(setup.diffPreF, setup.diffRampDecF, 70);
      phExit.U  += -lockAcc*p.diffSens*6;      // FWD: blocco sul gas spinge in USCITA
      phEntry.U += -lockCoast*(p.diffCoastSens||0.006)*2;
      bLow.U    += -lockAcc*p.diffSens*2 - lockCoast*(p.diffCoastSens||0.006);
    } else if(setup.diffF!==null){ bLow.U += -setup.diffF*p.diffSens; phExit.U += -setup.diffF*p.diffSens*1.5; }
  }
  if(p.drive!=='FWD'){
    if(hasLsdR){
      var laR = saDiffLock(setup.diffPreR, setup.diffRampAccR, 60);
      var lcR = saDiffLock(setup.diffPreR, setup.diffRampDecR, 70);
      phExit.U  += +laR*p.diffSens*6;          // RWD: sovrasterzo di potenza in USCITA
      phEntry.U += -lcR*(p.diffCoastSens||0.006)*2;
      bLow.U    += +laR*p.diffSens*2 - lcR*(p.diffCoastSens||0.006);
      if(p.drive==='RWD'){ lockAcc=laR; lockCoast=lcR; } else { lockAcc=(lockAcc+laR)/2; lockCoast=(lockCoast+lcR)/2; }
    } else if(setup.diffR!==null){ bLow.U += +setup.diffR*p.diffSens; phExit.U += +setup.diffR*p.diffSens*1.5; }
  }
  var lockC=0;
  if(p.drive==='AWD'){
    var hasLsdC = setup.diffPreC!==null || setup.diffRampAccC!==null || setup.diffRampDecC!==null;
    if(hasLsdC){
      lockC = saDiffLock(setup.diffPreC, setup.diffRampAccC, 45);
      phExit.U += -lockC*p.diffSens*3;
      bLow.U   += -lockC*p.diffSens*1.2;
      hasLsdF = hasLsdF || hasLsdC;
    }
  }

  var vmaxPower = saVmax(aeroRef.CdA, p);
  var gear = saGearing(p);
  var vmax = vmaxPower, limiter = 'potenza';
  if(gear && gear.vTop < vmaxPower){ vmax = gear.vTop; limiter = 'rapporti'; }

  var zBF = saZeta(setup.bumpF, stF.KR, p, 'f');
  var zBR = saZeta(setup.bumpR, stR.KR, p, 'r');
  var zRF = saZeta(setup.rebF,  stF.KR, p, 'f');
  var zRR = saZeta(setup.rebR,  stR.KR, p, 'r');
  var zs = [zBF,zBR,zRF,zRR].filter(function(z){return z!==null;});

  // camber dinamico alla percorrenza (per avvisi)
  var rollMid = lt.rollGrad*(bMid.ay/SA_G);
  var camDynF = setup.camberF!==null? setup.camberF + rollMid*(1-(p.camberRecF===undefined?0.5:p.camberRecF)) : null;
  var camDynR = setup.camberR!==null? setup.camberR + rollMid*(1-(p.camberRecR===undefined?0.6:p.camberRecR)) : null;

  return {
    KphiF: stF.Kphi, KphiR: stR.Kphi, KwF: stF.Kw, KwR: stR.Kw,
    KRf: stF.KR, KRr: stR.KR,
    tlltd: lt.tlltd, rollGrad: lt.rollGrad,
    bLow:bLow, bMid:bMid, bHigh:bHigh,
    phases: { entry: phEntry, mid: phMid, exit: phExit },
    camDynF: camDynF, camDynR: camDynR,
    ClAf: aeroRef.ClAf, ClAr: aeroRef.ClAr, CdA: aeroRef.CdA,
    aeroBalF: (aeroRef.ClAf+aeroRef.ClAr)>0.001? aeroRef.ClAf/(aeroRef.ClAf+aeroRef.ClAr) : null,
    vmax: vmax, vmaxPower: vmaxPower, gear: gear, limiter: limiter,
    axMax: mech.axTraction,
    biasPct: bias,
    zBF:zBF, zBR:zBR, zRF:zRF, zRR:zRR,
    zetaAvg: zs.length? zs.reduce(function(a,b){return a+b;},0)/zs.length : null,
