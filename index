function buildSidebar() {
  const container = document.getElementById('sidebar-widgets');
  if(!container) return;
  container.innerHTML = '';
  WIDGETS.filter(w=>w.visible).forEach(w=>{
    const panel = document.createElement('div');
    panel.className = 'panel';
    panel.id = 'sb-widget-'+w.id;
    panel.draggable = true;
    panel.addEventListener('dragstart', e=>{ e.dataTransfer.setData('text/plain', w.id); panel.style.opacity='0.5'; });
    panel.addEventListener('dragend', e=>{ panel.style.opacity='1'; });
    panel.addEventListener('dragover', e=>{ e.preventDefault(); panel.style.borderColor='var(--accent2)'; });
    panel.addEventListener('dragleave', ()=>{ panel.style.borderColor=''; });
    panel.addEventListener('drop', e=>{ e.preventDefault(); panel.style.borderColor=''; reorderWidget(e.dataTransfer.getData('text/plain'), w.id); });
    const renderFn = w.custom
      ? ()=>renderWidgetCustom(w)
      : WIDGETS_DEFAULT.find(d=>d.id===w.id)?.render;
    panel.innerHTML = `
      <div class="panel-head" style="cursor:grab;user-select:none;">
        <span>⠿ ${w.title}</span>
        ${w.removable ? `<button onclick="toggleWidget('${w.id}',false)" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;padding:0 2px;" title="Rimuovi">✕</button>` : ''}
      </div>
      <div class="panel-body">${renderFn ? renderFn() : ''}</div>`;
    container.appendChild(panel);
  });
  // Re-bind flag status label after re-render
  const fsl = document.getElementById('flag-status-label');
  if(fsl) fsl.style.color = STATE?.flag==='green'?'var(--green)':STATE?.flag==='yellow'?'var(--yellow)':'var(--red)';
}

function toggleWidget(id, visible) {
  const w = WIDGETS.find(x=>x.id===id);
  if(w) w.visible = visible;
  buildSidebar();
  renderWidgetToggleList();
}

function reorderWidget(fromId, toId) {
  const fromIdx = WIDGETS.findIndex(w=>w.id===fromId);
  const toIdx   = WIDGETS.findIndex(w=>w.id===toId);
  if(fromIdx<0||toIdx<0||fromIdx===toIdx) return;
  const [item] = WIDGETS.splice(fromIdx,1);
  WIDGETS.splice(toIdx,0,item);
  buildSidebar();
}

