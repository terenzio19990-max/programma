function anRenderPredict(){
  // Perf guard: skip rebuild if container is hidden
  var _g = document.getElementById('an-predict-result');
  if(_g && !_g.offsetParent && !window.__FORCE_REBUILD) return;

  var el = document.getElementById('an-predict-result');
  if(!el) return;
  var totalLaps = +document.getElementById('an-predict-total-laps')?.value || 25;
  var totalMin = +document.getElementById('an-predict-total-min')?.value || 0;
  var driverFilter = _selectedDriverFilter('an-driver-filter');
  var cars = _anAllCars().filter(function(c){return _lapsForCar(c.id, driverFilter).length>=3;});
  if(!cars.length){
    el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text3);">🔮 Servono almeno 3 giri per vettura per fare previsioni</div>';
    return;
  }
  // For each car, project finish time
  var rows = cars.map(function(car){
    var laps = _lapsForCar(car.id, driverFilter);
    var lapsDone = laps.length;
    var vals = laps.map(function(l){var t=parseTime(l.time);return t?t/1000:null;}).filter(function(v){return v!=null;});
    if(!vals.length) return null;
    var bestMs = Math.min.apply(null, vals);
    var avg = vals.reduce(function(a,b){return a+b;},0)/vals.length;
    var sd = Math.sqrt(vals.reduce(function(s,v){return s+Math.pow(v-avg,2);},0)/vals.length);
    // Recent pace: last 25% giri
    var recentN = Math.max(3, Math.floor(vals.length*0.25));
    var recent = vals.slice(-recentN);
    var recentAvg = recent.reduce(function(a,b){return a+b;},0)/recent.length;
    // Trend (s per lap)
    var n = vals.length;
    var sx=0,sy=0,sxy=0,sxx=0;
    for(var i=0;i<n;i++){ sx+=i; sy+=vals[i]; sxy+=i*vals[i]; sxx+=i*i; }
    var slope = n>=3 ? (n*sxy-sx*sy)/(n*sxx-sx*sx||1) : 0;
    // Project remaining laps
    var remainingLaps, projectedFinishTime, strategy;
    if(totalMin>0){
      // Time-based race
      var totalSec = totalMin*60;
      var spentSec = vals.reduce(function(a,b){return a+b;},0);
      var remainSec = totalSec - spentSec;
      remainingLaps = remainSec>0 ? Math.floor(remainSec/recentAvg) : 0;
      projectedFinishTime = totalSec;
      strategy = 'Gara a tempo: '+totalMin+' min';
    } else {
      // Lap-based race
      remainingLaps = Math.max(0, totalLaps - lapsDone);
      // Sum of projected remaining lap times (using recent avg + small trend extrapolation)
      var remSec = 0;
      for(var k=0;k<remainingLaps;k++){
        remSec += recentAvg + slope*k*0.3; // dampen slope extrapolation
      }
      var spentSec2 = vals.reduce(function(a,b){return a+b;},0);
      projectedFinishTime = spentSec2 + remSec;
      strategy = 'Gara a giri: '+totalLaps;
    }
    return {
      car:car, lapsDone:lapsDone, remainingLaps:remainingLaps,
      bestMs:bestMs, avg:avg, recentAvg:recentAvg, sd:sd, slope:slope,
      projectedFinishTime:projectedFinishTime
    };
  }).filter(function(r){return r;});
  rows.sort(function(a,b){return a.projectedFinishTime-b.projectedFinishTime;});
  var leader = rows[0];
  el.innerHTML = '<div style="background:var(--bg3);border-left:3px solid var(--accent3);padding:10px 14px;border-radius:4px;margin-bottom:10px;font-size:11px;color:var(--text2);">'+
    '🔮 <b>Proiezione finale</b> — basata su media degli ultimi '+Math.max(3, Math.floor(((leader&&leader.lapsDone)||3)*0.25))+' giri + trend linear. Non include safety car, bandiere gialle, soste imprevisto, incidenti.</div>'+
    '<table style="width:100%;border-collapse:collapse;font-size:11px;">'+
    '<tr style="background:var(--bg3);"><th style="padding:6px 8px;text-align:left;">Pos</th><th>Vettura</th><th>Giri fatti</th><th>Rimanenti</th><th>Best attuale</th><th>Pace recente</th><th>Trend</th><th>Tempo finale</th><th>Gap</th></tr>'+
    rows.map(function(r,i){
      var gap = (r.projectedFinishTime-leader.projectedFinishTime);
      var slopeTxt = (r.slope>=0?'+':'')+r.slope.toFixed(3)+'s/giro';
      var slopeColor = r.slope<-0.05 ? 'var(--green)' : r.slope>0.1 ? 'var(--red)' : 'var(--text2)';
      return '<tr style="border-bottom:1px solid var(--border);'+(i===0?'background:rgba(44,188,110,0.08);':'')+'">'+
        '<td style="padding:4px 8px;font-weight:700;">'+(i+1)+(i===0?' 🏆':'')+'</td>'+
        '<td><span class="an-dot" style="background:'+(r.car.color||'#888')+';"></span> '+r.car.name+'</td>'+
        '<td class="mono" style="text-align:center;">'+r.lapsDone+'</td>'+
        '<td class="mono" style="text-align:center;">'+r.remainingLaps+'</td>'+
        '<td class="mono" style="text-align:center;color:var(--green);">'+r.bestMs.toFixed(3)+'s</td>'+
        '<td class="mono" style="text-align:center;">'+r.recentAvg.toFixed(3)+'s</td>'+
        '<td class="mono" style="text-align:center;color:'+slopeColor+';">'+slopeTxt+'</td>'+
        '<td class="mono" style="text-align:center;font-weight:700;">'+_fmtTimeLong(r.projectedFinishTime)+'</td>'+
        '<td class="mono" style="text-align:center;color:var(--accent3);">'+(i===0?'LEADER':'+'+gap.toFixed(2)+'s')+'</td>'+
        '</tr>';
    }).join('')+
    '</table>'+
    '<div style="margin-top:10px;padding:10px 14px;background:var(--bg3);border-radius:4px;font-size:11px;color:var(--text3);line-height:1.6;">'+
    '💡 <b>Suggerimenti strategici:</b><br>'+
    rows.slice(0,3).map(function(r){
      var tips = [];
      if(r.slope > 0.1) tips.push('gomme in calo — considera pit per nuovo treno');
      if(r.sd > 0.8)    tips.push('molto incostante — chiedi al pilota di stabilizzare il ritmo');
      if(r.slope < -0.1) tips.push('in ottima forma — pressing sul pilota davanti');
      if(!tips.length) tips.push('ritmo stabile, mantieni');
      return '<b>'+r.car.name+':</b> '+tips.join(' · ');
    }).join('<br>')+
    '</div>';
}
function _fmtTimeLong(sec){
  var h = Math.floor(sec/3600);
  var m = Math.floor((sec%3600)/60);
  var s = sec%60;
  if(h>0) return h+'h '+String(m).padStart(2,'0')+'m '+s.toFixed(1)+'s';
  return m+'m '+s.toFixed(1)+'s';
}

