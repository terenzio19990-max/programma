function saSurfKey(mode){
  var ov = gv('sa-surf-'+mode);
  if(ov && ov!=='auto') return ov;
  if(mode==='rally'){
    var s = (gv('r-setup-surface')||'Asfalto').toLowerCase();
    if(s.indexOf('sterr')>=0) return 'rally_gravel';
    if(s.indexOf('neve')>=0) return 'rally_snow';
    if(s.indexOf('ghiac')>=0) return 'rally_ice';
    if(s.indexOf('mist')>=0) return 'rally_mixed';
    return 'rally_tarmac';
  }
  var st = (STATE.surface||'ASCIUTTO').toUpperCase();
  if(st.indexOf('BAGN')>=0) return 'track_wet';
  if(st.indexOf('UMID')>=0) return 'track_damp';
  return 'track_dry';
}
function saProfKey(mode, surfKey){
  if(mode==='track') return 'track';
  return surfKey==='rally_tarmac' ? 'rally_tarmac' : 'rally_loose';
}
function saRefTime(mode, car){
  var best = null;
  try {
    if(mode==='track'){
      (STATE.laps[car.id]||[]).forEach(function(l){
        var t = parseTime(l.time);
        if(t && (best===null||t<best)) best=t;
      });
    } else {
      (STATE.stages||[]).forEach(function(s){
        if(s.car===car.name && !s.cancelled){
          var t = parseTime(s.time);
          if(t && (best===null||t<best)) best=t;
        }
      });
    }
  } catch(e){}
  return best;
}

