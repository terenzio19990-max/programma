    lockAcc: lockAcc, lockCoast: lockCoast, lockC: lockC,
    _hasLsd: (hasLsdF||hasLsdR)
  };
}

/* ── CONFRONTO v6 ── */
function saCompare(cur, base, p, surf, prof){
  var T = prof.lapSec;
  var zones = [];
  function pct(a,b){ return (b&&isFinite(a)&&isFinite(b))? (a-b)/b : 0; }

  var dvmax = pct(cur.vmax, base.vmax);
  var strNote = 'Vmax '+(base.vmax*3.6).toFixed(1)+' → '+(cur.vmax*3.6).toFixed(1)+' km/h ('+(dvmax>=0?'+':'')+(dvmax*100).toFixed(2)+'%)';
  if(cur.limiter==='rapporti') strNote += ' — limitata dai RAPPORTI'+(cur.gear? ' ('+cur.gear.n+' marce)':'')+', non dall’aero';
  // resistenza indotta dallo squilibrio (Seward 5.2.2): |U| in eccesso = slip angle = drag
  var kInd = p.kInduced===undefined? 0.25 : p.kInduced;
  var indCur = Math.max(0, Math.abs(cur.bMid.U)-0.02), indBase = Math.max(0, Math.abs(base.bMid.U)-0.02);
  var dtInd = T*(prof.fFast+prof.fMid)*kInd*(indCur-indBase);
  zones.push({ id:'straight', label:'Rettilinei', conf:'alta',
    dt: -T*prof.fStraight*0.6*dvmax + dtInd*0.3,
    note: strNote + (Math.abs(dtInd)>0.01? ' · resistenza indotta dallo squilibrio '+(dtInd>0?'+':'')+dtInd.toFixed(3)+'s':'') });

  var dFast = pct(cur.bHigh.ay, base.bHigh.ay);
  zones.push({ id:'fast', label:'Curve veloci', conf:'alta',
    dt: -T*prof.fFast*0.5*dFast + dtInd*0.35,
    note:'ay '+(base.bHigh.ay/SA_G).toFixed(2)+'g → '+(cur.bHigh.ay/SA_G).toFixed(2)+'g' });

  var dMid = pct(cur.bMid.ay, base.bMid.ay);
  zones.push({ id:'mid', label:'Percorrenza (curve medie)', conf:'alta',
    dt: -T*prof.fMid*0.5*dMid + dtInd*0.35,
    note:'ay '+(base.bMid.ay/SA_G).toFixed(2)+'g → '+(cur.bMid.ay/SA_G).toFixed(2)+'g' });

  var dSlow = pct(cur.bLow.ay, base.bLow.ay);
  zones.push({ id:'slow', label:'Curve strette', conf:'alta',
    dt: -T*prof.fSlow*0.5*dSlow,
    note:'ay '+(base.bLow.ay/SA_G).toFixed(2)+'g → '+(cur.bLow.ay/SA_G).toFixed(2)+'g' });

  // trazione: capacita' in USCITA dalla fase (gia' con ellisse) + TLLTD + diff
  var ds = p.drive==='RWD'? -1 : (p.drive==='AWD'? 0.3 : 1);
  var dTr = -ds*p.tractionSens*(cur.tlltd - base.tlltd);
  var dExitAy = pct(cur.phases.exit.ay, base.phases.exit.ay);
  dTr += dExitAy*0.8;
  if(cur._hasLsd || base._hasLsd){
    dTr += 0.06*((cur.lockAcc||0)-(base.lockAcc||0));
    dTr += 0.03*((cur.lockC||0)-(base.lockC||0));
  } else {
    var dCur = p.drive==='RWD'? cur._diffR : cur._diffF;
    var dBase = p.drive==='RWD'? base._diffR : base._diffF;
    if(dCur!==null && dBase!==null) dTr += p.diffTractionSens*(dCur-dBase);
  }
  var axleName = p.drive==='RWD'?'posteriore':(p.drive==='AWD'?'integrale':'anteriore');
  zones.push({ id:'traction', label:'Trazione (uscita curva)', conf:'media',
    dt: -T*0.5*prof.fSlow*0.8*dTr,
    note:'asse motrice '+axleName+' · ay uscita '+(base.phases.exit.ay/SA_G).toFixed(2)+'g → '+(cur.phases.exit.ay/SA_G).toFixed(2)+'g' });

  var dtBrk = 0, brkNote = 'bias non inserito', brkWarn = null;
  if(cur.biasPct!==null && base.biasPct!==null){
    var refP = (prof.biasRefPct!==null&&prof.biasRefPct!==undefined)? prof.biasRefPct : base.biasPct;
    var sB = saBrakeSplit(base.biasPct, refP, surf.muB, p);
    var sC = saBrakeSplit(cur.biasPct,  refP, surf.muB, p);
    var dB = saBrakeDecel(sB.split, surf.muB, p);
    var dC = saBrakeDecel(sC.split, surf.muB, p);
    dtBrk = T*prof.fBrake*(dB.a/dC.a - 1);
    brkNote = 'decel. '+(dB.a/SA_G).toFixed(2)+'g → '+(dC.a/SA_G).toFixed(2)+'g';
    if(dC.rearLimited) brkWarn = 'Posteriore al limite in frenata: rischio bloccaggio/instabilità in staccata (Smith cap.10)';
  }
  zones.push({ id:'brake', label:'Frenata', conf:'media', dt:dtBrk, note:brkNote, warn:brkWarn });

  var bumpyFrac = 0.04*prof.bumpy;
  function bumpPen(st){
    var pen = 0;
    if(st.zetaAvg!==null) pen += p.kDamp*Math.pow(st.zetaAvg - surf.zetaOpt, 2);
    var fAvg=(st.rideFreqF+st.rideFreqR)/2;
    if(fAvg>surf.rideOptHi) pen += p.kRide*Math.pow(fAvg-surf.rideOptHi,2);
    if(fAvg<surf.rideOptLo) pen += p.kRide*Math.pow(surf.rideOptLo-fAvg,2);
    if(st.fastBumpF!==null) pen += p.kFastBump*Math.max(0,st.fastBumpF-surf.fastBumpRef)/10;
    return pen;
  }
  var dtBump = T*bumpyFrac*0.5*(bumpPen(cur)-bumpPen(base));
  var bumpNotes=[];
  if(cur.zetaAvg!==null) bumpNotes.push('ζ '+(base.zetaAvg!==null?base.zetaAvg.toFixed(2):'—')+' → '+cur.zetaAvg.toFixed(2)+' (ottimo ~ '+surf.zetaOpt+', Seward Es.4.4)');
  bumpNotes.push('ride freq '+((cur.rideFreqF+cur.rideFreqR)/2).toFixed(2)+' Hz (finestra '+surf.rideOptLo+'-'+surf.rideOptHi+')');
  zones.push({ id:'bumpy', label:'Sconnesso / cordoli', conf:'bassa', dt:dtBump, note:bumpNotes.join(' · ') });

  var total = zones.reduce(function(a,z){return a+z.dt;},0);
  var absSum = zones.reduce(function(a,z){return a+Math.abs(z.dt);},0);

  return { zones:zones, total:total,
    uncertainty: Math.max(0.05, 0.35*absSum),
    dVmaxPct: dvmax*100,
    dU: { low: cur.bLow.U-base.bLow.U, mid: cur.bMid.U-base.bMid.U, high: cur.bHigh.U-base.bHigh.U },
    dPhases: { entry: cur.phases.entry.U-base.phases.entry.U,
               mid: cur.phases.mid.U-base.phases.mid.U,
               exit: cur.phases.exit.U-base.phases.exit.U },
    transient: saTransientBalance(cur, base) };
}

function saClassifyU(U){
  if(U>0.02)  return { txt:'SOVRASTERZANTE', cls:'ovr', sev: Math.min(1,U/0.12) };
  if(U<-0.02) return { txt:'SOTTOSTERZANTE', cls:'und', sev: Math.min(1,-U/0.12) };
  return { txt:'NEUTRALE', cls:'neu', sev:0 };
}
/* SA-PHYS-END-MARKER v6 */

</script>
