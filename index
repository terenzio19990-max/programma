// FULL BACKUP — dump everything (sessions list + state + prefs)
// ═══════════════════════════════════════════════════════════════
function exportFullBackup(){
  var now = new Date();
  var pkg = {
    _REP_FULL_BACKUP: 2,
    appVersion: 'v17',
    exportedAt: now.toISOString(),
    exportedFor: 'Race Engineer Pro',
    // Current in-memory session
    currentSession: serializeSession(),
    // All saved sessions
    savedSessions: getAllSessions(),
    // Weekend schedule
    weekendSchedule: (function(){ try { return JSON.parse(localStorage.getItem(_SCHEDULE_KEY||'rep_weekend_schedule_v1')||'[]'); } catch(e){ return []; } })(),
    // Preferences and config
    preferences: {
      theme: (typeof _currentTheme!=='undefined') ? _currentTheme : (document.documentElement.getAttribute('data-theme')||'dark'),
      coopIdentity: (function(){ try { return JSON.parse(localStorage.getItem('coop_identity')||'null'); } catch(e){ return null; } })(),
      coopFbConfig: localStorage.getItem('coop_fb_config')||null,
      sidebarWidgets: (function(){ try { return JSON.parse(localStorage.getItem('rep_sidebar_widgets')||'null'); } catch(e){ return null; } })(),
      gdriveClientId: localStorage.getItem('gdrive_client_id')||null,
      alertThresholds: {
        fuelPct: document.getElementById('alert-fuel-pct')?.value,
        wearPct: document.getElementById('alert-wear-pct')?.value,
        sessionMin: document.getElementById('alert-session-min')?.value,
      }
    },
    // Full localStorage dump of REP-related keys
    localStorageDump: (function(){
      var out = {};
      try {
        for(var i=0;i<localStorage.length;i++){
          var k = localStorage.key(i);
          if(/^(rep[_-]|coop[_-]|gdrive|REP_)/i.test(k) || k==='SESSION_STORAGE_KEY' || k==='session_autosave') {
            try { out[k] = localStorage.getItem(k); } catch(e){}
          }
        }
      } catch(e){}
      return out;
    })()
  };
  var json = JSON.stringify(pkg, null, 2);
  var blob = new Blob([json], {type:'application/json'});
  var stamp = now.toISOString().slice(0,19).replace(/[:T]/g,'-');
  var fname = 'REP-backup-completo-'+stamp+'.json';
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = fname;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(a.href);
  var sizeKB = Math.round(json.length/1024);
  showToast('📦 Backup completo scaricato — '+sizeKB+' KB');
  if(typeof coopLog==='function') coopLog('📦 Backup completo esportato ('+sizeKB+' KB)');
  // Show summary modal
  var summary =
    '📦 BACKUP COMPLETO ESPORTATO\n\n'+
    'Sessioni salvate: '+pkg.savedSessions.length+'\n'+
    'Giri totali in sessione corrente: '+(Object.values(pkg.currentSession.STATE.laps||{}).reduce(function(a,l){return a+l.length;},0))+'\n'+
    'Avversari: '+(pkg.currentSession._competitors||[]).length+'\n'+
    'Sessioni schedulate: '+pkg.weekendSchedule.length+'\n'+
    'Ricambi: '+((pkg.currentSession.SPARE_PARTS_data?.track||[]).length+(pkg.currentSession.SPARE_PARTS_data?.rally||[]).length)+'\n'+
    'Documenti: '+((pkg.currentSession.DOCS_track||[]).length+(pkg.currentSession.DOCS_rally||[]).length)+'\n'+
    'Tema: '+pkg.preferences.theme+'\n\n'+
    'File: '+fname+'\n'+
    'Dimensione: '+sizeKB+' KB\n\n'+
    'Conserva questo file in un posto sicuro (Google Drive / email / chiavetta). Per ripristinare usa "📥 RIPRISTINA BACKUP".';
  alert(summary);
}

function importFullBackup(){
  var inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = '.json,application/json';
  inp.onchange = function(e){
    var f = e.target.files[0]; if(!f) return;
    var r = new FileReader();
    r.onload = function(ev){ _applyFullBackup(ev.target.result); };
    r.readAsText(f);
  };
  inp.click();
}

function _applyFullBackup(json){
  var pkg;
  try { pkg = JSON.parse(json); }
  catch(e){ showToast('❌ JSON non valido'); return; }
  if(!pkg._REP_FULL_BACKUP){
    // Maybe it's a single-session snapshot — try restoring that
    if(pkg.STATE){
      if(confirm('Questo non è un backup completo, è solo una sessione. Ripristinarla comunque?')){
        restoreSession(pkg);
        showToast('✓ Sessione ripristinata');
      }
      return;
    }
    showToast('❌ Non è un file di backup REP'); return;
  }
  var when = pkg.exportedAt ? new Date(pkg.exportedAt).toLocaleString('it-IT') : 'sconosciuta';
  var confirmMsg = '⚠️ RIPRISTINO BACKUP COMPLETO\n\n'+
    'Data export: '+when+'\n'+
    'Sessione corrente: '+(pkg.currentSession ? 'SÌ' : 'NO')+'\n'+
    'Sessioni salvate: '+(pkg.savedSessions||[]).length+'\n'+
    'Schedule weekend: '+(pkg.weekendSchedule||[]).length+' sessioni\n\n'+
    'TUTTI I DATI ATTUALI VERRANNO SOVRASCRITTI.\n'+
    'Vuoi continuare?';
  if(!confirm(confirmMsg)) return;

  try {
    // Restore saved sessions list
    if(Array.isArray(pkg.savedSessions)){
      localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(pkg.savedSessions));
    }
    // Restore weekend schedule
    if(Array.isArray(pkg.weekendSchedule)){
      localStorage.setItem(_SCHEDULE_KEY||'rep_weekend_schedule_v1', JSON.stringify(pkg.weekendSchedule));
    }
    // Restore preferences
    if(pkg.preferences){
      if(pkg.preferences.coopIdentity) localStorage.setItem('coop_identity', JSON.stringify(pkg.preferences.coopIdentity));
      if(pkg.preferences.coopFbConfig) localStorage.setItem('coop_fb_config', pkg.preferences.coopFbConfig);
      if(pkg.preferences.sidebarWidgets) localStorage.setItem('rep_sidebar_widgets', JSON.stringify(pkg.preferences.sidebarWidgets));
      if(pkg.preferences.gdriveClientId) localStorage.setItem('gdrive_client_id', pkg.preferences.gdriveClientId);
      if(pkg.preferences.theme) {
        try { document.documentElement.setAttribute('data-theme', pkg.preferences.theme); localStorage.setItem('rep_theme', pkg.preferences.theme); } catch(e){}
      }
    }
    // Restore localStorage dump (additive — don't overwrite things we already handled)
    if(pkg.localStorageDump){
      Object.keys(pkg.localStorageDump).forEach(function(k){
        // Don't overwrite ones we just set
        if(k==='coop_identity'||k==='coop_fb_config'||k==='rep_sidebar_widgets'||k==='rep_theme'||k==='gdrive_client_id') return;
        if(k===SESSION_STORAGE_KEY || k===_SCHEDULE_KEY) return;
        try { localStorage.setItem(k, pkg.localStorageDump[k]); } catch(e){}
      });
    }
    // Restore current session (in-memory)
    if(pkg.currentSession){
      restoreSession(pkg.currentSession);
    }
    // Refresh UI
    if(typeof renderSessionList==='function') renderSessionList();
    if(typeof renderSchedule==='function') renderSchedule();
    if(typeof updateScheduledBanner==='function') updateScheduledBanner();
    showToast('✅ Backup ripristinato con successo');
    if(typeof coopLog==='function') coopLog('📥 Backup completo ripristinato');
    setTimeout(function(){
      if(confirm('Ricaricare la pagina per applicare tutte le modifiche?')) location.reload();
    }, 500);
  } catch(e){
    showToast('❌ Errore ripristino: '+e.message);
    console.error(e);
  }
}

