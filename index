/* ═══ B2: Predittivo rally ↔ percorsi 3D ═══ */
window.repPredict3D = function(){
  try {
    var sel=document.getElementById('rep-pred-route');
    var out=document.getElementById('rep-pred-3d-out');
    if(!sel||!out) return;
    var routes={}; try { routes=JSON.parse(localStorage.getItem('REP_routes_v1')||'{}'); } catch(e){}
    var r=routes[sel.value];
    if(!r||!r.lats||r.lats.length<3){ out.innerHTML='<span class="small">Nessun percorso selezionato.</span>'; return; }
    var dist=0, climb=0, desc=0;
    function hv(a1,o1,a2,o2){ var R=6371e3,p1=a1*Math.PI/180,p2=a2*Math.PI/180,dp=(a2-a1)*Math.PI/180,dl=(o2-o1)*Math.PI/180;
      var x=Math.sin(dp/2)*Math.sin(dp/2)+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)*Math.sin(dl/2); return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x)); }
    for(var i=1;i<r.lats.length;i++){
      dist+=hv(r.lats[i-1],r.lons[i-1],r.lats[i],r.lons[i]);
      var dA=r.alts[i]-r.alts[i-1];
      if(dA>0) climb+=dA; else desc-=dA;
    }
    var km=dist/1000, cpk=climb/Math.max(0.1,km);
    // fattore tempo salita: ~+0.5% per m/km di salita netta media (potenza limitata in salita)
    var factor=1+0.005*cpk*0.5+0.002*(desc/Math.max(0.1,km))*0.3;
    out.innerHTML='<div class="small" style="line-height:1.8">'+
      '📏 <b>'+km.toFixed(2)+' km</b> · ⛰ salita <b>+'+climb.toFixed(0)+' m</b> ('+cpk.toFixed(0)+' m/km) · discesa −'+desc.toFixed(0)+' m<br>'+
      '⏱ Fattore difficoltà stimato: <b>×'+factor.toFixed(3)+'</b> rispetto a una PS piatta di pari lunghezza '+
      '<span style="opacity:.7">(stima di primo ordine dalla sola altimetria)</span><br>'+
      '<button class="btn btn-gray" style="font-size:10px;margin-top:4px" onclick="showPage(\'map3d\')">⛰ APRI IN 3D</button></div>';
  } catch(e){}
};
function repInjectPredict(){
  try {
    var pg=document.getElementById('page-rally-predict');
    if(!pg || document.getElementById('rep-pred-3d')) return;
    var routes={}; try { routes=JSON.parse(localStorage.getItem('REP_routes_v1')||'{}'); } catch(e){}
    var keys=Object.keys(routes);
    pg.insertAdjacentHTML('afterbegin',
      '<div class="panel mb12" id="rep-pred-3d"><div class="panel-head">⛰ ALTIMETRIA PS (dai percorsi 3D importati)</div>'+
      '<div class="panel-body"><div class="form-row"><div class="field"><label>Percorso</label><select id="rep-pred-route" onchange="repPredict3D()">'+
      (keys.length? keys.map(function(k){ return '<option>'+esc2(k)+'</option>'; }).join('') : '<option value="">— importa prima un percorso nella Mappa 3D —</option>')+
      '</select></div></div><div id="rep-pred-3d-out"></div></div></div>');
    if(keys.length) repPredict3D();
  } catch(e){}
}

/* ═══ D1: profilo circuito automatico dal percorso 3D ═══ */
window.repRouteToProfile = function(){
  try {
    var g=null;
    try { if(typeof _gpsData!=='undefined' && _gpsData) g=_gpsData; } catch(e){}
    if(!g) g=window._gpsData;
    if(!g||!g.lats||g.lats.length<10){ T('Carica prima un percorso nella Mappa 3D'); return; }
    var lats=g.lats, lons=g.lons, alts=g.alts, n=lats.length;
    var _mx=-Infinity,_mn=Infinity; for(var q0=0;q0<lats.length;q0++){ if(lats[q0]>_mx)_mx=lats[q0]; if(lats[q0]<_mn)_mn=lats[q0]; } var latC=(_mx+_mn)/2;
    var mLat=111320, mLon=111320*Math.cos(latC*Math.PI/180);
    function xy(i){ return [lons[i]*mLon, lats[i]*mLat]; }
    // raggio di curvatura per punto (circumraggio su finestra +-2, smussato)
    var vTrack = STATE.mode==='track';
    var vCap = vTrack? 200/3.6 : 140/3.6;      // m/s
    var ay = (vTrack? 1.15 : 0.75)*9.81;        // grip tipico (asfalto pista / misto rally)
    var tCls={ straight:0, fast:0, mid:0, slow:0 }, total=0;
    var slopeVar=0, prevSlope=null;
    for(var i=2;i<n-2;i++){
      var A=xy(i-2), B=xy(i), C=xy(i+2);
      var a=Math.hypot(B[0]-A[0],B[1]-A[1]), b=Math.hypot(C[0]-B[0],C[1]-B[1]), c=Math.hypot(C[0]-A[0],C[1]-A[1]);
      var area=Math.abs((B[0]-A[0])*(C[1]-A[1])-(C[0]-A[0])*(B[1]-A[1]))/2;
      var R = area>0.01? (a*b*c)/(4*area) : 9999;
      var ds=(a+b)/2;
      var v=Math.min(vCap, Math.sqrt(ay*Math.max(8,R)));
      var dt=ds/Math.max(6,v);
      total+=dt;
      if(R>350) tCls.straight+=dt;
      else if(R>140) tCls.fast+=dt;
      else if(R>55) tCls.mid+=dt;
      else tCls.slow+=dt;
      var sl=g.slopes? g.slopes[i] : 0;
      if(prevSlope!==null) slopeVar+=Math.abs(sl-prevSlope);
      prevSlope=sl;
    }
    if(!(total>0)){ T('Percorso troppo corto'); return; }
    // frenata: quota fissa 12% sottratta proporzionalmente
    var f={ fStraight:tCls.straight/total*88, fFast:tCls.fast/total*88, fMid:tCls.mid/total*88, fSlow:tCls.slow/total*88, fBrake:12 };
    var bumpy=Math.max(0, Math.min(10, Math.round(slopeVar/(n-5)*3)));
    // chiave profilo come l'analizzatore
    var profKey='track';
    if(STATE.mode!=='track'){
      var s=(document.getElementById('r-setup-surface')||{}).value||'Asfalto';
      profKey = /asfalto/i.test(s)? 'rally_tarmac':'rally_loose';
    }
    var all={}; try { all=JSON.parse(localStorage.getItem('REP_sa_prof_v2')||'{}'); } catch(e){}
    all[profKey]=Object.assign({}, all[profKey]||{}, {
      fStraight:+f.fStraight.toFixed(1), fFast:+f.fFast.toFixed(1), fMid:+f.fMid.toFixed(1),
      fSlow:+f.fSlow.toFixed(1), fBrake:12, bumpy:bumpy, lapSecOverride:Math.round(total)
    });
    localStorage.setItem('REP_sa_prof_v2', JSON.stringify(all));
    T('🛣 Profilo "'+profKey+'" dal percorso: rett '+f.fStraight.toFixed(0)+'% · veloci '+f.fFast.toFixed(0)+'% · medie '+f.fMid.toFixed(0)+'% · strette '+f.fSlow.toFixed(0)+'% · sconnesso '+bumpy+'/10 · tempo ~'+Math.round(total)+'s');
    try { if(typeof saRender==='function') saRender(STATE.mode==='track'?'track':'rally'); } catch(e){}
  } catch(e){ T('Errore profilo: '+e.message); }
};
