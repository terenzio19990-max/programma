// ── 14. S3 AUTOCOMPLETE DA S1+S2 ─────────────────────
(function(){
  function parseMs(str){
    if(!str||!str.trim()) return null;
    str=str.trim();
    var m=str.match(/^(\d+):(\d{2})\.(\d+)$/);
    if(m) return (+m[1])*60000+(+m[2])*1000+(+m[3].padEnd(3,'0').slice(0,3));
    m=str.match(/^(\d+)\.(\d+)$/);
    if(m) return (+m[1])*1000+(+m[2].padEnd(3,'0').slice(0,3));
    return null;
  }
  function msToStr(ms){
    var m=Math.floor(ms/60000), s=Math.floor((ms%60000)/1000), msec=ms%1000;
    return m+':'+String(s).padStart(2,'0')+'.'+String(msec).padStart(3,'0');
  }

  function tryAutoS3(){
    var lt=document.getElementById('lap-time');
    var s1=document.getElementById('s1-time');
    var s2=document.getElementById('s2-time');
    var s3=document.getElementById('s3-time');
    if(!lt||!s1||!s2||!s3) return;
    if(s3.value.trim()) return; // Don't overwrite if already filled
    var totalMs=parseMs(lt.value), s1Ms=parseMs(s1.value), s2Ms=parseMs(s2.value);
    if(totalMs && s1Ms && s2Ms){
      var s3Ms=totalMs-s1Ms-s2Ms;
      if(s3Ms>0 && s3Ms<totalMs){
        s3.value=msToStr(s3Ms);
        s3.style.color='var(--accent3)';
        setTimeout(function(){ s3.style.color=''; },1500);
      }
    }
  }

  ['s1-time','s2-time','lap-time'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('change', tryAutoS3);
  });
})();

