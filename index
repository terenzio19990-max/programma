// Client-side filter within the open picker modal (no re-render)
function _filterSinglePicker(){
  var q = (document.getElementById('single-picker-search')?.value || '').toLowerCase().trim();
  var statusFilter = document.getElementById('single-picker-filter-status')?.value || '';
  var onlyPref = document.getElementById('single-picker-only-preferred')?.checked;
  var ctx = _singlePickerCtx || {};
  var preferredPos = ctx.wheel;
  document.querySelectorAll('.single-picker-row').forEach(function(row){
    // Find the tyre id from the onclick attr
    var oc = row.getAttribute('onclick') || '';
    var m = oc.match(/pickSingleTyre\('([^']+)'/);
    var t = m ? TYRE_STOCK.find(function(x){return x.id===m[1];}) : null;
    if(!t){ row.style.display = 'none'; return; }
    var show = true;
    if(q){
      var hay = [t.code,t.brand,t.set,t.compound,t.position,t.notes].join(' ').toLowerCase();
      if(hay.indexOf(q) < 0) show = false;
    }
    if(statusFilter && (t.status||'new') !== statusFilter) show = false;
    if(onlyPref && (t.position||'').toUpperCase() !== preferredPos) show = false;
    row.style.display = show ? '' : 'none';
  });
}

// User picked a specific tyre for the current (mode, wheel)
function pickSingleTyre(tyreId){
  var ctx = _singlePickerCtx;
  if(!ctx){ document.getElementById('single-tyre-picker-modal').style.display='none'; return; }
  var t = TYRE_STOCK.find(function(x){return x.id===tyreId;});
  if(!t){ showToast('Gomma non trovata'); return; }
  var prefix = ctx.mode === 'rally' ? 'rl-' : 'tr-';
  var w = ctx.wheel;
  var fCpd = document.getElementById(prefix+'cpd-'+w);
  var fSet = document.getElementById(prefix+'setname-'+w);
  var fBrand = document.getElementById(prefix+'brand-'+w);
  var fCode = document.getElementById(prefix+'code-'+w);
  if(fCpd && t.compound) fCpd.value = t.compound;
  if(fSet && t.set) fSet.value = t.set;
  if(fBrand) fBrand.value = t.brand || '';
  if(fCode) fCode.value = t.code || '';
  document.getElementById('single-tyre-picker-modal').style.display='none';
  // Highlight the code input so user sees the update
  if(fCode){
    var origBg = fCode.style.background;
    fCode.style.background = 'rgba(44,188,110,0.3)';
    setTimeout(function(){ fCode.style.background = origBg; }, 1200);
  }
  showToast('✓ '+(t.code||'Gomma')+' selezionata per '+w);
}

