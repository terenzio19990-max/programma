// DOCUMENTS
// ═══════════════════════════════════════════════════════════════
const DOCS = { track: [], rally: [] };
let _docFilter = { track:'', rally:'' };

function addDocument(input, mode) {
  const file = input.files[0]; if(!file) return;
  const title = document.getElementById(`doc-${mode}-title`)?.value?.trim() || file.name;
  const cat   = document.getElementById(`doc-${mode}-cat`)?.value || 'Altro';
  const note  = document.getElementById(`doc-${mode}-note`)?.value || '';
  const isPdf = file.type === 'application/pdf';
  const isImg = file.type.startsWith('image/');
  if(!isPdf && !isImg) { showToast('⚠️ Solo PDF o immagini (JPG/PNG)'); return; }

  const reader = new FileReader();
  reader.onload = e => {
    DOCS[mode].push({
      id: Date.now(),
      title,
      cat,
      note,
      type: isPdf ? 'pdf' : 'image',
      name: file.name,
      size: (file.size/1024).toFixed(0),
      dataUrl: e.target.result,
      addedAt: new Date().toLocaleString('it-IT')
    });
    document.getElementById(`doc-${mode}-title`).value = '';
    document.getElementById(`doc-${mode}-note`).value = '';
    renderDocs(mode);
    if(typeof triggerAutoSave === 'function') triggerAutoSave();
    showToast(`✅ "${title}" caricato`);
  };
  reader.readAsDataURL(file);
  input.value = '';
}

function renderDocs(mode) {
  buildDocStorageIndicator(mode);
  const list = document.getElementById(`doc-${mode}-list`);
  const summary = document.getElementById(`doc-${mode}-summary`);
  if(!list) return;
  const filter = _docFilter[mode] || '';
  const filtered = filter ? DOCS[mode].filter(d=>d.cat===filter) : DOCS[mode];

  if(summary) {
    const total = DOCS[mode].length;
    const pdfs  = DOCS[mode].filter(d=>d.type==='pdf').length;
    const imgs  = DOCS[mode].filter(d=>d.type==='image').length;
    const cats  = [...new Set(DOCS[mode].map(d=>d.cat))];
    summary.innerHTML = total
      ? `<div class="g2" style="gap:8px;margin-bottom:8px;">
           <div class="tile"><div class="tile-label">TOTALE</div><div class="tile-value">${total}</div></div>
           <div class="tile"><div class="tile-label">PDF / IMMAGINI</div><div class="tile-value">${pdfs} / ${imgs}</div></div>
         </div>
         <div style="font-size:11px;color:var(--text3);">Categorie: ${cats.join(', ')}</div>`
      : '<div style="color:var(--text3);">Nessun documento</div>';
  }

  if(!filtered.length) {
    list.innerHTML = `<div style="grid-column:1/-1;text-align:center;color:var(--text3);padding:28px;font-size:12px;">Nessun documento${filter?' nella categoria "'+filter+'"':''}</div>`;
    return;
  }

  list.innerHTML = filtered.map(doc=>`
    <div style="background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:12px;display:flex;flex-direction:column;gap:8px;">
      <div style="display:flex;align-items:flex-start;gap:8px;">
        <div style="font-size:28px;line-height:1;">${doc.type==='pdf'?'📄':'🖼'}</div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;color:var(--text1);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${doc.title}</div>
          <div style="font-size:11px;color:var(--text3);margin-top:2px;">${doc.cat} · ${doc.size}KB · ${doc.addedAt}</div>
          ${doc.note?`<div style="font-size:11px;color:var(--text2);margin-top:3px;">${doc.note}</div>`:''}
        </div>
      </div>
      <div style="display:flex;gap:6px;">
        <button class="btn btn-blue" style="flex:1;padding:5px;" onclick="viewDocument('${mode}',${doc.id})">👁 APRI</button>
        <button class="btn btn-gray" style="padding:5px 10px;" onclick="downloadDocument('${mode}',${doc.id})" title="Download">⬇</button>
        <button onclick="removeDocument('${mode}',${doc.id})" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:16px;padding:0 4px;" title="Elimina">✕</button>
      </div>
    </div>`).join('');
}

function filterDocs(mode, cat, btn) {
  buildDocStorageIndicator(mode);
  _docFilter[mode] = cat;
  document.querySelectorAll('.doc-filter').forEach(b=>b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  renderDocs(mode);
}

function viewDocument(mode, id) {
  const doc = DOCS[mode].find(d=>d.id===id);
  if(!doc) return;
  const frame = document.getElementById(`doc-${mode}-viewer-frame`);
  const title = document.getElementById(`doc-${mode}-viewer-title`);
  const viewer = document.getElementById(`doc-${mode}-viewer`);
  if(frame) frame.src = doc.dataUrl;
  if(title) {
    title.innerHTML = `${doc.title} <button onclick="document.getElementById('doc-${mode}-viewer').style.display='none'" class="btn btn-gray" style="padding:2px 8px;font-size:10px;">✕ CHIUDI</button>`;
  }
  if(viewer) { viewer.style.display=''; viewer.scrollIntoView({behavior:'smooth'}); }
}

function downloadDocument(mode, id) {
  const doc = DOCS[mode].find(d=>d.id===id);
  if(!doc) return;
  const a = document.createElement('a');
  a.href = doc.dataUrl;
  a.download = doc.name || doc.title;
  a.click();
}

function removeDocument(mode, id) {
  if(!confirm('Rimuovere questo documento?')) return;
  DOCS[mode] = DOCS[mode].filter(d=>d.id!==id);
  renderDocs(mode);
  showToast('🗑 Documento rimosso');
}


