/* ─── 6. STILE: dichiarato + appreso ─────────────────────────────────────── */
function seedFromQuiz(answers){
  var acc={}, cnt={};
  answers.forEach(function(ai,qi){
    var a=QUIZ[qi] && QUIZ[qi].a[ai];
    if(!a) return;
    Object.keys(a.w).forEach(function(k){ acc[k]=(acc[k]||0)+a.w[k]; cnt[k]=(cnt[k]||0)+1; });
  });
  var seed={};
  AXK.forEach(function(k){ seed[k] = cnt[k]? acc[k]/cnt[k] : 0.5; });
  return seed;
}

function isLowGrip(s){ return /bagn|wet|pioggia|neve|snow|ghiacc|ghiaia|gravel|terra|sterrat|loose|misto/i.test(String(s||'')); }

/* Un evento con feedback produce dei "campioni" per gli assi appresi. */
function samplesFrom(ev){
  var fb=ev.fb; if(!fb) return null;
  var e=+fb.entry||0, m=+fb.mid||0, x=+fb.exit||0, conf=(fb.conf===undefined?5:+fb.conf);
  var ovr = ((e+m+x)/3)/5;          // -1 sottosterzo … +1 sovrasterzo (com'era l'auto)
  var c   = (conf-5)/5;             // -1 male … +1 bene (come si è trovato)
  var out = {};
  // Tolleranza al posteriore: auto sovrasterzante + si è trovato bene ⇒ alta.
  out.rearTol = clamp(0.5 + 0.5*clamp(ovr*c*2, -1, 1), 0, 1);
  // Priorità: la fase su cui è più sensibile (si lamenta di più) è quella che gli sta a cuore.
  out.exitBias = clamp(0.5 + (Math.abs(x)-Math.abs(e))/8, 0, 1);
  // Fiducia con poco grip: solo dagli eventi a bassa aderenza.
  if(isLowGrip(ev.surface)) out.wetConf = clamp(conf/10, 0, 1);
  return out;
}

function styleOf(d){
  var st={};
  AXES.forEach(function(a){
    var base = (d.seed && d.seed[a.k]!==undefined)? d.seed[a.k] : 0.5;
    var conf = d.seed? 0.45 : 0.15, src = d.seed? 'quiz':'default';
    if(d.manual && d.manual[a.k]!==undefined){ base=d.manual[a.k]; conf=0.80; src='manuale'; }
    st[a.k]={v:base, c:conf, src:src, n:0};
  });
  var evs=(d.events||[]).filter(function(e){ return e.fb && e.quality!=='scarta'; });
  var ema={}, n={};
  evs.forEach(function(ev){
    var s=samplesFrom(ev); if(!s) return;
    var w = (ev.quality==='dubbia')? 0.12 : 0.25;   // run sporchi pesano meno
    Object.keys(s).forEach(function(k){
      ema[k] = (ema[k]===undefined)? s[k] : (ema[k]*(1-w) + s[k]*w);
      n[k]   = (n[k]||0)+1;
    });
  });
  AXES.forEach(function(a){
    if(a.src!=='app' || ema[a.k]===undefined) return;
    var nn=n[a.k]||0;
    var wL = 1-Math.exp(-nn/5);                       // quanto ci si fida dell'appreso
    st[a.k].v = clamp(st[a.k].v*(1-wL) + ema[a.k]*wL, 0, 1);
    st[a.k].c = Math.max(st[a.k].c, 1-Math.exp(-nn/6));
    st[a.k].src = 'appreso'; st[a.k].n = nn;
  });
  return st;
}

function archetypeOf(st){
  var best=null, bd=1e9;
  ARCH.forEach(function(A){
    var d=0;
    AXK.forEach(function(k){ var x=(st[k]?st[k].v:0.5)-A.c[k]; d+=x*x; });
    if(d<bd){ bd=d; best=A; }
  });
  return {arch:best, dist:Math.sqrt(bd/AXK.length)};
}

/* ─── 7. OBIETTIVI DI BILANCIAMENTO (U positivo = verso sovrasterzo) ─────── */
var U_MAX = 0.05;
function targetsOf(st, lowGrip){
  function v(k){ return (st[k]? st[k].v : 0.5) - 0.5; }         // -0.5 … +0.5
  function c(k){ return st[k]? st[k].c : 0.3; }
  var reasons = {entry:[], mid:[], exit:[]};
  function add(ph, val, why){ if(Math.abs(val)>0.002) reasons[ph].push({d:val, why:why}); return val; }

  var t = {entry:0, mid:0, exit:0};

  t.entry += add('entry',  0.060*v('rearTol')*c('rearTol'),        'accetta il posteriore mobile');
  t.entry += add('entry',  0.040*v('trailBrake')*c('trailBrake'),  'porta il freno dentro: vuole rotazione');
  t.entry += add('entry', -0.030*v('brakeAggr')*c('brakeAggr'),    'stacca tardi e forte: serve un retrotreno che regga');

  t.mid   += add('mid',    0.050*v('rearTol')*c('rearTol'),        'accetta il posteriore mobile');
  t.mid   += add('mid',    0.040*v('smooth')*c('smooth'),          'guida pulita: regge un\'auto più puntata');

  t.exit  += add('exit',   0.040*v('rearTol')*c('rearTol'),        'accetta il posteriore mobile');
  t.exit  += add('exit',  -0.060*v('exitBias')*c('exitBias'),      'costruisce il tempo in uscita: serve trazione');
  t.exit  += add('exit',  -0.040*v('throttleAggr')*c('throttleAggr'),'apre il gas deciso: meno sovrasterzo di potenza');

  if(lowGrip){
    var lg = -0.050*(0.5 - (st.wetConf?st.wetConf.v:0.5))*c('wetConf');
    ['entry','mid','exit'].forEach(function(ph){ t[ph]+=add(ph, lg, 'poca aderenza: margine di stabilità'); });
  }
  ['entry','mid','exit'].forEach(function(ph){ t[ph]=clamp(t[ph], -U_MAX, U_MAX); });
  t._why = reasons;
  return t;
}

/* ─── 8. MEMORIA DEL LUOGO ───────────────────────────────────────────────── */
function venueName(mode){
  try {
    if(mode==='rally'){
      var el=document.getElementById('dp-venue-rally');
      if(el && el.value.trim()) return el.value.trim();
      var ps=(document.getElementById('r-setup-ps')||{}).value||'';
      var nm=String(ps).replace(/\bPS\s*\d+\b/ig,'').replace(/[\s\-–—]{2,}/g,' ').trim();
      return nm || 'Rally';
    }
    return (STATE && STATE.circuit) ? String(STATE.circuit) : 'Pista';
  } catch(e){ return mode==='rally'?'Rally':'Pista'; }
}
function surfNow(mode){
  try {
    if(mode==='rally') return (document.getElementById('r-setup-surface')||{}).value || 'Asfalto';
    return (STATE && STATE.surface) ? String(STATE.surface) : 'ASCIUTTO';
  } catch(e){ return 'n/d'; }
}
function venueKey(mode){ return (venueName(mode)+'/'+surfNow(mode)).toLowerCase(); }

function venueMemory(d, key){
  if(!d) return null;
  var evs=(d.events||[]).filter(function(e){ return e.venueKey===key; });
  if(!evs.length) return null;
  var timed=evs.filter(function(e){ return +e.timeS>0; });
  var best=null;
  if(timed.length) best=timed.reduce(function(a,b){ return (+a.timeS<=+b.timeS)? a:b; });
  else best=evs[evs.length-1];
  var avgConf = evs.reduce(function(s,e){ return s+((e.fb&&+e.fb.conf)||5); },0)/evs.length;
  return {runs:evs.length, best:best, avgConf:avgConf, last:evs[evs.length-1], events:evs};
}

