function bulkConfirm(){
  // Collect edited values
  var rows = [];
  document.querySelectorAll('#bulk-preview-tbody tr').forEach(function(tr){
    var chk = tr.querySelector('.bulk-chk'); if(!chk || !chk.checked) return;
    var vEl = tr.querySelector('.bulk-vmax');
    rows.push({
      lap: +tr.querySelector('.bulk-lap').value || 0,
      time: tr.querySelector('.bulk-time').value.trim(),
      s1: tr.querySelector('.bulk-s1').value.trim(),
      s2: tr.querySelector('.bulk-s2').value.trim(),
      s3: tr.querySelector('.bulk-s3').value.trim(),
      pos: tr.querySelector('.bulk-pos').value.trim(),
      vmax: vEl ? (+vEl.value || null) : null,
      note: tr.querySelector('.bulk-note').value.trim()
    });
  });
  if(!rows.length){ showToast('Nessuna riga selezionata'); return; }
  var carId = (document.getElementById('bulk-car-sel')||{}).value;
  var cars = STATE.trackCars.concat(STATE.rallyCars);
  var car = cars.filter(function(c){return c.id===carId;})[0];
  if(!car){ showToast('Vettura non trovata'); return; }
  if(!STATE.laps[car.id]) STATE.laps[car.id]=[];
  // Undo snapshot
  var snap = JSON.parse(JSON.stringify(STATE.laps[car.id]));
  if(typeof pushUndo==='function') pushUndo('Import '+rows.length+' giri su '+car.name, function(){
    STATE.laps[car.id]=snap;
    if(typeof buildLapsPage==='function') buildLapsPage();
    if(typeof buildDashboard==='function') buildDashboard();
  });
  var session = (document.getElementById('bulk-session')||{}).value.trim()
              || (document.getElementById('session-type')||{}).value
              || 'Import';
  var driverId = (document.getElementById('lap-driver')||{}).value
              || (typeof Mem !== 'undefined' && Mem.get ? (Mem.get('lastDriverId')||'') : '');
  var added = 0;
  rows.forEach(function(r){
    if(!parseTime(r.time)) return;
    STATE.laps[car.id].push({
      lap: r.lap||(STATE.laps[car.id].length+1),
      time: r.time,
      s1: r.s1, s2: r.s2, s3: r.s3,
      pos: r.pos, vmax: r.vmax, note: r.note,
      session: session, car: car.id,
      driverId: driverId,
      ts: Date.now() + added
    });
    added++;
  });
  // Rebuild UI
  showToast('✓ Importati '+added+' giri su '+car.name);
  bulkClear();
  // Switch the selected car to the imported car (if track car) for instant visual feedback
  var trackIdx = STATE.trackCars.findIndex(function(c){return c.id===car.id;});
  if(trackIdx>=0){ STATE.selectedTrackCar = trackIdx; }
  if(typeof buildLapsPage==='function') buildLapsPage();
  if(typeof updateTrackCarsPanel==='function') updateTrackCarsPanel();
  if(typeof buildDashboard==='function') buildDashboard();
  if(typeof triggerAutoSave==='function') triggerAutoSave();
}

