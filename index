function _buildStockPickerHTML(){
  // Gather available tyres: status is NEW or USED (not mounted, not dismissed)
  var available = TYRE_STOCK.filter(function(t){
    return t.status !== 'mounted' && t.status !== 'dismissed';
  });
  // Group by set name (or "— Senza set —")
  var groups = {};
  available.forEach(function(t){
    var key = (t.set||'').trim() || '— Senza set —';
    if(!groups[key]) groups[key] = [];
    groups[key].push(t);
  });
  // Sort: complete sets (>=4) first, then partial
  var groupEntries = Object.entries(groups).sort(function(a,b){
    var aComplete = a[1].length >= 4;
    var bComplete = b[1].length >= 4;
    if(aComplete && !bComplete) return -1;
    if(!aComplete && bComplete) return 1;
    return a[0].localeCompare(b[0]);
  });

  var setsHtml = '';
  if(!groupEntries.length){
    setsHtml = '<div style="padding:30px;text-align:center;color:var(--text3);">'+
      'Il magazzino non contiene gomme disponibili (nuove o usate).<br>'+
      '<a href="#" onclick="document.getElementById(\'stock-picker-modal\').style.display=\'none\';showPage(\'tyre-stock\');return false;" style="color:var(--accent3);">Vai al magazzino →</a>'+
      '</div>';
  } else {
    setsHtml = groupEntries.map(function(entry){
      var setName = entry[0];
      var tyres = entry[1];
      var isComplete = tyres.length >= 4;
      // Summary stats for the set
      var cpds = Array.from(new Set(tyres.map(function(t){return t.compound||'';}).filter(Boolean)));
      var brands = Array.from(new Set(tyres.map(function(t){return t.brand||'';}).filter(Boolean)));
      var avgWear = tyres.reduce(function(a,t){return a+(+t.wear||0);},0) / tyres.length;
      var maxWear = Math.max.apply(null, tyres.map(function(t){return +t.wear||0;}));
      var totalKm = tyres.reduce(function(a,t){return a+(+t.km||0);},0);
      var newCount = tyres.filter(function(t){return t.status==='new';}).length;
      var usedCount = tyres.filter(function(t){return t.status==='used';}).length;
      var hasDamage = tyres.some(function(t){return t.damage && t.damage!=='none' && t.damage!=='';});
      var wearColor = maxWear<40 ? 'var(--green)' : maxWear<70 ? 'var(--yellow)' : 'var(--red)';

      // Position coverage check
      var positions = tyres.map(function(t){return t.position||'';});
      var hasAllPositions = ['FL','FR','RL','RR'].every(function(p){return positions.indexOf(p)>=0;});
      var pickBtn;
      if(isComplete && hasAllPositions){
        pickBtn = '<button class="btn btn-green" style="padding:6px 14px;font-size:11px;" onclick="pickStockSet(\''+setName.replace(/'/g,"\\'")+'\')">✓ USA QUESTO SET</button>';
      } else if(isComplete && !hasAllPositions){
        pickBtn = '<button class="btn btn-yellow" style="padding:6px 14px;font-size:11px;" onclick="pickStockSet(\''+setName.replace(/'/g,"\\'")+'\')" title="Il set ha 4 gomme ma non tutte le posizioni FL/FR/RL/RR. Verranno assegnate in ordine.">⚠ USA (posizioni parziali)</button>';
      } else {
        pickBtn = '<span style="font-size:10px;color:var(--text3);padding:6px 10px;">Incompleto ('+tyres.length+'/4)</span>';
      }

      // Individual tyres detail
      var tyreRows = tyres.map(function(t){
        var statusBadge = t.status==='new' ? '<span style="background:var(--blue);color:#fff;padding:1px 5px;border-radius:2px;font-size:9px;">NUOVA</span>' :
                         '<span style="background:var(--yellow);color:#000;padding:1px 5px;border-radius:2px;font-size:9px;">USATA</span>';
        var tWear = +t.wear||0;
        var tWearCol = tWear<40 ? 'var(--green)' : tWear<70 ? 'var(--yellow)' : 'var(--red)';
        var dmgBadge = (t.damage && t.damage !== 'none' && t.damage !== '') ? '<span style="background:var(--red);color:#fff;padding:1px 5px;border-radius:2px;font-size:9px;margin-left:3px;">⚠ '+t.damage.toUpperCase()+'</span>' : '';
        return '<div style="display:grid;grid-template-columns:40px 80px 1fr 80px 70px 70px 80px;gap:6px;align-items:center;padding:3px 8px;background:var(--bg0);border-radius:3px;margin-bottom:2px;font-size:10px;">'+
          '<span style="font-weight:700;color:var(--accent3);font-family:var(--mono);">'+(t.position||'—')+'</span>'+
          '<span>'+statusBadge+'</span>'+
          '<span style="color:var(--text2);font-family:var(--mono);">'+(t.code||'(no codice)')+dmgBadge+'</span>'+
          '<span style="color:var(--text3);">'+(t.compound||'')+' '+(t.brand||'')+'</span>'+
          '<span style="text-align:right;font-family:var(--mono);">'+((+t.km||0).toFixed(1))+' km</span>'+
          '<span style="text-align:right;font-family:var(--mono);">'+(t.laps||0)+' giri</span>'+
          '<span style="text-align:right;font-family:var(--mono);color:'+tWearCol+';font-weight:700;">'+tWear+'%</span>'+
        '</div>';
      }).join('');

      return '<div style="background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:10px 14px;margin-bottom:8px;'+(isComplete?'border-left:4px solid var(--green);':'border-left:4px solid var(--yellow);')+'">'+
        '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;flex-wrap:wrap;gap:8px;">'+
          '<div>'+
            '<div style="font-family:var(--head);font-size:14px;font-weight:700;color:var(--text1);letter-spacing:1px;">📦 '+setName+'</div>'+
            '<div style="font-size:10px;color:var(--text3);margin-top:2px;">'+
              tyres.length+' gomme · '+
              (cpds.length ? 'Mescola: <b style="color:var(--accent3);">'+cpds.join('/')+'</b>' : 'mescola?')+
              (brands.length ? ' · '+brands.join('/') : '')+
              (newCount ? ' · 🆕 '+newCount+' nuove' : '')+
              (usedCount ? ' · ↻ '+usedCount+' usate' : '')+
              (hasDamage ? ' · <span style="color:var(--red);">⚠ con danni</span>' : '')+
            '</div>'+
          '</div>'+
          '<div style="display:flex;align-items:center;gap:8px;">'+
            '<div style="text-align:right;">'+
              '<div style="font-size:10px;color:var(--text3);letter-spacing:1px;">USURA MAX</div>'+
              '<div style="font-family:var(--mono);font-size:14px;font-weight:700;color:'+wearColor+';">'+maxWear.toFixed(0)+'%</div>'+
            '</div>'+
            '<div style="text-align:right;">'+
              '<div style="font-size:10px;color:var(--text3);letter-spacing:1px;">KM TOT</div>'+
              '<div style="font-family:var(--mono);font-size:14px;font-weight:700;">'+totalKm.toFixed(1)+'</div>'+
            '</div>'+
            pickBtn+
          '</div>'+
        '</div>'+
        tyreRows+
      '</div>';
    }).join('');
  }

  return '<div style="background:var(--bg2);border:1px solid var(--border2);border-radius:8px;padding:22px;width:900px;max-width:96vw;max-height:92vh;overflow-y:auto;">'+
    '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">'+
      '<span style="font-family:var(--head);font-size:14px;font-weight:700;letter-spacing:2px;color:var(--blue);">📦 SELEZIONA SET DAL MAGAZZINO — '+(_stockPickerMode==='rally'?'RALLY':'PISTA')+'</span>'+
      '<button class="btn btn-gray" onclick="document.getElementById(\'stock-picker-modal\').style.display=\'none\'">✕ CHIUDI</button>'+
    '</div>'+
    '<div style="background:var(--bg3);border-left:3px solid var(--blue);padding:10px 14px;margin-bottom:14px;font-size:11px;line-height:1.7;color:var(--text2);">'+
      'Scegli un set già presente nel magazzino per auto-compilare il form di montaggio. Il sistema marcherà le gomme come <b style="color:var(--green);">🔧 montate</b> sulla vettura corrente. Al prossimo smontaggio (quando monterai un nuovo treno) torneranno nel magazzino come <b style="color:var(--yellow);">↻ usate</b> con km e usura aggiornati.'+
