// LAP TIME CHART (Plotly)
// ═══════════════════════════════════════════════════════════════
function buildLapChart() {
  const car = STATE.trackCars[STATE.selectedTrackCar];
  const el = document.getElementById('lapchart-car-tabs');
  if(el) el.innerHTML = buildCarTabsHTML(STATE.trackCars, STATE.selectedTrackCar, (i,cid)=>`selectTrackCar(${i},this,'${cid}');buildLapChart()`)('lapchart-car-tabs');
  // Populate driver filter
  if(typeof _populateDriverFilter === 'function') _populateDriverFilter('lapchart-driver');

  // Performance: skip rebuild if the chart container isn't visible (page not active)
  const chartEl = document.getElementById('lapchart-plotly');
  if(chartEl && !chartEl.offsetParent && !window.__FORCE_REBUILD) return;

  const mode = document.getElementById('lapchart-mode')?.value||'all';
  const driverFilter = (typeof _selectedDriverFilter === 'function') ? _selectedDriverFilter('lapchart-driver') : '';
  const laps = (typeof _lapsForCar === 'function') ? _lapsForCar(car.id, driverFilter) : (STATE.laps[car.id]||[]);
  if(!laps.length) {
    if(window.Plotly) Plotly.purge('lapchart-plotly');
    return;
  }

  const bestMs = getBestLapMs(car.id);
  const xs=[], ys=[], texts=[], colors=[];
  laps.forEach((l,i) => {
    const ms = parseTime(l.time);
    if(!ms) return;
    if(mode==='clean' && l.note?.toLowerCase().includes('sc')) return;
    xs.push(l.lap||i+1);
    ys.push(+(ms/1000).toFixed(3));
    const diff = bestMs ? (ms-bestMs)/1000 : 0;
    texts.push('Giro '+l.lap+': '+l.time+(diff>0?'<br>+'+diff.toFixed(3)+'s':'<br>BEST LAP')+(l.note?'<br>'+l.note:''));
    colors.push(ms===bestMs?'#2cbc6e':ms<=bestMs*1.005?'#ffa040':'#2b7de9');
  });

  const traceLine = { type:'scatter', mode:'lines+markers', x:xs, y:ys, name:car.name,
    line:{color:'rgba(255,160,64,0.4)',width:1.5}, marker:{color:colors,size:8},
    text:texts, hoverinfo:'text' };
  const bestLine = bestMs ? { type:'scatter', mode:'lines', x:[xs[0],xs[xs.length-1]], y:[bestMs/1000,bestMs/1000],
    name:'Best: '+msToTime(bestMs), line:{color:'#2cbc6e',width:1.5,dash:'dash'}, hoverinfo:'none' } : null;

  const traces = bestLine ? [traceLine, bestLine] : [traceLine];
  const layout = {
    margin:{l:50,r:20,t:20,b:40},
    xaxis:{title:'Giro',color:'#6b7280',gridcolor:'#2a2f3e',tickfont:{color:'#a8afc0'}},
    yaxis:{title:'Tempo (s)',color:'#6b7280',gridcolor:'#2a2f3e',tickfont:{color:'#a8afc0'}},
    paper_bgcolor:'transparent', plot_bgcolor:'transparent',
    legend:{font:{color:'#a8afc0'},bgcolor:'rgba(0,0,0,0)'},
    font:{color:'#a8afc0'}
  };
  Plotly.newPlot('lapchart-plotly', traces, layout, {responsive:true,displayModeBar:false});

  // Sector chart (if sector data available)
  const s1s=[], s2s=[], s3s=[], lnums=[];
  laps.forEach(l=>{ if(l.s1&&l.s2&&l.s3){ lnums.push(l.lap); s1s.push(parseTime(l.s1)/1000); s2s.push(parseTime(l.s2)/1000); s3s.push(parseTime(l.s3)/1000); }});
  if(s1s.length) {
    const st1={type:'bar',name:'Settore 1',x:lnums,y:s1s,marker:{color:'#e8421a'}};
    const st2={type:'bar',name:'Settore 2',x:lnums,y:s2s,marker:{color:'#2b7de9'}};
    const st3={type:'bar',name:'Settore 3',x:lnums,y:s3s,marker:{color:'#2cbc6e'}};
    const sl={barmode:'stack',margin:{l:50,r:20,t:10,b:40},xaxis:{title:'Giro',color:'#6b7280',gridcolor:'#2a2f3e',tickfont:{color:'#a8afc0'}},yaxis:{title:'Tempo (s)',color:'#6b7280',gridcolor:'#2a2f3e',tickfont:{color:'#a8afc0'}},paper_bgcolor:'transparent',plot_bgcolor:'transparent',legend:{font:{color:'#a8afc0'},bgcolor:'rgba(0,0,0,0)'},font:{color:'#a8afc0'}};
    Plotly.newPlot('sectorchart-plotly',[st1,st2,st3],sl,{responsive:true,displayModeBar:false});
  }
}

