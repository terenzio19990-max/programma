  0%,100% { opacity:1; box-shadow:0 0 6px #e83a1a; }
  50%      { opacity:0.4; box-shadow:0 0 2px #e83a1a; }
}

/* ─── F1 TOPBAR POLISH ─── */
#topbar { border-bottom:2px solid var(--accent); overflow:visible !important; z-index:200 !important; }
#topbar .topbar-right { overflow:visible !important; position:relative; }
.logo { font-size:20px; letter-spacing:4px; }
.logo span { color:var(--accent); text-shadow:0 0 12px rgba(232,66,26,.4); }
#subbar { border-bottom:1px solid var(--border); }
.overflow-dropdown { z-index:1000; }

/* ─── MOBILE RESPONSIVE v18 ─── */
