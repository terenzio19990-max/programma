// ─── Bonus: auto-fill fuelSS/fuelTF in addStageTime using the current rally
//     fuel parameters (consSS, consTF). Only if user hasn't typed a value.
//     This is exposed as a helper that can be invoked from the PS form.
function _autoFillStageFuel(){
  var car = STATE.rallyCars[STATE.selectedRallyCar];
  if(!car || !STATE.rallyFuel || !STATE.rallyFuel[car.id]) return;
  var rf = STATE.rallyFuel[car.id];
  var kmEl = document.getElementById('stage-km');
  var tfEl = document.getElementById('transfer-km');
  var fuelSSEl = document.getElementById('stage-fuel-ss');
  var fuelTFEl = document.getElementById('stage-fuel-tf');
  if(!kmEl || !fuelSSEl) return;
  var km   = parseFloat(kmEl.value) || 0;
  var kmTF = parseFloat(tfEl ? tfEl.value : 0) || 0;
  // Only fill if the field is empty / zero
  if(!fuelSSEl.value || +fuelSSEl.value === 0){
    fuelSSEl.value = (km * (rf.consSS || 0.18)).toFixed(2);
  }
  if(fuelTFEl && (!fuelTFEl.value || +fuelTFEl.value === 0)){
    fuelTFEl.value = (kmTF * (rf.consTF || 0.08)).toFixed(2);
  }
}
window._autoFillStageFuel = _autoFillStageFuel;

// ─── Stage time entry: sync between m:ss.mmm and seconds.mmm ───
// User can enter the PS time either in classic m:ss.mmm or as plain seconds with millis (e.g. 523.456).
// Whichever they edit, the other field updates. Submission still uses stage-time as canonical.
var _stageTimeSyncing = false;

function syncStageTimeFromMin(){
  if(_stageTimeSyncing) return;
  _stageTimeSyncing = true;
  try {
    var minEl = document.getElementById('stage-time');
    var secEl = document.getElementById('stage-time-sec');
    if(!minEl || !secEl) return;
    var v = (minEl.value||'').trim();
    if(!v){ secEl.value=''; return; }
    var ms = (typeof parseTime === 'function') ? parseTime(v) : null;
    if(ms && isFinite(ms)){
      // Format as seconds with up to 3 decimals
      secEl.value = (ms/1000).toFixed(3);
    } else {
      secEl.value = '';
    }
  } finally { _stageTimeSyncing = false; }
}
window.syncStageTimeFromMin = syncStageTimeFromMin;

function syncStageTimeFromSec(){
  if(_stageTimeSyncing) return;
  _stageTimeSyncing = true;
  try {
    var minEl = document.getElementById('stage-time');
    var secEl = document.getElementById('stage-time-sec');
    if(!minEl || !secEl) return;
    var v = (secEl.value||'').trim().replace(',', '.');
    if(!v){ minEl.value=''; return; }
    // Pure seconds with optional .ms
    var n = parseFloat(v);
    if(!isFinite(n) || n <= 0){ minEl.value=''; return; }
    var totalMs = Math.round(n * 1000);
    if(typeof msToTime === 'function'){
      minEl.value = msToTime(totalMs);
    }
  } finally { _stageTimeSyncing = false; }
}
window.syncStageTimeFromSec = syncStageTimeFromSec;

