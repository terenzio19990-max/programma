function _stExpiryStatus(dateStr){
  if(!dateStr) return null;
  var exp = new Date(dateStr);
  if(isNaN(exp.getTime())) return null;
  var now = new Date();
  var diff = (exp-now)/86400000;
  if(diff < 0) return { status:'expired', days:Math.ceil(-diff), label:'SCADUTA da '+Math.ceil(-diff)+'g' };
  if(diff < 30) return { status:'soon', days:Math.ceil(diff), label:'Scade in '+Math.ceil(diff)+'g' };
  return { status:'ok', days:Math.ceil(diff), label:'OK ('+Math.ceil(diff)+'g)' };
}
