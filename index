    return {car, totalMs:s.reduce((a,x)=>a+(parseTime(x.time)||0),0), stages:s.length, kmSS:s.reduce((a,x)=>a+(+x.km||0),0)};
  }).filter(e=>e.totalMs>0).sort((a,b)=>a.totalMs-b.totalMs);
  carTimes2.forEach((e,i)=>{
    const gap=i===0?'—':'+'+msToTime(e.totalMs-carTimes2[0].totalMs);
    html+='<tr><td>'+(i+1)+'</td><td>'+e.car.name+'</td><td>'+msToTime(e.totalMs)+'</td><td>'+gap+'</td><td>'+e.stages+'</td><td>'+e.kmSS.toFixed(1)+'km</td><td>'+(e.car.retired?'RITIRATA':'In gara')+'</td></tr>';
  });
  html += '</table>';

  // PS detail
  html += '<h2>LOG PROVE SPECIALI</h2>';
  html += '<table><tr><th>PS</th><th>NOME</th><th>VETTURA</th><th>KM SS</th><th>KM TF</th><th>TEMPO</th><th>POS ASS</th><th>POS CLS</th><th>CONS SS</th><th>FONDO</th></tr>';
  stages.forEach(s=>{
    html+='<tr><td>PS'+s.num+'</td><td>'+s.name+'</td><td>'+s.car+'</td><td>'+s.km+'</td><td>'+s.tfKm+'</td><td>'+s.time+'</td><td>'+s.absPos+'</td><td>'+s.clsPos+'</td><td>'+s.fuelSS+'L</td><td>'+s.surface+'</td></tr>';
  });
  html += '</table>';

  // Meteo notes
  if(METEO_STATE.notes.length) {
    html+='<h2>NOTE STRATEGIA METEO</h2><table><tr><th>ORA</th><th>EVENTO</th><th>NOTA</th></tr>';
    METEO_STATE.notes.forEach(n=>{ html+='<tr><td>'+n.time+'</td><td>'+n.label+'</td><td>'+n.text+'</td></tr>'; });
    html+='</table>';
  }

  html += '<div class="footer">Race Engineer Pro — '+now+'</div>';
  const w = window.open('','_blank');
  if(w) { w.document.write(html); w.document.close(); setTimeout(()=>w.print(),500); }
  showToast('📄 Roadbook PDF aperto — usa Stampa (Ctrl+P) per salvare come PDF');
}

