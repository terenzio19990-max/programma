      if(!snap){
        try { snap = JSON.parse(localStorage.getItem(SESSION_AUTOSAVE_KEY)||'null'); } catch(_){}
      }
      if(snap && snap.savedAt) {
        const age = (Date.now() - new Date(snap.savedAt)) / 1000 / 60; // minutes
