  if(window.Plotly) Plotly.newPlot('compare-lapchart', traces, layout, {responsive:true,displayModeBar:false});

  // Stats comparison
  const statsEl = document.getElementById('compare-stats');
  const bestA = lapsA.length ? Math.min(...lapsA.map(l=>parseTime(l.time)||Infinity).filter(t=>t!==Infinity)) : Infinity;
  const bestB = lapsB.length ? Math.min(...lapsB.map(l=>parseTime(l.time)||Infinity).filter(t=>t!==Infinity)) : Infinity;
  const avgA = lapsA.length ? lapsA.reduce((a,l)=>a+(parseTime(l.time)||0),0)/lapsA.length/1000 : 0;
  const avgB = lapsB.length ? lapsB.reduce((a,l)=>a+(parseTime(l.time)||0),0)/lapsB.length/1000 : 0;
  const diff = bestA!==Infinity&&bestB!==Infinity ? ((bestB-bestA)/1000).toFixed(3) : '—';
  const diffColor = parseFloat(diff)<0?'var(--green)':parseFloat(diff)>0?'var(--red)':'var(--text3)';

  if(statsEl) statsEl.innerHTML =
    '<div class="g2" style="gap:8px;">'+
    '<div class="tile tile-good"><div class="tile-label">BEST A</div><div class="tile-value" style="font-size:14px;">'+(bestA!==Infinity?msToTime(bestA):'—')+'</div><div class="tile-sub">'+carA.name+'</div></div>'+
    '<div class="tile"><div class="tile-label">BEST B</div><div class="tile-value" style="font-size:14px;">'+(bestB!==Infinity?msToTime(bestB):'—')+'</div><div class="tile-sub">'+carB.name+'</div></div>'+
    '<div class="tile tile-accent"><div class="tile-label">DELTA BEST (B-A)</div><div class="tile-value" style="color:'+diffColor+';">'+diff+'s</div></div>'+
    '<div class="tile"><div class="tile-label">MEDIA A vs B</div><div class="tile-value" style="font-size:14px;">'+(avgA>0?avgA.toFixed(3):'—')+' / '+(avgB>0?avgB.toFixed(3):'—')+'</div></div>'+
    '<div class="tile"><div class="tile-label">GIRI A / B</div><div class="tile-value">'+lapsA.length+' / '+lapsB.length+'</div></div>'+
    '</div>';

  // Setup comparison
  const setupA = (sessA.STATE?.setup?.[carA.id]||[]).slice(-1)[0];
  const setupB = (sessB.STATE?.setup?.[carB.id]||[]).slice(-1)[0];
  const tbody = document.getElementById('compare-setup-tbody');
  if(tbody && (setupA||setupB)) {
    const fields = {wingF:'Ala Ant.',wingR:'Ala Post.',brakeBias:'Bias Freno',engMap:'Mappa',springF:'Molla Ant.',springR:'Molla Post.',bumpF:'Bump Ant.',rebF:'Reb Ant.',fastBumpF:'F.Bump Ant.',fastRebF:'F.Reb Ant.',camberFL:'Camber FL',camberFR:'Camber FR',camberRL:'Camber RL',camberRR:'Camber RR',toeF:'Toe Ant.',toeR:'Toe Post.'};
    tbody.innerHTML = Object.entries(fields).map(([k,label])=>{
      const va=(setupA?.[k]||'—'), vb=(setupB?.[k]||'—');
      const diff2=va!=='—'&&vb!=='—'&&va!==vb?'⚠️ DIVERSO':'—';
      const rowColor = diff2==='—'?'':'background:rgba(232,66,26,0.08);';
      return '<tr style="'+rowColor+'"><td>'+label+'</td><td class="mono">'+va+'</td><td class="mono">'+vb+'</td><td style="color:'+(diff2!=='—'?'var(--yellow)':'var(--text3)')+';">'+diff2+'</td></tr>';
    }).join('');
  } else if(tbody) { tbody.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--text3);">Nessun setup salvato</td></tr>'; }

  showToast('✅ Confronto completato');
}



