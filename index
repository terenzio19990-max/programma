// Compute best sectors (returns {s1:{ms,lap}, s2:{...}, s3:{...}, theorMs})
function getBestSectors(carId) {
  const laps = STATE.laps[carId]||[];
  const out = { s1:null, s2:null, s3:null };
  laps.forEach(l => {
    ['s1','s2','s3'].forEach(k => {
      const ms = parseTime(l[k]);
      if(ms && (!out[k] || ms < out[k].ms)) out[k] = { ms, lap: l.lap, time: l[k] };
    });
  });
  const theorMs = (out.s1 && out.s2 && out.s3) ? (out.s1.ms + out.s2.ms + out.s3.ms) : null;
  return { s1: out.s1, s2: out.s2, s3: out.s3, theorMs };
}

// Format a sector value nicely — sectors are usually under a minute, so ss.mmm style
function fmtSector(ms) {
  if(!ms) return '—';
  if(ms >= 60000) return msToTime(ms);
  const s = Math.floor(ms/1000);
  const mm = ms % 1000;
  return s + '.' + String(mm).padStart(3,'0');
}

function buildLapsTable(carId) {
  const tbody = document.getElementById('laps-tbody');
  if(!tbody) return;
  // Perf guard: skip rebuild if the table isn't currently visible (page not active).
  // Data still in STATE; will rebuild when user navigates here via showPage.
  // Bypassed when window.__FORCE_REBUILD is true (e.g. after JSON restore).
  if(!tbody.offsetParent && !window.__FORCE_REBUILD) return;
  // Refresh autocomplete datalist for lap notes when table updates
  if(typeof _refreshLapNotesHistory === 'function') _refreshLapNotesHistory();
  const laps = STATE.laps[carId]||[];
  const bestMs = getBestLapMs(carId);
  const target = document.getElementById('target-time').value;
  const targetMs = parseTime(target);

  // Best sectors
  const bs = getBestSectors(carId);
  const bestS1ms = bs.s1 ? bs.s1.ms : null;
  const bestS2ms = bs.s2 ? bs.s2.ms : null;
  const bestS3ms = bs.s3 ? bs.s3.ms : null;

  // Max speed analysis
  let bestVmax = null, bestVmaxLap = null;
  let vmaxSum = 0, vmaxCount = 0;
  laps.forEach(l => {
    const v = +l.vmax;
    if(v && isFinite(v) && v>0) {
      vmaxSum += v; vmaxCount++;
      if(bestVmax===null || v>bestVmax) { bestVmax = v; bestVmaxLap = l.lap; }
    }
  });
  const avgVmax = vmaxCount ? (vmaxSum/vmaxCount) : null;

  tbody.innerHTML = laps.map((l,i) => {
    const lms = parseTime(l.time);
    const dBest = lms&&bestMs ? deltaStr(lms-bestMs) : '—';
    const dTarget = lms&&targetMs ? deltaStr(lms-targetMs) : '—';
    const isBest = lms===bestMs;
    const s1ms = parseTime(l.s1), s2ms = parseTime(l.s2), s3ms = parseTime(l.s3);
    const s1Best = s1ms && bestS1ms && s1ms===bestS1ms;
    const s2Best = s2ms && bestS2ms && s2ms===bestS2ms;
    const s3Best = s3ms && bestS3ms && s3ms===bestS3ms;
    const vmaxVal = (+l.vmax) || null;
    const isBestV = vmaxVal && bestVmax && vmaxVal===bestVmax;
    const sectStyle = (isBestSec) => isBestSec ? 'color:var(--green);font-weight:700;background:rgba(44,188,110,0.14);' : '';
    const vmaxStyle = isBestV ? 'color:var(--accent3);font-weight:700;background:rgba(255,160,64,0.14);' : '';
    return `<tr class="${isBest?'best':''}">
      <td class="mono">${l.lap}</td>
      <td class="mono" style="color:${isBest?'var(--green)':'var(--text1)'};${isBest?'font-weight:700;':''}">${l.time}</td>
      <td class="mono" style="${sectStyle(s1Best)}">${l.s1||'—'}${s1Best?' 🟢':''}</td>
      <td class="mono" style="${sectStyle(s2Best)}">${l.s2||'—'}${s2Best?' 🟢':''}</td>
      <td class="mono" style="${sectStyle(s3Best)}">${l.s3||'—'}${s3Best?' 🟢':''}</td>
      <td class="mono ${lms&&bestMs&&lms===bestMs?'delta-zero':lms&&bestMs&&lms>bestMs?'delta-neg':'delta-pos'}">${dBest}</td>
      <td class="mono ${lms&&targetMs&&lms<=targetMs?'delta-pos':'delta-neg'}">${dTarget}</td>
      <td>${l.pos||'—'}</td>
      <td class="mono" style="${vmaxStyle}">${vmaxVal?vmaxVal+' km/h'+(isBestV?' 🚀':''):'—'}</td>
      <td style="font-size:11px;color:var(--text2)">${esc(l.note||'')}</td>
      <td><button onclick="deleteLapAt(${i})" title="Elimina giro" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;padding:0 4px;">🗑</button></td>
    </tr>`;
  }).join('');

  document.getElementById('target-disp').textContent = target||'—';
  document.getElementById('delta-target-disp').textContent = laps.length&&targetMs ? deltaStr(parseTime(laps[laps.length-1].time)-targetMs):'—';

  // VMAX tiles
  const vmaxEl = document.getElementById('best-vmax-disp');
  const vmaxLapEl = document.getElementById('best-vmax-lap');
  const avgVmaxEl = document.getElementById('avg-vmax-disp');
  if(vmaxEl)    vmaxEl.textContent = bestVmax ? (bestVmax + ' km/h') : '—';
  if(vmaxLapEl) vmaxLapEl.textContent = bestVmaxLap ? ('G'+bestVmaxLap) : '—';
  if(avgVmaxEl) avgVmaxEl.textContent = avgVmax ? (avgVmax.toFixed(1)+' km/h') : '—';

  // Update best sector tiles and theoretical lap
  const setSecDisp = (id, lapId, sec) => {
    const el = document.getElementById(id);
    const lapEl = document.getElementById(lapId);
    if(el)    el.textContent = sec ? fmtSector(sec.ms) : '—';
    if(lapEl) lapEl.textContent = sec ? ('G'+sec.lap) : '—';
  };
  setSecDisp('best-s1-disp','best-s1-lap', bs.s1);
  setSecDisp('best-s2-disp','best-s2-lap', bs.s2);
  setSecDisp('best-s3-disp','best-s3-lap', bs.s3);

  const theorEl  = document.getElementById('theor-lap-disp');
  const theorVs  = document.getElementById('theor-vs-best');
  if(theorEl) theorEl.textContent = bs.theorMs ? msToTime(bs.theorMs) : '—';
  if(theorVs) {
    if(bs.theorMs && bestMs) {
      const d = bs.theorMs - bestMs; // negative = gain
      const sign = d<0 ? '-' : (d>0?'+':'±');
      theorVs.textContent = 'vs best: ' + sign + (Math.abs(d)/1000).toFixed(3) + 's';
      theorVs.style.color = d<0 ? 'var(--green)' : 'var(--text3)';
    } else if(!bs.theorMs) {
      theorVs.textContent = 'inserisci S1+S2+S3';
      theorVs.style.color = 'var(--text3)';
    } else {
      theorVs.textContent = '—';
      theorVs.style.color = 'var(--text3)';
    }
  }
}

function addLap() {
