var _competitors = [];

// Refresh datalist and category dropdowns based on current data
function _compRefreshCategoryLists(){
  var cats = new Set();
  _competitors.forEach(function(c){ if(c.cls && c.cls.trim()) cats.add(c.cls.trim()); });
  // Also add categories of own cars
  STATE.trackCars.concat(STATE.rallyCars).forEach(function(c){
    if(c.category && c.category.trim()) cats.add(c.category.trim());
  });
  var arr = Array.from(cats).sort();
  // datalist for free-typed input
  var dl = document.getElementById('comp-class-list');
  if(dl) dl.innerHTML = arr.map(function(c){return '<option value="'+c+'">';}).join('');
  // Filter dropdown
  var fsel = document.getElementById('comp-filter-cat');
  if(fsel){
    var prev = fsel.value;
    fsel.innerHTML = '<option value="">Tutte le categorie</option>'+arr.map(function(c){return '<option value="'+c+'">'+c+'</option>';}).join('');
    if(prev && arr.indexOf(prev)>=0) fsel.value = prev;
  }
  // "Associa a mia categoria" dropdown
  var mysel = document.getElementById('comp-my-cat');
  if(mysel){
    var ownCats = new Set();
    STATE.trackCars.concat(STATE.rallyCars).forEach(function(c){
      if(c.category && c.category.trim()) ownCats.add(c.category.trim());
    });
    mysel.innerHTML = '<option value="">— nessun match automatico —</option>'+
      Array.from(ownCats).sort().map(function(c){return '<option value="'+c+'">'+c+'</option>';}).join('');
  }
  // Gap-car dropdown
  var gsel = document.getElementById('comp-gap-car');
  if(gsel){
    var prev = gsel.value;
    var ownCars = STATE.trackCars.concat(STATE.rallyCars);
    gsel.innerHTML = '<option value="">— tua vettura corrente —</option>'+ownCars.map(function(c){return '<option value="'+c.id+'">'+c.name+' ['+(c.category||c.type||'—')+']</option>';}).join('');
    if(prev) gsel.value = prev;
  }
}

function addCompetitor() {
  var name = (document.getElementById('comp-name')||{}).value;
  if(!name||!name.trim()) return;
  var cls = (document.getElementById('comp-class')||{}).value||'';
  var myCat = (document.getElementById('comp-my-cat')||{}).value||'';
  // If "Associa a tue vetture" has been selected, override/fill category
  if(myCat) cls = myCat;
  var color = (document.getElementById('comp-color')||{}).value||'#8b5cf6';
  _competitors.push({id:Date.now()+Math.floor(Math.random()*1000),name:name.trim(),cls:cls.trim(),color:color,laps:[]});
  if(document.getElementById('comp-name')) document.getElementById('comp-name').value='';
  if(document.getElementById('comp-class')) document.getElementById('comp-class').value='';
  if(document.getElementById('comp-my-cat')) document.getElementById('comp-my-cat').value='';
  _compRefreshCategoryLists();
  renderCompetitorsList();
  updateCompGaps();
  renderCategoryRanking();
  if(typeof triggerAutoSave==='function') triggerAutoSave();
  // Broadcast to coop peers
  if(typeof coopBroadcastPatch === 'function' && typeof COOP !== 'undefined' && COOP.status !== 'disconnected' && !COOP.applyingRemote){
    coopBroadcastPatch('_competitors', 'set', _competitors, 'ha aggiunto avversario '+name.trim());
  }
}

// Switch single <-> batch add UI
function switchCompAddMode(mode){
  var sgl = document.getElementById('comp-add-single');
  var btc = document.getElementById('comp-add-batch');
  var ts  = document.getElementById('comp-mode-single');
  var tb  = document.getElementById('comp-mode-batch');
  if(!sgl||!btc) return;
  if(mode==='batch'){
    sgl.style.display='none'; btc.style.display='';
    if(ts) ts.classList.remove('active'); if(tb) tb.classList.add('active');
    // Populate batch-my-cat from own cars
    var mysel = document.getElementById('batch-my-cat');
    if(mysel){
      var cats = new Set();
      STATE.trackCars.concat(STATE.rallyCars).forEach(function(c){ if(c.category && c.category.trim()) cats.add(c.category.trim()); });
      mysel.innerHTML = '<option value="">— usa il campo Categoria —</option>'+
        Array.from(cats).sort().map(function(c){return '<option value="'+c+'">'+c+'</option>';}).join('');
