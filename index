function tyreStockSync(setName, km, isPS){
  var KEY='REP_tyre_stock_v1', st=null;
  try { st=JSON.parse(localStorage.getItem(KEY)||'null'); } catch(e){}
  if(!st) st={};
  var arr = Array.isArray(st)? st : (st.sets||st.items||null);
  if(!Array.isArray(arr)){ st.sets=arr=[]; }
  var low=setName.toLowerCase();
  var hit=arr.filter(function(x){ return String(x.name||x.code||'').toLowerCase()===low; })[0];
  if(!hit){ hit={ name:setName, code:setName, kmTot:0, kmPS:0, runs:0, auto:true, createdAt:Date.now() }; arr.push(hit); }
  hit.kmTot=+((hit.kmTot||0)+km).toFixed(2);
  if(isPS){ hit.kmPS=+((hit.kmPS||0)+km).toFixed(2); hit.runs=(hit.runs||0)+1; }
  hit.updatedAt=Date.now();
  try { localStorage.setItem(KEY, JSON.stringify(Array.isArray(st)? arr : st)); } catch(e){}
  var lim=(window._REP_TYRE_LIMIT||120);
  if(hit.kmPS>=lim && !hit.warned){ hit.warned=true; toast('🛞 Treno '+setName+': '+hit.kmPS.toFixed(0)+' km in PS — controlla usura'); }
  return hit;
}
