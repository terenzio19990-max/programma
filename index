function mountRallyTyres() {
  const car = STATE.rallyCars[STATE.selectedRallyCar];
  const set = +document.getElementById('rally-new-set-num').value;
  const ps = +document.getElementById('rally-tyre-ps').value;
  const note = document.getElementById('rally-new-tyre-note').value;
  const kmPS = STATE.stages.filter(s=>s.car===car.name).reduce((a,s)=>a+(+s.km||0),0);
  const wheels = {};
  WHEELS.forEach(w=>{
    wheels[w] = {
      compound: document.getElementById(`rl-cpd-${w}`)?.value||'S',
      setName: document.getElementById(`rl-setname-${w}`)?.value||'',
      brand: document.getElementById(`rl-brand-${w}`)?.value||'',
      code: document.getElementById(`rl-code-${w}`)?.value||'',
      pressure: document.getElementById(`rl-pres-${w}`)?.value||2.2,
      temp: document.getElementById(`rl-temp-${w}`)?.value||'',
      wear: 0, damage: 'none'
    };
  });
  const rt = STATE.rallyTyres[car.id] = STATE.rallyTyres[car.id]||{current:null,history:[],spare:{compound:'S',pressure:2.2,wear:0,damage:'none',note:''}};
  // ─── Magazzino gomme: return old set to stock ──────────────
  if(rt.current && typeof _tsReturnMountedToStock === 'function') {
    var prevKm = kmPS - (rt.current.kmAtMount||0);
    var prevLaps = ps - (rt.current.psMounted||1);
    try { _tsReturnMountedToStock(rt.current.wheels, car.id, prevKm, prevLaps); } catch(e){ console.warn('Stock return fail',e); }
  }
  // ─── Magazzino gomme: link newly mounted from stock ────────
  if(typeof _tsTryLinkMount === 'function') {
    WHEELS.forEach(function(w){
      try { _tsTryLinkMount(wheels[w].code, car.id, w); } catch(e){ console.warn('Stock link fail',e); }
    });
  }
  // ────────────────────────────────────────────────────────────
  if(rt.current) {
    rt.current.lapsUsed = ps - (rt.current.psMounted||1);
    rt.current.km = kmPS - (rt.current.kmAtMount||0);
    rt.history.push(rt.current);
  }
  rt.current = { set, wheels, note, psMounted: ps, kmAtMount: kmPS, km: 0, mountedAt: new Date().toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit'}) };
  buildRallyTyresPage();
  triggerAutoSave();
  // Clear stock selection banner if any
  var banner = document.getElementById('rally-mount-selected-set-banner');
  if(banner){ banner.style.display = 'none'; banner.innerHTML = ''; }
  // Broadcast to coop peers
  if(typeof coopBroadcastPatch === 'function' && typeof COOP !== 'undefined' && COOP.status !== 'disconnected' && !COOP.applyingRemote){
    coopBroadcastPatch('STATE.rallyTyres.'+car.id, 'set', STATE.rallyTyres[car.id], 'ha montato gomme PS'+ps+' set '+set+' su '+car.name);
  }
}

