window.showSpareHistory = showSpareHistory;

function renderSpareParts(filter) {
  if(typeof filter !== 'undefined') _spareFilter = filter;
  var list = document.getElementById('spare-parts-list');
  if(!list) return;
  var parts = SPARE_PARTS[_spareMode] || [];
  var filtered = _spareFilter ? parts.filter(function(p){return p.cat===_spareFilter;}) : parts;
  // Refresh suppliers datalist
  _spareRefreshSuppliersList();
  if(!filtered.length) {
    list.innerHTML = '<div style="text-align:center;color:var(--text3);padding:32px;font-size:12px;">Nessun pezzo</div>';
    return;
  }
  var grouped = {};
  filtered.forEach(function(p){ if(!grouped[p.cat]) grouped[p.cat]=[]; grouped[p.cat].push(p); });
  var html = '';
  Object.keys(grouped).forEach(function(cat) {
    html += '<div style="margin-bottom:16px;">';
    html += '<div style="font-family:var(--head);font-size:11px;color:var(--accent2);letter-spacing:3px;margin-bottom:8px;padding-bottom:5px;border-bottom:1px solid var(--border);">'+cat.toUpperCase()+'</div>';
    grouped[cat].forEach(function(p) {
      // Determine stock status: 0 = red, <=min = yellow, > min = green
      var minQ = p.min||0;
      var col = p.qty===0?'var(--red)':(minQ>0&&p.qty<=minQ)?'var(--yellow)':'var(--green)';
      var border = p.qty===0?'var(--red)':(minQ>0&&p.qty<=minQ)?'var(--yellow)':'var(--border)';
      // Stock alert badge
      var statusBadge = '';
      if(p.qty === 0) statusBadge = '<span style="background:var(--red);color:#fff;padding:1px 6px;border-radius:3px;font-size:9px;letter-spacing:1px;font-weight:700;">ESAURITO</span>';
      else if(minQ > 0 && p.qty <= minQ) statusBadge = '<span style="background:var(--yellow);color:#000;padding:1px 6px;border-radius:3px;font-size:9px;letter-spacing:1px;font-weight:700;">SCORTA BASSA</span>';
      // Cost / supplier mini info
      var costLine = '';
      if(p.cost) costLine += '€'+(+p.cost).toFixed(2)+'/cad ';
      if(p.cost && p.qty) costLine += '<span style="color:var(--text3);">(tot €'+(p.cost*p.qty).toFixed(2)+')</span>';
      var supLine = p.supplier ? '🏢 '+p.supplier+(p.lead?' · ⏱ '+p.lead+'gg':'') : '';

      html += '<div style="display:flex;align-items:center;gap:8px;padding:9px 12px;background:var(--bg3);border:1px solid '+border+';border-radius:5px;margin-bottom:6px;flex-wrap:wrap;">';
      html += '<div style="flex:1;min-width:200px;">';
      html += '<div style="font-size:13px;color:var(--text1);font-weight:600;">'+p.name+' '+statusBadge+'</div>';
      if(p.note) html += '<div style="font-size:11px;color:var(--text3);margin-top:2px;">'+p.note+'</div>';
      if(costLine) html += '<div style="font-size:10px;color:var(--text2);margin-top:2px;">'+costLine+'</div>';
      if(supLine) html += '<div style="font-size:10px;color:var(--text3);margin-top:2px;">'+supLine+'</div>';
      html += '</div>';
      html += '<div style="text-align:center;min-width:48px;"><div style="font-family:var(--mono);font-size:20px;font-weight:700;color:'+col+'">&times;'+p.qty+'</div>';
      if(p.used) html += '<div style="font-size:10px;color:var(--text3);">usati:'+p.used+'</div>';
      if(minQ) html += '<div style="font-size:9px;color:var(--text3);">min:'+minQ+'</div>';
      html += '</div>';
      html += '<div style="display:flex;flex-direction:column;gap:4px;">';
      html += '<button onclick="useSparePartWithReason('+p.id+')" class="btn btn-gray" style="padding:3px 10px;font-size:12px;" '+(p.qty===0?'disabled':'')+' title="Consuma 1 con motivo">&#8722; USA</button>';
      html += '<button onclick="addSpareQty('+p.id+',1)" class="btn btn-green" style="padding:3px 10px;font-size:12px;">+ 1</button>';
      html += '</div>';
      html += '<button onclick="showSpareHistory('+p.id+')" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;padding:4px;" title="Cronologia movimenti">📜</button>';
      html += '<button onclick="removeSparePart('+p.id+')" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:16px;padding:4px;" title="Rimuovi">&#10005;</button>';
      html += '</div>';
    });
    html += '</div>';
  });
  list.innerHTML = html;
}
function filterSpareParts(cat, btn) {
  document.querySelectorAll('.spare-filter-btn').forEach(function(b){b.classList.remove('active');});
  if(btn) btn.classList.add('active');
  renderSpareParts(cat);
}

