function mountTyres() {
  const car = STATE.trackCars[STATE.selectedTrackCar];
  const set = +document.getElementById('new-set-num').value;
  const note = document.getElementById('new-tyre-note').value;
  const lapsNow = (STATE.laps[car.id]||[]).length;
  const kmNow = lapsNow * (CIRCUITS[STATE.circuit]?.km||0);
  const wheels = {};
  WHEELS.forEach(w=>{
    wheels[w] = {
      compound: document.getElementById(`tr-cpd-${w}`)?.value||'S',
      setName: document.getElementById(`tr-setname-${w}`)?.value||'',
      brand: document.getElementById(`tr-brand-${w}`)?.value||'',
      code: document.getElementById(`tr-code-${w}`)?.value||'',
      pressure: document.getElementById(`tr-pres-${w}`)?.value||2.0,
      temp: document.getElementById(`tr-temp-${w}`)?.value||'',
      wear: 0, damage: 'none'
    };
  });
  // ─── Magazzino gomme: return old set to stock ──────────────
  if(STATE.tyres[car.id].current && typeof _tsReturnMountedToStock === 'function') {
    var prev = STATE.tyres[car.id].current;
    var prevKm = kmNow - (prev.kmAtMount||0);
    var prevLaps = lapsNow - (prev.lapsMounted||0);
    try { _tsReturnMountedToStock(prev.wheels, car.id, prevKm, prevLaps); } catch(e){ console.warn('Stock return fail',e); }
  }
  // ─── Magazzino gomme: link newly mounted from stock ────────
  if(typeof _tsTryLinkMount === 'function') {
    WHEELS.forEach(function(w){
      try { _tsTryLinkMount(wheels[w].code, car.id, w); } catch(e){ console.warn('Stock link fail',e); }
    });
  }
  // ────────────────────────────────────────────────────────────
  const current = { set, wheels, note, lapsMounted: lapsNow, kmAtMount: kmNow, km: 0, mountedAt: new Date().toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit'}) };
  if(STATE.tyres[car.id].current) {
    const old = STATE.tyres[car.id].current;
    old.lapsUsed = lapsNow - old.lapsMounted;
    old.km = kmNow - old.kmAtMount;
    STATE.tyres[car.id].history.push(old);
  }
  STATE.tyres[car.id].current = current;
  buildTyresPage();
  triggerAutoSave();
  // Clear stock selection banner if any
  var banner = document.getElementById('mount-selected-set-banner');
  if(banner){ banner.style.display = 'none'; banner.innerHTML = ''; }
  // Broadcast to coop peers
  if(typeof coopBroadcastPatch === 'function' && typeof COOP !== 'undefined' && COOP.status !== 'disconnected' && !COOP.applyingRemote){
    coopBroadcastPatch('STATE.tyres.'+car.id, 'set', STATE.tyres[car.id], 'ha montato gomme set '+set+' su '+car.name);
  }
}

