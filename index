// ═══════════════════════════════════════════════════════════════
// TYRE STOCK (MAGAZZINO GOMME) — Global tyre inventory system
// ═══════════════════════════════════════════════════════════════
var TS_STORAGE_KEY = 'REP_tyre_stock_v1';
var TYRE_STOCK = []; // array of individual tyres {id, position, compound, brand, code, set, status, car, km, laps, wear, damage, notes, history, addedAt, lastMountedAt, dismissedAt}
var _tsViewMode = 'list'; // list | grid

function tsLoad(){
  try {
    var raw = localStorage.getItem(TS_STORAGE_KEY);
    if(raw){
      var data = JSON.parse(raw);
      if(Array.isArray(data)) TYRE_STOCK = data;
    }
  } catch(e){ console.warn('TS load fail', e); TYRE_STOCK = []; }
}
function tsSave(){
  try { localStorage.setItem(TS_STORAGE_KEY, JSON.stringify(TYRE_STOCK)); } catch(e){ console.warn('TS save fail', e); }
}
function _tsNewId(){ return 'tyr_' + Date.now() + '_' + Math.floor(Math.random()*10000); }

function buildTyreStockPage(){
  tsLoad();
  _tsBuildFilters();
  tsRenderSummary();
  tsRenderList();
}

function _tsBuildFilters(){
  // Populate compound filter
  var cpdSel = document.getElementById('ts-filter-cpd');
  if(cpdSel){
    var currentVal = cpdSel.value;
    var compounds = new Set();
    TYRE_STOCK.forEach(function(t){ if(t.compound) compounds.add(t.compound); });
    cpdSel.innerHTML = '<option value="">Tutte</option>' + Array.from(compounds).sort().map(function(c){
      return '<option value="'+c+'">'+c+'</option>';
    }).join('');
    cpdSel.value = currentVal;
  }
  // Populate car filter
  var carSel = document.getElementById('ts-filter-car');
  if(carSel){
    var currentVal = carSel.value;
    var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
    carSel.innerHTML = '<option value="">Tutte</option>' + allCars.map(function(c){
      return '<option value="'+c.id+'">'+c.name+'</option>';
    }).join('');
    carSel.value = currentVal;
  }
}

function tsClearFilters(){
  ['ts-filter-q','ts-filter-wear'].forEach(function(id){
    var el = document.getElementById(id); if(el) el.value = '';
  });
  ['ts-filter-status','ts-filter-cpd','ts-filter-car'].forEach(function(id){
    var el = document.getElementById(id); if(el) el.value = '';
  });
  tsRenderList();
}

function tsRenderSummary(){
  var el = document.getElementById('ts-summary-tiles');
  if(!el) return;
  var totals = { total:0, new:0, used:0, mounted:0, dismissed:0, sets:{} };
  TYRE_STOCK.forEach(function(t){
    totals.total++;
    totals[t.status || 'new']++;
    if(t.set) totals.sets[t.set] = (totals.sets[t.set]||0) + 1;
  });
  var completeSets = Object.values(totals.sets).filter(function(v){return v>=4;}).length;
  el.innerHTML =
    '<div class="st-tile"><div class="tl">TOTALE</div><div class="tv">'+totals.total+'</div></div>'+
    '<div class="st-tile" style="border-left:3px solid var(--blue);"><div class="tl">🆕 NUOVE</div><div class="tv" style="color:var(--blue);">'+totals.new+'</div></div>'+
    '<div class="st-tile" style="border-left:3px solid var(--yellow);"><div class="tl">↻ USATE</div><div class="tv" style="color:var(--yellow);">'+totals.used+'</div></div>'+
    '<div class="st-tile" style="border-left:3px solid var(--green);"><div class="tl">🔧 MONTATE</div><div class="tv" style="color:var(--green);">'+totals.mounted+'</div></div>'+
    '<div class="st-tile" style="border-left:3px solid var(--red);"><div class="tl">✕ DISMESSE</div><div class="tv" style="color:var(--red);">'+totals.dismissed+'</div></div>'+
    '<div class="st-tile" style="border-left:3px solid var(--accent3);"><div class="tl">📦 SET COMPLETI</div><div class="tv" style="color:var(--accent3);">'+completeSets+'</div></div>';
}

function tsRenderList(){
  var container = document.getElementById('ts-list');
  if(!container) return;
  // Filters
  var q = (document.getElementById('ts-filter-q')?.value||'').toLowerCase().trim();
  var fStatus = document.getElementById('ts-filter-status')?.value||'';
  var fCpd = document.getElementById('ts-filter-cpd')?.value||'';
  var fCar = document.getElementById('ts-filter-car')?.value||'';
  var fWear = +document.getElementById('ts-filter-wear')?.value||0;
  var sortBy = document.getElementById('ts-sort')?.value||'added-desc';

  var filtered = TYRE_STOCK.filter(function(t){
    if(fStatus && (t.status||'new') !== fStatus) return false;
    if(fCpd && t.compound !== fCpd) return false;
    if(fCar && t.car !== fCar) return false;
    if(fWear>0 && (t.wear||0) > fWear) return false;
    if(q){
      var hay = [t.code,t.brand,t.set,t.notes,t.position,t.compound].join(' ').toLowerCase();
      if(hay.indexOf(q) < 0) return false;
    }
    return true;
  });
  // Sort
  filtered.sort(function(a,b){
    switch(sortBy){
      case 'added-asc': return (a.addedAt||0) - (b.addedAt||0);
      case 'wear-asc':  return (a.wear||0) - (b.wear||0);
      case 'wear-desc': return (b.wear||0) - (a.wear||0);
      case 'km-asc':    return (a.km||0) - (b.km||0);
      case 'km-desc':   return (b.km||0) - (a.km||0);
      case 'set':       return (a.set||'').localeCompare(b.set||'');
      case 'status':    return (a.status||'').localeCompare(b.status||'');
      case 'added-desc':
      default:          return (b.addedAt||0) - (a.addedAt||0);
    }
  });

  // Title
  var titleEl = document.getElementById('ts-list-title');
  if(titleEl) titleEl.textContent = '📋 ELENCO GOMME — '+filtered.length+' di '+TYRE_STOCK.length;

  if(!filtered.length){
    container.innerHTML = '<div style="padding:30px;text-align:center;color:var(--text3);font-size:12px;">'+(TYRE_STOCK.length===0?'Magazzino vuoto. Clicca <b>+ SINGOLA GOMMA</b> o <b>+ SET DI 4</b> per iniziare.':'Nessuna gomma corrisponde ai filtri.')+'</div>';
    return;
  }

  var isGrid = _tsViewMode === 'grid';
  container.className = isGrid ? 'ts-grid-view' : '';
  container.innerHTML = filtered.map(_tsRenderCard).join('');
}

function _tsRenderCard(t){
  var status = t.status || 'new';
  var statusLabels = { new:'NUOVA', used:'USATA', mounted:'MONTATA', dismissed:'DISMESSA' };
  var statusIcon = { new:'🆕', used:'↻', mounted:'🔧', dismissed:'✕' };
  var carName = '';
  if(t.car){
    var car = [].concat(STATE.trackCars||[], STATE.rallyCars||[]).find(function(c){return c.id===t.car;});
    carName = car ? car.name : '(rimossa)';
  }
  var wear = t.wear || 0;
  var wearColor = wear<40 ? 'var(--green)' : wear<70 ? 'var(--yellow)' : 'var(--red)';
  var dmgBadge = '';
  if(t.damage && t.damage !== 'none' && t.damage !== '') dmgBadge = '<span style="background:var(--red);color:#fff;padding:1px 5px;border-radius:2px;font-size:9px;margin-left:4px;font-weight:700;">⚠ '+t.damage.toUpperCase()+'</span>';

  var isGrid = _tsViewMode === 'grid';

  if(isGrid){
    // Compact card for grid view
    return '<div class="ts-card '+status+'" onclick="tsEditTyre(\''+t.id+'\')" style="cursor:pointer;">'+
      '<div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;">'+
        '<span style="font-family:var(--head);font-size:13px;font-weight:700;color:var(--text1);">'+(t.code||'(senza codice)')+'</span>'+
        '<span class="ts-status-badge ts-status-'+status+'">'+statusIcon[status]+' '+statusLabels[status]+'</span>'+
      '</div>'+
      '<div style="font-size:10px;color:var(--text3);margin-bottom:4px;">'+
        (t.compound?'<b style="color:var(--accent3);">'+t.compound+'</b>':'')+
        (t.brand?' · '+t.brand:'')+
        (t.set?' · Set '+t.set:'')+
        (t.position?' · '+t.position:'')+
      '</div>'+
      (wear>0 ? '<div class="ts-wear-bar"><div class="ts-wear-fill" style="width:'+wear+'%;background:'+wearColor+';"></div></div>' : '')+
      '<div style="font-size:10px;color:var(--text3);display:flex;justify-content:space-between;">'+
        '<span>Usura: <b style="color:'+wearColor+';">'+wear+'%</b></span>'+
        '<span>Km: <b>'+((t.km||0).toFixed(1))+'</b></span>'+
      '</div>'+
      (carName ? '<div style="font-size:10px;color:var(--text2);margin-top:3px;">🚗 '+carName+'</div>' : '')+
      (dmgBadge || '')+
    '</div>';
  }

  // Full list view
  return '<div class="ts-card '+status+'">'+
    '<div style="display:grid;grid-template-columns:80px 1fr 1fr 1fr 90px 80px 80px auto;gap:8px;align-items:center;">'+
      '<div><span class="ts-status-badge ts-status-'+status+'" style="display:block;text-align:center;">'+statusIcon[status]+'</span>'+
        '<div style="font-size:9px;color:var(--text3);text-align:center;margin-top:3px;">'+statusLabels[status]+'</div>'+
      '</div>'+
      '<div>'+
        '<div style="font-family:var(--mono);font-size:13px;color:var(--text1);font-weight:700;">'+(t.code||'(no codice)')+' '+dmgBadge+'</div>'+
        '<div style="font-size:10px;color:var(--text3);margin-top:2px;">'+
          (t.brand?'<b>'+t.brand+'</b>':'(senza marca)')+
          (t.set?' · Set '+t.set:'')+
          (t.position?' · '+t.position:'')+
        '</div>'+
      '</div>'+
      '<div style="font-size:11px;color:var(--text2);">'+
        (t.compound?'<span style="background:var(--accent);color:#fff;padding:2px 6px;border-radius:3px;font-size:10px;font-weight:700;">'+t.compound+'</span>':'—')+
      '</div>'+
      '<div style="font-size:10px;color:var(--text3);">'+(carName ? '🚗 '+carName : '—')+'</div>'+
      '<div>'+
        '<div class="ts-wear-bar"><div class="ts-wear-fill" style="width:'+wear+'%;background:'+wearColor+';"></div></div>'+
        '<div style="font-size:10px;text-align:right;color:'+wearColor+';font-weight:700;">'+wear+'%</div>'+
      '</div>'+
      '<div style="font-family:var(--mono);font-size:11px;text-align:right;"><b>'+((t.km||0).toFixed(1))+'</b> km</div>'+
      '<div style="font-family:var(--mono);font-size:11px;text-align:right;color:var(--text3);">'+(t.laps||0)+' giri</div>'+
      '<div style="display:flex;gap:4px;">'+
        '<button class="btn btn-gray" style="padding:4px 8px;font-size:10px;" onclick="tsEditTyre(\''+t.id+'\')" title="Modifica">✏️</button>'+
        '<button class="btn btn-gray" style="padding:4px 8px;font-size:10px;" onclick="tsRemoveTyre(\''+t.id+'\')" title="Rimuovi">🗑</button>'+
      '</div>'+
    '</div>'+
    (t.notes ? '<div style="font-size:10px;color:var(--text3);margin-top:6px;padding:4px 8px;background:var(--bg0);border-radius:3px;font-style:italic;">💬 '+t.notes+'</div>' : '')+
  '</div>';
}

function tsToggleView(){
  _tsViewMode = _tsViewMode === 'list' ? 'grid' : 'list';
  var btn = document.getElementById('ts-view-btn');
  if(btn) btn.textContent = _tsViewMode === 'list' ? '⊞ GRID' : '☰ LISTA';
  tsRenderList();
}

function tsAddTyre(prefill){
  tsLoad();
  var t = Object.assign({
    id: _tsNewId(),
    code: '',
    brand: '',
    compound: 'S',
    set: '',
    position: '',
    status: 'new',
    car: '',
    km: 0,
    laps: 0,
    wear: 0,
    damage: 'none',
    notes: '',
    history: [],
    addedAt: Date.now(),
    lastMountedAt: null,
    dismissedAt: null
  }, prefill||{});
  TYRE_STOCK.push(t);
  tsSave();
  tsEditTyre(t.id);
}

function tsAddSet(){
  var setName = prompt('Nome del nuovo set (es. "Set A", "Set Gara 1"):');
  if(!setName) return;
  var cpd = prompt('Mescola (S, M, H, SS, W, ecc.):', 'S');
  if(cpd === null) return;
  var brand = prompt('Marchio (opzionale):', '');
  if(brand === null) return;
  var baseCode = prompt('Prefisso codice DOT (opzionale, verrà aggiunto -FL/FR/RL/RR):', '');
  if(baseCode === null) return;
  tsLoad();
  ['FL','FR','RL','RR'].forEach(function(pos){
    TYRE_STOCK.push({
      id: _tsNewId(),
      code: baseCode ? baseCode+'-'+pos : '',
      brand: brand,
      compound: cpd,
      set: setName,
      position: pos,
      status: 'new',
      car: '', km: 0, laps: 0, wear: 0, damage: 'none',
      notes: '', history: [],
      addedAt: Date.now(),
      lastMountedAt: null,
      dismissedAt: null
    });
  });
  tsSave();
  buildTyreStockPage();
  showToast('✓ Set "'+setName+'" aggiunto (4 gomme)');
}

function tsRemoveTyre(id){
  var t = TYRE_STOCK.find(function(x){return x.id===id;});
  if(!t) return;
  if(t.status === 'mounted'){
    alert('Non puoi rimuovere una gomma attualmente montata. Smontala prima dalla vettura.');
    return;
  }
  if(!confirm('Rimuovere definitivamente '+(t.code||'questa gomma')+' dal magazzino?')) return;
  TYRE_STOCK = TYRE_STOCK.filter(function(x){return x.id!==id;});
  tsSave();
  buildTyreStockPage();
}

