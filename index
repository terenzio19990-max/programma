// ─── Helpers used by all tabs ───────────────────────────────────
// Returns the full set of cars to consider based on the mode filter
function _statsCarsList(){
  var f = document.getElementById('stats-mode-filter')?.value || 'auto';
  var mode = STATE.mode;
  if(f === 'auto') {
    if(mode === 'rally') return STATE.rallyCars||[];
    if(mode === 'track') return STATE.trackCars||[];
    return [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
  }
  if(f === 'track') return STATE.trackCars||[];
  if(f === 'rally') return STATE.rallyCars||[];
  return [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
}

// Period filter: returns earliest acceptable timestamp (ms) or null = all
function _statsCutoffMs(){
  var p = document.getElementById('stats-period')?.value || 'all';
  if(p === 'all') return null;
  return Date.now() - (+p)*86400000;
}

// Format a duration in ms to mm:ss.sss
function _statsFmtMs(ms){
  if(!ms||ms<=0) return '—';
  var min = Math.floor(ms/60000);
  var sec = ((ms%60000)/1000).toFixed(3);
  if(sec.length === 5) sec = '0'+sec;
  return min+':'+sec;
}

// Mini SVG line chart helper (for inline charts)
function _statsMiniLineChart(data, opts){
  opts = opts||{};
  var w = opts.width || 600, h = opts.height || 180;
  var pad = { l: 50, r: 20, t: 20, b: 30 };
  if(!data.length) return '<div style="padding:20px;color:var(--text3);text-align:center;font-size:12px;">Dati insufficienti</div>';
  var values = data.map(function(d){return d.y;}).filter(function(v){return isFinite(v);});
  if(!values.length) return '<div style="padding:20px;color:var(--text3);text-align:center;font-size:12px;">Dati non numerici</div>';
  var min = Math.min.apply(null, values), max = Math.max.apply(null, values);
  if(min === max) { min = min - 1; max = max + 1; }
  var iw = w - pad.l - pad.r, ih = h - pad.t - pad.b;
  function xPos(i){ return pad.l + (data.length<2?iw/2:(i/(data.length-1))*iw); }
  function yPos(v){ return pad.t + (1 - (v-min)/(max-min)) * ih; }
  // Y axis grid (5 lines)
  var grid = '';
  for(var g=0;g<=4;g++){
    var gy = pad.t + (g/4)*ih;
    var val = max - (g/4)*(max-min);
    grid += '<line x1="'+pad.l+'" y1="'+gy+'" x2="'+(w-pad.r)+'" y2="'+gy+'" stroke="var(--border)" stroke-dasharray="2,3" opacity="0.5"/>';
    grid += '<text x="'+(pad.l-6)+'" y="'+(gy+3)+'" text-anchor="end" fill="var(--text3)" font-size="9" font-family="monospace">'+(opts.fmtY?opts.fmtY(val):val.toFixed(1))+'</text>';
  }
  // Line
  var pathD = data.map(function(d,i){return (i===0?'M':'L')+xPos(i)+','+yPos(d.y);}).join(' ');
  // Points
  var pts = data.map(function(d,i){
    return '<circle cx="'+xPos(i)+'" cy="'+yPos(d.y)+'" r="3" fill="var(--accent3)"><title>'+(d.label||'')+': '+(opts.fmtY?opts.fmtY(d.y):d.y)+'</title></circle>';
  }).join('');
  // X axis labels (first, middle, last)
  var xLab = '';
  if(data.length){
    [0, Math.floor((data.length-1)/2), data.length-1].forEach(function(i){
      if(i<data.length && data[i]){
        xLab += '<text x="'+xPos(i)+'" y="'+(h-8)+'" text-anchor="middle" fill="var(--text3)" font-size="9">'+((data[i].label||'')+'').slice(-12)+'</text>';
      }
    });
  }
  return '<svg viewBox="0 0 '+w+' '+h+'" style="width:100%;height:auto;background:var(--bg3);border-radius:4px;">'+
    grid+
    '<path d="'+pathD+'" stroke="var(--accent3)" stroke-width="2" fill="none"/>'+
    pts+xLab+
    '</svg>';
}

// Tile / KPI box helper
function _statsKpi(label, value, sub, color){
  color = color || 'var(--accent3)';
  return '<div style="background:var(--bg3);border-radius:5px;padding:12px 14px;border-left:3px solid '+color+';flex:1;min-width:140px;">'+
    '<div style="font-size:10px;color:var(--text3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:4px;">'+label+'</div>'+
    '<div style="font-family:var(--mono);font-size:22px;font-weight:700;color:'+color+';">'+value+'</div>'+
    (sub?'<div style="font-size:10px;color:var(--text3);margin-top:2px;">'+sub+'</div>':'')+
  '</div>';
}

// ─── 1) EVOLUTION — best lap progression per car/circuit ────────
function _renderStatsEvolution(){
  var cars = _statsCarsList();
  var cutoff = _statsCutoffMs();
  var driverFilter = _selectedDriverFilter('stats-driver-filter');
  if(!cars.length) return '<div style="padding:30px;text-align:center;color:var(--text3);">Nessuna vettura per la modalità selezionata.</div>';
  var out = '';
  // Aggregate stats: total laps, best ever, average, sessions count
  var totalLaps = 0, totalSessions = new Set(), bestEver = Infinity, bestEverWho = '';
  var allTimes = [];
  cars.forEach(function(car){
    var laps = _lapsForCar(car.id, driverFilter);
    laps.forEach(function(l){
      if(cutoff && l.ts && l.ts < cutoff) return;
      var ms = parseTime(l.time);
      if(!ms || !isFinite(ms)) return;
      totalLaps++;
      allTimes.push(ms);
      if(l.session) totalSessions.add(car.id+'_'+l.session);
      if(ms < bestEver){ bestEver = ms; bestEverWho = car.name; }
    });
  });
  var avg = allTimes.length ? allTimes.reduce(function(s,v){return s+v;},0) / allTimes.length : 0;
  var sortedTimes = allTimes.slice().sort(function(a,b){return a-b;});
  var median = sortedTimes.length ? sortedTimes[Math.floor(sortedTimes.length/2)] : 0;

  out += '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;">'+
    _statsKpi('GIRI TOTALI', totalLaps, totalLaps?'In '+totalSessions.size+' sessioni':'', 'var(--blue)')+
    _statsKpi('BEST LAP ASSOLUTO', _statsFmtMs(isFinite(bestEver)?bestEver:0), bestEverWho, 'var(--green)')+
    _statsKpi('TEMPO MEDIO', _statsFmtMs(avg), 'di tutti i giri', 'var(--accent3)')+
    _statsKpi('TEMPO MEDIANO', _statsFmtMs(median), '50° percentile', 'var(--accent3)')+
  '</div>';

  // Per-car best lap evolution (chronological — relies on lap order stored)
  out += '<div class="panel"><div class="panel-head">📈 EVOLUZIONE BEST LAP PER VETTURA</div><div class="panel-body">';
  out += '<div style="font-size:11px;color:var(--text3);margin-bottom:10px;line-height:1.5;">Per ogni vettura, andamento del best lap nel tempo (ordine cronologico delle sessioni). Una linea che scende = stai migliorando.</div>';
  cars.forEach(function(car){
    var laps = _lapsForCar(car.id, driverFilter);
    if(cutoff) laps = laps.filter(function(l){return !l.ts || l.ts >= cutoff;});
    if(laps.length < 2) return;
    // Group by session (consecutive same session = one bucket), keep chronological order via index
    var bySession = {};
    var sessionOrder = [];
    laps.forEach(function(l){
      var key = l.session || 'sess';
      if(!bySession[key]){ bySession[key] = []; sessionOrder.push(key); }
      bySession[key].push(l);
    });
    var pts = sessionOrder.map(function(s){
      var times = bySession[s].map(function(l){return parseTime(l.time);}).filter(function(t){return t&&isFinite(t);});
      if(!times.length) return null;
      return { y: Math.min.apply(null, times)/1000, label: s };
    }).filter(Boolean);
    if(pts.length < 2) return;
    out += '<div style="margin-bottom:18px;">'+
      '<div style="font-family:var(--head);font-size:11px;color:var(--text2);letter-spacing:1.5px;margin-bottom:6px;">'+car.name+' — '+pts.length+' sessioni</div>'+
      _statsMiniLineChart(pts, { fmtY: function(v){return v.toFixed(2)+'s';} })+
    '</div>';
  });
  out += '</div></div>';

  return out;
}

// ─── 2) OPPONENTS — gap and standings vs competitors ────────────
function _renderStatsOpponents(){
  if(typeof _competitors === 'undefined' || !_competitors.length){
    return '<div style="padding:30px;text-align:center;color:var(--text3);">Nessun avversario inserito. Vai su <b>🎯 AVVERSARI</b> per aggiungerli.</div>';
  }
  // For each competitor: their best, average, gap to my best
  var cars = _statsCarsList();
  var driverFilter = _selectedDriverFilter('stats-driver-filter');
  // Compute MY best across all cars
  var myBest = Infinity, myBestCar = '';
  cars.forEach(function(car){
    _lapsForCar(car.id, driverFilter).forEach(function(l){
      var ms = parseTime(l.time);
      if(ms && isFinite(ms) && ms < myBest){ myBest = ms; myBestCar = car.name; }
    });
  });
  var rows = _competitors.map(function(c){
    var times = (c.laps||[]).map(function(t){return parseTime(t);}).filter(function(t){return t&&isFinite(t);});
    var best = times.length ? Math.min.apply(null, times) : null;
    var avg  = times.length ? times.reduce(function(s,v){return s+v;},0)/times.length : null;
    var gap = (best && isFinite(myBest)) ? (best - myBest) : null;
    return { c: c, best: best, avg: avg, gap: gap, count: times.length };
  });
  rows.sort(function(a,b){return (a.best||Infinity) - (b.best||Infinity);});

  var out = '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">'+
    _statsKpi('AVVERSARI', _competitors.length, 'tracciati', 'var(--purple)')+
    _statsKpi('IL TUO BEST', _statsFmtMs(isFinite(myBest)?myBest:0), myBestCar, 'var(--green)')+
    _statsKpi('CON TEMPI', rows.filter(function(r){return r.count>0;}).length, 'avversari', 'var(--accent3)')+
  '</div>';
  out += '<div class="panel"><div class="panel-head">🎯 CLASSIFICA + GAP DAL MIO BEST</div><div class="panel-body" style="overflow-x:auto;">'+
    '<table class="data-table"><thead><tr>'+
      '<th>POS</th><th>NOME</th><th>CATEGORIA</th><th>BEST</th><th>MEDIA</th><th># GIRI</th><th>GAP</th>'+
    '</tr></thead><tbody>';
  rows.forEach(function(r, i){
    var gapStr = '—';
    var gapColor = 'var(--text3)';
    if(r.gap !== null && isFinite(r.gap)){
      gapStr = (r.gap >= 0 ? '+' : '') + (r.gap/1000).toFixed(3)+'s';
      gapColor = r.gap < 0 ? 'var(--red)' : (r.gap < 500 ? 'var(--yellow)' : 'var(--green)');
    }
    out += '<tr>'+
      '<td><b>'+(i+1)+'</b></td>'+
      '<td><span style="display:inline-block;width:10px;height:10px;border-radius:2px;background:'+(r.c.color||'#888')+';margin-right:6px;vertical-align:middle;"></span>'+r.c.name+'</td>'+
      '<td><span class="badge badge-blue">'+(r.c.cls||'—')+'</span></td>'+
      '<td style="font-family:var(--mono);">'+(r.best?_statsFmtMs(r.best):'—')+'</td>'+
      '<td style="font-family:var(--mono);color:var(--text3);">'+(r.avg?_statsFmtMs(r.avg):'—')+'</td>'+
      '<td style="text-align:center;">'+r.count+'</td>'+
      '<td style="font-family:var(--mono);font-weight:700;color:'+gapColor+';">'+gapStr+'</td>'+
    '</tr>';
  });
  out += '</tbody></table></div></div>';
  return out;
}

// ─── 3) RELIABILITY — laps/km between failures ──────────────────
function _renderStatsReliability(){
  var cars = _statsCarsList();
  var cutoff = _statsCutoffMs();
  var driverFilter = _selectedDriverFilter('stats-driver-filter');
  // Aggregate damage entries per car & per category
  var perCar = [];
  var damageCategories = ['engine','suspension','brakes','body','gearbox','electronics','steering','cooling'];
  cars.forEach(function(car){
    var damages = STATE.damage[car.id] || [];
    if(cutoff) damages = damages.filter(function(d){return !d.ts || d.ts >= cutoff;});
    var carLaps = _lapsForCar(car.id, driverFilter);
    var lapsCount = carLaps.length;
    if(cutoff){ lapsCount = carLaps.filter(function(l){return !l.ts||l.ts>=cutoff;}).length; }
    var byCat = {};
    damageCategories.forEach(function(cat){
      var hits = damages.filter(function(d){
        var v = d[cat];
        return v && v !== 'ok' && v !== 'OK' && v !== '';
      }).length;
      if(hits) byCat[cat] = hits;
    });
    var totalIncidents = Object.keys(byCat).reduce(function(s,k){return s+byCat[k];}, 0);
    perCar.push({
      car: car,
      totalLaps: lapsCount,
      totalIncidents: totalIncidents,
      mtbi: totalIncidents ? lapsCount/totalIncidents : null, // mean laps between incidents
      byCat: byCat
    });
  });

  var totalIncidents = perCar.reduce(function(s,p){return s+p.totalIncidents;}, 0);
  var totalLaps = perCar.reduce(function(s,p){return s+p.totalLaps;}, 0);

  var out = '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">'+
    _statsKpi('GIRI TOTALI', totalLaps, '', 'var(--blue)')+
    _statsKpi('INCIDENTI', totalIncidents, 'componenti danneggiati', 'var(--red)')+
    _statsKpi('MTBI', totalLaps && totalIncidents ? Math.round(totalLaps/totalIncidents)+' giri' : '—', 'Mean Time Between Incidents', 'var(--yellow)')+
  '</div>';

  out += '<div class="panel"><div class="panel-head">🔧 AFFIDABILITÀ PER VETTURA</div><div class="panel-body" style="overflow-x:auto;">'+
    '<table class="data-table"><thead><tr><th>VETTURA</th><th>GIRI</th><th>INCIDENTI</th><th>MTBI</th><th>CATEGORIE PIÙ COLPITE</th></tr></thead><tbody>';
  perCar.forEach(function(p){
    var topCats = Object.keys(p.byCat).sort(function(a,b){return p.byCat[b]-p.byCat[a];}).slice(0,3)
      .map(function(k){return k+' ('+p.byCat[k]+')';}).join(', ') || '—';
    out += '<tr>'+
      '<td><b>'+p.car.name+'</b></td>'+
      '<td>'+p.totalLaps+'</td>'+
      '<td style="color:'+(p.totalIncidents?'var(--red)':'var(--green)')+';">'+p.totalIncidents+'</td>'+
      '<td style="font-family:var(--mono);">'+(p.mtbi?Math.round(p.mtbi)+' giri':'—')+'</td>'+
      '<td style="font-size:11px;color:var(--text2);">'+topCats+'</td>'+
    '</tr>';
  });
  out += '</tbody></table></div></div>';

  // Most-recurring damage categories (overall)
  var allByCat = {};
  perCar.forEach(function(p){
    Object.keys(p.byCat).forEach(function(k){ allByCat[k] = (allByCat[k]||0) + p.byCat[k]; });
  });
  var topAll = Object.keys(allByCat).sort(function(a,b){return allByCat[b]-allByCat[a];});
  if(topAll.length){
    out += '<div class="panel" style="margin-top:14px;"><div class="panel-head">📊 DANNI RICORRENTI (TUTTE LE VETTURE)</div><div class="panel-body">';
    var max = allByCat[topAll[0]];
    topAll.forEach(function(cat){
      var n = allByCat[cat];
      var pct = Math.round(n/max*100);
      out += '<div style="display:grid;grid-template-columns:150px 1fr 60px;align-items:center;gap:10px;margin-bottom:6px;">'+
        '<span style="font-size:12px;text-transform:capitalize;color:var(--text1);">'+cat+'</span>'+
        '<div style="background:var(--bg0);border-radius:3px;height:14px;overflow:hidden;"><div style="background:var(--red);height:100%;width:'+pct+'%;"></div></div>'+
        '<span style="text-align:right;font-family:var(--mono);font-size:12px;color:var(--red);font-weight:700;">'+n+'</span>'+
      '</div>';
    });
    out += '</div></div>';
  }

  return out;
}

// ─── 4) TYRES — per compound: avg life, wear rate, count ────────
function _renderStatsTyres(){
  var cars = _statsCarsList();
  var perCpd = {};  // compound -> {sets, totalKm, totalLaps, sumWear, count, damages}
  cars.forEach(function(car){
    // Track tyres history
    var ts = STATE.tyres && STATE.tyres[car.id];
    if(ts && ts.history){
      ts.history.forEach(function(h){
        var w = h.wheels || {};
        ['FL','FR','RL','RR'].forEach(function(p){
          var wh = w[p];
          if(!wh) return;
          var cpd = wh.compound || '?';
          if(!perCpd[cpd]) perCpd[cpd] = { sets:0, km:0, laps:0, sumWear:0, count:0, damages:0 };
          perCpd[cpd].count++;
          perCpd[cpd].km += +wh.km || 0;
          perCpd[cpd].sumWear += +wh.wear || 0;
          if(wh.damage && wh.damage !== 'none' && wh.damage !== '') perCpd[cpd].damages++;
        });
      });
    }
    // Rally tyres history
    var rt = STATE.rallyTyres && STATE.rallyTyres[car.id];
    if(rt && rt.history){
      rt.history.forEach(function(h){
        var w = h.wheels || {};
        ['FL','FR','RL','RR'].forEach(function(p){
          var wh = w[p];
          if(!wh) return;
          var cpd = wh.compound || '?';
          if(!perCpd[cpd]) perCpd[cpd] = { sets:0, km:0, laps:0, sumWear:0, count:0, damages:0 };
          perCpd[cpd].count++;
          perCpd[cpd].km += +wh.km || 0;
          perCpd[cpd].sumWear += +wh.wear || 0;
          if(wh.damage && wh.damage !== 'none' && wh.damage !== '') perCpd[cpd].damages++;
        });
      });
    }
  });
  // Also count from tyre stock if available
  if(typeof TYRE_STOCK !== 'undefined' && TYRE_STOCK.length){
    TYRE_STOCK.forEach(function(t){
      if(t.status !== 'dismissed' && t.status !== 'used') return;
      var cpd = t.compound || '?';
      if(!perCpd[cpd]) perCpd[cpd] = { sets:0, km:0, laps:0, sumWear:0, count:0, damages:0 };
    });
  }

  var compounds = Object.keys(perCpd);
  if(!compounds.length){
    return '<div style="padding:30px;text-align:center;color:var(--text3);">Nessuna gomma in storico ancora.</div>';
  }

  var totalSets = 0, totalKm = 0, totalDmg = 0;
  compounds.forEach(function(c){
    totalSets += perCpd[c].count;
    totalKm += perCpd[c].km;
    totalDmg += perCpd[c].damages;
  });

  var out = '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">'+
    _statsKpi('SET TOTALI', Math.floor(totalSets/4), '('+totalSets+' singole gomme tracciate)', 'var(--blue)')+
    _statsKpi('KM CUMULATI', totalKm.toFixed(0)+' km', '', 'var(--accent3)')+
