var ST_STORAGE_KEY = 'REP_stagione_v1';
var ST = {
  currentSeason: null,
  currentTab: 'calendar',
  seasons: {}, // { "2026": { events:[], drivers:[], sponsors:[], budget:[], teams:{} } }
};

function stLoad(){
  try {
    var raw = localStorage.getItem(ST_STORAGE_KEY);
    if(raw){
      var data = JSON.parse(raw);
      if(data.seasons) ST.seasons = data.seasons;
      if(data.currentSeason) ST.currentSeason = data.currentSeason;
    }
  } catch(e){ console.warn('ST load fail', e); }
  if(!ST.currentSeason || !ST.seasons[ST.currentSeason]){
    var y = new Date().getFullYear().toString();
    if(!ST.seasons[y]) ST.seasons[y] = _stEmptySeason();
    ST.currentSeason = y;
  }
}
function stSave(){
  try {
    localStorage.setItem(ST_STORAGE_KEY, JSON.stringify({ seasons: ST.seasons, currentSeason: ST.currentSeason }));
  } catch(e){ console.warn('ST save fail', e); }
}
function _stEmptySeason(){
  return { events:[], drivers:[], sponsors:[], budget:[], pointsSystem:'f1_top10', pointsCustom:'', polebonus:false, fastlap:false, currency:'EUR' };
}
function _stCurrent(){
  if(!ST.seasons[ST.currentSeason]) ST.seasons[ST.currentSeason] = _stEmptySeason();
  return ST.seasons[ST.currentSeason];
}

function buildStagionePage(){
  stLoad();
  _stBuildSeasonSelector();
  stSwitchTab(ST.currentTab);
}

// Helper: navigate to Stagione page and switch to a specific tab in one call
// Used by the TEAM nav-menu entries. Exposed on window so menu onclick can reach it.
window.stGo = function(tab){
  if(typeof showPage === 'function') showPage('stagione');
  setTimeout(function(){
    if(typeof stSwitchTab === 'function') stSwitchTab(tab);
  }, 60);
};

function _stBuildSeasonSelector(){
  var sel = document.getElementById('st-season-sel');
  if(!sel) return;
  var years = Object.keys(ST.seasons).sort();
  if(!years.length){ years = [new Date().getFullYear().toString()]; ST.seasons[years[0]] = _stEmptySeason(); }
  sel.innerHTML = years.map(function(y){ return '<option value="'+y+'"'+(y===ST.currentSeason?' selected':'')+'>Stagione '+y+'</option>';}).join('');
  var lbl = document.getElementById('st-cal-season-label');
  if(lbl) lbl.textContent = 'Stagione '+ST.currentSeason;
}

function stSwitchSeason(y){
  ST.currentSeason = y;
  stSave();
  _stBuildSeasonSelector();
  stSwitchTab(ST.currentTab);
  showToast('📅 Stagione '+y);
}
function stNewSeason(){
  var y = prompt('Anno della nuova stagione:', (new Date().getFullYear()+1).toString());
  if(!y || !/^\d{4}$/.test(y)){ if(y) showToast('⚠️ Anno non valido'); return; }
  if(ST.seasons[y]){ showToast('⚠️ Stagione '+y+' esiste già'); return; }
  ST.seasons[y] = _stEmptySeason();
  ST.currentSeason = y;
  stSave();
  _stBuildSeasonSelector();
  stSwitchTab(ST.currentTab);
  showToast('✓ Stagione '+y+' creata');
}
function stSwitchTab(name){
  ST.currentTab = name;
  ['calendar','standings','budget','drivers','sponsors'].forEach(function(t){
    var btn = document.getElementById('st-tab-'+t);
    var panel = document.getElementById('st-panel-'+t);
    if(btn) btn.classList.toggle('active', t===name);
    if(panel) panel.style.display = (t===name) ? '' : 'none';
  });
  switch(name){
    case 'calendar':  stRenderCalendar(); break;
    case 'standings': stRenderStandings(); break;
    case 'budget':    stRenderBudget(); break;
    case 'drivers':   stRenderDrivers(); break;
    case 'sponsors':  stRenderSponsors(); break;
  }
}
function stExportSeason(){
  var s = _stCurrent();
  var json = JSON.stringify({ _REP_SEASON_EXPORT:1, year:ST.currentSeason, data:s }, null, 2);
  var blob = new Blob([json], {type:'application/json'});
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'REP-stagione-'+ST.currentSeason+'.json';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
