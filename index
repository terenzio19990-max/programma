          const d = new Date(snap.savedAt);
          const timeStr = d.toLocaleDateString('it-IT')+' '+d.toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit'});
          if(confirm(`🔄 Trovato un auto-salvataggio del ${timeStr}.\nVuoi ripristinare la sessione?`)) {
