REP2._forecastAt = function(hhmm){
  var F = (typeof METEO_STATE!=='undefined') ? METEO_STATE.forecast : null;
  if(!F || !F.time || !hhmm) return null;
  var hh = +hhmm.split(':')[0];
  var now = new Date();
  var best = null;
  for(var i=0;i<F.time.length;i++){
    var d = new Date(F.time[i]);
    if(d.getHours()!==hh) continue;
    if(best===null) best = i;
    if(d >= new Date(now.getTime()-3600000)){ best = i; break; }
  }
  if(best===null) return null;
  return { temp:F.temperature_2m?F.temperature_2m[best]:null,
           pp:F.precipitation_probability?F.precipitation_probability[best]:null,
           pr:F.precipitation?F.precipitation[best]:null,
           code:F.weathercode?F.weathercode[best]:null };
};
REP2._tyreSuggest = function(fc){
  if(!fc) return { txt:'—', col:'var(--text3)' };
  var pp = fc.pp==null?0:+fc.pp, pr = fc.pr==null?0:+fc.pr;
  if(pr>0.4 || pp>=60) return { txt:'🌧 RAIN', col:'var(--blue)' };
  if(pp>=30) return { txt:'⚠ RISCHIO — decidere al CO', col:'var(--yellow)' };
  var t = fc.temp;
  if(t!=null && t>=26) return { txt:'☀ SLICK hard', col:'var(--green)' };
  if(t!=null && t<=10) return { txt:'☀ SLICK soft', col:'var(--green)' };
  return { txt:'☀ SLICK', col:'var(--green)' };
};
