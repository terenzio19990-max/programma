function refreshMeteoPage() {
  if(!METEO_STATE.lat) {
    // Try to infer from current selection
    const key = STATE.mode==='track' ? STATE.circuit : document.getElementById('rally-event-sel')?.value;
    if(key) updateMeteoLocation(key);
    else return;
  }
  setEl('meteo-location-label', METEO_STATE.label||'—');
  fetchWeatherFull(METEO_STATE.lat, METEO_STATE.lng);
  loadWindyIframe();
}

function fetchWeather(lat, lng) {
  const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current=temperature_2m,weathercode,windspeed_10m,relativehumidity_2m&timezone=auto&forecast_days=1`;
  fetch(url).then(r=>r.json()).then(d=>{
    const cur = d.current;
    const code = cur.weathercode;
    const cond = wmoCode(code);
    const temp = cur.temperature_2m;
    const hum  = cur.relativehumidity_2m;
    const wind = cur.windspeed_10m;
    setEl('w-temp', temp+'°C');
    setEl('w-cond', cond.label.toUpperCase());
    setEl('w-icon', cond.icon);
    setEl('sw-temp', temp+'°C');
    setEl('sw-cond', cond.icon+' '+cond.label);
    setEl('sw-hum', hum+'%');
    setEl('sw-wind', wind+' km/h');
    if(code>=61&&code<=67) updateSurface('BAGNATO');
    if(code>=71&&code<=77) updateSurface('NEVE');
  }).catch(()=>{ setEl('w-temp','—°C'); setEl('w-cond','OFFLINE'); });
}

function wmoCode(c) {
  if(c===0) return {icon:'☀️',label:'Sereno'};
  if(c<=2)  return {icon:'⛅',label:'Parziale'};
  if(c<=3)  return {icon:'☁️',label:'Nuvoloso'};
  if(c<=9)  return {icon:'🌫',label:'Foschia'};
  if(c<=12) return {icon:'🌦',label:'Pioviggine'};
  if(c<=19) return {icon:'🌦',label:'Pioggerella'};
  if(c<=29) return {icon:'🌧',label:'Pioggia'};
  if(c<=39) return {icon:'❄️',label:'Neve'};
  if(c<=49) return {icon:'🌧',label:'Nev. Pioggia'};
  if(c<=59) return {icon:'🌧',label:'Pioggia mod.'};
  if(c<=69) return {icon:'🌧',label:'Pioggia forte'};
  if(c<=79) return {icon:'❄️',label:'Neve forte'};
  if(c<=82) return {icon:'⛈',label:'Rovescio'};
  if(c<=99) return {icon:'⛈',label:'Temporale'};
  return {icon:'🌡',label:'—'};
}

function initWeather() {
  if(navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos=>{
      const { latitude:lat, longitude:lng } = pos.coords;
      fetchWeather(lat, lng);
      setInterval(()=>fetchWeather(lat,lng), 600000);
      setEl('sw-location',`${lat.toFixed(2)}°N ${lng.toFixed(2)}°E`);
    }, ()=>{
      fetchWeather(43.997, 11.371);
      setEl('sw-location','Posizione predefinita: Mugello');
    });
  } else {
    fetchWeather(43.997, 11.371);
  }
}

