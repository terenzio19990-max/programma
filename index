// Compute best laps per circuit for the selected car
function _kbBestPerCircuit(carId){
  // Group by year of ts as a fallback "circuit context"
  // Note: lap doesn't store circuit. We'll group by session string as proxy.
  var laps = (STATE.laps[carId] || []);
  var bestPerSession = {};
  laps.forEach(function(l){
    var ms = parseTime(l.time);
    if(!ms || !isFinite(ms)) return;
    var key = l.session || '—';
    if(!bestPerSession[key] || ms < bestPerSession[key].ms){
      bestPerSession[key] = { ms: ms, lap: l.lap, ts: l.ts||0, session: key };
    }
  });
  return bestPerSession;
}

function _kbFmtMs(ms){
  if(!ms||!isFinite(ms)||ms<=0) return '—';
  var min = Math.floor(ms/60000);
  var sec = ((ms%60000)/1000).toFixed(3);
  if(sec.length === 5) sec = '0'+sec;
  return min+':'+sec;
}

