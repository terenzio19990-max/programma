// RESET RECOVERY — if user regrets, list and restore safety backups
// ═══════════════════════════════════════════════════════════════
async function listResetSafetyBackups(){
  try {
    var db = await openIDB();
    return new Promise(function(resolve){
      var out = [];
      var tx = db.transaction(IDB_STORE, 'readonly');
      var req = tx.objectStore(IDB_STORE).openCursor();
      req.onsuccess = function(){
        var cur = req.result;
        if(!cur){
          out.sort(function(a,b){return (b.savedAt||'').localeCompare(a.savedAt||'');});
          resolve(out);
          return;
        }
        var name = (cur.value.name||'');
        if(name.indexOf('_safety_pre_reset_') === 0){
          out.push({ name: name, savedAt: cur.value.savedAt });
        }
        cur.continue();
      };
      req.onerror = function(){ resolve(out); };
    });
  } catch(e){ return []; }
}
window.listResetSafetyBackups = listResetSafetyBackups;

async function restoreResetSafetyBackup(name){
  try {
    var db = await openIDB();
    var snap = await new Promise(function(res){
      var tx = db.transaction(IDB_STORE, 'readonly');
      var req = tx.objectStore(IDB_STORE).get(name);
      req.onsuccess = function(){ res(req.result); };
      req.onerror = function(){ res(null); };
    });
    if(!snap){ showToast('❌ Backup non trovato'); return; }
    if(!confirm('Ripristinare il backup di sicurezza salvato il '+(snap.savedAt||'?')+'?\nI dati attuali andranno persi.')) return;
    if(snap.STATE && typeof STATE !== 'undefined'){
      Object.keys(STATE).forEach(function(k){ delete STATE[k]; });
      Object.assign(STATE, snap.STATE);
    }
    if(snap._competitors && typeof _competitors !== 'undefined'){
      _competitors.length = 0;
      snap._competitors.forEach(function(c){_competitors.push(c);});
    }
    if(snap._driverNotes && typeof _driverNotes !== 'undefined'){
      Object.keys(_driverNotes).forEach(function(k){delete _driverNotes[k];});
      Object.assign(_driverNotes, snap._driverNotes);
    }
    if(snap._pitStops && typeof _pitStops !== 'undefined'){
      Object.keys(_pitStops).forEach(function(k){delete _pitStops[k];});
      Object.assign(_pitStops, snap._pitStops);
    }
    if(snap.COMPOUND_NAMES && typeof COMPOUND_NAMES !== 'undefined') Object.assign(COMPOUND_NAMES, snap.COMPOUND_NAMES);
    if(snap.DOCS && typeof DOCS !== 'undefined') Object.assign(DOCS, snap.DOCS);
    if(snap.METEO_STATE && typeof METEO_STATE !== 'undefined') Object.assign(METEO_STATE, snap.METEO_STATE);
    // Restore localStorage keys
    if(snap.ls){
      Object.keys(snap.ls).forEach(function(k){
        try { localStorage.setItem(k, snap.ls[k]); } catch(_){}
      });
    }
    showToast('✅ Backup ripristinato. Ricarico la pagina...');
    setTimeout(function(){ location.reload(); }, 1200);
  } catch(e){ showToast('❌ Errore: '+e.message); }
}
window.restoreResetSafetyBackup = restoreResetSafetyBackup;


function autoSave() {
  const snap = serializeSession();
  snap.name = '_autosave_';
  // ── Primary: save to IndexedDB (no 5MB limit, fits everything) ──
  // We use fire-and-forget Promise; UI feedback shown immediately optimistically.
  autoSaveToIDB().then(function(ok){
    if(!ok){
      // Fallback to localStorage only if IDB failed
      try { localStorage.setItem(SESSION_AUTOSAVE_KEY, JSON.stringify(snap)); } catch(_){}
    } else {
      // Migration: clean up old localStorage autosave once IDB is established
      try { localStorage.removeItem(SESSION_AUTOSAVE_KEY); } catch(_){}
