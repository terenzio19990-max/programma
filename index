  <div class="panel mb12" style="border-left:3px solid var(--accent3);">
    <div class="panel-head" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <span>⏱ CRONOMETRO <span id="chrono-car-label" style="font-size:10px;color:var(--blue);font-weight:400;letter-spacing:1px;">— vettura corrente</span></span>
      <span style="font-size:10px;color:var(--text3);font-weight:400;letter-spacing:1px;">precisione ~100ms · cronometrista umano</span>
    </div>
    <div class="panel-body">
      <!-- Display principale: giro corrente in primo piano -->
      <div style="text-align:center;margin-bottom:6px;">
        <div style="font-size:10px;color:var(--text3);letter-spacing:2px;margin-bottom:4px;">GIRO CORRENTE</div>
        <div id="chrono-display" style="font-family:var(--mono);font-size:54px;font-weight:900;letter-spacing:3px;color:var(--accent3);background:var(--bg0);border:1px solid var(--border);border-radius:6px;padding:12px 10px;line-height:1;">0:00.000</div>
      </div>

      <!-- Mini stats: total elapsed + last + best -->
      <div style="display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:10px;font-size:13px;color:var(--text3);flex-wrap:wrap;">
        <span>Totale: <span id="chrono-elapsed-mini" style="font-family:var(--mono);color:var(--text2);font-weight:700;">0:00.000</span></span>
        <span>·</span>
        <span>Ultimo: <span id="chrono-last-lap" style="font-family:var(--mono);color:var(--text2);font-weight:700;">—</span></span>
        <span>·</span>
        <span>Best: <span id="chrono-best-lap" style="font-family:var(--mono);color:var(--green);font-weight:700;">—</span></span>
      </div>

      <!-- Status indicator -->
      <div id="chrono-status" style="text-align:center;font-size:11px;color:var(--text3);letter-spacing:1.5px;margin-bottom:10px;height:14px;">FERMO</div>

      <!-- Flash overlay quando un lap viene registrato -->
      <div id="chrono-flash" style="display:none;text-align:center;background:var(--green);color:#fff;padding:10px;border-radius:6px;margin-bottom:10px;font-family:var(--head);font-size:14px;font-weight:700;letter-spacing:2px;"></div>

      <!-- Buttons -->
      <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-bottom:14px;">
        <button id="chrono-btn-start" class="btn btn-green" onclick="chronoStart()" style="font-size:14px;padding:12px 22px;min-width:110px;font-weight:700;">▶ START</button>
        <button id="chrono-btn-firstlap" class="btn btn-blue" onclick="chronoMarkFirst()" style="font-size:14px;padding:12px 22px;min-width:110px;font-weight:700;display:none;background:var(--blue);" title="Premi quando passi la linea start per la prima volta">🏁 1° PASSAGGIO</button>
        <button id="chrono-btn-lap" class="btn btn-blue" onclick="chronoLap()" style="font-size:14px;padding:12px 22px;min-width:110px;font-weight:700;display:none;">🚩 LAP</button>
        <button id="chrono-btn-stop" class="btn btn-gray" onclick="chronoStop()" style="font-size:14px;padding:12px 22px;min-width:110px;font-weight:700;display:none;">⏸ STOP</button>
        <button id="chrono-btn-resume" class="btn btn-green" onclick="chronoResume()" style="font-size:14px;padding:12px 22px;min-width:110px;font-weight:700;display:none;">▶ RIPRENDI</button>
        <button id="chrono-btn-reset" class="btn btn-gray" onclick="chronoReset()" style="font-size:14px;padding:12px 22px;min-width:110px;font-weight:700;color:var(--red);">🔄 RESET</button>
      </div>

      <!-- Recorded laps list — SEMPRE visibile -->
      <div id="chrono-laps-wrap">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;flex-wrap:wrap;gap:6px;">
          <div style="font-size:11px;color:var(--text3);letter-spacing:1.5px;">📋 GIRI CRONOMETRATI <span id="chrono-laps-count" style="color:var(--accent3);font-weight:700;">0</span></div>
          <div style="display:flex;gap:5px;">
            <button class="btn btn-blue" onclick="chronoTransferLast()" style="font-size:10px;padding:5px 10px;" title="Copia ultimo nel campo Tempo del form sotto">↓ ULTIMO NEL FORM</button>
            <button class="btn btn-green" onclick="chronoSaveAll()" style="font-size:10px;padding:5px 10px;" title="Salva tutti come giri della sessione">💾 SALVA TUTTI</button>
            <button class="btn btn-gray" onclick="chronoClearLaps()" style="font-size:10px;padding:5px 10px;" title="Svuota lista">🗑</button>
          </div>
        </div>
        <div id="chrono-laps" style="min-height:48px;max-height:200px;overflow-y:auto;background:var(--bg0);border:1px solid var(--border);border-radius:4px;padding:6px;"></div>
      </div>
    </div>
  </div>

  <div class="g2 mb12">
    <div class="panel">
      <div class="panel-head">INSERISCI GIRO</div>
      <div class="panel-body">
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:10px;padding:6px 10px;background:var(--bg3);border-radius:4px;border-left:3px solid var(--blue);">
          <span style="font-size:10px;color:var(--text3);letter-spacing:1.5px;">👤 PILOTA AL VOLANTE</span>
          <select id="lap-driver" style="flex:1;background:var(--bg0);border:1px solid var(--border);color:var(--text1);font-size:12px;padding:4px 8px;border-radius:3px;">
            <option value="">— non specificato —</option>
          </select>
          <span style="font-size:9px;color:var(--text3);">si applica a tutti i giri inseriti finché non cambi</span>
        </div>
        <div class="form-row">
          <div class="field"><label>Giro #</label><input type="number" id="lap-num" value="1" min="1" data-lap-form="1" data-next="lap-time"></div>
          <div class="field"><label>Tempo (m:ss.ms)</label><input type="text" id="lap-time" placeholder="1:34.567" data-lap-form="1" data-next="s1-time" autocomplete="off"></div>
          <div class="field"><label>Settore 1</label><input type="text" id="s1-time" placeholder="28.345" data-lap-form="1" data-next="s2-time" autocomplete="off"></div>
          <div class="field"><label>Settore 2</label><input type="text" id="s2-time" placeholder="32.100" data-lap-form="1" data-next="s3-time" autocomplete="off"></div>
          <div class="field"><label>Settore 3</label><input type="text" id="s3-time" placeholder="34.122" data-lap-form="1" data-next="lap-pos" autocomplete="off"></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Target Time</label><input type="text" id="target-time" placeholder="1:34.000" autocomplete="off"></div>
          <div class="field"><label>Posizione</label><input type="number" id="lap-pos" value="1" min="1" data-lap-form="1" data-next="lap-vmax"></div>
          <div class="field"><label>🚀 Vel. Max (km/h)</label><input type="number" id="lap-vmax" placeholder="215" min="0" step="0.1" data-lap-form="1" data-next="lap-note"></div>
          <div class="field"><label>Nota giro</label>
            <div style="position:relative;">
              <input type="text" id="lap-note" placeholder="..." data-lap-form="1" data-next="__SUBMIT__" list="lap-notes-history" autocomplete="off" style="padding-right:42px;width:100%;">
              <button type="button" onclick="voiceToggle('lap-note', this, 'append')" title="🎙 Dettatura vocale" style="position:absolute;top:50%;right:4px;transform:translateY(-50%);background:var(--bg3);border:1px solid var(--border);border-radius:3px;color:var(--text2);cursor:pointer;padding:4px 7px;font-size:11px;">🎙</button>
            </div>
          </div>
        </div>
        <datalist id="lap-notes-history"></datalist>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
          <button class="btn btn-green" onclick="addLap()">+ AGGIUNGI GIRO</button>
          <button class="btn btn-gray" style="font-size:11px;padding:8px 12px;" onclick="lapDuplicateLast()" title="Compila il form con i valori dell'ultimo giro inserito (utile per giri ripetuti)">📋 DUPLICA ULTIMO</button>
          <button class="btn btn-gray" style="font-size:11px;padding:8px 12px;" onclick="lapClearForm()" title="Pulisci tutti i campi">🗑 PULISCI</button>
          <span style="font-size:10px;color:var(--text3);margin-left:auto;">💡 ENTER = campo successivo · ENTER su nota = SALVA</span>
        </div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-head">BEST LAP & TEORICO</div>
      <div class="panel-body">
        <div class="g2" style="gap:8px;">
          <div class="tile tile-good"><div class="tile-label">BEST LAP</div><div class="tile-value" id="best-lap-disp">—</div></div>
          <div class="tile tile-accent"><div class="tile-label">TARGET</div><div class="tile-value" id="target-disp">—</div></div>
          <div class="tile"><div class="tile-label">GIRO CORRENTE</div><div class="tile-value" id="cur-lap-disp">—</div></div>
          <div class="tile"><div class="tile-label">Δ TARGET</div><div class="tile-value" id="delta-target-disp">—</div></div>
          <div class="tile" style="border-left:3px solid var(--accent3);"><div class="tile-label">🚀 VEL. MAX</div><div class="tile-value" id="best-vmax-disp" style="color:var(--accent3);">—</div><div class="tile-sub" id="best-vmax-lap" style="font-size:10px;color:var(--text3);">—</div></div>
          <div class="tile"><div class="tile-label">VEL. MEDIA MAX</div><div class="tile-value" id="avg-vmax-disp" style="font-size:16px;">—</div></div>
        </div>
        <div style="margin-top:10px;padding:8px 10px;background:var(--bg3);border-left:3px solid var(--green);border-radius:4px;">
          <div style="font-family:var(--head);font-size:10px;letter-spacing:2px;color:var(--text3);margin-bottom:6px;">⚡ GIRO TEORICO (miglior settore)</div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
            <div style="display:flex;flex-direction:column;align-items:center;min-width:72px;">
              <span style="font-size:9px;color:var(--text3);letter-spacing:1px;">S1 BEST</span>
              <span id="best-s1-disp" class="mono" style="font-size:14px;color:var(--green);font-weight:700;">—</span>
              <span id="best-s1-lap" style="font-size:9px;color:var(--text3);">—</span>
            </div>
            <div style="color:var(--text3);font-size:16px;">+</div>
            <div style="display:flex;flex-direction:column;align-items:center;min-width:72px;">
              <span style="font-size:9px;color:var(--text3);letter-spacing:1px;">S2 BEST</span>
              <span id="best-s2-disp" class="mono" style="font-size:14px;color:var(--green);font-weight:700;">—</span>
              <span id="best-s2-lap" style="font-size:9px;color:var(--text3);">—</span>
            </div>
            <div style="color:var(--text3);font-size:16px;">+</div>
            <div style="display:flex;flex-direction:column;align-items:center;min-width:72px;">
              <span style="font-size:9px;color:var(--text3);letter-spacing:1px;">S3 BEST</span>
              <span id="best-s3-disp" class="mono" style="font-size:14px;color:var(--green);font-weight:700;">—</span>
              <span id="best-s3-lap" style="font-size:9px;color:var(--text3);">—</span>
