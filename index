        '<div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text3);margin-top:6px;">'+
          '<span>Salvataggio automatico ogni modifica</span>'+
          '<span>Aggiornata '+_diaryFmtRelative(e.updatedAt)+' · creata '+_diaryFmtDate(e.createdAt)+'</span>'+
        '</div>'+
      '</div>'+
    '</div>';
}

