  if(sel) sel.innerHTML = STATE.rallyCars.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');
  setEl('quick-car-disp', STATE.trackCars[STATE.selectedTrackCar]?.name||'—');
  if(typeof updatePositionInputs==='function') updatePositionInputs();
}

