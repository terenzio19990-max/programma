// Generate demo session data — 1 weekend at Mugello with realistic laps
function loadDemoData(){
  if(!isAppEmpty()){
    if(!confirm('Caricare i dati di esempio sovrascriverà alcuni dati attuali. Continuare?')) return;
  }
  try {
    // Set circuit to Mugello, session to FP1
    STATE.circuit = 'mugello';
    var stEl = document.getElementById('session-type');
    if(stEl) stEl.value = 'FP1';
    var srfEl = document.getElementById('surface-sel');
    if(srfEl) srfEl.value = 'Asciutto';
    if(typeof selectCircuit === 'function') selectCircuit('mugello');

    // Pick the first track car
    var car = STATE.trackCars && STATE.trackCars[0];
    if(!car){
      showToast('Nessuna vettura pista — crea prima una vettura');
      return;
    }
    // Generate 12 laps with realistic progression: warmup 1:58.x → improving to 1:55.2
    var baseTimeMs = 118000; // 1:58.000
    var minTimeMs  = 115234; // 1:55.234 best
    var demoLaps = [];
    var sessions = ['FP1','FP1','FP1','FP1','FP1','FP2','FP2','FP2','FP2','Q1','Q1','Q1'];
    var positions = [3,3,3,2,2,2,2,2,2,1,1,1];
    var vmaxes   = [253,255,256,257,258,259,260,260,261,262,263,263];
    for(var i=0;i<12;i++){
      // Curve: faster as we go, but with variance
      var ms;
      if(i < 3) ms = baseTimeMs - i*800 + Math.floor(Math.random()*400-200);
      else if(i < 6) ms = baseTimeMs - 2400 - i*350 + Math.floor(Math.random()*400-200);
      else if(i < 9) ms = baseTimeMs - 4500 - (i-6)*250 + Math.floor(Math.random()*300-150);
      else ms = minTimeMs + (i-9)*100 + Math.floor(Math.random()*200-100);
      ms = Math.max(minTimeMs, ms);
      // Sectors: 30% / 35% / 35% with variance
      var s1 = Math.floor(ms * 0.30 + (Math.random()*200-100));
      var s2 = Math.floor(ms * 0.35 + (Math.random()*200-100));
      var s3 = ms - s1 - s2;
      demoLaps.push({
        lap: i+1,
        time: msToTime(ms),
        s1: msToTime(s1).replace(/^0:/,''),
        s2: msToTime(s2).replace(/^0:/,''),
        s3: msToTime(s3).replace(/^0:/,''),
        pos: positions[i],
        vmax: vmaxes[i],
        note: i===0 ? 'Warmup, gomme M' : i===5 ? 'Sgomma sopra 60% wear' : i===9 ? 'Push qualifica' : '',
        session: sessions[i],
        car: car.id,
        driverId: '',
        ts: Date.now() - (12-i)*180000  // staggered timestamps over last hour
      });
    }
    if(!STATE.laps[car.id]) STATE.laps[car.id] = [];
    STATE.laps[car.id] = STATE.laps[car.id].concat(demoLaps);

    // Add 2 sample competitors for Clio Cup
    if(typeof _competitors !== 'undefined' && _competitors.length === 0){
      _competitors.push({
        id: 'demo_c1',
        name: 'Rossi Mario',
        cls: 'Clio Cup',
        color: '#3b82f6',
        laps: ['1:55.890','1:55.500','1:55.234','1:55.100']
      });
      _competitors.push({
        id: 'demo_c2',
        name: 'Bianchi Luca',
        cls: 'Clio Cup',
        color: '#a855f7',
        laps: ['1:56.234','1:55.800','1:55.600']
      });
      try { localStorage.setItem('REP_competitors_v1', JSON.stringify(_competitors)); } catch(_){}
    }

    // Add 2 sample spare parts with full new fields
    if(typeof SPARE_PARTS !== 'undefined' && SPARE_PARTS.track && SPARE_PARTS.track.length === 0){
      SPARE_PARTS.track.push({
        id: Date.now()-1000, name: 'Pastiglie freno anteriori', cat: 'Freni',
        qty: 4, used: 0, note: 'Compatibile RS Clio',
        min: 2, cost: 32.50, supplier: 'Brembo Racing', lead: 5,
        history: [{action:'add', qty:4, motivo:'Riordino', at:Date.now()-86400000*7}],
        createdAt: Date.now()-86400000*7
      });
      SPARE_PARTS.track.push({
        id: Date.now()-500, name: 'Ammortizzatore anteriore SX', cat: 'Sospensioni',
        qty: 1, used: 0, note: 'Coilover regolabile',
        min: 2, cost: 285.00, supplier: 'Ohlins Italia', lead: 14,
        history: [{action:'add', qty:1, motivo:'Stock minimo', at:Date.now()-86400000*15}],
        createdAt: Date.now()-86400000*15
      });
    }

    // Mark welcome dismissed
    dismissWelcome();
    // Refresh everything
    if(typeof triggerAutoSave === 'function') triggerAutoSave();
    if(typeof buildLapsTable === 'function') buildLapsTable(car.id);
    if(typeof updateSidebarStats === 'function') updateSidebarStats(car.id);
    if(typeof buildDashboard === 'function') buildDashboard();
    showToast('✅ Dati esempio caricati — 12 giri Mugello + avversari + ricambi');
  } catch(e){
    showToast('❌ Errore caricamento demo: '+e.message);
    console.error(e);
  }
}
