function gpsSet(id,v){ var el=document.getElementById(id); if(el) el.textContent=v; }
function hav(a1,o1,a2,o2){ var R=6371e3,p1=a1*Math.PI/180,p2=a2*Math.PI/180,dp=(a2-a1)*Math.PI/180,dl=(o2-o1)*Math.PI/180;
  var x=Math.sin(dp/2)*Math.sin(dp/2)+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)*Math.sin(dl/2); return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x)); }
window.repGpsStart = function(){
  if(GPS.watching) return;
  if(!navigator.geolocation){ gpsSet('rep-gps-msg','Geolocalizzazione non disponibile in questo browser.'); return; }
  GPS.pts=[]; GPS.dist=0; GPS.vmax=0; GPS.t0=Date.now(); GPS.watching=true;
  document.getElementById('rep-gps-start').disabled=true;
  document.getElementById('rep-gps-stop').disabled=false;
  gpsSet('rep-gps-msg','Registrazione in corso… tieni la pagina aperta e lo schermo acceso.');
  GPS.id=navigator.geolocation.watchPosition(function(pos){
    var c=pos.coords;
    var p={ lat:c.latitude, lon:c.longitude, alt:(c.altitude!=null? c.altitude:0), v:(c.speed!=null? c.speed:null), t:Date.now() };
    var last=GPS.pts[GPS.pts.length-1];
    if(last){
      var d=hav(last.lat,last.lon,p.lat,p.lon);
      if(d<0.5) return;                     // fermo: non accumulare rumore
      GPS.dist+=d;
      if(p.v===null) p.v=d/Math.max(0.2,(p.t-last.t)/1000);
    }
    GPS.pts.push(p);
    try { if(typeof window._repGpsHook==='function') window._repGpsHook(p); } catch(e2){}
    if(p.v!==null) GPS.vmax=Math.max(GPS.vmax, p.v);
    gpsSet('rep-gps-v', p.v!==null? (p.v*3.6).toFixed(0)+' km/h':'—');
    gpsSet('rep-gps-vmax', (GPS.vmax*3.6).toFixed(0)+' km/h');
    gpsSet('rep-gps-d', (GPS.dist/1000).toFixed(2)+' km');
    gpsSet('rep-gps-n', String(GPS.pts.length));
    var el=(Date.now()-GPS.t0)/1000;
    gpsSet('rep-gps-t', Math.floor(el/60)+':'+String(Math.floor(el%60)).padStart(2,'0'));
  }, function(err){
    gpsSet('rep-gps-msg','Errore GPS: '+err.message+' (controlla permessi/HTTPS)');
  }, { enableHighAccuracy:true, maximumAge:0, timeout:10000 });
};
window.repGpsStop = function(){
  if(GPS.id!==null){ try { navigator.geolocation.clearWatch(GPS.id); } catch(e){} }
  try { if(typeof window._repGpsEndHook==='function') window._repGpsEndHook(); } catch(e){}
  GPS.watching=false; GPS.id=null;
  var st=document.getElementById('rep-gps-start'); if(st) st.disabled=false;
  var sp=document.getElementById('rep-gps-stop'); if(sp) sp.disabled=true;
  var ex=document.getElementById('rep-gps-exp'); if(ex) ex.disabled=!GPS.pts.length;
  if(GPS.pts.length<10){ gpsSet('rep-gps-msg','Registrazione troppo corta ('+GPS.pts.length+' punti).'); return; }
  // salva come percorso 3D + offri apertura mappa (quote online se alt mancante)
