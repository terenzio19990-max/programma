// TODO ENGINE — "Cosa fare adesso" intelligent action recommender
// Runs a series of rules over current STATE and returns a list of
// action items, sorted by priority (critical → warning → suggestion).
// Each item has: priority, icon, text, page (optional click target).
// ═══════════════════════════════════════════════════════════════
function _todoCheck(){
  var items = [];
  // Helper to push items
  function add(prio, icon, text, page){
    items.push({ prio: prio, icon: icon, text: text, page: page||null });
  }
  // Decide which set of cars to look at
  var trackCars = STATE.trackCars || [];
  var rallyCars = STATE.rallyCars || [];
  var mode = STATE.mode || 'track';
  var tyrePage = mode === 'rally' ? 'rally-tyres' : 'tyres';
  var fuelPage = mode === 'rally' ? 'rally-fuel'  : 'fuel';
  var damagePage = mode === 'rally' ? 'rally-damage' : 'damage';

  // ─── Per-car checks (current car for the active mode) ─────────
  var car = mode === 'track' ? trackCars[STATE.selectedTrackCar] : rallyCars[STATE.selectedRallyCar];
  if(car){
    // Tyres usage: check current mounted set
    var ts = (mode === 'rally' ? STATE.rallyTyres : STATE.tyres) || {};
    var tyresState = ts[car.id];
    if(tyresState && tyresState.current && tyresState.current.wheels){
      var wheels = tyresState.current.wheels;
      ['FL','FR','RL','RR'].forEach(function(p){
        var w = wheels[p]; if(!w) return;
        var wear = +w.wear || 0;
        if(wear >= 80){
          add('critical', '⚠️', p+' usurata al '+wear+'% — sostituire ora', tyrePage);
        } else if(wear >= 65){
          add('warning', '🛞', p+' al '+wear+'% — pianifica sostituzione', tyrePage);
        }
        if(w.damage && w.damage !== 'none' && w.damage !== '' && w.damage !== 'ok'){
          add('warning', '💢', p+' danneggiata: '+w.damage, tyrePage);
        }
      });
    }

    // Fuel: how many laps remaining?
    var fuel = (mode === 'rally' ? STATE.rallyFuel : STATE.fuel) || {};
    var fuelState = fuel[car.id];
    if(fuelState && fuelState.current !== undefined && fuelState.perLap){
      var remaining = fuelState.perLap > 0 ? Math.floor((+fuelState.current||0) / +fuelState.perLap) : null;
      if(remaining !== null){
        if(remaining <= 2){
          add('critical', '⛽', 'Carburante per ~'+remaining+' giri — rifornimento urgente', fuelPage);
        } else if(remaining <= 5){
          add('warning', '⛽', 'Carburante per ~'+remaining+' giri — pianifica rifornimento', fuelPage);
        }
      }
    }

    // Damage open / unresolved
    var damages = (STATE.damage && STATE.damage[car.id]) || [];
    if(damages.length){
      var lastDmg = damages[damages.length-1];
      var hasMajor = ['engine','suspension','brakes','body','gearbox','electronics','steering']
        .some(function(k){ var v = lastDmg[k]; return v && v!=='ok' && v!=='OK' && v!=='' && v!=='minor'; });
      if(hasMajor){
        add('warning', '🚨', 'Ultimo report danni con problemi major — verifica', damagePage);
      }
    }

    // Setup obsoleto? (last setup > 7 days ago)
    var setups = (STATE.setup && STATE.setup[car.id]) || [];
    var rsetups = (STATE.rallySetup && STATE.rallySetup[car.id]) || [];
    var allSet = setups.concat(rsetups);
    if(allSet.length){
      var lastSet = allSet[allSet.length-1];
      // Check timestamp if exists
      var ts2 = lastSet.ts || lastSet.timestamp;
      if(ts2 && typeof ts2 === 'number'){
        var ageDays = (Date.now() - ts2) / 86400000;
        if(ageDays > 14){
          add('suggestion', '🔧', 'Ultimo setup > '+Math.floor(ageDays)+' gg fa — verifica se aggiornarlo', 'setup');
        }
      }
    } else if((STATE.laps[car.id]||[]).length > 5){
      // Driver's done >5 laps but no setup saved
      add('suggestion', '🔧', 'Nessun setup salvato per '+car.name+' — registralo', mode==='rally'?'rally-setup':'setup');
    }
  }

  // ─── Mode-wide checks ──────────────────────────────────────────
  // Maintenance overdue (recurring checklist templates)
  if(typeof clGetOverdueTemplates === 'function'){
    try {
      var overdue = clGetOverdueTemplates() || [];
      overdue.forEach(function(o){
        var days = o.daysSince !== null ? ' ('+o.daysSince+' gg fa)' : ' (mai eseguita)';
        add('warning', '🛠', 'Manutenzione "'+o.tpl.name+'" in scadenza'+days, 'checklist');
      });
    } catch(_){}
  }

  // Per-session checklist not completed (only flag templates with frequency='per-session')
  if(typeof CL !== 'undefined' && CL.session){
    var anyIncomplete = false;
    var sess = CL.session;
    if(sess.tplId && sess.checks && Array.isArray(sess.checks)){
      // Count uncompleted required items
      var reqOpen = sess.checks.filter(function(c){return c.required && !c.done;}).length;
      if(reqOpen > 0){
        add('warning', '📋', 'Checklist attiva con '+reqOpen+' item obbligatori da completare', 'checklist');
      }
    }
  }

  // Avversari: weekend gara mode without competitors entered
  if(typeof _competitors !== 'undefined' && (!_competitors || _competitors.length === 0)){
    // Check if we are in gara session via session-type field
    var sess = document.getElementById('session-type')?.value || '';
    if(/gara|race/i.test(sess)){
      add('suggestion', '🎯', 'Sessione gara senza avversari registrati — aggiungili', 'avversari');
    }
  }

  // Tyre stock: low stock
  if(typeof TYRE_STOCK !== 'undefined' && Array.isArray(TYRE_STOCK)){
    var available = TYRE_STOCK.filter(function(t){return t.status==='available' || t.status==='new';}).length;
    if(available <= 4 && available > 0){
      add('suggestion', '📦', 'Solo '+available+' gomme disponibili in magazzino — riordino?', 'magazzino');
    } else if(available === 0 && TYRE_STOCK.length > 0){
      add('warning', '📦', 'Nessuna gomma disponibile in magazzino', 'magazzino');
    }
  }

  // Spare parts: low stock items (per-mode aware)
  if(typeof SPARE_PARTS !== 'undefined'){
    var spareList = SPARE_PARTS[mode] || [];
    var emptyParts = spareList.filter(function(p){return p.qty===0;});
    var lowParts = spareList.filter(function(p){var m=p.min||0;return m>0 && p.qty>0 && p.qty<=m;});
    if(emptyParts.length){
      // Up to 2 explicit names, else aggregate
      if(emptyParts.length <= 2){
        emptyParts.forEach(function(p){
          add('warning', '🔧', 'Ricambio esaurito: '+p.name+(p.supplier?' ('+p.supplier+')':''), 'spare-parts');
        });
      } else {
        add('warning', '🔧', emptyParts.length+' ricambi esauriti — controlla magazzino', 'spare-parts');
      }
    }
    if(lowParts.length){
      if(lowParts.length <= 2){
        lowParts.forEach(function(p){
          add('suggestion', '📉', 'Scorta bassa: '+p.name+' (×'+p.qty+', min '+p.min+')', 'spare-parts');
        });
      } else {
        add('suggestion', '📉', lowParts.length+' ricambi sotto soglia minima', 'spare-parts');
      }
    }
  }

  // Weather: rain forecasted
  if(typeof METEO_STATE !== 'undefined' && METEO_STATE){
    var cur = METEO_STATE.current;
    if(cur && (cur.rainNext || (cur.condition && /pioggia|rain/i.test(cur.condition)))){
      add('suggestion', '☔', 'Pioggia prevista — valuta gomme intermedie/wet', tyrePage);
    }
  }

  // Photos missing for current tyre set / damage with description
  if(car){
    var lastDmgItem = damages && damages.length ? damages[damages.length-1] : null;
    if(lastDmgItem && lastDmgItem.desc && (typeof photoList === 'function')){
      // Note: we don't await here (sync rule); just hint
      // Skip for performance
    }
  }

  // Sort by priority
  var prioOrder = { critical: 0, warning: 1, suggestion: 2 };
  items.sort(function(a,b){
    return (prioOrder[a.prio]||3) - (prioOrder[b.prio]||3);
  });
  return items;
}
window._todoCheck = _todoCheck;

// Render the widget
function renderWidgetTodo(){
  try {
    var items = _todoCheck();
    if(!items.length){
      return '<div style="padding:14px 6px;text-align:center;font-size:11px;color:var(--text3);line-height:1.6;">'+
        '<div style="font-size:24px;margin-bottom:6px;">✅</div>'+
        '<div>Tutto sotto controllo!</div>'+
        '<div style="font-size:10px;margin-top:4px;color:var(--text3);">Nessuna azione richiesta in questo momento.</div>'+
      '</div>';
    }
    var counts = { critical: 0, warning: 0, suggestion: 0 };
    items.forEach(function(it){ counts[it.prio]++; });
    var prioLabels = {
      critical:   { label: '🔥 CRITICO',     color: 'var(--red)'    },
      warning:    { label: '⚠️ ATTENZIONE',  color: 'var(--yellow)' },
      suggestion: { label: '💡 SUGGERIMENTO', color: 'var(--blue)'  }
    };
    var html = '<div style="padding:2px 0;">';
    // Top summary chips
    html += '<div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:8px;font-size:10px;">';
    if(counts.critical) html += '<span style="background:rgba(213,58,58,0.18);border:1px solid var(--red);color:var(--red);padding:2px 7px;border-radius:10px;font-weight:700;">🔥 '+counts.critical+'</span>';
    if(counts.warning) html += '<span style="background:rgba(245,158,11,0.18);border:1px solid var(--yellow);color:var(--yellow);padding:2px 7px;border-radius:10px;font-weight:700;">⚠️ '+counts.warning+'</span>';
    if(counts.suggestion) html += '<span style="background:rgba(43,125,233,0.18);border:1px solid var(--blue);color:var(--blue);padding:2px 7px;border-radius:10px;font-weight:700;">💡 '+counts.suggestion+'</span>';
    html += '</div>';
    // Render items grouped by priority (max 8 visible)
    var visibleItems = items.slice(0, 8);
    visibleItems.forEach(function(it){
      var meta = prioLabels[it.prio] || prioLabels.suggestion;
      var click = it.page ? 'onclick="showPage(\''+it.page+'\')" style="cursor:pointer;"' : '';
      html += '<div '+click+' style="background:var(--bg3);border-left:3px solid '+meta.color+';border-radius:3px;padding:6px 9px;margin-bottom:4px;font-size:11px;line-height:1.4;'+(it.page?'cursor:pointer;':'')+'">'+
        '<span style="margin-right:5px;">'+it.icon+'</span>'+
        '<span style="color:var(--text1);">'+it.text+'</span>'+
        (it.page ? '<span style="float:right;color:var(--text3);font-size:9px;margin-top:2px;">→</span>' : '')+
      '</div>';
    });
    if(items.length > 8){
      html += '<div style="text-align:center;font-size:10px;color:var(--text3);margin-top:4px;">+'+( items.length-8)+' altri</div>';
    }
    html += '</div>';
    return html;
  } catch(e){
    console.warn('TODO render err', e);
    return '<div style="padding:8px;color:var(--red);font-size:11px;">Errore rendering: '+(e.message||'sconosciuto')+'</div>';
  }
}
