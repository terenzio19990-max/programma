function posAt(pts,t){
  if(!pts||pts.length<2) return null;
  if(t<=pts[0].t) return pts[0];
  if(t>=pts[pts.length-1].t) return pts[pts.length-1];
  var lo=0,hi=pts.length-1;
  while(lo<hi-1){ var m=(lo+hi)>>1; if(pts[m].t<=t) lo=m; else hi=m; }
  var A=pts[lo],B=pts[hi], f=(B.t>A.t)? (t-A.t)/(B.t-A.t):0;
  return { lat:A.lat+(B.lat-A.lat)*f, lon:A.lon+(B.lon-A.lon)*f, v:(A.v!=null&&B.v!=null)? A.v+(B.v-A.v)*f:A.v };
}
