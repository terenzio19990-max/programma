   ═══════════════════════════════════════════════════════════════ */

/* ─── Grouped nav system (6 dropdowns) ───────────────────────── */
.nav-group {
  position: relative;
  display: inline-block;
  flex-shrink: 0;
}
.nav-group-btn {
  background: transparent;
  border: none;
  padding: 6px 14px;
  font-family: var(--head);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: var(--text2);
  cursor: pointer;
  border-radius: 4px;
  transition: background-color .15s, color .15s;
  white-space: nowrap;
}
.nav-group-btn:hover { background: var(--bg3); color: var(--text1); }
.nav-group.open .nav-group-btn {
  background: var(--accent3);
  color: #fff;
}
.nav-group-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  z-index: 1500;
  min-width: 220px;
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: 6px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.4), 0 2px 6px rgba(0,0,0,0.2);
  padding: 6px;
  margin-top: 4px;
  white-space: normal;
}
.nav-group.open .nav-group-menu { display: block; }
.nav-menu-item {
  padding: 8px 14px;
  font-family: var(--head);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  color: var(--text2);
  cursor: pointer;
  border-radius: 3px;
  transition: background-color .12s, color .12s;
  white-space: nowrap;
}
.nav-menu-item:hover {
  background: var(--bg3);
  color: var(--text1);
}
.nav-menu-item.active {
  background: var(--accent3);
  color: #fff;
}

/* On mobile: dropdowns full-width-ish */
@media (max-width: 700px) {
  .nav-group-menu { min-width: 180px; left: 0; }
  .nav-group-btn { padding: 6px 10px; font-size: 11px; }
}

/* Nav: overflow visible so dropdowns can escape the subbar */
#subbar { overflow: visible !important; mask-image: none !important; -webkit-mask-image: none !important; }

/* Nav-tab: gentle hover background for clarity (especially on tablet) */
.nav-tab {
  position: relative;
  transition: color .15s, background-color .15s, border-color .15s;
}
.nav-tab:hover:not(.active) {
  background: rgba(255,255,255,0.04);
}

/* Active tab: thicker bottom border for clearer feedback */
.nav-tab.active {
  border-bottom-width: 3px !important;
  padding-bottom: calc(4px - 1px); /* compensate for thicker border */
}

/* Bottoni: feedback più consistente */
.btn {
  transition: filter .15s, transform .08s, opacity .15s;
}
.btn:not(:disabled):hover { filter: brightness(1.1); }
.btn:not(:disabled):active { transform: scale(0.97); }
.btn:disabled { opacity: 0.45; cursor: not-allowed; }

/* Panel hover: subtile elevation cue */
.panel {
  transition: border-color .2s;
}

/* Form rows: consistent gap and wrap behavior */
.form-row {
  gap: 10px !important;
}
.form-row .field {
  min-width: 0;  /* allow proper flex-shrink */
}

/* Inputs / Selects: focus ring più visibile */
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--accent3) !important;
  box-shadow: 0 0 0 2px rgba(232,66,26,0.15);
}

/* Diary: responsive layout — stack columns on narrow screens */
@media (max-width: 900px) {
  #diary-layout { grid-template-columns: 1fr !important; }
  #diary-list { max-height: none !important; }
  #lessons-layout { grid-template-columns: 1fr !important; }
  #lessons-list { max-height: none !important; }
}

/* Validation states (applied via .val-ok / .val-warn / .val-err) */
input.val-ok {
  border-color: rgba(44,188,110,0.5) !important;
}
input.val-warn {
  border-color: var(--yellow) !important;
  background-image: linear-gradient(45deg, rgba(245,158,11,0.04) 0%, transparent 100%);
}
input.val-err {
  border-color: var(--red) !important;
  background-image: linear-gradient(45deg, rgba(213,58,58,0.06) 0%, transparent 100%);
}
/* Don't override focus ring */
input.val-warn:focus, input.val-err:focus, input.val-ok:focus {
  box-shadow: 0 0 0 2px rgba(232,66,26,0.15);
}

/* Tile (used in summaries): subtle hover */
.tile {
  transition: transform .12s, box-shadow .12s;
}

/* Datatable: row hover */
.data-table tbody tr {
