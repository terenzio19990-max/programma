// KNOWLEDGE BASE — Scheda Vettura permanente
// Storage: REP_knowledge_v1 = { byCarId: { [carId]: profile } }
// profile: { specs:{}, knownIssues:[], milestones:[], notes }
// ═══════════════════════════════════════════════════════════════
var KNOWLEDGE_KEY = 'REP_knowledge_v1';
var _knowledge = null;
var _schedaSelectedCarId = null;

function _kbLoad(){
  if(_knowledge) return _knowledge;
  try {
    _knowledge = JSON.parse(localStorage.getItem(KNOWLEDGE_KEY)||'null') || { byCarId: {} };
    if(!_knowledge.byCarId) _knowledge.byCarId = {};
  } catch(_) { _knowledge = { byCarId: {} }; }
  return _knowledge;
}
function _kbSave(){
  try { localStorage.setItem(KNOWLEDGE_KEY, JSON.stringify(_knowledge||{byCarId:{}})); } catch(_){}
}
function _kbProfile(carId){
  _kbLoad();
  if(!_knowledge.byCarId[carId]){
    _knowledge.byCarId[carId] = {
      specs: {},
      knownIssues: [],
      milestones: [],
      notes: '',
      updatedAt: Date.now()
    };
  }
  return _knowledge.byCarId[carId];
}

// Save current form into the profile
function schedaSaveSpecs(){
  if(!_schedaSelectedCarId) return;
  var p = _kbProfile(_schedaSelectedCarId);
  ['weight','distribution','engine','displacement','power','transmission','brakes','category','chassisNum','year','sponsor'].forEach(function(field){
    var el = document.getElementById('kb-spec-'+field);
    if(el) p.specs[field] = el.value;
  });
  var notesEl = document.getElementById('kb-notes');
  if(notesEl) p.notes = notesEl.value;
  p.updatedAt = Date.now();
  _kbSave();
}
window.schedaSaveSpecs = schedaSaveSpecs;

// Add a known issue
function schedaAddIssue(){
  if(!_schedaSelectedCarId) return;
  var p = _kbProfile(_schedaSelectedCarId);
  var desc = (document.getElementById('kb-new-issue-desc')||{}).value;
  if(!desc || !desc.trim()) { showToast('Inserisci una descrizione'); return; }
  var freq = (document.getElementById('kb-new-issue-freq')||{}).value || 'sporadica';
  var workaround = (document.getElementById('kb-new-issue-wa')||{}).value || '';
  p.knownIssues.push({
    id: Date.now(),
    desc: desc.trim(),
    freq: freq,
    workaround: workaround.trim(),
    addedAt: Date.now()
  });
  p.updatedAt = Date.now();
  _kbSave();
  document.getElementById('kb-new-issue-desc').value = '';
  document.getElementById('kb-new-issue-wa').value = '';
  renderSchedaVetturaPage();
}
window.schedaAddIssue = schedaAddIssue;

function schedaRemoveIssue(issueId){
  if(!_schedaSelectedCarId) return;
  if(!confirm('Rimuovere questo problema noto?')) return;
  var p = _kbProfile(_schedaSelectedCarId);
  p.knownIssues = p.knownIssues.filter(function(i){return i.id !== issueId;});
  p.updatedAt = Date.now();
  _kbSave();
  renderSchedaVetturaPage();
}
window.schedaRemoveIssue = schedaRemoveIssue;

// Milestones
function schedaAddMilestone(){
  if(!_schedaSelectedCarId) return;
  var p = _kbProfile(_schedaSelectedCarId);
  var date = (document.getElementById('kb-new-ms-date')||{}).value;
  var desc = (document.getElementById('kb-new-ms-desc')||{}).value;
  if(!desc || !desc.trim()) { showToast('Inserisci una descrizione'); return; }
  if(!date) date = new Date().toISOString().slice(0,10);
  p.milestones.push({
    id: Date.now(),
    date: date,
    desc: desc.trim(),
    addedAt: Date.now()
  });
  p.updatedAt = Date.now();
  _kbSave();
  document.getElementById('kb-new-ms-desc').value = '';
  renderSchedaVetturaPage();
}
window.schedaAddMilestone = schedaAddMilestone;

function schedaRemoveMilestone(msId){
  if(!_schedaSelectedCarId) return;
  if(!confirm('Rimuovere questa milestone?')) return;
  var p = _kbProfile(_schedaSelectedCarId);
