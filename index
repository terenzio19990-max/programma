    grid.innerHTML='<div class="small" style="grid-column:1/-1;padding:12px;">Nessun treno montato</div>';
    return;
  }
  const c = ts.current;
  const areas = ['fl','fr','rl','rr'];
  grid.innerHTML = WHEELS.map((w,i)=>{
    const wd = c.wheels[w];
    const wear = wd.wear||0;
    const dmg = wd.damage||'none';
    const wClass = wear<40?'wear-low':wear<70?'wear-mid':'wear-high';
    const cardBorder = dmg!=='none'?'var(--red)':wear>70?'var(--yellow)':'var(--border)';
    // Detect if this render is for rally or track based on gridId
    const modeHint = (gridId && gridId.indexOf('rally')>=0) ? 'rally' : 'track';
