  html += '<p>Generato il: '+now+' &nbsp;|&nbsp; PS completate: '+stages.length+' &nbsp;|&nbsp; KM SS: '+stages.reduce((a,s)=>a+(+s.km||0),0).toFixed(1)+'km</p>';

  // Standings
  html += '<h2>CLASSIFICA PROVVISORIA</h2>';
  html += '<table><tr><th>POS</th><th>VETTURA</th><th>TEMPO TOTALE</th><th>DISTACCO</th><th>PS</th><th>KM SS</th><th>STATO</th></tr>';
  const carTimes2 = STATE.rallyCars.map(car=>{
