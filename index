      var st=s.STATE||{};
      if(st.circuit!==key || !st.laps) return;
      Object.keys(st.laps).forEach(function(carId){
        (st.laps[carId]||[]).forEach(function(l){
          var t=(typeof parseTime==='function')? parseTime(l.time):null;
          if(t && (!best || t<best.ms)){
            var setups=(st.setup&&st.setup[carId])||[];
            best={ ms:t, session:s.name, carId:carId,
              carName:(st.trackCars||[]).filter(function(c){return c.id===carId;}).map(function(c){return c.name;})[0]||carId,
              setup: setups.length? setups[setups.length-1] : null };
          }
        });
      });
    });
