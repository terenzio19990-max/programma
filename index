  f.current = v;
  if(typeof buildFuelUI==='function'){ try{ buildFuelUI(car.id); buildFuelLogTable(car.id); }catch(_){} }
  save(); toast('⛽ Misura registrata: '+v.toFixed(1)+'L al giro '+lap);
