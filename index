    if(d.ev==='split'){
      if(Cs.stgLive) Cs.stgLive.splits.push({ i:+d.i, t:+d.t, dl:(d.dl!=null?+d.dl:null), km:(d.km!=null?+d.km:null) });
      var dTxt=(d.dl!=null)? ((+d.dl<0?'−':'+')+(Math.abs(+d.dl)/1000).toFixed(2)):'';
      toast('⏱ '+name+' split '+d.i+(d.km!=null? ' ('+d.km+' km)':'')+': '+fmtLapB(+d.t)+' '+dTxt);
      if(name===LIVE.sel) stageTable();
      return;
    }
    if(d.ev==='end'){
      Cs.stage=String(d.name||Cs.stage||'');
      Cs.stgSplits=(d.sp||[]).slice();
      try {
        if(typeof lifeAddKm==='function' && d.d>200 && !(Cs.legs&&Cs.legs.length))
          lifeAddKm(name, (+d.d)/1000, true, 'prova '+(d.name||''));
      } catch(e){}
      Cs.stgRuns.push({ n:+d.n||Cs.stgRuns.length+1, t:+d.t, s:(d.s||[]).slice(),
                        best:(+d.best===1), b:(d.b!=null?+d.b:null), d:(d.d!=null?+d.d:null), at:Date.now() });
      if(Cs.stgRuns.length>60) Cs.stgRuns.shift();
      Cs.stgLive=null;
      toast('🏁 '+name+' — '+Cs.stage+': '+fmtLapB(+d.t)+(+d.best===1? ' MIGLIORE!':''));
      if(name===LIVE.sel) stageTable();
      return;
    }
    return;
  }
  if(d.k==='perf'){
    var Cp=carState(name);
    Cp.perf.push({ type:String(d.type||''), val:String(d.val||''), unit:String(d.unit||''), t:+d.t||Date.now() });
    if(Cp.perf.length>60) Cp.perf.shift();
    toast('🚀 '+name+' — '+d.type+': '+d.val+' '+d.unit);
    return;
  }
  if(d.k==='lap'){
    var Cl=carState(name);
    Cl.laps.push({ n:+d.n, t:+d.t, tc:(d.tc!=null?+d.tc:null), s:(d.s||[]), vx:(d.vx!=null?+d.vx:null) });
    if(Cl.laps.length>200) Cl.laps.shift();
    Cl.best=(d.b!=null?+d.b:Cl.best); Cl.theo=(d.o!=null?+d.o:Cl.theo);
    /* km del giro nel libretto vita (solo se il telefono non sta gia'
       contando i tratti PS: in pista i giri sono la fonte dei km) */
    try {
      if(typeof lifeAddKm==='function' && !(Cl.legs&&Cl.legs.length)){
        var kmLap=null;
        if(d.km!=null) kmLap=+d.km;
        else if(Cl.pts.length>2 && Cl.laps.length>=2){
          var L2=Cl.laps[Cl.laps.length-1], L1=Cl.laps[Cl.laps.length-2];
          if(L1.tc && L2.tc){
            var dd=0, pp=null;
            Cl.pts.forEach(function(q){ if(q.t>=L1.tc && q.t<=L2.tc){ if(pp) dd+=hav(pp.lat,pp.lon,q.lat,q.lon); pp=q; } });
            if(dd>200) kmLap=dd/1000;
          }
        }
        if(kmLap>0) lifeAddKm(name, kmLap, true, 'giro '+d.n);
      }
    } catch(e){}
    if(d.tr) Cl.track=String(d.tr);
    if(d.pb!=null) Cl.pb=+d.pb;
    if(+d.npb===1) toast('🏆 '+name+': RECORD PERSONALE a '+(Cl.track||'?')+' — '+fmtLapB(+d.t)+'!');
    if(+d.t===Cl.best) toast('🏁 '+name+': GIRO '+d.n+' — '+fmtLapB(+d.t)+' BEST!');
    if(name===LIVE.sel){ lapsTable(); try { cornersTable(); } catch(eC){} }
    return;
  }
  if(d.k==='g'){
    if(d.vf!=null && isFinite(+d.vf)){ C.v=+d.vf; C.vmax=Math.max(C.vmax,(+d.vf)/3.6); }
    C.glat=+d.x||0; C.glong=+d.y||0;
    C.delta=(d.d!=null && isFinite(+d.d))? +d.d : null;
    if(C.glong<-0.35 && C.pts.length){
      var lpB=C.pts[C.pts.length-1];
      var lastB=C.brk.length? C.brk[C.brk.length-1]:null;
      if(!lastB || Math.abs(lastB[0]-lpB.lat)+Math.abs(lastB[1]-lpB.lon)>0.00015){
        C.brk.push([lpB.lat,lpB.lon]); if(C.brk.length>400) C.brk.shift();
        osmBrk(C);
      }
    }
    C.gs.push([+d.t||Date.now(), +C.glat.toFixed(3), +C.glong.toFixed(3)]);
    if(C.gs.length>6000) C.gs=C.gs.filter(function(_,i){ return i%2===0; });
    C.gLatMax=Math.max(C.gLatMax,Math.abs(C.glat));
    C.gLongMax=Math.max(C.gLongMax,Math.abs(C.glong));
    C.lastT=Date.now();
    try { ovUpdate(name); } catch(eO){}
    if(name===LIVE.sel){ refreshSelMetrics(); if(C.gs.length%10===0) gPlot(); }
    carsStrip();
    return;
  }
  if(d.k!=='p') return;
  var p={ lat:+d.a, lon:+d.o, alt:+(d.h||0), v:(d.v!=null? +d.v:null), t:+d.t||Date.now() };
  var last=C.pts[C.pts.length-1];
  if(last) C.dist+=hav(last.lat,last.lon,p.lat,p.lon);
  C.pts.push(p);
  if(p.v!==null){ C.vmax=Math.max(C.vmax,p.v); if(C.v==null) C.v=p.v*3.6; }
  if(d.q!=null) C.q=+d.q;
  C.lastT=Date.now();
  if(C.pts.length===1 && !C.gs.length) gPlot();
  osmUpdate(C,p);
  if(name===LIVE.sel) refreshSelMetrics();
  carsStrip();
  var totPts=0; Object.keys(LIVE.cars).forEach(function(n){ totPts+=LIVE.cars[n].pts.length; });
  if(totPts%5===0) boxPlot();
}

/* mappa: una traccia per vettura */
function boxPlot(){
  if(typeof Plotly==='undefined') return;
  var div=el('rep-live-plot'); if(!div) return;
  var tr=[];
  Object.keys(LIVE.cars).forEach(function(n){
    var C=LIVE.cars[n];
    if(C.pts.length<2) return;
    tr.push({ x:C.pts.map(function(p){return p.lon;}), y:C.pts.map(function(p){return p.lat;}),
      mode:'lines', name:n, line:{width:4,color:C.color}, hoverinfo:'name' });
    var lp=C.pts[C.pts.length-1];
    tr.push({ x:[lp.lon], y:[lp.lat], mode:'markers', showlegend:false,
      marker:{size:12,color:C.color,line:{width:2,color:'#fff'}}, hoverinfo:'skip' });
  });
  if(!tr.length) return;
  try {
    Plotly.react(div,tr,{ margin:{l:0,r:0,t:0,b:0}, xaxis:{visible:false}, yaxis:{visible:false,scaleanchor:'x'},
      paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)',
      legend:{font:{color:'#8a90a0'},orientation:'h'}, height:280 },
      { displayModeBar:false, staticPlot:true });
  } catch(e){}
}
/* cerchio d'attrito della vettura selezionata */
function gPlot(){
  if(typeof Plotly==='undefined') return;
  var div=el('rep-live-gplot'); if(!div) return;
  var C=LIVE.cars[LIVE.sel];
  var gs=C? C.gs:[], empty=!gs.length;
  var recent=gs.slice(-400), xs=[], ys=[];
  for(var i=0;i<recent.length;i++){ xs.push(recent[i][1]); ys.push(recent[i][2]); }
  var last=recent[recent.length-1]||[0,0,0];
  var rMax=Math.max(1.2, C? C.gLatMax*1.15:0, C? C.gLongMax*1.15:0);
  try {
    Plotly.react(div,[
      { x:xs, y:ys, mode:'markers', marker:{size:4,color:'rgba(0,229,255,.35)'}, hoverinfo:'skip' },
      { x:[last[1]], y:[last[2]], mode:'markers', marker:{size:11,color:(C?C.color:'#ff3b30')}, hoverinfo:'skip' }
    ],{ title: empty? {text:'Cerchio d\'attrito'+(C?' — '+C.name:'')+' — in attesa delle g (calibrazione sul telefono: una frenata decisa)',font:{size:11,color:'#8a90a0'}}
               : {text:'Cerchio d\'attrito — '+(C?C.name:''),font:{size:11,color:'#8a90a0'}},
        margin:{l:26,r:8,t:28,b:24},
        xaxis:{title:'g lat',range:[-rMax,rMax],zeroline:true,gridcolor:'rgba(128,140,160,.15)',color:'#8a90a0',dtick:0.5},
        yaxis:{title:'g long',range:[-rMax,rMax],zeroline:true,gridcolor:'rgba(128,140,160,.15)',color:'#8a90a0',dtick:0.5,scaleanchor:'x'},
        shapes:[{type:'circle',x0:-1,x1:1,y0:-1,y1:1,line:{color:'rgba(255,214,10,.5)',dash:'dot'}}],
        paper_bgcolor:'rgba(0,0,0,0)', plot_bgcolor:'rgba(0,0,0,0)', showlegend:false, height:270 },
      { displayModeBar:false, staticPlot:true });
  } catch(e){}
}

/* salvataggio per vettura */
function finishCar(C){
  if(!C || C.saved || C.pts.length<10) return;
  C.saved=true;
  try {
    var name='LIVE '+C.name+' '+new Date().toLocaleString('it-IT',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
    var o=JSON.parse(localStorage.getItem('REP_routes_v1')||'{}');
    if(o[name]) name=name+' ('+Math.floor(Math.random()*90+10)+')';
    var t00=C.pts[0].t;
    o[name]={ lats:C.pts.map(function(p){return +p.lat.toFixed(6);}),
              lons:C.pts.map(function(p){return +p.lon.toFixed(6);}),
              alts:C.pts.map(function(p){return +(+p.alt).toFixed(1);}),
              ts:C.pts.map(function(p){return p.t-t00;}),
              spd:C.pts.map(function(p){return p.v!=null? +(p.v*3.6).toFixed(1):null;}),
              gs:C.gs.slice(0,4000).map(function(g){return [g[0]-t00,g[1],g[2]];}),
              gLatMax:+C.gLatMax.toFixed(3), gLongMax:+C.gLongMax.toFixed(3),
              savedAt:new Date().toISOString() };
    localStorage.setItem('REP_routes_v1', JSON.stringify(o));
    var gTxt = C.gLatMax>0.15? ' · ay max '+C.gLatMax.toFixed(2)+' g (utile per il FIT µ in 📊 CALIBR.)':'';
    setT('rep-live-hstat','✅ Percorso "'+name+'" salvato ('+(C.dist/1000).toFixed(2)+' km, Vmax '+(C.vmax*3.6).toFixed(0)+' km/h'+gTxt+').');
    toast('📡 Percorso "'+name+'" salvato');
    try { if(typeof repFillRoutes==='function') repFillRoutes(); } catch(e){}
  } catch(e){}
}
function finishAll(force){
  Object.keys(LIVE.cars).forEach(function(n){
    var C=LIVE.cars[n];
    if(force || (C.lastT && Date.now()-C.lastT>15000)) finishCar(C);
  });
}

/* ═══ TELEFONO (dentro il software, per test): trasmissione ═══ */
window.repLiveConnect = function(){
  if(LIVE.txOn){
    try { if(LIVE.txConn&&LIVE.txConn.open!==false) LIVE.txConn.send({k:'end'}); } catch(e){}
    teardownTx();
    setT('rep-live-tstat','Scollegato.');
    var b0=el('rep-live-tbtn'); if(b0) b0.textContent='🔗 CONNETTI';
    return;
  }
  var code=String((el('rep-live-code-in')||{}).value||'').trim().toLowerCase();
  if(code.length<4){ setT('rep-live-tstat','Inserisci il codice mostrato sul PC box.'); return; }
  if(typeof _ensurePeerJS!=='function'){ setT('rep-live-tstat','PeerJS non presente in questa build'); return; }
  teardownTx();
  setT('rep-live-tstat','Connessione…');
  _ensurePeerJS(function(){
   repIce(function(ice){
    try { LIVE.txPeer=new Peer(ice? {debug:0, config:ice} : {debug:0}); }
    catch(e){ setT('rep-live-tstat','Errore: '+e.message); return; }
    LIVE.txOn=true;
    LIVE.txPeer.on('open', function(){
      var conn=LIVE.txPeer.connect('reptel-'+code,{reliable:true});
      LIVE.txConn=conn;
      conn.on('open', function(){
        setT('rep-live-tstat','📡 Collegato al box — premi START qui sopra per trasmettere.');
        var b=el('rep-live-tbtn'); if(b) b.textContent='✂ STACCA';
      });
      conn.on('close', function(){ setT('rep-live-tstat','Connessione chiusa dal box.'); LIVE.txConn=null; });
      conn.on('error', function(){ setT('rep-live-tstat','Errore connessione dati.'); });
    });
    LIVE.txPeer.on('error', function(err){ setT('rep-live-tstat','Errore: '+errMsg(err.type||err.message)); });
   });
  }, function(){ setT('rep-live-tstat','PeerJS non caricabile (serve internet).'); });
};

