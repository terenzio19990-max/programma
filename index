var _onboardStep = 0;

function startOnboarding(){
  _onboardStep = 0;
  var modal = document.getElementById('help-modal');
  if(modal) modal.style.display='none';
  document.getElementById('onboard-overlay').style.display='block';
  _renderOnboardStep();
}
function endOnboarding(){
  document.getElementById('onboard-overlay').style.display='none';
}
function onboardNext(){
  if(_onboardStep >= ONBOARD_STEPS.length - 1){ endOnboarding(); try { localStorage.setItem('REP_onboard_done','1'); } catch(e){} return; }
  _onboardStep++;
  _renderOnboardStep();
}
function onboardPrev(){
  if(_onboardStep > 0){ _onboardStep--; _renderOnboardStep(); }
}
function _renderOnboardStep(){
  var step = ONBOARD_STEPS[_onboardStep];
  if(!step) return;
  // Update counter/title/body
  document.getElementById('onboard-step-counter').textContent = (_onboardStep+1)+' / '+ONBOARD_STEPS.length;
  document.getElementById('onboard-title').innerHTML = step.title;
  document.getElementById('onboard-body').innerHTML = step.body;
  // Prev/Next state
  var prevBtn = document.getElementById('onboard-prev');
  var nextBtn = document.getElementById('onboard-next');
  if(prevBtn) prevBtn.disabled = _onboardStep===0;
  if(prevBtn) prevBtn.style.opacity = _onboardStep===0 ? 0.4 : 1;
  if(nextBtn) nextBtn.textContent = (_onboardStep>=ONBOARD_STEPS.length-1) ? '✓ FINITO' : 'AVANTI ▶';
  // Dots
  var dotsEl = document.getElementById('onboard-dots');
  if(dotsEl){
    dotsEl.innerHTML = ONBOARD_STEPS.map(function(_,i){
      return '<span style="width:7px;height:7px;border-radius:50%;background:'+(i===_onboardStep?'var(--accent3)':'var(--border2)')+';"></span>';
    }).join('');
  }
  // Locate target
  var target = null;
  try { target = document.querySelector(step.selector); } catch(e){}
  var vw = window.innerWidth, vh = window.innerHeight;
  if(!target){
    // Fallback: center tooltip, hide highlight
    _placeHighlight(null);
    _placeTooltip(vw/2 - 200, vh/2 - 100);
    return;
  }
  var rect = target.getBoundingClientRect();
  // Scroll into view if needed
  if(rect.bottom < 0 || rect.top > vh){
    target.scrollIntoView({behavior:'smooth', block:'center'});
    setTimeout(_renderOnboardStep, 350);
    return;
  }
  _placeHighlight(rect);
  // Place tooltip based on placement preference
  var tpX, tpY;
  var tpW = 420, tpH = 200;
  switch(step.placement){
    case 'right':
      tpX = rect.right + 18;
      tpY = rect.top + rect.height/2 - tpH/2;
      break;
    case 'left':
      tpX = rect.left - tpW - 18;
      tpY = rect.top + rect.height/2 - tpH/2;
      break;
    case 'top':
      tpX = rect.left + rect.width/2 - tpW/2;
      tpY = rect.top - tpH - 18;
      break;
    case 'bottom':
    default:
      tpX = rect.left + rect.width/2 - tpW/2;
      tpY = rect.bottom + 18;
  }
  // Clamp to viewport
  tpX = Math.max(12, Math.min(vw - tpW - 12, tpX));
  tpY = Math.max(12, Math.min(vh - tpH - 12, tpY));
  _placeTooltip(tpX, tpY);
}
function _placeHighlight(rect){
  var hi = document.getElementById('onboard-highlight');
  var hole = document.getElementById('onboard-hole-rect');
  if(!rect){
    if(hi) hi.style.display='none';
    if(hole) { hole.setAttribute('x',-10); hole.setAttribute('y',-10); hole.setAttribute('width',0); hole.setAttribute('height',0); }
    return;
  }
  if(hi){
    hi.style.display='block';
    hi.style.left = (rect.left - 5) + 'px';
    hi.style.top  = (rect.top - 5) + 'px';
    hi.style.width  = (rect.width + 10) + 'px';
    hi.style.height = (rect.height + 10) + 'px';
  }
  if(hole){
    hole.setAttribute('x', rect.left - 5);
    hole.setAttribute('y', rect.top - 5);
    hole.setAttribute('width',  rect.width + 10);
    hole.setAttribute('height', rect.height + 10);
  }
}
function _placeTooltip(x,y){
  var tt = document.getElementById('onboard-tooltip');
  if(tt){ tt.style.left = x+'px'; tt.style.top = y+'px'; }
}

