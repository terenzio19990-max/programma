  out += '<div class="panel"><div class="panel-head">🛞 STATISTICHE PER MESCOLA</div><div class="panel-body" style="overflow-x:auto;">'+
    '<table class="data-table"><thead><tr><th>MESCOLA</th><th># GOMME</th><th>KM CUMUL.</th><th>KM MEDI</th><th>USURA MEDIA</th><th>DANNI</th><th>% DANNI</th></tr></thead><tbody>';
  compounds.sort().forEach(function(cpd){
    var d = perCpd[cpd];
    var avgKm = d.count ? d.km/d.count : 0;
    var avgWear = d.count ? d.sumWear/d.count : 0;
    var dmgPct = d.count ? d.damages/d.count*100 : 0;
    var wearColor = avgWear < 40 ? 'var(--green)' : avgWear < 70 ? 'var(--yellow)' : 'var(--red)';
    out += '<tr>'+
      '<td><span class="tyre-compound cpd-'+cpd+'">'+cpd+'</span></td>'+
      '<td>'+d.count+'</td>'+
