  html += '<p style="font-size:11px;">Set montati totali nel weekend: <b>'+setMounts+'</b></p>';

  var totalDamages = 0;
  allCars.forEach(function(car){
    totalDamages += (STATE.damage[car.id]||[]).length;
  });
  totalDamages += (STATE.rallyDamage||[]).length;
  html += '<p style="font-size:11px;">Eventi di danno registrati: <b>'+totalDamages+'</b></p>';

  html += '<div class="footer">Race Engineer Pro · Weekend Report · '+now+' · Premi <b>Ctrl+P</b> per salvare come PDF</div></body></html>';
  var w = window.open('','_blank');
  if(w){ w.document.write(html); w.document.close(); setTimeout(function(){w.print();},800); }
  showToast('✅ Weekend report aperto · Ctrl+P → Salva PDF');
}
