  var count=0;
  entries.forEach(function(e,i){
    var mine=STATE.trackCars.some(function(c){ return e.name&&c.name&&e.name.toLowerCase().includes(c.name.split(' ')[0].toLowerCase().substring(0,4)); });
    if(!mine&&typeof _competitors!=='undefined'&&e.best&&e.best!=='—'&&parseTime(e.best)){
      var ex=_competitors.find(function(c){return c.name===e.name;});
      if(!ex){ _competitors.push({id:Date.now()+i,name:e.name,cls:'LiveTiming',color:'#8b5cf6',laps:[{lap:1,time:e.best}]}); count++; }
    }
    if(mine) ltAutoImport([e]);
  });
  if(typeof renderCompetitorsList==='function') renderCompetitorsList();
  if(typeof updateCompGaps==='function') updateCompGaps();
  if(typeof buildLapsPage==='function') buildLapsPage();
