function closeBarcodeScanner() {
  stopBarcodeCamera();
  var modal = document.getElementById('barcode-modal');
  if(modal) modal.style.display = 'none';
}
// ─── Cross-browser scanner ───
// Strategy: native BarcodeDetector (Chrome/Android, fast) → fallback ZXing
// (Safari/iOS, Firefox). Requires a secure context (https/localhost); on
// file:// getUserMedia is blocked, so we show a clear message + manual input.
var _zxingReader  = null;
var _zxingLoading = false;

function _cameraSecureContext(){
  return window.isSecureContext === true
      || location.protocol === 'https:'
      || location.hostname === 'localhost'
      || location.hostname === '127.0.0.1';
}
function _showManualBarcode(){
  var m = document.getElementById('barcode-manual-wrap');
  if(m) m.style.display = 'block';
}
function _loadZXing(cb){
  if(window.ZXing && window.ZXing.BrowserMultiFormatReader){ cb(true); return; }
  if(_zxingLoading){
    var waited = 0;
    var t = setInterval(function(){
      if(window.ZXing && window.ZXing.BrowserMultiFormatReader){ clearInterval(t); cb(true); }
      else if((waited += 150) > 9000){ clearInterval(t); cb(false); }
    }, 150);
    return;
  }
  _zxingLoading = true;
  var cdns = [
    'https://cdn.jsdelivr.net/npm/@zxing/[email protected]/umd/index.min.js',
    'https://unpkg.com/@zxing/[email protected]/umd/index.min.js'
  ];
  var i = 0;
  (function tryNext(){
    if(i >= cdns.length){ _zxingLoading = false; cb(false); return; }
    var sc = document.createElement('script');
    sc.src = cdns[i++];
    sc.onload  = function(){ _zxingLoading = false; cb(!!(window.ZXing && window.ZXing.BrowserMultiFormatReader)); };
    sc.onerror = function(){ tryNext(); };
    document.head.appendChild(sc);
  })();
}

function startBarcodeCamera() {
  var statusEl = document.getElementById('barcode-status');
  var resEl = document.getElementById('barcode-result');
  if(resEl) resEl.style.display = 'none';
  _showManualBarcode();

  if(!_cameraSecureContext()){
    if(statusEl) statusEl.innerHTML = '<span style="color:var(--yellow);">⚠ La fotocamera non è disponibile aprendo il file localmente (file://).<br>Pubblica l\'app su un indirizzo <b>https</b> (menu ⚙ → Deploy / Netlify) per usare lo scanner, oppure inserisci il codice manualmente qui sotto.</span>';
    return;
  }
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    if(statusEl) statusEl.innerHTML = '<span style="color:var(--yellow);">⚠ Questo browser non espone la fotocamera. Inserisci il codice manualmente.</span>';
    return;
  }

  if('BarcodeDetector' in window){
    startBarcodeNative(statusEl);
  } else {
    if(statusEl) statusEl.textContent = 'Carico il lettore codici…';
    _loadZXing(function(ok){
      if(ok) startBarcodeZXing(statusEl);
      else { if(statusEl) statusEl.innerHTML = '<span style="color:var(--red);">Impossibile caricare il lettore codici (connessione assente?). Inserisci il codice manualmente.</span>'; }
    });
  }
}

function startBarcodeNative(statusEl){
  if(statusEl) statusEl.textContent = 'Avvio camera…';
  navigator.mediaDevices.getUserMedia({video:{facingMode:'environment',width:{ideal:1280},height:{ideal:720}}})
    .then(function(stream) {
      _barcodeStream = stream;
      var video = document.getElementById('barcode-video');
      if(video) { video.srcObject = stream; video.play().catch(function(){}); }
      if(statusEl) statusEl.textContent = 'Punta la camera sul codice (barcode, QR, DataMatrix, DOT)…';
      try {
        _barcodeDetector = new BarcodeDetector({formats:['code_128','code_39','ean_13','ean_8','qr_code','data_matrix','upc_a','upc_e','itf']});
      } catch(e) {
        _barcodeDetector = new BarcodeDetector();
      }
      _barcodeScanInterval = setInterval(function() {
        var v = document.getElementById('barcode-video');
        if(!v||!v.videoWidth) return;
        _barcodeDetector.detect(v).then(function(codes) {
          if(codes && codes.length > 0) {
            var code = codes[0].rawValue;
            clearInterval(_barcodeScanInterval); _barcodeScanInterval = null;
            handleBarcodeResult(code);
          }
        }).catch(function(){});
      }, 200);
    })
    .catch(function(err) {
      if(statusEl) statusEl.innerHTML = '<span style="color:var(--red);">Errore camera: ' + (err && err.message ? err.message : err) + '</span>';
      _showManualBarcode();
    });
}

function startBarcodeZXing(statusEl){
  var video = document.getElementById('barcode-video');
  try {
    _zxingReader = new ZXing.BrowserMultiFormatReader();
  } catch(e){
    if(statusEl) statusEl.innerHTML = '<span style="color:var(--red);">Errore lettore: ' + e.message + '</span>';
    return;
  }
  if(statusEl) statusEl.textContent = 'Avvio camera…';
  _zxingReader.decodeFromConstraints(
    {video:{facingMode:'environment'}},
    video,
    function(result, err){
      if(result){
        var code = result.getText ? result.getText() : ('' + result);
        stopBarcodeCamera();
        handleBarcodeResult(code);
      }
    }
  ).then(function(){
    if(statusEl) statusEl.textContent = 'Punta la camera sul codice (barcode, QR, DataMatrix, DOT)…';
    if(video && video.srcObject) _barcodeStream = video.srcObject;
  }).catch(function(err){
    if(statusEl) statusEl.innerHTML = '<span style="color:var(--red);">Errore camera: ' + (err && err.message ? err.message : err) + '</span>';
    _showManualBarcode();
  });
}

function stopBarcodeCamera() {
  if(_barcodeScanInterval) { clearInterval(_barcodeScanInterval); _barcodeScanInterval = null; }
  if(_zxingReader) { try { _zxingReader.reset(); } catch(_){} _zxingReader = null; }
  if(_barcodeStream) { try { _barcodeStream.getTracks().forEach(function(t){t.stop();}); } catch(_){} _barcodeStream = null; }
  var video = document.getElementById('barcode-video');
  if(video) { video.srcObject = null; }
}
function handleBarcodeResult(code) {
  stopBarcodeCamera();
  var resultEl = document.getElementById('barcode-result');
  var statusEl = document.getElementById('barcode-status');
  if(statusEl) statusEl.innerHTML = '<span style="color:var(--green);">✓ Codice rilevato!</span>';
  if(resultEl) {
    resultEl.style.display = 'block';
    document.getElementById('barcode-code-display').textContent = code;
  }

  // ─── Route the result depending on target ───
  if(_barcodeTarget && _barcodeTarget.kind === 'input'){
    // Generic: put into specified input element (ask apply button to confirm)
    // Nothing to do here yet — user clicks "Applica" to copy
    showToast('Codice pronto — clicca "Applica" per inserirlo');
    return;
  }
  if(_barcodeTarget && _barcodeTarget.kind === 'tyre'){
    // Direct write to mount-form input (before mounting the set)
    var inp = document.getElementById(_barcodeTarget.prefix + 'code-' + _barcodeTarget.wheel);
    if(inp) inp.value = code;
    showToast('✓ Codice '+_barcodeTarget.wheel+' inserito: '+code);
    // Auto-close after short delay
    setTimeout(closeBarcodeScanner, 700);
    return;
  }
  if(_barcodeTarget && _barcodeTarget.kind === 'tyre-mounted'){
    // Update the currently-mounted tyre code on the selected car
    var w = _barcodeTarget.wheel;
    var mode = _barcodeTarget.mode || STATE.mode;
    var car = mode==='track' ? STATE.trackCars[STATE.selectedTrackCar] : STATE.rallyCars[STATE.selectedRallyCar];
    var ts = mode==='track' ? STATE.tyres[car.id] : STATE.rallyTyres[car.id];
    if(ts && ts.current && ts.current.wheels && ts.current.wheels[w]){
      ts.current.wheels[w].code = code;
      showToast('✓ Codice '+w+' aggiornato: '+code);
      if(typeof renderTyreGrid==='function'){
        if(mode==='track') renderTyreGrid(ts, 'tyre-grid-current', 'tyre-km-disp');
        else               renderTyreGrid(ts, 'rally-tyre-grid-current', 'rally-tyre-km-disp');
      }
      if(typeof triggerAutoSave==='function') triggerAutoSave();
    } else {
      showToast('⚠️ Nessun treno montato — scan fallito');
    }
    setTimeout(closeBarcodeScanner, 700);
    return;
  }

  // Default behavior: spare parts
  var nameEl = document.getElementById('spare-name');
  if(nameEl) nameEl.value = code;
  var allParts = SPARE_PARTS.track.concat(SPARE_PARTS.rally);
  var match = allParts.find(function(p){return p.barcode===code || p.name===code;});
  if(match) {
    showToast('✓ Pezzo trovato: ' + match.name + ' (' + (match.qty||0) + ' in magazzino)');
  } else {
    showToast('Nuovo pezzo: ' + code + ' — aggiungi i dettagli e salva');
  }
}
function barcodeScanManual() {
  var val = (document.getElementById('barcode-manual-input')||{}).value;
