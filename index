CB.setComp=function(car,id,f,v){ edit(function(o){ var k=compKey(car,id); o.comp[k]=o.comp[k]||{}; o.comp[k][f]=num(v,0); }); render(); };
CB.setCons=function(car,id,f,v){ edit(function(o){ (o.cons[car]||[]).forEach(function(c){ if(c.id===id) c[f]=num(v,0); }); }); render(); };
CB.delCons=function(car,id){ edit(function(o){ o.cons[car]=(o.cons[car]||[]).filter(function(c){ return c.id!==id; }); }); render(); };
CB.addCons=function(car){
  var n=prompt('Voce di consumo (es. Treno gomme, Carburante giornata):','');
  if(n===null||!String(n).trim()) return;
  var cost=num(prompt('Costo di una unità ('+load().cfg.cur+'):','0'),0);
  var kl=num(prompt('Quanti km dura?','300'),0);
  edit(function(o){ o.cons[car]=o.cons[car]||[]; o.cons[car].push({id:uid('c'),name:String(n).trim(),cost:cost,kmLife:kl}); });
  render();
};
CB.consPreset=function(car){
  var P=[['Treno gomme',1200,300],['Carburante',180,120],['Olio motore',120,1500],['Olio cambio',90,2500],['Filtri',60,1500]];
  edit(function(o){
    o.cons[car]=o.cons[car]||[];
    P.forEach(function(p){
      if(o.cons[car].some(function(x){ return x.name===p[0]; })) return;
      o.cons[car].push({id:uid('c'),name:p[0],cost:p[1],kmLife:p[2]});
    });
  });
  render(); toast('Voci tipiche aggiunte — correggi importi e durate con i tuoi numeri');
};
CB.addFixed=function(){
  var n=prompt('Costo fisso (es. Iscrizione, Trasferta, Meccanici):','');
  if(n===null||!String(n).trim()) return;
  var a=num(prompt('Importo ('+load().cfg.cur+'):','0'),0);
  var per=prompt('Ogni: gara / giorno / stagione','gara');
  per=String(per||'gara').trim().toLowerCase();
  if(['gara','giorno','stagione'].indexOf(per)<0) per='gara';
  edit(function(o){ o.fixed.push({id:uid('f'),name:String(n).trim(),amount:a,per:per}); });
  render();
};
CB.fixedPreset=function(){
  var P=[['Iscrizione gara',600,'gara'],['Trasferta e camion',800,'gara'],['Vitto e alloggio',400,'gara'],
         ['Meccanici',700,'gara'],['Assicurazione e licenze',1500,'stagione']];
  edit(function(o){
    P.forEach(function(p){
      if(o.fixed.some(function(x){ return x.name===p[0]; })) return;
      o.fixed.push({id:uid('f'),name:p[0],amount:p[1],per:p[2]});
    });
  });
  render(); toast('Voci tipiche aggiunte — sono numeri di esempio, mettici i tuoi');
};
CB.setFixed=function(id,f,v){ edit(function(o){ o.fixed.forEach(function(x){ if(x.id===id) x[f]=(f==='amount')?num(v,0):String(v); }); }); render(); };
CB.delFixed=function(id){ edit(function(o){ o.fixed=o.fixed.filter(function(x){ return x.id!==id; }); }); render(); };
CB.addSpendManual=function(){
  var n=prompt('Descrizione della spesa:','');
  if(n===null||!String(n).trim()) return;
  var a=num(prompt('Importo ('+load().cfg.cur+'):','0'),0);
  if(a<=0){ toast('Importo non valido'); return; }
  addSpend({ car:curCar()||'', label:String(n).trim(), amount:a, cat:'manuale' });
  render(); toast('Spesa registrata');
};
CB.delSpend=function(id){
  if(!confirm('Eliminare questa spesa dal registro?')) return;
  edit(function(o){ o.spend=o.spend.filter(function(s){ return s.id!==id; }); });
  render();
};
CB.exportCSV=function(){
  try {
    var o=load(), rows=['tipo;vettura;voce;importo;data;note'];
    o.spend.forEach(function(s){
      rows.push(['spesa', s.car||'', s.label||'', (+s.amount||0).toFixed(2), new Date(s.ts).toISOString().slice(0,10), s.note||''].join(';'));
    });
    cars().forEach(function(c){
      var pk=perKm(c);
      pk.rows.forEach(function(r){
        rows.push([(r.isCons?'consumo':'componente'), c, r.name, (+r.cost||0).toFixed(2), '', 'al km '+r.perKm.toFixed(4)].join(';'));
      });
      var S=season(c);
      rows.push(['riepilogo', c, 'costo al km', pk.total.toFixed(4), '', ''].join(';'));
      rows.push(['riepilogo', c, 'costo gara', S.perRace.toFixed(2), '', ''].join(';'));
      rows.push(['riepilogo', c, 'previsione fine stagione', S.forecast.toFixed(2), '', 'budget '+S.budget.toFixed(2)].join(';'));
    });
    var a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob(['﻿'+rows.join('\n')],{type:'text/csv;charset=utf-8'}));
    a.download='costi_budget_'+new Date().toISOString().slice(0,10)+'.csv';
    a.click();
    toast('Esportato');
  } catch(e){ toast('Export fallito: '+e.message); }
};

/* ─── aggancio: "FATTO" nel libretto ⇒ spesa registrata da sola ──────────── */
if(typeof window.lifeReset==='function' && !window._cbLifeWrapped){
  window._cbLifeWrapped=true;
  var _oReset=window.lifeReset;
  window.lifeReset=function(carName, id){
    var before=null;
    try {
      var L=life(), C=L.cars[carName];
      var p=C && (C.comps||[]).filter(function(x){ return x.id===id; })[0];
      if(p) before={ name:p.name, kind:p.kind, hist:(p.hist||[]).length, cost:compCost(carName,p).total };
    } catch(e){}
    var r=_oReset.apply(this, arguments);
    try {
      var L2=life(), C2=L2.cars[carName];
      var p2=C2 && (C2.comps||[]).filter(function(x){ return x.id===id; })[0];
      var done = before && p2 && (p2.hist||[]).length > before.hist;    // l'intervento è stato confermato
      if(done){
        if(before.cost>0){
          addSpend({ car:carName, cat:'intervento', auto:true,
                     label:(before.kind||'intervento')+' '+before.name, amount:before.cost });
          toast('💶 Registrata spesa '+money(before.cost)+' — '+before.name);
        } else {
          toast('💶 Nessun costo impostato per '+before.name+': aggiungilo in Costi e budget');
        }
      }
    } catch(e){}
    try { render(); } catch(e){}
    return r;
  };
}

/* ─── i costi entrano nei salvataggi e nei ripristini di sessione ─────────── */
if(typeof window.serializeSession==='function' && !window._cbSerWrapped){
  window._cbSerWrapped=true;
  var _oSer=window.serializeSession;
  window.serializeSession=function(){
    var snap=_oSer.apply(this, arguments);
    try { if(snap){ snap._repModules=snap._repModules||{}; var v=localStorage.getItem(KEY); if(v!==null) snap._repModules[KEY]=v; } } catch(e){}
    return snap;
  };
}
if(typeof window.restoreSession==='function' && !window._cbResWrapped){
  window._cbResWrapped=true;
  var _oRes=window.restoreSession;
  window.restoreSession=function(snap){
    try { if(snap && snap._repModules && snap._repModules[KEY]) localStorage.setItem(KEY, snap._repModules[KEY]); } catch(e){}
    var r=_oRes.apply(this, arguments);
    setTimeout(function(){ try{ render(); }catch(e){} }, 220);
    return r;
  };
}

/* ─── pagina ──────────────────────────────────────────────────────────────── */
function inject(){
  if(document.getElementById('page-costs')) return;
  var anyPage=document.querySelector('.page');
  var main=anyPage && anyPage.parentNode;
  if(!main) return;
  var pg=document.createElement('div');
  pg.className='page'; pg.id='page-costs';
  pg.innerHTML='<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">'+
    '<div style="font-family:var(--head);font-size:20px;font-weight:700;letter-spacing:2px;color:var(--accent3)">💶 COSTI E BUDGET</div>'+
    '<span class="small" style="opacity:.65">costo al km, costo giornata, proiezione di stagione</span></div>'+
    '<div id="cb-body"></div>';
  main.appendChild(pg);
  try { if(window.PAGES && !window.PAGES.some(function(p){ return p[0]==='costs'; })) window.PAGES.push(['costs','💶 Costi e budget']); } catch(e){}
  /* pulsante dalla pagina Libretto vita */
  try {
    var lp=document.getElementById('page-life');
    if(lp && !document.getElementById('cb-goto')){
      var b=document.createElement('button');
      b.id='cb-goto'; b.className='btn btn-gray';
      b.style.cssText='padding:5px 12px;font-size:11px;margin-left:auto';
      b.textContent='💶 COSTI E BUDGET';
      b.onclick=function(){ showPage('costs'); };
      var hdr=lp.querySelector('div');
      if(hdr) hdr.appendChild(b);
    }
  } catch(e){}
  render();
}
if(typeof window.showPage==='function' && !window._cbPageWrapped){
  window._cbPageWrapped=true;
  var _oP=window.showPage;
  window.showPage=function(id){
    var r=_oP.apply(this, arguments);
    if(id==='costs') setTimeout(render, 60);
    return r;
  };
}
function boot(){ inject(); render(); }
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(boot, 1200); });
else setTimeout(boot, 1200);
setTimeout(inject, 3000);
setTimeout(inject, 7000);

})();

</script>
<script>
/* ═══════════════════════════════════════════════════════════════════════════
   LAVAGNA LAVORI SQUADRA (WB) — v1.0
   Chi fa cosa fra una PS e l'altra: lavori assegnati ai meccanici, checklist
   con spunta, tempi stimati contro il tempo di assistenza che resta.
   I dati stanno in STATE.workboard: così viaggiano da soli nei salvataggi,
   nei ripristini e sul coop (più dispositivi in assistenza).
   ═══════════════════════════════════════════════════════════════════════════ */
(function(){
'use strict';
if(window.WB) return;

var COLORS=['#2b7de9','#1aada0','#8b5cf6','#e0793a','#3fbf6f','#d64550','#c9a227','#5b8def'];

/* ─── utilità ─────────────────────────────────────────────────────────────── */
function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function toast(m){ try{ if(typeof showToast==='function') showToast(m); }catch(e){} }
function num(v,d){ var x=parseFloat(String(v==null?'':v).replace(',','.')); return isFinite(x)? x:(d||0); }
function uid(p){ return (p||'w')+Date.now().toString(36)+Math.floor(Math.random()*1e4).toString(36); }
function now(){ return Date.now(); }

function board(){
  if(typeof STATE==='undefined') return null;
  if(!STATE.workboard || typeof STATE.workboard!=='object'){
    STATE.workboard={ crew:[], jobs:[], win:{ label:'Assistenza', endsAt:null, minutes:30 }, v:1 };
  }
  var B=STATE.workboard;
  B.crew=B.crew||[]; B.jobs=B.jobs||[];
  B.win=B.win||{ label:'Assistenza', endsAt:null, minutes:30 };
  return B;
}

/* salva in locale e manda agli altri dispositivi */
function commit(desc){
  try { if(typeof triggerAutoSave==='function') triggerAutoSave(); } catch(e){}
  try {
    if(typeof coopBroadcastPatch==='function' && typeof COOP!=='undefined' &&
       COOP.status!=='disconnected' && !COOP.applyingRemote){
      coopBroadcastPatch('STATE.workboard','set', STATE.workboard, desc||'lavagna lavori');
    }
  } catch(e){}
  render();
}

/* ─── lavori tipici ───────────────────────────────────────────────────────── */
var TPL=[
  ['Cambio gomme', 12, ['Coppie di serraggio','Pressioni a freddo','Segnare il set usato']],
  ['Controllo serraggi', 10, ['Ruote','Bracci sospensione','Scarico','Sottoscocca']],
  ['Rifornimento', 8, ['Litri annotati','Tappo chiuso','Estintore a portata']],
  ['Spurgo freni', 20, ['Liquido a livello','Pedale duro','Nessuna perdita']],
  ['Controllo geometrie', 25, ['Convergenza ant.','Convergenza post.','Camber','Altezze']],
  ['Pulizia radiatori', 10, ['Radiatore acqua','Intercooler','Radiatore olio']],
  ['Controllo livelli', 8, ['Olio motore','Acqua','Freni','Servosterzo']],
  ['Controllo danni', 12, ['Sottoscocca','Sospensioni','Carrozzeria','Scarico']],
  ['Cambio pastiglie', 25, ['Ant. sx','Ant. dx','Post. sx','Post. dx','Rodaggio']],
  ['Setup: modifica', 15, ['Valore prima','Valore dopo','Annotato nel setup']]
];

/* ─── stato dei lavori ────────────────────────────────────────────────────── */
function jobsBy(status){ var B=board(); return B? B.jobs.filter(function(j){ return j.status===status; }) : []; }
function crewOf(id){ var B=board(); return (B&&B.crew.filter(function(c){ return c.id===id; })[0])||null; }
function jobOf(id){ var B=board(); return (B&&B.jobs.filter(function(j){ return j.id===id; })[0])||null; }

/* minuti che restano nella finestra di assistenza */
function minutesLeft(){
  var B=board(); if(!B||!B.win.endsAt) return null;
  return (B.win.endsAt-now())/60000;
}
/* carico di lavoro per meccanico (minuti stimati non ancora fatti) */
function load(){
  var B=board(), out={ unassigned:0, per:{} , total:0};
  if(!B) return out;
  B.crew.forEach(function(c){ out.per[c.id]=0; });
  B.jobs.forEach(function(j){
    if(j.status==='done') return;
    var est=+j.est||0;
    out.total+=est;
    var who=(j.who||[]).filter(function(id){ return crewOf(id); });
    if(!who.length){ out.unassigned+=est; return; }
    var share=est/who.length;
    who.forEach(function(id){ out.per[id]=(out.per[id]||0)+share; });
  });
  return out;
}
/* il piano ci sta nella finestra? */
function feasibility(){
  var B=board(), L=load(), ml=minutesLeft();
  var people=Math.max(1, B? B.crew.length : 1);
  var res={ minutesLeft:ml, work:L.total, people:people,
            parallel: L.total/people, worst:0, worstWho:null, ok:true, msg:'' };
  Object.keys(L.per).forEach(function(id){
    if(L.per[id]>res.worst){ res.worst=L.per[id]; res.worstWho=id; }
  });
  if(L.unassigned>0) res.worst=Math.max(res.worst, L.unassigned);
  if(ml==null){ res.msg='Nessun cronometro impostato: imposta i minuti di assistenza per sapere se ci state.'; return res; }
  var need=Math.max(res.worst, res.parallel);
  res.need=need;
  if(need>ml){ res.ok=false; res.msg='Non ci state: servono ~'+Math.ceil(need)+' min, ne restano '+Math.max(0,Math.round(ml))+'.'; }
  else res.msg='Ci state: servono ~'+Math.ceil(need)+' min sui '+Math.round(ml)+' che restano.';
  return res;
}

/* ═══ UI ═══════════════════════════════════════════════════════════════════ */
var filterWho=null;     // id meccanico o null = tutti

function fmtMin(m){
  if(m==null) return '—';
  var neg=m<0; m=Math.abs(m);
  var h=Math.floor(m/60), mm=Math.floor(m%60), s=Math.floor((m*60)%60);
  return (neg?'−':'')+(h>0? h+'h ':'')+mm+"'"+(h>0?'':' '+(s<10?'0':'')+s+'"');
}

function crewChip(c, sel){
  return '<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:10px;'+
    'background:'+(sel?c.color:'transparent')+';color:'+(sel?'#fff':c.color)+';border:1px solid '+c.color+'">'+esc(c.name)+'</span>';
}

function jobCard(j){
  var B=board();
  var who=(j.who||[]).map(function(id){ var c=crewOf(id); return c? crewChip(c,true):''; }).join(' ');
  var checks=(j.checks||[]);
  var doneC=checks.filter(function(c){ return c.done; }).length;
  var prioCol = j.prio==='alta'? 'var(--red)' : (j.prio==='bassa'? 'var(--text3)' : 'var(--yellow,#ffd60a)');
  var h='<div style="border:1px solid var(--border);border-left:3px solid '+prioCol+';border-radius:6px;padding:8px;margin-bottom:8px;background:var(--bg2,transparent)">';
  h+='<div style="display:flex;gap:6px;align-items:flex-start">'+
     '<div style="flex:1"><b>'+esc(j.title)+'</b>'+
     (j.car? ' <span class="small" style="opacity:.6">· '+esc(j.car)+'</span>':'')+
     '<div class="small" style="opacity:.65;margin-top:2px">'+(+j.est||0)+' min stimati'+
       (j.status==='doing'&&j.startedAt? ' · in corso da '+Math.round((now()-j.startedAt)/60000)+' min':'')+
       (j.status==='done'&&j.realMin!=null? ' · fatto in '+Math.round(j.realMin)+' min':'')+
     '</div></div>';
  h+='<div style="display:flex;gap:3px">';
  if(j.status==='todo')  h+='<button class="btn btn-blue"  style="font-size:10px;padding:3px 7px" onclick="WB.start(\''+j.id+'\')" title="Inizia">▶</button>';
  if(j.status==='doing') h+='<button class="btn btn-gray"  style="font-size:10px;padding:3px 7px" onclick="WB.stop(\''+j.id+'\')" title="Rimetti da fare">⏸</button>';
  if(j.status!=='done')  h+='<button class="btn btn-green" style="font-size:10px;padding:3px 7px" onclick="WB.done(\''+j.id+'\')" title="Fatto">✓</button>';
  if(j.status==='done')  h+='<button class="btn btn-gray"  style="font-size:10px;padding:3px 7px" onclick="WB.stop(\''+j.id+'\')" title="Riapri">↩</button>';
  h+='<button class="btn btn-gray" style="font-size:10px;padding:3px 7px" onclick="WB.del(\''+j.id+'\')">🗑</button>';
  h+='</div></div>';

  if(who) h+='<div style="margin-top:5px">'+who+'</div>';
  else h+='<div style="margin-top:5px"><span class="small" style="color:var(--yellow,#ffd60a)">nessuno assegnato</span></div>';

  if(checks.length){
    h+='<div style="margin-top:6px">';
    checks.forEach(function(c,i){
      h+='<label style="display:block;font-size:11px;line-height:1.9;cursor:pointer;'+(c.done?'opacity:.5;text-decoration:line-through':'')+'">'+
         '<input type="checkbox" '+(c.done?'checked':'')+' onchange="WB.check(\''+j.id+'\','+i+')" style="margin-right:6px">'+esc(c.t)+'</label>';
    });
    h+='<div class="small" style="opacity:.6">'+doneC+'/'+checks.length+' spuntati</div>';
    h+='</div>';
  }
  if(j.note) h+='<div class="small" style="margin-top:5px;opacity:.75">'+esc(j.note)+'</div>';
  h+='<div style="margin-top:6px;display:flex;gap:4px;flex-wrap:wrap">'+
     '<button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="WB.assign(\''+j.id+'\')">👤 Assegna</button>'+
     '<button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="WB.addCheck(\''+j.id+'\')">＋ voce</button>'+
     '<button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="WB.editJob(\''+j.id+'\')">✎</button>'+
     '</div>';
  h+='</div>';
  return h;
}

function column(title, status, jobs, color){
  var h='<div style="flex:1;min-width:230px">'+
    '<div class="small" style="letter-spacing:1px;opacity:.7;margin-bottom:6px;border-bottom:2px solid '+color+';padding-bottom:3px">'+
    esc(title)+' <b>'+jobs.length+'</b></div>';
  if(!jobs.length) h+='<div class="small" style="opacity:.45;padding:8px 0">—</div>';
  jobs.forEach(function(j){ h+=jobCard(j); });
  return h+'</div>';
}

function render(){
  var host=document.getElementById('wb-body'); if(!host) return;
  var B=board(); if(!B){ host.innerHTML='<div class="small">Stato applicazione non disponibile.</div>'; return; }
  var L=load(), F=feasibility(), ml=minutesLeft();
  var h='';

  /* finestra di assistenza */
  var col = (ml==null)? 'var(--text3)' : (ml<0? 'var(--red)' : (ml<5? 'var(--red)' : (ml<10? 'var(--yellow,#ffd60a)':'var(--green)')));
  h+='<div class="panel mb12"><div class="panel-body">'+
     '<div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center">'+
     '<div><div class="small" style="opacity:.6;letter-spacing:1px">FINESTRA</div>'+
       '<input value="'+esc(B.win.label||'')+'" onchange="WB.setWin(\'label\',this.value)" '+
       'style="background:var(--bg3);color:var(--text1);border:1px solid var(--border);border-radius:4px;padding:3px 6px;font-size:13px;width:180px"></div>'+
     '<div><div class="small" style="opacity:.6;letter-spacing:1px">TEMPO CHE RESTA</div>'+
       '<div id="wb-clock" style="font-size:26px;font-weight:700;font-family:var(--head,inherit);color:'+col+'">'+(ml==null?'—':fmtMin(ml))+'</div></div>'+
     '<div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center">'+
       [15,20,30,45,60].map(function(m){ return '<button class="btn btn-gray" style="font-size:11px" onclick="WB.startWin('+m+')">'+m+"'</button>"; }).join('')+
       '<button class="btn btn-gray" style="font-size:11px" onclick="WB.startWin(0)">stop</button>'+
     '</div></div>';
  h+='<div class="small" style="margin-top:8px;color:'+(F.ok?'var(--green)':'var(--red)')+'">'+esc(F.msg)+'</div>';
  h+='</div></div>';

  /* squadra */
  h+='<div class="panel mb12"><div class="panel-head">👷 SQUADRA</div><div class="panel-body">';
  if(!B.crew.length){
    h+='<div class="small" style="opacity:.8;margin-bottom:8px">Nessun meccanico. Aggiungili per poter assegnare i lavori e vedere chi è carico.</div>';
  } else {
    h+='<div style="display:flex;gap:10px;flex-wrap:wrap">';
    B.crew.forEach(function(c){
      var mins=L.per[c.id]||0;
      var over=(ml!=null && mins>ml);
      h+='<div style="min-width:120px;border:1px solid '+c.color+';border-radius:6px;padding:6px 9px;'+(filterWho===c.id?'background:'+c.color+'22':'')+'">'+
         '<div style="font-weight:600;color:'+c.color+'">'+esc(c.name)+'</div>'+
         '<div class="small" style="opacity:.7">'+esc(c.role||'meccanico')+'</div>'+
         '<div class="small" style="color:'+(over?'var(--red)':'inherit')+'">'+Math.round(mins)+' min di lavoro'+(over?' ⚠':'')+'</div>'+
         '<div style="margin-top:4px;display:flex;gap:3px">'+
           '<button class="btn btn-gray" style="font-size:9px;padding:2px 5px" onclick="WB.filter(\''+c.id+'\')">'+(filterWho===c.id?'tutti':'solo lui')+'</button>'+
           '<button class="btn btn-gray" style="font-size:9px;padding:2px 5px" onclick="WB.delCrew(\''+c.id+'\')">🗑</button>'+
         '</div></div>';
    });
    h+='</div>';
    if(L.unassigned>0) h+='<div class="small" style="margin-top:8px;color:var(--yellow,#ffd60a)">⚠ '+Math.round(L.unassigned)+' min di lavoro non assegnati a nessuno</div>';
  }
  h+='<div style="margin-top:8px"><button class="btn btn-blue" style="font-size:11px" onclick="WB.addCrew()">＋ MECCANICO</button></div>';
  h+='</div></div>';

  /* aggiunta lavori */
  h+='<div class="panel mb12"><div class="panel-body" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">'+
     '<button class="btn btn-blue" style="font-size:11px" onclick="WB.addJob()">＋ LAVORO</button>'+
     '<select id="wb-tpl" style="background:var(--bg3);color:var(--text1);border:1px solid var(--border);border-radius:4px;padding:3px 6px;font-size:11px">'+
       TPL.map(function(t,i){ return '<option value="'+i+'">'+esc(t[0])+' ('+t[1]+"')</option>"; }).join('')+
     '</select>'+
     '<button class="btn btn-gray" style="font-size:11px" onclick="WB.addFromTpl()">＋ DA MODELLO</button>'+
     '<span style="flex:1"></span>'+
     (filterWho? '<span class="small">filtro: <b>'+esc((crewOf(filterWho)||{}).name||'')+'</b> <button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="WB.filter(null)">togli</button></span>':'')+
     '<button class="btn btn-gray" style="font-size:11px" onclick="WB.clearDone()">🧹 SVUOTA FATTI</button>'+
     '</div></div>';

  /* colonne */
  function flt(list){ return filterWho? list.filter(function(j){ return (j.who||[]).indexOf(filterWho)>=0; }) : list; }
  h+='<div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-start">'+
     column('DA FARE','todo', flt(jobsBy('todo')), 'var(--text3)')+
     column('IN CORSO','doing', flt(jobsBy('doing')), 'var(--yellow,#ffd60a)')+
     column('FATTO','done', flt(jobsBy('done')), 'var(--green)')+
     '</div>';

  /* riepilogo tempi */
  var done=jobsBy('done').filter(function(j){ return j.realMin!=null && +j.est>0; });
  if(done.length>=2){
    var dEst=done.reduce(function(s,j){ return s+(+j.est||0); },0);
    var dRe=done.reduce(function(s,j){ return s+j.realMin; },0);
    var r=dRe/dEst;
    h+='<div class="panel" style="margin-top:12px"><div class="panel-head">⏱ TEMPI REALI</div><div class="panel-body small" style="line-height:1.8">'+
       'Su '+done.length+' lavori chiusi: stimati <b>'+Math.round(dEst)+' min</b>, impiegati <b>'+Math.round(dRe)+' min</b> ('+
       (r>=1? '+'+Math.round((r-1)*100)+'% più lenti' : '−'+Math.round((1-r)*100)+'% più veloci')+' delle stime).<br>'+
       (r>1.15? 'Le stime sono ottimistiche: conviene gonfiarle di circa '+Math.round((r-1)*100)+'%.' :
        (r<0.85? 'Le stime sono prudenti: c\'è margine.' : 'Le stime sono affidabili.'))+
       '</div></div>';
  }

  host.innerHTML=h;
}

/* orologio: aggiorna solo il numero, non ridisegna la pagina */
function tick(){
  var el=document.getElementById('wb-clock'); if(!el) return;
  var ml=minutesLeft();
  if(ml==null){ el.textContent='—'; return; }
  el.textContent=fmtMin(ml);
  el.style.color = ml<0? 'var(--red)' : (ml<5? 'var(--red)' : (ml<10? 'var(--yellow,#ffd60a)':'var(--green)'));
  var B=board();
  if(B && B.win.endsAt && !B.win.warned && ml<=5 && ml>0){ B.win.warned=true; toast('⏰ 5 minuti alla fine dell\'assistenza'); }
  if(B && B.win.endsAt && !B.win.over && ml<=0){ B.win.over=true; toast('⏰ Tempo scaduto'); }
}

/* ridisegna se i dati cambiano da fuori (coop, ripristino) senza disturbare chi sta scrivendo */
var lastSig='';
function watch(){
  try {
    var B=board(); if(!B) return;
    var pg=document.getElementById('page-works');
    if(!pg || pg.style.display==='none' || !pg.classList.contains('active')){
      if(pg && pg.offsetParent===null) return;   // pagina non visibile
    }
    var sig=JSON.stringify([B.crew.length, B.jobs.map(function(j){ return [j.id,j.status,(j.checks||[]).map(function(c){return c.done?1:0;}).join(''),(j.who||[]).join(',')]; }), B.win.label]);
    if(sig===lastSig) return;
    var ae=document.activeElement;
    if(ae && /input|select|textarea/i.test(ae.tagName)) return;   // sta scrivendo qualcuno
    lastSig=sig; render();
  } catch(e){}
}

/* ═══ API ══════════════════════════════════════════════════════════════════ */
var WB={ board:board, render:render, inject:inject, load:load, feasibility:feasibility, minutesLeft:minutesLeft,
         TPL:TPL, jobsBy:jobsBy, crewOf:crewOf, jobOf:jobOf, tick:tick, fmtMin:fmtMin };
window.WB=WB;

WB.setWin=function(f,v){ var B=board(); B.win[f]= (f==='label')? String(v) : v; commit('finestra assistenza'); };
WB.startWin=function(mins){
  var B=board();
  if(!mins){ B.win.endsAt=null; B.win.warned=false; B.win.over=false; commit('cronometro fermato'); return; }
  B.win.minutes=mins; B.win.endsAt=now()+mins*60000; B.win.warned=false; B.win.over=false;
  commit('assistenza '+mins+" min");
  toast('⏱ '+mins+' minuti di assistenza');
};
WB.addCrew=function(){
  var n=prompt('Nome del meccanico:',''); if(n===null||!String(n).trim()) return;
  var r=prompt('Ruolo (motorista, gommista, elettronica…):','meccanico');
  var B=board();
  B.crew.push({ id:uid('m'), name:String(n).trim(), role:String(r||'meccanico').trim(), color:COLORS[B.crew.length%COLORS.length] });
  commit('squadra aggiornata');
};
WB.delCrew=function(id){
  var c=crewOf(id); if(!c) return;
  if(!confirm('Togliere '+c.name+' dalla squadra? I lavori restano, senza assegnatario.')) return;
  var B=board();
  B.crew=B.crew.filter(function(x){ return x.id!==id; });
  B.jobs.forEach(function(j){ j.who=(j.who||[]).filter(function(w){ return w!==id; }); });
  if(filterWho===id) filterWho=null;
  commit('squadra aggiornata');
};
WB.filter=function(id){ filterWho=(filterWho===id)?null:id; render(); };

function newJob(title, est, checks, car){
  return { id:uid('j'), title:title, car:car||'', who:[], prio:'media', est:est||10,
           status:'todo', checks:(checks||[]).map(function(t){ return {t:t, done:false}; }),
           note:'', createdAt:now(), startedAt:null, doneAt:null, realMin:null };
}
WB.addJob=function(){
  var t=prompt('Che lavoro?',''); if(t===null||!String(t).trim()) return;
  var e=num(prompt('Minuti stimati:','15'),15);
  var B=board(); B.jobs.push(newJob(String(t).trim(), e, [], carHint()));
  commit('nuovo lavoro');
};
WB.addFromTpl=function(){
  var s=document.getElementById('wb-tpl'); if(!s) return;
  var t=TPL[+s.value]; if(!t) return;
  var B=board(); B.jobs.push(newJob(t[0], t[1], t[2], carHint()));
  commit('lavoro da modello: '+t[0]);
};
function carHint(){
  try {
    if(STATE.mode==='rally' && STATE.rallyCars) return (STATE.rallyCars[STATE.selectedRallyCar]||{}).name||'';
    if(STATE.trackCars) return (STATE.trackCars[STATE.selectedTrackCar]||{}).name||'';
  } catch(e){}
  return '';
}
WB.editJob=function(id){
  var j=jobOf(id); if(!j) return;
  var t=prompt('Titolo:', j.title); if(t===null) return;
  if(String(t).trim()) j.title=String(t).trim();
  var e=prompt('Minuti stimati:', String(j.est));
  if(e!==null) j.est=num(e, j.est);
  var p=prompt('Priorità: alta / media / bassa', j.prio||'media');
  if(p!==null){ p=String(p).trim().toLowerCase(); if(['alta','media','bassa'].indexOf(p)>=0) j.prio=p; }
  var n=prompt('Nota (facoltativa):', j.note||'');
  if(n!==null) j.note=String(n);
  commit('lavoro modificato');
};
WB.assign=function(id){
  var j=jobOf(id); if(!j) return;
  var B=board();
  if(!B.crew.length){ toast('Aggiungi prima i meccanici'); return; }
  var txt='Chi ci lavora? Numeri separati da virgola (vuoto = nessuno)\n\n';
  B.crew.forEach(function(c,i){ txt+=(i+1)+') '+c.name+((j.who||[]).indexOf(c.id)>=0? '  ✓':'')+'\n'; });
  var r=prompt(txt, (j.who||[]).map(function(w){ return B.crew.findIndex(function(c){return c.id===w;})+1; }).filter(function(x){return x>0;}).join(','));
  if(r===null) return;
  var ids=[];
  String(r).split(',').forEach(function(p){
    var k=parseInt(String(p).trim(),10);
    if(k>=1 && k<=B.crew.length && ids.indexOf(B.crew[k-1].id)<0) ids.push(B.crew[k-1].id);
  });
  j.who=ids;
  commit('assegnazione: '+j.title);
};
WB.addCheck=function(id){
  var j=jobOf(id); if(!j) return;
  var t=prompt('Voce da spuntare:',''); if(t===null||!String(t).trim()) return;
  j.checks=j.checks||[]; j.checks.push({t:String(t).trim(), done:false});
  commit('checklist: '+j.title);
};
WB.check=function(id, i){
  var j=jobOf(id); if(!j||!j.checks||!j.checks[i]) return;
  j.checks[i].done=!j.checks[i].done;
  var all=j.checks.length && j.checks.every(function(c){ return c.done; });
  if(all && j.status!=='done'){ WB.done(id, true); return; }
  commit('spunta: '+j.title);
};
WB.start=function(id){
  var j=jobOf(id); if(!j) return;
  j.status='doing'; if(!j.startedAt) j.startedAt=now(); j.doneAt=null; j.realMin=null;
  commit('iniziato: '+j.title);
};
WB.stop=function(id){
  var j=jobOf(id); if(!j) return;
  j.status='todo'; j.doneAt=null; j.realMin=null;
  commit('rimesso da fare: '+j.title);
};
WB.done=function(id, silent){
  var j=jobOf(id); if(!j) return;
  j.status='done'; j.doneAt=now();
  if(j.startedAt) j.realMin=(j.doneAt-j.startedAt)/60000;
  (j.checks||[]).forEach(function(c){ c.done=true; });
  commit('fatto: '+j.title);
  if(!silent) toast('✅ '+j.title);
};
WB.del=function(id){
  var j=jobOf(id); if(!j) return;
  if(!confirm('Eliminare "'+j.title+'"?')) return;
  var B=board(); B.jobs=B.jobs.filter(function(x){ return x.id!==id; });
  commit('lavoro eliminato');
};
WB.clearDone=function(){
  var n=jobsBy('done').length;
  if(!n){ toast('Niente da svuotare'); return; }
  if(!confirm('Togliere dalla lavagna i '+n+' lavori già fatti?')) return;
  var B=board(); B.jobs=B.jobs.filter(function(j){ return j.status!=='done'; });
  commit('lavagna ripulita');
};
WB.newWindow=function(){
  var B=board();
  var lab=prompt('Nome della prossima finestra (es. "Assistenza dopo PS4"):', B.win.label||'Assistenza');
  if(lab===null) return;
  B.jobs=B.jobs.filter(function(j){ return j.status!=='done'; });
  B.win.label=String(lab); B.win.endsAt=null; B.win.warned=false; B.win.over=false;
  commit('nuova finestra');
};

/* ─── pagina ──────────────────────────────────────────────────────────────── */
function inject(){
  if(document.getElementById('page-works')) return;
  var anyPage=document.querySelector('.page');
  var main=anyPage && anyPage.parentNode;
  if(!main) return;
  var pg=document.createElement('div');
  pg.className='page'; pg.id='page-works';
  pg.innerHTML='<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">'+
    '<div style="font-family:var(--head);font-size:20px;font-weight:700;letter-spacing:2px;color:var(--accent3)">🧰 LAVAGNA LAVORI</div>'+
    '<span class="small" style="opacity:.65">chi fa cosa fra una PS e l\'altra</span>'+
    '<button class="btn btn-gray" style="font-size:11px;margin-left:auto" onclick="WB.newWindow()">🔄 NUOVA FINESTRA</button></div>'+
    '<div id="wb-body"></div>';
  main.appendChild(pg);
  try { if(window.PAGES && !window.PAGES.some(function(p){ return p[0]==='works'; })) window.PAGES.push(['works','🧰 Lavagna lavori squadra']); } catch(e){}
  render();
}
if(typeof window.showPage==='function' && !window._wbPageWrapped){
  window._wbPageWrapped=true;
  var _oP=window.showPage;
  window.showPage=function(id){
    var r=_oP.apply(this, arguments);
    if(id==='works') setTimeout(function(){ lastSig=''; render(); }, 60);
    return r;
  };
}
function boot(){ inject(); render(); }
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(boot, 1400); });
else setTimeout(boot, 1400);
setTimeout(inject, 3200);
setTimeout(inject, 7200);
setInterval(tick, 1000);
setInterval(watch, 2000);

})();

</script>
<script>
/* ═══════════════════════════════════════════════════════════════════════════
   STORICO STAGIONE (SH) — v1.0
   Confronto fra gare, progressione del pilota, affidabilità dei componenti.
   Non duplica dati: incrocia quelli che ci sono già —
     REP_life_v1   (libretto vita: interventi, km)
     REP_cost_v1   (costi e spese)
     REP_driver_prof_v1 (sessioni e feedback dei piloti)
     STATE         (gara in corso: PS, giri, danni)
   L'unica cosa che salva di suo è l'archivio delle gare chiuse: REP_season_v1
   ═══════════════════════════════════════════════════════════════════════════ */
(function(){
'use strict';
if(window.SH) return;

var KEY='REP_season_v1';
var SYS={ engine:'Motore', suspension:'Sospensioni', brakes:'Freni', body:'Carrozzeria',
          gearbox:'Cambio', electronics:'Elettronica', steering:'Sterzo', cooling:'Raffreddamento' };

/* ─── utilità ─────────────────────────────────────────────────────────────── */
function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function toast(m){ try{ if(typeof showToast==='function') showToast(m); }catch(e){} }
function num(v,d){ var x=parseFloat(String(v==null?'':v).replace(',','.')); return isFinite(x)? x:(d||0); }
function uid(p){ return (p||'e')+Date.now().toString(36)+Math.floor(Math.random()*1e4).toString(36); }
function ls(k){ try{ return JSON.parse(localStorage.getItem(k)||'null'); }catch(e){ return null; } }

function load(){
  var o=ls(KEY);
  if(!o||typeof o!=='object') o={ v:1, events:[] };
  o.events=o.events||[];
  return o;
}
function save(o){ try{ localStorage.setItem(KEY, JSON.stringify(o)); }catch(e){ toast('Memoria piena: storico non salvato'); } }
function edit(fn){ var o=load(); fn(o); save(o); return o; }

function lifeData(){ var o=ls('REP_life_v1'); return (o&&o.cars)? o : {cars:{},log:[]}; }
function costData(){ var o=ls('REP_cost_v1'); return o||{cfg:{cur:'€'},spend:[],comp:{}}; }
function drvData(){ var o=ls('REP_driver_prof_v1'); return (o&&o.drivers)? o : {drivers:{}}; }
function cur(){ try{ return costData().cfg.cur||'€'; }catch(e){ return '€'; } }
function money(n){ if(!isFinite(n)) n=0; return Math.round(n).toLocaleString('it-IT')+' '+cur(); }

/* ═══ 1. ARCHIVIO GARE ═════════════════════════════════════════════════════ */

/* fotografia della gara in corso, presa da STATE */
function snapshotCurrent(){
  var out={ mode:'track', name:'', km:0, kmPS:0, stages:0, laps:0, cars:[], issues:[],
            bestPos:null, endPos:null, surface:'', driverIds:[] };
  try {
    out.mode = (STATE.mode==='rally')? 'rally':'track';
    if(out.mode==='rally'){
      var st=(STATE.stages||[]).filter(function(s){ return !s.cancelled; });
      out.stages=st.length;
      st.forEach(function(s){
        out.kmPS+=num(s.km,0); out.km+=num(s.km,0)+num(s.tfKm,0);
        if(s.driverId && out.driverIds.indexOf(s.driverId)<0) out.driverIds.push(s.driverId);
        if(s.car && out.cars.indexOf(s.car)<0) out.cars.push(s.car);
        if(s.surface && !out.surface) out.surface=s.surface;
      });
      var pos=st.map(function(s){ return num(s.absPos,0); }).filter(function(x){ return x>0; });
      if(pos.length){ out.bestPos=Math.min.apply(null,pos); out.endPos=pos[pos.length-1]; }
      out.name = 'Rally';
      (STATE.rallyDamage||[]).forEach(function(d){ collectIssues(d, out.issues); });
    } else {
      out.name = STATE.circuit || 'Pista';
      out.surface = STATE.surface||'';
      (STATE.trackCars||[]).forEach(function(c){
        var L=(STATE.laps||{})[c.id]||[];
        if(L.length){ out.laps+=L.length; if(out.cars.indexOf(c.name)<0) out.cars.push(c.name); }
        ((STATE.damage||{})[c.id]||[]).forEach(function(d){ collectIssues(d, out.issues); });
      });
    }
  } catch(e){}
  return out;
}
function collectIssues(d, arr){
  Object.keys(SYS).forEach(function(k){
    var v=d[k];
    if(v===undefined||v===null) return;
    v=String(v).trim();
    if(!v || /^ok$/i.test(v) || /^(nessun|—|-)/i.test(v)) return;
    arr.push({ sys:k, level:v, desc:d.desc||'', when:d.stage||d.session||'', ts:d.ts||null });
  });
}

/* spese registrate dopo l'ultima gara archiviata */
function spendSince(ts){
  var C=costData(), s=0;
  (C.spend||[]).forEach(function(x){ if(!ts || x.ts>ts) s+=num(x.amount,0); });
  return s;
}

function archive(data){
  var o=load();
  var ev=Object.assign({ id:uid('ev'), ts:Date.now(), year:new Date().getFullYear() }, data);
  o.events.push(ev);
  o.events.sort(function(a,b){ return a.ts-b.ts; });
  save(o);
  return ev;
}

/* ═══ 2. AFFIDABILITÀ ══════════════════════════════════════════════════════ */
/* Un intervento fatto molto prima del limite è quasi sempre un cedimento,
   non manutenzione programmata. Soglia: sotto il 70% della vita prevista. */
var EARLY=0.70;

function reliability(carName){
  var L=lifeData(), C=costData();
  var out={ rows:[], totalJobs:0, totalEarly:0, totalCost:0 };
  Object.keys(L.cars).forEach(function(cn){
    if(carName && cn!==carName) return;
    var car=L.cars[cn];
    (car.comps||[]).forEach(function(p){
      var hist=p.hist||[];
      var lim=num(p.limit,0);
      var early=hist.filter(function(h){ return lim>0 && num(h.km,0) < lim*EARLY; });
      var kmTot=hist.reduce(function(s,h){ return s+num(h.km,0); },0)+num(p.km,0);
      var unit=0;
      try {
        var cc=(C.comp||{})[cn+'::'+p.id]||{};
        unit=num(cc.price,0)+num(cc.hours,0)*num((C.cfg||{}).hourRate,0);
      } catch(e){}
      if(!hist.length && num(p.km,0)===0) return;
      out.rows.push({
        car:cn, name:p.name, kind:p.kind||'', jobs:hist.length, early:early.length,
        limit:lim, kmNow:num(p.km,0), kmTot:kmTot,
        mtb: hist.length? kmTot/(hist.length+ (num(p.km,0)>0?1:0) ) : null,   // km medi fra un intervento e l'altro
        unit:unit, spent:unit*hist.length,
        lastAt: hist.length? hist[hist.length-1].at : null,
        earlyKm: early.map(function(h){ return num(h.km,0); })
      });
      out.totalJobs+=hist.length; out.totalEarly+=early.length; out.totalCost+=unit*hist.length;
    });
  });
  out.rows.sort(function(a,b){ return (b.early-a.early) || (b.jobs-a.jobs) || (b.spent-a.spent); });
  return out;
}

/* conteggio dei guasti per sistema, dai danni registrati (gara in corso + archivio) */
function issuesBySystem(){
  var counts={}, now=snapshotCurrent();
  function add(list){ (list||[]).forEach(function(i){ counts[i.sys]=(counts[i.sys]||0)+1; }); }
  add(now.issues);
  load().events.forEach(function(e){ add(e.issues); });
  return Object.keys(SYS).map(function(k){ return { sys:k, lab:SYS[k], n:counts[k]||0 }; })
    .sort(function(a,b){ return b.n-a.n; });
}

/* ═══ 3. PROGRESSIONE PILOTA ═══════════════════════════════════════════════ */
function driverProgress(driverId){
  var D=drvData().drivers[driverId];
  if(!D) return null;
  var evs=(D.events||[]).filter(function(e){ return e.fb && e.quality!=='scarta'; })
                        .sort(function(a,b){ return a.ts-b.ts; });
  if(!evs.length) return null;
  /* miglior tempo per ogni luogo, per calcolare lo scarto */
  var best={};
  evs.forEach(function(e){ var t=num(e.timeS,0); if(t>0){ if(!best[e.venueKey]||t<best[e.venueKey]) best[e.venueKey]=t; } });
  var pts=evs.map(function(e){
    var t=num(e.timeS,0);
    var gap=(t>0 && best[e.venueKey])? 100*(t-best[e.venueKey])/best[e.venueKey] : null;
    return { ts:e.ts, conf:num(e.fb.conf,5), gap:gap, venue:e.venue, surface:e.surface,
             bal:(num(e.fb.entry,0)+num(e.fb.mid,0)+num(e.fb.exit,0))/3 };
  });
  /* media mobile a 3 sulla fiducia */
  pts.forEach(function(p,i){
    var w=pts.slice(Math.max(0,i-2), i+1);
    p.confMA = w.reduce(function(s,x){ return s+x.conf; },0)/w.length;
  });
  var first=pts.slice(0, Math.min(3,pts.length)), last=pts.slice(-3);
  var avg=function(a,k){ var v=a.map(function(x){ return x[k]; }).filter(function(x){ return x!=null; });
                          return v.length? v.reduce(function(s,x){ return s+x; },0)/v.length : null; };
  return { id:driverId, name:D.name, n:pts.length, pts:pts,
           confStart:avg(first,'conf'), confEnd:avg(last,'conf'),
           gapStart:avg(first,'gap'), gapEnd:avg(last,'gap'),
           venues:Object.keys(best).length };
}

/* ═══ GRAFICI (SVG, niente librerie) ═══════════════════════════════════════ */
function lineChart(pts, opt){
  opt=opt||{};
  var W=opt.w||520, H=opt.h||140, pad=opt.pad||{l:34,r:10,t:10,b:20};
  var iw=W-pad.l-pad.r, ih=H-pad.t-pad.b;
  var vals=pts.map(function(p){ return p.y; }).filter(function(v){ return v!=null && isFinite(v); });
  if(!vals.length) return '';
  var mn=(opt.min!=null)? opt.min : Math.min.apply(null,vals);
  var mx=(opt.max!=null)? opt.max : Math.max.apply(null,vals);
  if(mx===mn){ mx=mn+1; mn=mn-1; }
  var n=pts.length;
  function X(i){ return pad.l + (n<=1? iw/2 : iw*i/(n-1)); }
  function Y(v){ return pad.t + ih*(1-(v-mn)/(mx-mn)); }
  var g='';
  /* griglia */
  [0,0.5,1].forEach(function(f){
    var y=pad.t+ih*f, v=mx-(mx-mn)*f;
    g+='<line x1="'+pad.l+'" y1="'+y.toFixed(1)+'" x2="'+(W-pad.r)+'" y2="'+y.toFixed(1)+'" stroke="currentColor" stroke-opacity=".15"/>';
    g+='<text x="'+(pad.l-5)+'" y="'+(y+3).toFixed(1)+'" text-anchor="end" font-size="9" fill="currentColor" fill-opacity=".55">'+v.toFixed(opt.dec==null?1:opt.dec)+'</text>';
  });
  var dsel=[], dots='';
  pts.forEach(function(p,i){
    if(p.y==null||!isFinite(p.y)) return;
    dsel.push((dsel.length?'L':'M')+X(i).toFixed(1)+' '+Y(p.y).toFixed(1));
    dots+='<circle cx="'+X(i).toFixed(1)+'" cy="'+Y(p.y).toFixed(1)+'" r="2.6" fill="'+(opt.color||'var(--teal,#1aada0)')+'"><title>'+esc(p.t||'')+'</title></circle>';
  });
  return '<svg viewBox="0 0 '+W+' '+H+'" width="100%" height="'+H+'" preserveAspectRatio="none" style="color:var(--text3,#8a94a6);max-width:'+W+'px">'+
    g+'<path d="'+dsel.join(' ')+'" fill="none" stroke="'+(opt.color||'var(--teal,#1aada0)')+'" stroke-width="2"/>'+dots+'</svg>';
}

function barsH(rows, opt){
  opt=opt||{};
  var max=Math.max.apply(null, rows.map(function(r){ return r.v; }).concat([1]));
  var h='';
  rows.forEach(function(r){
    var pct=100*r.v/max;
    h+='<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">'+
       '<div class="small" style="width:110px;text-align:right;opacity:.8">'+esc(r.lab)+'</div>'+
       '<div style="flex:1;background:var(--bg3);border-radius:4px;height:14px;overflow:hidden">'+
       '<div style="height:100%;width:'+pct.toFixed(1)+'%;background:'+(r.color||opt.color||'var(--teal,#1aada0)')+'"></div></div>'+
       '<div class="small mono" style="width:70px">'+esc(r.txt!=null? r.txt : r.v)+'</div></div>';
  });
  return h;
}

/* ═══ UI ═══════════════════════════════════════════════════════════════════ */
var selDriver=null, selTab='gare';

function render(){
  var host=document.getElementById('sh-body'); if(!host) return;
  var o=load();
  var h='';

  h+='<div class="panel mb12"><div class="panel-body" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center">'+
     ['gare','piloti','affidabilita'].map(function(t){
       var lab={gare:'📅 GARE', piloti:'📈 PROGRESSIONE PILOTI', affidabilita:'🔩 AFFIDABILITÀ'}[t];
       return '<button class="btn '+(selTab===t?'btn-blue':'btn-gray')+'" style="font-size:11px" onclick="SH.tab(\''+t+'\')">'+lab+'</button>';
     }).join(' ')+
     '<span style="flex:1"></span>'+
     '<button class="btn btn-green" style="font-size:11px" onclick="SH.archiveNow()">📦 ARCHIVIA GARA IN CORSO</button>'+
     '<button class="btn btn-gray" style="font-size:11px" onclick="SH.exportCSV()">⬇ CSV</button>'+
     '</div></div>';

  if(selTab==='gare') h+=tabGare(o);
  else if(selTab==='piloti') h+=tabPiloti();
  else h+=tabAffidabilita();

  host.innerHTML=h;
}

/* ── scheda GARE ── */
function tabGare(o){
  var h='';
  var live=snapshotCurrent();
  h+='<div class="panel mb12"><div class="panel-head">🔴 GARA IN CORSO</div><div class="panel-body small" style="line-height:1.9">';
  if(live.mode==='rally'){
    h+='PS registrate: <b>'+live.stages+'</b> · km di PS <b>'+live.kmPS.toFixed(0)+'</b> (totali con trasferimenti '+live.km.toFixed(0)+')<br>';
    if(live.bestPos) h+='Miglior posizione <b>'+live.bestPos+'</b> · ultima <b>'+live.endPos+'</b><br>';
  } else {
    h+='Circuito: <b>'+esc(live.name)+'</b> · giri registrati <b>'+live.laps+'</b><br>';
  }
  h+='Problemi segnalati: <b>'+live.issues.length+'</b>'+(live.issues.length? ' ('+esc(live.issues.slice(0,4).map(function(i){ return SYS[i.sys]; }).join(', '))+(live.issues.length>4?'…':'')+')':'')+'<br>';
  var last=o.events.length? o.events[o.events.length-1].ts : null;
  h+='Spese dall\'ultima gara archiviata: <b>'+money(spendSince(last))+'</b>';
  h+='<div style="margin-top:8px;opacity:.7">Quando la gara è finita, premi <b>ARCHIVIA</b>: la fotografia entra nello storico e il conto delle spese riparte.</div>';
  h+='</div></div>';

  if(!o.events.length){
    return h+'<div class="panel"><div class="panel-body small" style="opacity:.8">Nessuna gara archiviata. '+
      'Lo storico si costruisce da qui: a fine gara premi <b>ARCHIVIA GARA IN CORSO</b>. '+
      'Nel frattempo le schede <b>Progressione piloti</b> e <b>Affidabilità</b> funzionano già, perché leggono i dati che stai raccogliendo.</div></div>';
  }

  /* tabella confronto */
  h+='<div class="panel mb12"><div class="panel-head">📅 CONFRONTO FRA GARE ('+o.events.length+')</div><div class="panel-body" style="overflow-x:auto">'+
     '<table class="small" style="width:100%;border-collapse:collapse;text-align:left">'+
     '<tr style="opacity:.6"><th>GARA</th><th>DATA</th><th>KM</th><th>POS.</th><th>PROBLEMI</th><th>SPESA</th><th>€/KM</th><th></th></tr>';
  o.events.forEach(function(e){
    var km=num(e.km,0);
    h+='<tr style="border-top:1px solid var(--border)">'+
       '<td><b>'+esc(e.name)+'</b><div class="small" style="opacity:.55">'+esc(e.surface||e.mode)+(e.cars&&e.cars.length?' · '+esc(e.cars.join(', ')):'')+'</div></td>'+
       '<td>'+esc(new Date(e.ts).toLocaleDateString('it-IT'))+'</td>'+
       '<td class="mono">'+(km>0? km.toFixed(0):'—')+'</td>'+
       '<td class="mono">'+(e.endPos? e.endPos+(e.bestPos&&e.bestPos!==e.endPos? ' (best '+e.bestPos+')':'') : '—')+'</td>'+
       '<td class="mono">'+((e.issues||[]).length||'—')+'</td>'+
       '<td class="mono">'+(num(e.spend,0)>0? money(e.spend):'—')+'</td>'+
       '<td class="mono">'+((km>0&&num(e.spend,0)>0)? (e.spend/km).toFixed(2)+' '+cur():'—')+'</td>'+
       '<td><button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="SH.delEvent(\''+e.id+'\')">🗑</button></td></tr>';
  });
  h+='</table></div></div>';

  /* andamenti */
  var withSpend=o.events.filter(function(e){ return num(e.spend,0)>0 && num(e.km,0)>0; });
  if(withSpend.length>=2){
    h+='<div class="panel mb12"><div class="panel-head">💶 COSTO AL KM, GARA PER GARA</div><div class="panel-body">'+
       lineChart(withSpend.map(function(e){ return { y:e.spend/e.km, t:e.name+': '+(e.spend/e.km).toFixed(2) }; }), {dec:2, color:'var(--yellow,#ffd60a)'})+
       '<div class="small" style="opacity:.65">Se sale, o state rompendo di più o state facendo meno km a parità di spesa.</div>'+
       '</div></div>';
  }
  var withPos=o.events.filter(function(e){ return e.endPos>0; });
  if(withPos.length>=2){
    h+='<div class="panel mb12"><div class="panel-head">🏁 POSIZIONE FINALE</div><div class="panel-body">'+
       lineChart(withPos.map(function(e){ return { y:-e.endPos, t:e.name+': '+e.endPos+'°' }; }), {dec:0, color:'var(--green)'})+
       '<div class="small" style="opacity:.65">Più in alto = meglio piazzati (la scala è rovesciata apposta).</div>'+
       '</div></div>';
  }
  var iss=o.events.filter(function(e){ return (e.issues||[]).length>0; });
  if(iss.length>=2){
    h+='<div class="panel"><div class="panel-head">⚠ PROBLEMI PER GARA</div><div class="panel-body">'+
       lineChart(o.events.map(function(e){ return { y:(e.issues||[]).length, t:e.name+': '+(e.issues||[]).length }; }), {dec:0, min:0, color:'var(--red)'})+
       '</div></div>';
  }
  return h;
}

/* ── scheda PILOTI ── */
function tabPiloti(){
  var D=drvData().drivers;
  var ids=Object.keys(D);
  if(!ids.length){
    return '<div class="panel"><div class="panel-body small" style="opacity:.8">Nessun pilota. '+
      'Aprili dalla pagina Setup, sezione <b>Profilo pilota</b>: ogni sessione che registri lì costruisce questa progressione.</div></div>';
  }
  if(!selDriver || !D[selDriver]) selDriver=ids[0];
  var h='<div class="panel mb12"><div class="panel-body" style="display:flex;gap:6px;flex-wrap:wrap">';
  ids.forEach(function(id){
    h+='<button class="btn '+(id===selDriver?'btn-blue':'btn-gray')+'" style="font-size:11px" onclick="SH.driver(\''+id+'\')">'+esc(D[id].name)+'</button>';
  });
  h+='</div></div>';

  var P=driverProgress(selDriver);
  if(!P){
    return h+'<div class="panel"><div class="panel-body small" style="opacity:.8">'+esc(D[selDriver].name)+
      ' non ha ancora sessioni con feedback. Registrale dal pannello Profilo pilota nella pagina Setup.</div></div>';
  }

  /* fiducia */
  h+='<div class="panel mb12"><div class="panel-head">📈 FIDUCIA NELL\'AUTO — '+esc(P.name)+' ('+P.n+' sessioni)</div><div class="panel-body">'+
     lineChart(P.pts.map(function(p){ return { y:p.confMA, t:p.venue+' · '+p.conf+'/10' }; }), {min:0,max:10,dec:0})+
     '<div class="small" style="line-height:1.8;margin-top:4px">';
  if(P.confStart!=null && P.confEnd!=null){
    var dC=P.confEnd-P.confStart;
    h+='Prime sessioni <b>'+P.confStart.toFixed(1)+'/10</b> → ultime <b>'+P.confEnd.toFixed(1)+'/10</b> '+
       '<span style="color:'+(dC>0.3?'var(--green)':(dC<-0.3?'var(--red)':'inherit'))+'">('+(dC>=0?'+':'')+dC.toFixed(1)+')</span>. '+
       (dC>0.5? 'Si sta trovando sempre meglio.' : (dC<-0.5? 'Sta perdendo fiducia: qualcosa nel setup o nella vettura è andato nella direzione sbagliata.' : 'Situazione stabile.'));
  }
  h+='</div></div></div>';

  /* scarto dal miglior tempo sullo stesso luogo */
  var gapPts=P.pts.filter(function(p){ return p.gap!=null; });
  if(gapPts.length>=2){
    h+='<div class="panel mb12"><div class="panel-head">⏱ SCARTO DAL SUO MIGLIOR TEMPO (stesso luogo)</div><div class="panel-body">'+
       lineChart(P.pts.map(function(p){ return { y:(p.gap==null? null : -p.gap), t:p.venue+': +'+(p.gap||0).toFixed(1)+'%' }; }), {dec:1, color:'var(--accent3,#8b5cf6)'})+
       '<div class="small" style="opacity:.7">Più in alto = più vicino al suo riferimento su quel percorso. Confronta solo sessioni sullo stesso luogo, quindi è un paragone onesto.</div>'+
       '</div></div>';
  }

  /* dove va meglio */
  var byV={};
  P.pts.forEach(function(p){
    var k=p.venue+' · '+p.surface;
    byV[k]=byV[k]||{n:0,c:0};
    byV[k].n++; byV[k].c+=p.conf;
  });
  var rows=Object.keys(byV).map(function(k){ return { lab:k, v:byV[k].c/byV[k].n, txt:(byV[k].c/byV[k].n).toFixed(1)+'/10 ('+byV[k].n+')' }; })
                            .sort(function(a,b){ return b.v-a.v; });
  if(rows.length>=2){
    h+='<div class="panel"><div class="panel-head">📍 DOVE SI TROVA MEGLIO</div><div class="panel-body">'+barsH(rows)+
       '<div class="small" style="opacity:.7;margin-top:6px">Media della fiducia per luogo e fondo. Il numero fra parentesi sono le sessioni: con una sola, vale poco.</div>'+
       '</div></div>';
  }
  return h;
}

/* ── scheda AFFIDABILITÀ ── */
function tabAffidabilita(){
  var R=reliability(null), IS=issuesBySystem();
  var h='';

  var anyIssue=IS.some(function(x){ return x.n>0; });
  if(anyIssue){
    h+='<div class="panel mb12"><div class="panel-head">⚠ COSA VI HA DATO PIÙ PROBLEMI</div><div class="panel-body">'+
       barsH(IS.filter(function(x){ return x.n>0; }).map(function(x){ return { lab:x.lab, v:x.n, txt:x.n+' volte', color:'var(--red)' }; }))+
       '<div class="small" style="opacity:.7;margin-top:6px">Conteggio delle segnalazioni di danno, gara in corso e archivio insieme.</div>'+
       '</div></div>';
  }

  if(!R.rows.length){
    return h+'<div class="panel"><div class="panel-body small" style="opacity:.8">Nessun componente con storia. '+
      'L\'affidabilità si costruisce dal <b>Libretto vita</b>: ogni volta che premi ✅ FATTO su un componente, l\'intervento resta registrato con i km che aveva.</div></div>';
  }

  h+='<div class="panel mb12"><div class="panel-head">🔩 COMPONENTI — INTERVENTI E CEDIMENTI</div><div class="panel-body" style="overflow-x:auto">'+
     '<table class="small" style="width:100%;border-collapse:collapse;text-align:left">'+
     '<tr style="opacity:.6"><th>COMPONENTE</th><th>INTERVENTI</th><th>ANTICIPATI</th><th>KM MEDI</th><th>COSTO TOTALE</th></tr>';
  R.rows.forEach(function(r){
    var col=r.early>0? 'var(--red)':'inherit';
    h+='<tr style="border-top:1px solid var(--border)">'+
       '<td><b>'+esc(r.name)+'</b><div class="small" style="opacity:.55">'+esc(r.car)+'</div></td>'+
       '<td class="mono">'+(r.jobs||'—')+'</td>'+
       '<td class="mono" style="color:'+col+'">'+(r.early? r.early+' ⚠':'—')+
         (r.early? '<div class="small" style="opacity:.7">a '+r.earlyKm.map(function(k){ return k.toFixed(0); }).join(', ')+' km</div>':'')+'</td>'+
       '<td class="mono">'+(r.mtb? Math.round(r.mtb)+' km':'—')+
         (r.limit>0? '<div class="small" style="opacity:.55">previsti '+r.limit.toFixed(0)+'</div>':'')+'</td>'+
       '<td class="mono">'+(r.spent>0? money(r.spent):'—')+'</td></tr>';
  });
  h+='</table>';
  h+='<div class="small" style="opacity:.7;margin-top:8px">«Anticipati» = interventi fatti prima del 70% della vita prevista: quasi sempre sono cedimenti, non manutenzione. '+
     'Se un componente ne accumula, o il limite che gli hai dato è troppo ottimista, o quel pezzo non regge il vostro uso.</div>';
  h+='</div></div>';

  /* riepilogo */
  h+='<div class="panel"><div class="panel-head">📊 IN SINTESI</div><div class="panel-body small" style="line-height:1.9">'+
     'Interventi registrati: <b>'+R.totalJobs+'</b>, di cui <b style="color:'+(R.totalEarly?'var(--red)':'inherit')+'">'+R.totalEarly+'</b> anticipati'+
     (R.totalJobs? ' ('+Math.round(100*R.totalEarly/R.totalJobs)+'%)':'')+'.<br>'+
     'Costo complessivo degli interventi: <b>'+money(R.totalCost)+'</b>.';
  var worst=R.rows.filter(function(r){ return r.early>0; })[0];
  if(worst) h+='<br>Il pezzo che vi ha tradito di più: <b>'+esc(worst.name)+'</b> ('+worst.early+' interventi anticipati'+(worst.unit>0? ', '+money(worst.unit)+' l\'uno':'')+').';
  h+='</div></div>';
  return h;
}

/* ═══ API ══════════════════════════════════════════════════════════════════ */
var SH={ KEY:KEY, load:load, save:save, render:render, inject:inject,
         snapshotCurrent:snapshotCurrent, archive:archive, reliability:reliability,
         issuesBySystem:issuesBySystem, driverProgress:driverProgress, spendSince:spendSince,
         lineChart:lineChart, EARLY:EARLY };
window.SH=SH;

SH.tab=function(t){ selTab=t; render(); };
SH.driver=function(id){ selDriver=id; render(); };
SH.archiveNow=function(){
  var s=snapshotCurrent();
  var nm=prompt('Nome della gara da archiviare:', s.name||'Gara');
  if(nm===null) return;
  nm=String(nm).trim(); if(!nm) return;
  var kmDef=s.km>0? s.km.toFixed(0):'';
  var km=prompt('Km totali della gara (PS + trasferimenti):', kmDef);
  if(km===null) return;
  var o=load();
  var last=o.events.length? o.events[o.events.length-1].ts : null;
  var sp=spendSince(last);
  var spIn=prompt('Spesa della gara ('+cur()+'):', String(Math.round(sp)));
  if(spIn===null) return;
  var ev=archive({
    name:nm, mode:s.mode, surface:s.surface, cars:s.cars, driverIds:s.driverIds,
    km:num(km,0), kmPS:s.kmPS, stages:s.stages, laps:s.laps,
    bestPos:s.bestPos, endPos:s.endPos, issues:s.issues, spend:num(spIn,0)
  });
  selTab='gare'; render();
  toast('📦 '+ev.name+' archiviata — '+(ev.issues||[]).length+' problemi, '+money(ev.spend));
};
SH.delEvent=function(id){
  if(!confirm('Togliere questa gara dallo storico?')) return;
  edit(function(o){ o.events=o.events.filter(function(e){ return e.id!==id; }); });
  render();
};
SH.exportCSV=function(){
  try {
    var o=load(), rows=['sezione;voce;dettaglio;valore1;valore2;valore3'];
    o.events.forEach(function(e){
      rows.push(['gara', e.name, new Date(e.ts).toISOString().slice(0,10),
        num(e.km,0).toFixed(0), (e.endPos||''), num(e.spend,0).toFixed(2)].join(';'));
    });
    reliability(null).rows.forEach(function(r){
      rows.push(['componente', r.name, r.car, r.jobs, r.early, r.spent.toFixed(2)].join(';'));
    });
    var D=drvData().drivers;
    Object.keys(D).forEach(function(id){
      var P=driverProgress(id); if(!P) return;
      rows.push(['pilota', P.name, P.n+' sessioni',
        (P.confStart==null?'':P.confStart.toFixed(1)), (P.confEnd==null?'':P.confEnd.toFixed(1)), P.venues].join(';'));
    });
    var a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob(['﻿'+rows.join('\n')],{type:'text/csv;charset=utf-8'}));
    a.download='storico_stagione_'+new Date().toISOString().slice(0,10)+'.csv';
    a.click();
    toast('Esportato');
  } catch(e){ toast('Export fallito: '+e.message); }
};

/* ─── salvataggi di sessione ──────────────────────────────────────────────── */
if(typeof window.serializeSession==='function' && !window._shSerWrapped){
  window._shSerWrapped=true;
  var _oSer=window.serializeSession;
  window.serializeSession=function(){
    var snap=_oSer.apply(this, arguments);
    try { if(snap){ snap._repModules=snap._repModules||{}; var v=localStorage.getItem(KEY); if(v!==null) snap._repModules[KEY]=v; } } catch(e){}
    return snap;
  };
}
if(typeof window.restoreSession==='function' && !window._shResWrapped){
  window._shResWrapped=true;
  var _oRes=window.restoreSession;
  window.restoreSession=function(snap){
    try { if(snap && snap._repModules && snap._repModules[KEY]) localStorage.setItem(KEY, snap._repModules[KEY]); } catch(e){}
    var r=_oRes.apply(this, arguments);
    setTimeout(function(){ try{ render(); }catch(e){} }, 240);
    return r;
  };
}

/* ─── pagina ──────────────────────────────────────────────────────────────── */
function inject(){
  if(document.getElementById('page-season')) return;
  var anyPage=document.querySelector('.page');
  var main=anyPage && anyPage.parentNode;
  if(!main) return;
  var pg=document.createElement('div');
  pg.className='page'; pg.id='page-season';
  pg.innerHTML='<div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">'+
    '<div style="font-family:var(--head);font-size:20px;font-weight:700;letter-spacing:2px;color:var(--accent3)">📚 STORICO STAGIONE</div>'+
    '<span class="small" style="opacity:.65">gare a confronto, crescita dei piloti, cosa si rompe</span></div>'+
    '<div id="sh-body"></div>';
  main.appendChild(pg);
  try { if(window.PAGES && !window.PAGES.some(function(p){ return p[0]==='season'; })) window.PAGES.push(['season','📚 Storico stagione']); } catch(e){}
  render();
}
if(typeof window.showPage==='function' && !window._shPageWrapped){
  window._shPageWrapped=true;
  var _oP=window.showPage;
  window.showPage=function(id){
    var r=_oP.apply(this, arguments);
    if(id==='season') setTimeout(render, 60);
    return r;
  };
}
function boot(){ inject(); render(); }
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(boot, 1600); });
else setTimeout(boot, 1600);
setTimeout(inject, 3400);
setTimeout(inject, 7400);

})();

