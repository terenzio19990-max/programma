REP2.calcDuel = function(){
  var out = document.getElementById('rep2-duel-out'); if(!out) return;
  var comps = (typeof _competitors!=='undefined') ? _competitors : [];
  var compId = +(document.getElementById('rep2-duel-comp')||{}).value;
  var comp = comps.filter(function(c){ return c.id===compId; })[0];
  var gap = +(document.getElementById('rep2-duel-gap')||{}).value;
  var rem = +(document.getElementById('rep2-duel-rem')||{}).value||0;
  if(!comp){ out.innerHTML='<div class="small">Aggiungi avversari nella pagina.</div>'; return; }
  st().duelPrefs = { compId:compId, gap:gap, rem:rem }; save();
  var carSet = STATE.mode==='rally' ? STATE.rallyCars : STATE.trackCars;
  var car = carSet[STATE.mode==='rally' ? STATE.selectedRallyCar : STATE.selectedTrackCar];
  var mine = lastValidMs(car.id, 5);
  var theirs = (comp.laps||[]).map(parseTime).filter(Boolean).slice(-5);
  if(mine.length<2 || theirs.length<2){ out.innerHTML='<div class="small" style="color:var(--yellow);">Servono ≥2 giri validi per entrambi (tu: '+mine.length+', lui: '+theirs.length+').</div>'; return; }
  var myPace = median(mine), hisPace = median(theirs);
  var delta = hisPace - myPace;
  var rows = ['<div>Passo: tu <b class="mono">'+msToTime(Math.round(myPace))+'</b> vs '+E(comp.name)+' <b class="mono">'+msToTime(Math.round(hisPace))+'</b> → delta <b class="mono" style="color:'+(delta>0?'var(--green)':'var(--red)')+';">'+(delta>0?'-':'+')+Math.abs(delta/1000).toFixed(3)+' s/giro</b> per te</div>'];
  if(Math.abs(delta)<50){
    rows.push('<div style="color:var(--yellow);">Passo praticamente identico: il gap resta ~'+Math.abs(gap).toFixed(1)+'s.</div>');
  } else if(gap>0 && delta>0){
    var k = Math.ceil(gap*1000/delta);
    rows.push('<div>🎯 Lo agganci in <b>'+k+'</b> giri'+(rem?(k<=rem?' → <b style="color:var(--green);">CE LA FAI</b> (restano '+rem+')':' → <b style="color:var(--red);">NON BASTA</b> (restano '+rem+', arrivi a -'+Math.max(0,(gap-delta*rem/1000)).toFixed(1)+'s)'):'')+'</div>');
  } else if(gap>0){
    rows.push('<div style="color:var(--red);">📉 È più veloce: il gap cresce di '+Math.abs(delta/1000).toFixed(3)+' s/giro.</div>');
  } else if(delta<0){
    var k2 = Math.ceil(Math.abs(gap)*1000/Math.abs(delta));
    rows.push('<div style="color:var(--red);">⚠️ Ti riprende in <b>'+k2+'</b> giri'+(rem?(k2<=rem?' — difendi!':' — al traguardo sei salvo di '+(Math.abs(gap)-Math.abs(delta)*rem/1000).toFixed(1)+'s'):'')+'</div>');
  } else {
    rows.push('<div style="color:var(--green);">✅ Sei davanti e più veloce: gap +'+Math.abs(delta/1000).toFixed(3)+' s/giro.</div>');
  }
  out.innerHTML = '<div style="display:flex;flex-direction:column;gap:6px;">'+rows.join('')+'</div>';
};

