function buildCorrelationMatrix() {
  var el = document.getElementById('correlation-matrix'); if(!el) return;
  var cars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;
  var car = cars[STATE.mode==='track' ? STATE.selectedTrackCar : STATE.selectedRallyCar];
  var setups = STATE.setup[car.id]||[];
  var laps = STATE.laps[car.id]||[];
  if(setups.length < 3) { el.innerHTML='<div style="color:var(--yellow);font-size:12px;">Servono almeno 3 setup salvati.</div>'; return; }
  var params = ['wingF','wingR','springF','springR','brakeBias','camberFL','camberRL','toeF','toeR'];
  var paramL = {wingF:'Ala Ant.',wingR:'Ala Post.',springF:'Molla Ant.',springR:'Molla Post.',brakeBias:'Bias Freno',camberFL:'Camber FL',camberRL:'Camber RL',toeF:'Toe Ant.',toeR:'Toe Post.'};
  var dataPoints = setups.map(function(setup,si) {
    var setupLap = +setup.lap||0;
    var nextSetupLap = si+1<setups.length?(+setups[si+1].lap||999):999;
    var relLaps = laps.filter(function(l){return (+l.lap||0)>setupLap&&(+l.lap||0)<nextSetupLap;});
    var bests = relLaps.map(function(l){return parseTime(l.time)||Infinity;}).filter(function(t){return isFinite(t);});
    var bestMs = bests.length ? Math.min.apply(null,bests) : null;
    return {setup:setup, bestMs:bestMs};
  }).filter(function(d){return d.bestMs;});
  if(dataPoints.length < 2) { el.innerHTML='<div style="color:var(--yellow);font-size:12px;">Non abbastanza giri nelle finestre tra setup.</div>'; return; }
  var bestTimes = dataPoints.map(function(d){return d.bestMs/1000;});
  var avgTime = bestTimes.reduce(function(a,b){return a+b;},0)/bestTimes.length;
  var correlations = params.map(function(param) {
    var vals = dataPoints.map(function(d){return parseFloat(d.setup[param])||0;});
    var avgVal = vals.reduce(function(a,b){return a+b;},0)/vals.length;
    var num = vals.reduce(function(sum,v,i){return (v-avgVal)*(bestTimes[i]-avgTime)+sum;},0);
    var den = Math.sqrt(vals.reduce(function(s,v){return Math.pow(v-avgVal,2)+s;},0)*bestTimes.reduce(function(s,t){return Math.pow(t-avgTime,2)+s;},0));
    var r = den>0?+(num/den).toFixed(3):null;
    return {param:param, label:paramL[param]||param, r:r};
  }).filter(function(d){return d.r!==null;}).sort(function(a,b){return Math.abs(b.r)-Math.abs(a.r);});
  var html = '<table class="data-table" style="max-width:600px;"><thead><tr><th>PARAMETRO</th><th>CORRELAZIONE</th><th>INTERPRETAZIONE</th></tr></thead><tbody>';
  correlations.forEach(function(d) {
    var abs = Math.abs(d.r);
    var strength = abs>0.7?'FORTE':abs>0.4?'MODERATA':abs>0.2?'DEBOLE':'NESSUNA';
    var col = abs>0.7?'var(--red)':abs>0.4?'var(--yellow)':abs>0.2?'var(--accent3)':'var(--text3)';
    html += '<tr><td>'+d.label+'</td><td class="mono" style="color:'+col+';">'+(d.r>0?'+':'')+d.r+'</td><td style="font-size:11px;color:var(--text3);">'+strength+'</td></tr>';
  });
  html += '</tbody></table><div style="font-size:10px;color:var(--text3);margin-top:8px;">Basato su '+dataPoints.length+' punti. r&gt;0 = valore alto = tempo lento.</div>';
  el.innerHTML = html;
}

