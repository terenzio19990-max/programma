<script>
/* REP-HOTFIX-BEGIN ====================================================
   HOTFIX AUDIT v18.2 — ripara chiamate a funzioni rinominate/mancanti
   trovate dall'audit statico+runtime dell'intero programma:
   1. refreshSessionList  -> renderSessionList (modal sessioni si rompeva
      a meta': lista salvataggi non popolata, tab non inizializzato)
   2. renderDiarioPage    -> renderDiaryPage        (refresh diario saltato)
   3. renderSchedaCarPage -> renderSchedaVetturaPage (refresh scheda saltato)
   4. renderDriverNotesSummary -> buildDriverNotesPage (fallback rotto)
   5. updateRallyCarsPanel / buildRallyOverviewPage / buildRallyServicePage
      -> rebuildStaticRallyTabs (i refresh rally saltavano in silenzio:
         pannelli/tab vetture rally non si aggiornavano dopo modifiche)
   6. buildTyreGrid       -> buildTyresPage (refresh griglia gomme saltato)
   7. ltParseHTMLTable    -> implementazione minima mancante (il Live
      Timing lanciava ReferenceError sui contenuti HTML non-JSON)
====================================================================== */
(function(){
'use strict';
if(window._repHotfix1) return;
window._repHotfix1 = true;

function alias(missing, target){
  if(typeof window[missing] !== 'function' && typeof window[target] === 'function'){
    window[missing] = function(){
      try { return window[target].apply(this, arguments); } catch(e){}
    };
    return true;
  }
  return false;
}
var applied = [];
if(alias('refreshSessionList','renderSessionList'))        applied.push('sessioni');
if(alias('renderDiarioPage','renderDiaryPage'))            applied.push('diario');
if(alias('renderSchedaCarPage','renderSchedaVetturaPage')) applied.push('scheda vettura');
if(alias('renderDriverNotesSummary','buildDriverNotesPage')) applied.push('note pilota');
if(alias('updateRallyCarsPanel','rebuildStaticRallyTabs')) applied.push('pannello rally');
if(alias('buildRallyOverviewPage','rebuildStaticRallyTabs')) applied.push('overview rally');
if(alias('buildRallyServicePage','rebuildStaticRallyTabs')) applied.push('assistenza rally');
if(alias('buildTyreGrid','buildTyresPage'))                applied.push('griglia gomme');

/* 7. Live Timing: parser minimo di tabelle HTML (pos | pilota | tempo/gap) */
if(typeof window.ltParseHTMLTable !== 'function'){
  window.ltParseHTMLTable = function(htmlText){
    try {
      if(!htmlText || htmlText.indexOf('<table')<0) return [];
      var doc = new DOMParser().parseFromString(htmlText, 'text/html');
      var best = null, bestRows = 0;
      doc.querySelectorAll('table').forEach(function(tb){
        var r = tb.querySelectorAll('tr').length;
        if(r > bestRows){ bestRows = r; best = tb; }
      });
      if(!best || bestRows < 2) return [];
      var out = [];
      var rows = best.querySelectorAll('tr');
      for(var i=0;i<rows.length;i++){
        var cells = rows[i].querySelectorAll('td,th');
        if(cells.length < 2) continue;
        var vals = [];
        for(var j=0;j<cells.length;j++) vals.push(cells[j].textContent.trim());
        // salta header (nessun numero nella prima cella)
        if(i===0 && !/\d/.test(vals[0])) continue;
        var timeIdx = -1;
        for(var k=vals.length-1;k>=1;k--){
          if(/\d+[:'.]\d{2}[.:]?\d*/.test(vals[k])){ timeIdx = k; break; }
        }
        var tv = timeIdx>=0? vals[timeIdx] : (vals[2]||'\u2014');
        out.push({
          pos: vals[0].replace(/\D/g,'') || String(out.length+1),
          name: vals[1] || '\u2014', num: '',
          last: tv, best: tv, gap: vals[timeIdx+1]||'\u2014', laps: '\u2014',
          raw: vals
        });
      }
      return out;
    } catch(e){ return []; }
  };
  applied.push('live timing parser');
}

if(applied.length && window.console)
  console.log('[REP-Hotfix] riparate '+applied.length+' funzioni: '+applied.join(', '));
})();
/* REP-HOTFIX-END-MARKER */

</script>
