REP2._coTick = function(){
  if(!STATE.rallyCO || !STATE.rallyCO.length) return;
  var now = new Date();
  STATE.rallyCO.forEach(function(co){
    var cell = document.getElementById('rep2-co-cd-'+co.id);
    if(co.done){ if(cell) cell.textContent='TIMBRATO'; return; }
    var diff = Math.round((REP2._coTarget(co) - now)/1000);
    if(cell){
      if(diff<0){ cell.textContent='PASSATO'; cell.style.color='var(--red)'; }
      else {
        var h=Math.floor(diff/3600), m=Math.floor((diff%3600)/60), s=diff%60;
        cell.textContent=(h?h+':':'')+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
        cell.style.color = diff<=60?'var(--red)':diff<=300?'var(--yellow)':'var(--text1)';
      }
    }
    if(diff>0 && diff<=300 && !co.a5){ co.a5=true; save(); if(typeof playAlertSound==='function') playAlertSound(); toast('⏱ 5 MINUTI al CO: '+co.name+' ('+co.time+')'); }
    if(diff>0 && diff<=60  && !co.a1){ co.a1=true; save(); if(typeof playAlertSound==='function'){ playAlertSound(); setTimeout(playAlertSound,400); } toast('🚨 1 MINUTO al CO: '+co.name+'!'); }
  });
};
