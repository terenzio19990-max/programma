  heatmapCar: null,
  suggestCar: null,
};

function buildAnalisiPage(){
  // Populate driver filter
  if(typeof _populateDriverFilter === 'function') _populateDriverFilter('an-driver-filter');
  // Ensure at least some cars are selected for overlay
  var cars = _anAllCars();
  if(!Object.keys(AN.overlaySelected).length){
    // Auto-select first 2 cars with laps
    var pick = cars.filter(function(c){return (STATE.laps[c.id]||[]).length>0;}).slice(0,2);
    pick.forEach(function(c){ AN.overlaySelected[c.id] = true; });
  }
  if(!AN.degradoCar){
