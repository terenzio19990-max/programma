function updateAllWear(mode) {
  const cid = mode==='track' ? 'wear-cards-track' : 'wear-cards-rally';
  const tyresObj = mode==='track' ? STATE.tyres : STATE.rallyTyres;
  const car = mode==='track' ? STATE.trackCars[STATE.selectedTrackCar] : STATE.rallyCars[STATE.selectedRallyCar];
  if(!tyresObj[car.id]?.current) return;
  WHEELS.forEach(w=>{
    tyresObj[car.id].current.wheels[w].wear = +document.getElementById(`wu-${cid}-${w}`)?.value||0;
    tyresObj[car.id].current.wheels[w].damage = document.getElementById(`wd-${cid}-${w}`)?.value||'none';
    tyresObj[car.id].current.wheels[w].temp = document.getElementById(`wt-${cid}-${w}`)?.value||'';
  });
  // ─── Magazzino gomme: sync live wear/damage to stock entries by code ───
  try {
    if(typeof TYRE_STOCK !== 'undefined' && typeof tsSave === 'function'){
      tsLoad();
      var changed = false;
      WHEELS.forEach(function(w){
        var wd = tyresObj[car.id].current.wheels[w];
        if(!wd || !wd.code) return;
        var t = TYRE_STOCK.find(function(x){return x.code === wd.code && x.status === 'mounted';});
        if(!t) return;
        if(t.wear !== +wd.wear || t.damage !== wd.damage){
          t.wear = +wd.wear || 0;
          t.damage = wd.damage || 'none';
          changed = true;
        }
      });
      if(changed) tsSave();
    }
  } catch(e){ console.warn('Stock wear sync fail',e); }
  // ──────────────────────────────────────────────────────────────────────
  renderTyreGrid(tyresObj[car.id], mode==='track'?'tyre-grid-current':'rally-tyre-grid-current', mode==='track'?'tyre-km-disp':'rally-tyre-km-disp');
  buildTyreHistoryTable(car.id, mode);
  setTimeout(runAlertChecks, 300);
}

