// ─── 6) HEATMAP — best lap by hour-of-day / temperature ─────────
function _renderStatsHeatmap(){
  var cars = _statsCarsList();
  var driverFilter = _selectedDriverFilter('stats-driver-filter');
  // Collect all laps with timestamp + (optional) temperature from meteo log
  var allLaps = [];
  cars.forEach(function(car){
    _lapsForCar(car.id, driverFilter).forEach(function(l){
      var ms = parseTime(l.time);
      if(!ms||!isFinite(ms)) return;
      // Estimate hour from session label or timestamp if available
      var hour = null;
      if(l.ts){ hour = new Date(l.ts).getHours(); }
      // Estimate temperature — use most recent meteo note or current
      var temp = (typeof METEO_STATE !== 'undefined' && METEO_STATE.current && METEO_STATE.current.temp) ? +METEO_STATE.current.temp : null;
      allLaps.push({ ms: ms, hour: hour, temp: temp, session: l.session });
    });
  });
  if(!allLaps.length){
    return '<div style="padding:30px;text-align:center;color:var(--text3);">Nessun giro disponibile per la heatmap.</div>';
  }

  // Group by session label (this is the most reliable bucket we actually have)
  var bySession = {};
  allLaps.forEach(function(l){
    var s = l.session || '—';
    if(!bySession[s]) bySession[s] = [];
    bySession[s].push(l.ms);
  });
  var sessions = Object.keys(bySession);
  var bestPerSession = sessions.map(function(s){
    var times = bySession[s];
    return { session: s, best: Math.min.apply(null, times), avg: times.reduce(function(a,b){return a+b;},0)/times.length, count: times.length };
  });
  bestPerSession.sort(function(a,b){return a.best - b.best;});

  // Find global min/max for color scale
  var globalMin = Math.min.apply(null, bestPerSession.map(function(s){return s.best;}));
  var globalMax = Math.max.apply(null, bestPerSession.map(function(s){return s.avg;}));
  function colorForMs(ms){
    if(globalMin === globalMax) return 'var(--green)';
    var pct = (ms - globalMin)/(globalMax - globalMin); // 0..1, 0=fast
    if(pct < 0.25) return 'rgba(44,188,110,0.8)';
    if(pct < 0.5)  return 'rgba(34,197,94,0.6)';
    if(pct < 0.75) return 'rgba(245,158,11,0.7)';
    return 'rgba(213,58,58,0.7)';
  }

  var out = '<div class="panel"><div class="panel-head">🌡 PERFORMANCE PER SESSIONE</div><div class="panel-body">';
  out += '<div style="font-size:11px;color:var(--text3);margin-bottom:10px;line-height:1.5;">'+
    'Mappa di calore: best lap e media per ogni tipo di sessione. Verde = veloce, rosso = lento. '+
    'Aiuta a vedere dove la vettura va meglio e dove c\'è margine di miglioramento.'+
  '</div>';
  out += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;">';
  bestPerSession.forEach(function(s){
    var col = colorForMs(s.best);
    out += '<div style="background:'+col+';border-radius:5px;padding:12px;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,0.4);">'+
      '<div style="font-family:var(--head);font-size:11px;letter-spacing:1.5px;margin-bottom:6px;opacity:0.9;">'+(s.session||'—').toUpperCase()+'</div>'+
      '<div style="font-family:var(--mono);font-size:18px;font-weight:700;">'+_statsFmtMs(s.best)+'</div>'+
      '<div style="font-size:10px;opacity:0.85;margin-top:2px;">media: '+_statsFmtMs(s.avg)+' · '+s.count+' giri</div>'+
    '</div>';
  });
  out += '</div></div></div>';

  return out;
}

// ─── 7) SETUP — which changes correlated with improvement ───────
function _renderStatsSetup(){
  var cars = _statsCarsList();
  var driverFilter = _selectedDriverFilter('stats-driver-filter');
  var changes = []; // {field, deltaValue, deltaTime, car}
  cars.forEach(function(car){
    var setups = STATE.setup && STATE.setup[car.id] || [];
    if(!setups.length) return;
    var laps = _lapsForCar(car.id, driverFilter);
    // For each setup change, compare best lap before vs after
    var SETUP_FIELDS = ['wingF','wingR','splitter','brakeBias','engMap','springF','springR','barF','barR',
                        'bumpF','rebF','bumpR','rebR','camberFL','camberFR','camberRL','camberRR','toeF','toeR'];
    for(var i=1;i<setups.length;i++){
      var prev = setups[i-1], curr = setups[i];
      // Approx best lap before/after by session
      var prevBest = _statsBestForSession(laps, prev.session);
      var currBest = _statsBestForSession(laps, curr.session);
      if(!prevBest || !currBest) continue;
      var deltaTime = currBest - prevBest;
      SETUP_FIELDS.forEach(function(f){
        if(prev[f] !== undefined && curr[f] !== undefined && prev[f] !== curr[f]){
          changes.push({ field: f, from: prev[f], to: curr[f], deltaTime: deltaTime, car: car.name });
        }
      });
    }
  });

  if(!changes.length){
    return '<div style="padding:30px;text-align:center;color:var(--text3);">Servono almeno 2 setup salvati con sessioni di tempi associate per calcolare correlazioni.</div>';
  }

  // Group changes by field, average delta time
  var byField = {};
  changes.forEach(function(ch){
    if(!byField[ch.field]) byField[ch.field] = { count:0, totalDelta:0, examples:[] };
    byField[ch.field].count++;
    byField[ch.field].totalDelta += ch.deltaTime;
    byField[ch.field].examples.push(ch);
  });
  var fields = Object.keys(byField).sort(function(a,b){return byField[a].totalDelta/byField[a].count - byField[b].totalDelta/byField[b].count;});

  var out = '<div class="panel"><div class="panel-head">🔬 IMPATTO MEDIO MODIFICHE SETUP</div><div class="panel-body" style="overflow-x:auto;">';
  out += '<div style="font-size:11px;color:var(--text3);margin-bottom:10px;line-height:1.5;">'+
    'Ogni volta che hai cambiato un parametro setup tra una sessione e quella successiva, calcoliamo la differenza tra il best lap delle 2 sessioni. '+
    'Verde = miglioramento, rosso = peggioramento. Solo correlazione (non causazione): altri fattori influenzano i tempi.'+
  '</div>';
  out += '<table class="data-table"><thead><tr><th>PARAMETRO</th><th># MODIFICHE</th><th>Δ TEMPO MEDIO</th><th>VALUTAZIONE</th></tr></thead><tbody>';
  fields.forEach(function(f){
    var d = byField[f];
    var avg = d.totalDelta / d.count;
    var color = avg < -100 ? 'var(--green)' : avg < 100 ? 'var(--text3)' : 'var(--red)';
    var label = avg < -100 ? '✓ Migliora' : avg < 100 ? '~ Neutro' : '✗ Peggiora';
    out += '<tr>'+
      '<td><b>'+f+'</b></td>'+
      '<td>'+d.count+'</td>'+
      '<td style="font-family:var(--mono);color:'+color+';font-weight:700;">'+(avg>=0?'+':'')+(avg/1000).toFixed(3)+'s</td>'+
      '<td style="color:'+color+';">'+label+'</td>'+
    '</tr>';
  });
  out += '</tbody></table></div></div>';

  return out;
}

function _statsBestForSession(laps, session){
  if(!session) return null;
  var times = laps.filter(function(l){return l.session === session;}).map(function(l){return parseTime(l.time);}).filter(function(t){return t&&isFinite(t);});
  return times.length ? Math.min.apply(null, times) : null;
}

