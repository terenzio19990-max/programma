// ── Alert checkers (run every 10s + on key actions) ──
function runAlertChecks() {
  const fuelThreshold  = +(document.getElementById('alert-fuel-pct')?.value)||20;
  const wearThreshold  = +(document.getElementById('alert-wear-pct')?.value)||75;
  const sessionMinLeft = +(document.getElementById('alert-session-min')?.value)||5;

  // 1. Fuel alerts
  [...STATE.trackCars,...STATE.rallyCars].forEach(car=>{
    const fuel = STATE.fuel[car.id];
    if(fuel && fuel.capacity>0) {
      const pct = (fuel.current/fuel.capacity)*100;
      if(pct<=fuelThreshold && pct>0) pushNotif('warn','⛽','CARBURANTE BASSO',car.name+' — '+pct.toFixed(0)+'% rimasto ('+fuel.current.toFixed(1)+'L)',{key:'fuel_'+car.id,cooldown:120000});
      if(pct<=5) pushNotif('crit','🚨','CARBURANTE CRITICO',car.name+' — Carburante quasi esaurito!',{key:'fuel_crit_'+car.id,cooldown:30000});
    }
  });

  // 2. Tyre wear alerts
  [...STATE.trackCars,...STATE.rallyCars].forEach(car=>{
    const ts = STATE.tyres[car.id];
    if(ts?.current?.wheels) {
      const WHEELS=['FL','FR','RL','RR'];
      WHEELS.forEach(w=>{
        const wear = ts.current.wheels[w]?.wear||0;
        const dmg  = ts.current.wheels[w]?.damage||'none';
        if(wear>=wearThreshold) pushNotif('warn','🔴','USURA GOMMA',car.name+' — '+w+' al '+wear+'% — valuta cambio treno',{key:'tyre_'+car.id+w,cooldown:180000});
        if(dmg==='puncture') pushNotif('crit','💥','FORATURA RILEVATA',car.name+' — '+w+' segnata come forata!',{key:'punct_'+car.id+w,cooldown:30000});
      });
    }
  });

  // 3. Session timer alert
  if(SESSION_DURATION_MS>0 && STATE.sessionTimerRunning) {
    const elapsed = STATE.sessionTimerRunning ? Date.now()-STATE.sessionTimerStart : 0;
    const rem = SESSION_DURATION_MS - elapsed - (SESSION_DURATION_MS-STATE.sessionTimerElapsed);
    const remMs = STATE.sessionTimerRunning ? Math.max(0, SESSION_DURATION_MS - (Date.now()-STATE.sessionTimerStart)) : STATE.sessionTimerElapsed;
    if(remMs>0 && remMs < sessionMinLeft*60000) pushNotif('warn','⏱','FINE SESSIONE',Math.ceil(remMs/60000)+' minuti alla fine della sessione',{key:'session_end',cooldown:60000});
    if(remMs>0 && remMs < 60000) pushNotif('crit','⏱','ULTIMO MINUTO','Meno di 1 minuto alla fine!',{key:'session_1min',cooldown:20000});
  }
}

// Weather alert checker (called after fetch)
function runWeatherAlerts(code, wind, temp, hum) {
  if(code>=61&&code<=69) pushNotif('weather','🌧','PIOGGIA IN ARRIVO','Possibile pista bagnata — considera cambio gomme',{key:'rain_alert',cooldown:300000});
  if(code>=71&&code<=77) pushNotif('weather','❄️','NEVE/GHIACCIO','Condizioni di neve rilevate — massima attenzione',{key:'snow_alert',cooldown:300000});
  if(code>=80&&code<=99) pushNotif('weather','⛈','TEMPORALE','Temporale nell\'area — rivaluta la strategia',{key:'storm_alert',cooldown:300000});
  if(wind>60)  pushNotif('weather','💨','VENTO FORTE',wind+' km/h — può influenzare l\'aerodinamica',{key:'wind_alert',cooldown:300000});
  if(temp<5)   pushNotif('weather','🧊','TEMPERATURA BASSA',temp+'°C — gomme fredde, attenzione al warm-up',{key:'cold_alert',cooldown:300000});
  if(hum>90)   pushNotif('weather','💧','UMIDITÀ ELEVATA',hum+'% — pista potenzialmente scivolosa',{key:'hum_alert',cooldown:300000});
}

