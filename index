        '<div style="height:100%;width:'+Math.min(100,lsPct)+'%;background:'+lsColor+';border-radius:3px;transition:width .3s;"></div>'+
      '</div>'+
    '</div>'+
    '<div style="color:var(--text3);font-size:11px;">'+
