try { if(navigator.storage && navigator.storage.persist) navigator.storage.persist(); } catch(e){}

/* ═══ 1) SESSIONI MANUALI SU INDEXEDDB (limite 5MB rimosso) ═══ */
var _sessCache = null;

function idbAll(){
  return openIDB().then(function(db){
    return new Promise(function(res){
      var tx=db.transaction(IDB_STORE,'readonly');
      var rq=tx.objectStore(IDB_STORE).getAll();
      rq.onsuccess=function(){ res(rq.result||[]); };
      rq.onerror=function(){ res([]); };
    });
  });
}
function isAutoName(n){ return n==='_autosave_' || n==='_idb_autosave_'; }

function repLoadSessCache(){
  return idbAll().then(function(all){
    _sessCache = all.filter(function(s){ return s && s.name && !isAutoName(s.name); });
    _sessCache.sort(function(a,b){ return (new Date(b.savedAt||0)) - (new Date(a.savedAt||0)); });
    return _sessCache;
  }).catch(function(){ _sessCache=null; });
}
function repMigrateSessions(){
  var list=[];
  try { list=JSON.parse(localStorage.getItem(SESSION_STORAGE_KEY)||'[]'); } catch(e){}
  if(!list.length) return Promise.resolve();
  return openIDB().then(function(db){
    return new Promise(function(res){
      var tx=db.transaction(IDB_STORE,'readwrite');
      list.forEach(function(s){ if(s&&s.name) { if(!s.savedAt) s.savedAt=nowIso(); tx.objectStore(IDB_STORE).put(s); } });
      tx.oncomplete=function(){ res(true); };
      tx.onerror=function(){ res(false); };
    });
  }).then(function(ok){
    if(ok){
      try { localStorage.removeItem(SESSION_STORAGE_KEY); } catch(e){}
      toast('📦 '+list.length+' sessione/i migrate su IndexedDB — limite 5MB rimosso');
    }
  }).catch(function(){});
}

window.getAllSessions = function(){
  if(_sessCache) return _sessCache.slice();
  try { return JSON.parse(localStorage.getItem(SESSION_STORAGE_KEY)||'[]'); } catch(e){ return []; }
};
window.saveAllSessions = function(list){
  _sessCache = list.slice();
  openIDB().then(function(db){
    return idbAll().then(function(existing){
      return new Promise(function(res){
        var keep={};
        list.forEach(function(s){ if(s&&s.name){ if(!s.savedAt) s.savedAt=nowIso(); keep[s.name]=1; } });
        var tx=db.transaction(IDB_STORE,'readwrite');
        var st=tx.objectStore(IDB_STORE);
        list.forEach(function(s){ if(s&&s.name) st.put(s); });
        existing.forEach(function(s){
          if(s&&s.name&&!isAutoName(s.name)&&!keep[s.name]) st.delete(s.name);
        });
        tx.oncomplete=function(){ res(true); };
        tx.onerror=function(){ res(false); };
