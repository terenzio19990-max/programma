  if(p) p.style.display = p.style.display==='none' ? 'block' : 'none';
}
async function coopFbJoinRoom(){
  _persistIdentity();
  if(!COOP.me.name){ showToast('⚠️ Inserisci il tuo nome'); return; }
  var room = document.getElementById('coop-fb-room')?.value?.trim();
  if(!room){ showToast('⚠️ Inserisci un nome stanza'); return; }
  var cfg;
  try { cfg = JSON.parse(localStorage.getItem('coop_fb_config')||'{}'); } catch(e){ showToast('❌ Config Firebase mancante'); return; }
  if(!cfg.projectId){ showToast('❌ Config Firebase invalida'); return; }
  coopUpdateStatus('connecting','Caricamento Firebase...','🟡');
  var mods = await window.loadFirebaseModules();
  if(!mods){ showToast('❌ Impossibile caricare Firebase'); coopUpdateStatus('disconnected','Errore','⚪'); return; }
  try {
    var app = mods.app.initializeApp(cfg, 'rep-coop-'+Date.now());
    var db = mods.db.getFirestore(app);
    COOP.fbApp = app; COOP.fbDb = db; COOP.fbRoom = room;
    COOP.me.id = 'fb-'+coopShortId();

    // Sub to session snapshot doc
    var sessionDoc = mods.db.doc(db, 'sessions', room);
    var eventsCol  = mods.db.collection(db, 'sessions', room, 'events');
    var presenceCol = mods.db.collection(db, 'sessions', room, 'presence');

    // Presence heartbeat
    var myPresDoc = mods.db.doc(db, 'sessions', room, 'presence', COOP.me.id);
    await mods.db.setDoc(myPresDoc, { name:COOP.me.name, color:COOP.me.color, ts:Date.now() });
    var hbInterval = setInterval(function(){
      try { mods.db.setDoc(myPresDoc, { name:COOP.me.name, color:COOP.me.color, ts:Date.now() }); } catch(e){}
    }, 15000);
    window.addEventListener('beforeunload', function(){ try { mods.db.deleteDoc(myPresDoc); } catch(e){} });

    // Listen for events (operations) from other engineers
    var qEvents = mods.db.query(eventsCol, mods.db.orderBy('ts','asc'));
    var unsubEvents = mods.db.onSnapshot(qEvents, function(snap){
      snap.docChanges().forEach(function(ch){
        if(ch.type==='added'){
          var ev = ch.doc.data();
          if(ev.from === COOP.me.id) return; // skip own events
          _handleCoopMessage(ev, ev.from);
        }
      });
    });
    COOP.fbUnsub.push(unsubEvents);

    // Listen for presence
    var unsubPres = mods.db.onSnapshot(presenceCol, function(snap){
      var now = Date.now();
      var newPeers = {};
      snap.forEach(function(d){
        var p = d.data();
        if(d.id === COOP.me.id) return;
        // Consider alive if heartbeat within last 40s
        if(now - (p.ts||0) < 40000){
          newPeers[d.id] = { name:p.name, color:p.color, lastSeen:p.ts };
        }
      });
      COOP.peers = newPeers;
      _updateCoopPeersList();
      coopUpdateStatus('connected','Firebase · '+Object.keys(newPeers).length+' ingegneri','🔥');
    });
    COOP.fbUnsub.push(unsubPres);

    // Load initial snapshot (if any)
    var sessSnap = await mods.db.getDoc(sessionDoc);
    if(sessSnap.exists()){
      var d = sessSnap.data();
      if(d.state){
        _applyCoopSnapshot(d.state);
        coopLog('📥 Snapshot iniziale ricevuto dalla stanza');
      }
    } else {
      // Create room doc with our current state as seed
      await mods.db.setDoc(sessionDoc, { createdAt:Date.now(), state: _coopSnapshot(), createdBy:COOP.me.name });
      coopLog('🆕 Stanza creata ("'+room+'")');
    }

    document.getElementById('coop-fb-config-wrap').style.display='none';
    document.getElementById('coop-fb-room-wrap').style.display='none';
    document.getElementById('coop-fb-connected-info').style.display='block';
    document.getElementById('coop-fb-room-display').textContent = room;
    coopUpdateStatus('connected','Firebase · stanza "'+room+'"','🔥');
    coopLog('🔥 Connesso a Firestore — '+room);
    showToast('🔥 Connesso a stanza "'+room+'"');
  } catch(e){
    console.error(e);
    showToast('❌ Errore Firebase: '+e.message);
    coopLog('❌ '+e.message);
    coopUpdateStatus('disconnected','Errore','⚪');
  }
}
async function _coopFbPublish(msg){
  if(!COOP.fbDb || !COOP.fbRoom) return;
  var mods = window._FB_MODS;
  if(!mods) return;
  try {
    msg.from = COOP.me.id;
    msg.fromName = COOP.me.name;
    msg.ts = Date.now();
    var col = mods.db.collection(COOP.fbDb, 'sessions', COOP.fbRoom, 'events');
    await mods.db.addDoc(col, msg);
  } catch(e){ coopLog('⚠️ Publish fail: '+e.message); }
}

