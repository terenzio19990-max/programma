      var menu=grp.querySelector('.nav-group-menu');
      if(menu && !menu.querySelector('[data-rep-anlz]')){
        menu.insertAdjacentHTML('beforeend',
          '<div class="nav-menu-item" data-rep-anlz="1" onclick="showPage(\'rep-anlz\');closeNavGroups()" style="color:var(--yellow)">📉 Analisi giro</div>');
      }
    }
  });
}
function hook(){
  if(typeof window.showPage==='function' && !window._repAnlzWrapped){
    window._repAnlzWrapped=true;
    var o=window.showPage;
    window.showPage=function(id){
      var r=o.apply(this,arguments);
      try { injectPage(); injectMenu(); if(id==='rep-anlz') fillSelects(); } catch(e){}
      return r;
    };
  }
}
function init(){ try { injectPage(); injectMenu(); hook(); } catch(e){} }
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 1200); });
else setTimeout(init, 1200);

console.log('[REP-Anlz] analisi giro attiva');
})();
