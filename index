window.saRunTarget = function(mode){
  var out = document.getElementById('sa-tgt-out-'+mode);
  if(!out) return;
  var ctx = saCtx(mode);
  var goalStr = gv('sa-tgt-goal-'+mode);
  var curStr = gv('sa-tgt-cur-'+mode);
  var goalMs = parseTime(goalStr);
  var curMs = curStr? parseTime(curStr) : ctx.refMs;
  if(!goalMs){ out.innerHTML='<span class="small" style="color:var(--yellow)">Inserisci un tempo obiettivo valido (es. 1:42.500).</span>'; return; }
  if(!curMs){ out.innerHTML='<span class="small" style="color:var(--yellow)">Nessun tempo attuale: registra un '+(mode==='rally'?'tempo PS':'giro')+' o inseriscilo a mano.</span>'; return; }
  saSetTarget(ctx.car.id, goalStr);
  var needGain = (curMs - goalMs)/1000;   // secondi da trovare
  var html = '<div class="small">Attuale <b>'+msToStr(curMs)+'</b> → obiettivo <b>'+msToStr(goalMs)+'</b>: ';
  if(needGain<=0){
    html += 'sei già più veloce dell’obiettivo di '+(-needGain).toFixed(3)+' s.</div>';
    out.innerHTML = html; return;
  }
  html += 'servono <b>'+needGain.toFixed(3)+' s</b>.</div>';
  var res = saSuggest(ctx.cur, ctx.p, ctx.surf, ctx.prof, 6);
  if(!res.steps.length){
    html += '<div class="small" style="margin-top:6px;color:var(--yellow)">Il modello non trova modifiche di setup con guadagno affidabile dal punto attuale: il setup è vicino all’ottimo per come sono impostati profilo tracciato e parametri. Rivedi 🛣 PROFILO (quote zone, sconnesso) e ⚙ PARAMETRI, o cerca il tempo in guida/gomme.</div>';
    out.innerHTML = html; return;
  }
  html += '<ol style="margin:8px 0 4px 18px;font-size:12px;line-height:1.8">';
  res.steps.forEach(function(st){
    var bal = Math.abs(st.dU)>0.003? ' · bilancio '+(st.dU>0?'+':'')+(st.dU*100).toFixed(1)+' pt '+(st.dU>0?'sovra':'sotto') : '';
    html += '<li><b>'+esc(st.lab)+'</b> <span style="color:var(--green)">'+st.dt.toFixed(3)+' s</span> <span class="small">'+st.conf+bal+'</span></li>';
  });
  html += '</ol>';
  var calF=(ctx.cal&&ctx.cal.n>=2)? ctx.cal.factor:1;
  var gain = -res.total*calF;
  var covPct = Math.max(0, Math.min(100, gain/needGain*100));
  var covCol = covPct>=99? 'var(--green)' : covPct>=50? 'var(--yellow)' : 'var(--red)';
  html += '<div class="small">Guadagno complessivo previsto (ricalcolato in blocco): <b style="color:var(--green)">'+(res.total*calF).toFixed(3)+' ± '+(res.unc*Math.max(1,calF)).toFixed(3)+' s</b>'+(calF!==1?' (cal.×'+calF.toFixed(2)+')':'')+'</div>';
  html += '<div style="height:12px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;overflow:hidden;margin:6px 0">' +
    '<div style="height:100%;width:'+covPct.toFixed(0)+'%;background:'+covCol+'"></div></div>';
  if(covPct>=99){
    html += '<div class="small" style="color:var(--green)">✔ Il setup può coprire l’intero gap secondo il modello. Applica le modifiche in ordine, UNA alla volta, e verifica in pista (Smith: un aggiustamento per volta).</div>';
  } else {
    html += '<div class="small" style="color:var(--yellow)">Il setup copre ≈ '+covPct.toFixed(0)+'% del gap ('+gain.toFixed(3)+' su '+needGain.toFixed(3)+' s). Il resto difficilmente arriva dall’assetto: guarda guida (traiettorie, frenate), gomme/pressioni, benzina a bordo, condizioni pista.</div>';
  }
  html += '<div class="small" style="margin-top:4px;opacity:.75">Modello del primo ordine (● alta · ◐ media · ○ bassa confidenza): i guadagni non sono garantiti né perfettamente additivi. Non conosce stile di guida, usura gomme e meteo.</div>';
  out.innerHTML = html;
};


