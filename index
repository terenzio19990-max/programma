// TIMING CSV IMPORT (MyLaps / generic)
// ═══════════════════════════════════════════════════════════════
function loadTimingCSV(event) {
  var file = event.target.files[0]; if(!file) return;
  var sel = document.getElementById('timing-car-sel');
  if(sel) {
    var allCars = STATE.trackCars.concat(STATE.rallyCars);
    sel.innerHTML = allCars.map(function(c){ return '<option value="'+c.id+'">'+c.name+'</option>'; }).join('');
  }
  var reader = new FileReader();
  reader.onload = function(e){ parseTimingCSV(e.target.result); };
  reader.readAsText(file);
}
function parseTimingCSV(text) {
  var lines = text.split('\n').map(function(l){return l.trim();}).filter(function(l){return l;});
  var st = document.getElementById('timing-status');
  if(lines.length < 2) { if(st) st.innerHTML='<span style="color:var(--red);">File vuoto</span>'; return; }
  var headers = lines[0].toLowerCase().replace(/['"]/g,'').split(',').map(function(h){return h.trim();});
  var lapIdx  = headers.findIndex(function(h){return h.includes('lap')||h.includes('giro');});
  var timeIdx = headers.findIndex(function(h){return h.includes('time')||h.includes('tempo');});
  var posIdx  = headers.findIndex(function(h){return h.includes('pos');});
  var s1Idx   = headers.findIndex(function(h){return h==='s1'||h.includes('sector1');});
  var s2Idx   = headers.findIndex(function(h){return h==='s2'||h.includes('sector2');});
  var s3Idx   = headers.findIndex(function(h){return h==='s3'||h.includes('sector3');});
  var vmaxIdx = headers.findIndex(function(h){return h==='vmax'||h==='v.max'||h==='speed'||h==='kmh'||h==='km/h'||h.includes('velocit')||h.includes('top speed');});
  if(timeIdx===-1) { if(st) st.innerHTML='<span style="color:var(--red);">Colonna "time/tempo" non trovata. Intestazioni: '+headers.join(', ')+'</span>'; return; }
  var sel = document.getElementById('timing-car-sel');
  var carId = sel ? sel.value : null;
  var allCars = STATE.trackCars.concat(STATE.rallyCars);
  var car = carId ? allCars.filter(function(c){return c.id===carId;})[0] : allCars[0];
  if(!car) { if(st) st.innerHTML='<span style="color:var(--red);">Vettura non trovata</span>'; return; }
  if(!STATE.laps[car.id]) STATE.laps[car.id]=[];
  var snap = JSON.parse(JSON.stringify(STATE.laps[car.id]));
  pushUndo('Import CSV '+car.name, function(){STATE.laps[car.id]=snap;});
  var imported = 0;
  for(var i=1; i<lines.length; i++) {
    var cols = lines[i].replace(/['"]/g,'').split(',').map(function(v){return v.trim();});
    var time = cols[timeIdx];
    if(!time||!parseTime(time)) continue;
    STATE.laps[car.id].push({
      lap: lapIdx>=0?(+cols[lapIdx]||i):i,
      time: time,
      s1: s1Idx>=0?cols[s1Idx]:'',
      s2: s2Idx>=0?cols[s2Idx]:'',
      s3: s3Idx>=0?cols[s3Idx]:'',
      pos: posIdx>=0?cols[posIdx]:'',
      vmax: vmaxIdx>=0?(+String(cols[vmaxIdx]).replace(',','.')||null):null,
      note: '', session:'CSV Import', car:car.id
    });
    imported++;
  }
  if(st) st.innerHTML='<span style="color:var(--green);">Importati '+imported+' giri per '+car.name+'</span>';
  showToast('Importati '+imported+' giri per '+car.name);
  triggerAutoSave();
}

