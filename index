// ═══════════════════════════════════════════════════════════════
// VOICE INPUT (dictation) — Web Speech API for Italian
// Adds a 🎙 button next to text fields; click → talk → text appears.
// Includes a motorsport-Italian correction dictionary to fix common
// mis-recognitions (sotto sterzo → sottosterzo, ecc.)
// ═══════════════════════════════════════════════════════════════

// Check if the browser supports speech recognition
function _voiceSupported(){
  return typeof (window.SpeechRecognition || window.webkitSpeechRecognition) === 'function';
}

// Italian motorsport-specific corrections applied after recognition.
// Each entry: [regex, replacement]. Order matters — more specific first.
var VOICE_CORRECTIONS = [
  // Termini chiave: separati → uniti
  [/\bsotto\s+sterzo\b/gi, 'sottosterzo'],
  [/\bsovra\s+sterzo\b/gi, 'sovrasterzo'],
  [/\bsotto\s+steerz\w*\b/gi, 'sottosterzo'],
  [/\bcontro\s+sterzo\b/gi, 'controsterzo'],
  [/\bsempre\s+verde\b/gi, 'semaforo verde'],
  // Tempi e numeri
  [/\bsec\b/gi, 'secondi'],
  [/\bms\b/gi, 'millisecondi'],
  [/\bkm\b/gi, 'km'],
  // Marche/componenti spesso fraintese
  [/\bolins\b/gi, 'Ohlins'],
  [/\bolinis\b/gi, 'Ohlins'],
  [/\bbilstein?\b/gi, 'Bilstein'],
  [/\bbrembo\b/gi, 'Brembo'],
  [/\bsacks\b/gi, 'Sachs'],
  [/\bk?\s*w\b/gi, 'KW'],
  [/\bcockpit\b/gi, 'cockpit'],
  // Gomme
  [/\bsoft\b/gi, 'Soft'],
  [/\bmedium\b/gi, 'Medium'],
  [/\bhard\b/gi, 'Hard'],
  [/\bwet\b/gi, 'Wet'],
  [/\bdot\b/gi, 'DOT'],
  // Settori
  [/\bs\s*1\b/gi, 'S1'],
  [/\bs\s*2\b/gi, 'S2'],
  [/\bs\s*3\b/gi, 'S3'],
  // Frenata/freno
  [/\babs\b/gi, 'ABS'],
  // Vetture comuni
  [/\bclio\b/gi, 'Clio'],
  [/\blancia\b/gi, 'Lancia'],
  // Capitalizzazione di base post-correzione: solo prima lettera
];

function _voiceApplyCorrections(text){
  if(!text) return text;
  var out = text;
  VOICE_CORRECTIONS.forEach(function(pair){ out = out.replace(pair[0], pair[1]); });
  // Capitalize first letter
  if(out.length) out = out.charAt(0).toUpperCase() + out.slice(1);
  return out;
}

// Active recognition session — only one at a time
var _voiceCurrent = null;

// Start dictation into a target input/textarea by id.
// mode: 'append' (default) appends to existing text; 'replace' overwrites.
function voiceStart(targetId, btn, mode){
  if(!_voiceSupported()){
    showToast('🎙 Dettatura non supportata in questo browser');
    return;
  }
  if(_voiceCurrent){
    // Another mic active → stop it first
    try { _voiceCurrent.recognition.stop(); } catch(_){}
    _voiceCurrent = null;
  }
  var el = document.getElementById(targetId);
  if(!el) return;
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  var recog = new SR();
  recog.lang = 'it-IT';
  recog.continuous = true;       // keep recording until user stops
  recog.interimResults = true;   // show partial transcripts as user speaks
  recog.maxAlternatives = 1;

  var initialText = (mode === 'replace') ? '' : (el.value || '');
  var separator = (initialText && !initialText.endsWith(' ')) ? ' ' : '';

  // Visual: change button to indicate recording (pulsing red)
  var origBtnHtml = btn ? btn.innerHTML : '';
  var origBtnTitle = btn ? btn.title : '';
  if(btn){
    btn.innerHTML = '⏺ STOP';
    btn.title = 'Tocca per fermare';
    btn.style.background = 'var(--red)';
    btn.style.color = '#fff';
    btn.style.borderColor = 'var(--red)';
    btn.classList.add('voice-recording');
  }

  function restoreBtn(){
    if(!btn) return;
    btn.innerHTML = origBtnHtml;
    btn.title = origBtnTitle;
    btn.style.background = '';
    btn.style.color = '';
    btn.style.borderColor = '';
    btn.classList.remove('voice-recording');
  }

  var lastFinalText = '';
  recog.onresult = function(ev){
    var interim = '';
    var final  = '';
    for(var i = ev.resultIndex; i < ev.results.length; i++){
      var r = ev.results[i];
      if(r.isFinal){
        final += r[0].transcript;
      } else {
        interim += r[0].transcript;
      }
    }
    if(final) lastFinalText += final;
    var combined = lastFinalText + interim;
    var corrected = _voiceApplyCorrections(combined.trim());
    el.value = initialText + separator + corrected;
  };
  recog.onerror = function(ev){
    var msg = 'Errore microfono';
    if(ev.error === 'no-speech') msg = 'Nessuna voce rilevata';
    else if(ev.error === 'not-allowed') msg = 'Permesso microfono negato — abilitalo in Impostazioni Safari';
    else if(ev.error === 'network') msg = 'Connessione richiesta per la dettatura';
    else if(ev.error === 'aborted') return; // user stopped, no toast
    else msg = 'Errore: '+ev.error;
    showToast('🎙 '+msg);
  };
  recog.onend = function(){
    restoreBtn();
    _voiceCurrent = null;
  };
  try {
    recog.start();
    _voiceCurrent = { recognition: recog, targetId: targetId, btn: btn };
    showToast('🎙 In ascolto... parla pure');
  } catch(e){
    restoreBtn();
    showToast('🎙 Avvio fallito: '+e.message);
  }
}
window.voiceStart = voiceStart;

// Click handler on a voice button — if recording, stop; else start
function voiceToggle(targetId, btn, mode){
  if(_voiceCurrent && _voiceCurrent.targetId === targetId){
    try { _voiceCurrent.recognition.stop(); } catch(_){}
    return;
  }
  voiceStart(targetId, btn, mode);
}
window.voiceToggle = voiceToggle;
