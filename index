// MODE SWITCH
// ═══════════════════════════════════════════════════════════════
function setMode(m) {
  STATE.mode = m;
  document.querySelectorAll('.mode-tab').forEach(function(t){
    // v18.1: identifica il tab da data-mode (robusto anche se il testo cambia); fallback al testo
    var tm = t.getAttribute('data-mode');
    if(!tm){
      var label = t.textContent.trim();
      tm = label.includes('PISTA')?'track':label.includes('RALLY')?'rally':label.includes('CUSTOM')?'custom':'';
    }
    t.classList.toggle('active', tm===m);
  });
  // Show/hide nav elements.
  // - track mode: .track-nav visible, .rally-nav hidden
  // - rally mode: .rally-nav visible, .track-nav hidden
  // - custom mode: BOTH initially visible, then applyCustomNavFilter() hides groups
  //   whose menu items are all disabled by user preference.
  document.querySelectorAll('.track-nav').forEach(el=>el.style.display = (m==='track'||m==='custom') ? '' : 'none');
  document.querySelectorAll('.rally-nav').forEach(el=>el.style.display = (m==='rally'||m==='custom') ? '' : 'none');
  document.querySelectorAll('.custom-nav').forEach(el=>el.style.display = m==='custom' ? '' : 'none');
  // If camere page is active, reload its content for new mode
  try {
    var camerePage = document.getElementById('page-camere');
    if(camerePage && camerePage.classList.contains('active') && typeof camerePageLoad === 'function'){
      camerePageLoad();
    }
  } catch(_){}
  // In custom mode, filter the menu items according to user preferences
  if(m==='custom' && typeof applyCustomNavFilter==='function') applyCustomNavFilter();
  else if(typeof resetCustomNavFilter==='function') resetCustomNavFilter(m);
  // Compute a smart, dynamic label for the car type panel based on the actual cars the user has
  var lbl = document.getElementById('track-car-type-label');
  if(lbl){
    try {
      var types = (STATE.trackCars||[]).map(function(c){return (c.type||'').trim();}).filter(Boolean);
      if(!types.length){
        lbl.textContent = 'VETTURE';
      } else {
        var uniq = Array.from(new Set(types.map(function(t){return t.toUpperCase();})));
        if(uniq.length === 1){
          // Map common internal type codes to nicer labels
          var nice = { 'CLIO5':'CLIO CUP', 'CLIO4':'CLIO CUP', 'CLIO':'CLIO CUP',
                       'RADICAL':'RADICAL', 'FORMULA':'FORMULA', 'LAMBO':'LAMBORGHINI',
                       'PORSCHE':'PORSCHE', 'GT3':'GT3', 'GT4':'GT4', 'TCR':'TCR',
                       'ENDURANCE':'ENDURANCE', 'PROTOTYPE':'PROTOTYPE' };
          lbl.textContent = nice[uniq[0]] || uniq[0];
        } else if(uniq.length <= 3){
          lbl.textContent = uniq.join(' / ');
        } else {
          lbl.textContent = 'MIX';
        }
      }
    } catch(e){ lbl.textContent = 'VETTURE'; }
  }
  if(m==='track') { showPage('overview'); buildTrackCarTabs(); }
  else if(m==='rally') { showPage('rally-overview'); }
  else if(m==='custom') { if(typeof goToCustomHome==='function') goToCustomHome(); }
}

