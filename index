// ─── PS Live Display (HTML-based, replaces canvas) ───
function updatePsLiveDisplay() {
  const weather = getPsWeatherCondition();
  const lastStage = (typeof STATE!=='undefined') ? (STATE.stages.filter(s=>!s.cancelled).slice(-1)[0] || STATE.stages[STATE.stages.length-1]) : null;
  const lightsOn = (typeof stageLightsOn!=='undefined'&&stageLightsOn)||weather==='rain'||weather==='heavy_rain'||weather==='fog'||weather==='snow';

  // Weather icons + labels
  const wIcons  = {clear:'☀️', cloudy:'🌥', rain:'🌧', heavy_rain:'⛈', snow:'❄️', fog:'🌫'};
  const wLabels = {clear:'SERENO', cloudy:'NUVOLOSO', rain:'PIOGGIA', heavy_rain:'PIOGGIA FORTE', snow:'NEVE', fog:'NEBBIA'};
  const wColors = {clear:'#d4a820', cloudy:'#7a8898', rain:'#4488cc', heavy_rain:'#2255bb', snow:'#88aace', fog:'#7a8a96'};

  // Weather
  const wIcon = document.getElementById('ps-disp-weather-icon');
  const wLabel = document.getElementById('ps-disp-weather-label');
  const wInd = document.getElementById('ps-weather-indicator');
  if(wIcon)  wIcon.textContent  = wIcons[weather]  || '—';
  if(wLabel) { wLabel.textContent = wLabels[weather] || weather.toUpperCase(); wLabel.style.color = wColors[weather]||'var(--text3)'; }
  if(wInd)   wInd.textContent   = wLabels[weather]  || weather.toUpperCase();

  // Lights
  const lIcon = document.getElementById('ps-disp-lights-icon');
  const lText = document.getElementById('ps-disp-lights-text');
  const lCell = document.getElementById('ps-disp-lights-cell');
  if(lIcon) lIcon.textContent = lightsOn ? '💡' : '🔲';
  if(lText) { lText.textContent = lightsOn ? (typeof stageLightsOn!=='undefined'&&stageLightsOn?'ON':'AUTO') : 'OFF'; lText.style.color = lightsOn?'#d4a820':'var(--text3)'; }
  if(lCell) lCell.style.background = lightsOn?'rgba(212,168,32,0.07)':'';

  if(!lastStage) {
    // No stage data yet
    const lbl = document.getElementById('ps-live-label');
    if(lbl) lbl.textContent = 'IN ATTESA';
    return;
  }

  // PS number
  const numEl = document.getElementById('ps-disp-num');
  if(numEl) numEl.textContent = lastStage.num || '—';

  // Name
  const nameEl = document.getElementById('ps-disp-name');
  if(nameEl) nameEl.textContent = (lastStage.name||'—').toUpperCase();

  // KM
  const kmEl = document.getElementById('ps-disp-km');
  if(kmEl) kmEl.textContent = lastStage.km ? lastStage.km.toFixed(2)+' km' : '—';

  // Surface
  const sfEl = document.getElementById('ps-disp-surface');
  if(sfEl) { sfEl.textContent = (lastStage.surface||'—').toUpperCase(); sfEl.style.color = {asfalto:'var(--blue)',sterrato:'var(--yellow)',neve:'#aaccee',misto:'var(--accent3)'}[(lastStage.surface||'').toLowerCase()]||'var(--text2)'; }

  // Time
  const timeEl = document.getElementById('ps-disp-time');
  if(timeEl) timeEl.textContent = lastStage.time || '—';

  // Delta
  const deltaEl = document.getElementById('ps-disp-delta');
  if(deltaEl && lastStage.delta !== undefined && lastStage.delta !== null && lastStage.delta !== '') {
    const d = parseFloat(lastStage.delta);
    deltaEl.textContent = (!isNaN(d) ? (d>=0?'+':'')+d.toFixed(2)+'s' : lastStage.delta);
    deltaEl.style.color = (!isNaN(d) && d<0) ? 'var(--green)' : (!isNaN(d) && d>0) ? 'var(--red)' : 'var(--text2)';
  } else if(deltaEl) { deltaEl.textContent='—'; deltaEl.style.color='var(--text2)'; }

  // Positions
  const posAbsEl = document.getElementById('ps-disp-pos-abs');
  const posClsEl = document.getElementById('ps-disp-pos-cls');
  if(posAbsEl) { posAbsEl.textContent=lastStage.absPos||lastStage.abs_pos||'—'; posAbsEl.style.color = (lastStage.absPos===1||lastStage.abs_pos===1)?'var(--yellow)':'var(--text1)'; }
  if(posClsEl) { posClsEl.textContent=lastStage.clsPos||lastStage.cls_pos||'—'; posClsEl.style.color = (lastStage.clsPos===1||lastStage.cls_pos===1)?'var(--yellow)':'var(--text1)'; }

  // Progress bar (stages count)
  const stages = typeof STATE!=='undefined' ? STATE.stages.filter(s=>!s.cancelled) : [];
  const progEl = document.getElementById('ps-disp-progress');
  const progLbl = document.getElementById('ps-disp-progress-label');
  const total = Math.max(stages.length, 1);
  const pct = Math.min(100, (stages.length / Math.max(stages.length,1))*100);
  if(progEl) progEl.style.width = '100%';
  if(progLbl) progLbl.textContent = stages.length + ' PS';

  // Fuel
  const rallyStages = typeof STATE!=='undefined' ? STATE.stages : [];
  const totalFuelSS = rallyStages.reduce((a,s)=>a+(parseFloat(s.fuelSS)||0),0);
  const totalFuelTF = rallyStages.reduce((a,s)=>a+(parseFloat(s.fuelTF)||0),0);
  const fssEl = document.getElementById('ps-disp-fuel-ss');
  const ftfEl = document.getElementById('ps-disp-fuel-tf');
  const ftotEl = document.getElementById('ps-disp-fuel-tot');
  if(fssEl) fssEl.textContent = totalFuelSS>0 ? totalFuelSS.toFixed(1)+'L' : '—L';
  if(ftfEl) ftfEl.textContent = totalFuelTF>0 ? totalFuelTF.toFixed(1)+'L' : '—L';
  if(ftotEl) ftotEl.textContent = (totalFuelSS+totalFuelTF)>0 ? (totalFuelSS+totalFuelTF).toFixed(1)+'L' : '—L';

  // Cancelled state
  const liveLabel = document.getElementById('ps-live-label');
  const liveDot   = document.getElementById('ps-live-dot');
  if(lastStage.cancelled){
    if(liveLabel) { liveLabel.textContent='ANNULLATA'; liveLabel.style.color='var(--red)'; }
    if(liveDot)   { liveDot.style.background='var(--red)'; liveDot.style.boxShadow='0 0 8px var(--red)'; }
    if(timeEl)    { timeEl.style.color='var(--red)'; }
  } else {
    if(liveLabel) { liveLabel.textContent='COMPLETATA'; liveLabel.style.color='var(--green)'; }
    if(liveDot)   { liveDot.style.background='var(--green)'; liveDot.style.boxShadow='0 0 8px var(--green)'; liveDot.style.animation='none'; }
    if(timeEl)    { timeEl.style.color='#f0961e'; }
  }
}
