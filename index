        else if(/cremaglier/.test(l)&&nums.length){ set('sa2-rack',nums[0]); }
        else if(/(distribuzion|prima\s*\/\s*post)/.test(l)&&/(bar|fren)/.test(l)&&nums.length>=2){ set('sa2-brk-press-f',nums[0]); set('sa2-brk-press-r',nums[1]); }
