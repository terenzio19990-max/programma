const IDB_NAME = 'RaceEngineerPro';
const IDB_VERSION = 2;  // v2: added 'photos' store
const IDB_PHOTOS_STORE = 'rep_photos';
let _idb = null;


// ═══════════════════════════════════════════════════════════════
// FUNCTIONS RESTORED FROM v15
// ═══════════════════════════════════════════════════════════════


function openIDB() {
  return new Promise((resolve, reject) => {
    if(_idb) { resolve(_idb); return; }
    const req = indexedDB.open(IDB_NAME, IDB_VERSION);
    req.onupgradeneeded = e => {
      const db = e.target.result;
      if(!db.objectStoreNames.contains(IDB_STORE)) db.createObjectStore(IDB_STORE, {keyPath:'name'});
      // v2: photos store — keyPath 'id' (timestamp-based unique)
      if(!db.objectStoreNames.contains(IDB_PHOTOS_STORE)){
        var ps = db.createObjectStore(IDB_PHOTOS_STORE, {keyPath:'id'});
        ps.createIndex('byCategory', 'category', {unique:false});
        ps.createIndex('byCarId',    'carId',    {unique:false});
        ps.createIndex('byTimestamp','timestamp',{unique:false});
      }
    };
    req.onsuccess = e => { _idb = e.target.result; resolve(_idb); };
    req.onerror   = e => reject(e.target.error);
  });
}


async function autoSaveIDB() {
  try {
    const db = await openIDB();
    const snap = serializeSession();
    snap.name = '_idb_autosave_';
    snap.savedAt = new Date().toISOString();
    const tx = db.transaction(IDB_STORE,'readwrite');
    tx.objectStore(IDB_STORE).put(snap);
  } catch(e) {}
}

// ═══════════════════════════════════════════════════════════════
// PHOTOS — IndexedDB-backed image storage with aggressive compression
// Each photo is: { id, category, carId, label, note, timestamp, blob (Blob), thumb (dataURL) }
// Categories: 'tyre' | 'damage' | 'setup' | 'other'
// ═══════════════════════════════════════════════════════════════

// Compress an image File/Blob to JPEG with max dimensions and given quality.
// Returns { blob, thumb, originalKB, compressedKB }
function _photoCompress(fileOrBlob, maxW, maxH, quality){
  maxW = maxW || 1024;
  maxH = maxH || 1024;
  quality = quality || 0.72;
  return new Promise(function(resolve, reject){
    var originalKB = Math.round(fileOrBlob.size/1024);
    var img = new Image();
    var url = URL.createObjectURL(fileOrBlob);
    img.onload = function(){
      URL.revokeObjectURL(url);
      // Calculate scaled dimensions keeping aspect ratio
      var w = img.naturalWidth;
      var h = img.naturalHeight;
      if(w > maxW || h > maxH){
        var ratio = Math.min(maxW/w, maxH/h);
        w = Math.round(w*ratio);
        h = Math.round(h*ratio);
      }
      var canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      var ctx = canvas.getContext('2d');
  if(!ctx) return;
      if(!ctx) return;
    if(!ctx) return;
      // Fill black BG in case source has transparency
      ctx.fillStyle = '#000'; ctx.fillRect(0,0,w,h);
      ctx.drawImage(img, 0, 0, w, h);
      // Compress to JPEG blob
      canvas.toBlob(function(blob){
        if(!blob){ reject(new Error('canvas toBlob failed')); return; }
        // Also create a tiny thumb (250px wide, JPEG 60%) as dataURL for quick display
        var thumbCanvas = document.createElement('canvas');
        var tw = 250;
        var th = Math.round(h * tw/w);
        thumbCanvas.width = tw; thumbCanvas.height = th;
        var tctx = thumbCanvas.getContext('2d');
        if(!tctx) return;
        tctx.fillStyle='#000'; tctx.fillRect(0,0,tw,th);
        tctx.drawImage(img, 0, 0, tw, th);
        var thumb = thumbCanvas.toDataURL('image/jpeg', 0.6);
        resolve({
          blob: blob,
          thumb: thumb,
          originalKB: originalKB,
          compressedKB: Math.round(blob.size/1024)
        });
      }, 'image/jpeg', quality);
    };
    img.onerror = function(){ URL.revokeObjectURL(url); reject(new Error('image load failed')); };
    img.src = url;
  });
}

// Save a compressed photo to IDB
async function photoSave(opts){
  // opts: { category, carId, label, note, file (File or Blob) }
  var cmp = await _photoCompress(opts.file, 1024, 1024, 0.72);
  var record = {
    id: 'ph_'+Date.now()+'_'+Math.floor(Math.random()*10000),
    category: opts.category || 'other',
    carId: opts.carId || '',
    label: opts.label || '',
    note: opts.note || '',
    timestamp: Date.now(),
    blob: cmp.blob,
    thumb: cmp.thumb,
    sizeKB: cmp.compressedKB,
    originalSizeKB: cmp.originalKB
  };
  var db = await openIDB();
  return new Promise(function(resolve, reject){
    var tx = db.transaction(IDB_PHOTOS_STORE, 'readwrite');
    var store = tx.objectStore(IDB_PHOTOS_STORE);
    var req = store.put(record);
    req.onsuccess = function(){ resolve(record); };
    req.onerror = function(){ reject(req.error); };
  });
}
window.photoSave = photoSave;

// List photos filtered by criteria
async function photoList(filter){
  // filter: { category?, carId? } — all optional
  filter = filter || {};
  var db = await openIDB();
  return new Promise(function(resolve, reject){
    var tx = db.transaction(IDB_PHOTOS_STORE, 'readonly');
    var store = tx.objectStore(IDB_PHOTOS_STORE);
    var out = [];
    var req = store.openCursor();
    req.onsuccess = function(){
      var cur = req.result;
      if(!cur){
        // Sort by timestamp DESC (newest first)
        out.sort(function(a,b){return (b.timestamp||0)-(a.timestamp||0);});
        resolve(out);
        return;
      }
      var rec = cur.value;
      var ok = true;
      if(filter.category && rec.category !== filter.category) ok = false;
      if(filter.carId && rec.carId !== filter.carId) ok = false;
      if(ok) out.push(rec);
      cur.continue();
    };
    req.onerror = function(){ reject(req.error); };
  });
}
window.photoList = photoList;

// Delete photo by id
async function photoDelete(id){
  var db = await openIDB();
  return new Promise(function(resolve, reject){
    var tx = db.transaction(IDB_PHOTOS_STORE, 'readwrite');
    tx.objectStore(IDB_PHOTOS_STORE).delete(id);
    tx.oncomplete = function(){ resolve(true); };
    tx.onerror = function(){ reject(tx.error); };
  });
}
window.photoDelete = photoDelete;

// Turn a stored Blob back into a displayable object URL (for full-size preview)
