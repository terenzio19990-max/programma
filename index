      '<div class="cover-subtitle">'+(mode==='PISTA'?'🏁 ':'🌲 ')+circuitName+'</div>'+
      '<div class="cover-meta">'+
        '<div><b>Modalità:</b> '+mode+'</div>'+
        '<div><b>Sessione:</b> '+session+'</div>'+
        '<div><b>Vetture:</b> '+carNames+'</div>'+
        '<div><b>Meteo:</b> '+meteoStr+'</div>'+
        '<div><b>Bandiera:</b> '+flag.toUpperCase()+'</div>'+
        '<div><b>Generato il:</b> '+now+'</div>'+
      '</div>'+
      '<div class="cover-footer">Race Engineer Pro · Report dettagliato ('+(allCars.length)+' vetture)</div>'+
    '</div>';
  }

  html += '<h1>🏁 RACE ENGINEER PRO — REPORT '+mode+' — '+circuitName+'</h1>';
  html += '<div class="meta"><span><b>📅 Data:</b> '+now+'</span>'+
          '<span><b>🏁 Sessione:</b> '+session+'</span>'+
          '<span><b>🛣 Fondo:</b> '+surface+'</span>'+
          '<span><b>🚩 Bandiera:</b> '+flag.toUpperCase()+'</span>'+
          '<span><b>🌦 Meteo:</b> '+meteoStr+'</span>'+
          '<span><b>🚗 Vetture:</b> '+allCars.length+'</span></div>';

  var totalLaps = allCars.reduce(function(a,c){return a+(STATE.laps[c.id]||[]).length;},0);
  var allBests = allCars.map(function(c){return getBestLapMs(c.id);}).filter(Boolean);
  var overallBest = allBests.length?Math.min.apply(null,allBests):null;
  var overallBestCar = overallBest ? allCars.find(function(c){return getBestLapMs(c.id)===overallBest;}) : null;

  // Overall max speed
  var overallVmax = 0, overallVmaxCar = null, overallVmaxLap = null;
  allCars.forEach(function(c){
    (STATE.laps[c.id]||[]).forEach(function(l){
      var v = +l.vmax;
      if(v && v>overallVmax){ overallVmax=v; overallVmaxCar=c; overallVmaxLap=l.lap; }
    });
