  var head = '<div class="small mb8">Inserisci l\'orario di partenza previsto di ogni PS: incrocio la previsione oraria'+
    (hasFc ? ' di <b>'+E(METEO_STATE.label||'località meteo')+'</b>.' : '. <b style="color:var(--yellow);">Apri prima la pagina Meteo e seleziona la località del rally.</b>')+'</div>';
  var rows = '';
  for(var i=0;i<n;i++){
    var ps = STATE.psSchedule[i]||{};
    var fc = ps.time ? REP2._forecastAt(ps.time) : null;
    var sg = REP2._tyreSuggest(fc);
    rows += '<tr><td class="mono">PS'+(i+1)+'</td>'+
      '<td><input type="text" value="'+E(ps.name||'')+'" placeholder="nome prova" style="width:100%;" onchange="REP2.setPS('+i+',\'name\',this.value)"></td>'+
      '<td><input type="time" value="'+E(ps.time||'')+'" onchange="REP2.setPS('+i+',\'time\',this.value)"></td>'+
      '<td class="mono">'+(fc&&fc.temp!=null?fc.temp.toFixed(0)+'°C':'—')+'</td>'+
      '<td class="mono">'+(fc&&fc.pp!=null?fc.pp+'%':'—')+'</td>'+
      '<td class="mono">'+(fc&&fc.pr!=null?(+fc.pr).toFixed(1)+'mm':'—')+'</td>'+
      '<td style="color:'+sg.col+';font-weight:700;">'+sg.txt+'</td></tr>';
  }
  body.innerHTML = head +
    '<table class="data-table" style="width:100%;"><thead><tr><th>PS</th><th>Nome</th><th>Partenza</th><th>Temp</th><th>Pioggia%</th><th>mm/h</th><th>Gomma</th></tr></thead><tbody>'+rows+'</tbody></table>'+
    '<button class="btn btn-blue mt12" onclick="REP2.renderPSMatrix()">AGGIORNA</button>';
};
