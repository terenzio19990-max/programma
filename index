// Save current STATE snapshot to IDB (the 'rep_sessions' store).
// Returns a Promise<boolean> indicating success. Falls back to localStorage if IDB fails.
async function autoSaveToIDB(){
  try {
    const db = await openIDB();
    const snap = serializeSession();
    snap.name = '_autosave_';
    snap.savedAt = new Date().toISOString();
    return new Promise(function(resolve){
      var tx = db.transaction(IDB_STORE, 'readwrite');
      tx.objectStore(IDB_STORE).put(snap);
      tx.oncomplete = function(){ resolve(true); };
      tx.onerror    = function(){ resolve(false); };
    });
  } catch(e){
    console.warn('[Storage] autoSaveToIDB failed, will fall back to localStorage', e);
    return false;
  }
}

// Read autosave from IDB
async function loadAutoSaveFromIDB(){
  try {
    const db = await openIDB();
    return new Promise(function(resolve){
      var tx = db.transaction(IDB_STORE, 'readonly');
      var req = tx.objectStore(IDB_STORE).get('_autosave_');
      req.onsuccess = function(){ resolve(req.result || null); };
      req.onerror   = function(){ resolve(null); };
    });
  } catch(e){
    return null;
  }
}

// Storage usage stats — lets the user see at a glance how full each storage is
async function getStorageUsage(){
  var info = {
    localStorage: { usedBytes: 0, items: 0 },
    indexedDB:    { usedBytes: 0, photos: 0, sessions: 0 },
    quota:        { usage: 0, quota: 0 }
  };
  // localStorage size: sum of all key+value lengths (UTF-16 = 2 bytes/char approx)
  try {
    for(var i = 0; i < localStorage.length; i++){
      var k = localStorage.key(i);
      var v = localStorage.getItem(k) || '';
      info.localStorage.usedBytes += (k.length + v.length) * 2;
      info.localStorage.items++;
    }
  } catch(e){}
  // navigator.storage.estimate() — total quota for the origin
  try {
    if(navigator.storage && navigator.storage.estimate){
      var est = await navigator.storage.estimate();
      info.quota.usage = est.usage || 0;
      info.quota.quota = est.quota || 0;
    }
  } catch(e){}
  // Photos count + size in IDB
  try {
    var photos = await photoList();
    info.indexedDB.photos = photos.length;
    info.indexedDB.usedBytes = photos.reduce(function(s,p){return s+(p.sizeKB||0)*1024;}, 0);
  } catch(e){}
  // Sessions in IDB
  try {
    var db = await openIDB();
    var sessionsCount = await new Promise(function(resolve){
      var tx = db.transaction(IDB_STORE, 'readonly');
      var req = tx.objectStore(IDB_STORE).count();
      req.onsuccess = function(){ resolve(req.result); };
      req.onerror   = function(){ resolve(0); };
    });
    info.indexedDB.sessions = sessionsCount;
  } catch(e){}
  return info;
}
window.getStorageUsage = getStorageUsage;

// Pretty-format bytes for display
function _fmtBytes(bytes){
  if(!bytes) return '0 B';
  var k = 1024;
  if(bytes < k) return bytes + ' B';
  if(bytes < k*k) return (bytes/k).toFixed(1) + ' KB';
  if(bytes < k*k*k) return (bytes/(k*k)).toFixed(2) + ' MB';
  return (bytes/(k*k*k)).toFixed(2) + ' GB';
}
window._fmtBytes = _fmtBytes;

// Render a small storage indicator block (e.g. inside Settings or Help modal)
async function renderStorageInfo(containerId){
  var el = document.getElementById(containerId);
  if(!el){ return; }
  el.innerHTML = '<div style="font-size:11px;color:var(--text3);">Calcolo storage...</div>';
  var u = await getStorageUsage();
  var ls = u.localStorage.usedBytes;
  var lsLimit = 5 * 1024 * 1024;  // ~5MB typical limit
  var lsPct = Math.min(100, Math.round(ls / lsLimit * 100));
  var lsColor = lsPct > 80 ? 'var(--red)' : lsPct > 60 ? 'var(--yellow)' : 'var(--green)';
  var idbBytes = u.indexedDB.usedBytes;
  var quotaUsage = u.quota.usage || 0;
  var quotaTotal = u.quota.quota || 0;
  var quotaPct = quotaTotal ? Math.round(quotaUsage/quotaTotal*100) : 0;
  el.innerHTML =
    '<div style="background:var(--bg3);border-radius:5px;padding:10px 12px;font-size:11px;line-height:1.6;">'+
      '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">'+
        '<b style="color:var(--text1);">📦 STORAGE USATO</b>'+
        '<button class="btn btn-gray" style="padding:3px 8px;font-size:10px;" onclick="renderStorageInfo(\''+containerId+'\')">🔄</button>'+
      '</div>'+
      '<div style="display:grid;grid-template-columns:1fr 80px;gap:6px;align-items:center;">'+
        '<div>localStorage <span style="color:var(--text3);">('+u.localStorage.items+' chiavi)</span></div>'+
        '<div style="text-align:right;font-family:var(--mono);color:'+lsColor+';font-weight:700;">'+_fmtBytes(ls)+' / 5 MB</div>'+
        '<div style="grid-column:1/3;background:var(--bg0);border-radius:3px;height:6px;overflow:hidden;"><div style="background:'+lsColor+';height:100%;width:'+lsPct+'%;"></div></div>'+
        '<div>IndexedDB foto <span style="color:var(--text3);">('+u.indexedDB.photos+' foto)</span></div>'+
        '<div style="text-align:right;font-family:var(--mono);color:var(--accent3);">'+_fmtBytes(idbBytes)+'</div>'+
        '<div>IndexedDB sessioni <span style="color:var(--text3);">('+u.indexedDB.sessions+' salvate)</span></div>'+
        '<div style="text-align:right;font-family:var(--mono);color:var(--accent3);">—</div>'+
        (quotaTotal ? '<div style="grid-column:1/3;margin-top:4px;color:var(--text3);font-size:10px;">'+
          'Quota browser: '+_fmtBytes(quotaUsage)+' / '+_fmtBytes(quotaTotal)+' ('+quotaPct+'%)'+
        '</div>' : '')+
      '</div>'+
      (lsPct > 80 ? '<div style="color:var(--red);font-size:10px;margin-top:6px;">⚠️ localStorage quasi pieno. Considera un backup + reset selettivo.</div>' : '')+
    '</div>';
}
window.renderStorageInfo = renderStorageInfo;

