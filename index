// RALLY STANDINGS
// ═══════════════════════════════════════════════════════════════
function buildRallyStandings() {
  // Aggregate times per car
  const carTimes = {};
  STATE.rallyCars.forEach(car=>{
    const stages = STATE.stages.filter(s=>s.car===car.name&&!s.cancelled);
    const totalMs = stages.reduce((a,s)=>{ const ms=parseTime(s.time); return a+(ms||0); },0);
    const kmSS    = stages.reduce((a,s)=>a+(+s.km||0),0);
    carTimes[car.id] = { car, stages:stages.length, totalMs, kmSS, retired:car.retired };
  });

  // Sort by totalMs (non-retired first, retired last)
  const sorted = Object.values(carTimes)
    .filter(e=>e.totalMs>0||e.stages>0)
    .sort((a,b)=>{
      if(a.retired&&!b.retired) return 1;
      if(!a.retired&&b.retired) return -1;
      return a.totalMs - b.totalMs;
    });

  // Summary tiles
  const tilesEl = document.getElementById('standings-summary-tiles');
  if(tilesEl) {
    const leader = sorted[0];
    tilesEl.innerHTML =
      '<div class="tile tile-accent"><div class="tile-label">PS TOTALI</div><div class="tile-value">'+STATE.stages.filter(s=>!s.cancelled).length+'</div></div>' +
      '<div class="tile"><div class="tile-label">KM SS TOTALI</div><div class="tile-value">'+STATE.stages.filter(s=>!s.cancelled).reduce((a,s)=>a+(+s.km||0),0).toFixed(1)+'km</div></div>' +
      '<div class="tile tile-good"><div class="tile-label">IN GARA</div><div class="tile-value">'+STATE.rallyCars.filter(c=>!c.retired).length+'/'+STATE.rallyCars.length+'</div></div>' +
      '<div class="tile"><div class="tile-label">LEADER</div><div class="tile-value" style="font-size:13px;">'+(leader?leader.car.name:'—')+'</div></div>';
  }

  // Main standings table
  const tbody = document.getElementById('standings-tbody');
  if(tbody) tbody.innerHTML = sorted.length ? sorted.map((e,i)=>{
    const gap = i===0?'—':sorted[0].totalMs?'+'+msToTime(e.totalMs-sorted[0].totalMs):'—';
    const timeStr = e.totalMs?msToTime(e.totalMs):'—';
    return '<tr class="'+(i===0?'best':'')+(e.retired?' target':'')+'">' +
      '<td class="mono" style="font-size:18px;color:'+(i===0?'var(--yellow)':i===1?'#aaa':i===2?'#cd7f32':'var(--text2)')+';font-weight:700;">'+(i+1)+'</td>' +
      '<td style="font-weight:700;color:'+(e.car.color||'var(--text1)')+';">'+e.car.name+'</td>' +
      '<td class="mono" style="color:var(--accent3);">'+timeStr+'</td>' +
      '<td class="mono" style="color:var(--text3);">'+gap+'</td>' +
      '<td class="mono">'+e.stages+'</td>' +
      '<td class="mono">'+e.kmSS.toFixed(1)+'km</td>' +
      '<td><span class="badge '+(e.retired?'badge-red':'badge-green')+'">'+(e.retired?'RITIRATA':'IN GARA')+'</span></td>' +
    '</tr>';
  }).join('') : '<tr><td colspan="7" style="text-align:center;color:var(--text3);padding:14px;">Nessun tempo PS inserito</td></tr>';

  // PS by PS detail
  const detail = document.getElementById('standings-detail');
  if(detail) {
    const psNums = [...new Set(STATE.stages.filter(s=>!s.cancelled).map(s=>s.num))].sort((a,b)=>a-b);
    if(!psNums.length) { detail.innerHTML='<div style="color:var(--text3);font-size:12px;padding:10px;">Nessun dato PS</div>'; return; }
    let html = '<table class="data-table"><thead><tr><th>PS</th><th>NOME</th><th>KM</th>';
    STATE.rallyCars.forEach(car=>{ html+='<th>'+car.name+'</th>'; });
    html+='</tr></thead><tbody>';
    psNums.forEach(num=>{
      const stageInfo = STATE.stages.find(s=>s.num===num&&!s.cancelled);
      html+='<tr><td class="mono">PS'+num+'</td><td>'+(stageInfo?.name||'—')+'</td><td class="mono">'+(stageInfo?stageInfo.km.toFixed(1):'—')+'km</td>';
      STATE.rallyCars.forEach(car=>{
        const stage = STATE.stages.find(s=>s.num===num&&s.car===car.name&&!s.cancelled);
        const allTimes = STATE.rallyCars.map(c=>{ const s=STATE.stages.find(x=>x.num===num&&x.car===c.name&&!x.cancelled); return s?parseTime(s.time):Infinity; }).filter(t=>t!==Infinity);
        const best = allTimes.length?Math.min(...allTimes):null;
        const ms = stage?parseTime(stage.time):null;
        const isBest = ms&&best&&ms===best;
        const diff = ms&&best&&!isBest?'+'+(((ms-best)/1000).toFixed(3))+'s':'';
        html+='<td class="mono" style="color:'+(isBest?'var(--green)':ms?'var(--text1)':'var(--text3)')+'">'+(stage?stage.time+'<br><span style="font-size:10px;color:var(--text3);">'+diff+'</span>':'—')+'</td>';
      });
      html+='</tr>';
    });
    html+='</tbody></table>';
    detail.innerHTML = html;
  }
}

