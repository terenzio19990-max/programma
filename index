var SA_CALKEY='REP_sa_calib_v1';
function saCalKey(mode, type){ return mode+'_'+type; }
function saCalGet(key){
  try { var o=JSON.parse(localStorage.getItem(SA_CALKEY)||'{}'); return o[key]||{factor:1,n:0,hist:[],pending:[]}; }
  catch(e){ return {factor:1,n:0,hist:[],pending:[]}; }
}
function saCalSave(key,c){ try { var o=JSON.parse(localStorage.getItem(SA_CALKEY)||'{}'); o[key]=c; localStorage.setItem(SA_CALKEY,JSON.stringify(o)); } catch(e){} }
window.saFitAero = function(mode){
  var car=saCar(mode); if(!car) return;
  var p=saGetParams(car.type);
  var el=document.getElementById('sa-vmaxfit-'+mode);
  var v=el? parseFloat(el.value)/3.6 : NaN;
  if(!isFinite(v)||v<20){ if(typeof showToast==='function') showToast('Inserisci una Vmax valida'); return; }
  var rho=(window.SA_RHO||1.225);
  var CdAfit=(p.powerKW*1000*p.driveEff - p.crr*p.m*9.81*v)*2/(rho*v*v*v);
  var cur=saReadFields(mode);
  var extra=saAeroLoads(cur, p, 40).CdA - p.cdA0;
  var cdA0=Math.max(0.4, Math.min(1.3, CdAfit-extra));
  saSaveParam(car.type,'cdA0',+cdA0.toFixed(3));
  if(typeof showToast==='function') showToast('🎯 CdA base tarato a '+cdA0.toFixed(3)+' m² dalla Vmax reale');
  saRender(mode);
};
window.saFitGrip = function(mode){
  var car=saCar(mode); if(!car) return;
  var el=document.getElementById('sa-gfit-'+mode);
  var target=el? parseFloat(el.value) : NaN;
  if(!isFinite(target)||target<0.2||target>3){ if(typeof showToast==='function') showToast('Inserisci una g valida (es. 1.45)'); return; }
  var ctx=saCtx(mode);
  var A=saAnalyze(ctx.cur, ctx.p, ctx.surf);
  var cur=A.bMid.ay/9.81;
  if(!(cur>0.1)) return;
  var p=saGetParams(car.type);
  var mg=Math.max(0.6, Math.min(1.8, (p.muGrip||1)*(target/cur)));
  saSaveParam(car.type,'muGrip',+mg.toFixed(3));
  if(typeof showToast==='function') showToast('🛞 Aderenza gomma tarata: ×'+mg.toFixed(2)+' (ay media ora ≈ '+target.toFixed(2)+'g)');
  saRender(mode);
};
window.saCalReset = function(mode){
  var car=saCar(mode); if(!car) return;
  saCalSave(saCalKey(mode,car.type), {factor:1,n:0,hist:[],pending:[]});
  var el=document.getElementById('sa-box-calib-'+mode); if(el) el.innerHTML=saCalibHTML(mode);
  saRender(mode);
  if(typeof showToast==='function') showToast('Calibrazione azzerata');
};
function saLapCount(mode, car){
  if(mode==='rally') return (STATE.stages||[]).filter(function(st){return st.car===car.name&&!st.cancelled;}).length;
  return (STATE.laps[car.id]||[]).length;
}
function saBestAfter(mode, car, fromIdx){
  var best=null;
  function upd(t){ if(t&&(best===null||t<best)) best=t; }
  if(mode==='rally'){
    (STATE.stages||[]).filter(function(st){return st.car===car.name&&!st.cancelled;})
      .slice(fromIdx).forEach(function(st){ upd(parseTime(st.time)); });
  } else {
    (STATE.laps[car.id]||[]).slice(fromIdx).forEach(function(l){ upd(parseTime(l.time)); });
  }
  return best;
}
function saCalSnapshot(mode){
  var car=saCar(mode); if(!car) return;
  var hist=saHistory(mode,car.id);
  if(hist.length<2) return;
  var ctx=saCtx(mode);
  if(!ctx.refMs) return;
  var prev=saEntryToSetup(hist[hist.length-2], ctx.cur);
  var A=saAnalyze(ctx.cur,ctx.p,ctx.surf), B=saAnalyze(prev,ctx.p,ctx.surf);
  var Cc=saCompare(A,B,ctx.p,ctx.surf,ctx.prof);
  if(Math.abs(Cc.total)<0.03) return;
  var key=saCalKey(mode,car.type), cal=saCalGet(key);
  cal.pending.push({ ts:Date.now(), predicted:Cc.total, bestBefore:ctx.refMs, lapIdx:saLapCount(mode,car) });
  if(cal.pending.length>6) cal.pending.shift();
  saCalSave(key,cal);
}
function saCalResolve(mode, car){
  var key=saCalKey(mode,car.type), cal=saCalGet(key), changed=false;
  var minNew = mode==='rally'? 1 : 2;
  cal.pending = cal.pending.filter(function(pd){
    var count=saLapCount(mode,car);
    if(count - pd.lapIdx < minNew) return true;
    var after=saBestAfter(mode,car,pd.lapIdx);
    if(!after) return true;
    var actual=(after-pd.bestBefore)/1000;
    var r=actual/pd.predicted;
    if(!isFinite(r)) return false;
    r=Math.max(0.2, Math.min(2.5, r));
    cal.factor = Math.max(0.3, Math.min(2.0, cal.factor*0.65 + 0.35*r));
    cal.n++;
    cal.hist.push({ts:pd.ts, predicted:pd.predicted, actual:actual});
    if(cal.hist.length>12) cal.hist.shift();
    changed=true;
    return false;
  });
  if(changed) saCalSave(key,cal);
  return cal;
}
