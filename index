// ─── Get current weather condition from meteo page ───
function getPsWeatherCondition() {
  const condEl = document.getElementById('meteo-cond');
  const cond = condEl ? condEl.textContent.toLowerCase() : '';
  const stageEl = document.getElementById('stage-surface');
  const surface = stageEl ? stageEl.value.toLowerCase() : '';
  if(cond.includes('neve') || surface.includes('neve')) return 'snow';
  if(cond.includes('pioggia forte') || cond.includes('rovescio') || cond.includes('temporale')) return 'heavy_rain';
  if(cond.includes('pioggia') || cond.includes('pioviggine') || cond.includes('bagnato')) return 'rain';
  if(cond.includes('foschia') || cond.includes('nebbia')) return 'fog';
  if(cond.includes('nuvoloso') || cond.includes('parziale')) return 'cloudy';
  return 'clear';
}

// Rain drop pool for animation
let _rainDrops = Array.from({length:80},()=>({x:Math.random(),y:Math.random(),speed:0.4+Math.random()*0.6,len:6+Math.random()*10}));
let _snowFlakes = Array.from({length:60},()=>({x:Math.random(),y:Math.random(),r:1+Math.random()*2.5,drift:0.1+Math.random()*0.2}));

function drawPsTrack(canvas, t) {
  const W = canvas.width, H = canvas.height;
  const ctx = canvas.getContext('2d');
  if(!ctx) return;
  const weather = getPsWeatherCondition();

  const lightsOn = (typeof stageLightsOn!=='undefined'&&stageLightsOn)||weather==='rain'||weather==='heavy_rain'||weather==='fog'||weather==='snow';
  const lastStage = (typeof STATE!=='undefined') ? (STATE.stages.filter(s=>!s.cancelled).slice(-1)[0]||STATE.stages[STATE.stages.length-1]) : null;

  // ── Perspective config — camera low behind car ──
  const HORIZON = H * 0.42;
  const curveOff = Math.sin(t * 0.22) * W * 0.055; // subtle road curve
  const VPX = W * 0.5 + curveOff;

  // ─── SKY GRADIENT ───
  let skyTop, skyBot, skyMid;
  if(weather==='snow')        { skyTop='#566878'; skyMid='#8aaabb'; skyBot='#b8d0dd'; }
  else if(weather==='heavy_rain') { skyTop='#05070f'; skyMid='#0c1020'; skyBot='#131828'; }
  else if(weather==='rain')   { skyTop='#070a14'; skyMid='#0d1222'; skyBot='#141a2e'; }
  else if(weather==='fog')    { skyTop='#181c24'; skyMid='#252c36'; skyBot='#303844'; }
  else if(weather==='cloudy') { skyTop='#040608'; skyMid='#080c14'; skyBot='#0c1020'; }
  else                        { skyTop='#010206'; skyMid='#03060e'; skyBot='#050a14'; }
  const skyGrad = ctx.createLinearGradient(0,0,0,HORIZON+10);
  skyGrad.addColorStop(0, skyTop);
  skyGrad.addColorStop(0.55, skyMid);
  skyGrad.addColorStop(1, skyBot);
  ctx.fillStyle = skyGrad;
  ctx.fillRect(0,0,W,H);

  // ─── STARS (clear/cloudy night) ───
  if(weather==='clear'||weather==='cloudy'){
    for(let i=0;i<80;i++){
      const sx=(i*271+13)%W, sy=(i*137+7)%(HORIZON*0.88);
      const twinkle=0.3+0.7*Math.abs(Math.sin(t*0.8+i*0.4));
      const alpha=weather==='cloudy'?twinkle*0.25:twinkle*0.85;
      ctx.fillStyle=`rgba(255,255,255,${alpha})`;
      ctx.beginPath(); ctx.arc(sx,sy,i%7===0?1.2:0.7,0,Math.PI*2); ctx.fill();
    }
    // Moon (clear)
    if(weather==='clear'){
      const mx=W*0.82, my=H*0.08;
      const moonGrad=ctx.createRadialGradient(mx-2,my-2,1,mx,my,14);
      moonGrad.addColorStop(0,'rgba(255,248,220,0.95)');
      moonGrad.addColorStop(0.7,'rgba(240,230,180,0.7)');
      moonGrad.addColorStop(1,'rgba(220,210,160,0)');
      ctx.fillStyle=moonGrad; ctx.beginPath(); ctx.arc(mx,my,14,0,Math.PI*2); ctx.fill();
      // Moon glow
      const moonHalo=ctx.createRadialGradient(mx,my,10,mx,my,40);
      moonHalo.addColorStop(0,'rgba(255,248,200,0.08)'); moonHalo.addColorStop(1,'rgba(255,248,200,0)');
      ctx.fillStyle=moonHalo; ctx.beginPath(); ctx.arc(mx,my,40,0,Math.PI*2); ctx.fill();
    }
  }

  // ─── CLOUDS (rain/heavy_rain/cloudy) ───
  if(weather==='cloudy'||weather==='rain'||weather==='heavy_rain'){
    const cloudAlpha=weather==='heavy_rain'?0.75:weather==='rain'?0.6:0.45;
    const cloudColor=weather==='heavy_rain'?`rgba(18,22,32,${cloudAlpha})`:`rgba(28,34,46,${cloudAlpha})`;
    for(let c=0;c<5;c++){
      const cx=((c*W*0.22+t*12*(c%2?1:-1))%(W*1.3))-W*0.15;
      const cy=HORIZON*(0.18+c*0.12);
      const cw=W*(0.18+c*0.04), ch=H*0.06;
      ctx.fillStyle=cloudColor;
      ctx.beginPath(); ctx.ellipse(cx,cy,cw,ch,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(cx-cw*0.28,cy+ch*0.2,cw*0.55,ch*0.7,0,0,Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.ellipse(cx+cw*0.22,cy+ch*0.15,cw*0.45,ch*0.6,0,0,Math.PI*2); ctx.fill();
    }
  }

  // ─── FOG ATMOSPHERE ───
  if(weather==='fog'){
    for(let i=0;i<6;i++){
      const fy=HORIZON*(0.1+i*0.15)+Math.sin(t*0.25+i*1.3)*H*0.025;
      const fg=ctx.createLinearGradient(0,fy,0,fy+H*0.14);
      fg.addColorStop(0,'rgba(160,175,185,0)');
      fg.addColorStop(0.5,`rgba(160,175,185,${0.05+i*0.012})`);
      fg.addColorStop(1,'rgba(160,175,185,0)');
      ctx.fillStyle=fg; ctx.fillRect(0,fy,W,H*0.14);
    }
  }

  // ─── MOUNTAIN RANGES (3 layers, parallax) ───
  const mLayers=[
    { pts:[0,.06,.14,.22,.32,.40,.50,.60,.70,.80,.88,.96,1], hh:[0,.20,.38,.12,.44,.28,.50,.20,.42,.18,.36,.14,0], scale:0.60, alpha:weather==='snow'?0.85:0.9, col:weather==='snow'?'#6a8499':weather==='fog'?'rgba(55,65,78,0.6)':'#111824' },
    { pts:[0,.08,.18,.30,.44,.56,.68,.80,.90,1],              hh:[0,.28,.48,.16,.55,.32,.50,.22,.38,0],             scale:0.72, alpha:weather==='snow'?0.7:0.95,  col:weather==='snow'?'#4e6a80':weather==='fog'?'rgba(42,52,64,0.7)':'#0c1420' },
    { pts:[0,.12,.25,.40,.55,.70,.84,1],                      hh:[0,.18,.36,.10,.42,.25,.32,0],                     scale:0.85, alpha:1,                          col:weather==='snow'?'#3a5268':weather==='fog'?'rgba(32,40,50,0.8)':'#080f1a' }
  ];
  mLayers.forEach((ml,mi)=>{
    const parallax = (ml.scale-0.5)*0.02*Math.sin(t*0.18+mi);
    ctx.fillStyle=ml.col; ctx.globalAlpha=ml.alpha;
    ctx.beginPath();
    ml.pts.forEach((x,i)=>{
      const px=(x+parallax)*W, py=HORIZON - ml.hh[i]*(H*0.58)*ml.scale;
      i===0?ctx.moveTo(px,py):ctx.lineTo(px,py);
    });
    ctx.lineTo(W,HORIZON); ctx.lineTo(0,HORIZON); ctx.closePath(); ctx.fill();
    // Snow caps
    if(weather==='snow'&&mi<2){
      ctx.fillStyle='rgba(220,238,250,0.45)';
      ctx.beginPath();
      ml.pts.forEach((x,i)=>{
        const px=(x+parallax)*W, py=HORIZON - ml.hh[i]*(H*0.58)*ml.scale + (ml.hh[i]>0.1?H*0.03:0);
        i===0?ctx.moveTo(px,py):ctx.lineTo(px,py);
      });
      ctx.lineTo(W,HORIZON); ctx.lineTo(0,HORIZON); ctx.closePath(); ctx.fill();
    }
    ctx.globalAlpha=1;
  });

  // ─── HORIZON GLOW (headlights ambient at night) ───
  if(weather==='clear'||weather==='cloudy'){
    const hgGrad=ctx.createRadialGradient(VPX,HORIZON,0,VPX,HORIZON,W*0.38);
    hgGrad.addColorStop(0,'rgba(255,200,80,0.07)');
    hgGrad.addColorStop(0.4,'rgba(255,160,40,0.03)');
    hgGrad.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=hgGrad; ctx.fillRect(0,HORIZON-H*0.08,W,H*0.18);
  }

  // ─── ROAD SURFACE ───
  // Shoulders first (gravel/grass)
  const shoulderPts = {
    L: [{x:0,y:H},{x:VPX-W*0.06,y:HORIZON},{x:0,y:HORIZON}],
    R: [{x:W,y:H},{x:VPX+W*0.06,y:HORIZON},{x:W,y:HORIZON}]
  };
  let sCol;
  if(weather==='snow') sCol='#7a8e9e';
  else if(weather==='rain'||weather==='heavy_rain') sCol='#1e2838';
  else sCol='#181c24';
  ctx.fillStyle=sCol;
  ['L','R'].forEach(side=>{
    const pts=shoulderPts[side];
    ctx.beginPath(); pts.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y)); ctx.closePath(); ctx.fill();
  });
  // Gravel texture dots on shoulders
  if(weather!=='snow'){
    ctx.fillStyle='rgba(100,95,80,0.18)';
    for(let d=0;d<30;d++){
      const dp=0.1+((d*0.087+t*0.3)%0.88);
      const roadW_p=(VPX-W*0.06)*(1-dp)+0*(dp);
      const sy2=HORIZON+(H-HORIZON)*dp;
      const sz=dp*5;
      const side=d%2===0?-1:1;
      const roadEdgeX=VPX+side*(W*0.06+(W*0.5-W*0.06)*(1-dp)*0.3);
      ctx.beginPath(); ctx.arc(roadEdgeX+side*sz*(d%3),sy2,sz*0.4,0,Math.PI*2); ctx.fill();
    }
  }

  // Road trapezoid
  const roadBotL=VPX-W*0.30, roadBotR=VPX+W*0.30;
  const roadTopL=VPX-W*0.055, roadTopR=VPX+W*0.055;
  let roadGrad;
  if(weather==='snow'){
    roadGrad=ctx.createLinearGradient(0,HORIZON,0,H);
    roadGrad.addColorStop(0,'#a0b4c4'); roadGrad.addColorStop(0.5,'#c0d0dc'); roadGrad.addColorStop(1,'#ccdae4');
  } else if(weather==='rain'||weather==='heavy_rain'){
    roadGrad=ctx.createLinearGradient(0,HORIZON,0,H);
    roadGrad.addColorStop(0,'#151e30'); roadGrad.addColorStop(1,'#1e2a3e');
  } else {
    roadGrad=ctx.createLinearGradient(0,HORIZON,0,H);
    roadGrad.addColorStop(0,'#141820'); roadGrad.addColorStop(0.6,'#1c2028'); roadGrad.addColorStop(1,'#20242c');
  }
  ctx.fillStyle=roadGrad;
  ctx.beginPath(); ctx.moveTo(roadBotL,H); ctx.lineTo(roadTopL,HORIZON); ctx.lineTo(roadTopR,HORIZON); ctx.lineTo(roadBotR,H); ctx.closePath(); ctx.fill();

  // Wet reflection on road
  if(weather==='rain'||weather==='heavy_rain'){
    // Headlight reflection streak down center
    const reflGrad=ctx.createLinearGradient(VPX,HORIZON,VPX,H);
    reflGrad.addColorStop(0,'rgba(255,230,120,0.16)');
    reflGrad.addColorStop(0.4,'rgba(255,200,80,0.08)');
    reflGrad.addColorStop(1,'rgba(255,200,80,0)');
    ctx.fillStyle=reflGrad;
    ctx.beginPath(); ctx.moveTo(roadBotL,H); ctx.lineTo(roadTopL,HORIZON); ctx.lineTo(roadTopR,HORIZON); ctx.lineTo(roadBotR,H); ctx.closePath(); ctx.fill();
    // Blue-tint water sheen
    const wetSheen=ctx.createLinearGradient(0,HORIZON,0,H);
    wetSheen.addColorStop(0,'rgba(30,60,130,0.12)'); wetSheen.addColorStop(1,'rgba(30,60,130,0.06)');
    ctx.fillStyle=wetSheen;
    ctx.beginPath(); ctx.moveTo(roadBotL,H); ctx.lineTo(roadTopL,HORIZON); ctx.lineTo(roadTopR,HORIZON); ctx.lineTo(roadBotR,H); ctx.closePath(); ctx.fill();
  }

  // Road edge lines
  const eAlpha=weather==='snow'?0.35:weather==='rain'?0.5:0.65;
  ctx.strokeStyle=`rgba(240,240,220,${eAlpha})`; ctx.lineWidth=2.5;
  ctx.beginPath(); ctx.moveTo(roadBotL,H); ctx.lineTo(roadTopL,HORIZON); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(roadBotR,H); ctx.lineTo(roadTopR,HORIZON); ctx.stroke();

  // Dashed centre line (perspective-correct)
  const nDash=10;
  for(let d=0;d<nDash;d++){
    const p0=((d/nDash)+((t*0.35)%(1/nDash))*nDash)%1;
    const p1=p0+0.032;
    if(p1>1) continue;
    const y0=HORIZON+(H-HORIZON)*p0, y1=HORIZON+(H-HORIZON)*p1;
    const x0=roadTopL+(roadBotL-roadTopL)*p0, x1=roadTopL+(roadBotL-roadTopL)*p1;
    const wid=x0+(roadTopR+roadBotR*(p0)-roadTopL-(roadBotL*(p0)))*0.5 - x0;
    const cx0=VPX+(x0-roadTopL-(roadBotL-roadTopL)*p0)*0; // center
    const da=weather==='snow'?0.12:0.28;
    const lw=Math.max(1, p0*3.5);
    ctx.strokeStyle=`rgba(230,225,180,${da})`; ctx.lineWidth=lw;
    ctx.beginPath(); ctx.moveTo(VPX,y0); ctx.lineTo(VPX,y1); ctx.stroke();
  }

  // Road surface texture lines (parallax)
  ctx.strokeStyle='rgba(255,255,255,0.04)'; ctx.lineWidth=1;
  for(let r=0;r<6;r++){
    const rp=((r/6+t*0.25)%1);
    const ry=HORIZON+(H-HORIZON)*rp;
    const rx0=roadTopL+(roadBotL-roadTopL)*rp, rx1=roadTopR+(roadBotR-roadTopR)*rp;
    ctx.beginPath(); ctx.moveTo(rx0,ry); ctx.lineTo(rx1,ry); ctx.stroke();
  }

  // ─── TREES (perspective, both sides) ───
  const nTrees=9;
  for(let i=0;i<nTrees;i++){
    const baseP=((i/nTrees + t*0.10*(1+i%3*0.15)) % 1);
    const p=baseP;
    const scale=0.10+p*0.90;
    const baseY=HORIZON+(H-HORIZON)*p;
    const roadWhere_L=roadTopL+(roadBotL-roadTopL)*p;
    const roadWhere_R=roadTopR+(roadBotR-roadTopR)*p;
    const gap=scale*22;
    const treeH=scale*H*0.65;
    const trunkW=Math.max(1.5,scale*5);

    [[roadWhere_L-gap, -1],[roadWhere_R+gap, 1]].forEach(([tx,side])=>{
      if(tx<-30||tx>W+30) return;
      const alpha=Math.min(1, scale*1.3);
      ctx.globalAlpha=alpha;
      // Distance fog
      if(weather==='fog'){ ctx.globalAlpha=Math.min(alpha, scale*0.8); }

      // Trunk
      const trunkCol=weather==='snow'?'#5a6a7a':'#221810';
      ctx.fillStyle=trunkCol;
      ctx.fillRect(tx-trunkW/2, baseY-treeH*0.3, trunkW, treeH*0.3);

      // Conifer layers (3 tiers)
      for(let l=0;l<4;l++){
        const ly=baseY-treeH*(0.18+l*0.22);
        const lw=scale*(32-l*6);
        const lh=scale*(20+l*3);
        let fc;
        if(weather==='snow')      fc=`hsl(210,${12+l*3}%,${30+l*5}%)`;
        else if(weather==='fog')  fc=`hsl(140,${10+l*2}%,${14+l*3}%)`;
        else                       fc=`hsl(130,${28+l*5}%,${8+l*3}%)`;
        ctx.fillStyle=fc;
        ctx.beginPath(); ctx.moveTo(tx,ly-lh); ctx.lineTo(tx+lw,ly); ctx.lineTo(tx-lw,ly); ctx.closePath(); ctx.fill();
        if(weather==='snow'){
          ctx.fillStyle=`rgba(210,228,242,${0.28+l*0.07})`;
          ctx.beginPath(); ctx.moveTo(tx,ly-lh*0.65); ctx.lineTo(tx+lw*0.55,ly); ctx.lineTo(tx-lw*0.55,ly); ctx.closePath(); ctx.fill();
        }
      }
      ctx.globalAlpha=1;
    });
  }

  // ─── RAIN ───
  if(weather==='rain'||weather==='heavy_rain'){
    const count=weather==='heavy_rain'?_rainDrops.length:50;
    for(let i=0;i<count;i++){
      const d=_rainDrops[i];
      d.y+=d.speed*0.013; d.x-=d.speed*0.0025;
      if(d.y>1){d.y=0;d.x=Math.random();}
      if(d.x<0) d.x=1;
      const px=d.x*W, py=d.y*H;
      const a=weather==='heavy_rain'?0.50:0.32;
      const lw2=0.7+d.speed*0.25;
      ctx.strokeStyle=`rgba(150,185,235,${a})`; ctx.lineWidth=lw2;
      ctx.beginPath(); ctx.moveTo(px,py); ctx.lineTo(px+d.len*0.2,py+d.len*1.2); ctx.stroke();
    }
    // Road puddle ripples
    for(let i=0;i<6;i++){
      const rp=0.25+i*0.12;
      const rx2=roadTopL+(roadBotL-roadTopL)*rp + ((i*W*0.08+t*55)%(roadBotR-roadBotL)*0.6);
      const ry2=HORIZON+(H-HORIZON)*rp;
      const rr2=((t*45+i*18)%11)+1;
      const rscale=rp;
      ctx.beginPath(); ctx.ellipse(rx2,ry2,rr2*2.5*rscale,rr2*0.5*rscale,0,0,Math.PI*2);
      ctx.strokeStyle=`rgba(60,120,210,${0.2+rscale*0.1})`; ctx.lineWidth=0.8; ctx.stroke();
    }
  }

  // ─── SNOW ───
  if(weather==='snow'){
    _snowFlakes.forEach(sf=>{
      sf.y+=0.005; sf.x+=Math.sin(t*1.2+sf.y*6)*sf.drift*0.005;
      if(sf.y>1){sf.y=0;sf.x=Math.random();}
      const a=0.4+sf.r*0.14;
      ctx.fillStyle=`rgba(240,248,255,${a})`;
      ctx.beginPath(); ctx.arc(sf.x*W,sf.y*H,sf.r,0,Math.PI*2); ctx.fill();
    });
  }

  // ─── DUST / GRAVEL SPRAY (behind car) ───
  if(weather!=='rain'&&weather!=='heavy_rain'){
    for(let i=0;i<8;i++){
      const sp=((t*0.65+i*0.13)%1);
      const dx=W*0.5 - sp*W*0.14 - W*0.06;
      const dy=H*0.88+Math.sin(i*2.3)*H*0.02;
      const dr=sp*10+1;
      const dc=weather==='snow'?`rgba(200,220,240,${(1-sp)*0.35})`:`rgba(140,130,110,${(1-sp)*0.22})`;
      ctx.fillStyle=dc;
      ctx.beginPath(); ctx.ellipse(dx,dy,dr*2.5,dr*0.6,0,0,Math.PI*2); ctx.fill();
    }
  }

  // ─── CAR — viewed from directly behind, large, low camera ──
  // Camera is behind-center, car fills bottom third
  const CX=W*0.5, CY=H*0.78;
  const BW=W*0.30; // body width
  const BH=H*0.34; // body height

  ctx.save();

  // Ground shadow
  const shGrad=ctx.createRadialGradient(CX,CY+BH*0.18,0,CX,CY+BH*0.18,BW*0.7);
  shGrad.addColorStop(0,'rgba(0,0,0,0.55)'); shGrad.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=shGrad; ctx.beginPath(); ctx.ellipse(CX,CY+BH*0.18,BW*0.7,BH*0.15,0,0,Math.PI*2); ctx.fill();

  // ── Body colour ──
  let bCol='#b42c12';
  if(weather==='heavy_rain') bCol='#8a1e08';
  if(weather==='snow') bCol='#9a2010';

  // ── Rear diffuser / underbody ──
  ctx.fillStyle='#0a0c10';
  ctx.beginPath();
  ctx.moveTo(CX-BW*0.48, CY+BH*0.12);
  ctx.lineTo(CX+BW*0.48, CY+BH*0.12);
  ctx.lineTo(CX+BW*0.38, CY+BH*0.22);
  ctx.lineTo(CX-BW*0.38, CY+BH*0.22);
  ctx.closePath(); ctx.fill();

  // ── Rear bumper ──
  ctx.fillStyle='#1e2028';
  ctx.beginPath();
  ctx.moveTo(CX-BW*0.50, CY+BH*0.00);
  ctx.lineTo(CX+BW*0.50, CY+BH*0.00);
  ctx.lineTo(CX+BW*0.48, CY+BH*0.14);
  ctx.lineTo(CX-BW*0.48, CY+BH*0.14);
  ctx.closePath(); ctx.fill();

  // ── Main body shell ──
  ctx.fillStyle=bCol;
  ctx.beginPath();
  ctx.moveTo(CX-BW*0.50, CY+BH*0.00);
  ctx.lineTo(CX-BW*0.52, CY-BH*0.30);
  ctx.lineTo(CX-BW*0.42, CY-BH*0.72);
  ctx.lineTo(CX-BW*0.30, CY-BH*0.90);
  ctx.lineTo(CX+BW*0.30, CY-BH*0.90);
  ctx.lineTo(CX+BW*0.42, CY-BH*0.72);
  ctx.lineTo(CX+BW*0.52, CY-BH*0.30);
  ctx.lineTo(CX+BW*0.50, CY+BH*0.00);
  ctx.closePath(); ctx.fill();

  // ── Roof ──
  ctx.fillStyle='#141618';
  ctx.beginPath();
  ctx.moveTo(CX-BW*0.28, CY-BH*0.88);
  ctx.lineTo(CX-BW*0.24, CY-BH*0.99);
  ctx.lineTo(CX+BW*0.24, CY-BH*0.99);
  ctx.lineTo(CX+BW*0.28, CY-BH*0.88);
  ctx.closePath(); ctx.fill();

  // ── Rear window ──
  ctx.fillStyle='rgba(80,120,180,0.28)';
  ctx.beginPath();
  ctx.moveTo(CX-BW*0.25, CY-BH*0.86);
  ctx.lineTo(CX-BW*0.20, CY-BH*0.96);
  ctx.lineTo(CX+BW*0.20, CY-BH*0.96);
  ctx.lineTo(CX+BW*0.25, CY-BH*0.86);
  ctx.closePath(); ctx.fill();
  // Window border
  ctx.strokeStyle='rgba(30,35,45,0.9)'; ctx.lineWidth=2;
  ctx.beginPath();
  ctx.moveTo(CX-BW*0.25, CY-BH*0.86);
  ctx.lineTo(CX-BW*0.20, CY-BH*0.96);
  ctx.lineTo(CX+BW*0.20, CY-BH*0.96);
  ctx.lineTo(CX+BW*0.25, CY-BH*0.86);
  ctx.closePath(); ctx.stroke();

  // Rain streaks on rear window
  if(weather==='rain'||weather==='heavy_rain'){
    ctx.strokeStyle='rgba(200,220,255,0.22)'; ctx.lineWidth=0.8;
    for(let i=0;i<5;i++){
      const wx=CX+BW*(-0.16+i*0.08);
      ctx.beginPath(); ctx.moveTo(wx,CY-BH*0.94); ctx.lineTo(wx+1,CY-BH*0.87); ctx.stroke();
    }
  }

  // ── Livery / rally stripe ──
  // White central stripe
  ctx.fillStyle='rgba(255,255,255,0.13)';
  ctx.fillRect(CX-BW*0.06, CY-BH*0.92, BW*0.12, BH*0.90);
  // Number plate area
  ctx.fillStyle='rgba(240,240,255,0.85)';
  ctx.beginPath(); ctx.roundRect(CX-BW*0.16, CY-BH*0.18, BW*0.32, BH*0.15, 3); ctx.fill();
  ctx.fillStyle='#1a1c22'; ctx.font=`bold ${Math.floor(BH*0.10)}px 'Share Tech Mono',monospace`;
  ctx.textAlign='center'; ctx.fillText('RALLY', CX, CY-BH*0.065);

  // ── Rear spoiler ──
  ctx.fillStyle='#0e1018';
  ctx.fillRect(CX-BW*0.38, CY-BH*0.96, BW*0.76, BH*0.06);
  // Spoiler supports
  ctx.fillStyle='#181c24';
  ctx.fillRect(CX-BW*0.30, CY-BH*1.04, BW*0.06, BH*0.10);
  ctx.fillRect(CX+BW*0.24, CY-BH*1.04, BW*0.06, BH*0.10);
  // Spoiler blade
  ctx.fillStyle='#0a0c12';
  ctx.beginPath(); ctx.roundRect(CX-BW*0.42, CY-BH*1.06, BW*0.84, BH*0.05, 2); ctx.fill();

  // ── Exhaust (left side, with glow) ──
  ctx.fillStyle='#181820';
  ctx.beginPath(); ctx.ellipse(CX-BW*0.34, CY+BH*0.08, BH*0.04, BH*0.025, -0.2, 0, Math.PI*2); ctx.fill();
  // Exhaust glow
  const exGlow=ctx.createRadialGradient(CX-BW*0.34,CY+BH*0.08,0,CX-BW*0.34,CY+BH*0.08,BH*0.08);
  exGlow.addColorStop(0,`rgba(255,140,20,${0.12+0.06*Math.sin(t*8)})`); exGlow.addColorStop(1,'rgba(255,100,0,0)');
  ctx.fillStyle=exGlow; ctx.beginPath(); ctx.arc(CX-BW*0.34,CY+BH*0.08,BH*0.08,0,Math.PI*2); ctx.fill();

  // ── Wheels (rear pair, large, perspective-flat) ──
  const wheels=[{x:CX-BW*0.52, y:CY+BH*0.06},{x:CX+BW*0.52, y:CY+BH*0.06}];
  wheels.forEach(({x,y},wi)=>{
    const rW=BH*0.38, rH=BH*0.15; // ellipse for perspective
    // Tyre
    ctx.fillStyle='#0e0f12';
    ctx.beginPath(); ctx.ellipse(x,y,rW,rH,0,0,Math.PI*2); ctx.fill();
    // Tyre sidewall detail
    ctx.strokeStyle='rgba(50,52,58,0.8)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.ellipse(x,y,rW*0.88,rH*0.88,0,0,Math.PI*2); ctx.stroke();
    // Rim face
    const rimGrad=ctx.createRadialGradient(x-rW*0.1,y-rH*0.2,rW*0.05,x,y,rW*0.72);
    rimGrad.addColorStop(0,'rgba(200,205,215,0.95)');
    rimGrad.addColorStop(0.5,'rgba(140,145,155,0.85)');
    rimGrad.addColorStop(1,'rgba(80,85,90,0.9)');
    ctx.fillStyle=rimGrad;
    ctx.beginPath(); ctx.ellipse(x,y,rW*0.72,rH*0.72,0,0,Math.PI*2); ctx.fill();
    // 5-spoke pattern (rotating)
    const spAngle=t*18+(wi*Math.PI*0.4);
    ctx.strokeStyle='rgba(60,65,70,0.85)'; ctx.lineWidth=rW*0.07;
    for(let s=0;s<5;s++){
      const sa=spAngle+s*Math.PI*2/5;
      ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x+Math.cos(sa)*rW*0.62, y+Math.sin(sa)*rH*0.62); ctx.stroke();
    }
    // Centre cap
    const capGrad=ctx.createRadialGradient(x-rW*0.05,y-rH*0.05,0,x,y,rW*0.18);
    capGrad.addColorStop(0,'rgba(220,225,235,1)'); capGrad.addColorStop(1,'rgba(100,105,115,1)');
    ctx.fillStyle=capGrad; ctx.beginPath(); ctx.ellipse(x,y,rW*0.18,rH*0.18,0,0,Math.PI*2); ctx.fill();
    // Brake caliper (red, visible through rim)
    ctx.fillStyle='rgba(200,30,10,0.7)';
    ctx.beginPath(); ctx.ellipse(x+rW*0.28,y,rW*0.10,rH*0.10,0,0,Math.PI*2); ctx.fill();
  });

  // ── Taillights ──
  const tlY=CY-BH*0.22;
  // Left cluster
  ctx.fillStyle='rgba(200,20,8,0.95)';
  ctx.beginPath(); ctx.roundRect(CX-BW*0.50, tlY, BW*0.12, BH*0.09, 2); ctx.fill();
  // Right cluster
  ctx.beginPath(); ctx.roundRect(CX+BW*0.38, tlY, BW*0.12, BH*0.09, 2); ctx.fill();
  // Inner LED strip
  ctx.fillStyle='rgba(255,50,20,0.6)';
  ctx.beginPath(); ctx.roundRect(CX-BW*0.28, tlY+BH*0.01, BW*0.56, BH*0.04, 1); ctx.fill();
  // Glow
  const tlGlow=ctx.createLinearGradient(CX-BW*0.5,0,CX+BW*0.5,0);
  tlGlow.addColorStop(0,'rgba(255,30,0,0.18)'); tlGlow.addColorStop(0.15,'rgba(255,30,0,0.04)');
  tlGlow.addColorStop(0.85,'rgba(255,30,0,0.04)'); tlGlow.addColorStop(1,'rgba(255,30,0,0.18)');
  ctx.fillStyle=tlGlow; ctx.fillRect(CX-BW*0.52,tlY-BH*0.04,BW*1.04,BH*0.20);

  // Rear fog (heavy rain / fog)
  if(weather==='heavy_rain'||weather==='fog'){
    ctx.fillStyle='rgba(255,60,0,0.92)';
    ctx.beginPath(); ctx.roundRect(CX-BW*0.08, CY+BH*0.01, BW*0.16, BH*0.07, 2); ctx.fill();
    const rfg=ctx.createRadialGradient(CX,CY+BH*0.04,0,CX,CY+BH*0.04,BW*0.3);
    rfg.addColorStop(0,'rgba(255,50,0,0.20)'); rfg.addColorStop(1,'rgba(255,50,0,0)');
    ctx.fillStyle=rfg; ctx.beginPath(); ctx.arc(CX,CY+BH*0.04,BW*0.3,0,Math.PI*2); ctx.fill();
  }

  // Snow on roof
  if(weather==='snow'){
    ctx.fillStyle='rgba(220,238,250,0.75)';
    ctx.beginPath();
    ctx.moveTo(CX-BW*0.26, CY-BH*0.88); ctx.lineTo(CX-BW*0.22, CY-BH*0.98);
    ctx.lineTo(CX+BW*0.22, CY-BH*0.98); ctx.lineTo(CX+BW*0.26, CY-BH*0.88);
    ctx.closePath(); ctx.fill();
    // Snow on spoiler
    ctx.fillStyle='rgba(220,238,250,0.55)';
    ctx.beginPath(); ctx.roundRect(CX-BW*0.42, CY-BH*1.07, BW*0.84, BH*0.04, 1); ctx.fill();
  }

  ctx.restore();

  // ─── HUD ───
  const mono=`'Share Tech Mono',monospace`;
  ctx.save();

  // ── Bottom-left: PS data strip ──
  const hudH=46, hudW=Math.min(W*0.42, 280), hudX=10, hudY=H-hudH-8;
  ctx.fillStyle='rgba(6,8,14,0.82)';
  ctx.beginPath(); ctx.roundRect(hudX,hudY,hudW,hudH,4); ctx.fill();
  // Red left bar
  ctx.fillStyle='#c8301a'; ctx.fillRect(hudX,hudY,3,hudH);
  ctx.strokeStyle='rgba(180,35,18,0.45)'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(hudX,hudY,hudW,hudH,4); ctx.stroke();

  if(lastStage){
    // PS label
    ctx.fillStyle='#c0321a'; ctx.font=`bold 9px ${mono}`; ctx.textAlign='left';
    ctx.fillText(`PS ${lastStage.num}`, hudX+10, hudY+13);
    // Name
    ctx.fillStyle='rgba(210,218,232,0.92)'; ctx.font=`bold 11px ${mono}`;
    ctx.fillText((lastStage.name||'—').toUpperCase().slice(0,20), hudX+10, hudY+27);
    // Details row
    ctx.fillStyle='rgba(120,135,155,0.85)'; ctx.font=`9px ${mono}`;
    const km=lastStage.km?lastStage.km.toFixed(2)+'km':'—';
    const sf=(lastStage.surface||'—').toUpperCase();
    ctx.fillText(`${km}  ·  ${sf}`, hudX+10, hudY+39);
    // Time — right side of strip
    ctx.fillStyle='#f0961e'; ctx.font=`bold 14px ${mono}`; ctx.textAlign='right';
    ctx.fillText(lastStage.time||'—', hudX+hudW-10, hudY+29);
  } else {
    ctx.fillStyle='rgba(120,135,155,0.65)'; ctx.font=`10px ${mono}`; ctx.textAlign='left';
    ctx.fillText('IN ATTESA', hudX+10, hudY+27);
  }

  // ── Top-right: weather badge ──
  const wLabels={clear:'SERENO',cloudy:'NUVOLOSO',rain:'PIOGGIA',heavy_rain:'PIOGGIA FORTE',snow:'NEVE',fog:'NEBBIA'};
  const wBgCol={clear:'rgba(10,14,6,0.82)',cloudy:'rgba(8,10,16,0.82)',rain:'rgba(6,10,18,0.82)',heavy_rain:'rgba(4,6,14,0.82)',snow:'rgba(8,12,18,0.82)',fog:'rgba(10,12,16,0.82)'};
  const wAccCol={clear:'#d4a820',cloudy:'#6a7a8c',rain:'#3a6ab0',heavy_rain:'#2248a0',snow:'#88aace',fog:'#708090'};
  const wl=wLabels[weather]||weather.toUpperCase();
  const wac=wAccCol[weather]||'#888';
  const wbg=wBgCol[weather]||'rgba(8,10,16,0.82)';
  ctx.font=`bold 10px ${mono}`; ctx.textAlign='right';
  const wbW=ctx.measureText(wl).width+28, wbH=28;
  const wbX=W-wbW-8, wbY=8;
  ctx.fillStyle=wbg;
  ctx.beginPath(); ctx.roundRect(wbX,wbY,wbW,wbH,4); ctx.fill();
  ctx.fillStyle=wac+'88'; ctx.fillRect(wbX+wbW-3,wbY,3,wbH);
  ctx.strokeStyle=wac+'55'; ctx.lineWidth=1;
  ctx.beginPath(); ctx.roundRect(wbX,wbY,wbW,wbH,4); ctx.stroke();
  ctx.fillStyle=wac; ctx.font=`bold 10px ${mono}`; ctx.textAlign='right';
  ctx.fillText(wl, W-12, wbY+18);

  // ── Lights indicator (if on) ──
  if(lightsOn){
    const liW=120, liH=20, liX=W-liW-8, liY=wbY+wbH+5;
    ctx.fillStyle='rgba(6,8,14,0.80)';
    ctx.beginPath(); ctx.roundRect(liX,liY,liW,liH,3); ctx.fill();
    ctx.fillStyle='rgba(220,185,30,0.92)'; ctx.font=`bold 9px ${mono}`; ctx.textAlign='right';
    const liLabel=(typeof stageLightsOn!=='undefined'&&stageLightsOn)?'● FANALIERA ON':'● LIGHTS AUTO';
    ctx.fillText(liLabel, W-12, liY+14);
  }

  // ── CANCELLED overlay ──
  if(lastStage&&lastStage.cancelled){
    ctx.fillStyle='rgba(160,20,10,0.22)'; ctx.fillRect(0,0,W,H);
    ctx.fillStyle='rgba(6,8,14,0.88)';
    ctx.beginPath(); ctx.roundRect(W/2-80,H/2-18,160,36,5); ctx.fill();
    ctx.strokeStyle='rgba(200,30,18,0.7)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.roundRect(W/2-80,H/2-18,160,36,5); ctx.stroke();
    ctx.fillStyle='rgba(220,40,20,0.95)'; ctx.font=`bold 13px ${mono}`; ctx.textAlign='center';
    ctx.fillText('PS ANNULLATA', W/2, H/2+5);
  }

  ctx.restore();
}

function startPsAnim() {
  if(psAnimRunning) return;
  psAnimRunning = true;
  function tick() {
    const canvas = document.getElementById('ps-anim-canvas');
    if(!canvas || !psAnimRunning) return;
    psAnimT += 0.008;
    drawPsTrack(canvas, psAnimT);
    // Update weather label
    const wInd=document.getElementById('ps-weather-indicator');
    if(wInd){const w=getPsWeatherCondition();const wl={clear:'SERENO',cloudy:'NUVOLOSO',rain:'PIOGGIA',heavy_rain:'PIOGGIA FORTE',snow:'NEVE',fog:'NEBBIA'};wInd.textContent=wl[w]||w.toUpperCase();}
    psAnimFrame = requestAnimationFrame(tick);
  }
  tick();
}
