// ─── 5) PNG IMAGE EXPORT ────────────────────────────────────────
function _exportReportImage(){
  try {
    var car = (STATE.mode==='track') ? STATE.trackCars[STATE.selectedTrackCar] : STATE.rallyCars[STATE.selectedRallyCar];
    if(!car){ showToast('⚠️ Nessuna vettura selezionata'); return; }
    var laps = STATE.laps[car.id] || [];
    var times = laps.map(function(l){return parseTime(l.time);}).filter(function(t){return t&&isFinite(t);});
    if(!times.length){ showToast('⚠️ Nessun giro registrato'); return; }
    var best = Math.min.apply(null, times);
    var avg = times.reduce(function(a,b){return a+b;},0)/times.length;
    var lastLap = laps[laps.length-1];

    var W = 1080, H = 1080;
    var canvas = document.createElement('canvas');
    canvas.width = W; canvas.height = H;
    var ctx = canvas.getContext('2d');
  if(!ctx) return;
    if(!ctx) return;

    var grad = ctx.createLinearGradient(0,0,0,H);
    grad.addColorStop(0, '#0f1218');
    grad.addColorStop(1, '#1a1d26');
    ctx.fillStyle = grad;
    ctx.fillRect(0,0,W,H);

    ctx.fillStyle = '#e8421a';
    ctx.fillRect(0, 80, W, 8);

    ctx.font = 'bold 56px Arial,sans-serif';
    ctx.fillStyle = '#ffffff';
    ctx.fillText('RACE ENGINEER PRO', 60, 60);

    ctx.font = 'bold 80px Arial,sans-serif';
    ctx.fillStyle = '#e8421a';
    ctx.fillText('🏁 '+car.name, 60, 200);

    var circuit = (typeof CIRCUIT !== 'undefined' && CIRCUIT && CIRCUIT.name) ? CIRCUIT.name : (STATE.circuit||'—');
    ctx.font = '36px Arial,sans-serif';
    ctx.fillStyle = '#aaaaaa';
    ctx.fillText((STATE.mode||'—').toUpperCase()+' · '+circuit, 60, 260);

    function fmt(ms){
      if(!ms||!isFinite(ms)) return '—';
      var min = Math.floor(ms/60000);
      var sec = ((ms%60000)/1000).toFixed(3);
      if(sec.length === 5) sec = '0'+sec;
      return min+':'+sec;
    }
    var kpis = [
      { label:'BEST LAP', value: fmt(best), color:'#2cbc6e' },
      { label:'MEDIA', value: fmt(avg), color:'#2b7de9' },
      { label:'GIRI', value: laps.length+'', color:'#8b5cf6' },
      { label:'ULTIMO', value: lastLap ? (lastLap.time||'—') : '—', color:'#f59e0b' }
    ];
    var kpiY = 340;
    var kpiW = (W - 60*2 - 20)/2;
    var kpiH = 180;
    kpis.forEach(function(k, i){
      var x = 60 + (i%2)*(kpiW+20);
      var y = kpiY + Math.floor(i/2)*(kpiH+20);
      ctx.fillStyle = '#252834';
      ctx.fillRect(x, y, kpiW, kpiH);
      ctx.fillStyle = k.color;
      ctx.fillRect(x, y, 6, kpiH);
      ctx.font = 'bold 24px Arial,sans-serif';
      ctx.fillStyle = '#888';
      ctx.fillText(k.label, x+30, y+50);
      ctx.font = 'bold 60px monospace';
      ctx.fillStyle = k.color;
      ctx.fillText(k.value, x+30, y+130);
    });

    var footerY = 820;
    ctx.fillStyle = '#252834';
    ctx.fillRect(60, footerY, W-120, 200);
    ctx.font = 'bold 32px Arial,sans-serif';
    ctx.fillStyle = '#fff';
    ctx.fillText('📊 Sessione', 90, footerY+50);
    ctx.font = '26px Arial,sans-serif';
    ctx.fillStyle = '#aaa';
    ctx.fillText(lastLap && lastLap.session ? lastLap.session : '—', 90, footerY+90);
    ctx.fillText('Posizione: '+(lastLap && lastLap.pos ? lastLap.pos : '—'), 90, footerY+130);
    ctx.fillText('Generato: '+new Date().toLocaleString('it-IT'), 90, footerY+170);

    canvas.toBlob(function(blob){
      if(!blob){ showToast('❌ Generazione PNG fallita'); return; }
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'race-summary-'+car.name.replace(/\s+/g,'_')+'-'+new Date().toISOString().slice(0,10)+'.png';
      a.click();
      setTimeout(function(){URL.revokeObjectURL(url);}, 1500);
      showToast('✅ Immagine PNG scaricata');
    }, 'image/png');
  } catch(e){
    showToast('❌ Errore: '+e.message);
    console.error(e);
  }
}
