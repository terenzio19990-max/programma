      <span class="tyre-compound cpd-${wd.compound}">${wd.compound} <span style="font-size:10px;opacity:.8">${cpdName(wd.compound)}</span></span>
      <div class="wear-bar" style="margin:7px 0;"><div class="wear-fill ${wClass}" style="width:${wear}%"></div></div>
      <div style="font-size:10px;color:var(--text3);line-height:1.7;">
        Set: <b style="color:var(--text2);">${wd.setName||c.set}</b> · Press: <b style="color:var(--text2);">${wd.pressure||'—'} bar</b><br>
        ${wd.brand?`🏷 <b style="color:var(--text2);">${wd.brand}</b>`:''}${wd.brand&&wd.code?' · ':''}${wd.code?`🔖 <span style="font-family:var(--mono);color:var(--accent3);">${wd.code}</span>`:''}${wd.brand||wd.code?'<br>':''}
        Usura: <b style="color:var(--text1);">${wear}%</b> · Temp: <b style="color:var(--accent3);">${wd.temp||'—'}°C</b>
      </div>
      <button onclick="scanTyreCodeMounted('${modeHint}','${w}')" title="${wd.code?'Aggiorna codice':'Scansiona codice'}" style="position:absolute;top:6px;right:6px;background:rgba(232,66,26,0.15);border:1px solid var(--accent);border-radius:4px;color:var(--accent);cursor:pointer;padding:2px 6px;font-size:11px;">📷</button>
