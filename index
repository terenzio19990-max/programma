// ═══════════════════════════════════════════════════════════════
// LESSONS LEARNED — capture and recall structured knowledge
// Storage: REP_lessons_v1 = { entries: [...] }
// Each lesson: { id, createdAt, updatedAt, situation, lesson,
//   triggerCircuit, triggerSession, triggerWeather, tags[], importance }
// ═══════════════════════════════════════════════════════════════
var LESSONS_KEY = 'REP_lessons_v1';
var _lessons = null;
var _lessonsSelectedId = null;

function _lsLoad(){
  if(_lessons) return _lessons;
  try {
    _lessons = JSON.parse(localStorage.getItem(LESSONS_KEY)||'null') || { entries: [] };
    if(!Array.isArray(_lessons.entries)) _lessons.entries = [];
  } catch(_) { _lessons = { entries: [] }; }
  return _lessons;
}
function _lsSave(){
  try { localStorage.setItem(LESSONS_KEY, JSON.stringify(_lessons||{entries:[]})); } catch(_){}
}
function _lsFmtDate(ts){
  if(!ts) return '—';
  try {
    var d = new Date(ts);
    return d.toLocaleDateString('it-IT', {day:'2-digit', month:'short', year:'numeric'});
  } catch(_) { return '—'; }
}
function _lsFmtRelative(ts){
  if(!ts) return '';
  var diffMs = Date.now() - ts;
  var min = Math.floor(diffMs/60000);
  if(min < 1) return 'ora';
  if(min < 60) return min+'m fa';
  var h = Math.floor(min/60);
  if(h < 24) return h+'h fa';
  var d = Math.floor(h/24);
  if(d < 7) return d+'g fa';
  return _lsFmtDate(ts);
}

// Check if a lesson is relevant to current context
function _lsIsRelevant(lesson, ctx){
  // ctx = { circuit, session, weather }
  // Score: number of trigger fields that match
  var matches = 0;
  var triggers = 0;
  if(lesson.triggerCircuit){
    triggers++;
    if(lesson.triggerCircuit === ctx.circuit) matches++;
  }
  if(lesson.triggerSession){
    triggers++;
    if(ctx.session && lesson.triggerSession.toLowerCase() === ctx.session.toLowerCase()) matches++;
  }
  if(lesson.triggerWeather){
    triggers++;
    if(ctx.weather && lesson.triggerWeather.toLowerCase() === ctx.weather.toLowerCase()) matches++;
  }
  // If lesson has no triggers, it's a generic one — exclude from "rilevanti"
  if(triggers === 0) return false;
  // At least 1 trigger must match
  return matches > 0;
}

function _lsCurrentContext(){
  var circuit = STATE.circuit || '';
  var session = document.getElementById('session-type')?.value || '';
  var weather = '';
  try {
    if(typeof METEO_STATE !== 'undefined' && METEO_STATE && METEO_STATE.current){
      var c = METEO_STATE.current.condition || '';
      if(/pioggia|rain/i.test(c)) weather = 'pioggia';
      else if(/sole|sun/i.test(c)) weather = 'sole';
      else if(/nuvol|cloud/i.test(c)) weather = 'nuvoloso';
      else if(/bagn/i.test(c)) weather = 'bagnato';
      else weather = 'asciutto';
    }
  } catch(_){}
  return { circuit: circuit, session: session, weather: weather };
}

// Create a new empty lesson
function lessonsNew(prefill){
  _lsLoad();
  var lesson = Object.assign({
    id: Date.now() + Math.random().toString(36).substr(2,5),
    createdAt: Date.now(),
    updatedAt: Date.now(),
    situation: '',
    lesson: '',
    triggerCircuit: '',
    triggerSession: '',
    triggerWeather: '',
    tags: [],
    importance: 'medium'
  }, prefill || {});
  _lessons.entries.unshift(lesson);
  _lsSave();
  _lessonsSelectedId = lesson.id;
  renderLessonsPage();
  setTimeout(function(){
    var el = document.getElementById('lesson-situation');
    if(el) el.focus();
  }, 100);
}
window.lessonsNew = lessonsNew;

// Create a new lesson pre-filled from current session context
function lessonsNewFromSession(){
  var ctx = _lsCurrentContext();
  lessonsNew({
    triggerCircuit: ctx.circuit,
    triggerSession: ctx.session,
