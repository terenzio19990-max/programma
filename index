function fuelPlanSync(carName, C, lg){
  var KEY='REP_fuel_plans_v1', st=null;
  try { st=JSON.parse(localStorage.getItem(KEY)||'null'); } catch(e){}
  if(!st || !Array.isArray(st.plans)) st={plans:[]};
  var planName='AUTO — '+carName;
  var pl=st.plans.filter(function(p){ return p.name===planName; })[0];
  if(!pl){
    pl={ id:'fp_auto_'+Date.now(), name:planName, capacity:60, startFuel:60,
         consSS:0.18, consTF:0.08, safety:3, stages:[], updatedAt:Date.now(), auto:true };
    st.plans.push(pl);
  }
  if(lg.type==='ps'){
    var nm=lg.name||('PS'+(pl.stages.length+1));
    var ex=pl.stages.filter(function(s){ return s.name===nm; })[0];
    if(ex) ex.km=lg.km;
    else pl.stages.push({ n:pl.stages.length+1, name:nm, km:lg.km, kmTF:0, refuelAfter:false, refuelMax:0 });
  } else if(pl.stages.length){
    var last=pl.stages[pl.stages.length-1];
    last.kmTF=+((last.kmTF||0)+lg.km).toFixed(2);
  }
  pl.updatedAt=Date.now();
  try { localStorage.setItem(KEY, JSON.stringify(st)); } catch(e){}
  C.fuelPlan=pl;
  try { if(typeof fpRender==='function' && document.getElementById('fp-stages-body')) fpRender(); } catch(e){}
}
