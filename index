// SEASONS COMPARE — year-over-year analytics
// Stagione is inferred from lap.ts (timestamp) → year of that date.
// Laps without ts go to "Sconosciuta".
// ═══════════════════════════════════════════════════════════════

// Bucket all laps by year (and optionally driverId)
function _seasonsBucketLaps(driverId){
  var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
  var buckets = {}; // year -> { laps: [], cars: Set, sessions: Set, circuits: Set }
  allCars.forEach(function(car){
    (STATE.laps[car.id]||[]).forEach(function(l){
      // Filter by driver if requested
      if(driverId && (l.driverId||'') !== driverId) return;
      var ms = parseTime(l.time);
      if(!ms || !isFinite(ms)) return;
      // Determine year from ts
      var year = 'Sconosciuta';
      if(l.ts){
        try { year = String(new Date(l.ts).getFullYear()); } catch(_){}
      }
      if(!buckets[year]){
        buckets[year] = { laps: [], cars: new Set(), sessions: new Set(), circuits: new Set() };
      }
      // Try to attach a circuit guess: the lap doesn't store it, but the season
      // probably had one main circuit per session label. We'll capture STATE.circuit
      // if available, but ALSO try to extract from session if it embeds circuit name
      // (we don't have that field — keep it simple)
      var circuit = l.circuit || ''; // future-proof
      buckets[year].laps.push({ ms: ms, car: car, session: l.session||'', circuit: circuit, ts: l.ts||0, lap: l.lap });
      buckets[year].cars.add(car.id);
      if(l.session) buckets[year].sessions.add(l.session);
      if(circuit) buckets[year].circuits.add(circuit);
    });
  });
  return buckets;
}

// Compute aggregated stats per year
function _seasonsComputeStats(buckets){
  var years = Object.keys(buckets).sort();
  return years.map(function(y){
    var b = buckets[y];
    var times = b.laps.map(function(l){return l.ms;});
    if(!times.length) return null;
    var best = Math.min.apply(null, times);
    var worst = Math.max.apply(null, times);
    var avg = times.reduce(function(a,c){return a+c;},0)/times.length;
    var variance = times.reduce(function(s,v){return s+(v-avg)*(v-avg);},0)/times.length;
    var cv = avg ? (Math.sqrt(variance)/avg)*100 : 0;
    // Best lap car
    var bestLap = b.laps.find(function(l){return l.ms===best;});
    return {
      year: y,
      lapsCount: times.length,
      carsCount: b.cars.size,
      sessionsCount: b.sessions.size,
      best: best,
      worst: worst,
      avg: avg,
      cv: cv,
      bestCar: bestLap ? bestLap.car.name : '—',
      bestSession: bestLap ? bestLap.session : '—'
    };
  }).filter(Boolean);
}

// Populate driver filter
function _seasonsPopulateDriverFilter(){
  var sel = document.getElementById('seasons-driver-filter');
  if(!sel) return;
  var prev = sel.value;
  var drivers = (typeof _drvList === 'function') ? _drvList() : [];
  sel.innerHTML = '<option value="">Tutti i piloti</option>' +
