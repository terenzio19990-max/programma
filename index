// FULL RESTORE — reads a backup file and restores everything
// ═══════════════════════════════════════════════════════════════
function fullBackupImport(ev){
  var file = ev.target.files && ev.target.files[0];
  if(!file) return;
  var reader = new FileReader();
  reader.onload = async function(e){
    try {
      var bak = JSON.parse(e.target.result);
      if(!bak.version || !bak.STATE){ showToast('❌ File non riconosciuto'); return; }
      var info = 'Verrà ripristinato:\n\n';
      info += '• Stato app (vetture, tempi, gomme, ecc.)\n';
      var photoCount = (bak.photos||[]).length;
      info += '• '+photoCount+' foto\n';
      var lsCount = Object.keys(bak.localStorage||{}).length;
      info += '• '+lsCount+' impostazioni / dati ausiliari\n\n';
      info += 'Dati attuali andranno SOSTITUITI. Procedere?';
      if(!confirm(info)) return;
      // Save a safety backup of CURRENT data first to IDB
      try {
        var pre = await openIDB();
        var safetySnap = serializeSession();
        safetySnap.name = '_pre_restore_'+Date.now();
        safetySnap.savedAt = new Date().toISOString();
        var tx = pre.transaction(IDB_STORE, 'readwrite');
        tx.objectStore(IDB_STORE).put(safetySnap);
      } catch(_){}
      // Restore STATE
      if(bak.STATE && typeof STATE !== 'undefined'){
        Object.keys(STATE).forEach(function(k){ delete STATE[k]; });
        Object.assign(STATE, bak.STATE);
      }
      if(bak._competitors && typeof _competitors !== 'undefined'){
        _competitors.length = 0;
        bak._competitors.forEach(function(c){_competitors.push(c);});
      }
      if(bak._driverNotes && typeof _driverNotes !== 'undefined'){
        Object.keys(_driverNotes).forEach(function(k){delete _driverNotes[k];});
        Object.assign(_driverNotes, bak._driverNotes);
      }
      if(bak._pitStops && typeof _pitStops !== 'undefined'){
        Object.keys(_pitStops).forEach(function(k){delete _pitStops[k];});
        Object.assign(_pitStops, bak._pitStops);
      }
      if(bak.COMPOUND_NAMES && typeof COMPOUND_NAMES !== 'undefined'){
        Object.assign(COMPOUND_NAMES, bak.COMPOUND_NAMES);
      }
      if(bak.DOCS && typeof DOCS !== 'undefined'){
        Object.assign(DOCS, bak.DOCS);
      }
      if(bak.METEO_STATE && typeof METEO_STATE !== 'undefined'){
