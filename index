  el.innerHTML = '<div>📊 Consumo reale su '+lr.laps+' giri: <b class="mono" style="color:var(--accent3);">'+lr.perLap.toFixed(2)+' L/giro</b> '+
    '<span class="small">(impostato: '+(f.perLap||0).toFixed(2)+', delta '+(diff>=0?'+':'')+diff.toFixed(2)+')</span> '+
    '<button class="btn btn-green" style="margin-left:8px;" onclick="REP2.useLearned()">USA COME CONSUMO</button></div>';
};
REP2.useLearned = function(){
  var car = curTrackCar(); if(!car) return;
  var lr = REP2.learnedPerLap(car.id); if(!lr) return;
