    else if(e.circuit) circuitName = e.circuit;
    var tags = (e.tags||[]).slice(0,3).map(function(t){return '<span style="background:var(--bg0);color:var(--text2);padding:1px 6px;border-radius:8px;font-size:9px;">#'+t+'</span>';}).join(' ');
