REP2.renderPitWindow = function(){
  var body = ensurePanel('page-pitstop','rep2-pitwin','🪟 PIT WINDOW CALCOLATO <span class="badge badge-blue">v18.2</span>');
  if(!body) return;
  body.innerHTML = '<div class="small mb8">Combina il degrado dello stint corrente (regressione sui tempi), il pit loss reale del circuito e carburante/gomme.</div>'+
    '<button class="btn btn-blue mb8" onclick="REP2.calcPitWindow()">CALCOLA</button><div id="rep2-pw-out"></div>';
  REP2.calcPitWindow();
};
REP2.calcPitWindow = function(){
  var out = document.getElementById('rep2-pw-out'); if(!out) return;
  var car = curTrackCar(); var c = circ();
  if(!car){ out.innerHTML='Seleziona una vettura.'; return; }
  var rows = [];
  var laps = STATE.laps[car.id]||[];
  var mounted = (STATE.tyres[car.id]&&STATE.tyres[car.id].current) ? (STATE.tyres[car.id].current.lapsMounted||0) : 0;
  var stintAll = laps.slice(mounted).map(function(l){ return parseTime(l.time); }).filter(Boolean);
  var med = median(stintAll);
  var stint = stintAll.filter(function(t){ return !med || t < med*1.07; });

  var stopS = +(document.getElementById('pitstop-target')||{}).value || 25;
  var best = (typeof getBestLapMs==='function') ? getBestLapMs(car.id) : null;
  var loss = null;
  if(c && c.pitLengthM && best){
    var pitKm = c.pitLengthM/1000;
    var tPit = pitKm/(c.pitLimitKmh||60)*3600;
    var speed = c.km/(best/3600000);
    loss = tPit - (pitKm/speed*3600) + stopS;
    rows.push('<div>🏁 Pit loss '+E(c.name)+': <b class="mono">~'+loss.toFixed(1)+'s</b> '+
      '<span class="small">(corsia '+c.pitLengthM+'m @ '+(c.pitLimitKmh||60)+' km/h + sosta '+stopS+'s − tratto equivalente in pista)</span></div>');
  } else {
    rows.push('<div class="small" style="color:var(--text3);">Pit loss: seleziona il circuito e registra almeno un giro valido.</div>');
  }

  var slope = null;
  if(stint.length>=4){
    var n=stint.length, sx=0,sy=0,sxy=0,sxx=0;
    stint.forEach(function(y,i){ sx+=i; sy+=y; sxy+=i*y; sxx+=i*i; });
    var den = n*sxx - sx*sx;
    if(den!==0) slope = (n*sxy - sx*sy)/den;
  }
  if(slope!==null){
    var col = slope>150 ? 'var(--red)' : slope>60 ? 'var(--yellow)' : 'var(--green)';
    rows.push('<div>📉 Degrado stint ('+stint.length+' giri validi): <b class="mono" style="color:'+col+';">'+
      (slope>=0?'+':'')+(slope/1000).toFixed(3)+' s/giro</b></div>');
    if(loss!==null && slope>10){
      var done = stintAll.length, cum=0, k=0;
      while(k<80){ k++; cum += slope*(done+k); if(cum > loss*1000) break; }
      var absLap = laps.length + k;
      rows.push('<div>🪟 Restando fuori altri <b>'+k+'</b> giri il degrado cumulato supera il pit loss → '+
        '<b style="color:var(--accent3);">finestra pit entro il giro '+absLap+'</b></div>');
    } else if(loss!==null){
      rows.push('<div style="color:var(--green);">Degrado piatto: nessuna urgenza di sosta per passo.</div>');
    }
  } else {
    rows.push('<div class="small" style="color:var(--text3);">Degrado: servono ≥4 giri validi nello stint corrente.</div>');
  }

  var f = STATE.fuel[car.id];
  if(f && f.perLap>0){
    var lapsFuel = Math.floor(f.current/f.perLap);
    var colF = lapsFuel<=3?'var(--red)':lapsFuel<=8?'var(--yellow)':'var(--green)';
    rows.push('<div>⛽ Autonomia: <b class="mono" style="color:'+colF+';">~'+lapsFuel+' giri</b> ('+f.current.toFixed(1)+'L @ '+f.perLap.toFixed(2)+'L/giro)</div>');
  }
  var wi = REP2.wearInfo(car.id);
  if(wi){
    var colW = wi.est>=wi.thr?'var(--red)':'var(--green)';
    rows.push('<div>🛞 Usura stimata: <b class="mono" style="color:'+colW+';">'+wi.est.toFixed(0)+'%</b>'+
      (wi.est<wi.thr?' → soglia '+wi.thr+'% tra ~<b>'+wi.lapsToThr+'</b> giri':' → <b style="color:var(--red);">SOGLIA SUPERATA</b>')+'</div>');
  }
  out.innerHTML = '<div style="display:flex;flex-direction:column;gap:8px;">'+rows.join('')+'</div>';
};

