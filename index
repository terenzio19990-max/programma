              <span id="theor-lap-disp" class="mono" style="font-size:17px;color:var(--green);font-weight:700;">—</span>
              <span id="theor-vs-best" style="font-size:10px;color:var(--text3);">—</span>
            </div>
          </div>
        </div>
      </div>
    </div>
