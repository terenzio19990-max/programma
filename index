/* ═══ 3) RESTORE VELOCE: rebuild solo l'essenziale + pagina visibile ═══ */
var REP_DEFER_FNS = ['buildLapsPage','buildDashboard','buildTyresPage','buildRallyTyresPage',
  'buildFuelPage','buildRallyFuelPage','buildDamagePage','buildRallyDamagePage','refreshHistory',
  'buildLapChart','buildRallyStandings','renderCompetitorsList','buildPitstopPage','refreshStages',
  'buildTeleCarTabs','buildRallyTeleCarTabs','buildSetupCarTabs','buildRallySetupPage','renderDocs',
  'refreshMeteoPage','buildMeteoChart','renderWaypointsList','updateMapFrame','buildComparePage',
  'renderStatsActiveTab','updateCompGaps','renderWelcomeBanner','updateStageNumAuto',
  'renderSpareParts','buildSpareSummary','rebuildStaticRallyTabs'];

var _origRestore = window.restoreSession;
window.restoreSession = function(snap){
  var t0 = (window.performance&&performance.now)? performance.now() : Date.now();
  var stubs = {};
  REP_DEFER_FNS.forEach(function(fn){
    if(typeof window[fn]==='function'){ stubs[fn]=window[fn]; window[fn]=function(){}; }
  });
  var ok=false;
  try { ok = _origRestore(snap); }
  catch(e){ console.warn('[REP-Storage] restore err', e); }
  finally {
    Object.keys(stubs).forEach(function(fn){ window[fn]=stubs[fn]; });
  }
  // rebuild essenziale (barra laterale, tab vetture) + SOLO la pagina visibile;
  // tutte le altre si ricostruiscono da sole appena le apri (showPage gia' lo fa)
  try { if(typeof buildSidebar==='function') buildSidebar(); } catch(e){}
  try { if(typeof buildTrackCarTabs==='function') buildTrackCarTabs(); } catch(e){}
  try { if(typeof updateTrackCarsPanel==='function') updateTrackCarsPanel(); } catch(e){}
  try {
    var act=document.querySelector('.page.active');
    if(act && typeof showPage==='function') showPage(act.id.replace('page-',''));
  } catch(e){}
  try {
    if(snap && snap.savedAt) _lastApplied = Math.max(_lastApplied, +new Date(snap.savedAt));
  } catch(e){}
  // propaga alle altre schede (se non stiamo GIA' applicando un remoto)
  if(!window._repSuppressAutosave){
    setTimeout(function(){ try { window.autoSave(); } catch(e){} }, 600);
  }
  try {
    var ms = Math.round(((window.performance&&performance.now)? performance.now():Date.now()) - t0);
    console.log('[REP-Storage] restore completato in '+ms+' ms (pagine ricostruite alla visita)');
  } catch(e){}
  return ok;
};

/* ═══ 4) SYNC MULTI-SCHEDA (BroadcastChannel + fallback storage event) ═══ */
var _bc = null;
try { _bc = new BroadcastChannel('rep_sync_v1'); } catch(e){}

function repBroadcast(msg){
  if(_bc){ try { _bc.postMessage(msg); } catch(e){} }
  try { localStorage.setItem('REP_sync_ping', JSON.stringify(msg)+':'+Math.random()); } catch(e){}
}
function repOnRemote(msg){
  if(!msg || msg.tab===TAB_ID) return;
  if(msg.t==='sessions'){
    repLoadSessCache().then(function(){
      try { if(typeof renderSessionList==='function') renderSessionList(); } catch(e){}
    });
    return;
  }
  if(msg.t==='saved'){
    clearTimeout(_syncTimer);
    _syncTimer = setTimeout(repPullRemote, 700);
  }
}
function repPullRemote(){
  // se l'utente sta modificando QUI, rimanda (last-writer-wins ma senza strappare la penna di mano)
  if(Date.now()-_lastLocalEdit < 6000){
    clearTimeout(_syncTimer);
    _syncTimer = setTimeout(repPullRemote, 4000);
    return;
  }
  loadAutoSaveFromIDB().then(function(snap){
    if(!snap || !snap.savedAt) return;
    var ts = +new Date(snap.savedAt);
    if(!(ts > _lastApplied)) return;
    // SYNC SILENZIOSO: aggiorna i dati SENZA toccare la navigazione di QUESTA scheda.
    var actEl = document.querySelector('.page.active');
    var curPage = actEl? actEl.id.replace('page-','') : null;
    var curMode = null;
    try { curMode = STATE.mode; } catch(e){}
    var origShow = window.showPage;
    window._repSuppressAutosave = true;
    window.showPage = function(){};          // blocca i cambi pagina durante l'apply
    try { window.restoreSession(snap); _lastApplied = ts; }
    finally {
      window.showPage = origShow;
      window._repSuppressAutosave = false;
    }
    // ripristina la vista LOCALE (modalita' e pagina dove stavi lavorando)
    try {
      if(curMode){
        try { STATE.mode = curMode; } catch(e){}
        if(typeof setMode==='function') setMode(curMode);
      }
      if(curPage && typeof origShow==='function') origShow(curPage);
    } catch(e){}
    toast('🔄 Dati sincronizzati da un’altra scheda');
  }).catch(function(){});
}
window._repDbgPull = repPullRemote;
if(_bc) _bc.onmessage = function(ev){ repOnRemote(ev.data); };
window.addEventListener('storage', function(ev){
  if(ev.key==='REP_sync_ping' && ev.newValue){
    try { repOnRemote(JSON.parse(ev.newValue.slice(0, ev.newValue.lastIndexOf(':')))); } catch(e){}
  }
});
/* al ritorno sul tab: riallineati comunque (copre messaggi persi) */
window.addEventListener('focus', function(){
  clearTimeout(_syncTimer);
  _syncTimer = setTimeout(repPullRemote, 300);
});

/* ═══ 5) BOOT: migrazione + cache sessioni ═══ */
setTimeout(function(){
  repMigrateSessions().then(repLoadSessCache).then(function(){
    try { if(typeof renderSessionList==='function') renderSessionList(); } catch(e){}
  });
}, 900);

console.log('[REP-Storage] v2 attivo — sessioni su IndexedDB, sync multi-scheda '+(_bc?'(BroadcastChannel)':'(storage event)'));
})();
/* REP-STORAGE-END-MARKER */

</script>
<!-- ===== MAPPA 3D v3.2 ===== -->
<script>
/* REP-MAP3D-BEGIN v3 ==================================================
   MAPPA 3D v3
   - Import automatico: link Google Maps -> strade reali (OSRM) ->
     elevazione (open-meteo); GPX/KML; coordinate incollate.
   - Resa 3D "vera": nastro-strada largo in METRI reali colorato per
     pendenza, terreno circostante ricostruito da griglia di quote,
     parete d'ombra, cippi chilometrici, partenza/arrivo, luci.
   - Accesso in modalita' RALLY: pulsante dedicato in barra nav +
     voce nel menu VETTURA + scorciatoia nella pagina Mappa rally.
   Tutto senza chiavi API.
====================================================================== */
(function(){
'use strict';
if(window._repMap3dV3) return;
window._repMap3dV3 = true;

var Z_EXAG = 2.2;
var MAX_PTS = 450;
var ROUTES_KEY = 'REP_routes_v1';
var TERR_PREF_KEY = 'REP_m3_terrain';
var TERR_N = 14;                       // griglia terreno 14x14 = 196 quote (2 chiamate)
var _terrCache = { key:null, trace:null };

function toast(m){ try { if(typeof showToast==='function') showToast(m); } catch(e){} }
function setProg(m){ var el=document.getElementById('m3-progress'); if(el) el.innerHTML=m||''; }
function terrOn(){ try { return localStorage.getItem(TERR_PREF_KEY)!=='0'; } catch(e){ return true; } }

/* ── geometria ── */
function gpsData(){
  try { if(typeof _gpsData!=='undefined' && _gpsData) return _gpsData; } catch(e){}
  return window._gpsData||null;
}
function aMin(a){ var m=Infinity; for(var i=0;i<a.length;i++) if(a[i]<m) m=a[i]; return m; }
function aMax(a){ var m=-Infinity; for(var i=0;i<a.length;i++) if(a[i]>m) m=a[i]; return m; }
function movAvg(a,w){
  var out=new Array(a.length);
  for(var i=0;i<a.length;i++){
    var s0=0,c=0;
    for(var j=Math.max(0,i-w); j<=Math.min(a.length-1,i+w); j++){ s0+=a[j]; c++; }
    out[i]=s0/c;
  }
  return out;
}
function havM(a1,o1,a2,o2){
  var R=6371e3, p1=a1*Math.PI/180, p2=a2*Math.PI/180;
  var dp=(a2-a1)*Math.PI/180, dl=(o2-o1)*Math.PI/180;
  var x=Math.sin(dp/2)*Math.sin(dp/2)+Math.cos(p1)*Math.cos(p2)*Math.sin(dl/2)*Math.sin(dl/2);
  return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));
}
function m3Resample(pts, n){
  if(pts.length<=2) return pts.slice();
  var cum=[0];
  for(var i=1;i<pts.length;i++) cum.push(cum[i-1]+havM(pts[i-1][0],pts[i-1][1],pts[i][0],pts[i][1]));
  var tot=cum[cum.length-1];
  if(!(tot>0)) return pts.slice();
  var N=Math.min(n, Math.max(pts.length, Math.round(tot/20)));
  var out=[], j=0;
  for(var k=0;k<N;k++){
    var target=tot*k/(N-1);
    while(j<cum.length-2 && cum[j+1]<target) j++;
    var seg=cum[j+1]-cum[j], f=seg>0? (target-cum[j])/seg : 0;
    out.push([ pts[j][0]+(pts[j+1][0]-pts[j][0])*f, pts[j][1]+(pts[j+1][1]-pts[j][1])*f ]);
  }
  return out;
}

/* ── parsing input (link Google Maps / coordinate) ── */
window.m3ParseInput = function(txt){
  if(!txt) return { short:false, pts:[] };
  var t;
  try { t = decodeURIComponent(txt); } catch(e){ t = txt; }
  var pts=[], seen={};
  function push(lat,lon){
    lat=+lat; lon=+lon;
    if(!isFinite(lat)||!isFinite(lon)||Math.abs(lat)>85||Math.abs(lon)>180) return;
    var k=lat.toFixed(5)+','+lon.toFixed(5);
    if(seen[k]) return; seen[k]=1;
    pts.push([lat,lon]);
  }
  var isGmaps = /google\.[a-z.]+\/maps|maps\.app\.goo/i.test(t);
  if(/maps\.app\.goo\.gl/i.test(t) && !/\/dir\//i.test(t)) return { short:true, pts:[] };
  if(isGmaps){
    var dir = t.match(/\/dir\/([^?]*)/i);
    if(dir){
      var m, re=/(-?\d{1,2}\.\d{2,}),\s*(-?\d{1,3}\.\d{2,})/g;
      var seg = dir[1].split('data=')[0].split('@')[0];
      while((m=re.exec(seg))) push(m[1],m[2]);
    }
    var re2=/!3d(-?\d{1,2}\.\d{2,})!4d(-?\d{1,3}\.\d{2,})/g, m2;
    while((m2=re2.exec(t))) push(m2[1],m2[2]);
    var re2b=/!1d(-?\d{1,3}\.\d{2,})!2d(-?\d{1,2}\.\d{2,})/g, m2b;
    while((m2b=re2b.exec(t))) push(m2b[2],m2b[1]);
    var m3=t.match(/[?&](?:q|ll)=(-?\d{1,2}\.\d{2,}),(-?\d{1,3}\.\d{2,})/);
    if(m3) push(m3[1],m3[2]);
    if(!pts.length){
      var m4=t.match(/@(-?\d{1,2}\.\d{2,}),(-?\d{1,3}\.\d{2,})/);
      if(m4) push(m4[1],m4[2]);
    }
  } else {
    var m5, re5=/(-?\d{1,2}\.\d{2,})\s*,\s*(-?\d{1,3}\.\d{2,})/g;
    while((m5=re5.exec(t))) push(m5[1],m5[2]);
  }
  return { short:false, pts:pts };
};

/* ── GPX / KML ── */
window.m3ParseTrackFile = function(name, text){
  var pts=[], alts=[], hasAlt=false;
  if(/\.gpx$/i.test(name) || /<gpx/i.test(text)){
    var re=/<(?:trkpt|rtept|wpt)[^>]*lat="(-?[\d.]+)"[^>]*lon="(-?[\d.]+)"[^>]*>([\s\S]*?)<\/(?:trkpt|rtept|wpt)>|<(?:trkpt|rtept)[^>]*lat="(-?[\d.]+)"[^>]*lon="(-?[\d.]+)"[^>]*\/>/g, m;
    while((m=re.exec(text))){
      var lat=+(m[1]||m[4]), lon=+(m[2]||m[5]);
      if(!isFinite(lat)||!isFinite(lon)) continue;
      pts.push([lat,lon]);
      var em = m[3]? m[3].match(/<ele>\s*(-?[\d.]+)\s*<\/ele>/) : null;
      if(em){ alts.push(+em[1]); hasAlt=true; } else alts.push(null);
    }
  } else if(/\.kml$/i.test(name) || /<kml/i.test(text)){
    var re2=/<coordinates>([\s\S]*?)<\/coordinates>/g, m2;
    while((m2=re2.exec(text))){
      m2[1].trim().split(/\s+/).forEach(function(trip){
        var c=trip.split(',');
        var lon=+c[0], lat=+c[1], al=c.length>2? +c[2] : null;
        if(isFinite(lat)&&isFinite(lon)){
          pts.push([lat,lon]);
          if(al!==null&&isFinite(al)&&al!==0){ alts.push(al); hasAlt=true; } else alts.push(null);
        }
      });
    }
  }
  return { pts:pts, alts:alts, hasAlt:hasAlt };
};

/* ── rete: OSRM + elevazione open-meteo ── */
function m3Route(pts){
  var coords = pts.map(function(p){ return p[1].toFixed(6)+','+p[0].toFixed(6); }).join(';');
  var url = 'https://router.project-osrm.org/route/v1/driving/'+coords+'?overview=full&geometries=geojson&steps=false';
  return fetch(url).then(function(r){ return r.json(); }).then(function(j){
    if(!j || j.code!=='Ok' || !j.routes || !j.routes[0]) throw new Error(j&&j.message||'routing fallito');
    return j.routes[0].geometry.coordinates.map(function(c){ return [c[1],c[0]]; });
  });
}
function m3FetchElev(lats, lons){
  return fetch('https://api.open-meteo.com/v1/elevation?latitude='+lats.join(',')+'&longitude='+lons.join(','))
    .then(function(r){ return r.json(); })
    .then(function(j){ return (j&&j.elevation)||[]; });
}
function m3Elevations(pts){
  var out=new Array(pts.length), idx=0;
  function batch(){
    if(idx>=pts.length) return Promise.resolve(out);
    var chunk=pts.slice(idx, idx+100);
    setProg('⛰ Elevazione percorso: '+Math.min(idx+100,pts.length)+'/'+pts.length+'...');
    return m3FetchElev(chunk.map(function(p){return p[0].toFixed(5);}), chunk.map(function(p){return p[1].toFixed(5);}))
      .then(function(arr){
        for(var i=0;i<chunk.length;i++) out[idx+i]= isFinite(arr[i])? arr[i] : (out[idx+i-1]||0);
        idx+=100;
        return batch();
      });
  }
  return batch();
}

/* ── pipeline comune ── */
function m3Plot(pts, alts, label){
  var csv='lat,lon,alt\n';
  for(var i=0;i<pts.length;i++) csv+=pts[i][0].toFixed(6)+','+pts[i][1].toFixed(6)+','+(+alts[i]).toFixed(1)+'\n';
  parseAndPlotGPS(csv);
  m3SaveRoute('_ultimo_', pts, alts, true);
  if(label) toast('✅ '+label);
}
function m3Finish(pts, alts0, label){
  var need = !alts0 || alts0.some(function(a){ return a===null||a===undefined; });
  var p = need? m3Elevations(pts) : Promise.resolve(alts0);
  return p.then(function(alts){ setProg(''); m3Plot(pts, alts, label); })
    .catch(function(e){ setProg(''); toast('⚠ Elevazione non disponibile: '+(e&&e.message||'serve connessione')); });
}
window.m3Import = function(){
  var txt = (document.getElementById('m3-input')||{}).value||'';
  var mode = (document.getElementById('m3-mode')||{}).value||'osrm';
  var res = m3ParseInput(txt);
  if(res.short){ toast('🔗 Link breve goo.gl: aprilo nel browser e incolla l’URL completo'); return; }
  var pts = res.pts;
  if(!pts.length){ toast('Nessuna coordinata trovata nel testo'); return; }
  if(pts.length===1){ toast('Trovato solo 1 punto: serve un itinerario (partenza e arrivo)'); return; }
  setProg('🛣 Calcolo percorso ('+pts.length+' punti guida)...');
  var geomP = (mode==='osrm')? m3Route(pts).catch(function(e){
      toast('⚠ Instradamento non riuscito → uso linea diretta');
      return pts;
    }) : Promise.resolve(pts);
  geomP.then(function(geom){
    var dense = m3Resample(geom, MAX_PTS);
    return m3Finish(dense, null, 'Percorso importato: '+dense.length+' punti');
  });
};
window.m3File = function(ev){
  var f = ev.target.files && ev.target.files[0];
  if(!f) return;
  var rd = new FileReader();
  rd.onload = function(){
    var r = m3ParseTrackFile(f.name, String(rd.result||''));
    if(!r.pts.length){ toast('Nessun punto nel file (attesi GPX trkpt/rtept o KML coordinates)'); return; }
    if(r.hasAlt && r.alts.filter(function(a){return a!==null;}).length > r.pts.length*0.8){
      var step = Math.max(1, Math.ceil(r.pts.length/MAX_PTS));
      var pts=[], alts=[];
      for(var i=0;i<r.pts.length;i+=step){ pts.push(r.pts[i]); alts.push(r.alts[i]!==null? r.alts[i] : (alts.length?alts[alts.length-1]:0)); }
      m3Finish(pts, alts, f.name+' ('+pts.length+' punti, quote dal file)');
    } else {
      m3Finish(m3Resample(r.pts, MAX_PTS), null, f.name+' caricato');
    }
  };
  rd.readAsText(f);
  ev.target.value='';
};

/* ── percorsi salvati ── */
function m3Routes(){ try { return JSON.parse(localStorage.getItem(ROUTES_KEY)||'{}'); } catch(e){ return {}; } }
function m3SaveRoute(name, pts, alts, silent){
