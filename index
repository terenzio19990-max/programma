function anRenderHeatmap(){
  // Perf guard: skip rebuild if container is hidden
  var _g = document.getElementById('an-heatmap-chart');
  if(_g && !_g.offsetParent && !window.__FORCE_REBUILD) return;

  var el = document.getElementById('an-heatmap-chart');
  var topEl = document.getElementById('an-heatmap-top');
  if(!el) return;
  if(!AN.heatmapCar){ el.innerHTML='<div style="padding:30px;text-align:center;color:var(--text3);">Seleziona una vettura</div>'; topEl.innerHTML=''; return; }
  var notes = (typeof _driverNotes!=='undefined' ? (_driverNotes[AN.heatmapCar]||[]) : []);
  if(!notes.length){
    el.innerHTML = '<div style="padding:30px;text-align:center;color:var(--text3);">🔥 Nessuna nota pilota per questa vettura<br><span style="font-size:10px;">Inserisci note dalla pagina "💬 PILOTA" per popolare la heatmap</span></div>';
    topEl.innerHTML = '';
    return;
  }
  // Categories and sectors
  var cats = ['understeer','oversteer','braking','traction','balance','vibration','noise','positive','general'];
  var catLabels = {understeer:'Sottosterzo',oversteer:'Sovrasterzo',braking:'Freni',traction:'Trazione',balance:'Bilanciamento',vibration:'Vibrazioni',noise:'Rumore',positive:'Positivo',general:'Generale'};
  var catColors = {understeer:'#f59e0b',oversteer:'#ec4899',braking:'#e03030',traction:'#8b5cf6',balance:'#2b7de9',vibration:'#14b8a6',noise:'#94a3b8',positive:'#2cbc6e',general:'#6b7280'};
  // Determine "sectors" grouping by point field (free text) — normalize common S1/S2/S3 labels
  var sectors = new Set(['S1','S2','S3','Generale']);
  notes.forEach(function(n){
    var p = (n.point||'').trim();
    if(!p) return;
    // Normalize
    p = p.replace(/settore\s*(\d)/gi,'S$1').replace(/sector\s*(\d)/gi,'S$1').toUpperCase();
    if(/^S[123]$/.test(p)) sectors.add(p);
    else sectors.add(p.slice(0,30)); // Free text: up to 30 chars
  });
  var sectorList = Array.from(sectors);
  // Build matrix[cat][sector] = count + intensity sum
  var matrix = {};
  cats.forEach(function(c){ matrix[c] = {}; sectorList.forEach(function(s){ matrix[c][s]=0; }); });
  var intensityWeights = { light:1, medium:2, heavy:3, critical:4 };
  notes.forEach(function(n){
    var c = n.category || 'general';
    var p = (n.point||'').trim();
    p = p.replace(/settore\s*(\d)/gi,'S$1').replace(/sector\s*(\d)/gi,'S$1').toUpperCase();
    if(!p) p = 'Generale';
    if(!/^S[123]$/.test(p)) p = p.slice(0,30);
    if(!matrix[c]) matrix[c] = {};
    if(!matrix[c][p]) matrix[c][p] = 0;
    var w = intensityWeights[n.intensity||'medium'] || 2;
    matrix[c][p] = (matrix[c][p]||0) + w;
  });
  // Find max for color scaling
  var max = 0;
  cats.forEach(function(c){ sectorList.forEach(function(s){ if((matrix[c][s]||0)>max) max = matrix[c][s]||0; }); });
  if(max===0){ el.innerHTML='<div style="padding:30px;text-align:center;color:var(--text3);">Nessun dato categorizzabile</div>'; topEl.innerHTML=''; return; }
  // Render as HTML grid
  var cellW = Math.max(70, Math.floor((el.offsetWidth||700) / (sectorList.length+1)) - 4);
  var html = '<div style="display:inline-block;min-width:100%;">'+
    '<div style="display:grid;grid-template-columns:120px repeat('+sectorList.length+',minmax('+cellW+'px,1fr));gap:2px;">'+
    '<div></div>'+
    sectorList.map(function(s){return '<div style="padding:6px 4px;background:var(--bg3);border-radius:4px;text-align:center;font-size:10px;font-weight:700;letter-spacing:1px;">'+s+'</div>';}).join('')+
    cats.map(function(c){
      var total = sectorList.reduce(function(a,s){return a+(matrix[c][s]||0);},0);
      if(total===0) return '';
      return '<div style="padding:6px 8px;background:var(--bg3);border-left:3px solid '+catColors[c]+';border-radius:4px;font-size:10px;font-weight:600;">'+catLabels[c]+'</div>'+
        sectorList.map(function(s){
          var v = matrix[c][s]||0;
          var intensity = v/max;
          var bg = v===0 ? 'rgba(255,255,255,0.02)' : 'rgba(224,48,48,'+Math.max(0.12,intensity*0.85)+')';
          var fg = intensity>0.5 ? '#fff' : 'var(--text3)';
          return '<div style="padding:10px 4px;background:'+bg+';border-radius:4px;text-align:center;font-family:var(--mono);font-size:13px;font-weight:700;color:'+fg+';" title="'+catLabels[c]+' in '+s+': '+v+' punti">'+(v||'')+'</div>';
        }).join('');
    }).join('')+
    '</div></div>';
  el.innerHTML = html;
  // Top 5 hot zones
  var hot = [];
  cats.forEach(function(c){ sectorList.forEach(function(s){ if(matrix[c][s]>0) hot.push({cat:c, sector:s, val:matrix[c][s]}); }); });
  hot.sort(function(a,b){return b.val-a.val;});
  hot = hot.slice(0,5);
  topEl.innerHTML = hot.length ? '<div style="font-family:var(--head);font-size:11px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">🔥 TOP 5 PUNTI CRITICI</div>'+
    '<div style="display:flex;flex-wrap:wrap;gap:6px;">'+
    hot.map(function(h,i){
      return '<div style="padding:6px 10px;background:var(--bg3);border-radius:4px;border-left:3px solid '+catColors[h.cat]+';font-size:11px;">'+
        '<b style="color:var(--accent3);">#'+(i+1)+'</b> · '+catLabels[h.cat]+' in <b>'+h.sector+'</b> · <span style="color:var(--red);">'+h.val+' punti</span></div>';
    }).join('')+
    '</div>' : '';
}

