      var e=el('rep-live-age'); if(e) e.style.color = age>6? 'var(--red)':'var(--green)';
    }
    carsStrip();
    try { ghostTick(); } catch(eG){}
    if(LIVE.sel && LIVE.cars[LIVE.sel]) { try { wxFetch(LIVE.cars[LIVE.sel]); } catch(eW){} }
    Object.keys(LIVE.cars).forEach(function(nm){ try { ovUpdate(nm); } catch(eO){} });
    Object.keys(LIVE.heldT||{}).forEach(function(nm){
      if(Date.now()-LIVE.heldT[nm]>90000){ videoRemove(nm); delete LIVE.heldT[nm]; }
    });
    Object.keys(LIVE.frameT||{}).forEach(function(nm){
      var b=el('rep-vid-'+nm.replace(/[^a-z0-9]/gi,'_'));
      if(b && b._frameImg) b.style.opacity = (Date.now()-LIVE.frameT[nm]>8000)? '0.35':'1';
    });
    if(window._repAlerts.some(function(a){ return !a.done; })) alertRender();
    /* WATCHDOG: vetture attive ma nessun dato da troppo tempo → i socket
       del PC sono probabilmente morti (cambio rete, sospensione):
       ricostruisce i collegamenti con lo STESSO codice, senza perdere
       nulla di cio' che e' gia' arrivato. */
    var wd=(window._REP_WD_MS||20000), cd=(window._REP_WD_CD||30000);
    if(LIVE.hostOn && LIVE.lastAnyData &&
       Date.now()-LIVE.lastAnyData>wd &&
