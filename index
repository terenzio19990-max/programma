function setEl(id,val,fn) { const el=document.getElementById(id); if(!el) return; if(fn) fn(el); else el.textContent=val; }
function getBestLap(carId) {
  const laps = STATE.laps[carId]||[];
  if(!laps.length) return null;
  let best=null, bestMs=Infinity;
  laps.forEach(l=>{ const ms=parseTime(l.time); if(ms&&ms<bestMs){bestMs=ms;best=l.time;} });
  return best;
}
function getBestLapMs(carId) {
  const laps = STATE.laps[carId]||[];
  let bestMs=Infinity;
  laps.forEach(l=>{ const ms=parseTime(l.time); if(ms&&ms<bestMs) bestMs=ms; });
  return bestMs===Infinity?null:bestMs;
}

function parseTime(str) {
  if(str===null||str===undefined) return null;
  let s = String(str).trim();
  if(!s) return null;
  // Remove surrounding quotes, currency/other noise
  s = s.replace(/["']/g,'').replace(/\s+/g,'');
  // Handle comma as decimal separator
  s = s.replace(/,/g,'.');
  // Formats: m:ss.ms  |  m.ss.ms (Italian) |  ss.ms  |  m'ss"ms (legacy)
  // 1) classic m:ss.mmm
  let m = s.match(/^(\d+):(\d+)\.(\d+)$/);
  if(m) return (+m[1])*60000 + (+m[2])*1000 + +(m[3].padEnd(3,'0').slice(0,3));
  // 2) m'ss"ms
  m = s.match(/^(\d+)['′](\d+)["″](\d+)$/);
  if(m) return (+m[1])*60000 + (+m[2])*1000 + +(m[3].padEnd(3,'0').slice(0,3));
  // 3) m.ss.ms  (three dot-separated groups) — only when first < 60 and second < 60
  m = s.match(/^(\d+)\.(\d{1,2})\.(\d{1,3})$/);
  if(m && +m[2] < 60) return (+m[1])*60000 + (+m[2])*1000 + +(m[3].padEnd(3,'0').slice(0,3));
  // 4) ss.ms
  m = s.match(/^(\d+)\.(\d+)$/);
  if(m) {
    const total = +m[1];
    // If first part >= 60 it's unlikely seconds; treat as seconds anyway
    return total*1000 + +(m[2].padEnd(3,'0').slice(0,3));
  }
  // 5) plain integer seconds
  m = s.match(/^(\d+)$/);
  if(m) return (+m[1])*1000;
  return null;
}

// Normalize any accepted time string → canonical "m:ss.mmm"
function normalizeTime(str) {
  const ms = parseTime(str);
  return ms ? msToTime(ms) : null;
}
function deltaStr(ms) {
  if(ms===0) return '±0.000';
  const sign = ms>0?'+':'-'; const abs=Math.abs(ms);
  const s = Math.floor(abs/1000); const ms2 = abs%1000;
  return sign+s+'.'+String(ms2).padStart(3,'0');
}
function msToTime(ms) {
  if(!ms) return '—';
  const m=Math.floor(ms/60000); const s=Math.floor((ms%60000)/1000); const ms3=ms%1000;
  return `${m}:${String(s).padStart(2,'0')}.${String(ms3).padStart(3,'0')}`;
}

// ═══════════════════════════════════════════════════════════════
// INPUT VALIDATION — sanity checks for user inputs
// Returns { valid:bool, level:'ok'|'warn'|'err', msg, parsed?, suggested? }
// `valid` = true if not 'err'. UI uses level for color-coding.
// ═══════════════════════════════════════════════════════════════
var Validate = {};

// ─── Lap time validation ───────────────────────────────────────
// Returns ms or null. Hard error if unparseable. Soft warning if
// outside [20s, 15min] or far from circuit's recent best.
Validate.lapTime = function(str, options){
  options = options || {};
  if(!str || !String(str).trim()) return { valid:false, level:'err', msg:'Tempo vuoto' };
  var ms = parseTime(str);
  if(ms === null) return { valid:false, level:'err', msg:'Formato non riconosciuto. Usa m:ss.mmm' };
  if(ms < 5000)   return { valid:true, level:'warn', msg:'Tempo molto breve (<5s) — sicuro?', parsed:ms };
  if(ms < 20000)  return { valid:true, level:'warn', msg:'Tempo breve ('+(ms/1000).toFixed(1)+'s) — è un giro o un settore?', parsed:ms };
  if(ms > 900000) return { valid:true, level:'warn', msg:'Tempo lungo (>15min) — verifica', parsed:ms };
  // Compare to circuit best if provided
  if(options.circuitBestMs && options.circuitBestMs > 0){
    var deltaPct = Math.abs(ms - options.circuitBestMs) / options.circuitBestMs * 100;
    if(deltaPct > 30){
      var sign = ms > options.circuitBestMs ? 'sopra' : 'sotto';
      return { valid:true, level:'warn', msg:'>'+deltaPct.toFixed(0)+'% '+sign+' best del circuito — verifica formato', parsed:ms };
    }
  }
  return { valid:true, level:'ok', parsed:ms };
};

// ─── Sector time validation ────────────────────────────────────
// Sectors are normally 5s-3min. Optional check: sum of sectors vs lap total.
Validate.sectorTime = function(str, options){
  options = options || {};
  if(!str || !String(str).trim()) return { valid:true, level:'ok', parsed:null }; // empty allowed
  var ms = parseTime(str);
  if(ms === null) return { valid:false, level:'err', msg:'Formato settore non valido' };
  if(ms < 3000) return { valid:true, level:'warn', msg:'Settore <3s — sicuro?', parsed:ms };
  if(ms > 300000) return { valid:true, level:'warn', msg:'Settore >5min — verifica', parsed:ms };
  return { valid:true, level:'ok', parsed:ms };
};

// ─── Sectors-vs-lap consistency (called at submit) ─────────────
Validate.sectorsConsistency = function(s1, s2, s3, lapMs){
  var p1 = parseTime(s1), p2 = parseTime(s2), p3 = parseTime(s3);
  if(!p1 || !p2 || !p3 || !lapMs) return { valid:true, level:'ok' };
  var sum = p1 + p2 + p3;
  var deltaMs = Math.abs(sum - lapMs);
  // Tolerate 200ms (rounding/manual entry)
  if(deltaMs > 200){
    var sign = sum > lapMs ? '+' : '-';
    return {
      valid:true,
      level:'warn',
      msg:'Somma settori ('+(sum/1000).toFixed(3)+'s) differisce dal tempo giro di '+sign+(deltaMs/1000).toFixed(3)+'s'
    };
  }
  return { valid:true, level:'ok' };
};

// ─── Numeric range validation ──────────────────────────────────
Validate.numeric = function(value, min, max, label){
  if(value === '' || value === null || value === undefined) return { valid:true, level:'ok' }; // empty allowed
  var n = +value;
  if(isNaN(n)) return { valid:false, level:'err', msg:(label||'Valore')+' non numerico' };
  if(n < min) return { valid:true, level:'warn', msg:(label||'Valore')+' < '+min+' — sicuro?' };
  if(n > max) return { valid:true, level:'warn', msg:(label||'Valore')+' > '+max+' — sicuro?' };
  return { valid:true, level:'ok', parsed:n };
};

// ─── Specific helpers ──────────────────────────────────────────
Validate.pressure   = function(v){ return Validate.numeric(v, 1.0, 4.0, 'Pressione (bar)'); };
Validate.tyreTemp   = function(v){ return Validate.numeric(v, -10, 150, 'Temperatura gomma (°C)'); };
Validate.tyreWear   = function(v){ var r = Validate.numeric(v, 0, 100, 'Usura (%)'); if(r.level==='warn'&&(+v<0||+v>100)) r.level='err'; return r; };
Validate.camber     = function(v){ return Validate.numeric(v, -10, 5, 'Camber'); };
Validate.toe        = function(v){ return Validate.numeric(v, -2, 2, 'Toe'); };
Validate.position   = function(v){ var r = Validate.numeric(v, 1, 100, 'Posizione'); if(+v===0) r={valid:false,level:'err',msg:'Posizione 0 non valida'}; return r; };
Validate.vmax       = function(v){ return Validate.numeric(v, 50, 400, 'V.Max km/h'); };
Validate.fuel       = function(v, capacity){
  if(v === '' || v === null || v === undefined) return { valid:true, level:'ok' };
  var n = +v;
  if(isNaN(n)) return { valid:false, level:'err', msg:'Carburante non numerico' };
  if(n < 0) return { valid:false, level:'err', msg:'Carburante negativo non valido' };
  if(capacity && n > capacity*1.05) return { valid:true, level:'warn', msg:'Carburante > capacità ('+capacity+'L) — sicuro?' };
  return { valid:true, level:'ok', parsed:n };
};

// ─── UI integration helper ─────────────────────────────────────
// Apply visual feedback to an input field based on a Validate.* result
Validate.applyToField = function(inputEl, result){
  if(!inputEl) return;
  inputEl.classList.remove('val-ok','val-warn','val-err');
  if(result.level === 'err')  inputEl.classList.add('val-err');
  else if(result.level === 'warn') inputEl.classList.add('val-warn');
  else if(result.level === 'ok' && inputEl.value !== '') inputEl.classList.add('val-ok');
  // Tooltip on warn/err
  if(result.msg) inputEl.setAttribute('title', result.msg);
  else inputEl.removeAttribute('title');
};

// Wire up live validation on a single field
Validate.wireField = function(inputId, validatorFn){
  var el = document.getElementById(inputId);
  if(!el) return;
  // Remove previous listener (idempotent)
  if(el._valFn) el.removeEventListener('input', el._valFn);
  el._valFn = function(){
    var r = validatorFn(el.value);
    Validate.applyToField(el, r);
  };
  el.addEventListener('input', el._valFn);
  el.addEventListener('blur', el._valFn);
};

// Compute circuit best for current car (used as benchmark in lap validation)
Validate.currentCircuitBestMs = function(){
  try {
    var cars = (STATE.mode === 'rally' ? STATE.rallyCars : STATE.trackCars) || [];
    var best = Infinity;
    cars.forEach(function(car){
      (STATE.laps[car.id]||[]).forEach(function(l){
        var ms = parseTime(l.time);
        if(ms && isFinite(ms) && ms < best) best = ms;
      });
    });
    return isFinite(best) ? best : 0;
  } catch(_){ return 0; }
};

window.Validate = Validate;

// ═══════════════════════════════════════════════════════════════
// SMART DEFAULTS — remember last user choices and pre-fill forms
// Storage key: REP_form_memory_v1 = { sessionType, surface,
//   compoundTrack, compoundRally, lastDriverId, lastVmax,
//   targetTime_<circuit>, ... }
// ═══════════════════════════════════════════════════════════════
var FORM_MEM_KEY = 'REP_form_memory_v1';
var Mem = {
  _cache: null,
  _load: function(){
    if(this._cache) return this._cache;
    try {
      this._cache = JSON.parse(localStorage.getItem(FORM_MEM_KEY)||'{}') || {};
    } catch(_) { this._cache = {}; }
    return this._cache;
  },
  get: function(key, fallback){
    var m = this._load();
    return (key in m) ? m[key] : (fallback === undefined ? null : fallback);
  },
  set: function(key, value){
    var m = this._load();
    m[key] = value;
    try { localStorage.setItem(FORM_MEM_KEY, JSON.stringify(m)); } catch(_){}
  },
  remove: function(key){
    var m = this._load();
    delete m[key];
    try { localStorage.setItem(FORM_MEM_KEY, JSON.stringify(m)); } catch(_){}
  },
  clear: function(){
    this._cache = {};
    try { localStorage.removeItem(FORM_MEM_KEY); } catch(_){}
  }
};
window.Mem = Mem;

// ─── Apply smart defaults to forms (called on page show) ───────
function applySmartDefaults(){
  // Session type — restore last used (only if currently empty/default)
  var st = document.getElementById('session-type');
  if(st && Mem.get('sessionType')){
    var current = st.value;
    var saved = Mem.get('sessionType');
    // Only override if current value is the literal default ('FP1' often), or empty,
    // or the saved value matches an option (avoid setting an invalid value)
    if(saved && Array.from(st.options).some(function(o){return o.value === saved;})){
      // Set only if it's the very first time (no manual change yet for this session)
      if(!st.dataset.userChanged) st.value = saved;
    }
  }
  // Surface
  var srf = document.getElementById('surface-sel');
  if(srf && Mem.get('surface')){
    var savedSrf = Mem.get('surface');
    if(Array.from(srf.options).some(function(o){return o.value === savedSrf;})){
      if(!srf.dataset.userChanged) srf.value = savedSrf;
    }
  }
  // Driver — last used
  var ld = document.getElementById('lap-driver');
  if(ld && Mem.get('lastDriverId')){
    var savedDr = Mem.get('lastDriverId');
    if(Array.from(ld.options).some(function(o){return o.value === savedDr;})){
      if(!ld.value) ld.value = savedDr;
    }
  }
  var sd = document.getElementById('stage-driver');
  if(sd && Mem.get('lastDriverId')){
    var savedDr2 = Mem.get('lastDriverId');
    if(Array.from(sd.options).some(function(o){return o.value === savedDr2;})){
      if(!sd.value) sd.value = savedDr2;
    }
  }
  // Target time — load saved per circuit
  var tt = document.getElementById('target-time');
  if(tt && !tt.value){
    var circuit = STATE.circuit || 'unknown';
    var savedTT = Mem.get('targetTime_' + circuit);
    if(savedTT) tt.value = savedTT;
    else {
      // Suggest based on best-0.3s
      var bestMs = (typeof Validate !== 'undefined') ? Validate.currentCircuitBestMs() : 0;
      if(bestMs > 0){
        // Target = best + 0% (just hit the best). Offer it as default.
        tt.value = msToTime(bestMs);
        tt.placeholder = 'Suggerito: il tuo best (' + msToTime(bestMs) + ')';
      }
    }
  }
}
window.applySmartDefaults = applySmartDefaults;

