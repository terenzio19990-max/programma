<!-- PeerJS with multi-CDN fallback: tries jsdelivr → unpkg → cdnjs in sequence -->
<script>
(function(){
  var PEERJS_CDNS = [
    'https://cdn.jsdelivr.net/npm/[email protected]/dist/peerjs.min.js',
    'https://unpkg.com/[email protected]/dist/peerjs.min.js',
    'https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.4/peerjs.min.js'
  ];
  window._PEERJS_LOAD_STATUS = 'loading';
  window._PEERJS_CDN_TRIED = [];
  function tryLoad(idx){
    if(idx >= PEERJS_CDNS.length){
      window._PEERJS_LOAD_STATUS = 'failed';
      console.error('[PeerJS] Tutti i CDN hanno fallito. Modalità LAN non disponibile.', window._PEERJS_CDN_TRIED);
      return;
    }
    var url = PEERJS_CDNS[idx];
    window._PEERJS_CDN_TRIED.push(url);
    var s = document.createElement('script');
    s.src = url;
    s.async = false;
    s.onload = function(){
      if(typeof Peer !== 'undefined'){
        window._PEERJS_LOAD_STATUS = 'ready';
        window._PEERJS_CDN_USED = url;
        console.log('[PeerJS] Caricato da '+url);
      } else {
        tryLoad(idx+1);
      }
    };
    s.onerror = function(){
      console.warn('[PeerJS] Fallito CDN '+url+', provo il successivo...');
      tryLoad(idx+1);
    };
    document.head.appendChild(s);
  }
  tryLoad(0);
})();
</script>
<script type="module">
  // Firebase modules — loaded only on-demand when user activates Firebase mode.
  // We expose them on window so the non-module script can use them.
  window._FB_MODS = null;
  window.loadFirebaseModules = async function(){
    if(window._FB_MODS) return window._FB_MODS;
    try {
      const app = await import('https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js');
      const db  = await import('https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js');
      window._FB_MODS = { app, db };
      return window._FB_MODS;
    } catch(e){ console.error('Firebase load failed', e); return null; }
  };
</script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Exo+2:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap');

:root {
  --bg0: #0a0b0d;
  --bg1: #0f1115;
  --bg2: #14161c;
  --bg3: #1a1d26;
  --bg4: #20242f;
  --border: #2a2f3e;
  --border2: #353b4f;
  --accent: #e8421a;
  --accent2: #f07030;
  --accent3: #ffa040;
  --blue: #2b7de9;
  --teal: #1aada0;
  --green: #2cbc6e;
  --yellow: #f5c518;
  --red: #e03030;
  --purple: #8b5cf6;
  --text1: #f0f2f5;
  --text2: #a8afc0;
  --text3: #6b7280;
  --mono: 'Share Tech Mono', monospace;
  --head: 'Rajdhani', sans-serif;
  --body: 'Exo 2', sans-serif;
}


/* ─── LIGHT THEME ─── */
html[data-theme="light"] {
  --bg0: #f0f2f5;
  --bg1: #ffffff;
  --bg2: #f8f9fb;
  --bg3: #eef0f4;
  --bg4: #e4e7ed;
  --border: #d0d5e0;
  --border2: #b8bfcc;
  --accent: #e8421a;
  --accent2: #d05020;
  --accent3: #c06010;
  --blue: #1a6fd0;
  --teal: #0f8f84;
  --green: #1a9a50;
  --yellow: #b89010;
  --red: #cc2020;
  --purple: #7040e0;
  --text1: #1a1d26;
  --text2: #3a4055;
  --text3: #6b7280;
}
html[data-theme="light"] body { background:var(--bg0); }
html[data-theme="light"] input,
html[data-theme="light"] select,
html[data-theme="light"] textarea { background:var(--bg1) !important; color:var(--text1) !important; border-color:var(--border) !important; }
html[data-theme="light"] .field input,
html[data-theme="light"] .field select,
html[data-theme="light"] .field textarea { background:var(--bg1); color:var(--text1); }
html[data-theme="light"] .dmg-sel { background:var(--bg1); color:var(--text1); }
html[data-theme="light"] #circuit-wrap { background:var(--bg3); }
html[data-theme="light"] .fuel-gauge { background:var(--bg3); }
html[data-theme="light"] .wear-card { background:var(--bg3); }
html[data-theme="light"] .tile { background:var(--bg3); }
html[data-theme="light"] .note-item { background:var(--bg3); }
html[data-theme="light"] .badge-gray { background:var(--bg4); color:var(--text2); }
html[data-theme="light"] .panel { background:var(--bg2); }
html[data-theme="light"] .panel-head { background:var(--bg3); }
html[data-theme="light"] #topbar,
html[data-theme="light"] #subbar,
html[data-theme="light"] #sidebar { background:var(--bg1); }
html[data-theme="light"] .mode-tab { background:var(--bg3); color:var(--text2); }
html[data-theme="light"] .nav-tab { color:var(--text3); }
html[data-theme="light"] .car-tab { background:var(--bg3); }
html[data-theme="light"] .data-table td { color:var(--text2); }
html[data-theme="light"] .data-table th { background:var(--bg3); color:var(--text3); }
html[data-theme="light"] .data-table tr:hover td { background:var(--bg4); }
html[data-theme="light"] #session-modal > div,
html[data-theme="light"] #car-manager-modal > div,
html[data-theme="light"] #track-editor-modal > div,
html[data-theme="light"] #rename-modal > div,
html[data-theme="light"] #compound-editor-modal > div { background:var(--bg2); }
html[data-theme="light"] .btn-gray { background:var(--bg3); color:var(--text1); border-color:var(--border2); }
html[data-theme="light"] .btn-gray:hover { background:var(--bg4); }
#theme-toggle { transition: all .2s; }

* { margin:0; padding:0; box-sizing:border-box; }
html,body { height:100%; overflow:hidden; background:var(--bg0); color:var(--text1); font-family:var(--body); }

/* ─── LAYOUT ─── */
#app { display:flex; flex-direction:column; height:100vh; overflow:hidden; }

/* TOPBAR */
#topbar {
  display:flex; align-items:center; gap:16px; padding:0 20px;
  height:52px; background:var(--bg1); border-bottom:1px solid var(--border);
  flex-shrink:0; position:relative; z-index:50;
}
.logo { font-family:var(--head); font-size:22px; font-weight:700; letter-spacing:3px; color:var(--text1); }
.logo span { color:var(--accent); }
.mode-tabs { display:flex; gap:4px; margin-left:auto; }
.mode-tab {
  padding:6px 18px; border-radius:4px; font-family:var(--head); font-size:13px;
  font-weight:600; letter-spacing:1px; cursor:pointer; border:1px solid var(--border2);
  background:transparent; color:var(--text2); transition:all .2s;
}
.mode-tab.active { background:var(--accent); border-color:var(--accent); color:#fff; }
.mode-tab:hover:not(.active) { background:var(--bg3); color:var(--text1); }
.topbar-right { display:flex; align-items:center; gap:10px; }
.session-clock { font-family:var(--mono); font-size:22px; color:var(--accent3); letter-spacing:2px; min-width:90px; }
.flag-display { width:28px; height:28px; border-radius:4px; cursor:pointer; transition:all .2s; }
.flag-green { background:var(--green); }
.flag-yellow { background:var(--yellow); }
.flag-red { background:var(--red); box-shadow:0 0 12px var(--red); }
.flag-sc { background:var(--yellow); border:2px solid #fff; }
.weather-badge { display:flex; align-items:center; gap:6px; padding:4px 10px; background:var(--bg3); border:1px solid var(--border); border-radius:4px; font-size:12px; color:var(--text2); }
.weather-temp { font-family:var(--mono); font-size:14px; color:var(--accent3); font-weight:600; }
.btn { padding:6px 14px; border-radius:4px; font-family:var(--head); font-size:12px; font-weight:600; letter-spacing:1px; cursor:pointer; border:1px solid; transition:all .2s; }
.btn-red { background:rgba(232,66,26,.15); border-color:var(--accent); color:var(--accent); }
.btn-red:hover { background:var(--accent); color:#fff; }
.btn-blue { background:rgba(43,125,233,.15); border-color:var(--blue); color:var(--blue); }
.btn-blue:hover { background:var(--blue); color:#fff; }
.btn-green { background:rgba(44,188,110,.15); border-color:var(--green); color:var(--green); }
.btn-green:hover { background:var(--green); color:#fff; }
.btn-gray { background:var(--bg3); border-color:var(--border2); color:var(--text2); }
.btn-gray:hover { background:var(--bg4); color:var(--text1); }

/* Quick-pick mini buttons for fast data entry (tele notes, etc.) */
.btn-quick-tele { background:var(--bg3); border:1px solid var(--border); color:var(--text2); cursor:pointer; padding:5px 9px; border-radius:14px; font-size:10px; font-weight:600; transition:all 0.15s; }
.btn-quick-tele:hover { background:var(--accent); color:#fff; border-color:var(--accent); }
.btn-quick-tele:active { transform:scale(0.96); }

/* Voice (microphone) recording animation — pulses red while listening */
@keyframes mic-pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(213,58,58,0.6); } 50% { box-shadow: 0 0 0 8px rgba(213,58,58,0); } }
.voice-recording { animation: mic-pulse 1.2s infinite; }

/* ─── Spectator mode: disable all input interactions ─── */
body.spectator input:not([type="radio"]):not([type="checkbox"]),
body.spectator textarea,
body.spectator select,
body.spectator button:not([data-spectator-ok]):not(.spectator-nav),
body.spectator .btn:not([data-spectator-ok]):not(.spectator-nav),
body.spectator [contenteditable="true"] {
  pointer-events: none !important;
  opacity: 0.55;
  cursor: not-allowed !important;
  filter: grayscale(0.3);
}
body.spectator #spectator-banner { display:block !important; pointer-events:none; }
body.spectator { padding-top:26px; }
/* Always keep these usable in spectator */
body.spectator #help-modal *,
body.spectator #notif-drawer *,
body.spectator [data-spectator-ok],
body.spectator .spectator-nav,
body.spectator .mode-tab,
body.spectator .subbar button,
body.spectator .subbar input,
body.spectator nav button,
body.spectator .page-nav button {
  pointer-events: auto !important;
  opacity: 1 !important;
  cursor: pointer !important;
  filter: none !important;
}

/* ─── Density variants ─── */
body.density-compact  .panel-body { padding: 6px 8px !important; }
body.density-compact  .panel-head { padding: 4px 10px !important; font-size:10px !important; }
body.density-compact  input, body.density-compact select, body.density-compact textarea { padding:3px 5px !important; font-size:11px !important; }
body.density-compact  .btn { padding:4px 10px !important; font-size:11px !important; }
body.density-spacious .panel-body { padding: 18px 22px !important; }
body.density-spacious .panel-head { padding: 12px 18px !important; }
body.density-spacious input, body.density-spacious select, body.density-spacious textarea { padding:8px 10px !important; font-size:13px !important; }
body.density-spacious .btn { padding:10px 20px !important; font-size:13px !important; }

/* SUBBAR */
#subbar {
  display:flex; align-items:center; gap:8px; padding:0 20px;
  height:40px; background:var(--bg1); border-bottom:1px solid var(--border);
  flex-shrink:0; overflow:visible; white-space:nowrap;
  position:relative;
}
#subbar::-webkit-scrollbar { height:4px; }
#subbar::-webkit-scrollbar-thumb { background:var(--border2); border-radius:2px; }
#subbar::-webkit-scrollbar-track { background:transparent; }
.nav-tab {
  padding:4px 14px; border-radius:3px; font-family:var(--head); font-size:12px;
  font-weight:600; letter-spacing:1px; cursor:pointer; color:var(--text3);
  transition:all .2s; flex-shrink:0;
}
.nav-tab.active { color:var(--accent2); border-bottom:2px solid var(--accent2); }
.nav-tab:hover:not(.active) { color:var(--text1); }
.sep { color:var(--border2); font-size:16px; }

/* MAIN AREA */
#main { display:flex; flex:1; overflow:hidden; }
#content { flex:1; overflow-y:auto; padding:16px; }
#sidebar { width:360px; flex-shrink:0; background:var(--bg1); border-left:1px solid var(--border); overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:14px; scroll-behavior:smooth; }

/* ─── PANELS ─── */
.panel {
  background:var(--bg2); border:1px solid var(--border); border-radius:6px;
  overflow:hidden;
}
.panel-head {
  display:flex; align-items:center; justify-content:space-between;
  padding:8px 14px; background:var(--bg3); border-bottom:1px solid var(--border);
  font-family:var(--head); font-size:12px; font-weight:700; letter-spacing:2px;
  color:var(--text2); text-transform:uppercase;
}
.panel-head .ph-accent { color:var(--accent2); }
.panel-body { padding:12px; }

/* GRID LAYOUTS */
.g2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.g3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; }
.g4 { display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px; }

/* STAT TILES */
.tile {
  background:var(--bg3); border:1px solid var(--border); border-radius:5px;
  padding:12px 14px;
}
.tile-label { font-size:10px; color:var(--text3); letter-spacing:2px; text-transform:uppercase; margin-bottom:6px; }
.tile-value { font-family:var(--mono); font-size:22px; color:var(--text1); font-weight:600; }
.tile-sub { font-size:10px; color:var(--text3); margin-top:2px; }
.tile-good .tile-value { color:var(--green); }
.tile-warn .tile-value { color:var(--yellow); }
.tile-bad .tile-value { color:var(--red); }
.tile-accent .tile-value { color:var(--accent3); }

/* ─── CIRCUIT CANVAS ─── */
#circuit-wrap { position:relative; width:100%; aspect-ratio:16/9; background:var(--bg0); border-radius:6px; overflow:hidden; }
#circuit-canvas { width:100%; height:100%; }
.car-icon { position:absolute; width:16px; height:16px; border-radius:50%; border:2px solid; transition:all .05s linear; z-index:10; }

/* ─── TABLES ─── */
.data-table { width:100%; border-collapse:collapse; font-size:12px; }
.data-table th { background:var(--bg3); color:var(--text3); font-family:var(--head); font-size:10px; letter-spacing:2px; padding:7px 10px; text-align:left; border-bottom:1px solid var(--border); position:sticky; top:0; }
.data-table td { padding:7px 10px; border-bottom:1px solid var(--border); color:var(--text2); vertical-align:middle; }
.data-table tr:hover td { background:var(--bg3); }
.data-table tr.best td { background:rgba(44,188,110,.08); }
.data-table tr.target td { background:rgba(248,197,24,.08); }
.data-table .mono { font-family:var(--mono); color:var(--text1); }
.delta-pos { color:var(--green); }
.delta-neg { color:var(--red); }
.delta-zero { color:var(--text3); }

/* ─── TYRE GRID ─── */
.tyre-grid { display:grid; grid-template-areas:"fl fr" "rl rr"; gap:10px; }
.tyre-card { background:var(--bg3); border:2px solid var(--border); border-radius:6px; padding:10px; position:relative; }
.tyre-card.worn { border-color:var(--yellow); }
.tyre-card.damaged { border-color:var(--red); }
.tyre-pos { font-family:var(--head); font-size:11px; color:var(--text3); letter-spacing:2px; margin-bottom:6px; }
.tyre-compound { display:inline-block; padding:2px 8px; border-radius:3px; font-family:var(--head); font-size:12px; font-weight:700; letter-spacing:1px; margin-bottom:6px; }
.cpd-S { background:rgba(232,66,26,.2); color:var(--accent); border:1px solid var(--accent); }
.cpd-M { background:rgba(245,197,24,.2); color:var(--yellow); border:1px solid var(--yellow); }
.cpd-H { background:rgba(240,240,240,.1); color:#ddd; border:1px solid #555; }
.cpd-W { background:rgba(43,125,233,.2); color:var(--blue); border:1px solid var(--blue); }
.cpd-I { background:rgba(26,173,160,.2); color:var(--teal); border:1px solid var(--teal); }
.wear-bar { width:100%; height:6px; background:var(--border); border-radius:3px; overflow:hidden; margin:6px 0; }
.wear-fill { height:100%; border-radius:3px; transition:width .3s; }
.wear-low { background:var(--green); }
.wear-mid { background:var(--yellow); }
.wear-high { background:var(--red); }
.tyre-info { font-size:10px; color:var(--text3); line-height:1.6; }
.dmg-badge { position:absolute; top:6px; right:6px; background:var(--red); color:#fff; font-size:9px; padding:1px 5px; border-radius:2px; font-family:var(--head); letter-spacing:1px; }

/* ─── FUEL GAUGE ─── */
.fuel-gauge { position:relative; height:80px; background:var(--bg0); border-radius:5px; overflow:hidden; border:1px solid var(--border); }
.fuel-fill { position:absolute; bottom:0; left:0; right:0; background:linear-gradient(to top, rgba(43,125,233,.8), rgba(43,125,233,.3)); transition:height .5s; }
.fuel-val { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:22px; font-weight:600; color:#fff; text-shadow:0 0 10px rgba(0,0,0,.8); }
.fuel-label { position:absolute; bottom:6px; right:8px; font-size:10px; color:rgba(255,255,255,.6); }

/* ─── FORMS ─── */
.form-row { display:flex; gap:8px; align-items:flex-end; margin-bottom:8px; flex-wrap:wrap; }
.field { display:flex; flex-direction:column; gap:3px; flex:1; min-width:80px; }
.field label { font-size:10px; color:var(--text3); letter-spacing:1px; text-transform:uppercase; }
.field input, .field select, .field textarea {
  background:var(--bg0); border:1px solid var(--border); border-radius:4px;
  color:var(--text1); font-family:var(--body); font-size:12px; padding:6px 8px;
  outline:none; transition:border-color .2s;
}
.field input:focus, .field select:focus, .field textarea:focus { border-color:var(--accent2); }
.field select option { background:var(--bg2); }
.field textarea { resize:vertical; min-height:60px; }

/* ─── TABS ─── */
.inner-tabs { display:flex; gap:2px; margin-bottom:12px; border-bottom:1px solid var(--border); }
.itab { padding:6px 14px; font-family:var(--head); font-size:11px; font-weight:600; letter-spacing:1px; cursor:pointer; color:var(--text3); border-bottom:2px solid transparent; transition:all .2s; }
.itab.active { color:var(--accent2); border-bottom-color:var(--accent2); }

/* ─── BADGE ─── */
.badge { display:inline-block; padding:2px 7px; border-radius:3px; font-size:10px; font-family:var(--head); letter-spacing:1px; font-weight:700; }
.badge-green { background:rgba(44,188,110,.15); color:var(--green); border:1px solid rgba(44,188,110,.3); }
.badge-red { background:rgba(224,48,48,.15); color:var(--red); border:1px solid rgba(224,48,48,.3); }
.badge-yellow { background:rgba(245,197,24,.15); color:var(--yellow); border:1px solid rgba(245,197,24,.3); }
.badge-blue { background:rgba(43,125,233,.15); color:var(--blue); border:1px solid rgba(43,125,233,.3); }
.badge-purple { background:rgba(139,92,246,.15); color:var(--purple); border:1px solid rgba(139,92,246,.3); }
.badge-gray { background:var(--bg3); color:var(--text2); border:1px solid var(--border); }
.badge-retired { background:rgba(224,48,48,.3); color:#fff; border:1px solid var(--red); }

/* ─── SESSION TIMER ─── */
.session-timer-display { font-family:var(--mono); font-size:36px; color:var(--accent3); text-align:center; padding:8px; letter-spacing:4px; }
.timer-controls { display:flex; gap:6px; justify-content:center; margin-top:6px; }

/* ─── SUNRISE/SUNSET ─── */
.sun-bar { display:flex; align-items:center; gap:6px; padding:8px 12px; background:var(--bg0); border-radius:5px; border:1px solid var(--border); }
.sun-icon { font-size:16px; }
.sun-time { font-family:var(--mono); font-size:13px; }

/* ─── NOTES ─── */
.note-item { background:var(--bg3); border-left:3px solid var(--accent2); border-radius:0 4px 4px 0; padding:8px 10px; margin-bottom:6px; font-size:12px; line-height:1.5; }
.note-meta { font-size:10px; color:var(--text3); margin-top:4px; }

/* ─── CIRCUIT INFO ─── */
.circuit-info { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px; }
.ci-tag { display:flex; flex-direction:column; align-items:center; padding:8px 14px; background:var(--bg3); border:1px solid var(--border); border-radius:5px; }
.ci-tag[style*="flex-basis:100%"] { align-items:flex-start; }
.ci-tag span:first-child { font-size:10px; color:var(--text3); letter-spacing:1px; margin-bottom:3px; }
.ci-tag span:last-child { font-family:var(--mono); font-size:14px; color:var(--accent3); font-weight:600; }

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar { width:4px; height:4px; }
::-webkit-scrollbar-track { background:var(--bg1); }
::-webkit-scrollbar-thumb { background:var(--border2); border-radius:2px; }

/* ─── CAR SELECT ─── */
.car-tabs { display:flex; gap:4px; flex-wrap:wrap; margin-bottom:12px; }
.car-tab { padding:4px 12px; border-radius:4px; font-family:var(--head); font-size:11px; font-weight:700; letter-spacing:1px; cursor:pointer; border:1px solid; transition:all .2s; }
.car-lancia { border-color:#1aada0; color:#1aada0; background:rgba(26,173,160,.1); }
.car-lancia.active { background:#1aada0; color:#000; }
.car-clio5 { border-color:#2b7de9; color:#2b7de9; background:rgba(43,125,233,.1); }
.car-clio5.active { background:#2b7de9; color:#fff; }
.car-clio4 { border-color:#8b5cf6; color:#8b5cf6; background:rgba(139,92,246,.1); }
.car-clio4.active { background:#8b5cf6; color:#fff; }
/* Dynamic car category colors */
.car-dyn { border-color:var(--car-color,#555); color:var(--car-color,#aaa); background:rgba(85,85,85,.1); }
.car-dyn.active { background:var(--car-color,#555); color:#fff; }
.car-category-header { font-family:var(--head); font-size:10px; letter-spacing:2px; color:var(--text3); padding:4px 6px 2px; width:100%; text-transform:uppercase; }

/* ─── POSITION INDICATOR ─── */
.pos-badge { display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:50%; font-family:var(--mono); font-size:18px; font-weight:600; }
.pos-1 { background:rgba(245,197,24,.2); color:var(--yellow); border:2px solid var(--yellow); }
.pos-2 { background:rgba(176,176,176,.15); color:#aaa; border:2px solid #aaa; }
.pos-3 { background:rgba(205,127,50,.2); color:#cd7f32; border:2px solid #cd7f32; }
.pos-other { background:var(--bg3); color:var(--text2); border:2px solid var(--border2); }

/* ─── SECTION HEADERS ─── */
.sec-head { font-family:var(--head); font-size:11px; font-weight:700; color:var(--text3); letter-spacing:3px; text-transform:uppercase; padding:6px 0; border-bottom:1px solid var(--border); margin-bottom:10px; }

/* ─── PAGES ─── */
.page { display:none; }
.page.active { display:block; }

/* ─── RETIRED OVERLAY ─── */
.retired-banner { background:rgba(224,48,48,.15); border:1px solid var(--red); border-radius:5px; padding:8px 14px; display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
.retired-banner span { color:var(--red); font-family:var(--head); font-size:12px; letter-spacing:2px; font-weight:700; }

/* ─── MAP LINK ─── */
.map-link { display:flex; align-items:center; gap:8px; padding:8px 12px; background:var(--bg3); border:1px solid var(--border); border-radius:5px; cursor:pointer; text-decoration:none; color:var(--text1); transition:all .2s; font-size:12px; }
.map-link:hover { border-color:var(--accent2); color:var(--accent2); }

/* ─── RESPONSIVE ─── */
@media (max-width:1200px) {
  #sidebar { display:none; }
}

@media (max-width: 992px) {
  /* ─── TABLET ─── */
  .g4, .g3 { grid-template-columns: 1fr 1fr; }
  #topbar { flex-wrap: wrap; height: auto; padding: 10px 15px; }
  .topbar-right { width: 100%; justify-content: flex-start; margin-top: 8px; overflow-x: auto; padding-bottom: 5px; }
  .mode-tabs { margin-left: 0; }
  .session-clock { font-size: 18px; }
  .panel-head { flex-wrap: wrap; gap: 6px; }
}

@media (max-width: 768px) {
  /* ─── SMARTPHONE ─── */
  .g2, .g3, .g4 { grid-template-columns: 1fr; }

  #topbar { flex-direction: column; align-items: flex-start; gap: 6px; padding: 10px; }
  .logo { font-size: 18px; }
  .topbar-right { flex-wrap: nowrap; overflow-x: auto; width: 100%; white-space: nowrap; gap: 6px; }
  .mode-tabs { flex-wrap: nowrap; }

  #subbar { padding: 0 8px; gap: 4px; }
  .nav-tab { padding: 8px 10px; font-size: 12px; }
  .sep { display: none; }

  #content { padding: 10px; }

  .form-row { flex-direction: column; align-items: stretch; }
  .field { width: 100%; margin-bottom: 6px; }

  .panel-head { flex-direction: column; align-items: flex-start; gap: 8px; }
  .panel-body { overflow-x: auto; }

  .tyre-grid { grid-template-areas: "fl" "fr" "rl" "rr"; grid-template-columns: 1fr; }

  .btn { padding: 9px 14px; font-size: 13px; }

  #circuit-wrap { aspect-ratio: 4/3; }

  /* Car tabs scrollable on mobile */
  .car-tabs { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 4px; }
  .car-tab { flex-shrink: 0; }

  /* Timer larger on mobile */
  .session-timer-display { font-size: 28px; }

  /* Cameras: single column on mobile */
  #page-camere > div > div { grid-template-columns: 1fr; }

  /* Hide some topbar buttons on very small screens */
  .topbar-right .btn { padding: 5px 8px; font-size: 11px; }

  /* Inner tabs scrollable */
  .inner-tabs { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .itab { flex-shrink: 0; }

  /* Tile values smaller on mobile */
  .tile-value { font-size: 18px; }
}

/* ─── TABLET / iPad (820px — 1200px) — optimised for engineers in pit ─── */
@media (min-width: 820px) and (max-width: 1200px) {
  /* Hide heavy widget sidebar by default on tablet, add a slide-out toggle */
  #sidebar {
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    width: 320px;
    z-index: 150;
    transform: translateX(100%);
    transition: transform 0.25s ease;
    box-shadow: -4px 0 20px rgba(0,0,0,0.5);
    display: block !important;
  }
  #sidebar.tablet-open { transform: translateX(0); }
  /* Toggle button in topbar for sidebar */
  .tablet-sidebar-toggle { display: inline-flex !important; }

  /* Content takes full width when sidebar is hidden */
  #content { padding: 14px 16px; }

  /* Touch-friendly input sizes — iOS zooms on <16px fonts */
  input[type="text"], input[type="number"], input[type="date"],
  input[type="time"], input[type="email"], select, textarea {
    font-size: 16px !important;
    min-height: 40px;
    padding: 8px 10px;
  }
  /* Tiny inputs inside tight grids — allow smaller but keep tappable */
  .wheel-mount-row input, .tyre-card input, .tile input {
    min-height: 36px;
  }

  /* Bigger action buttons */
  .btn { padding: 10px 16px; font-size: 13px; min-height: 40px; }
  .btn.btn-sm, .btn-gray[style*="padding:2px"], .btn-gray[style*="padding:3px"] { min-height: 30px; }

  /* Nav sidebar: icon-only compact mode on tablet, expand menus on tap */
  .nav-tab { padding: 10px 12px; font-size: 13px; }
  .nav-menu-item { padding: 10px 14px; font-size: 14px; min-height: 44px; display: flex; align-items: center; }

  /* Car tabs: horizontal scroll, never truncate */
  .car-tabs { flex-wrap: nowrap !important; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 4px; }
  .car-tab { flex-shrink: 0; min-height: 40px; padding: 8px 14px; font-size: 13px; }

  /* Form rows: go 2-columns instead of squashing to 1 */
  .form-row { flex-wrap: wrap; gap: 10px; }
  .field { min-width: calc(50% - 6px); flex: 1 1 calc(50% - 6px); }

  /* Tyre grid stays 2x2 — don't collapse to 1 col */
  .tyre-grid { grid-template-areas: "fl fr" "rl rr"; grid-template-columns: 1fr 1fr; }

  /* Panel headers wrap cleanly */
  .panel-head { flex-wrap: wrap; gap: 8px; padding: 10px 14px; }
  .panel-body { padding: 12px 14px; }

  /* Tables: sticky first column for horizontal scroll */
  .panel-body table { min-width: 100%; }
  .panel-body table thead th:first-child,
  .panel-body table tbody td:first-child {
    position: sticky;
    left: 0;
    background: var(--bg2);
    z-index: 2;
  }

  /* Modals: wider on tablet, avoid cutting off */
  .modal-content { max-width: 92vw !important; max-height: 90vh !important; }

  /* Wheel mount rows: 2-col responsive */
  .wheel-mount-row { grid-template-columns: 40px 1fr 1fr 1fr 80px 80px !important; gap: 6px; }

  /* Inner tabs scroll */
  .inner-tabs { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .itab { flex-shrink: 0; min-height: 40px; padding: 8px 14px; }

  /* Topbar cleaner on tablet */
  #topbar { flex-wrap: wrap; padding: 8px 14px; }
  .topbar-right { gap: 6px; flex-wrap: wrap; }

  /* Car mini-panel in main area: more compact */
  .car-compact-strip { font-size: 12px; }
}

/* ─── TABLET PORTRAIT (< 900px & height > width) — iPad portrait ─── */
@media (min-width: 820px) and (max-width: 1024px) and (orientation: portrait) {
  /* Tighter content margins */
  #content { padding: 10px 12px; }
  /* Slightly smaller nav in portrait to save space */
  .nav-tab { font-size: 12px; padding: 8px 10px; }
  /* Tyre mount rows more compressed but still readable */
  .wheel-mount-row { grid-template-columns: 36px 1fr 1fr 1fr 70px 70px !important; gap: 4px; font-size: 12px; }
}

/* ─── GENERIC TOUCH DEVICE (no hover, works on all touch) ─── */
@media (hover: none) and (pointer: coarse) {
  /* Make all clickable things at least 40x40 for reliable tapping */
  button, .btn, .nav-tab, .nav-menu-item, .car-tab, .itab,
  .mode-tab, [onclick]:not(input):not(select):not(textarea) {
    min-height: 40px;
  }
  /* No zoom on input focus (Safari iOS will zoom on <16px) */
  input, select, textarea { font-size: 16px !important; }
  /* Disable hover effects that look stuck on touch */
  .btn:hover, .nav-tab:hover { transform: none; }
  /* Larger tap target for close buttons (×) */
  [onclick*="display='none'"], [onclick*="style.display"] {
    min-width: 36px; min-height: 36px;
  }
}

/* Tablet sidebar toggle button — hidden on desktop */
.tablet-sidebar-toggle {
  display: none;
  align-items: center;
  gap: 6px;
  background: var(--bg3);
  color: var(--text2);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 6px 10px;
  font-size: 12px;
  cursor: pointer;
}
.tablet-sidebar-toggle:hover { background: var(--bg4); }
.tablet-sidebar-toggle .badge-count {
  background: var(--accent);
  color: #fff;
  border-radius: 10px;
  padding: 1px 7px;
  font-size: 10px;
}

/* Backdrop when tablet sidebar is open */
#tablet-sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 149;
}
#tablet-sidebar-backdrop.show { display: block; }

/* ─── ANIMATIONS ─── */
@keyframes pulse-red { 0%,100%{box-shadow:0 0 6px var(--red)} 50%{box-shadow:0 0 18px var(--red)} }
.flag-red { animation:pulse-red 1s infinite; }
@keyframes blink { 50%{opacity:0} }
.retiring { animation:blink .5s infinite; }

/* ─── DAMAGE TRACKER ─── */
.dmg-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.dmg-row { display:flex; align-items:center; gap:8px; padding:6px 8px; background:var(--bg3); border-radius:4px; border:1px solid var(--border); }
.dmg-label { flex:1; font-size:11px; color:var(--text2); }
.dmg-sel { background:var(--bg0); border:1px solid var(--border); border-radius:3px; color:var(--text1); font-size:11px; padding:3px 6px; }

input[type=range] { accent-color:var(--accent2); width:100%; }

.mb8 { margin-bottom:8px; }
.mb12 { margin-bottom:12px; }
.mb16 { margin-bottom:16px; }
.mt8 { margin-top:8px; }
.mt12 { margin-top:12px; }
.flex { display:flex; }
.gap8 { gap:8px; }
.gap12 { gap:12px; }
.aic { align-items:center; }
.jcsb { justify-content:space-between; }
.f1 { flex:1; }
.small { font-size:11px; color:var(--text2); }
.mono { font-family:var(--mono); }

/* ─── WEAR CARD ─── */
.wear-card { background:var(--bg3); border:2px solid var(--border); border-radius:6px; padding:10px; }
.wear-card.worn { border-color:var(--yellow); }
.wear-card.damaged { border-color:var(--red); }
.wear-card-pos { font-family:var(--head); font-size:11px; color:var(--text3); letter-spacing:2px; margin-bottom:6px; }
