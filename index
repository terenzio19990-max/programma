function buildChecklistPage(){
  clLoad();
  _clRebuildTemplateSelector();
  _clRenderTemplate();
}

function _clRebuildTemplateSelector(){
  var sel = document.getElementById('cl-template-sel');
  if(!sel) return;
  var currentMode = (typeof STATE !== 'undefined' && STATE.mode) ? STATE.mode : 'track';
  // Only show templates relevant to the current app mode:
  //   - 'track' mode → 'track' + 'both'
  //   - 'rally' mode → 'rally' + 'both'
  //   - 'custom' → show all (user decides)
  var filtered = CL.templates.filter(function(tpl){
    if(currentMode === 'custom') return true;
    var m = tpl.mode || 'both';
    return m === 'both' || m === currentMode;
  });
  if(!filtered.length){
    // If current selection was filtered out, show all as fallback
    filtered = CL.templates;
  }
  // If currentTplId is no longer in the filtered list, switch to first visible
  if(!filtered.find(function(t){return t.id===CL.currentTplId;})){
    CL.currentTplId = filtered[0] ? filtered[0].id : CL.currentTplId;
  }
  sel.innerHTML = filtered.map(function(tpl){
    var freqBadge = '';
    var f = tpl.frequency || 'per-session';
    var freqIcons = { 'per-session':'', 'per-weekend':' 📅', 'per-month':' 🗓', 'per-season':' 🏁', 'every-500km':' 🔧' };
    freqBadge = freqIcons[f] || '';
    var modeBadge = '';
    if(tpl.mode === 'rally') modeBadge = ' 🌲';
    else if(tpl.mode === 'track') modeBadge = ' 🏁';
    return '<option value="'+tpl.id+'"'+(CL.currentTplId===tpl.id?' selected':'')+'>'+tpl.name+' ['+tpl.type+']'+modeBadge+freqBadge+'</option>';
  }).join('');
}

function clSwitchTemplate(id){
  CL.currentTplId = id;
  CL.session = null; // reset active session
  clSave();
  _clRenderTemplate();
}

function _clCurrentTpl(){
  return CL.templates.find(function(t){return t.id===CL.currentTplId;});
}

function _clRenderTemplate(){
  var tpl = _clCurrentTpl();
  if(!tpl){
    document.getElementById('cl-groups-container').innerHTML = '<div style="padding:30px;text-align:center;color:var(--text3);">Nessun template. Crea il primo.</div>';
    return;
  }
  // Meta fields
  var nameEl = document.getElementById('cl-tpl-name');
  if(nameEl) nameEl.value = tpl.name;
  var typeEl = document.getElementById('cl-tpl-type');
  if(typeEl) typeEl.value = tpl.type || 'generic';

  var container = document.getElementById('cl-groups-container');
  if(!container) return;
  container.innerHTML = tpl.groups.map(function(g){
    var itemsHtml = g.items.map(function(item){
      var done = CL.session && CL.session.completions && CL.session.completions[item.id] && CL.session.completions[item.id].done;
      var prColors = { critical:'var(--red)', warning:'var(--yellow)', normal:'var(--text3)' };
      var prClass = item.priority || 'normal';
      return '<div class="cl-item '+(done?'done':'')+' '+prClass+'">'+
        '<input type="checkbox" '+(done?'checked':'')+' onchange="clToggleItem(\''+item.id+'\',this.checked)">'+
        '<input type="text" class="cl-item-text" value="'+(item.text||'').replace(/"/g,'&quot;')+'" onchange="clUpdateItem(\''+g.id+'\',\''+item.id+'\',\'text\',this.value)">'+
        '<select onchange="clUpdateItem(\''+g.id+'\',\''+item.id+'\',\'priority\',this.value);_clRenderTemplate()" class="cl-item-priority" style="background:'+prColors[prClass]+';color:'+(prClass==='warning'?'#000':'#fff')+';border:none;">'+
          '<option value="critical"'+(prClass==='critical'?' selected':'')+'>ALTA</option>'+
          '<option value="warning"'+(prClass==='warning'?' selected':'')+'>MEDIA</option>'+
          '<option value="normal"'+(prClass==='normal'?' selected':'')+'>BASSA</option>'+
        '</select>'+
        '<button class="cl-remove" onclick="clRemoveItem(\''+g.id+'\',\''+item.id+'\')">✕</button>'+
      '</div>';
    }).join('');
    return '<div class="cl-group">'+
      '<div class="cl-group-head">'+
        '<input type="text" value="'+(g.name||'').replace(/"/g,'&quot;')+'" onchange="clUpdateGroup(\''+g.id+'\',\'name\',this.value)">'+
        '<button class="btn btn-gray" style="padding:3px 8px;font-size:10px;" onclick="clAddItem(\''+g.id+'\')">+ CONTROLLO</button>'+
        '<button class="cl-remove" onclick="clRemoveGroup(\''+g.id+'\')" title="Rimuovi gruppo">🗑</button>'+
      '</div>'+
      '<div class="cl-group-body">'+itemsHtml+'</div>'+
    '</div>';
  }).join('');

  // Update progress bar if session active
  _clUpdateProgress();
}

function clSaveTemplateMeta(){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  var nameEl = document.getElementById('cl-tpl-name');
  var typeEl = document.getElementById('cl-tpl-type');
  if(nameEl) tpl.name = nameEl.value || tpl.name;
  if(typeEl) tpl.type = typeEl.value || 'generic';
  clSave();
  _clRebuildTemplateSelector();
}

function clNewTemplate(){
  var name = prompt('Nome del nuovo template:', 'Nuovo Check');
  if(!name) return;
  var tpl = { id:_clNewId(), name:name, type:'generic', groups:[{id:_clNewId(), name:'Gruppo 1', items:[]}] };
  CL.templates.push(tpl);
  CL.currentTplId = tpl.id;
  clSave();
  _clRebuildTemplateSelector();
  _clRenderTemplate();
}

function clDeleteTemplate(){
  if(CL.templates.length <= 1){ showToast('⚠️ Deve rimanere almeno un template'); return; }
  var tpl = _clCurrentTpl();
  if(!tpl || !confirm('Eliminare il template "'+tpl.name+'"?')) return;
  CL.templates = CL.templates.filter(function(t){return t.id!==tpl.id;});
  CL.currentTplId = CL.templates[0].id;
  CL.session = null;
  clSave();
  _clRebuildTemplateSelector();
  _clRenderTemplate();
}

function clAddGroup(){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  tpl.groups.push({ id:_clNewId(), name:'Nuovo Gruppo', items:[] });
  clSave();
  _clRenderTemplate();
}

function clRemoveGroup(gid){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  if(!confirm('Rimuovere questo gruppo e tutti i suoi controlli?')) return;
  tpl.groups = tpl.groups.filter(function(g){return g.id!==gid;});
  clSave();
  _clRenderTemplate();
}

function clUpdateGroup(gid, field, value){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  var g = tpl.groups.find(function(g){return g.id===gid;});
  if(g){ g[field] = value; clSave(); }
}

function clAddItem(gid){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  var g = tpl.groups.find(function(g){return g.id===gid;}); if(!g) return;
  g.items.push({ id:_clNewId(), text:'Nuovo controllo', priority:'normal' });
  clSave();
  _clRenderTemplate();
}

function clRemoveItem(gid, iid){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  var g = tpl.groups.find(function(g){return g.id===gid;}); if(!g) return;
  g.items = g.items.filter(function(i){return i.id!==iid;});
  clSave();
  _clRenderTemplate();
}

function clUpdateItem(gid, iid, field, value){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  var g = tpl.groups.find(function(g){return g.id===gid;}); if(!g) return;
  var item = g.items.find(function(i){return i.id===iid;}); if(!item) return;
  item[field] = value;
  clSave();
}

function clStartSession(){
  var tpl = _clCurrentTpl(); if(!tpl) return;
  if(CL.session && !CL.session.finalizedAt){
    if(!confirm('C\'è una sessione checklist in corso. Riavviare azzera i progressi. Continuare?')) return;
  }
  CL.session = {
    tplId: tpl.id,
    startedAt: Date.now(),
    completions: {},
    finalizedAt: null,
    sessionType: tpl.type || 'generic'
  };
  clSave();
  _clRenderTemplate();
  _clUpdateProgress();
  document.getElementById('cl-progress-wrap').style.display = 'block';
  document.getElementById('cl-start-btn').textContent = '▶ CHECK IN CORSO';
  showToast('▶ Check iniziato — '+tpl.name);
}

function clResetSession(){
  if(!CL.session) return;
  if(!confirm('Azzerare tutti i progressi di questo check?')) return;
  CL.session.completions = {};
  CL.session.finalizedAt = null;
  clSave();
  _clRenderTemplate();
  _clUpdateProgress();
}

function clToggleItem(iid, done){
  if(!CL.session) {
    // Auto-start session if user starts ticking
    clStartSession();
  }
  if(!CL.session.completions) CL.session.completions = {};
  CL.session.completions[iid] = { done:done, ts:Date.now() };
  clSave();
  _clUpdateProgress();
  // Visually update without full re-render
  var tpl = _clCurrentTpl(); if(!tpl) return;
  // Find the nearest .cl-item in DOM
  var cb = document.querySelector('input[type="checkbox"][onchange*="'+iid+'"]');
  if(cb){
    var item = cb.closest('.cl-item');
    if(item){ if(done) item.classList.add('done'); else item.classList.remove('done'); }
  }
}

function _clUpdateProgress(){
  if(!CL.session){
    document.getElementById('cl-progress-wrap').style.display = 'none';
    var btn = document.getElementById('cl-start-btn');
    if(btn) btn.textContent = '▶ INIZIA CHECK';
    return;
  }
  document.getElementById('cl-progress-wrap').style.display = 'block';
  var tpl = _clCurrentTpl(); if(!tpl) return;
  var allItems = [];
  tpl.groups.forEach(function(g){ g.items.forEach(function(i){ allItems.push(i); }); });
  var total = allItems.length;
  var done = 0, requiredPending = 0;
  allItems.forEach(function(i){
    var c = CL.session.completions && CL.session.completions[i.id];
    if(c && c.done) done++;
    else if(i.priority === 'critical' || i.required) requiredPending++;
  });
  var pct = total > 0 ? Math.round(done/total*100) : 0;
  var bar = document.getElementById('cl-progress-bar');
  var count = document.getElementById('cl-progress-count');
  var meta = document.getElementById('cl-session-meta');
  var finBtn = document.getElementById('cl-finalize-btn');
  if(bar){ bar.style.width = pct+'%'; bar.textContent = pct+'%'; }
  if(count) count.textContent = done+' / '+total;
  if(meta){
    var startStr = new Date(CL.session.startedAt).toLocaleTimeString('it-IT');
    meta.innerHTML = '▶ Iniziato alle <b>'+startStr+'</b> · '+
      '<span style="color:var(--accent3);">'+requiredPending+' critici pendenti</span>';
  }
  if(finBtn){
    finBtn.disabled = requiredPending > 0;
    finBtn.style.opacity = requiredPending>0 ? 0.5 : 1;
    finBtn.title = requiredPending>0 ? 'Completa tutti i controlli critici per finalizzare' : 'Finalizza il check';
  }
}

function clFinalizeSession(){
  if(!CL.session) return;
  var tpl = _clCurrentTpl(); if(!tpl) return;
  var allItems = [];
  tpl.groups.forEach(function(g){ g.items.forEach(function(i){ allItems.push(i); }); });
  var done = 0;
  allItems.forEach(function(i){
    var c = CL.session.completions && CL.session.completions[i.id];
    if(c && c.done) done++;
  });
  CL.session.finalizedAt = Date.now();
  // Push to history
  CL.history.push({
    tplId: tpl.id, tplName: tpl.name, type: tpl.type,
    startedAt: CL.session.startedAt, finalizedAt: CL.session.finalizedAt,
    total: allItems.length, done: done
  });
  // Keep only last 50
  if(CL.history.length > 50) CL.history = CL.history.slice(-50);
  clSave();
  showToast('✅ Check completato: '+done+'/'+allItems.length+' voci');
  // Reset session for next use but keep completions visible
  var sessionCopy = Object.assign({}, CL.session);
  CL.session = null;
  clSave();
  _clRenderTemplate();
  document.getElementById('cl-progress-wrap').style.display = 'none';
  var btn = document.getElementById('cl-start-btn');
  if(btn) btn.textContent = '▶ INIZIA CHECK';
}

function clShowHistory(){
  clLoad();
  if(!CL.history.length){ alert('Nessuno storico ancora. Completa almeno un check per registrarlo.'); return; }
  var h = CL.history.slice().reverse();
  var txt = '📜 STORICO CHECKLIST (ultimi '+Math.min(h.length,20)+')\n\n';
  h.slice(0,20).forEach(function(rec){
    var s = new Date(rec.startedAt).toLocaleString('it-IT');
    var f = rec.finalizedAt ? new Date(rec.finalizedAt).toLocaleTimeString('it-IT') : '—';
    var dur = rec.finalizedAt ? Math.round((rec.finalizedAt-rec.startedAt)/1000) : '—';
    txt += s+' · '+rec.tplName+' ['+rec.type+']\n';
    txt += '  Completati: '+rec.done+'/'+rec.total+' · Durata: '+dur+'s · Fine: '+f+'\n\n';
  });
  alert(txt);
}

