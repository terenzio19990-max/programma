  html += '</div>';

  // Classifica vetture per best lap
  var ranked = allCars.map(function(c){
    var b = getBestLapMs(c.id);
    var laps = STATE.laps[c.id]||[];
    var avg = laps.length?laps.reduce(function(a,l){return a+(parseTime(l.time)||0);},0)/laps.length:0;
    var vm = 0;
    laps.forEach(function(l){var v=+l.vmax; if(v&&v>vm) vm=v;});
    return {car:c, best:b, avg:avg, laps:laps.length, vmax:vm};
  }).filter(function(r){return r.laps>0;}).sort(function(a,b){return (a.best||Infinity)-(b.best||Infinity);});

  if(ranked.length){
    html += '<h3>Classifica per Best Lap</h3><table><tr><th>#</th><th>VETTURA</th><th>CATEGORIA</th><th>BEST</th><th>GAP</th><th>MEDIA</th><th>GIRI</th><th>🚀 V.MAX</th></tr>';
    var leader = ranked[0].best||Infinity;
    ranked.forEach(function(r,i){
      var gap = r.best && isFinite(leader) && i>0 ? '+'+((r.best-leader)/1000).toFixed(3)+'s' : (i===0?'LEADER':'—');
      html += '<tr'+(i===0?' class="best"':'')+'><td class="mono">'+(i+1)+'</td><td>'+r.car.name+(r.car.retired?' <span class="retired-tag">RTD</span>':'')+'</td><td>'+(r.car.category||r.car.type||'—')+'</td><td class="mono">'+(r.best?msToTime(r.best):'—')+'</td><td class="mono" style="color:#e8421a;">'+gap+'</td><td class="mono">'+(r.avg?msToTime(r.avg):'—')+'</td><td class="mono">'+r.laps+'</td><td class="mono" style="color:#d97706;">'+(r.vmax?r.vmax+' km/h':'—')+'</td></tr>';
    });
    html += '</table>';
  }

  // Classifica velocità max
  var rankedV = allCars.map(function(c){
    var vm = 0, vlap = null;
    (STATE.laps[c.id]||[]).forEach(function(l){var v=+l.vmax; if(v&&v>vm){vm=v; vlap=l.lap;}});
    return {car:c, vmax:vm, lap:vlap};
  }).filter(function(r){return r.vmax>0;}).sort(function(a,b){return b.vmax-a.vmax;});
  if(rankedV.length){
    html += '<h3>Classifica Velocità Massima</h3><table><tr><th>#</th><th>VETTURA</th><th>V.MAX</th><th>GIRO</th><th>GAP TOP</th></tr>';
    var topV = rankedV[0].vmax;
    rankedV.forEach(function(r,i){
      var d = r.vmax - topV;
      html += '<tr'+(i===0?' class="best"':'')+'><td class="mono">'+(i+1)+'</td><td>'+r.car.name+'</td><td class="mono" style="color:#d97706;font-weight:700;">'+r.vmax+' km/h</td><td class="mono">G'+r.lap+'</td><td class="mono">'+(i===0?'—':d+' km/h')+'</td></tr>';
    });
    html += '</table>';
  }

  // ─── QUICK report ends here — only summary, ranking, vmax ───────
  if(type === 'quick'){
    html += '<div class="footer">Race Engineer Pro · Report QUICK generato il '+now+' · Premi <b>Ctrl+P</b> per salvare come PDF</div></body></html>';
    var wQ = window.open('','_blank');
    if(wQ){ wQ.document.write(html); wQ.document.close(); setTimeout(function(){wQ.print();},600); }
    showToast('✅ Report rapido aperto · Ctrl+P → Salva PDF');
    return;
  }

  // Gap incrociato tra tue vetture
  if(ranked.length >= 2){
    html += '<h3>Gap Incrociato (best lap)</h3><table><tr><th></th>';
    ranked.forEach(function(r){ html += '<th>'+r.car.name+'</th>'; });
    html += '</tr>';
    ranked.forEach(function(r1){
      html += '<tr><td><b>'+r1.car.name+'</b></td>';
      ranked.forEach(function(r2){
        if(r1===r2){ html += '<td class="mono" style="background:#eef0f4;">—</td>'; return; }
        if(!r1.best||!r2.best){ html += '<td class="mono">—</td>'; return; }
        var d = (r1.best-r2.best)/1000;
        var color = d>0 ? '#e03030' : d<0 ? '#2cbc6e' : '#888';
        var sign = d>0 ? '+' : (d<0?'':'±');
        html += '<td class="mono" style="color:'+color+';">'+sign+d.toFixed(3)+'s</td>';
      });
      html += '</tr>';
    });
    html += '</table>';
  }

  // === Per-car detail ===
  allCars.forEach(function(car) {
    var laps = STATE.laps[car.id]||[];
    if(!laps.length && !(STATE.setup[car.id]||[]).length && !(STATE.damage[car.id]||[]).length) return;
    var bestMs = getBestLapMs(car.id);
    var avgMs = laps.length ? laps.reduce(function(a,l){return a+(parseTime(l.time)||0);},0)/laps.length : 0;
    // Consistency stddev
    var stdev = null;
    if(laps.length>1 && avgMs){
      var variance = laps.reduce(function(s,l){var ms=parseTime(l.time)||0; return s+Math.pow(ms-avgMs,2);},0)/laps.length;
      stdev = Math.sqrt(variance)/1000;
    }
    // Progression: first third vs last third
    var n = laps.length;
    var prog = null;
    if(n>=6){
      var third = Math.floor(n/3);
      var firstLaps = laps.slice(0, third);
      var lastLaps  = laps.slice(n-third);
      var avgF = firstLaps.reduce(function(a,l){return a+(parseTime(l.time)||0);},0)/firstLaps.length;
      var avgL = lastLaps.reduce(function(a,l){return a+(parseTime(l.time)||0);},0)/lastLaps.length;
      prog = { avgF:avgF, avgL:avgL, delta:(avgL-avgF)/1000 };
    }
    // Best sectors for this car (via existing helper)
    var bs = getBestSectors(car.id);
    // Max speed stats
    var vmaxVal = 0, vmaxLap=null, vmaxSum=0, vmaxN=0;
    laps.forEach(function(l){ var v=+l.vmax; if(v){ if(v>vmaxVal){vmaxVal=v;vmaxLap=l.lap;} vmaxSum+=v; vmaxN++; }});
    var vmaxAvg = vmaxN ? vmaxSum/vmaxN : null;

    var pos = STATE.positions[car.id]||{};
    var fuelState = STATE.fuel[car.id]||{};
    var tyreState = STATE.tyres[car.id]||{};
    var setups = STATE.setup[car.id]||[];
    var damages = STATE.damage[car.id]||[];
    var teleNotes = STATE.teleNotes[car.id]||[];
    var driverNotes = (typeof _driverNotes!=='undefined' && _driverNotes[car.id]) || [];
    var pitStops  = (typeof _pitStops  !=='undefined' && _pitStops[car.id])   || [];

    html += '<div class="car-block section">';
    html += '<div class="car-title"><div class="car-dot" style="background:'+(car.color||'#888')+';"></div><h2 style="margin:0;flex:1;border:none;background:none;padding:0;">'+car.name+(car.retired?' <span class="retired-tag">RITIRATA</span>':'')+'</h2><span style="font-size:10px;color:#888;">'+(car.category||car.type||'')+'</span></div>';

    // Key stats row (8 tiles across 2 rows of 4)
    html += '<div class="grid">';
    html += '<div class="tile"><div class="tl">GIRI</div><div class="tv">'+laps.length+'</div></div>';
    html += '<div class="tile"><div class="tl">BEST</div><div class="tvs" style="color:#2cbc6e;">'+(bestMs?msToTime(bestMs):'—')+'</div></div>';
    html += '<div class="tile"><div class="tl">MEDIA</div><div class="tvs">'+(avgMs?msToTime(avgMs):'—')+'</div></div>';
    html += '<div class="tile"><div class="tl">COSTANZA σ</div><div class="tvs">'+(stdev!==null?stdev.toFixed(3)+'s':'—')+'</div></div>';
    html += '</div><div class="grid">';
    html += '<div class="tile"><div class="tl">🚀 V.MAX</div><div class="tvs" style="color:#d97706;">'+(vmaxVal?vmaxVal+' km/h':'—')+'</div><div class="tsub">'+(vmaxLap?'G'+vmaxLap:'—')+'</div></div>';
    html += '<div class="tile"><div class="tl">V.MEDIA MAX</div><div class="tvs">'+(vmaxAvg?vmaxAvg.toFixed(1)+' km/h':'—')+'</div></div>';
    html += '<div class="tile"><div class="tl">POSIZIONE</div><div class="tv">'+(pos.start||'—')+' → '+(pos.current||'—')+'</div></div>';
    html += '<div class="tile"><div class="tl">CARB. USATO</div><div class="tvs">'+(fuelState.totalUsed?fuelState.totalUsed.toFixed(1)+'L':'—')+'</div></div>';
    html += '</div>';

    // Theoretical / Best sectors
    if(bs.s1 || bs.s2 || bs.s3){
      html += '<h3>Giro Teorico · Settori Migliori</h3>';
      html += '<div class="grid">';
      html += '<div class="tile"><div class="tl">S1 BEST</div><div class="tvs" style="color:#2cbc6e;">'+(bs.s1?fmtSector(bs.s1.ms):'—')+'</div><div class="tsub">'+(bs.s1?'G'+bs.s1.lap:'—')+'</div></div>';
      html += '<div class="tile"><div class="tl">S2 BEST</div><div class="tvs" style="color:#2cbc6e;">'+(bs.s2?fmtSector(bs.s2.ms):'—')+'</div><div class="tsub">'+(bs.s2?'G'+bs.s2.lap:'—')+'</div></div>';
      html += '<div class="tile"><div class="tl">S3 BEST</div><div class="tvs" style="color:#2cbc6e;">'+(bs.s3?fmtSector(bs.s3.ms):'—')+'</div><div class="tsub">'+(bs.s3?'G'+bs.s3.lap:'—')+'</div></div>';
      var theorStr = bs.theorMs ? msToTime(bs.theorMs) : '—';
      var dVsB = (bs.theorMs && bestMs) ? ((bs.theorMs-bestMs)/1000) : null;
      html += '<div class="tile" style="border-left:3px solid #2cbc6e;"><div class="tl">🏁 TEORICO</div><div class="tvs" style="color:#2cbc6e;">'+theorStr+'</div><div class="tsub">'+(dVsB!==null?(dVsB<0?'-':'+')+Math.abs(dVsB).toFixed(3)+'s vs best':'—')+'</div></div>';
      html += '</div>';
    }

    // Progression
    if(prog){
      html += '<h3>Progressione Tempi (primo vs ultimo terzo)</h3>';
      html += '<div class="grid3">';
      html += '<div class="tile"><div class="tl">MEDIA PRIMO TERZO</div><div class="tvs">'+msToTime(prog.avgF)+'</div></div>';
      html += '<div class="tile"><div class="tl">MEDIA ULTIMO TERZO</div><div class="tvs">'+msToTime(prog.avgL)+'</div></div>';
      var pColor = prog.delta<0 ? '#2cbc6e' : (prog.delta>0 ? '#e03030':'#555');
      var pSign = prog.delta>0?'+':(prog.delta<0?'-':'±');
      html += '<div class="tile" style="border-left:3px solid '+pColor+';"><div class="tl">ANDAMENTO</div><div class="tvs" style="color:'+pColor+';">'+pSign+Math.abs(prog.delta).toFixed(3)+'s</div><div class="tsub">'+(prog.delta<-0.1?'📈 in miglioramento':prog.delta>0.1?'📉 in calo':'≈ stabile')+'</div></div>';
      html += '</div>';
    }

    // Stint analysis: groups of consecutive laps divided by pit stops
    // Stints are determined by pit stop laps OR by tyre mounts
    if(laps.length>=3){
      var pitLaps = new Set();
      pitStops.forEach(function(p){ if(p.lap) pitLaps.add(+p.lap); });
      // Also consider tyre history mounts as stint markers
      (tyreState.history||[]).forEach(function(t){ if(t.lapsMounted) pitLaps.add(+t.lapsMounted); });
      if(tyreState.current && tyreState.current.lapsMounted) pitLaps.add(+tyreState.current.lapsMounted);
      var stints = [];
      var current = { laps:[], start:null };
      laps.forEach(function(l){
        if(pitLaps.has(+l.lap) && current.laps.length){
          stints.push(current);
          current = { laps:[l], start:+l.lap };
        } else {
          if(current.start===null) current.start = +l.lap;
          current.laps.push(l);
        }
      });
      if(current.laps.length) stints.push(current);
      if(stints.length>=2){
        html += '<h3>Analisi Stint ('+stints.length+')</h3>';
        // Visual bar
        var totalLs = stints.reduce(function(a,s){return a+s.laps.length;},0);
        var palette = ['#2b7de9','#e8421a','#2cbc6e','#8b5cf6','#f59e0b','#14b8a6','#ec4899','#84cc16'];
        html += '<div class="stint-bar">';
        stints.forEach(function(s,si){
          var w = Math.max(8, s.laps.length/totalLs*100);
          html += '<div class="stint-seg" style="width:'+w+'%;background:'+palette[si%palette.length]+';">#'+(si+1)+' ('+s.laps.length+'L)</div>';
        });
        html += '</div>';
        html += '<table><tr><th>STINT</th><th>GIRI</th><th>RANGE</th><th>BEST</th><th>MEDIA</th><th>DEGRADO</th></tr>';
        stints.forEach(function(s,si){
          var lapMs = s.laps.map(function(l){return parseTime(l.time)||0;}).filter(function(t){return t>0;});
          if(!lapMs.length){ html += '<tr><td class="mono">#'+(si+1)+'</td><td class="mono">'+s.laps.length+'</td><td class="mono">G'+(s.start||'?')+'+</td><td>—</td><td>—</td><td>—</td></tr>'; return; }
          var stBest = Math.min.apply(null, lapMs);
          var stAvg  = lapMs.reduce(function(a,b){return a+b;},0)/lapMs.length;
          // Degrado: media primi 3 vs ultimi 3
          var deg = '—';
          if(lapMs.length>=6){
            var f3 = lapMs.slice(0,3).reduce(function(a,b){return a+b;},0)/3;
            var l3 = lapMs.slice(-3).reduce(function(a,b){return a+b;},0)/3;
            var d = (l3-f3)/1000;
            deg = (d>0?'+':'')+d.toFixed(3)+'s';
          }
          var endLap = s.laps[s.laps.length-1].lap;
          html += '<tr><td class="mono"><span class="cat-dn" style="background:'+palette[si%palette.length]+';">#'+(si+1)+'</span></td><td class="mono">'+s.laps.length+'</td><td class="mono">G'+(s.start||'?')+'→G'+endLap+'</td><td class="mono">'+msToTime(stBest)+'</td><td class="mono">'+msToTime(stAvg)+'</td><td class="mono">'+deg+'</td></tr>';
        });
        html += '</table>';
      }
    }

    // Laps table — with best sectors and vmax highlighted
    if(laps.length){
      html += '<h3>Storico Giri</h3><table><tr><th>G</th><th>TEMPO</th><th>DELTA</th><th>S1</th><th>S2</th><th>S3</th><th>POS</th><th>🚀 V.MAX</th><th>NOTE</th></tr>';
      var bS1 = bs.s1 ? bs.s1.ms : null, bS2 = bs.s2 ? bs.s2.ms : null, bS3 = bs.s3 ? bs.s3.ms : null;
      laps.forEach(function(l) {
        var ms = parseTime(l.time);
        var diff = ms&&bestMs?deltaStr(ms-bestMs):'';
        var isBest = ms&&ms===bestMs;
        var s1ms = parseTime(l.s1), s2ms = parseTime(l.s2), s3ms = parseTime(l.s3);
        var s1C = s1ms && bS1 && s1ms===bS1 ? 'sbest' : '';
        var s2C = s2ms && bS2 && s2ms===bS2 ? 'sbest' : '';
        var s3C = s3ms && bS3 && s3ms===bS3 ? 'sbest' : '';
        var vC = (+l.vmax) && (+l.vmax)===vmaxVal ? 'vmaxbest' : '';
        html += '<tr'+(isBest?' class="best"':'')+'>'+
          '<td class="mono">'+l.lap+'</td>'+
          '<td class="mono">'+(l.time||'—')+'</td>'+
          '<td class="mono" style="color:'+(isBest?'#2cbc6e':diff.startsWith('+')?'#e03030':'#888')+';">'+diff+'</td>'+
          '<td class="mono '+s1C+'">'+(l.s1||'—')+'</td>'+
          '<td class="mono '+s2C+'">'+(l.s2||'—')+'</td>'+
          '<td class="mono '+s3C+'">'+(l.s3||'—')+'</td>'+
          '<td class="mono">'+(l.pos||'—')+'</td>'+
          '<td class="mono '+vC+'">'+(l.vmax?l.vmax+' km/h':'—')+'</td>'+
          '<td style="font-size:9px;">'+(l.note||'')+'</td></tr>';
      });
      html += '</table>';
    }

    // Setup (last one)
    var lastSetup = setups.slice(-1)[0];
    if(lastSetup){
      var fields = {wingF:'Ala Ant.',wingR:'Ala Post.',brakeBias:'Bias Freno %',engMap:'Mappa Motore',springF:'Molla Ant.',springR:'Molla Post.',bumpF:'Bump Ant.',rebF:'Reb Ant.',bumpR:'Bump Post.',rebR:'Reb Post.',camberFL:'Camber FL',camberFR:'Camber FR',camberRL:'Camber RL',camberRR:'Camber RR',toeF:'Toe Ant.',toeR:'Toe Post.',arbF:'Barra Ant.',arbR:'Barra Post.'};
      html += '<h3>Setup (ultimo salvato — giro '+(lastSetup.lap||'—')+')</h3><table>';
      var entries = Object.keys(fields).map(function(k){return {k:k,label:fields[k],val:lastSetup[k]};}).filter(function(e){return e.val!==undefined && e.val!==''&&e.val!==null;});
      html += '<tr><th>PARAMETRO</th><th>VALORE</th><th>PARAMETRO</th><th>VALORE</th></tr>';
      for(var i=0;i<entries.length;i+=2){
        var a=entries[i], b=entries[i+1];
        html += '<tr><td>'+a.label+'</td><td class="mono">'+a.val+'</td>'+(b?'<td>'+b.label+'</td><td class="mono">'+b.val+'</td>':'<td></td><td></td>')+'</tr>';
      }
      html += '</table>';
      if(lastSetup.note) html += '<div class="note-row"><b>Nota setup:</b> '+lastSetup.note+'</div>';
      if(setups.length>1) html += '<div style="font-size:9px;color:#888;">Setup salvati totali: <b>'+setups.length+'</b></div>';
    }

    // Tyres
    var tyreHistory = tyreState.history||[];
    if(tyreState.current || tyreHistory.length){
      html += '<h3>Gomme</h3>';
      if(tyreState.current){
        var tc = tyreState.current;
        html += '<div style="background:#f0f7ff;border:1px solid #b8d4f0;border-radius:4px;padding:6px 10px;margin-bottom:6px;font-size:10px;"><b>Treno corrente:</b> Set '+(tc.set||'—')+' · Km percorsi: <b>'+((tc.km||0).toFixed?tc.km.toFixed(1):tc.km)+' km</b> · Giri dall\'installazione: '+(tc.lapsUsed||((STATE.laps[car.id]||[]).length-(tc.lapsMounted||0)))+(tc.note?' · <i>'+tc.note+'</i>':'')+'</div>';
      }
      if(tyreHistory.length){
        html += '<table><tr><th>SET</th><th>KM</th><th>GIRI</th><th>MONTATO G.</th><th>NOTE</th></tr>';
        tyreHistory.forEach(function(t){
          html += '<tr><td class="mono">'+(t.set||'—')+'</td><td class="mono">'+((t.km||0).toFixed?t.km.toFixed(1):t.km||0)+'</td><td class="mono">'+(t.lapsUsed||0)+'</td><td class="mono">'+(t.lapsMounted||'—')+'</td><td style="font-size:9px;">'+(t.note||'')+'</td></tr>';
        });
        html += '</table>';
      }
    }

    // Fuel log
    if((fuelState.log||[]).length){
      html += '<h3>Carburante — Rifornimenti</h3><table><tr><th>GIRO</th><th>LITRI</th><th>TIPO</th><th>NOTE</th></tr>';
      fuelState.log.forEach(function(f){
        html += '<tr><td class="mono">'+(f.lap||'—')+'</td><td class="mono">'+(f.liters||'—')+'L</td><td>'+(f.type||'—')+'</td><td style="font-size:9px;">'+(f.note||'')+'</td></tr>';
      });
      html += '</table>';
      var totalL = fuelState.log.reduce(function(a,f){return a+(+f.liters||0);},0);
      html += '<div style="font-size:10px;color:#555;">Totale rifornito: <b>'+totalL.toFixed(1)+'L</b> — Consumo medio: <b>'+(fuelState.perLap||0).toFixed(2)+' L/giro</b></div>';
    }

    // Pit stops
    if(pitStops.length){
      html += '<h3>Pit Stop ('+pitStops.length+')</h3><table><tr><th>G</th><th>DURATA</th><th>TIPO</th><th>NOTE</th></tr>';
      var psTotal = 0;
      pitStops.forEach(function(p){
        psTotal += (+p.duration||0);
        html += '<tr><td class="mono">'+(p.lap||'—')+'</td><td class="mono">'+((+p.duration||0).toFixed(3))+'s</td><td>'+(p.type||'—')+'</td><td style="font-size:9px;">'+(p.note||'')+'</td></tr>';
      });
      html += '</table>';
      var avgPs = pitStops.length ? psTotal/pitStops.length : 0;
      html += '<div style="font-size:10px;color:#555;">Tempo totale in pit: <b>'+psTotal.toFixed(3)+'s</b> — Media pit: <b>'+avgPs.toFixed(3)+'s</b></div>';
    }

    // Damages
    if(damages.length){
      html += '<h3>Danni ('+damages.length+')</h3>';
      damages.forEach(function(d){
        html += '<div class="dmg-row"><b>G'+(d.lap||'—')+':</b> '+(d.desc||'—')+(d.severity?' <span style="color:#e03030;font-weight:700;">['+d.severity+']</span>':'')+(d.part?' — parte: '+d.part:'')+'</div>';
      });
    }

    // Telemetry notes
    if(teleNotes.length){
      html += '<h3>Note Telemetria ('+teleNotes.length+')</h3>';
      teleNotes.forEach(function(t){
        html += '<div class="note-row"><b>G'+(t.lap||'—')+':</b> '+(t.note||'—')+'</div>';
      });
    }

    // Driver notes — with category breakdown
    if(driverNotes.length){
      // Categorize
      var byCat = {};
      var byInt = {};
      driverNotes.forEach(function(n){
        var c = n.category||'general';
        byCat[c] = (byCat[c]||0)+1;
        var it = n.intensity||'medium';
        byInt[it] = (byInt[it]||0)+1;
      });
      var catLabels = {understeer:'Sottosterzo',oversteer:'Sovrasterzo',braking:'Freni',traction:'Trazione',balance:'Bilanciamento',vibration:'Vibrazioni',noise:'Rumore',positive:'Positivo',general:'Generale'};
      var intLabels = {light:'Leggera',medium:'Media',heavy:'Forte',critical:'Critica'};
      var catColors = {understeer:'#f59e0b',oversteer:'#ec4899',braking:'#e03030',traction:'#8b5cf6',balance:'#2b7de9',vibration:'#14b8a6',noise:'#94a3b8',positive:'#2cbc6e',general:'#6b7280'};
      html += '<h3>Note Pilota ('+driverNotes.length+') — Distribuzione</h3>';
      html += '<div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;">';
      Object.keys(byCat).sort(function(a,b){return byCat[b]-byCat[a];}).forEach(function(c){
        html += '<span style="background:'+(catColors[c]||'#6b7280')+';color:#fff;padding:3px 8px;border-radius:3px;font-size:10px;"><b>'+byCat[c]+'×</b> '+(catLabels[c]||c)+'</span>';
      });
      html += '</div>';
      html += '<div style="font-size:10px;color:#555;margin-bottom:8px;">Intensità: ';
      Object.keys(byInt).forEach(function(i){
        html += '<span style="margin-right:10px;"><b>'+byInt[i]+'×</b> '+(intLabels[i]||i)+'</span>';
      });
      html += '</div>';
      // Show list
      driverNotes.slice(0,15).forEach(function(n){
        html += '<div class="note-row"><b>G'+(n.lap||'—')+'</b>'+(n.point?' @ '+n.point:'')+' <span style="color:#888;font-size:9px;">['+(catLabels[n.category]||n.category||'—')+' · '+(intLabels[n.intensity]||n.intensity||'—')+']</span>: '+(n.note||'')+(n.response?'<br><i style="color:#555;">→ '+n.response+'</i>':'')+'</div>';
      });
      if(driverNotes.length>15) html += '<div style="font-size:9px;color:#888;">... e altre '+(driverNotes.length-15)+' note</div>';
    }

    html += '</div>'; // car-block
  });

  // Rally stages
  if(STATE.stages.length) {
    html += '<h2>🏞 PROVE SPECIALI — RIEPILOGO PILOTI</h2>';

    // Helper: format ms back to mm:ss.mmm
    var _rfmtMs = function(ms){
      if(!ms || !isFinite(ms) || ms<=0) return '—';
      var min = Math.floor(ms/60000);
      var sec = ((ms%60000)/1000).toFixed(3);
      if(sec.length === 5) sec = '0'+sec;
      return min+':'+sec;
    };

    // ─── Group stages by driverId ────────────────────────
    // Stages without driverId get bucketed under '__no_driver__'
    var stagesByDriver = {};
    STATE.stages.forEach(function(s){
      var did = s.driverId || '__no_driver__';
      if(!stagesByDriver[did]) stagesByDriver[did] = [];
      stagesByDriver[did].push(s);
    });

    // Build a list of driver entries with stats
    var driverEntries = Object.keys(stagesByDriver).map(function(did){
      var stages = stagesByDriver[did];
      var validStages = stages.filter(function(s){return !s.cancelled;});
      var driver = (did === '__no_driver__') ? null : (typeof _drvById === 'function' ? _drvById(did) : null);
      var name = driver ? (driver.name || '?') : '— PS senza pilota assegnato —';
      var num  = driver ? (driver.number || '') : '';

      // Compute best PS time, total km, total time, etc.
      var bestMs = Infinity, bestStage = null, totalMs = 0, totalKm = 0;
      validStages.forEach(function(s){
        var ms = parseTime(s.time);
        if(ms && isFinite(ms)){
          totalMs += ms;
          if(ms < bestMs){ bestMs = ms; bestStage = s; }
        }
        totalKm += (+s.km||0);
      });

      // Average pace (s/km) for the driver across valid stages with km
      var pacedStages = validStages.filter(function(s){var ms=parseTime(s.time); return ms && isFinite(ms) && (+s.km||0) > 0;});
      var avgPace = null;
      if(pacedStages.length){
        var paces = pacedStages.map(function(s){return parseTime(s.time)/1000 / (+s.km||1);});
        avgPace = paces.reduce(function(a,b){return a+b;}, 0) / paces.length;
      }

      return {
        did: did,
        driver: driver,
        name: name,
        number: num,
        stages: stages,
        validStages: validStages,
        bestMs: bestMs,
        bestStage: bestStage,
        totalMs: totalMs,
        totalKm: totalKm,
        avgPace: avgPace,
        cancelledCount: stages.length - validStages.length
      };
    });

    // Sort: drivers first by bestMs (faster on top), then '__no_driver__' last
    driverEntries.sort(function(a,b){
      if(a.did === '__no_driver__') return 1;
      if(b.did === '__no_driver__') return -1;
      return (a.bestMs||Infinity) - (b.bestMs||Infinity);
    });

    // ─── Per-driver block ────────────────────────────────
    driverEntries.forEach(function(e){
      var bestPsLabel = e.bestStage ? ('PS'+e.bestStage.num+(e.bestStage.name?' '+e.bestStage.name:'')) : '—';
      var bestTimeStr = isFinite(e.bestMs) ? _rfmtMs(e.bestMs) : '—';
      var totalTimeStr = e.totalMs ? _rfmtMs(e.totalMs) : '—';
      var paceStr = e.avgPace ? e.avgPace.toFixed(2)+' s/km' : '—';
      var nameTitle = '👤 '+e.name + (e.number ? ' #'+e.number : '');

      html += '<div class="car-block" style="margin-top:10px;">';
      html += '<h3 style="background:#1f2c3f;color:#fff;padding:6px 10px;border-radius:4px;display:inline-block;margin-bottom:8px;">'+nameTitle+'</h3>';

      // Mini-KPI row for the driver
      html += '<div style="display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap;font-size:10px;">';
      html += '<div style="background:#f0f7ff;border:1px solid #b8d4f0;border-radius:4px;padding:4px 8px;"><b>PS valide:</b> '+e.validStages.length+(e.cancelledCount?' (+'+e.cancelledCount+' annullate)':'')+'</div>';
      html += '<div style="background:#e8f5e9;border:1px solid #b3d9b3;border-radius:4px;padding:4px 8px;"><b>Best PS:</b> '+bestTimeStr+' <span style="color:#666;">su '+bestPsLabel+'</span></div>';
      html += '<div style="background:#fff8e1;border:1px solid #f0e0a0;border-radius:4px;padding:4px 8px;"><b>Tempo totale:</b> '+totalTimeStr+'</div>';
      html += '<div style="background:#f8f9fa;border:1px solid #ddd;border-radius:4px;padding:4px 8px;"><b>Km totali:</b> '+e.totalKm.toFixed(1)+' km</div>';
      html += '<div style="background:#f8f9fa;border:1px solid #ddd;border-radius:4px;padding:4px 8px;"><b>Passo medio:</b> '+paceStr+'</div>';
      html += '</div>';

      // Stages table (per driver)
      html += '<table><tr><th>PS</th><th>NOME</th><th>VETTURA</th><th>KM</th><th>TEMPO</th><th>POS ASS</th><th>POS CLS</th><th>NOTE</th></tr>';
      // Sort stages chronologically by num
      var sorted = e.stages.slice().sort(function(a,b){return (+a.num||0)-(+b.num||0);});
      sorted.forEach(function(s){
        var sMs = parseTime(s.time);
        var isBestForDriver = e.bestStage && e.bestStage === s;
        var rowStyle = isBestForDriver ? 'background:#e8f5e9;' : '';
        var timeCell = s.cancelled
          ? '<span style="color:#c00;">ANNULLATA</span>'
          : (s.time||'—') + (isBestForDriver ? ' 🏆' : '');
        html += '<tr style="'+rowStyle+'">'+
          '<td class="mono">PS'+s.num+'</td>'+
          '<td>'+(s.name||'—')+'</td>'+
          '<td style="font-size:9px;">'+(s.car||'—')+'</td>'+
          '<td class="mono">'+((+s.km||0).toFixed(1))+'km</td>'+
          '<td class="mono">'+timeCell+'</td>'+
          '<td>'+(s.absPos||'—')+'</td>'+
          '<td>'+(s.clsPos||'—')+'</td>'+
          '<td style="font-size:9px;">'+(s.note||'')+'</td>'+
        '</tr>';
      });
      html += '</table>';
      html += '</div>';
    });

    // ─── Classifica generale: best PS time per driver ────
    // Solo piloti con almeno una PS valida cronometrata
    var rankList = driverEntries.filter(function(e){return e.did !== '__no_driver__' && isFinite(e.bestMs);});
    if(rankList.length >= 1){
      html += '<h2>🏆 CLASSIFICA BEST PS — TUTTI I PILOTI</h2>';
      html += '<p style="font-size:10px;color:#666;margin-bottom:6px;">Confronto del miglior tempo PS di ogni pilota (ordinato dal più veloce). Il leader è il pilota col best assoluto.</p>';
      html += '<table><tr><th>POS</th><th>PILOTA</th><th>VETTURA</th><th>BEST PS</th><th>SU</th><th>GAP LEADER</th><th>PS FATTE</th></tr>';
      var leaderMs = rankList[0].bestMs;
      rankList.forEach(function(e, i){
        var gap = (i === 0) ? 'LEADER' : '+'+((e.bestMs - leaderMs)/1000).toFixed(3)+'s';
        var gapStyle = (i === 0) ? 'color:#28a745;font-weight:700;' : 'color:#c00;';
        var medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : '';
        var pos = (i+1) + (medal?' '+medal:'');
        var carName = e.bestStage ? (e.bestStage.car||'—') : '—';
        var bestPsLabel = e.bestStage ? ('PS'+e.bestStage.num+(e.bestStage.name?' '+e.bestStage.name:'')) : '—';
        html += '<tr'+(i===0?' style="background:#e8f5e9;font-weight:700;"':'')+'>'+
          '<td class="mono">'+pos+'</td>'+
          '<td>'+e.name+(e.number?' #'+e.number:'')+'</td>'+
          '<td style="font-size:10px;">'+carName+'</td>'+
          '<td class="mono">'+_rfmtMs(e.bestMs)+'</td>'+
          '<td style="font-size:10px;">'+bestPsLabel+'</td>'+
          '<td class="mono" style="'+gapStyle+'">'+gap+'</td>'+
          '<td class="mono">'+e.validStages.length+'</td>'+
        '</tr>';
      });
      html += '</table>';
    }

    // ─── Classifica per singola PS: best per ogni PS ─────
    // Per ciascun numero PS, mostriamo chi è andato più veloce
    var stagesByNum = {};
    STATE.stages.forEach(function(s){
      if(s.cancelled) return;
      var ms = parseTime(s.time);
      if(!ms || !isFinite(ms)) return;
      if(!stagesByNum[s.num]) stagesByNum[s.num] = [];
      stagesByNum[s.num].push({ stage: s, ms: ms });
    });
    var psKeys = Object.keys(stagesByNum).sort(function(a,b){return (+a)-(+b);});
    if(psKeys.length){
      html += '<h2>📊 BEST PER OGNI PROVA SPECIALE</h2>';
      html += '<p style="font-size:10px;color:#666;margin-bottom:6px;">Per ogni PS, classifica dei piloti che l\'hanno fatta dal più veloce al più lento.</p>';
      psKeys.forEach(function(k){
        var arr = stagesByNum[k].slice().sort(function(a,b){return a.ms - b.ms;});
        var firstName = arr[0].stage.name || '';
        html += '<h3 style="margin-top:10px;">PS'+k+(firstName?' — '+firstName:'')+'</h3>';
        html += '<table><tr><th>POS</th><th>PILOTA</th><th>VETTURA</th><th>TEMPO</th><th>GAP BEST</th></tr>';
        var leaderMs2 = arr[0].ms;
        arr.forEach(function(r, i){
          var did = r.stage.driverId;
          var drv = did ? (typeof _drvById === 'function' ? _drvById(did) : null) : null;
          var pname = drv ? (drv.name||'?') : '— pilota n.d. —';
          var gap = i === 0 ? 'BEST' : '+'+((r.ms - leaderMs2)/1000).toFixed(3)+'s';
          var gapStyle = (i === 0) ? 'color:#28a745;font-weight:700;' : 'color:#c00;';
          var medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : '';
          html += '<tr'+(i===0?' style="background:#e8f5e9;"':'')+'>'+
            '<td class="mono">'+(i+1)+(medal?' '+medal:'')+'</td>'+
            '<td>'+pname+(drv && drv.number?' #'+drv.number:'')+'</td>'+
            '<td style="font-size:10px;">'+(r.stage.car||'—')+'</td>'+
            '<td class="mono">'+(r.stage.time||'—')+'</td>'+
            '<td class="mono" style="'+gapStyle+'">'+gap+'</td>'+
          '</tr>';
        });
        html += '</table>';
      });
    }
  }

  // Competitors (if any)
  if(typeof _competitors!=='undefined' && _competitors.length){
    html += '<h2>🏁 AVVERSARI ('+_competitors.length+')</h2>';
    // Group by category
    var cg = {};
    _competitors.forEach(function(c){
      var k = c.cls||'— Senza categoria —';
      if(!cg[k]) cg[k]=[];
      cg[k].push(c);
    });
    Object.keys(cg).sort().forEach(function(cat){
      html += '<h3>'+cat+' ('+cg[cat].length+')</h3><table><tr><th>#</th><th>NOME</th><th>BEST</th><th>GIRI INSERITI</th><th>GAP LEADER</th></tr>';
      var arr = cg[cat].map(function(c){
        var b = c.laps.length ? Math.min.apply(null, c.laps.map(parseTime).filter(function(t){return t&&isFinite(t);})) : Infinity;
        return {c:c,b:b};
      }).sort(function(a,b){return a.b-b.b;});
      var leader = arr[0].b;
      arr.forEach(function(r,i){
        var gap = isFinite(r.b)&&isFinite(leader)&&i>0?'+'+((r.b-leader)/1000).toFixed(3)+'s':(i===0?'LEADER':'—');
        html += '<tr><td class="mono">'+(i+1)+'</td><td>'+r.c.name+'</td><td class="mono">'+(isFinite(r.b)?msToTime(r.b):'—')+'</td><td class="mono">'+r.c.laps.length+'</td><td class="mono">'+gap+'</td></tr>';
      });
      html += '</table>';
    });

    // Combined ranking mie vetture + avversari per categoria (only cats with both)
    html += '<h3>🏆 Classifica Combinata (Mie vetture + Avversari)</h3>';
    var combined = {};
    allCars.forEach(function(c){
      var b = getBestLapMs(c.id);
      var k = (c.category||c.type||'— Senza cat. —').trim();
      if(!combined[k]) combined[k] = [];
      combined[k].push({ name:c.name, best:b||Infinity, isMine:true, color:c.color||'#e8421a' });
    });
    _competitors.forEach(function(c){
      var b = c.laps.length ? Math.min.apply(null, c.laps.map(parseTime).filter(function(t){return t&&isFinite(t);})) : Infinity;
      var k = (c.cls||'— Senza cat. —').trim();
      if(!combined[k]) combined[k] = [];
      combined[k].push({ name:c.name, best:b, isMine:false, color:c.color||'#8b5cf6' });
    });
    Object.keys(combined).sort().forEach(function(k){
      var arr = combined[k];
      if(!arr.some(function(e){return !e.isMine;})) return; // skip cats without competitors
      arr.sort(function(a,b){return a.best-b.best;});
      var leaderMs = arr[0].best;
      html += '<h4 style="font-size:11px;color:#555;margin-top:10px;">'+k+'</h4>';
      html += '<table><tr><th>#</th><th>NOME</th><th>BEST</th><th>GAP LEADER</th></tr>';
      arr.forEach(function(e,i){
        var gap = isFinite(e.best)&&isFinite(leaderMs)&&i>0 ? '+'+((e.best-leaderMs)/1000).toFixed(3)+'s' : (i===0?'LEADER':'—');
        html += '<tr style="'+(e.isMine?'background:#fdf4ef;':'')+'"><td class="mono">'+(i+1)+'</td><td>'+e.name+(e.isMine?' <span class="retired-tag" style="background:#e8421a;">TUA</span>':'')+'</td><td class="mono">'+(isFinite(e.best)?msToTime(e.best):'—')+'</td><td class="mono">'+gap+'</td></tr>';
      });
      html += '</table>';
    });
  }

  // ─── METEO DETTAGLIATO (only complete) ───────────────────────────
  if(type === 'complete' && meteoExtra){
    html += '<h2>🌦 METEO DETTAGLIATO</h2>'+meteoExtra;
  }

  // ─── PHOTOS (only complete) ──────────────────────────────────────
  if(type === 'complete'){
    var photoSections = [
      { key:'tyre',         title:'📷 FOTO GOMME PISTA' },
      { key:'damage',       title:'📷 FOTO DANNI PISTA' },
      { key:'rally-tyre',   title:'📷 FOTO GOMME RALLY' },
      { key:'rally-damage', title:'📷 FOTO DANNI RALLY' }
    ];
    photoSections.forEach(function(sec){
      // Gather all photos in this category across cars
      var photosForCat = [];
      Object.keys(photosByCarCategory).forEach(function(k){
        if(k.indexOf(sec.key+'|') === 0){
          photosForCat = photosForCat.concat(photosByCarCategory[k]);
        }
      });
      if(!photosForCat.length) return;
      photosForCat.sort(function(a,b){return (b.timestamp||0)-(a.timestamp||0);});
      // Limit to most recent 12 photos per category to keep PDF manageable
      photosForCat = photosForCat.slice(0, 12);
      html += '<h2>'+sec.title+' ('+photosForCat.length+')</h2>';
      html += '<div class="photo-grid">';
      photosForCat.forEach(function(p){
        var when = p.timestamp ? new Date(p.timestamp).toLocaleString('it-IT',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '';
        var lblPart = p.label ? '<b>'+p.label+'</b><br>' : '';
        html += '<div class="photo-card">'+
          '<img src="'+(p.thumb||'')+'" alt="">'+
          '<div class="cap">'+lblPart+
            (p.carId ? p.carId+' · ' : '')+when+
            (p.note ? '<br>'+p.note : '')+
          '</div>'+
        '</div>';
      });
      html += '</div>';
    });
  }

  html += '<div class="footer">Race Engineer Pro · Report '+(type==='quick'?'QUICK':type==='complete'?'COMPLETO':'STANDARD')+' generato il '+now+' · Premi <b>Ctrl+P</b> per salvare come PDF</div></body></html>';
  var w = window.open('','_blank');
  if(w){ w.document.write(html); w.document.close(); setTimeout(function(){w.print();},800); }
  showToast('✅ Report '+(type==='quick'?'rapido':type==='complete'?'completo':'standard')+' aperto · Ctrl+P → Salva PDF');
}


