var SA_SECT_TYPES={ fast:'Veloce', mixed:'Misto', slow:'Lento/stretto', bumpy:'Sconnesso' };
var SA_SECT_FOCUS={
  fast:'curve veloci e aero (ali, appoggio alta velocità)',
  mixed:'percorrenza (barre, bilancio meccanico)',
  slow:'trazione, curve strette e frenata (diff, barra post, bias)',
  bumpy:'assorbimento (damper, molle, altezze)'
