// Format ms to "m:ss.mmm"
function _drvFmtMs(ms){
  if(!ms||!isFinite(ms)||ms<=0) return '—';
  var min = Math.floor(ms/60000);
  var sec = ((ms%60000)/1000).toFixed(3);
  if(sec.length === 5) sec = '0'+sec;
  return min+':'+sec;
}

// Compute learning-curve stats for a single driver
function _drvComputeStats(driverId){
  // Collect ALL their laps across all cars (track + rally implicit via stages — but stages are different shape)
  var allCars = [].concat(STATE.trackCars||[], STATE.rallyCars||[]);
  var laps = [];
  allCars.forEach(function(car){
    (STATE.laps[car.id]||[]).forEach(function(l){
      if((l.driverId||'') === (driverId||'')){
        var ms = parseTime(l.time);
        if(ms && isFinite(ms)){
          laps.push({ ms: ms, lap: l.lap, session: l.session, car: car.name, ts: l.ts||0, note: l.note||'' });
        }
      }
    });
  });
  // Sort chronologically by ts (or by index added if no ts)
  laps.sort(function(a,b){
    if(a.ts && b.ts) return a.ts - b.ts;
    return 0;
  });
  if(!laps.length) return null;
  var times = laps.map(function(l){return l.ms;});
  var firstTime = times[0];
  var lastTime = times[times.length-1];
  var bestTime = Math.min.apply(null, times);
  var worstTime = Math.max.apply(null, times);
  var avg = times.reduce(function(a,b){return a+b;},0)/times.length;
  // Improvement: last vs first
  var improvement = firstTime - lastTime; // positive = improved
  // Consistency: stddev
  var variance = times.reduce(function(s,v){return s+(v-avg)*(v-avg);},0)/times.length;
  var stddev = Math.sqrt(variance);
  var cv = (stddev/avg)*100;

  // Group by session to find session-by-session evolution
  var bySession = {};
  laps.forEach(function(l){
    var s = l.session || 'sess';
    if(!bySession[s]) bySession[s] = [];
    bySession[s].push(l);
  });
  var sessions = Object.keys(bySession);
  // Per session: best, avg
  var sessionStats = sessions.map(function(s){
    var ts = bySession[s].map(function(l){return l.ms;});
    return {
      session: s,
      best: Math.min.apply(null, ts),
      avg: ts.reduce(function(a,b){return a+b;},0)/ts.length,
      count: ts.length,
      firstLap: bySession[s][0],
      lastLap: bySession[s][bySession[s].length-1]
    };
  });

  // Warm-up time: how many laps until best lap of session is reached?
  // We compute average over all sessions: in session N, best is reached at lap K (relative position in session)
  var warmupLaps = sessionStats.map(function(ss){
    var sLaps = bySession[ss.session];
    var bestIdx = 0, bestMs = sLaps[0].ms;
    for(var i=1;i<sLaps.length;i++){
      if(sLaps[i].ms < bestMs){ bestMs = sLaps[i].ms; bestIdx = i; }
    }
    return bestIdx + 1; // 1-based: in lap N of the session
  }).filter(function(n){return n>0;});
  var avgWarmup = warmupLaps.length ? warmupLaps.reduce(function(a,b){return a+b;},0)/warmupLaps.length : null;

  return {
    laps: laps,
    totalLaps: laps.length,
    firstTime: firstTime,
    lastTime: lastTime,
    bestTime: bestTime,
    worstTime: worstTime,
    avg: avg,
    stddev: stddev,
    cv: cv,
    improvement: improvement,
    improvementPct: firstTime ? (improvement/firstTime*100) : 0,
    sessionStats: sessionStats,
    avgWarmup: avgWarmup,
    sessionsCount: sessions.length
  };
}

