    '.bal{display:flex;align-items:center;gap:8px;margin:3px 0} .balbar{flex:1;height:10px;background:linear-gradient(90deg,#9db8e8,#e8e8e8 45%,#e8e8e8 55%,#e8a1a1);border:1px solid #999;border-radius:5px;position:relative}'+
    '.mark{position:absolute;top:-3px;width:4px;height:14px;background:#111}'+
    '.warn{background:#fff6d8;border:1px solid #d9c46a;padding:6px 10px;font-size:11px;margin-top:4px}'+
    '.foot{margin-top:18px;color:#777;font-size:10px;border-top:1px solid #ccc;padding-top:6px}'+
    '.noprint button{padding:8px 16px;font-size:13px} @media print{.noprint{display:none}}'+
    '</style></head><body>'+
    '<h1>REPORT SETUP — '+esc3(car.name)+'</h1>'+
    '<div class="meta">'+now+' · '+(mode==='rally'?'RALLY':'PISTA')+' · '+esc3(circuito)+
    (sheetName? ' · scheda "'+esc3(sheetName)+'"':'')+
    (ctx? ' · trazione '+ctx.p.drive+(ctx.pmodeGeneric? ' · <b>PARAMETRI GENERICI</b>':''):'')+' · Race Engineer Pro / Setup Analyzer</div>';

    // valori setup (solo compilati)
    h+='<h2>ASSETTO INSERITO</h2><div class="grid"><table><tbody>';
    var form=saEntryFromForm(mode);
    var defs=saFieldDefs(mode);
    var rows=[], half;
    defs.forEach(function(fd){
      var v=form[fd[0]];
      if(v!==undefined && v!==null && String(v).trim()!=='') rows.push('<tr><td>'+esc3(fd[1])+'</td><td class="mono"><b>'+esc3(v)+'</b></td></tr>');
    });
    // voci extra s2_ presenti nel dom
    if(window._sa2FieldDefs){
      window._sa2FieldDefs.forEach(function(fd){
        var el=document.getElementById((mode==='rally'?'r-':'')+fd[0].replace(/^s2_/,''));
        if(el && el.value!=='') rows.push('<tr><td>'+esc3(fd[1])+'</td><td class="mono"><b>'+esc3(el.value)+'</b></td></tr>');
      });
    }
    half=Math.ceil(rows.length/2);
    h+=rows.slice(0,half).join('')+'</tbody></table><table><tbody>'+rows.slice(half).join('')+'</tbody></table></div>';
    if(!rows.length) h+='<div class="meta">Nessun campo compilato.</div>';

    if(A){
      // bilanciamento per fase
      h+='<h2>BILANCIAMENTO PER FASE (modello v6 — carichi per ruota, ellisse d’attrito)</h2>';
      [['INGRESSO (freno+laterale)',A.phases.entry.U,0.35],['PERCORRENZA',A.phases.mid.U,0.12],['USCITA (gas+laterale)',A.phases.exit.U,0.35]].forEach(function(x){
        var pctPos=50+50*Math.max(-1,Math.min(1,x[1]/x[2]));
        var cl=saClassifyU(x[1]);
        h+='<div class="bal"><div style="width:200px">'+x[0]+'</div><div class="balbar"><div class="mark" style="left:'+pctPos.toFixed(0)+'%"></div></div><div style="width:190px"><b>'+cl.txt+'</b> ('+(x[1]*100).toFixed(1)+' pt)</div></div>';
      });
      h+='<div class="meta">Camber dinamico in percorrenza: ant '+(A.camDynF!==null?A.camDynF.toFixed(1)+'°':'—')+' / post '+(A.camDynR!==null?A.camDynR.toFixed(1)+'°':'—')+' · rollio '+ (A.rollGrad*(A.bMid.ay/9.81)).toFixed(1)+'°</div>';
      // metriche
      h+='<h2>METRICHE</h2><table><tbody>'+
      '<tr><td>V max (limite '+A.limiter+')</td><td class="mono">'+(A.vmax*3.6).toFixed(1)+' km/h</td>'+
      '<td>Cambio</td><td class="mono">'+(A.gear? A.gear.n+' marce · '+(A.gear.vTop*3.6).toFixed(0)+' km/h' : 'rapporti n.d.')+'</td></tr>'+
      '<tr><td>Trazione max (asse '+(ctx.p.drive)+')</td><td class="mono">'+(A.axMax/9.81).toFixed(2)+' g</td>'+
      '<td>TLLTD anteriore</td><td class="mono">'+(A.tlltd*100).toFixed(1)+'%</td></tr>'+
      '<tr><td>Rollio</td><td class="mono">'+A.rollGrad.toFixed(2)+' °/g</td>'+
      '<td>Ride freq F/R</td><td class="mono">'+A.rideFreqF.toFixed(2)+' / '+A.rideFreqR.toFixed(2)+' Hz</td></tr>'+
      '<tr><td>ζ medio damper</td><td class="mono">'+(A.zetaAvg!==null?A.zetaAvg.toFixed(2):'—')+'</td>'+
      '<td>Massa · ρ aria</td><td class="mono">'+ctx.p.m.toFixed(0)+' kg · '+(window.SA_RHO||1.225).toFixed(3)+'</td></tr></tbody></table>';
      // confronto baseline
      if(C){
        var calF=(ctx.cal&&ctx.cal.n>=2)? ctx.cal.factor:1;
        h+='<h2>VS ULTIMO SETUP SALVATO ('+esc3(baseLabel)+')</h2>'+
        '<div>Δt previsto: <b>'+(C.total*calF>=0?'+':'')+(C.total*calF).toFixed(3)+' ± '+(C.uncertainty*Math.max(1,calF)).toFixed(3)+' s</b>'+(calF!==1? ' (calibrazione ×'+calF.toFixed(2)+')':'')+'</div>'+
        '<table><thead><tr><th>ZONA</th><th>Δt</th><th>NOTE</th></tr></thead><tbody>'+
        C.zones.map(function(z){ return '<tr><td>'+z.label+'</td><td class="mono">'+(z.dt>=0?'+':'')+z.dt.toFixed(3)+'s</td><td>'+esc3(z.note)+(z.warn? ' ⚠ '+esc3(z.warn):'')+'</td></tr>'; }).join('')+
        '</tbody></tbody></table>';
      }
      // gomme
      if(ctx.tyres && ctx.tyres.html){
        h+='<h2>GOMME (rilievi)</h2><div style="font-size:11px">'+ctx.tyres.html.replace(/class="small"/g,'')+'</div>';
      }
      // avvisi
      var warns=saWarnings(A, C, ctx.p, ctx.surf, ctx.cur);
      if(warns.length){
        h+='<h2>AVVISI</h2>';
        warns.forEach(function(wn){ h+='<div class="warn">⚠ '+esc3(wn)+'</div>'; });
      }
    } else {
      h+='<div class="meta">Analisi fisica disattivata: report dei soli valori inseriti.</div>';
    }
    h+='<div class="foot">Modello: Milliken RCVD · Seward Race Car Design · Guiggiani Dinamica del Veicolo · Smith Tune to Win — prime approssimazioni dichiarate, verificare in pista una modifica alla volta.</div>';
    h+='<div class="noprint" style="margin-top:14px"><button onclick="window.print()">🖨 STAMPA / SALVA PDF (Ctrl+P)</button></div>';
    h+='</body></html>';
    var wn2=window.open('','_blank','width=860,height=980');
    if(!wn2){ if(typeof showToast==='function') showToast('⚠ Popup bloccato: abilita i popup per il report'); return; }
    wn2.document.write(h); wn2.document.close();
  } catch(e){ if(typeof showToast==='function') showToast('Errore report: '+e.message); }
};

