  }).join('')+'</div>';
  // migliori settori e giro ideale
  var best={s1:null,s2:null,s3:null}, bestLap=null, bestLapObj=null;
  laps.forEach(function(l){
    ['s1','s2','s3'].forEach(function(s){
      var t=parseTime(l[s]);
      if(t && (best[s]===null||t<best[s])) best[s]=t;
    });
    var lt=parseTime(l.time);
    if(lt && (bestLap===null||lt<bestLap)){ bestLap=lt; bestLapObj=l; }
  });
  if(!bestLap || best.s1===null || best.s2===null || best.s3===null){
    return html+'<div class="small" style="color:var(--yellow)">Servono giri con i tempi settore compilati (S1/S2/S3 nella pagina Tempi Giro).</div>';
  }
  var ideal=best.s1+best.s2+best.s3;
  var rows='', worst=null, worstGap=0;
  ['s1','s2','s3'].forEach(function(s,i){
    var inBest=parseTime(bestLapObj[s]);
    var gap=inBest!==null? (inBest-best[s])/1000 : null;
    if(gap!==null && gap>worstGap){ worstGap=gap; worst={sec:'S'+(i+1), type:cfg[s], gap:gap}; }
    rows+='<tr><td>S'+(i+1)+' ('+SA_SECT_TYPES[cfg[s]]+')</td><td class="mono">'+(best[s]/1000).toFixed(3)+'</td>'+
      '<td class="mono">'+(inBest!==null?(inBest/1000).toFixed(3):'—')+'</td>'+
      '<td class="mono" style="color:'+(gap>0.05?'var(--red)':'var(--green)')+'">'+(gap!==null? '+'+gap.toFixed(3):'—')+'</td></tr>';
  });
  html+='<table class="data-table" style="font-size:11px"><thead><tr><th>SETTORE</th><th>BEST ASSOLUTO</th><th>NEL TUO BEST LAP</th><th>GAP</th></tr></thead><tbody>'+rows+'</tbody></table>';
  html+='<div class="small" style="margin-top:6px">Giro ideale (somma best settori): <b class="mono">'+msToStr(ideal)+'</b> · tuo best: <b class="mono">'+msToStr(bestLap)+'</b> · margine <b style="color:var(--teal)">'+((bestLap-ideal)/1000).toFixed(3)+' s</b></div>';
  if(worst && worst.gap>0.03){
    html+='<div class="small" style="margin-top:6px;padding:8px;background:var(--bg3);border-radius:6px">🎯 Perdi di più in <b>'+worst.sec+'</b> (settore '+SA_SECT_TYPES[worst.type].toLowerCase()+', +'+worst.gap.toFixed(3)+'s): lavora su <b>'+SA_SECT_FOCUS[worst.type]+'</b>. '+
      '<button class="btn btn-gray" style="font-size:9px;padding:2px 6px" onclick="saSectWeight(\''+worst.type+'\')">PESA IL PROFILO SU QUESTO SETTORE</button></div>';
  }
  return html;
}
