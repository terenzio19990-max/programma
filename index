function saOutputHTML(mode, car, A, B, C, p, surf, prof, refMs, baseLabel, ctx){
  var calF=(ctx&&ctx.cal&&ctx.cal.n>=2)? ctx.cal.factor : 1;
  var html = '';
  var driveBadge = '<span class="sa-drive" title="asse motrice — cambia in ⚙ PARAMETRI">'+p.drive+' · TRAZIONE '+SA_DRIVES[p.drive]+'</span>';
  if(ctx && ctx.pmodeGeneric) driveBadge += ' <span class="sa-drive" style="color:var(--yellow);border-color:var(--yellow)" title="Stai usando i default del tipo vettura: i delta sono indicativi, i valori assoluti poco affidabili. Inserisci i dati reali in ⚙ quando li hai.">PARAMETRI GENERICI</span>';
  if(C){
    var dUm = (C.dU.low+C.dU.mid+C.dU.high)/3;
    var vtxt, vcol;
    if(Math.abs(dUm)<0.005){ vtxt='BILANCIAMENTO INVARIATO'; vcol='var(--text2)'; }
    else if(dUm>0){ vtxt='PIÙ SOVRASTERZANTE'; vcol='var(--red)'; }
    else { vtxt='PIÙ SOTTOSTERZANTE'; vcol='var(--blue)'; }
    var tcol = C.total<-0.005? 'var(--green)' : (C.total>0.005? 'var(--red)':'var(--text2)');
    html += '<div class="sa-verdict">' +
      '<div>'+driveBadge+'<br><span class="sa-vmain" style="color:'+vcol+'">'+vtxt+'</span> <span class="small">vs '+esc(baseLabel)+' ('+fmtSigned(dUm*100,1)+' pt medi)</span></div>' +
      '<div class="sa-vtime" style="color:'+tcol+'">Δt stimato: <b>'+fmtSigned(C.total*calF,3)+' ± '+(C.uncertainty*Math.max(1,calF)).toFixed(3)+' s</b>'+(calF!==1? ' <span class="small">cal.×'+calF.toFixed(2)+'</span>':'') +
      '<span class="small"> su '+(refMs? msToStr(refMs)+' (tuo miglior tempo)' : fmt(prof.lapSec,0)+' s (tempo tipico — nessun riferimento registrato)')+'</span></div>' +
    '</div>';
  } else {
    html += '<div class="sa-verdict"><div>'+driveBadge+'<br><span class="small">Nessun setup salvato per <b>'+esc(car.name)+'</b>: analisi assoluta dei valori attuali. Salva un setup per vedere i delta.</span></div></div>';
  }
  if(ctx && ctx.baseGaps && ctx.baseGaps.length){
    html += '<div class="small" style="color:var(--yellow);margin-bottom:6px">⚠ La baseline non ha questi campi (delta neutralizzato, ereditano il valore attuale): '+ctx.baseGaps.join(', ')+'. Salva un setup completo per confronti pieni.</div>';
  }
  html += '<div class="sa-sec" title="Carichi per ruota + ellisse d’attrito: in ingresso il freno consuma grip (bias incluso), in uscita la trazione consuma l’asse motrice (diff incluso). Metodo Guiggiani cap.3 / Seward cap.5 / Milliken.">BILANCIAMENTO PER FASE DI CURVA (carichi per ruota + ellisse d’attrito)</div>';
  html += saBalBarHTML('INGRESSO (freno+laterale)',   A.phases.entry.U, B? B.phases.entry.U : null, 0.35);
  html += saBalBarHTML('PERCORRENZA (laterale puro)', A.phases.mid.U,   B? B.phases.mid.U : null, 0.12);
  html += saBalBarHTML('USCITA (gas+laterale)',       A.phases.exit.U,  B? B.phases.exit.U : null, 0.35);
  function cornerRow(nome, b, vKmh){
    var v=vKmh/3.6, R=b.ay>0.5? v*v/b.ay : 0;
    return saBalBarHTML(nome+' ~R'+R.toFixed(0)+'m @'+vKmh+' km/h · <b>'+(b.ay/9.81).toFixed(2)+'g</b>', b.U, null, 0.12);
  }
  html += '<div class="sa-sec" title="Bilanciamento in percorrenza per raggio di curva: R=v²/ay col grip attuale. Se la g ti sembra bassa, tara l’aderenza in ⚙ (Aderenza gomma ×) o col FIT GRIP nel box CALIBR.">PER TIPO DI CURVA (raggio · velocità · g laterale max)</div>';
  html += cornerRow('Stretta', A.bLow, surf.vLow);
  html += cornerRow('Media',   A.bMid, surf.vMid);
  html += cornerRow('Veloce',  A.bHigh, surf.vHigh);
  html += '<div class="small" style="opacity:.7;margin:2px 0 4px">Camber dinamico in percorrenza: ant '+(A.camDynF!==null?A.camDynF.toFixed(1)+'°':'—')+' post '+(A.camDynR!==null?A.camDynR.toFixed(1)+'°':'—')+' (rollio '+fmt(A.rollGrad*(A.bMid.ay/9.81),1)+'°) · aderenza gomma ×'+fmt(p.muGrip||1,2)+'</div>';
  html += saCoherenceHTML(mode, A, ctx);

  // cambio
  var gearHTML, gearTitle='';
  if(A.gear){
    var names=['1ª','2ª','3ª','4ª','5ª','6ª','7ª','8ª'];
    gearTitle = A.gear.per.map(function(v,i){ return names[i]+' '+(v*3.6).toFixed(0)+' km/h'; }).join(' · ');
    gearHTML = A.gear.n+' marce · '+fmt(A.gear.vTop*3.6,0)+' km/h a '+p.rpmMax+' rpm';
  } else {
    gearHTML = '<span class="small">rapporti non inseriti (⚙ PARAMETRI o scheda vettura)</span>';
  }
  html += '<div class="sa-metrics">';
  html += '<div class="sa-met"><div class="sa-mlab">V max (limite: '+A.limiter+')</div><div class="sa-mval">'+fmt(A.vmax*3.6,1)+' km/h'+ (C? ' <span class="small">('+fmtSigned(C.dVmaxPct,2)+'%)</span>':'') + (p.vmaxDecl>0? ' <span class="small">dich. '+p.vmaxDecl+'</span>':'') +'</div></div>';
  html += '<div class="sa-met" title="'+gearTitle+'"><div class="sa-mlab">Cambio</div><div class="sa-mval">'+gearHTML+'</div></div>';
  html += '<div class="sa-met"><div class="sa-mlab">Trazione 0-100 (asse '+SA_DRIVES[p.drive].toLowerCase()+')</div><div class="sa-mval">'+fmt(A.axMax/9.81,2)+' g max</div></div>';
  html += '<div class="sa-met"><div class="sa-mlab">Downforce @'+surf.vHigh+'</div><div class="sa-mval">'+fmt(0.5*(window.SA_RHO||1.225)*Math.pow(surf.vHigh/3.6,2)*(A.ClAf+A.ClAr),0)+' N <span class="small">'+(A.aeroBalF!==null? fmt(A.aeroBalF*100,0)+'% ant.':'')+'</span></div></div>';
  html += '<div class="sa-met"><div class="sa-mlab">TLLTD (trasf. ant.)</div><div class="sa-mval">'+fmt(A.tlltd*100,1)+'%'+(B&&Math.abs(A.tlltd-B.tlltd)>0.0005? ' <span class="small">('+fmtSigned((A.tlltd-B.tlltd)*100,1)+' pt)</span>':'')+'</div></div>';
  html += '<div class="sa-met"><div class="sa-mlab">Rollio</div><div class="sa-mval">'+fmt(A.rollGrad,2)+' °/g</div></div>';
  html += '<div class="sa-met"><div class="sa-mlab">Ride freq F/R</div><div class="sa-mval">'+fmt(A.rideFreqF,2)+' / '+fmt(A.rideFreqR,2)+' Hz</div></div>';
  html += '<div class="sa-met"><div class="sa-mlab">ζ medio damper</div><div class="sa-mval">'+(A.zetaAvg!==null? fmt(A.zetaAvg,2):'—')+' <span class="small">(ott. '+surf.zetaOpt+')</span></div></div>';
  html += '<div class="sa-met"><div class="sa-mlab">Massa · aria</div><div class="sa-mval">'+fmt(p.m,0)+' kg'+(ctx&&ctx.fuelL? ' <span class="small">(con '+fmt(ctx.fuelL,0)+' l)</span>':'')+' · ρ '+fmt((window.SA_RHO||1.225),3)+'</div></div>';
  html += '</div>';
  if(ctx&&ctx.tyres&&(ctx.tyres.camOptF!==null||ctx.tyres.camOptR!==null)){
    html += '<div class="small" style="margin-top:4px;color:var(--teal)">🌡 Ottimi camber dai TUOI rilievi gomme: ant. '+(ctx.tyres.camOptF!==null?surf.camOptF+'°':'—')+' / post. '+(ctx.tyres.camOptR!==null?surf.camOptR+'°':'—')+' (sostituiscono i teorici).</div>';
  }
  if(A.gear){
    html += '<div class="small" style="margin-top:4px;opacity:.85">Velocità per marcia @'+p.rpmMax+' rpm: '+gearTitle+'</div>';
  }
  if(C){
    html += '<div class="sa-sec">DOVE GUADAGNI / PERDI (verde = più veloce)</div>';
    html += saZonesHTML(C.zones);
  }
  var warns = saWarnings(A, C, p, surf, saReadFields(mode));
  if(warns.length){
    html += '<div class="sa-sec">⚠ AVVISI</div><ul class="sa-warns">';
    warns.forEach(function(w){ html += '<li>'+w+'</li>'; });
    html += '</ul>';
  }
  return html;
}

window.saRender = function(mode){
  var out = document.getElementById('sa-out-'+mode);
  if(!out) return;
  var car = saCar(mode);
  if(!car){ out.innerHTML=''; return; }
  var pmSel=document.getElementById('sa-pmode-'+mode);
  if(pmSel && pmSel.value!==saPMode(mode)) pmSel.value=saPMode(mode);
  if(saPMode(mode)==='off'){
    out.innerHTML='<div class="small" style="padding:10px;color:var(--text3)">Analisi fisica disattivata per questa modalità — riattivala dal selettore "Parametri vettura" qui sopra. I campi del setup restano pienamente utilizzabili.</div>';
    try { saUpdateDiffVisibility(mode); } catch(eOff){}
    return;
  }
  var ctx = saCtx(mode);
  ctx.cal = saCalResolve(mode, car);
  var hist = saHistory(mode, car.id);
  var sel = document.getElementById('sa-base-'+mode);
  var selVal = sel? sel.value : '';
  if(sel){
    var opts = '';
    hist.forEach(function(e,i){
      var lab = (mode==='rally'? ('PS'+(e.ps||'?')+' '+(e.surface||'')) : (e.session||'?')) + ' \u00b7 ' + (e.timestamp||('#'+(i+1)));
      opts += '<option value="'+i+'">'+esc(lab)+'</option>';
    });
    opts += '<option value="-1">\u2014 nessuna \u2014</option>';
    sel.innerHTML = opts;
    if(selVal!=='' && +selVal>=0 && +selVal<hist.length) sel.value = selVal;
    else sel.value = hist.length? String(hist.length-1) : '-1';
  }
  var baseIdx = sel? +sel.value : (hist.length-1);
  var A = saAnalyze(ctx.cur, ctx.p, ctx.surf);
  var B=null, C=null, baseLabel='';
  if(baseIdx>=0 && hist[baseIdx]){
    var bset = saEntryToSetup(hist[baseIdx], ctx.cur);
    B = saAnalyze(bset, ctx.p, ctx.surf);
    C = saCompare(A, B, ctx.p, ctx.surf, ctx.prof);
    baseLabel = mode==='rally'? ('PS'+(hist[baseIdx].ps||'?')) : (hist[baseIdx].session||'setup precedente');
    baseLabel += ' '+(hist[baseIdx].timestamp||'');
    ctx.baseGaps = saBaselineGaps(hist[baseIdx], ctx.cur);
  }
  out.innerHTML = saOutputHTML(mode, car, A, B, C, ctx.p, ctx.surf, ctx.prof, ctx.refMs, baseLabel, ctx);
