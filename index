<!-- ═══════════════════════════════════════════════════════════════
     PWA — Progressive Web App registration + install prompt
     - Manifest inline as blob (no separate file needed)
     - Service worker inline as blob (works from single HTML file)
     - Install prompt UI (banner that appears when installable)
     - Offline awareness indicator
     ═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  'use strict';

  // ─── Inline manifest (PWA metadata) ──────────────────────────────
  var manifest = {
    name: 'Race Engineer Pro',
    short_name: 'RaceEngPro',
    description: 'Race engineering companion — track + rally',
    start_url: location.pathname,
    scope: '.',
    display: 'standalone',
    orientation: 'any',
    background_color: '#0f1218',
    theme_color: '#0f1218',
    icons: [
      { src: 'data:image/svg+xml;base64,'+btoa('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192"><rect width="192" height="192" rx="36" fill="#0f1218"/><text x="96" y="82" text-anchor="middle" font-family="Arial Black,sans-serif" font-size="34" font-weight="900" fill="#e8421a">RACE</text><text x="96" y="114" text-anchor="middle" font-family="Arial Black,sans-serif" font-size="34" font-weight="900" fill="#fff">ENG</text><text x="96" y="148" text-anchor="middle" font-family="Arial Black,sans-serif" font-size="28" font-weight="700" fill="#e8421a">PRO</text></svg>'),
        sizes: '192x192',
        type: 'image/svg+xml',
        purpose: 'any maskable'
      },
      { src: 'data:image/svg+xml;base64,'+btoa('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><rect width="512" height="512" rx="96" fill="#0f1218"/><text x="256" y="220" text-anchor="middle" font-family="Arial Black,sans-serif" font-size="92" font-weight="900" fill="#e8421a">RACE</text><text x="256" y="300" text-anchor="middle" font-family="Arial Black,sans-serif" font-size="92" font-weight="900" fill="#fff">ENG</text><text x="256" y="400" text-anchor="middle" font-family="Arial Black,sans-serif" font-size="76" font-weight="700" fill="#e8421a">PRO</text></svg>'),
        sizes: '512x512',
        type: 'image/svg+xml',
        purpose: 'any maskable'
      }
    ]
  };
  try {
    var manifestBlob = new Blob([JSON.stringify(manifest)], {type:'application/json'});
    var manifestUrl = URL.createObjectURL(manifestBlob);
    var manifestLink = document.createElement('link');
    manifestLink.rel = 'manifest';
    manifestLink.href = manifestUrl;
    document.head.appendChild(manifestLink);
  } catch(e){ console.warn('[PWA] manifest blob failed', e); }

  // ─── Inline service worker ──────────────────────────────────────
  var swSource = `
    var CACHE = 'race-eng-pro-v1';
    var BASE  = self.location.href.replace(/[^/]+$/, '');
    self.addEventListener('install', function(ev){
      ev.waitUntil(
        caches.open(CACHE).then(function(c){
          return c.addAll([BASE]);
        }).catch(function(){})
      );
      self.skipWaiting();
    });
    self.addEventListener('activate', function(ev){
      ev.waitUntil(
        caches.keys().then(function(keys){
          return Promise.all(keys.filter(function(k){return k!==CACHE;}).map(function(k){return caches.delete(k);}));
        }).then(function(){ return self.clients.claim(); })
      );
    });
    self.addEventListener('fetch', function(ev){
      var req = ev.request;
      if(req.method !== 'GET') return;
      var url = new URL(req.url);
      var isHTML = req.destination === 'document' || (req.headers.get('accept')||'').indexOf('text/html') >= 0;
      var isCDN  = /cdn\\.|cloudflare|jsdelivr|unpkg|plot\\.ly|googleapis/.test(url.hostname);
      if(isHTML){
        ev.respondWith(
          fetch(req).then(function(resp){
            var copy = resp.clone();
            caches.open(CACHE).then(function(c){ c.put(req, copy); }).catch(function(){});
            return resp;
          }).catch(function(){
            return caches.match(req).then(function(m){ return m || caches.match(BASE); });
          })
        );
      } else if(isCDN){
        ev.respondWith(
          caches.match(req).then(function(m){
            return m || fetch(req).then(function(resp){
              if(resp.ok){
                var copy = resp.clone();
                caches.open(CACHE).then(function(c){ c.put(req, copy); }).catch(function(){});
              }
              return resp;
            }).catch(function(){ return m; });
          })
        );
      }
    });
  `;

  function canUseSW(){
    return 'serviceWorker' in navigator && (
      location.protocol === 'https:' ||
      location.hostname === 'localhost' ||
      location.hostname === '127.0.0.1'
    );
  }

  if(canUseSW()){
    try {
      var swBlob = new Blob([swSource], {type:'application/javascript'});
      var swUrl = URL.createObjectURL(swBlob);
      navigator.serviceWorker.register(swUrl, { scope: './' })
        .then(function(reg){
          console.log('[PWA] service worker registrato', reg.scope);
          window._PWA_SW_OK = true;
        })
        .catch(function(err){
          console.warn('[PWA] registrazione service worker fallita', err);
        });
    } catch(e){ console.warn('[PWA] service worker init err', e); }
  } else {
    console.log('[PWA] service worker non registrabile (richiede HTTPS o localhost; protocol:', location.protocol, ')');
  }

  // ─── Install prompt management ──────────────────────────────────
  var deferredInstallPrompt = null;
  window.addEventListener('beforeinstallprompt', function(e){
    e.preventDefault();
    deferredInstallPrompt = e;
    showInstallBanner();
  });
  window.addEventListener('appinstalled', function(){
    console.log('[PWA] app installata');
    hideInstallBanner();
    if(typeof showToast === 'function') showToast('✅ App installata');
  });

  function showInstallBanner(){
    if(document.getElementById('pwa-install-banner')) return;
    var dismissed = null;
    try { dismissed = localStorage.getItem('pwa_install_dismissed'); } catch(e){}
    if(dismissed && (Date.now() - (+dismissed)) < 7*24*60*60*1000) return;

    var banner = document.createElement('div');
    banner.id = 'pwa-install-banner';
    banner.style.cssText = 'position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:var(--bg1);border:1px solid var(--accent);border-radius:8px;padding:12px 16px;z-index:9999;display:flex;align-items:center;gap:12px;box-shadow:0 4px 20px rgba(0,0,0,0.6);max-width:calc(100vw - 32px);';
    banner.innerHTML =
      '<span style="font-size:22px;">📱</span>'+
      '<div style="flex:1;font-size:12px;line-height:1.4;color:var(--text1);">'+
        '<b>Installa Race Engineer Pro</b><br>'+
        '<span style="color:var(--text3);font-size:11px;">Più veloce, offline, a schermo intero</span>'+
      '</div>'+
      '<button class="btn btn-green" style="padding:7px 14px;font-size:12px;" onclick="window._pwaInstall()">INSTALLA</button>'+
      '<button class="btn btn-gray" style="padding:7px 10px;font-size:11px;" onclick="window._pwaDismiss()" title="Non mostrare per 7 giorni">✕</button>';
    document.body.appendChild(banner);
  }
  function hideInstallBanner(){
    var b = document.getElementById('pwa-install-banner');
    if(b) b.remove();
  }
  window._pwaInstall = function(){
    if(!deferredInstallPrompt) return;
    deferredInstallPrompt.prompt();
    deferredInstallPrompt.userChoice.then(function(choice){
      if(choice.outcome === 'accepted'){
        if(typeof showToast === 'function') showToast('📥 Installazione in corso...');
      }
      deferredInstallPrompt = null;
      hideInstallBanner();
    });
  };
  window._pwaDismiss = function(){
    try { localStorage.setItem('pwa_install_dismissed', String(Date.now())); } catch(e){}
    hideInstallBanner();
  };

  // ─── iOS Safari install hint (no beforeinstallprompt there) ─────
  function isIOSSafari(){
    var ua = navigator.userAgent;
    return /iPad|iPhone|iPod/.test(ua) && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS/.test(ua);
  }
  function isStandalone(){
    return window.matchMedia('(display-mode: standalone)').matches ||
           window.navigator.standalone === true;
  }

  if(isIOSSafari() && !isStandalone()){
    setTimeout(function(){
      var shown = null;
      try { shown = localStorage.getItem('pwa_ios_hint_shown'); } catch(e){}
      if(shown) return;
      var hint = document.createElement('div');
      hint.id = 'pwa-ios-hint';
      hint.style.cssText = 'position:fixed;bottom:20px;left:16px;right:16px;background:var(--bg1);border:1px solid var(--accent);border-radius:10px;padding:14px 16px;z-index:9999;box-shadow:0 6px 24px rgba(0,0,0,0.6);';
      hint.innerHTML =
        '<div style="display:flex;align-items:flex-start;gap:10px;">'+
          '<span style="font-size:24px;">📲</span>'+
          '<div style="flex:1;font-size:12px;line-height:1.5;color:var(--text1);">'+
            '<b>Installa sulla Home</b><br>'+
            '<span style="color:var(--text3);">Tocca <span style="display:inline-block;padding:1px 5px;background:var(--bg3);border-radius:3px;">⎙</span> (Condividi) → <b>Aggiungi alla schermata Home</b></span>'+
          '</div>'+
          '<button class="btn btn-gray" style="padding:6px 10px;font-size:11px;" onclick="window._pwaIOSHintDismiss()">✕</button>'+
        '</div>';
      document.body.appendChild(hint);
      window._pwaIOSHintDismiss = function(){
        try { localStorage.setItem('pwa_ios_hint_shown','1'); } catch(e){}
        var h = document.getElementById('pwa-ios-hint'); if(h) h.remove();
      };
      setTimeout(function(){ if(document.getElementById('pwa-ios-hint')) window._pwaIOSHintDismiss(); }, 12000);
    }, 3000);
  }

  // ─── Online/offline awareness ───────────────────────────────────
  function updateOnlineStatus(){
    var isOnline = navigator.onLine;
    var badge = document.getElementById('pwa-offline-badge');
    if(!isOnline){
      if(!badge){
        badge = document.createElement('div');
        badge.id = 'pwa-offline-badge';
        badge.style.cssText = 'position:fixed;top:8px;left:50%;transform:translateX(-50%);background:#d53a3a;color:#fff;padding:5px 14px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:1px;z-index:9999;box-shadow:0 2px 10px rgba(213,58,58,0.5);';
        badge.innerHTML = '⚡ OFFLINE — DATI LOCALI';
        document.body.appendChild(badge);
      }
    } else if(badge) {
      badge.remove();
    }
  }
  window.addEventListener('online', updateOnlineStatus);
  window.addEventListener('offline', updateOnlineStatus);
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', updateOnlineStatus);
  } else {
    updateOnlineStatus();
  }

  // Expose helper for help/info modal
  window.pwaStatus = function(){
    return {
      swSupported: 'serviceWorker' in navigator,
      swRegistered: !!window._PWA_SW_OK,
      protocol: location.protocol,
      standalone: isStandalone(),
      installable: !!deferredInstallPrompt,
      platform: isIOSSafari() ? 'ios-safari' : (navigator.userAgent)
    };
  };
})();
</script>

<script>
/* ═══════════════════════════════════════════════════════
   UX/UI IMPROVEMENTS v29
   1. Fade page transitions
   2. Live lap counter in topbar
   3. Circuit search
   4. Keyboard shortcut T → lap-time, D → dashboard, M → meteo
   5. Richer toast notifications
   6. Keyboard hints in overflow menu
   ═══════════════════════════════════════════════════════ */

// ── 1. PAGE TRANSITION FADE ──────────────────────────
(function(){
  const style = document.createElement('style');
  style.textContent = `
    .page { opacity:0; transition:opacity 80ms ease; pointer-events:none; }
    .page.active { opacity:1; pointer-events:auto; }
  `;
  document.head.appendChild(style);
})();

// ── 2. LIVE LAP COUNTER IN TOPBAR ───────────────────
(function(){
  const clock = document.getElementById('session-clock');
  if(!clock) return;
  const ctr = document.createElement('div');
  ctr.id = 'topbar-lap-counter';
  ctr.title = 'Giri registrati (vettura selezionata)';
  ctr.style.cssText = 'font-family:var(--mono);font-size:12px;color:var(--text3);letter-spacing:1px;white-space:nowrap;cursor:default;border-left:1px solid var(--border);padding-left:10px;display:flex;align-items:center;gap:4px;';
  ctr.innerHTML = '<span style="opacity:.6">G</span><span id="tlc-num" style="color:var(--accent3);font-size:18px;font-weight:700;line-height:1;">0</span>';
  clock.parentNode.insertBefore(ctr, clock);

  function updateLapCounter(){
    if(typeof STATE==='undefined') return;
    const selIdx = STATE.mode==='track' ? (STATE.selectedTrackCar||0) : (STATE.selectedRallyCar||0);
    const cars = STATE.mode==='track' ? STATE.trackCars : STATE.rallyCars;
    const car = cars && cars[selIdx];
    const count = car ? ((STATE.laps && STATE.laps[car.id])||[]).length : 0;
    const el = document.getElementById('tlc-num');
    if(el) el.textContent = count;
  }
  setInterval(updateLapCounter, 1200);

  // Patch addLap to update immediately
  var _orig = window.addLap;
  if(_orig) window.addLap = function(){
    _orig.apply(this, arguments);
    setTimeout(updateLapCounter, 80);
  };
})();

// ── 3. CIRCUIT SEARCH ────────────────────────────────
(function(){
  var sel = document.getElementById('circuit-selector');
  if(!sel) return;
  var wrap = sel.parentElement;
  var inp = document.createElement('input');
  inp.type = 'text';
  inp.placeholder = '🔍 Cerca…';
  inp.id = 'circuit-search';
  inp.style.cssText = 'background:var(--bg0);border:1px solid var(--border);color:var(--text1);border-radius:3px;font-size:11px;padding:3px 6px;width:100px;font-family:var(--mono);';
  wrap.insertBefore(inp, sel);

  // Clone all original options for filtering
  var allNodes = Array.from(sel.querySelectorAll('option,optgroup')).map(function(n){ return n.cloneNode(true); });

  inp.addEventListener('input', function(){
    var q = inp.value.trim().toLowerCase();
    sel.innerHTML = '';
    if(!q){
      allNodes.forEach(function(n){ sel.appendChild(n.cloneNode(true)); });
      return;
    }
    var matches = [];
    allNodes.forEach(function(node){
      if(node.tagName==='OPTGROUP'){
        node.querySelectorAll('option').forEach(function(opt){
          if(opt.textContent.toLowerCase().includes(q)) matches.push(opt.cloneNode(true));
        });
      } else if(node.tagName==='OPTION' && node.value){
        if(node.textContent.toLowerCase().includes(q)) matches.push(node.cloneNode(true));
      }
    });
    if(!matches.length){
      var empty=document.createElement('option'); empty.value=''; empty.textContent='Nessun risultato';
      sel.appendChild(empty);
    } else {
      matches.forEach(function(o){ sel.appendChild(o); });
      if(matches.length===1 && matches[0].value){
        sel.value=matches[0].value;
        if(typeof selectCircuit==='function') selectCircuit(matches[0].value);
      }
    }
  });

  sel.addEventListener('change', function(){
    var current=sel.value;
    inp.value='';
    sel.innerHTML='';
    allNodes.forEach(function(n){ sel.appendChild(n.cloneNode(true)); });
    sel.value=current;
  });
})();

// ── 4. KEYBOARD SHORTCUTS ────────────────────────────
(function(){
  document.addEventListener('keydown', function(e){
    var tag=(document.activeElement||{}).tagName||'';
    if(['INPUT','TEXTAREA','SELECT'].includes(tag)) return;
    if(e.altKey||e.ctrlKey||e.metaKey) return;
    if(e.key==='t'||e.key==='T'){
      if(typeof showPage==='function') showPage('laps');
      setTimeout(function(){ var lt=document.getElementById('lap-time'); if(lt){lt.focus();lt.select();} },120);
      e.preventDefault();
    } else if(e.key==='d'||e.key==='D'){
      if(typeof showPage==='function') showPage('dashboard');
      e.preventDefault();
    } else if(e.key==='m'||e.key==='M'){
      if(typeof showPage==='function') showPage('meteo');
      e.preventDefault();
    } else if(e.key==='p'||e.key==='P'){
      if(typeof showPage==='function') showPage('pitstop');
      e.preventDefault();
    }
  });
})();

// ── 5. RICHER TOASTS ─────────────────────────────────
(function(){
  var style=document.createElement('style');
  style.textContent=`
    #rep-toast {
      position:fixed !important; bottom:28px !important; left:50% !important;
      transform:translateX(-50%) !important;
      background:var(--bg1) !important; border:1px solid var(--border2) !important;
      border-left:3px solid var(--accent) !important;
      color:var(--text1) !important; font-family:var(--mono) !important;
      font-size:12px !important; letter-spacing:.5px !important;
      padding:10px 22px !important; border-radius:5px !important;
      box-shadow:0 8px 32px rgba(0,0,0,.6) !important;
      z-index:99999 !important; white-space:nowrap !important;
      max-width:90vw; text-align:center;
    }
    #rep-toast.toast-success { border-left-color:var(--green) !important; }
    #rep-toast.toast-warn    { border-left-color:var(--yellow) !important; }
    #rep-toast.toast-error   { border-left-color:var(--red) !important; }
  `;
  document.head.appendChild(style);

  var _origToast = window.showToast;
  window.showToast = function(msg, duration, type){
    if(_origToast) _origToast(msg, duration||2800);
    setTimeout(function(){
      var t=document.getElementById('rep-toast');
      if(!t) return;
      t.classList.remove('toast-success','toast-warn','toast-error');
      var m=msg||'';
      if(type==='success'||m.startsWith('✅')||m.startsWith('✔')) t.classList.add('toast-success');
      else if(type==='warn'||m.startsWith('⚠')) t.classList.add('toast-warn');
      else if(type==='error'||m.startsWith('❌')) t.classList.add('toast-error');
    }, 10);
  };
})();

// ── 6. KEYBOARD HINTS IN OVERFLOW MENU ───────────────
(function(){
  var overflow=document.querySelector('.overflow-dropdown');
