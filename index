  if(el && el.value) return el.value;
  // fallback: try memory
  try {
    if(typeof Mem !== 'undefined' && Mem.get){
      var m = Mem.get('lastDriverId');
      if(m) return m;
    }
  } catch(_){}
  return '';
}
