function calcStrategy() {
  var totalLaps = +(document.getElementById('strat-total-laps')||{}).value||20;
  var currentLap = +(document.getElementById('strat-current-lap')||{}).value||1;
  var lapTime = +(document.getElementById('strat-lap-time')||{}).value||0;
  var pitLoss = +(document.getElementById('strat-pit-loss')||{}).value||22;
  var tyreLife = +(document.getElementById('strat-tyre-life')||{}).value||12;
  var lapsOnTyre = +(document.getElementById('strat-laps-on-tyre')||{}).value||0;
  var fuelNow = +(document.getElementById('strat-fuel-now')||{}).value||0;
  var fuelPerLap = +(document.getElementById('strat-fuel-per-lap')||{}).value||0;
  var tyreDelta = +(document.getElementById('strat-tyre-delta')||{}).value||0.3;
  var el = document.getElementById('strategy-result'); if(!el) return;
  if(!lapTime) { el.innerHTML='<div style="color:var(--text3);">Inserisci il tempo giro medio in secondi.</div>'; return; }
  var lapsLeft = totalLaps - currentLap + 1;
  var tyreLapsLeft = tyreLife - lapsOnTyre;
  var pitsNeeded = Math.ceil((lapsLeft - tyreLapsLeft) / tyreLife);
  if(pitsNeeded < 0) pitsNeeded = 0;
  var timeNoPit = lapsLeft * lapTime;
  var timeWithPit = pitsNeeded * pitLoss + lapsLeft * lapTime;
  var fuelNeeded = fuelPerLap > 0 ? lapsLeft * fuelPerLap : 0;
  var html = '<div class="g2" style="gap:8px;">';
  html += '<div class="tile"><div class="tile-label">PIT STIMATI</div><div class="tile-value" style="color:var(--accent3);">'+pitsNeeded+'</div></div>';
