// ═══════════════════════════════════════════════════════════════
let _pitTimerStart=null, _pitTimerRunning=false, _pitTimerInterval=null;
let _pitStops = {}; // carId -> []

function buildPitstopPage() {
  const containers=['laps-car-tabs','tyres-car-tabs','fuel-car-tabs','damage-car-tabs','setup-car-tabs','tele-car-tabs','pitstop-car-tabs'];
  const el=document.getElementById('pitstop-car-tabs');
  if(el) el.innerHTML=buildCarTabsHTML(STATE.trackCars,STATE.selectedTrackCar,(i,cid)=>`selectTrackCar(${i},this,'${cid}')`)('pitstop-car-tabs');
  const car=STATE.trackCars[STATE.selectedTrackCar];
  if(!_pitStops[car.id]) _pitStops[car.id]=[];
  // Sync lap counter
  const lapEl=document.getElementById('pitstop-lap');
  if(lapEl) lapEl.value=(STATE.laps[car.id]||[]).length+1;
  buildPitstopHistoryTable(car.id);
  updatePitstopStats(car.id);
  setEl('pitstop-count-badge', `${(_pitStops[car.id]||[]).length} pit`);
  // Reset button states if timer not running
  if(!_pitTimerRunning) {
    const sb=document.getElementById('pitstop-start-btn'); if(sb) sb.disabled=false;
    const sb2=document.getElementById('pitstop-stop-btn'); if(sb2) sb2.disabled=true;
  }
}

function startPitstopTimer() {
  if(_pitTimerRunning) return;
  _pitTimerRunning=true;
  _pitTimerStart=performance.now();
  document.getElementById('pitstop-start-btn').disabled=true;
  document.getElementById('pitstop-stop-btn').disabled=false;
  _pitTimerInterval=setInterval(()=>{
    const ms=performance.now()-_pitTimerStart;
    const s=ms/1000;
    setEl('pitstop-timer-display',s.toFixed(3));
    // Target bar
    const target=+document.getElementById('pitstop-target')?.value||25;
    const pct=Math.min(100,(s/target)*100);
    const bar=document.getElementById('pitstop-target-bar');
    if(bar){bar.style.width=pct+'%';bar.style.background=pct>100?'var(--red)':pct>80?'var(--yellow)':'var(--green)';}
  },50);
}

function stopPitstopTimer() {
  if(!_pitTimerRunning) return;
  _pitTimerRunning=false;
  clearInterval(_pitTimerInterval);
  const ms=performance.now()-_pitTimerStart;
  const s=ms/1000;
  const target=+document.getElementById('pitstop-target')?.value||25;
  const diff=s-target;
  const vsT=document.getElementById('pitstop-vs-target');
  if(vsT){
    vsT.textContent=(diff>0?'+':'')+diff.toFixed(3)+'s vs target';
    vsT.style.color=diff<=0?'var(--green)':diff<2?'var(--yellow)':'var(--red)';
  }
  document.getElementById('pitstop-start-btn').disabled=false;
  document.getElementById('pitstop-stop-btn').disabled=true;
}

function resetPitstopTimer() {
  stopPitstopTimer();
  _pitTimerStart=null; _pitTimerRunning=false;
  setEl('pitstop-timer-display','0.000');
  setEl('pitstop-vs-target','— vs target');
  const bar=document.getElementById('pitstop-target-bar');
  if(bar){bar.style.width='0%';bar.style.background='var(--green)';}
  document.getElementById('pitstop-start-btn').disabled=false;
  document.getElementById('pitstop-stop-btn').disabled=true;
}

function savePitstop() {
  const car=STATE.trackCars[STATE.selectedTrackCar];
  if(!_pitStops[car.id]) _pitStops[car.id]=[];
  const durEl=document.getElementById('pitstop-timer-display');
  const dur=durEl?+durEl.textContent:0;
  if(!dur) { showToast('⚠️ Avvia il timer prima di salvare'); return; }
  const entry={
    id:Date.now(),
    carId:car.id,
    lap:+document.getElementById('pitstop-lap')?.value||1,
    duration:dur,
    target:+document.getElementById('pitstop-target')?.value||25,
    type:document.getElementById('pitstop-type')?.value||'tyre',
    posBefore:+document.getElementById('pitstop-pos-before')?.value||1,
    posAfter:+document.getElementById('pitstop-pos-after')?.value||1,
    fuelAdded:+document.getElementById('pitstop-fuel-add')?.value||0,
    laneLoss:+document.getElementById('pitstop-lane-loss')?.value||20,
    notes:document.getElementById('pitstop-notes')?.value||'',
    timestamp:new Date().toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit'})
  };
  _pitStops[car.id].push(entry);
  // Auto-update fuel
  if(entry.fuelAdded>0) {
    STATE.fuel[car.id].current=Math.min(STATE.fuel[car.id].capacity,STATE.fuel[car.id].current+entry.fuelAdded);
    STATE.fuel[car.id].log.push({lap:entry.lap,event:'Rifornimento pit',liters:entry.fuelAdded,level:STATE.fuel[car.id].current});
  }
  buildPitstopHistoryTable(car.id);
  updatePitstopStats(car.id);
  setEl('pitstop-count-badge',`${_pitStops[car.id].length} pit`);
  resetPitstopTimer();
  showToast(`✅ Pit stop salvato: ${dur.toFixed(3)}s (giro ${entry.lap})`);
  triggerAutoSave();
}

function buildPitstopHistoryTable(carId) {
  const tbody=document.getElementById('pitstop-history-tbody');
  if(!tbody) return;
  const pits=_pitStops[carId]||[];
  if(!pits.length){tbody.innerHTML='<tr><td colspan="9" style="text-align:center;color:var(--text3);padding:14px;">Nessun pit stop</td></tr>';return;}
  const typeLabels={tyre:'🔧 Gomme',fuel:'⛽ Carburante',tyre_fuel:'🔧+⛽',repair:'🔩 Riparazione',drive_through:'🚦 Drive Through',other:'📋 Altro'};
  tbody.innerHTML=pits.map((p,i)=>{
    const diff=p.duration-p.target;
    return `<tr>
      <td class="mono">${p.lap}</td>
      <td class="mono" style="font-size:15px;color:${diff<=0?'var(--green)':diff<2?'var(--yellow)':'var(--red)'};font-weight:700;">${p.duration.toFixed(3)}s</td>
      <td class="mono" style="color:${diff<=0?'var(--green)':'var(--red)'};">${diff>0?'+':''}${diff.toFixed(3)}s</td>
      <td style="font-size:11px;">${typeLabels[p.type]||p.type}</td>
      <td class="mono">${p.posBefore}</td>
      <td class="mono">${p.posAfter}</td>
      <td class="mono">${p.fuelAdded>0?'+'+p.fuelAdded+'L':'—'}</td>
      <td style="font-size:11px;">${p.notes||''}</td>
      <td><button onclick="deletePitstop('${carId}',${i})" style="background:none;border:none;color:var(--text3);cursor:pointer;">✕</button></td>
    </tr>`;
  }).join('');
}

function deletePitstop(carId,idx) {
  if(!confirm('Eliminare questo pit stop?')) return;
  _pitStops[carId]?.splice(idx,1);
  buildPitstopHistoryTable(carId);
  updatePitstopStats(carId);
}

function updatePitstopStats(carId) {
  const pits=(_pitStops[carId]||[]);
  if(!pits.length){setEl('pitstop-avg-badge','Media: —');setEl('pitstop-best-badge','Best: —');return;}
  const durs=pits.map(p=>p.duration);
  const avg=durs.reduce((a,b)=>a+b,0)/durs.length;
  const best=Math.min(...durs);
  setEl('pitstop-avg-badge',`Media: ${avg.toFixed(3)}s`);
  setEl('pitstop-best-badge',`Best: ${best.toFixed(3)}s`);
}

