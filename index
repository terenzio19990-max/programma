      html += '<tr><td><b>'+ps.session+'</b></td><td colspan="5" class="muted">— nessun dato —</td></tr>';
      return;
    }
    ps.cars.sort(function(a,b){return a.best-b.best;});
    ps.cars.forEach(function(c, i){
      var delta = c.best - ps.sessBest;
      var deltaStr = i === 0 ? '<span class="green">— BEST —</span>' : '+'+(delta/1000).toFixed(3)+'s';
      html += '<tr>'+
        (i===0 ? '<td rowspan="'+ps.cars.length+'"><b>'+ps.session+'</b></td>' : '')+
        '<td>'+c.car.name+'</td>'+
        '<td style="font-family:monospace;">'+_reportFmtMs(c.best)+'</td>'+
        '<td>'+deltaStr+'</td>'+
        '<td style="font-family:monospace;color:#888;">'+_reportFmtMs(c.avg)+'</td>'+
        '<td>'+c.count+'</td>'+
      '</tr>';
    });
  });
  html += '</tbody></table>';

  html += '<h2>Evoluzione Best Lap nel Weekend</h2>';
  html += '<table><thead><tr><th>Vettura</th>'+sessions.map(function(s){return '<th>'+s+'</th>';}).join('')+'<th>Trend</th></tr></thead><tbody>';
  allCars.forEach(function(car){
    var row = '<tr><td><b>'+car.name+'</b></td>';
    var bestVals = [];
    sessions.forEach(function(s){
      var laps = (STATE.laps[car.id]||[]).filter(function(l){return l.session === s;});
      var times = laps.map(function(l){return parseTime(l.time);}).filter(function(t){return t&&isFinite(t);});
      var best = times.length ? Math.min.apply(null, times) : null;
      bestVals.push(best);
      row += '<td style="font-family:monospace;font-size:10px;">'+(best?_reportFmtMs(best):'—')+'</td>';
    });
    var trend = '';
    var validVals = bestVals.filter(function(v){return v!=null;});
    if(validVals.length >= 2){
      var first = validVals[0];
      var last = validVals[validVals.length-1];
      var diff = last - first;
      if(diff < -100) trend = '<span class="green">↘ -'+Math.abs(diff/1000).toFixed(2)+'s</span>';
      else if(diff > 100) trend = '<span class="red">↗ +'+(diff/1000).toFixed(2)+'s</span>';
      else trend = '<span class="muted">→ stabile</span>';
    }
    row += '<td>'+trend+'</td></tr>';
    html += row;
  });
  html += '</tbody></table>';

  html += '<h2>Gomme Weekend</h2>';
  var setMounts = 0;
  allCars.forEach(function(car){
    var ts = STATE.tyres && STATE.tyres[car.id];
    if(ts && ts.history) setMounts += ts.history.length;
    var rt = STATE.rallyTyres && STATE.rallyTyres[car.id];
    if(rt && rt.history) setMounts += rt.history.length;
