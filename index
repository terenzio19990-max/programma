// Apply defaults when page is shown (called via showPage hook)
function _applyDefaultsOnLapPage(){
  // Position auto-fill: copy from last lap if empty
  try {
    var car = STATE.mode === 'rally'
      ? STATE.rallyCars[STATE.selectedRallyCar]
      : STATE.trackCars[STATE.selectedTrackCar];
    var posEl = document.getElementById('lap-pos');
    if(posEl && (!posEl.value || posEl.value === '1' || posEl.value === '0')){
