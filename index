// KEYBOARD SHORTCUTS
// ═══════════════════════════════════════════════════════════════
let _kbEnabled = true;
document.addEventListener('keydown', e=>{
  if(!_kbEnabled) return;
  // Skip if typing in input/textarea
  if(['INPUT','TEXTAREA','SELECT'].includes(e.target.tagName)) return;
  switch(e.key.toLowerCase()) {
    case 'g': showPage('laps'); break;                        // G = Giri (tempi)
    case 'p': if(STATE.sessionTimerRunning) pauseTimer(); else startTimer(); break; // P = Play/Pause sessione
    case 'r': resetTimer(); break;                            // R = Reset timer
    case 'q': showPage('overview'); break;                    // Q = Overview
    case 'd': showPage('dashboard'); break;                   // D = Dashboard
    case 't': showPage('tyres'); break;                       // T = Tyres
    case 'f': showPage('fuel'); break;                        // F = Fuel
    case 'm': showPage('meteo'); break;                       // M = Meteo
    case '1': setFlag('green'); break;
    case '2': setFlag('yellow'); break;
    case '3': setFlag('red'); break;
    case '4': setFlag('sc'); break;
    case 'n': toggleNotifPanel(); break;                      // N = Notifiche
    case 'k': showKeyboardHelp(); break;                      // K = Help shortcuts
    case '+': case '=': { // Quick lap from keyboard
      const t=document.getElementById('quick-lap-time');
