];

function setBrowserUrl(mode, url) {
  const el = document.getElementById('browser-'+mode+'-url');
  if(el) el.value = url;
}

function loadBrowser(mode) {
  const inputEl = document.getElementById('browser-'+mode+'-url');
  let url = inputEl ? inputEl.value.trim() : '';
  if(!url) { showBrowserPlaceholder(mode); return; }
  if(!url.startsWith('http') && !url.startsWith('//')) {
    if(url.includes('.') && !url.includes(' ')) url = 'https://' + url;
    else url = 'https://www.google.com/search?q=' + encodeURIComponent(url);
    if(inputEl) inputEl.value = url;
  }
  const domain = url.replace('https://','').replace('http://','').split('/')[0];
  const forceNewTab = ALWAYS_NEWTAB.some(d => domain.includes(d));
  const blocked = document.getElementById('browser-'+mode+'-blocked');
  if(forceNewTab) {
    // These sites refuse to be embedded — open them directly instead of
    // leaving a blank frame, and keep the launcher visible.
    window.open(url, '_blank', 'noopener');
    if(blocked) blocked.style.display = 'flex';
    showBrowserPlaceholder(mode);
    return;
  }
  hideBrowserPlaceholder(mode);
  if(blocked) blocked.style.display = 'none';
  const frame = document.getElementById('browser-'+mode+'-frame');
  if(frame) {
    frame._blLoaded = false;
    frame.src = url;
    if(frame._blTimer) clearTimeout(frame._blTimer);
    // If the page never signals a successful load, it is almost certainly
    // refusing to be embedded — reveal the "open externally" hint.
    frame._blTimer = setTimeout(function(){
      if(!frame._blLoaded && blocked) blocked.style.display = 'flex';
    }, 4500);
  }
}
function loadBrowserTrack() { loadBrowser('track'); }
function loadBrowserRally() { loadBrowser('rally'); }

function onBrowserLoad(mode, iframe) {
  // The frame fired 'load' — treat that as a successful render.
  if(iframe && iframe._blTimer){ clearTimeout(iframe._blTimer); iframe._blTimer = null; }
  if(iframe) iframe._blLoaded = true;
  if(iframe && iframe.src && iframe.src !== 'about:blank') hideBrowserPlaceholder(mode);
  // NOTE: a cross-origin frame throws on contentDocument access even when it
  // loaded fine, so we must NOT infer "blocked" from that exception (old bug).
  // The toolbar ↗ button and the stall-timeout hint cover truly blocked sites.
}
function hideBrowserPlaceholder(mode) {
  const ph = document.getElementById('browser-'+mode+'-placeholder');
  if(ph) ph.style.display = 'none';
}
function showBrowserPlaceholder(mode) {
  const ph = document.getElementById('browser-'+mode+'-placeholder');
  if(ph) ph.style.display = 'flex';
  const frame = document.getElementById('browser-'+mode+'-frame');
  if(frame) frame.src = 'about:blank';
  const blocked = document.getElementById('browser-'+mode+'-blocked');
  if(blocked) blocked.style.display = 'none';
}
function openBrowserExternal(mode) {
  const url = document.getElementById('browser-'+mode+'-url') ? document.getElementById('browser-'+mode+'-url').value.trim() : '';
  if(url) window.open(url, '_blank', 'noopener');
}

// ═══════════════════════════════════════════════════════════════
// CAMERAS — smart stream detection + per-mode persistent storage
// Storage: REP_cameras_v1 = { track: {cams:{1:{url,name},...}}, rally:{...} }
// Camere salvate separatamente per track e rally — la modalità corrente
// determina quali si vedono.
// ═══════════════════════════════════════════════════════════════
var CAMERAS_KEY = 'REP_cameras_v1';
var _cameras = null;
const _camNames = {1:'CAMERA 1',2:'CAMERA 2',3:'CAMERA 3',4:'CAMERA 4'};

function _camLoad(){
  if(_cameras) return _cameras;
  try {
    _cameras = JSON.parse(localStorage.getItem(CAMERAS_KEY)||'null');
  } catch(_){ _cameras = null; }
  if(!_cameras){
    _cameras = {
      track: { cams: {1:{url:'',name:'CAMERA 1'}, 2:{url:'',name:'CAMERA 2'}, 3:{url:'',name:'CAMERA 3'}, 4:{url:'',name:'CAMERA 4'}} },
      rally: { cams: {1:{url:'',name:'CAMERA 1'}, 2:{url:'',name:'CAMERA 2'}, 3:{url:'',name:'CAMERA 3'}, 4:{url:'',name:'CAMERA 4'}} }
    };
  }
  // Defensive: ensure structure is well-formed
  ['track','rally'].forEach(function(m){
    if(!_cameras[m]) _cameras[m] = { cams: {} };
    if(!_cameras[m].cams) _cameras[m].cams = {};
    [1,2,3,4].forEach(function(n){
      if(!_cameras[m].cams[n]) _cameras[m].cams[n] = { url:'', name:'CAMERA '+n };
    });
  });
  return _cameras;
}

function _camSave(){
  try { localStorage.setItem(CAMERAS_KEY, JSON.stringify(_cameras||{})); } catch(_){}
}

function _camCurrentMode(){
  return (typeof STATE !== 'undefined' && STATE.mode === 'rally') ? 'rally' : 'track';
}

// Persist a camera URL+name for the current mode
function _camPersist(n){
  _camLoad();
  var mode = _camCurrentMode();
  var input = document.getElementById('cam'+n+'-url');
  var label = document.getElementById('cam'+n+'-label');
  if(input) _cameras[mode].cams[n].url = input.value.trim();
  // name is taken from _camNames runtime; persist it too
  _cameras[mode].cams[n].name = _camNames[n] || ('CAMERA '+n);
  _camSave();
}

// Load all 4 cameras for the current mode and display them
function camerePageLoad(){
  _camLoad();
  var mode = _camCurrentMode();
  var modeData = _cameras[mode];

  // Update mode indicator banner
  var ind = document.getElementById('camere-mode-indicator');
  if(ind){
    if(mode === 'rally'){
      ind.textContent = '🌲 SEZIONE RALLY — le camere qui sono separate da quelle pista';
      ind.style.background = 'rgba(44,188,110,0.12)';
      ind.style.borderColor = 'var(--green)';
      ind.style.color = 'var(--green)';
    } else {
      ind.textContent = '🏁 SEZIONE PISTA — le camere qui sono separate da quelle rally';
      ind.style.background = 'rgba(232,66,26,0.12)';
      ind.style.borderColor = 'var(--accent3)';
      ind.style.color = 'var(--accent3)';
    }
  }

  // Restore each camera
  for(var n=1; n<=4; n++){
    var cam = modeData.cams[n] || {url:'', name:'CAMERA '+n};
    _camNames[n] = cam.name || ('CAMERA '+n);
    var lbl = document.getElementById('cam'+n+'-label');
    if(lbl) lbl.textContent = '📷 ' + (_camNames[n] || ('CAMERA '+n));
    var input = document.getElementById('cam'+n+'-url');
    if(input) input.value = cam.url || '';
    // If URL present, auto-load the stream
    if(cam.url){
      // Defer to next tick so DOM is ready
      (function(num){ setTimeout(function(){ if(typeof loadCam === 'function') loadCam(num); }, 50); })(n);
    } else {
      if(typeof clearCam === 'function') clearCam(n);
    }
  }
}
window.camerePageLoad = camerePageLoad;

function loadCam(n) {
  let url = document.getElementById('cam'+n+'-url') ? document.getElementById('cam'+n+'-url').value.trim() : '';
  if(!url) { clearCam(n); _camPersist(n); return; }
  if(!url.startsWith('http')) url = 'https://' + url;
  const img   = document.getElementById('cam'+n+'-img');
  const frame = document.getElementById('cam'+n+'-frame');
  const ph    = document.getElementById('cam'+n+'-placeholder');
  const bl    = document.getElementById('cam'+n+'-blocked');
  if(img)   { img.style.display='none'; img.src=''; }
  if(frame) { frame.style.display='none'; frame.src='about:blank'; }
  if(ph)    ph.style.display='none';
  if(bl)    bl.style.display='none';
  const isMjpeg = /\.(mjpg|mjpeg|cgi)(\?|$)/i.test(url) || url.includes('mjpeg') || url.includes('video.cgi');
  const isImage = /\.(jpg|jpeg|png|gif|webp)(\?|$)/i.test(url);
  const forceNewTab = ALWAYS_NEWTAB.some(d => url.replace('https://','').split('/')[0].includes(d));
  if(forceNewTab) {
    window.open(url, '_blank', 'noopener');
    if(bl) { bl.style.display='flex'; }
    _camPersist(n);
    return;
  }
  if(isMjpeg || isImage) {
    if(img) {
      img.style.display='block'; img.src = url;
      img.onerror = function() {
        this.style.display='none';
        if(ph) { ph.style.display='flex'; ph.innerHTML='<div style="font-size:20px;">❌</div><div style="font-size:11px;color:var(--red);">Stream non raggiungibile</div><button class="btn btn-gray" style="font-size:10px;margin-top:4px;pointer-events:all;" onclick="openCamExternal('+n+')">↗ Apri</button>'; }
      };
    }
  } else {
    if(frame) { frame.style.display='block'; frame.src = url; }
  }
  _camPersist(n);
}
function clearCam(n) {
  const img   = document.getElementById('cam'+n+'-img');
  const frame = document.getElementById('cam'+n+'-frame');
  const ph    = document.getElementById('cam'+n+'-placeholder');
  const bl    = document.getElementById('cam'+n+'-blocked');
  const input = document.getElementById('cam'+n+'-url');
  if(img)   { img.style.display='none'; img.src=''; }
  if(frame) { frame.style.display='none'; frame.src='about:blank'; }
  if(bl)    bl.style.display='none';
  if(ph)    { ph.style.display='flex'; ph.innerHTML='<div style="font-size:32px;opacity:.3;">📷</div><div style="font-size:11px;color:var(--text3);opacity:.6;">'+(_camNames[n]||'CAMERA '+n)+'</div>'; }
  if(input) input.value='';
  // Persist the cleared state
  _camPersist(n);
}
function openCamExternal(n) {
  const url = document.getElementById('cam'+n+'-url') ? document.getElementById('cam'+n+'-url').value.trim() : '';
  if(url) window.open(url, '_blank', 'noopener');
}
function renameCam(n) {
  const name = prompt('Nome camera '+n+':', _camNames[n]);
  if(name && name.trim()) {
    _camNames[n] = name.trim();
    const lbl = document.getElementById('cam'+n+'-label');
    if(lbl) lbl.textContent = '📷 ' + name.trim().toUpperCase();
    _camPersist(n);
  }
}

