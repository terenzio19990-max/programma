    eventId: (prefill&&prefill.eventId) || ''
  };
  s.budget.push(item);
  stSave();
  stRenderBudget();
}
function stRemoveBudgetItem(id){
  if(!confirm('Rimuovere questa voce di budget?')) return;
  var s = _stCurrent();
  s.budget = s.budget.filter(function(b){return b.id!==id;});
  stSave(); stRenderBudget();
}
function stUpdateBudgetItem(id, field, value){
  var s = _stCurrent();
  var b = s.budget.find(function(x){return x.id===id;});
  if(!b) return;
  if(field==='amount') value = +value || 0;
  b[field] = value;
  stSave();
  // Re-render totals without rebuilding whole list (keeps focus)
  stRenderBudgetSummary();
}
function _stCurrencySymbol(){
  var s = _stCurrent();
  var c = s.currency || 'EUR';
  return c==='EUR'?'€':c==='USD'?'$':c==='GBP'?'£':c;
}
function _stFmtMoney(v){
  return _stCurrencySymbol()+' '+(v||0).toLocaleString('it-IT',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function stRenderBudget(){
  var s = _stCurrent();
  var curSel = document.getElementById('st-budget-currency');
  if(curSel){
    if(!s.currency) s.currency = 'EUR';
    curSel.value = s.currency;
    s.currency = curSel.value;
  }
  stRenderBudgetSummary();
  // Categories chart
  var catDiv = document.getElementById('st-budget-categories');
  if(catDiv){
    var catTotals = {};
    BUDGET_CATEGORIES.forEach(function(c){catTotals[c] = 0;});
    s.budget.filter(function(b){return b.type==='cost';}).forEach(function(b){
      if(!catTotals[b.category]) catTotals[b.category] = 0;
      catTotals[b.category] += +b.amount || 0;
    });
    var totalCosts = Object.values(catTotals).reduce(function(a,b){return a+b;},0);
    var catColors = ['#e8421a','#2b7de9','#2cbc6e','#8b5cf6','#f59e0b','#14b8a6','#ec4899','#94a3b8'];
    var catHtml = '<div style="font-family:var(--head);font-size:10px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">RIPARTIZIONE COSTI PER CATEGORIA</div>';
    // Horizontal bar chart
    catHtml += '<div style="display:flex;height:28px;border-radius:4px;overflow:hidden;margin-bottom:8px;background:var(--bg3);">';
    BUDGET_CATEGORIES.forEach(function(cat, i){
      var v = catTotals[cat] || 0;
      if(v<=0) return;
      var pct = totalCosts>0 ? (v/totalCosts*100) : 0;
      catHtml += '<div style="width:'+pct+'%;background:'+catColors[i%catColors.length]+';display:flex;align-items:center;justify-content:center;font-size:10px;color:#fff;font-weight:700;" title="'+cat+': '+_stFmtMoney(v)+'">'+(pct>8?(pct.toFixed(0)+'%'):'')+'</div>';
    });
    catHtml += '</div>';
    catHtml += '<div style="display:flex;flex-wrap:wrap;gap:8px;font-size:10px;">';
    BUDGET_CATEGORIES.forEach(function(cat, i){
      var v = catTotals[cat] || 0;
      catHtml += '<span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;background:var(--bg3);border-radius:3px;">'+
        '<span style="width:8px;height:8px;background:'+catColors[i%catColors.length]+';border-radius:50%;"></span>'+
        cat+': <b>'+_stFmtMoney(v)+'</b></span>';
    });
    catHtml += '</div>';
    catDiv.innerHTML = catHtml;
  }
  // Items list
  var listDiv = document.getElementById('st-budget-list');
  if(!listDiv) return;
  if(!s.budget.length){
    listDiv.innerHTML = '<div style="text-align:center;color:var(--text3);padding:20px;font-size:11px;">Nessuna voce. Clicca <b>+ VOCE</b>.</div>';
    return;
  }
  var sorted = s.budget.slice().sort(function(a,b){return (b.date||'').localeCompare(a.date||'');});
  var html = '<div style="font-family:var(--head);font-size:10px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">VOCI BUDGET ('+sorted.length+')</div>';
  html += '<div style="display:grid;grid-template-columns:100px 110px 1fr 90px 110px auto;gap:6px;font-size:9px;color:var(--text3);letter-spacing:1px;padding:0 8px 6px 8px;border-bottom:1px solid var(--border);margin-bottom:6px;">'+
    '<span>DATA</span><span>CATEGORIA</span><span>DESCRIZIONE</span><span>TIPO</span><span>IMPORTO</span><span></span></div>';
  html += sorted.map(function(b){
    var col = b.type==='income' ? 'var(--green)' : 'var(--accent)';
    return '<div style="display:grid;grid-template-columns:100px 110px 1fr 90px 110px auto;gap:6px;align-items:center;padding:5px 8px;background:var(--bg3);border-radius:4px;margin-bottom:4px;">'+
      '<input type="date" value="'+(b.date||'')+'" onchange="stUpdateBudgetItem(\''+b.id+'\',\'date\',this.value)" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-family:var(--mono);font-size:10px;padding:2px 4px;">'+
      '<select onchange="stUpdateBudgetItem(\''+b.id+'\',\'category\',this.value);stRenderBudget()" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-size:10px;padding:2px 4px;">'+
        BUDGET_CATEGORIES.map(function(c){return '<option '+(b.category===c?'selected':'')+'>'+c+'</option>';}).join('')+
      '</select>'+
      '<input type="text" value="'+(b.description||'').replace(/"/g,'&quot;')+'" onchange="stUpdateBudgetItem(\''+b.id+'\',\'description\',this.value)" placeholder="Descrizione" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:var(--text1);font-size:11px;padding:2px 5px;">'+
      '<select onchange="stUpdateBudgetItem(\''+b.id+'\',\'type\',this.value);stRenderBudget()" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:'+col+';font-size:10px;padding:2px 4px;">'+
        '<option value="cost"'+(b.type==='cost'?' selected':'')+'>💸 Costo</option>'+
        '<option value="income"'+(b.type==='income'?' selected':'')+'>💰 Entrata</option>'+
      '</select>'+
      '<input type="number" step="0.01" value="'+(b.amount||0)+'" onchange="stUpdateBudgetItem(\''+b.id+'\',\'amount\',this.value);stRenderBudget()" style="background:var(--bg0);border:1px solid var(--border);border-radius:3px;color:'+col+';font-family:var(--mono);font-size:11px;padding:2px 5px;text-align:right;">'+
      '<button onclick="stRemoveBudgetItem(\''+b.id+'\')" title="Rimuovi" style="background:none;border:none;color:var(--text3);cursor:pointer;font-size:13px;">✕</button>'+
    '</div>';
  }).join('');
  listDiv.innerHTML = html;
}
function stRenderBudgetSummary(){
  var s = _stCurrent();
  var summDiv = document.getElementById('st-budget-summary');
  if(!summDiv) return;
  var totalCosts = s.budget.filter(function(b){return b.type==='cost';}).reduce(function(a,b){return a+(+b.amount||0);},0);
  var totalIncome = s.budget.filter(function(b){return b.type==='income';}).reduce(function(a,b){return a+(+b.amount||0);},0);
  // Add sponsor income automatically
  var sponsorTotal = (s.sponsors||[]).reduce(function(a,sp){return a+(+sp.amount||0);},0);
  var totalIncomeWithSp = totalIncome + sponsorTotal;
  var balance = totalIncomeWithSp - totalCosts;
  var balanceColor = balance >= 0 ? 'var(--green)' : 'var(--red)';
  summDiv.innerHTML =
    '<div class="st-tile"><div class="tl">USCITE TOTALI</div><div class="tv" style="color:var(--red);">'+_stFmtMoney(totalCosts)+'</div></div>'+
    '<div class="st-tile"><div class="tl">ENTRATE</div><div class="tv" style="color:var(--green);">'+_stFmtMoney(totalIncomeWithSp)+'</div><div style="font-size:9px;color:var(--text3);margin-top:2px;">di cui sponsor: '+_stFmtMoney(sponsorTotal)+'</div></div>'+
    '<div class="st-tile"><div class="tl">BILANCIO</div><div class="tv" style="color:'+balanceColor+';">'+_stFmtMoney(balance)+'</div></div>'+
    '<div class="st-tile"><div class="tl">EVENTI CORSI</div><div class="tv">'+(s.events||[]).filter(function(e){return e.status==='done';}).length+' / '+(s.events||[]).length+'</div><div style="font-size:9px;color:var(--text3);margin-top:2px;">costo medio evento: '+_stFmtMoney(s.events.length?totalCosts/Math.max(1,s.events.filter(function(e){return e.status==='done';}).length):0)+'</div></div>';
}

