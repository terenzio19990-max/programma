// ═══════════════════════════════════════════════════════════════
// MAPPA 3D CON PLOTLY — DATI GPS (ALTIMETRIA E PENDENZA)
// ═══════════════════════════════════════════════════════════════
let _gpsData = null;

function loadGPSData(event) {
  const file = event.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => { parseAndPlotGPS(e.target.result); };
  reader.readAsText(file);
}

function parseAndPlotGPS(csvText) {
  const lines = csvText.split('\n').map(l=>l.trim()).filter(l=>l);
  if(lines.length < 2) { showToast('File CSV vuoto'); return; }

  const headers = lines[0].toLowerCase().split(',').map(h=>h.trim());
  const latIdx = headers.findIndex(h=>h.includes('lat'));
  const lonIdx = headers.findIndex(h=>h.includes('lon')||h.includes('lng'));
  const altIdx = headers.findIndex(h=>h.includes('alt')||h.includes('elev')||h.includes('z'));

  if(latIdx===-1||lonIdx===-1||altIdx===-1) {
    showToast('Colonne GPS non trovate: '+headers.join(', ')); return;
    return;
  }

  const lats=[], lons=[], alts=[], slopes=[];
  for(let i=1;i<lines.length;i++){
    const cols = lines[i].split(',').map(v=>parseFloat(v.trim()));
    if(!isNaN(cols[latIdx])&&!isNaN(cols[lonIdx])&&!isNaN(cols[altIdx])){
      lats.push(cols[latIdx]);
      lons.push(cols[lonIdx]);
      alts.push(cols[altIdx]);
    }
  }
  if(lats.length < 2) { showToast('Dati GPS insufficienti'); return; }

  // Calcola pendenza % con Haversine
  slopes.push(0);
  let totalDist=0, totalClimb=0, totalDescent=0;
  for(let i=1;i<lats.length;i++){
    const R=6371e3;
    const phi1=lats[i-1]*Math.PI/180, phi2=lats[i]*Math.PI/180;
    const dPhi=(lats[i]-lats[i-1])*Math.PI/180;
    const dLam=(lons[i]-lons[i-1])*Math.PI/180;
    const a=Math.sin(dPhi/2)**2+Math.cos(phi1)*Math.cos(phi2)*Math.sin(dLam/2)**2;
    const dist=R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
    totalDist += dist;
    const dAlt=alts[i]-alts[i-1];
    if(dAlt>0) totalClimb+=dAlt;
    else totalDescent+=Math.abs(dAlt);
    const slope=dist>0?Math.max(-20,Math.min(20,(dAlt/dist)*100)):0;
    slopes.push(slope);
  }

  _gpsData = { lats, lons, alts, slopes };

  // Stats
  document.getElementById('gps-stats').style.display='';
  document.getElementById('gps-placeholder').style.display='none';
  setEl('gps-points', lats.length.toLocaleString('it-IT'));
  setEl('gps-distance', (totalDist/1000).toFixed(2)+' km');
  setEl('gps-climb', '+'+totalClimb.toFixed(0)+' m');
  setEl('gps-descent', '−'+totalDescent.toFixed(0)+' m');
  setEl('gps-alt-max', Math.max(...alts).toFixed(0)+' m');
  setEl('gps-alt-min', Math.min(...alts).toFixed(0)+' m');

  // Build Plotly chart
  const trace = {
    type:'scatter3d', mode:'lines+markers',
    x:lons, y:lats, z:alts,
    line:{
      width:6, color:slopes, colorscale:'Jet',
      showscale:true,
      colorbar:{title:'Pendenza %',thickness:14,len:0.5,tickfont:{color:'#a8afc0'},titlefont:{color:'#a8afc0'}},
      cmin:-15, cmax:15
    },
    marker:{ size:2, color:slopes, colorscale:'Jet', cmin:-15, cmax:15 },
    text:slopes.map((s,i)=>`Altitudine: ${alts[i].toFixed(1)}m<br>Pendenza: ${s.toFixed(1)}%<br>Lat: ${lats[i].toFixed(5)}<br>Lon: ${lons[i].toFixed(5)}`),
    hoverinfo:'text'
  };

  const layout = {
    margin:{l:0,r:0,b:0,t:0},
    scene:{
      xaxis:{title:'Longitudine',showgrid:false,zeroline:false,color:'#6b7280'},
      yaxis:{title:'Latitudine',showgrid:false,zeroline:false,color:'#6b7280'},
      zaxis:{title:'Altitudine (m)',showgrid:true,zeroline:false,color:'#6b7280',gridcolor:'#2a2f3e'},
      bgcolor:'rgba(10,11,13,0)',
      camera:{eye:{x:1.2,y:1.2,z:0.7}}
    },
    paper_bgcolor:'transparent',
    plot_bgcolor:'transparent',
    font:{color:'#a8afc0'}
  };

  Plotly.newPlot('plotly-3d-map', [trace], layout, {responsive:true, displayModeBar:true, modeBarButtonsToRemove:['sendDataToCloud']});
  showToast(`✅ GPS caricato: ${lats.length} punti · ${(totalDist/1000).toFixed(2)} km`);
}

function resetGps3DCamera() {
  const el = document.getElementById('plotly-3d-map');
  if(!el || !_gpsData) return;
  Plotly.relayout(el, {'scene.camera': {eye:{x:1.2,y:1.2,z:0.7}}});
}

