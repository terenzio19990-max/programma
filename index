// ── Init token client ──
function gdriveInitClient(clientId) {
  if(!window.google || !window.google.accounts) {
    showToast('Libreria Google non ancora caricata. Riprova tra qualche secondo.');
    return false;
  }
  try {
    _gdriveTokenClient = google.accounts.oauth2.initTokenClient({
      client_id: clientId,
      scope: 'https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email',
      callback: function(resp) {
        if(resp.error) {
          console.error('GDrive OAuth error:', resp.error);
          showToast('Errore Google: ' + resp.error_description || resp.error);
          gdriveRender();
          return;
        }
        _gdriveToken = resp.access_token;
        // Get user info
        fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
          headers: { Authorization: 'Bearer ' + _gdriveToken }
        }).then(function(r){ return r.json(); }).then(function(u){
          _gdriveUser = u.email || '';
          // Update Drive button
          var btn = document.getElementById('gdrive-btn');
          if(btn) btn.style.color = 'var(--green)';
          gdriveRender();
          showToast('Connesso a Google Drive come ' + _gdriveUser);
        }).catch(function(){
          gdriveRender();
        });
      }
    });
    _gdriveInitialized = true;
    return true;
  } catch(e) {
    console.error('gdriveInitClient error:', e);
    showToast('Errore inizializzazione Google: ' + e.message);
    return false;
  }
}

// ── Sign In ──
function gdriveSignIn() {
  var clientId = localStorage.getItem(GDRIVE_LS_KEY);
  if(!clientId) { gdriveRender(); return; }
  if(!_gdriveInitialized) {
    if(!gdriveInitClient(clientId)) return;
  }
  if(!_gdriveTokenClient) {
    showToast('Client non inizializzato. Verifica il Client ID.');
    return;
  }
  document.getElementById('gdrive-loading').style.display='block';
  document.getElementById('gdrive-signout-panel').style.display='none';
  document.getElementById('gdrive-loading-msg').textContent='Connessione in corso...';
  _gdriveTokenClient.requestAccessToken({ prompt: 'consent' });
}

// ── Sign Out ──
function gdriveSignOut() {
  if(_gdriveToken && window.google && window.google.accounts) {
    google.accounts.oauth2.revoke(_gdriveToken, function(){});
  }
  _gdriveToken = null;
  _gdriveUser = null;
  _gdriveInitialized = false;
  _gdriveTokenClient = null;
  var btn = document.getElementById('gdrive-btn');
  if(btn) btn.style.color = '';
  gdriveRender();
  showToast('Disconnesso da Google Drive');
}

