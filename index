// FULL BACKUP — exports EVERYTHING (STATE + all localStorage + photos)
// ═══════════════════════════════════════════════════════════════
async function fullBackupExport(){
  try {
    showToast('📦 Preparazione backup completo...');
    var bak = {
      version: 'rep-v1',
      exportedAt: new Date().toISOString(),
      app: 'Race Engineer Pro',
      // 1) STATE (current in-memory)
      STATE: typeof STATE !== 'undefined' ? STATE : null,
      _competitors: typeof _competitors !== 'undefined' ? _competitors : null,
      _driverNotes: typeof _driverNotes !== 'undefined' ? _driverNotes : null,
      _pitStops:    typeof _pitStops !== 'undefined' ? _pitStops : null,
      COMPOUND_NAMES: typeof COMPOUND_NAMES !== 'undefined' ? COMPOUND_NAMES : null,
      DOCS:         typeof DOCS !== 'undefined' ? DOCS : null,
      METEO_STATE:  typeof METEO_STATE !== 'undefined' ? METEO_STATE : null,
      // 2) All localStorage keys (REP_*, rep_*)
      localStorage: {},
      // 3) All photos as base64 data URLs
      photos: []
    };
    try {
      for(var i = 0; i < localStorage.length; i++){
        var k = localStorage.key(i);
        if(k && (k.indexOf('REP_')===0 || k.indexOf('rep_')===0 || k.indexOf('coop_')===0)){
          bak.localStorage[k] = localStorage.getItem(k);
        }
      }
    } catch(e){}
    // Photos
    try {
      var pl = await photoList();
      for(var j = 0; j < pl.length; j++){
        var p = pl[j];
        var b64 = await new Promise(function(res){
          var fr = new FileReader();
          fr.onload = function(){ res(fr.result); };
          fr.readAsDataURL(p.blob);
        });
        bak.photos.push({
          id: p.id, category: p.category, carId: p.carId, label: p.label, note: p.note,
          timestamp: p.timestamp, sizeKB: p.sizeKB, originalSizeKB: p.originalSizeKB,
          dataURL: b64
        });
      }
    } catch(e){}
    var json = JSON.stringify(bak);
    var blob = new Blob([json], { type:'application/json' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    var ts = new Date().toISOString().slice(0,19).replace(/[:T]/g,'-');
    a.download = 'race-eng-pro-FULL-BACKUP-'+ts+'.json';
    a.click();
    setTimeout(function(){ URL.revokeObjectURL(url); }, 2000);
    showToast('✅ Backup completo: '+_fmtBytes(blob.size)+' ('+bak.photos.length+' foto)');
  } catch(e){
    showToast('❌ Backup fallito: '+e.message);
  }
}
