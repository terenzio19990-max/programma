function alertBeep(){
  try {
    var ctx=new (window.AudioContext||window.webkitAudioContext)();
    for(var i=0;i<3;i++){
      var o=ctx.createOscillator(), gn=ctx.createGain();
      o.type='square'; o.frequency.value=880;
      gn.gain.setValueAtTime(0.001, ctx.currentTime+i*0.35);
      gn.gain.exponentialRampToValueAtTime(0.3, ctx.currentTime+i*0.35+0.03);
      gn.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime+i*0.35+0.28);
      o.connect(gn); gn.connect(ctx.destination);
      o.start(ctx.currentTime+i*0.35); o.stop(ctx.currentTime+i*0.35+0.3);
    }
  } catch(e){}
}
