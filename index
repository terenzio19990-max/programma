<script>
/* ═══════════════════════════════════════════════════════════════
   RACE ENGINEER PRO — FEATURE PACK v18.2
   1) Import tempi (CSV / incolla dal cronometraggio)
   2) Pit window calcolato (degrado stint + pit loss circuito)
   3) Consumo carburante appreso dai livelli misurati
   4) Proiezione duelli con avversari
   5) Cronotabella controlli orari (CO) rally con allarme
   6) Matrice gomme per PS incrociata col meteo orario
   7) Usura gomme configurabile in %/km
═══════════════════════════════════════════════════════════════ */
(function(){
'use strict';
var REP2 = window.REP2 = {};

/* ── stato aggiuntivo (serializzato automaticamente con STATE) ── */
function st(){
  if(!STATE.rallyCO)       STATE.rallyCO = [];
  if(!STATE.tyreWearRates) STATE.tyreWearRates = {};
  if(!STATE.psSchedule)    STATE.psSchedule = [];
  if(!STATE.duelPrefs)     STATE.duelPrefs = {};
  if(!STATE.fuelPlanRem)   STATE.fuelPlanRem = {};
  return STATE;
}
function E(s){ return (typeof esc==='function') ? esc(s) : String(s==null?'':s); }
function toast(m){ if(typeof showToast==='function') showToast(m); }
function save(){ if(typeof triggerAutoSave==='function'){ try{ triggerAutoSave(); }catch(_){} } }
function median(a){ if(!a||!a.length) return null; var b=a.slice().sort(function(x,y){return x-y;}); var m=Math.floor(b.length/2); return b.length%2 ? b[m] : (b[m-1]+b[m])/2; }
function curTrackCar(){ return STATE.trackCars[STATE.selectedTrackCar]; }
function circ(){ return (typeof CIRCUITS!=='undefined' && STATE.circuit) ? CIRCUITS[STATE.circuit] : null; }
function lastValidMs(carId, n){
  var out = (STATE.laps[carId]||[]).map(function(l){ return parseTime(l.time); }).filter(Boolean);
  var med = median(out);
  out = out.filter(function(t){ return !med || t < med*1.07; });
  return out.slice(-n);
}

/* ── iniezione pannelli nelle pagine esistenti ── */
function ensurePanel(pageId, pid, head){
  var page = document.getElementById(pageId); if(!page) return null;
  var el = document.getElementById(pid);
  if(!el){
    el = document.createElement('div');
    el.className = 'panel mb12'; el.id = pid;
    el.innerHTML = '<div class="panel-head">'+head+'</div><div class="panel-body" id="'+pid+'-body"></div>';
    var ref = page.firstElementChild;
    while(ref && ref.classList && ref.classList.contains('car-tabs')) ref = ref.nextElementSibling;
    page.insertBefore(el, ref);
  }
  return document.getElementById(pid+'-body');
}
function modal(innerHtml){
  var ov = document.createElement('div');
  ov.id = 'rep2-modal';
  ov.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px;';
  ov.innerHTML = '<div class="panel" style="max-width:860px;width:100%;max-height:90vh;overflow:auto;">'+innerHtml+'</div>';
  ov.addEventListener('click', function(e){ if(e.target===ov) REP2.closeModal(); });
  document.body.appendChild(ov);
}
REP2.closeModal = function(){ var m = document.getElementById('rep2-modal'); if(m) m.remove(); };

/* ═══ 1. IMPORT TEMPI ═══════════════════════════════════════════ */
REP2.renderImportBtn = function(){
  var page = document.getElementById('page-laps'); if(!page) return;
  if(document.getElementById('rep2-imp-btn')) return;
  var b = document.createElement('button');
  b.id = 'rep2-imp-btn'; b.className = 'btn btn-blue mb12';
  b.textContent = '📥 IMPORTA TEMPI (CSV / incolla)';
  b.onclick = REP2.openImport;
  page.insertBefore(b, page.firstElementChild);
};
REP2.openImport = function(){
  var car = curTrackCar(); if(!car){ toast('Seleziona una vettura'); return; }
  modal(
    '<div class="panel-head">📥 IMPORT TEMPI — '+E(car.name)+'</div>'+
    '<div class="panel-body">'+
    '<div class="small mb8">Incolla le righe dal cronometraggio (export MyLaps/TAG Heuer, CSV o testo dal live timing). '+
    'Riconosco formati <b>1:45.320</b>, <b>105.32</b>, <b>1.45.320</b>; se una riga ha 4 tempi individuo giro e settori automaticamente. '+
    'Un numero intero a inizio riga è letto come numero giro.</div>'+
    '<textarea id="rep2-imp-txt" rows="8" style="width:100%;font-family:var(--mono);font-size:12px;" placeholder="1;1:46.230;35.120;41.005;30.105"></textarea>'+
    '<div style="display:flex;gap:8px;margin:10px 0;">'+
    '<button class="btn btn-blue" onclick="REP2.previewImport()">ANTEPRIMA</button>'+
    '<button class="btn btn-green" onclick="REP2.doImport()" id="rep2-imp-go" disabled>IMPORTA</button>'+
    '<button class="btn btn-gray" onclick="REP2.closeModal()">CHIUDI</button>'+
    '</div><div id="rep2-imp-preview"></div></div>');
};
REP2._impRows = [];
REP2.parseImportText = function(txt){
  var car = curTrackCar();
  var nextLap = ((STATE.laps[car.id]||[]).length) + 1;
  var rows = [];
  txt.split(/\r?\n/).forEach(function(line){
    if(!line.trim()) return;
    var toks = line.match(/\d+[:'′]\d{1,2}[.,"″]\d{1,3}|\d+[.,]\d{1,3}|\b\d{2,3}\b/g) || [];
    var times = [];
    toks.forEach(function(t){
      var ms = parseTime(t);
      if(ms && ms>=8000 && ms<=900000) times.push(ms);
    });
    if(!times.length) return;
    var lapNum = null;
    var mLap = line.match(/^\s*(\d{1,3})\s*[;,\t |]/);
    if(mLap && +mLap[1]>0 && +mLap[1]<1000) lapNum = +mLap[1];
    var time=null, s1='', s2='', s3='';
    if(times.length>=4){
      var last4 = times.slice(-4);
      var sumTail = last4[1]+last4[2]+last4[3];
      var sumHead = last4[0]+last4[1]+last4[2];
      if(Math.abs(last4[0]-sumTail)<2500){ time=last4[0]; s1=last4[1]; s2=last4[2]; s3=last4[3]; }
      else if(Math.abs(last4[3]-sumHead)<2500){ s1=last4[0]; s2=last4[1]; s3=last4[2]; time=last4[3]; }
      else { time=Math.max.apply(null,last4); var rest=last4.filter(function(t){return t!==time;}); s1=rest[0]; s2=rest[1]; s3=rest[2]; }
    } else {
      time = Math.max.apply(null, times);
    }
    if(!time) return;
    var fmtS = function(ms){ return ms<60000 ? (ms/1000).toFixed(3) : msToTime(ms); };
    rows.push({
      lap: lapNum!==null ? lapNum : nextLap++,
      time: msToTime(time),
      s1: s1?fmtS(s1):'', s2: s2?fmtS(s2):'', s3: s3?fmtS(s3):''
    });
    if(lapNum!==null) nextLap = lapNum+1;
  });
  return rows;
};
REP2.previewImport = function(){
  var txt = (document.getElementById('rep2-imp-txt')||{}).value||'';
  REP2._impRows = REP2.parseImportText(txt);
  var pv = document.getElementById('rep2-imp-preview'); if(!pv) return;
  if(!REP2._impRows.length){ pv.innerHTML = '<div class="small" style="color:var(--red);">Nessun tempo riconosciuto.</div>'; return; }
  pv.innerHTML = '<div class="small mb8">'+REP2._impRows.length+' giri riconosciuti:</div>'+
    '<table class="data-table" style="width:100%;"><thead><tr><th>Giro</th><th>Tempo</th><th>S1</th><th>S2</th><th>S3</th></tr></thead><tbody>'+
    REP2._impRows.map(function(r){
      return '<tr><td class="mono">'+r.lap+'</td><td class="mono" style="color:var(--accent3);">'+r.time+'</td><td class="mono">'+(r.s1||'—')+'</td><td class="mono">'+(r.s2||'—')+'</td><td class="mono">'+(r.s3||'—')+'</td></tr>';
    }).join('')+'</tbody></table>';
  var go = document.getElementById('rep2-imp-go'); if(go) go.disabled = false;
};
REP2.doImport = function(){
  var car = curTrackCar(); if(!car || !REP2._impRows.length) return;
  var snap = JSON.parse(JSON.stringify(STATE.laps[car.id]||[]));
  if(typeof pushUndo==='function') pushUndo('Import '+REP2._impRows.length+' giri '+car.name, function(){
    STATE.laps[car.id]=snap;
    if(typeof buildLapsPage==='function') buildLapsPage();
  });
  var sess = STATE.sessionType || 'FP1';
  REP2._impRows.forEach(function(r){
    STATE.laps[car.id].push({ lap:r.lap, time:r.time, s1:r.s1, s2:r.s2, s3:r.s3,
      pos:null, vmax:null, note:'import', session:sess, car:car.id, driverId:'', ts:Date.now() });
  });
  toast('📥 Importati '+REP2._impRows.length+' giri su '+car.name+' (nota: carburante non scalato)');
  REP2._impRows = [];
  REP2.closeModal();
  if(typeof buildLapsPage==='function') buildLapsPage();
  if(typeof updateTrackCarsPanel==='function'){ try{ updateTrackCarsPanel(); }catch(_){} }
  save();
};

/* ═══ 7. USURA GOMME %/km (serve anche al pit window) ═══════════ */
REP2.wearInfo = function(carId){
  st();
  var rate = +STATE.tyreWearRates[carId]||0;
  var t = STATE.tyres[carId] && STATE.tyres[carId].current;
  var c = circ();
  if(!rate || !t || !c || !c.km) return null;
  var lapsNow = (STATE.laps[carId]||[]).length;
  var kmOnSet = Math.max(0, (lapsNow - (t.lapsMounted||0)) * c.km);
  var manual = 0;
  if(t.wheels){ Object.keys(t.wheels).forEach(function(w){ manual = Math.max(manual, +t.wheels[w].wear||0); }); }
  var est = Math.min(100, kmOnSet * rate);
  var eff = Math.max(est, manual);
  var thr = +(document.getElementById('alert-wear-pct')||{}).value || 80;
  var lapsToThr = (rate>0 && eff<thr) ? Math.floor((thr-eff)/(rate*c.km)) : 0;
  return { rate:rate, kmOnSet:kmOnSet, est:est, manual:manual, eff:eff, thr:thr, lapsToThr:lapsToThr };
};
REP2.renderWearRate = function(){
  var body = ensurePanel('page-tyres','rep2-wearrate','🛞 USURA STIMATA — %/km <span class="badge badge-blue">v18.2</span>');
  if(!body) return;
  st();
  var car = curTrackCar(); if(!car){ body.innerHTML='Seleziona una vettura.'; return; }
  var rate = +STATE.tyreWearRates[car.id]||'';
  body.innerHTML = '<div class="form-row">'+
    '<div class="field"><label>Consumo gomma (%/km)</label>'+
    '<input type="number" step="0.01" min="0" max="10" id="rep2-wr-rate" value="'+rate+'" placeholder="es. 0.35" '+
