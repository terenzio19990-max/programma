];
var MQ_BROKERS=[
 'wss://broker.emqx.io:8084/mqtt',
 'wss://broker.hivemq.com:8884/mqtt',
 'wss://test.mosquitto.org:8081'
];
function ensureMqtt(ok,fail){
  if(typeof window.mqtt!=='undefined'){ ok(); return; }
  var i=0;
  (function next(){
    if(i>=MQTT_CDNS.length){ fail&&fail(); return; }
    var s=document.createElement('script');
    s.src=MQTT_CDNS[i++];
    s.onload=function(){ typeof window.mqtt!=='undefined'? ok() : next(); };
    s.onerror=next;
    document.head.appendChild(s);
  })();
}
function mqBoxStart(code){
  /* Il box ascolta TUTTI i broker in parallelo: ogni telefono si aggancia
     al primo che gli risponde, e non e' detto sia lo stesso per tutti —
     con un solo ascolto le vetture su un broker diverso sparirebbero. */
  ensureMqtt(function(){
    MQ_BROKERS.forEach(function(url){
      var c;
      try { c=window.mqtt.connect(url,{connectTimeout:6000,reconnectPeriod:5000,clean:true}); }
      catch(e){ return; }
      LIVE.mqs.push(c);
      c.on('connect',function(){ c.subscribe('reptel/'+code.toLowerCase()); });
