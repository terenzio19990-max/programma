// RESET ALL — wipe everything as if app was just installed
// Includes safety: auto-backup to IDB before reset, with undo prompt
// ═══════════════════════════════════════════════════════════════
async function resetAllData(){
  // Step 1: warn the user with full disclosure
  var warning = '⚠️  ATTENZIONE — RESET COMPLETO\n\n'+
    'Questo cancellerà TUTTI i dati dell\'app:\n\n'+
    '• Tutte le vetture (pista + rally)\n'+
    '• Tempi giro, gomme, danni, setup, fuel, note\n'+
    '• Magazzino gomme\n'+
    '• Stagione (calendario, classifiche, budget, piloti, sponsor)\n'+
    '• Templates setup e checklist\n'+
    '• Foto archiviate\n'+
    '• Tutte le impostazioni\n\n'+
    'L\'app tornerà come appena installata.\n\n'+
    'Sicuro di voler continuare?';
  if(!confirm(warning)) return;
  // Step 2: second confirm with type-to-confirm
  var typed = prompt('Digita esattamente "RESET" (in maiuscolo) per confermare:');
  if(typed !== 'RESET'){ showToast('Reset annullato'); return; }
  // Step 3: save safety backup to IDB (silently — undo within 24h)
  try {
    var safety = {
      name: '_safety_pre_reset_'+Date.now(),
      savedAt: new Date().toISOString(),
      // Capture CURRENT state plus all localStorage
      STATE: typeof STATE !== 'undefined' ? JSON.parse(JSON.stringify(STATE)) : null,
      _competitors: typeof _competitors !== 'undefined' ? JSON.parse(JSON.stringify(_competitors)) : null,
      _driverNotes: typeof _driverNotes !== 'undefined' ? JSON.parse(JSON.stringify(_driverNotes)) : null,
      _pitStops:    typeof _pitStops    !== 'undefined' ? JSON.parse(JSON.stringify(_pitStops)) : null,
      COMPOUND_NAMES: typeof COMPOUND_NAMES !== 'undefined' ? JSON.parse(JSON.stringify(COMPOUND_NAMES)) : null,
      DOCS:         typeof DOCS         !== 'undefined' ? JSON.parse(JSON.stringify(DOCS)) : null,
      METEO_STATE:  typeof METEO_STATE  !== 'undefined' ? JSON.parse(JSON.stringify(METEO_STATE)) : null,
      ls: {}
    };
    for(var i=0;i<localStorage.length;i++){
      var k = localStorage.key(i);
      if(k && (k.indexOf('REP_')===0 || k.indexOf('rep_')===0 || k.indexOf('coop_')===0)){
        safety.ls[k] = localStorage.getItem(k);
      }
    }
    var db = await openIDB();
    await new Promise(function(res){
      var tx = db.transaction(IDB_STORE, 'readwrite');
      tx.objectStore(IDB_STORE).put(safety);
      tx.oncomplete = res; tx.onerror = res;
    });
    console.log('[Reset] Safety backup saved as', safety.name);
  } catch(e){ console.warn('[Reset] safety backup failed', e); }

  // Step 4: clear localStorage (only REP_ / rep_ / coop_ keys)
  try {
    var keysToDel = [];
    for(var j=0;j<localStorage.length;j++){
      var key = localStorage.key(j);
      if(key && (key.indexOf('REP_')===0 || key.indexOf('rep_')===0 || key.indexOf('coop_')===0)){
        keysToDel.push(key);
      }
    }
    keysToDel.forEach(function(k){ try { localStorage.removeItem(k); } catch(_){} });
  } catch(e){}

  // Step 5: clear IDB (sessions + photos), but keep the safety backup just made
  try {
    var db2 = await openIDB();
    // Clear sessions store BUT keep the just-saved safety backup
    await new Promise(function(res){
      var tx = db2.transaction(IDB_STORE, 'readwrite');
      var store = tx.objectStore(IDB_STORE);
      var req = store.openCursor();
      req.onsuccess = function(){
        var cur = req.result;
        if(cur){
          var name = cur.value.name || '';
          if(name.indexOf('_safety_pre_reset_') !== 0){
            cur.delete();
          }
          cur.continue();
        } else { res(); }
      };
      req.onerror = function(){ res(); };
    });
    // Clear all photos
    await new Promise(function(res){
      var tx = db2.transaction(IDB_PHOTOS_STORE, 'readwrite');
      tx.objectStore(IDB_PHOTOS_STORE).clear();
      tx.oncomplete = res; tx.onerror = res;
    });
  } catch(e){ console.warn('[Reset] IDB clear failed', e); }

  // Done — reload
  showToast('🔄 Reset completato. Ricarico l\'app...');
  setTimeout(function(){ location.reload(); }, 1200);
}
