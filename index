// COOP MODE — Multi-engineer collaboration
// Supports 3 backends:
//   1) LAN / WiFi via PeerJS (WebRTC peer-to-peer, free signaling)
//   2) Firebase Firestore (cloud, live sync across internet)
//   3) Manual Export/Import (offline packages)
// ═══════════════════════════════════════════════════════════════

var COOP = {
  mode: 'lan',            // 'lan' | 'firebase' | 'manual'
  status: 'disconnected', // 'disconnected' | 'connecting' | 'connected' | 'host' | 'guest'
  me: { id:null, name:'', color:'#2b7de9' },
  peers: {},              // id -> {name,color,lastSeen}
  // LAN (PeerJS)
  peer: null,             // PeerJS instance
  connections: {},        // id -> DataConnection
  isHost: false,
  // Firebase
  fbApp: null, fbDb: null, fbRoom: null, fbUnsub: [],
  fbLastServerVersion: 0,
  // Anti-loop: suppress broadcasting when applying remote changes
  applyingRemote: false,
  // Activity log
  log: [],
};

// ─── Utils ───
function coopLog(msg, who){
  var t = new Date().toLocaleTimeString('it-IT');
  var line = '['+t+'] '+(who?('<b style="color:'+(COOP.peers[who]?.color||'var(--accent3)')+'">'+who+'</b> '):'')+msg;
  COOP.log.unshift(line);
  if(COOP.log.length>100) COOP.log.length=100;
  var el = document.getElementById('coop-activity-log');
  if(el) el.innerHTML = COOP.log.map(function(l){return '<div>'+l+'</div>';}).join('');
}
function coopUpdateStatus(status, text, icon){
  COOP.status = status;
  var el = document.getElementById('coop-status-text');
  var ic = document.getElementById('coop-status-icon');
  if(el) el.textContent = text;
  if(ic) ic.textContent = icon || '⚪';
  var dot = document.getElementById('coop-status-dot');
  if(dot){
    dot.style.background = status==='connected'||status==='host'||status==='guest' ? 'var(--green)' :
                           status==='connecting' ? 'var(--yellow)' : '#6b7280';
  }
  updateCoopPresence();
}
function coopShortId(){
  // 6-char easy-to-type code
  var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  var s = '';
  for(var i=0;i<6;i++) s += chars[Math.floor(Math.random()*chars.length)];
  return s;
}
