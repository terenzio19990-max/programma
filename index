REP2.learnedPerLap = function(carId){
  var f = STATE.fuel[carId]; if(!f||!f.log) return null;
  var pts = f.log.filter(function(l){ return l.level!==undefined && l.level!==null; })
                 .slice().sort(function(a,b){ return (a.lap||0)-(b.lap||0); });
  var totC=0, totL=0;
  for(var i=1;i<pts.length;i++){
    var A=pts[i-1], B=pts[i];
    var dl=(B.lap||0)-(A.lap||0); if(dl<=0) continue;
    var addedBetween = f.log.filter(function(l){
      return l.event==='Rifornimento' && (l.lap||0)>(A.lap||0) && (l.lap||0)<(B.lap||0);
    }).reduce(function(s,l){ return s+(+l.liters||0); },0);
    var levelBeforeB = (+B.level) - (B.event==='Rifornimento' ? (+B.liters||0) : 0);
    var consumed = (+A.level) + addedBetween - levelBeforeB;
    if(consumed>0 && consumed/dl<20){ totC+=consumed; totL+=dl; }
  }
  return totL>0 ? { perLap: totC/totL, laps: totL } : null;
};
REP2._fuelLearned = function(){
  var el = document.getElementById('rep2-fl-learned'); if(!el) return;
  var car = curTrackCar(); if(!car) return;
  var f = STATE.fuel[car.id];
