      '<th style="padding:5px 8px;">#</th><th style="padding:5px 8px;text-align:left;">TEAM</th>'+
      '<th style="padding:5px 8px;">PILOTI</th><th style="padding:5px 8px;">V</th><th style="padding:5px 8px;">PUNTI</th></tr>';
    teamArr.forEach(function(t, i){
      teamHtml += '<tr style="border-bottom:1px solid var(--border);">'+
        '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);font-weight:700;">'+(i+1)+'</td>'+
        '<td style="padding:5px 8px;font-weight:700;">'+t.name+'</td>'+
        '<td style="padding:5px 8px;color:var(--text3);font-size:10px;">'+t.drivers.join(', ')+'</td>'+
        '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);">'+t.wins+'</td>'+
        '<td style="padding:5px 8px;text-align:center;font-family:var(--mono);color:var(--accent3);font-weight:700;">'+t.total+'</td>'+
      '</tr>';
    });
    teamHtml += '</table>';
    tmDiv.innerHTML = teamHtml;
  } else if(tmDiv) {
    tmDiv.innerHTML = '';
  }
}

