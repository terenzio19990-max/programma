// Pick a set and fill the mount form
function pickStockSet(setName){
  tsLoad();
  var tyres = TYRE_STOCK.filter(function(t){
    return (t.set||'').trim() === setName.trim() && t.status !== 'mounted' && t.status !== 'dismissed';
  });
  if(!tyres.length){ showToast('Set non disponibile'); return; }

  // Match by position first, fallback to order
  var byPosition = {};
  ['FL','FR','RL','RR'].forEach(function(p){
    var t = tyres.find(function(x){return (x.position||'') === p;});
    if(t) byPosition[p] = t;
  });
  // If not all positions present, assign remaining tyres in order
  var assigned = new Set(Object.values(byPosition).map(function(t){return t.id;}));
  ['FL','FR','RL','RR'].forEach(function(p){
    if(byPosition[p]) return;
    var unassigned = tyres.find(function(t){return !assigned.has(t.id);});
    if(unassigned){ byPosition[p] = unassigned; assigned.add(unassigned.id); }
  });

  // Fill the form fields
  var prefix = _stockPickerMode === 'rally' ? 'rl-' : 'tr-';
  var filledCount = 0;
  ['FL','FR','RL','RR'].forEach(function(w){
    var t = byPosition[w]; if(!t) return;
    filledCount++;
    var setCpd = document.getElementById(prefix+'cpd-'+w);
    var setSet = document.getElementById(prefix+'setname-'+w);
    var setBrand = document.getElementById(prefix+'brand-'+w);
    var setCode = document.getElementById(prefix+'code-'+w);
    if(setCpd && t.compound) setCpd.value = t.compound;
    if(setSet) setSet.value = setName;
    if(setBrand) setBrand.value = t.brand || '';
    if(setCode) setCode.value = t.code || '';
  });

  // Show confirmation banner
  var bannerId = _stockPickerMode === 'rally' ? 'rally-mount-selected-set-banner' : 'mount-selected-set-banner';
  var banner = document.getElementById(bannerId);
  if(banner){
    banner.style.display = 'block';
    banner.innerHTML = '✓ Set <b>'+setName+'</b> selezionato dal magazzino ('+filledCount+'/4 ruote compilate). '+
      'Aggiungi pressioni/temp, poi premi <b>🔧 MONTA TRENO</b>. '+
      '<a href="#" onclick="_clearStockSelection(\''+_stockPickerMode+'\');return false;" style="color:var(--text3);margin-left:10px;">✕ annulla</a>';
  }

  document.getElementById('stock-picker-modal').style.display='none';
  showToast('✓ Set "'+setName+'" caricato nel form');
}

function _clearStockSelection(mode){
  var bannerId = mode === 'rally' ? 'rally-mount-selected-set-banner' : 'mount-selected-set-banner';
  var banner = document.getElementById(bannerId);
  if(banner){ banner.style.display = 'none'; banner.innerHTML = ''; }
  // Clear the form fields for the selected prefix
  var prefix = mode === 'rally' ? 'rl-' : 'tr-';
  ['FL','FR','RL','RR'].forEach(function(w){
    var setSet = document.getElementById(prefix+'setname-'+w);
    var setBrand = document.getElementById(prefix+'brand-'+w);
    var setCode = document.getElementById(prefix+'code-'+w);
    if(setSet) setSet.value = '';
    if(setBrand) setBrand.value = '';
    if(setCode) setCode.value = '';
  });
}

