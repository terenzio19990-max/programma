function buildMeteoChart(hourly) {
  const canvas = document.getElementById('meteo-chart');
  const placeholder = document.getElementById('meteo-chart-placeholder');
  if(!canvas||!hourly) return;
  if(placeholder) placeholder.style.display='none';
  canvas.style.display='block';

  const now = new Date();
  const labels=[], temps=[], precips=[], precipProbs=[];
  for(let i=0; i<hourly.time.length && labels.length<24; i++) {
    const t = new Date(hourly.time[i]);
    if(t < now) continue;
    const hh = t.getHours().toString().padStart(2,'0')+':00';
    labels.push(hh);
    temps.push(hourly.temperature_2m[i]);
    precips.push(hourly.precipitation?.[i]||0);
    precipProbs.push(hourly.precipitation_probability?.[i]||0);
  }

  const W = canvas.offsetWidth || canvas.parentElement.offsetWidth || 900;
  const H = 160;
  canvas.width = W; canvas.height = H;
  const ctx = canvas.getContext('2d');
  if(!ctx) return;
  ctx.clearRect(0,0,W,H);

  const padL=40, padR=16, padT=14, padB=28;
  const chartW = W - padL - padR;
  const chartH = H - padT - padB;
  const n = labels.length;
  if(!n) return;

  // Ranges
  const tMin = Math.min(...temps)-2, tMax = Math.max(...temps)+2;
  const pMax = Math.max(Math.max(...precips)*1.3, 2);

  const tx = i => padL + i*(chartW/(n-1||1));
  const ty = v => padT + chartH - ((v-tMin)/(tMax-tMin||1))*chartH;
  const py = v => padT + chartH - (v/pMax)*chartH;

  // Grid lines
  ctx.strokeStyle='rgba(255,255,255,0.05)'; ctx.lineWidth=1;
  for(let g=0;g<=4;g++){
    const y=padT+g*(chartH/4);
    ctx.beginPath();ctx.moveTo(padL,y);ctx.lineTo(W-padR,y);ctx.stroke();
  }

  // Precipitation bars
  const barW = Math.max(4, chartW/n*0.6);
  precips.forEach((p,i)=>{
    if(p<=0) return;
    const bh = (p/pMax)*chartH;
    const bx = tx(i)-barW/2;
    ctx.fillStyle='rgba(43,125,233,0.45)';
    ctx.fillRect(bx, padT+chartH-bh, barW, bh);
  });

  // Precip probability area
  ctx.beginPath();
  precipProbs.forEach((v,i)=>{ const x=tx(i), y=py(v/100*pMax); i===0?ctx.moveTo(x,y):ctx.lineTo(x,y); });
  ctx.lineTo(tx(n-1),padT+chartH); ctx.lineTo(tx(0),padT+chartH); ctx.closePath();
  ctx.fillStyle='rgba(43,125,233,0.12)'; ctx.fill();

  // Temperature line
  ctx.beginPath();
  temps.forEach((v,i)=>{ i===0?ctx.moveTo(tx(i),ty(v)):ctx.lineTo(tx(i),ty(v)); });
  ctx.strokeStyle='#ffa040'; ctx.lineWidth=2.5; ctx.lineJoin='round'; ctx.stroke();

  // Temp dots
  temps.forEach((v,i)=>{
    ctx.beginPath(); ctx.arc(tx(i),ty(v),3,0,Math.PI*2);
    ctx.fillStyle='#ffa040'; ctx.fill();
  });

  // Temp labels (Y axis)
  ctx.fillStyle='rgba(168,175,192,0.8)'; ctx.font='10px Share Tech Mono,monospace'; ctx.textAlign='right';
  for(let g=0;g<=4;g++){
    const v = tMin + (tMax-tMin)*(1-g/4);
    ctx.fillText(v.toFixed(0)+'°', padL-4, padT+g*(chartH/4)+4);
  }

  // X labels
  ctx.textAlign='center'; ctx.fillStyle='rgba(107,114,128,0.9)'; ctx.font='9px Share Tech Mono,monospace';
  const step = Math.ceil(n/8);
  labels.forEach((l,i)=>{ if(i%step===0) ctx.fillText(l, tx(i), H-6); });

  // Legend
  ctx.textAlign='left';
  ctx.fillStyle='#ffa040'; ctx.fillRect(padL,4,12,4);
  ctx.fillStyle='rgba(168,175,192,0.7)'; ctx.fillText('Temperatura',padL+16,10);
  ctx.fillStyle='rgba(43,125,233,0.6)'; ctx.fillRect(padL+120,4,12,4);
  ctx.fillStyle='rgba(168,175,192,0.7)'; ctx.fillText('Precipitazioni',padL+136,10);
}

