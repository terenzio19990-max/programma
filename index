  // Overall summary card
  var topCat = matchedRules[0].rule.category;
  var html = '<div style="padding:12px 16px;background:linear-gradient(135deg,rgba('+_hexToRgbCss(catColors[topCat])+',0.2), transparent);border-left:4px solid '+catColors[topCat]+';border-radius:4px;margin-bottom:14px;">'+
    '<div style="font-family:var(--head);font-size:12px;color:'+catColors[topCat]+';letter-spacing:2px;margin-bottom:4px;">🎯 PROBLEMA PRINCIPALE RILEVATO</div>'+
    '<div style="font-size:14px;font-weight:700;">'+catLabels[topCat]+'</div>'+
    '<div style="font-size:11px;color:var(--text3);margin-top:4px;">Basato su '+matchedRules[0].matchedNotes.length+' nota/e pilota recente/i (intensità totale: '+matchedRules[0].score+')</div>'+
    '</div>';

  // Suggestions per rule
  html += '<div style="font-family:var(--head);font-size:11px;color:var(--text3);letter-spacing:2px;margin-bottom:6px;">🔧 SUGGERIMENTI SETUP</div>';
  matchedRules.slice(0,4).forEach(function(m){
    html += '<div style="background:var(--bg3);border-left:3px solid '+catColors[m.rule.category]+';border-radius:4px;padding:12px 14px;margin-bottom:10px;">'+
      '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">'+
      '<div><b>'+catLabels[m.rule.category]+'</b> '+(m.rule.keywords.length ? '('+m.rule.keywords.slice(0,3).join(' / ')+')' : '')+'</div>'+
      '<span style="font-size:10px;color:var(--text3);">score '+m.score+' · '+m.matchedNotes.length+' note</span>'+
      '</div>'+
      '<div style="display:grid;grid-template-columns:auto 1fr auto;gap:6px 12px;font-size:11px;align-items:start;">'+
      '<div style="font-weight:700;color:var(--text3);font-size:10px;letter-spacing:1px;">PARAMETRO</div>'+
      '<div style="font-weight:700;color:var(--text3);font-size:10px;letter-spacing:1px;">MOTIVAZIONE</div>'+
      '<div style="font-weight:700;color:var(--text3);font-size:10px;letter-spacing:1px;">AZIONE</div>'+
      m.rule.suggestions.map(function(s){
        return '<div style="color:var(--text1);">'+s.field+'</div>'+
          '<div style="color:var(--text3);font-size:10px;line-height:1.5;">'+s.reason+'</div>'+
          '<div style="color:var(--accent3);font-family:var(--mono);font-weight:700;white-space:nowrap;">'+s.action+'</div>';
      }).join('')+
      '</div>'+
      // Matched notes (expandable)
      '<details style="margin-top:10px;"><summary style="cursor:pointer;font-size:10px;color:var(--text3);">📋 Vedi le '+m.matchedNotes.length+' nota/e che hanno attivato questa regola</summary>'+
      '<div style="margin-top:6px;font-size:10px;color:var(--text2);">'+
      m.matchedNotes.map(function(n){
        return '<div style="padding:4px 8px;background:var(--bg0);border-left:2px solid '+catColors[m.rule.category]+';margin-top:3px;border-radius:3px;">'+
          '<b>G'+(n.lap||'?')+'</b> '+(n.point?'@ '+n.point+' ':'')+'['+( n.intensity||'medium')+']: <i>'+(n.note||'')+'</i></div>';
      }).join('')+
      '</div></details>'+
      '</div>';
  });

  html += '<div style="margin-top:14px;padding:10px 14px;background:var(--bg3);border-left:3px solid var(--yellow);border-radius:4px;font-size:11px;color:var(--text2);line-height:1.7;">'+
    '⚠️ <b>Promemoria importante:</b><br>'+
    '• Questi sono suggerimenti basati su pattern comuni. La realtà è sempre specifica della vettura/pilota/circuito.<br>'+
    '• Fai <b>UN cambio per volta</b> per capire cosa ha funzionato.<br>'+
    '• Parla col pilota prima di cambiare: conferma che il problema sia ancora presente.<br>'+
    '• Se il problema è "positivo" → non toccare nulla, solo ottimizza costanza.'+
    '</div>';

  el.innerHTML = html;
}

function _hexToRgbCss(hex){
  hex = (hex||'#888').replace('#','');
  if(hex.length===3) hex = hex.split('').map(function(c){return c+c;}).join('');
  var n = parseInt(hex,16);
  return ((n>>16)&255)+','+((n>>8)&255)+','+(n&255);
}


