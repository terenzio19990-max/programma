// TIMELINE
// ═══════════════════════════════════════════════════════════════
function buildTimeline() {
  var events = [];
  var allCars = STATE.trackCars.concat(STATE.rallyCars);
  allCars.forEach(function(car) {
    (STATE.laps[car.id]||[]).forEach(function(l){ if(l.time) events.push({time:l.lap,type:'lap',car:car.name,desc:'G'+l.lap+': '+l.time+(l.note?' - '+l.note:''),flag:''}); });
    (STATE.damage[car.id]||[]).forEach(function(e){ events.push({time:+e.lap||0,type:'damage',car:car.name,desc:'Danno: '+e.desc,flag:'&#9888;'}); });
    (_pitStops[car.id]||[]).forEach(function(p){ events.push({time:p.lap,type:'pit',car:car.name,desc:'Pit: '+p.duration.toFixed(3)+'s',flag:'&#128295;'}); });
    (_driverNotes[car.id]||[]).forEach(function(n){ events.push({time:n.lap,type:'note',car:car.name,desc:'Pilota: '+n.note.slice(0,60),flag:'&#128483;'}); });
  });
  STATE.stages.forEach(function(s){ events.push({time:s.num,type:'stage',car:s.car,desc:'PS'+s.num+' '+s.name+': '+s.time+(s.cancelled?' [ANNULLATA]':''),flag:s.cancelled?'&#10005;':'&#127807;'}); });
  events.sort(function(a,b){return a.time-b.time;});
  var tbody = document.getElementById('timeline-tbody');
  if(tbody) {
    var typeC = {lap:'var(--text2)',damage:'var(--red)',pit:'var(--accent3)',note:'var(--teal)',stage:'var(--green)'};
    tbody.innerHTML = events.map(function(e) {
