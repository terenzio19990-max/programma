// Save all chrono laps as actual session laps
function chronoSaveAll(){
  _chronoLoad();
  if(!_chrono.laps.length){ showToast('Nessun giro da salvare'); return; }
  // Pick correct car based on mode
  var isRally = (STATE.mode === 'rally');
  var car = isRally
    ? STATE.rallyCars[STATE.selectedRallyCar]
    : STATE.trackCars[STATE.selectedTrackCar];
  if(!car){ showToast('⚠️ Nessuna vettura selezionata'); return; }
  if(isRally){
    // Rally laps go to STATE.stages, not STATE.laps. Different schema.
    showToast('⚠️ In modalità rally usa la pagina Prove Speciali per registrare i tempi PS');
    return;
  }
  // Sanity check: warn if any lap is suspiciously short or long
  var bad = _chrono.laps.filter(function(l){return l.ms < 5000 || l.ms > 900000;});
  var msg = 'Salvare i '+_chrono.laps.length+' giri cronometrati come giri della sessione?\n\n'+
    'Vettura: '+car.name+'\n'+
    'Sessione: '+((document.getElementById('session-type')||{}).value || '—')+'\n'+
    'Pilota: '+(((document.getElementById('lap-driver')||{}).options[((document.getElementById('lap-driver')||{}).selectedIndex||0)]||{}).text || '—');
  if(bad.length){
    msg += '\n\n⚠️ '+bad.length+' giro/i sospetti (<5s o >15min). Verifica prima di salvare.';
  }
  if(!confirm(msg)) return;

  if(!STATE.laps[car.id]) STATE.laps[car.id] = [];
  // Find next lap number
  var nextLap = (STATE.laps[car.id].length > 0)
    ? Math.max.apply(null, STATE.laps[car.id].map(function(l){return +l.lap||0;})) + 1
    : 1;
  var sessionType = (document.getElementById('session-type')||{}).value || '';
  var driverId = (document.getElementById('lap-driver')||{}).value || '';
  // Pick last position if available, else 1
  var lastPos = 1;
  if(STATE.laps[car.id].length > 0){
    var lp = STATE.laps[car.id][STATE.laps[car.id].length - 1];
    if(lp && lp.pos) lastPos = +lp.pos || 1;
  }
  // Snapshot for undo
  var _lapSnap = JSON.parse(JSON.stringify(STATE.laps[car.id]));
  _chrono.laps.forEach(function(cl, i){
    var lap = {
      lap: nextLap + i,
      time: _chronoFmt(cl.ms),
      s1: '', s2: '', s3: '',
      pos: lastPos,
      vmax: 0,
      note: '⏱ Cronometro',
      session: sessionType,
      car: car.id,
      driverId: driverId,
      ts: cl.at || Date.now()
    };
    STATE.laps[car.id].push(lap);
  });
  // Push undo (uses correct refresh functions)
  if(typeof pushUndo === 'function'){
    pushUndo('Crono '+_chrono.laps.length+'g '+car.name, function(){
      STATE.laps[car.id] = _lapSnap;
      if(typeof buildLapsTable==='function') buildLapsTable(car.id);
      if(typeof updateSidebarStats==='function') updateSidebarStats(car.id);
      if(typeof buildDashboard==='function') buildDashboard();
    });
  }
  var savedCount = _chrono.laps.length;
  // If chrono is still running, restart lap count from current elapsed,
  // so the next 🚩 LAP measures from now (not from when last saved lap ended).
  _chrono.laps = [];
  _chrono.lastLapAt = _chronoElapsed();
  _chronoSave();
  // Refresh
  if(typeof triggerAutoSave === 'function') triggerAutoSave();
  if(typeof buildLapsTable === 'function') buildLapsTable(car.id);
  if(typeof updateSidebarStats === 'function') updateSidebarStats(car.id);
  if(typeof buildDashboard === 'function') buildDashboard();
  _chronoUpdateLapsList();
  showToast('💾 '+savedCount+' giri salvati su '+car.name);
}
window.chronoSaveAll = chronoSaveAll;

