      (Math.abs(me)>=10? ' → controlla montaggio/calibrazione g':' — sensori coerenti')+'</span>';
  }
  host.innerHTML='<div style="font-weight:700;margin:6px 0 4px">🌀 CURVE — vmin km/h · ay in g (GPS=v²/r vs IMU misurata)'+vTxt+'</div>'+
